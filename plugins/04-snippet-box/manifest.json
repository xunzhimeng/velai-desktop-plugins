{
  "manifest_version": 1,
  "plugin_id": "snippet-box",
  "name": "常用片段剪贴箱",
  "version": "1.0.0",
  "host_api": 1,
  "backend": "backend/index.js",
  "page": "ui/index.html",
  "ui": {
    "icon": "app",
    "surfaces": ["workspace", "chat", "assistant"]
  },
  "permissions": ["data.read", "data.write"],
  "actions": [
    {
      "id": "snippet.list",
      "title": "读取片段列表",
      "permissions": ["data.read"],
      "input_schema": { "type": "object", "additionalProperties": false, "required": [], "properties": {} },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revision", "snippets"],
        "properties": {
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "snippets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title", "tag", "pinned", "body"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 48 },
                "title": { "type": "string", "minLength": 1, "maxLength": 80 },
                "tag": { "type": "string", "maxLength": 32 },
                "pinned": { "type": "boolean" },
                "body": { "type": "string", "minLength": 1, "maxLength": 2048 }
              }
            }
          }
        }
      }
    },
    {
      "id": "snippet.save",
      "title": "保存片段",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "id", "title", "tag", "pinned", "body"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "id": { "type": "string", "minLength": 1, "maxLength": 48 },
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "tag": { "type": "string", "maxLength": 32 },
          "pinned": { "type": "boolean" },
          "body": { "type": "string", "minLength": 1, "maxLength": 2048 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["saved", "conflict", "limit", "invalid_input"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    },
    {
      "id": "snippet.delete",
      "title": "删除片段",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "id"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "id": { "type": "string", "minLength": 1, "maxLength": 48 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["deleted", "not_found", "conflict"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    }
  ],
  "tools": [
    {
      "id": "snippet.search",
      "title": "检索常用片段",
      "description": "按关键词或标签搜索当前账号收藏的代码片段、命令或回复话术。",
      "permissions": ["data.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "keyword": { "type": "string", "maxLength": 64 },
          "tag": { "type": "string", "maxLength": 32 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["success", "status", "snippets"],
        "properties": {
          "success": { "type": "boolean" },
          "status": { "type": "string", "enum": ["ready", "storage_error"] },
          "snippets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title", "tag", "pinned", "body"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 48 },
                "title": { "type": "string", "minLength": 1, "maxLength": 80 },
                "tag": { "type": "string", "maxLength": 32 },
                "pinned": { "type": "boolean" },
                "body": { "type": "string", "minLength": 1, "maxLength": 2048 }
              }
            }
          }
        }
      }
    }
  ],
  "data": [
    { "collection": "snippets", "scope": "account", "schema_version": 1 }
  ],
  "http": [],
  "tasks": [],
  "files": []
}
