{
  "manifest_version": 2,
  "plugin_id": "novel-studio",
  "name": "AI 长篇小说开发系统",
  "version": "2.0.0",
  "host_api": 2,
  "backend": "backend/index.js",
  "page": "ui/index.html",
  "ui": {
    "icon": "edit",
    "surfaces": ["workspace", "chat"]
  },
  "permissions": ["data.read", "data.write", "workspace.fs.read", "workspace.fs.write"],
  "actions": [
    {
      "id": "novel.bootstrap",
      "title": "读取小说工作台总览",
      "permissions": ["data.read"],
      "input_schema": { "type": "object", "additionalProperties": false, "required": [], "properties": {} },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revision", "book", "characters", "relations", "lore", "threads", "stored_chapter_keys"],
        "properties": {
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "stored_chapter_keys": {
            "type": "array",
            "items": { "type": "string", "maxLength": 64 }
          },
          "book": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "genre", "logline", "target_words", "total_words", "chapters"],
            "properties": {
              "title": { "type": "string", "maxLength": 100 },
              "genre": { "type": "string", "maxLength": 40 },
              "logline": { "type": "string", "maxLength": 400 },
              "target_words": { "type": "integer", "minimum": 1000, "maximum": 10000000 },
              "total_words": { "type": "integer", "minimum": 0, "maximum": 10000000 },
              "chapters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "volume", "order", "title", "status", "tension", "pov", "word_count", "summary"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1, "maxLength": 48 },
                    "volume": { "type": "string", "maxLength": 60 },
                    "order": { "type": "integer", "minimum": 1, "maximum": 9999 },
                    "title": { "type": "string", "minLength": 1, "maxLength": 100 },
                    "status": { "type": "string", "enum": ["draft", "revising", "done"] },
                    "tension": { "type": "integer", "minimum": 1, "maximum": 10 },
                    "pov": { "type": "string", "maxLength": 40 },
                    "word_count": { "type": "integer", "minimum": 0, "maximum": 200000 },
                    "summary": { "type": "string", "maxLength": 240 },
                    "fs_path": { "type": ["string", "null"], "maxLength": 512 },
                    "fs_sha256": { "type": ["string", "null"], "maxLength": 64 }
                  }
                }
              }
            }
          },
          "characters": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "role", "faction", "traits", "goal", "secret"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 48 },
                "name": { "type": "string", "minLength": 1, "maxLength": 40 },
                "role": { "type": "string", "enum": ["protagonist", "antagonist", "supporting", "mentor"] },
                "faction": { "type": "string", "maxLength": 40 },
                "traits": { "type": "string", "maxLength": 120 },
                "goal": { "type": "string", "maxLength": 200 },
                "secret": { "type": "string", "maxLength": 200 }
              }
            }
          },
          "relations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "from", "to", "kind", "label"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 48 },
                "from": { "type": "string", "minLength": 1, "maxLength": 48 },
                "to": { "type": "string", "minLength": 1, "maxLength": 48 },
                "kind": { "type": "string", "enum": ["ally", "rival", "mentor", "romance", "secret"] },
                "label": { "type": "string", "maxLength": 40 }
              }
            }
          },
          "lore": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "category", "title", "detail"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 48 },
                "category": { "type": "string", "enum": ["location", "faction", "magic_tech", "artifact", "history"] },
                "title": { "type": "string", "minLength": 1, "maxLength": 64 },
                "detail": { "type": "string", "maxLength": 400 }
              }
            }
          },
          "threads": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title", "planted_ch", "payoff_ch", "status", "priority", "detail"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 48 },
                "title": { "type": "string", "minLength": 1, "maxLength": 80 },
                "planted_ch": { "type": "integer", "minimum": 1, "maximum": 9999 },
                "payoff_ch": { "type": "integer", "minimum": 0, "maximum": 9999 },
                "status": { "type": "string", "enum": ["planted", "hinted", "payoff", "abandoned"] },
                "priority": { "type": "string", "enum": ["critical", "major", "minor"] },
                "detail": { "type": "string", "maxLength": 240 }
              }
            }
          }
        }
      }
    },
    {
      "id": "novel.book.save",
      "title": "更新书籍基本信息",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "title", "genre", "logline", "target_words"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "title": { "type": "string", "minLength": 1, "maxLength": 100 },
          "genre": { "type": "string", "maxLength": 40 },
          "logline": { "type": "string", "maxLength": 400 },
          "target_words": { "type": "integer", "minimum": 1000, "maximum": 10000000 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["saved", "conflict", "invalid_input"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    },
    {
      "id": "novel.chapter.get",
      "title": "读取章节完整正文",
      "permissions": ["data.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 48 } }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["found", "revision"],
        "properties": {
          "found": { "type": "boolean" },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "body": { "type": "string", "maxLength": 80000 },
          "beats": { "type": "string", "maxLength": 4000 },
          "notes": { "type": "string", "maxLength": 4000 },
          "fs_path": { "type": ["string", "null"], "maxLength": 512 },
          "fs_sha256": { "type": ["string", "null"], "maxLength": 64 }
        }
      }
    },
    {
      "id": "novel.chapter.save",
      "title": "保存章节元数据与正文",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "id", "volume", "title", "status", "tension", "pov", "summary", "beats", "notes", "body"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "id": { "type": "string", "minLength": 1, "maxLength": 48 },
          "volume": { "type": "string", "maxLength": 60 },
          "title": { "type": "string", "minLength": 1, "maxLength": 100 },
          "status": { "type": "string", "enum": ["draft", "revising", "done"] },
          "tension": { "type": "integer", "minimum": 1, "maximum": 10 },
          "pov": { "type": "string", "maxLength": 40 },
          "summary": { "type": "string", "maxLength": 240 },
          "beats": { "type": "string", "maxLength": 4000 },
          "notes": { "type": "string", "maxLength": 4000 },
          "body": { "type": "string", "maxLength": 80000 },
          "fs_path": { "type": ["string", "null"], "maxLength": 512 },
          "fs_sha256": { "type": ["string", "null"], "maxLength": 64 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["saved", "conflict", "limit", "invalid_input"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "word_count": { "type": "integer", "minimum": 0, "maximum": 200000 }
        }
      }
    },
    {
      "id": "novel.chapter.delete",
      "title": "删除章节并清理分章正文",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "id"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "id": { "type": "string", "minLength": 1, "maxLength": 48 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["deleted", "not_found", "conflict"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    },
    {
      "id": "novel.world.save",
      "title": "保存人物、关系或世界观设定",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "characters", "relations", "lore"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "characters": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "role", "faction", "traits", "goal", "secret"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 48 },
                "name": { "type": "string", "minLength": 1, "maxLength": 40 },
                "role": { "type": "string", "enum": ["protagonist", "antagonist", "supporting", "mentor"] },
                "faction": { "type": "string", "maxLength": 40 },
                "traits": { "type": "string", "maxLength": 120 },
                "goal": { "type": "string", "maxLength": 200 },
                "secret": { "type": "string", "maxLength": 200 }
              }
            }
          },
          "relations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "from", "to", "kind", "label"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 48 },
                "from": { "type": "string", "minLength": 1, "maxLength": 48 },
                "to": { "type": "string", "minLength": 1, "maxLength": 48 },
                "kind": { "type": "string", "enum": ["ally", "rival", "mentor", "romance", "secret"] },
                "label": { "type": "string", "maxLength": 40 }
              }
            }
          },
          "lore": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "category", "title", "detail"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 48 },
                "category": { "type": "string", "enum": ["location", "faction", "magic_tech", "artifact", "history"] },
                "title": { "type": "string", "minLength": 1, "maxLength": 64 },
                "detail": { "type": "string", "maxLength": 400 }
              }
            }
          }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["saved", "conflict", "limit"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    },
    {
      "id": "novel.plot.save",
      "title": "保存伏笔与线索追踪表",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "threads"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "threads": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title", "planted_ch", "payoff_ch", "status", "priority", "detail"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 48 },
                "title": { "type": "string", "minLength": 1, "maxLength": 80 },
                "planted_ch": { "type": "integer", "minimum": 1, "maximum": 9999 },
                "payoff_ch": { "type": "integer", "minimum": 0, "maximum": 9999 },
                "status": { "type": "string", "enum": ["planted", "hinted", "payoff", "abandoned"] },
                "priority": { "type": "string", "enum": ["critical", "major", "minor"] },
                "detail": { "type": "string", "maxLength": 240 }
              }
            }
          }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["saved", "conflict", "limit"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    },
    {
      "id": "novel.seed_demo",
      "title": "加载演示长篇项目",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["seeded", "conflict"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    },
    {
      "id": "novel.fs_list",
      "title": "浏览项目工作区目录",
      "permissions": ["workspace.fs.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "path": { "type": "string", "maxLength": 512 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
          "cursor": { "type": "string", "maxLength": 128 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "entries", "next_cursor"],
        "properties": {
          "path": { "type": "string", "maxLength": 512 },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "path", "kind", "size_bytes"],
              "properties": {
                "name": { "type": "string", "maxLength": 255 },
                "path": { "type": "string", "maxLength": 1024 },
                "kind": { "type": "string", "enum": ["file", "dir"] },
                "size_bytes": { "type": ["integer", "null"], "minimum": 0, "maximum": 1073741824 }
              }
            }
          },
          "next_cursor": { "type": ["string", "null"], "maxLength": 128 }
        }
      }
    },
    {
      "id": "novel.fs_stat",
      "title": "检查工作区文件元数据与摘要",
      "permissions": ["workspace.fs.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "size_bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "maxLength": 512 },
          "kind": { "type": "string", "enum": ["file", "dir"] },
          "size_bytes": { "type": ["integer", "null"], "minimum": 0, "maximum": 1073741824 },
          "sha256": { "type": ["string", "null"], "maxLength": 64 }
        }
      }
    },
    {
      "id": "novel.fs_import_chapter",
      "title": "从项目工作区导入章节 Markdown",
      "permissions": ["workspace.fs.read", "data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "path"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "path": { "type": "string", "minLength": 1, "maxLength": 512 },
          "id": { "type": "string", "minLength": 1, "maxLength": 48 },
          "volume": { "type": "string", "maxLength": 60 },
          "title": { "type": "string", "maxLength": 100 },
          "pov": { "type": "string", "maxLength": 40 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["imported", "conflict", "limit", "invalid_input"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "id": { "type": "string", "maxLength": 48 },
          "title": { "type": "string", "maxLength": 100 },
          "word_count": { "type": "integer", "minimum": 0, "maximum": 200000 },
          "fs_path": { "type": "string", "maxLength": 512 },
          "fs_sha256": { "type": "string", "maxLength": 64 },
          "size_bytes": { "type": "integer", "minimum": 0, "maximum": 1048576 }
        }
      }
    },
    {
      "id": "novel.fs_export_chapter",
      "title": "原子导出章节手稿到项目工作区 (CAS)",
      "permissions": ["workspace.fs.write", "data.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 48 },
          "path": { "type": "string", "minLength": 1, "maxLength": 512 },
          "create_only": { "type": "boolean" },
          "expected_sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
          "include_header": { "type": "boolean" }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "path"],
        "properties": {
          "status": { "type": "string", "enum": ["exported", "conflict", "not_found", "invalid_input"] },
          "path": { "type": "string", "maxLength": 512 },
          "size_bytes": { "type": "integer", "minimum": 0, "maximum": 1048576 },
          "sha256": { "type": "string", "maxLength": 64 },
          "message": { "type": "string", "maxLength": 240 }
        }
      }
    },
    {
      "id": "document.list",
      "title": "列出可导出内容",
      "permissions": ["data.read"],
      "input_schema": { "type": "object", "additionalProperties": false, "required": [], "properties": {} },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 48 },
                "label": { "type": "string", "minLength": 1, "maxLength": 120 }
              }
            }
          }
        }
      }
    },
    {
      "id": "document.export",
      "title": "导出大纲设定或单章",
      "permissions": ["data.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 48 } }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "filename": { "type": "string", "maxLength": 80 },
          "text": { "type": "string", "maxLength": 120000 },
          "error": { "type": "string", "maxLength": 64 }
        }
      }
    },
    {
      "id": "document.import",
      "title": "导入小说设定或章节 JSON",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": { "text": { "type": "string", "minLength": 2, "maxLength": 120000 } }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["imported"],
        "properties": {
          "imported": { "type": "boolean" },
          "reason": { "type": "string", "maxLength": 64 }
        }
      }
    }
  ],
  "tools": [
    {
      "id": "novel.get_story_context",
      "title": "读取小说全书设定、章节大纲与未回收伏笔",
      "description": "读取当前项目长篇小说的书目元数据、分卷章节大纲（含同步文件路径）、核心人物、世界观词条及未回收伏笔，可选读取指定章节正文。",
      "permissions": ["data.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "chapter_id": { "type": "string", "minLength": 1, "maxLength": 48 },
          "include_body": { "type": "boolean" }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["success", "status"],
        "properties": {
          "success": { "type": "boolean" },
          "status": { "type": "string", "enum": ["ready", "empty", "chapter_not_found"] },
          "title": { "type": "string", "maxLength": 100 },
          "genre": { "type": "string", "maxLength": 40 },
          "logline": { "type": "string", "maxLength": 400 },
          "total_words": { "type": "integer", "minimum": 0, "maximum": 10000000 },
          "chapters": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "volume", "order", "title", "status", "tension", "pov", "word_count", "summary"],
              "properties": {
                "id": { "type": "string", "maxLength": 48 },
                "volume": { "type": "string", "maxLength": 60 },
                "order": { "type": "integer", "minimum": 1, "maximum": 9999 },
                "title": { "type": "string", "maxLength": 100 },
                "status": { "type": "string", "enum": ["draft", "revising", "done"] },
                "tension": { "type": "integer", "minimum": 1, "maximum": 10 },
                "pov": { "type": "string", "maxLength": 40 },
