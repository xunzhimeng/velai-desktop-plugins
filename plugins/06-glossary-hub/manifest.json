{
  "manifest_version": 1,
  "plugin_id": "glossary-hub",
  "name": "项目术语表",
  "version": "1.0.0",
  "host_api": 1,
  "backend": "backend/index.js",
  "page": "ui/index.html",
  "ui": {
    "icon": "text",
    "surfaces": ["workspace", "chat"]
  },
  "permissions": ["data.read", "data.write"],
  "actions": [
    {
      "id": "glossary.list",
      "title": "读取项目术语列表",
      "permissions": ["data.read"],
      "input_schema": { "type": "object", "additionalProperties": false, "required": [], "properties": {} },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revision", "terms"],
        "properties": {
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "terms": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["term", "alias", "domain", "definition"],
              "properties": {
                "term": { "type": "string", "minLength": 1, "maxLength": 64 },
                "alias": { "type": "string", "maxLength": 80 },
                "domain": { "type": "string", "maxLength": 40 },
                "definition": { "type": "string", "minLength": 1, "maxLength": 400 }
              }
            }
          }
        }
      }
    },
    {
      "id": "glossary.save",
      "title": "保存术语定义",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "term", "alias", "domain", "definition"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "term": { "type": "string", "minLength": 1, "maxLength": 64 },
          "alias": { "type": "string", "maxLength": 80 },
          "domain": { "type": "string", "maxLength": 40 },
          "definition": { "type": "string", "minLength": 1, "maxLength": 400 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["saved", "conflict", "limit", "invalid_input"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    },
    {
      "id": "glossary.delete",
      "title": "删除术语",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "term"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "term": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["deleted", "not_found", "conflict"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    },
    {
      "id": "document.list",
      "title": "列出可导出的术语表",
      "permissions": ["data.read"],
      "input_schema": { "type": "object", "additionalProperties": false, "required": [], "properties": {} },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 32 },
                "label": { "type": "string", "minLength": 1, "maxLength": 80 }
              }
            }
          }
        }
      }
    },
    {
      "id": "document.export",
      "title": "导出术语表 JSON",
      "permissions": ["data.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 32 } }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "filename": { "type": "string", "maxLength": 64 },
          "text": { "type": "string", "maxLength": 12288 },
          "error": { "type": "string", "maxLength": 64 }
        }
      }
    },
    {
      "id": "document.import",
      "title": "导入术语表 JSON",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": { "text": { "type": "string", "minLength": 2, "maxLength": 12288 } }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["imported"],
        "properties": {
          "imported": { "type": "boolean" },
          "reason": { "type": "string", "maxLength": 64 }
        }
      }
    }
  ],
  "tools": [
    {
      "id": "glossary.lookup",
      "title": "查询项目术语定义",
      "description": "按术语、英文缩写或领域查询当前项目的标准名词解释，避免业务语义歧义。",
      "permissions": ["data.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "query": { "type": "string", "maxLength": 64 },
          "domain": { "type": "string", "maxLength": 40 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["success", "status", "terms"],
        "properties": {
          "success": { "type": "boolean" },
          "status": { "type": "string", "enum": ["ready", "storage_error"] },
          "terms": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["term", "alias", "domain", "definition"],
              "properties": {
                "term": { "type": "string", "minLength": 1, "maxLength": 64 },
                "alias": { "type": "string", "maxLength": 80 },
                "domain": { "type": "string", "maxLength": 40 },
                "definition": { "type": "string", "minLength": 1, "maxLength": 400 }
              }
            }
          }
        }
      }
    },
    {
      "id": "glossary.upsert",
      "title": "登记项目术语",
      "description": "向当前项目术语表新增或更新一条专业名词及其解释。",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "definition"],
        "properties": {
          "term": { "type": "string", "minLength": 1, "maxLength": 64 },
          "alias": { "type": "string", "maxLength": 80 },
          "domain": { "type": "string", "maxLength": 40 },
          "definition": { "type": "string", "minLength": 1, "maxLength": 400 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["success", "status"],
        "properties": {
          "success": { "type": "boolean" },
          "status": { "type": "string", "enum": ["saved", "conflict", "limit", "invalid_input"] }
        }
      }
    }
  ],
  "data": [
    { "collection": "glossary", "scope": "project", "schema_version": 1 }
  ],
  "http": [],
  "tasks": [],
  "files": []
}
