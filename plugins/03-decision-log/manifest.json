{
  "manifest_version": 1,
  "plugin_id": "decision-log",
  "name": "项目决策记录 (ADR)",
  "version": "1.0.0",
  "host_api": 1,
  "backend": "backend/index.js",
  "page": "ui/index.html",
  "ui": {
    "icon": "edit",
    "surfaces": ["workspace", "chat"]
  },
  "permissions": ["data.read", "data.write"],
  "actions": [
    {
      "id": "adr.list",
      "title": "读取项目决策记录",
      "permissions": ["data.read"],
      "input_schema": { "type": "object", "additionalProperties": false, "required": [], "properties": {} },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revision", "records"],
        "properties": {
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title", "status", "context", "decision", "consequences", "date"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 24 },
                "title": { "type": "string", "minLength": 1, "maxLength": 100 },
                "status": { "type": "string", "enum": ["proposed", "accepted", "superseded", "deprecated"] },
                "context": { "type": "string", "maxLength": 600 },
                "decision": { "type": "string", "minLength": 1, "maxLength": 600 },
                "consequences": { "type": "string", "maxLength": 600 },
                "date": { "type": "string", "minLength": 10, "maxLength": 10 }
              }
            }
          }
        }
      }
    },
    {
      "id": "adr.save",
      "title": "保存决策记录",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "id", "title", "status", "context", "decision", "consequences"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "id": { "type": "string", "minLength": 1, "maxLength": 24 },
          "title": { "type": "string", "minLength": 1, "maxLength": 100 },
          "status": { "type": "string", "enum": ["proposed", "accepted", "superseded", "deprecated"] },
          "context": { "type": "string", "maxLength": 600 },
          "decision": { "type": "string", "minLength": 1, "maxLength": 600 },
          "consequences": { "type": "string", "maxLength": 600 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["saved", "conflict", "limit", "invalid_input"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "id": { "type": "string", "maxLength": 24 }
        }
      }
    },
    {
      "id": "adr.delete",
      "title": "删除决策记录",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "id"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "id": { "type": "string", "minLength": 1, "maxLength": 24 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["deleted", "not_found", "conflict"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    },
    {
      "id": "document.list",
      "title": "列出可导出的 ADR",
      "permissions": ["data.read"],
      "input_schema": { "type": "object", "additionalProperties": false, "required": [], "properties": {} },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 24 },
                "label": { "type": "string", "minLength": 1, "maxLength": 140 }
              }
            }
          }
        }
      }
    },
    {
      "id": "document.export",
      "title": "导出单条 ADR",
      "permissions": ["data.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 24 } }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "filename": { "type": "string", "maxLength": 64 },
          "text": { "type": "string", "maxLength": 8192 },
          "error": { "type": "string", "maxLength": 64 }
        }
      }
    },
    {
      "id": "document.import",
      "title": "导入 ADR JSON",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": { "text": { "type": "string", "minLength": 2, "maxLength": 8192 } }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["imported"],
        "properties": {
          "imported": { "type": "boolean" },
          "reason": { "type": "string", "maxLength": 64 }
        }
      }
    }
  ],
  "tools": [
    {
      "id": "decision.list",
      "title": "查询项目架构决策",
      "description": "检索当前项目已记录的架构与产品决策 (ADR)，支持按状态或关键词过滤。",
      "permissions": ["data.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "status": { "type": "string", "enum": ["proposed", "accepted", "superseded", "deprecated"] },
          "keyword": { "type": "string", "maxLength": 64 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["success", "status", "records"],
        "properties": {
          "success": { "type": "boolean" },
          "status": { "type": "string", "enum": ["ready", "storage_error"] },
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title", "status", "decision", "date"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 24 },
                "title": { "type": "string", "minLength": 1, "maxLength": 100 },
                "status": { "type": "string", "enum": ["proposed", "accepted", "superseded", "deprecated"] },
                "decision": { "type": "string", "minLength": 1, "maxLength": 600 },
                "date": { "type": "string", "minLength": 10, "maxLength": 10 }
              }
            }
          }
        }
      }
    },
    {
      "id": "decision.record",
      "title": "新增项目架构决策",
      "description": "向当前项目 ADR 台账新增一条决策记录，自动分配 ADR-NNN 编号。",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "decision"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 100 },
          "status": { "type": "string", "enum": ["proposed", "accepted", "superseded", "deprecated"] },
          "context": { "type": "string", "maxLength": 600 },
          "decision": { "type": "string", "minLength": 1, "maxLength": 600 },
          "consequences": { "type": "string", "maxLength": 600 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["success", "status"],
        "properties": {
          "success": { "type": "boolean" },
          "status": { "type": "string", "enum": ["saved", "conflict", "limit", "invalid_input"] },
          "id": { "type": "string", "maxLength": 24 }
        }
      }
    }
  ],
  "data": [
    { "collection": "decisions", "scope": "project", "schema_version": 1 }
  ],
  "http": [],
  "tasks": [],
  "files": []
}
