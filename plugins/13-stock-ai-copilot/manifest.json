{
  "manifest_version": 2,
  "plugin_id": "stock-ai-copilot",
  "name": "股票 AI 流式投研副驾驶",
  "version": "2.0.0",
  "host_api": 2,
  "backend": "backend/index.js",
  "page": "ui/index.html",
  "ui": {
    "icon": "table",
    "surfaces": ["workspace"]
  },
  "permissions": ["ai.complete"],
  "ai": {
    "model": "gpt/gpt-6.2-astra",
    "max_output_tokens": 1024,
    "max_call_microcredits": 50000,
    "max_day_microcredits": 500000
  },
  "actions": [
    {
      "id": "copilot.stream_memo",
      "title": "流式生成股票深度投研备忘录",
      "permissions": ["ai.complete"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "ticker", "company_name", "thesis_context"],
        "properties": {
          "request_id": { "type": "string", "minLength": 36, "maxLength": 36 },
          "ticker": { "type": "string", "minLength": 1, "maxLength": 24 },
          "company_name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "market": { "type": "string", "enum": ["US", "HK", "CN", "GLOBAL"] },
          "horizon": { "type": "string", "enum": ["short", "medium", "long"] },
          "focus": { "type": "string", "enum": ["comprehensive", "earnings", "valuation", "moat", "risk"] },
          "financial_snapshot": { "type": "string", "maxLength": 1800 },
          "thesis_context": { "type": "string", "minLength": 1, "maxLength": 3200 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "status", "prompt_bytes"],
        "properties": {
          "request_id": { "type": "string", "minLength": 36, "maxLength": 36 },
          "status": { "type": "string", "enum": ["started"] },
          "prompt_bytes": { "type": "integer", "minimum": 1, "maximum": 8192 }
        }
      }
    },
    {
      "id": "copilot.rating_json",
      "title": "生成结构化 JSON 多空评级矩阵",
      "permissions": ["ai.complete"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "ticker", "company_name", "thesis_context"],
        "properties": {
          "request_id": { "type": "string", "minLength": 36, "maxLength": 36 },
          "ticker": { "type": "string", "minLength": 1, "maxLength": 24 },
          "company_name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "market": { "type": "string", "enum": ["US", "HK", "CN", "GLOBAL"] },
          "current_price": { "type": ["number", "null"], "minimum": 0 },
          "financial_snapshot": { "type": "string", "maxLength": 1800 },
          "thesis_context": { "type": "string", "minLength": 1, "maxLength": 3200 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "model", "rating", "input_tokens", "output_tokens", "cost_microcredits"],
        "properties": {
          "request_id": { "type": "string", "minLength": 36, "maxLength": 36 },
          "model": { "type": "string", "minLength": 1, "maxLength": 128 },
          "rating": { "type": ["object", "null"], "additionalProperties": true },
          "input_tokens": { "type": "integer", "minimum": 0 },
          "output_tokens": { "type": "integer", "minimum": 0 },
          "cost_microcredits": { "type": "integer", "minimum": 0 }
        }
      }
    },
    {
      "id": "copilot.cancel",
      "title": "取消进行中的流式投研请求",
      "permissions": ["ai.complete"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id"],
        "properties": {
          "request_id": { "type": "string", "minLength": 36, "maxLength": 36 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "status"],
        "properties": {
          "request_id": { "type": "string", "minLength": 36, "maxLength": 36 },
          "status": { "type": "string", "enum": ["cancel_requested"] }
        }
      }
    }
  ],
  "tools": [],
  "data": [],
  "http": [],
  "tasks": [],
  "files": []
}
