{
  "manifest_version": 1,
  "plugin_id": "api-arch-studio",
  "name": "系统架构与 API 契约设计台",
  "version": "1.0.0",
  "host_api": 1,
  "backend": "backend/index.js",
  "page": "ui/index.html",
  "ui": {
    "icon": "app",
    "surfaces": ["workspace", "chat"]
  },
  "permissions": ["data.read", "data.write"],
  "actions": [
    {
      "id": "arch.state",
      "title": "读取项目架构拓扑与接口契约",
      "permissions": ["data.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {}
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revision", "services", "edges", "endpoints", "schemas", "analysis"],
        "properties": {
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "services": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "kind", "owner", "description", "tier"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 40 },
                "name": { "type": "string", "minLength": 1, "maxLength": 60 },
                "kind": { "type": "string", "enum": ["gateway", "service", "db", "queue", "external"] },
                "owner": { "type": "string", "maxLength": 40 },
                "description": { "type": "string", "maxLength": 180 },
                "tier": { "type": "integer", "minimum": 0, "maximum": 4 }
              }
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "from", "to", "protocol", "label"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 48 },
                "from": { "type": "string", "minLength": 1, "maxLength": 40 },
                "to": { "type": "string", "minLength": 1, "maxLength": 40 },
                "protocol": { "type": "string", "enum": ["HTTP", "gRPC", "Event", "SQL", "Cache"] },
                "label": { "type": "string", "maxLength": 60 }
              }
            }
          },
          "endpoints": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "service_id",
                "method",
                "path",
                "summary",
                "auth",
                "status",
                "params",
                "request_schema",
                "response_schema",
                "error_codes"
              ],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 48 },
                "service_id": { "type": "string", "minLength": 1, "maxLength": 40 },
                "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
                "path": { "type": "string", "minLength": 1, "maxLength": 120 },
                "summary": { "type": "string", "minLength": 1, "maxLength": 100 },
                "auth": { "type": "string", "enum": ["none", "bearer", "api_key", "mtls", "oauth2"] },
                "status": { "type": "string", "enum": ["draft", "review", "stable", "deprecated"] },
                "params": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "in", "type", "required", "description"],
                    "properties": {
                      "name": { "type": "string", "minLength": 1, "maxLength": 40 },
                      "in": { "type": "string", "enum": ["path", "query", "header"] },
                      "type": { "type": "string", "enum": ["string", "integer", "number", "boolean"] },
                      "required": { "type": "boolean" },
                      "description": { "type": "string", "maxLength": 100 }
                    }
                  }
                },
                "request_schema": { "type": "string", "maxLength": 48 },
                "response_schema": { "type": "string", "maxLength": 48 },
                "error_codes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["code", "message"],
                    "properties": {
                      "code": { "type": "integer", "minimum": 400, "maximum": 599 },
                      "message": { "type": "string", "minLength": 1, "maxLength": 80 }
                    }
                  }
                }
              }
            }
          },
          "schemas": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "kind", "description", "fields"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 48 },
                "name": { "type": "string", "minLength": 1, "maxLength": 60 },
                "kind": { "type": "string", "enum": ["dto", "entity", "event", "error"] },
                "description": { "type": "string", "maxLength": 160 },
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "type", "item_type", "ref", "required", "description"],
                    "properties": {
                      "name": { "type": "string", "minLength": 1, "maxLength": 40 },
                      "type": { "type": "string", "enum": ["string", "integer", "number", "boolean", "object", "array"] },
                      "item_type": { "type": "string", "maxLength": 48 },
                      "ref": { "type": "string", "maxLength": 48 },
                      "required": { "type": "boolean" },
                      "description": { "type": "string", "maxLength": 100 }
                    }
                  }
                }
              }
            }
          },
          "analysis": {
            "type": "object",
            "additionalProperties": false,
            "required": ["metrics", "cycles", "cycle_edge_ids", "warnings", "stable_ratio"],
            "properties": {
              "metrics": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["service_id", "fan_in", "fan_out", "endpoint_count", "in_cycle"],
                  "properties": {
                    "service_id": { "type": "string", "minLength": 1, "maxLength": 40 },
                    "fan_in": { "type": "integer", "minimum": 0, "maximum": 999 },
                    "fan_out": { "type": "integer", "minimum": 0, "maximum": 999 },
                    "endpoint_count": { "type": "integer", "minimum": 0, "maximum": 999 },
                    "in_cycle": { "type": "boolean" }
                  }
                }
              },
              "cycles": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1, "maxLength": 40 }
                }
              },
              "cycle_edge_ids": {
                "type": "array",
                "items": { "type": "string", "minLength": 1, "maxLength": 48 }
              },
              "warnings": {
                "type": "array",
                "items": { "type": "string", "minLength": 1, "maxLength": 160 }
              },
              "stable_ratio": { "type": "number", "minimum": 0, "maximum": 100 }
            }
          }
        }
      }
    },
    {
      "id": "arch.service.save",
      "title": "保存微服务节点",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "id", "name", "kind", "owner", "description", "tier"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "id": { "type": "string", "minLength": 1, "maxLength": 40 },
          "name": { "type": "string", "minLength": 1, "maxLength": 60 },
          "kind": { "type": "string", "enum": ["gateway", "service", "db", "queue", "external"] },
          "owner": { "type": "string", "maxLength": 40 },
          "description": { "type": "string", "maxLength": 180 },
          "tier": { "type": "integer", "minimum": 0, "maximum": 4 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["saved", "conflict", "limit", "invalid_input"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    },
    {
      "id": "arch.service.delete",
      "title": "删除微服务节点",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "id"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "id": { "type": "string", "minLength": 1, "maxLength": 40 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["deleted", "not_found", "conflict"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    },
    {
      "id": "arch.edge.save",
      "title": "保存服务依赖连线",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "id", "from", "to", "protocol", "label"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "id": { "type": "string", "minLength": 1, "maxLength": 48 },
          "from": { "type": "string", "minLength": 1, "maxLength": 40 },
          "to": { "type": "string", "minLength": 1, "maxLength": 40 },
          "protocol": { "type": "string", "enum": ["HTTP", "gRPC", "Event", "SQL", "Cache"] },
          "label": { "type": "string", "maxLength": 60 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["saved", "service_not_found", "conflict", "limit", "invalid_input"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    },
    {
      "id": "arch.edge.delete",
      "title": "删除服务依赖连线",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "id"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "id": { "type": "string", "minLength": 1, "maxLength": 48 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["deleted", "not_found", "conflict"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    },
    {
      "id": "arch.endpoint.save",
      "title": "保存 API 接口契约",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expected_revision",
          "id",
          "service_id",
          "method",
          "path",
          "summary",
          "auth",
          "status",
          "params",
          "request_schema",
          "response_schema",
          "error_codes"
        ],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "id": { "type": "string", "minLength": 1, "maxLength": 48 },
          "service_id": { "type": "string", "minLength": 1, "maxLength": 40 },
          "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
          "path": { "type": "string", "minLength": 1, "maxLength": 120 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 100 },
          "auth": { "type": "string", "enum": ["none", "bearer", "api_key", "mtls", "oauth2"] },
          "status": { "type": "string", "enum": ["draft", "review", "stable", "deprecated"] },
          "params": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "in", "type", "required", "description"],
              "properties": {
                "name": { "type": "string", "minLength": 1, "maxLength": 40 },
                "in": { "type": "string", "enum": ["path", "query", "header"] },
                "type": { "type": "string", "enum": ["string", "integer", "number", "boolean"] },
                "required": { "type": "boolean" },
                "description": { "type": "string", "maxLength": 100 }
              }
            }
          },
          "request_schema": { "type": "string", "maxLength": 48 },
          "response_schema": { "type": "string", "maxLength": 48 },
          "error_codes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message"],
              "properties": {
                "code": { "type": "integer", "minimum": 400, "maximum": 599 },
                "message": { "type": "string", "minLength": 1, "maxLength": 80 }
              }
            }
          }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["saved", "service_not_found", "conflict", "limit", "invalid_input"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "endpoint_id": { "type": "string", "minLength": 1, "maxLength": 48 }
        }
      }
    },
    {
      "id": "arch.endpoint.delete",
      "title": "删除 API 接口契约",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "id"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "id": { "type": "string", "minLength": 1, "maxLength": 48 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["deleted", "not_found", "conflict"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    },
    {
      "id": "arch.schema.save",
      "title": "保存数据模型 Schema",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "id", "name", "kind", "description", "fields"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "id": { "type": "string", "minLength": 1, "maxLength": 48 },
          "name": { "type": "string", "minLength": 1, "maxLength": 60 },
          "kind": { "type": "string", "enum": ["dto", "entity", "event", "error"] },
          "description": { "type": "string", "maxLength": 160 },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type", "item_type", "ref", "required", "description"],
              "properties": {
                "name": { "type": "string", "minLength": 1, "maxLength": 40 },
                "type": { "type": "string", "enum": ["string", "integer", "number", "boolean", "object", "array"] },
                "item_type": { "type": "string", "maxLength": 48 },
                "ref": { "type": "string", "maxLength": 48 },
                "required": { "type": "boolean" },
                "description": { "type": "string", "maxLength": 100 }
              }
            }
          }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["saved", "conflict", "limit", "invalid_input"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    },
    {
      "id": "arch.schema.delete",
      "title": "删除数据模型 Schema",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "id"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "id": { "type": "string", "minLength": 1, "maxLength": 48 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["deleted", "not_found", "conflict"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    },
    {
      "id": "arch.codegen",
      "title": "实时编译 OpenAPI 3.0 与 TypeScript 契约代码",
      "permissions": ["data.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target"],
        "properties": {
          "target": { "type": "string", "enum": ["openapi", "typescript"] },
          "service_id": { "type": "string", "maxLength": 40 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "code", "endpoint_count", "schema_count", "truncated"],
        "properties": {
          "target": { "type": "string", "enum": ["openapi", "typescript"] },
          "code": { "type": "string", "maxLength": 12288 },
          "endpoint_count": { "type": "integer", "minimum": 0, "maximum": 999 },
          "schema_count": { "type": "integer", "minimum": 0, "maximum": 999 },
          "truncated": { "type": "boolean" }
        }
      }
    },
    {
      "id": "arch.demo.load",
      "title": "载入分布式电商订单与风控架构演示数据",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision", "services_count", "endpoints_count", "schemas_count"],
        "properties": {
          "status": { "type": "string", "enum": ["loaded", "conflict"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "services_count": { "type": "integer", "minimum": 0, "maximum": 99 },
          "endpoints_count": { "type": "integer", "minimum": 0, "maximum": 99 },
          "schemas_count": { "type": "integer", "minimum": 0, "maximum": 99 }
        }
      }
    },
    {
      "id": "document.list",
      "title": "列出可导出的架构与契约快照",
      "permissions": ["data.read"],
      "input_schema": { "type": "object", "additionalProperties": false, "required": [], "properties": {} },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 64 },
                "label": { "type": "string", "minLength": 1, "maxLength": 120 }
              }
            }
          },
          "error": { "type": "string", "maxLength": 64 }
        }
      }
    },
    {
      "id": "document.export",
      "title": "导出项目架构与 API 契约 JSON",
      "permissions": ["data.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "filename": { "type": "string", "maxLength": 80 },
          "text": { "type": "string", "maxLength": 12288 },
          "error": { "type": "string", "maxLength": 64 }
        }
      }
    },
    {
      "id": "document.import",
      "title": "导入项目架构与 API 契约 JSON",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "minLength": 2, "maxLength": 12288 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["imported"],
        "properties": {
          "imported": { "type": "boolean" },
          "reason": { "type": "string", "maxLength": 64 },
          "services_count": { "type": "integer", "minimum": 0, "maximum": 99 },
          "endpoints_count": { "type": "integer", "minimum": 0, "maximum": 99 },
          "schemas_count": { "type": "integer", "minimum": 0, "maximum": 99 }
        }
      }
    }
  ],
  "tools": [
    {
      "id": "arch.topology",
      "title": "读取项目服务拓扑与接口清单",
      "description": "获取当前项目的微服务架构拓扑、各节点扇入/扇出耦合度、循环依赖告警以及 API 接口契约清单。",
      "permissions": ["data.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "service_id": { "type": "string", "maxLength": 40, "description": "可选：按服务 ID 筛选接口清单" }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "success",
          "status",
          "service_count",
          "edge_count",
          "endpoint_count",
          "cycles",
          "warnings",
          "services",
          "endpoints"
        ],
        "properties": {
          "success": { "type": "boolean" },
          "status": { "type": "string", "enum": ["ready", "empty"] },
          "service_count": { "type": "integer", "minimum": 0, "maximum": 99 },
          "edge_count": { "type": "integer", "minimum": 0, "maximum": 99 },
          "endpoint_count": { "type": "integer", "minimum": 0, "maximum": 99 },
          "cycles": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 40 }
            }
          },
          "warnings": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 160 }
          },
          "services": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "kind", "fan_in", "fan_out", "in_cycle", "endpoint_count"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 40 },
                "name": { "type": "string", "minLength": 1, "maxLength": 60 },
                "kind": { "type": "string", "enum": ["gateway", "service", "db", "queue", "external"] },
                "fan_in": { "type": "integer", "minimum": 0, "maximum": 999 },
