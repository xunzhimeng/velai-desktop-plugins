{
  "manifest_version": 1,
  "plugin_id": "meeting-minutes",
  "name": "会议纪要工作台",
  "version": "1.0.0",
  "host_api": 1,
  "backend": "backend/index.js",
  "page": "ui/index.html",
  "ui": {
    "icon": "chat",
    "surfaces": ["workspace", "chat", "assistant"]
  },
  "permissions": ["data.read", "data.write", "tasks.start", "tasks.read", "tasks.cancel"],
  "actions": [
    {
      "id": "minutes.read",
      "title": "读取会议纪要列表",
      "permissions": ["data.read"],
      "input_schema": { "type": "object", "additionalProperties": false, "required": [], "properties": {} },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revision", "meetings"],
        "properties": {
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "meetings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title", "date", "attendees", "raw_notes", "summary"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 48 },
                "title": { "type": "string", "minLength": 1, "maxLength": 100 },
                "date": { "type": "string", "minLength": 10, "maxLength": 10 },
                "attendees": { "type": "string", "maxLength": 160 },
                "raw_notes": { "type": "string", "maxLength": 3072 },
                "summary": { "type": "string", "maxLength": 3072 }
              }
            }
          }
        }
      }
    },
    {
      "id": "minutes.save",
      "title": "保存会议记录",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "id", "title", "date", "attendees", "raw_notes", "summary"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "id": { "type": "string", "minLength": 1, "maxLength": 48 },
          "title": { "type": "string", "minLength": 1, "maxLength": 100 },
          "date": { "type": "string", "minLength": 10, "maxLength": 10 },
          "attendees": { "type": "string", "maxLength": 160 },
          "raw_notes": { "type": "string", "maxLength": 3072 },
          "summary": { "type": "string", "maxLength": 3072 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["saved", "conflict", "limit", "invalid_input"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    },
    {
      "id": "minutes.delete",
      "title": "删除会议记录",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "id"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "id": { "type": "string", "minLength": 1, "maxLength": 48 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["deleted", "not_found", "conflict"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    },
    {
      "id": "session.turn.request",
      "title": "交给当前会话提炼纪要",
      "permissions": ["tasks.start"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prompt", "work_id"],
        "properties": {
          "prompt": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "work_id": { "type": "string", "minLength": 36, "maxLength": 36 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "state"],
        "properties": {
          "task_id": { "type": "string", "minLength": 36, "maxLength": 36 },
          "state": { "type": "string", "enum": ["dispatching"] }
        }
      }
    },
    {
      "id": "session.turn.result",
      "title": "核对纪要提炼结果",
      "permissions": ["tasks.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["work_id"],
        "properties": {
          "work_id": { "type": "string", "minLength": 36, "maxLength": 36 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": true,
        "required": ["work_id", "state", "truncated"],
        "properties": {
          "work_id": { "type": "string", "minLength": 36, "maxLength": 36 },
          "state": { "type": "string", "enum": ["dispatching", "running", "waiting", "completed", "cancelled", "failed", "unknown", "unavailable"] },
          "truncated": { "type": "boolean" }
        }
      }
    }
  ],
  "tools": [
    {
      "id": "minutes.list",
      "title": "查询历史会议纪要",
      "description": "按关键词检索已保存的会议主题、日期、参会人与结构化纪要摘要。",
      "permissions": ["data.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "keyword": { "type": "string", "maxLength": 64 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["success", "status", "meetings"],
        "properties": {
          "success": { "type": "boolean" },
          "status": { "type": "string", "enum": ["ready", "storage_error"] },
          "meetings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title", "date", "attendees", "summary"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 48 },
                "title": { "type": "string", "minLength": 1, "maxLength": 100 },
                "date": { "type": "string", "minLength": 10, "maxLength": 10 },
                "attendees": { "type": "string", "maxLength": 160 },
                "summary": { "type": "string", "maxLength": 3072 }
              }
            }
          }
        }
      }
    }
  ],
  "data": [
    { "collection": "minutes", "scope": "account", "schema_version": 1 }
  ],
  "http": [],
  "tasks": [],
  "files": []
}
