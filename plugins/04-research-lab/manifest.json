{
  "manifest_version": 1,
  "plugin_id": "research-lab",
  "name": "AI 学术科研与文献综述工作台",
  "version": "1.0.0",
  "host_api": 1,
  "backend": "backend/index.js",
  "page": "ui/index.html",
  "ui": {
    "icon": "text",
    "surfaces": ["workspace", "chat", "assistant"]
  },
  "permissions": ["data.read", "data.write", "tasks.start", "tasks.read", "tasks.cancel"],
  "actions": [
    {
      "id": "lab.load",
      "title": "加载文献库、对比矩阵与科研笔记总览",
      "permissions": ["data.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {}
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revision", "kpi", "papers", "matrix", "notes"],
        "properties": {
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "kpi": {
            "type": "object",
            "additionalProperties": false,
            "required": ["total_papers", "annotated_or_cited", "citation_edges", "total_notes", "avg_rating"],
            "properties": {
              "total_papers": { "type": "integer", "minimum": 0, "maximum": 128 },
              "annotated_or_cited": { "type": "integer", "minimum": 0, "maximum": 128 },
              "citation_edges": { "type": "integer", "minimum": 0, "maximum": 1024 },
              "total_notes": { "type": "integer", "minimum": 0, "maximum": 128 },
              "avg_rating": { "type": "number", "minimum": 0, "maximum": 5 }
            }
          },
          "papers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title", "authors", "year", "venue", "tags", "rating", "status", "method", "contribution", "limitations", "cites"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 40 },
                "title": { "type": "string", "minLength": 1, "maxLength": 160 },
                "authors": { "type": "string", "maxLength": 120 },
                "year": { "type": "integer", "minimum": 1950, "maximum": 2100 },
                "venue": { "type": "string", "maxLength": 48 },
                "tags": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1, "maxLength": 24 }
                },
                "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
                "status": { "type": "string", "enum": ["unread", "reading", "annotated", "cited"] },
                "method": { "type": "string", "maxLength": 260 },
                "contribution": { "type": "string", "maxLength": 260 },
                "limitations": { "type": "string", "maxLength": 260 },
                "cites": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1, "maxLength": 40 }
                }
              }
            }
          },
          "matrix": {
            "type": "object",
            "additionalProperties": false,
            "required": ["selected_ids", "rows"],
            "properties": {
              "selected_ids": {
                "type": "array",
                "items": { "type": "string", "minLength": 1, "maxLength": 40 }
              },
              "rows": {
                "type": "object",
                "additionalProperties": true
              }
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title", "mode", "paper_ids", "created_at", "preview"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 40 },
                "title": { "type": "string", "minLength": 1, "maxLength": 100 },
                "mode": { "type": "string", "enum": ["related_work", "research_gaps", "experiment_plan", "peer_review", "custom"] },
                "paper_ids": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1, "maxLength": 40 }
                },
                "created_at": { "type": "string", "maxLength": 24 },
                "preview": { "type": "string", "maxLength": 180 }
              }
            }
          }
        }
      }
    },
    {
      "id": "paper.save",
      "title": "新增或更新文献条目及引用关系",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "id", "title", "authors", "year", "venue", "tags", "rating", "status", "method", "contribution", "limitations", "cites"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "id": { "type": "string", "minLength": 1, "maxLength": 40 },
          "title": { "type": "string", "minLength": 1, "maxLength": 160 },
          "authors": { "type": "string", "maxLength": 120 },
          "year": { "type": "integer", "minimum": 1950, "maximum": 2100 },
          "venue": { "type": "string", "maxLength": 48 },
          "tags": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 24 }
          },
          "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
          "status": { "type": "string", "enum": ["unread", "reading", "annotated", "cited"] },
          "method": { "type": "string", "maxLength": 260 },
          "contribution": { "type": "string", "maxLength": 260 },
          "limitations": { "type": "string", "maxLength": 260 },
          "cites": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 40 }
          }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["saved", "conflict", "limit", "invalid_input"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    },
    {
      "id": "paper.delete",
      "title": "删除文献并清理引用与对比矩阵",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "id"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "id": { "type": "string", "minLength": 1, "maxLength": 40 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["deleted", "not_found", "conflict"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    },
    {
      "id": "matrix.save",
      "title": "保存方法论对比矩阵选中集与字段",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "selected_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 40 }
          },
          "paper_id": { "type": "string", "minLength": 1, "maxLength": 40 },
          "row": {
            "type": "object",
            "additionalProperties": false,
            "required": ["architecture", "datasets", "metrics", "limitations", "reusable"],
            "properties": {
              "architecture": { "type": "string", "maxLength": 240 },
              "datasets": { "type": "string", "maxLength": 180 },
              "metrics": { "type": "string", "maxLength": 180 },
              "limitations": { "type": "string", "maxLength": 240 },
              "reusable": { "type": "string", "maxLength": 240 }
            }
          }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["saved", "conflict", "limit", "invalid_input"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    },
    {
      "id": "note.get",
      "title": "读取科研综述笔记全文",
      "permissions": ["data.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 40 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revision", "found"],
        "properties": {
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "found": { "type": "boolean" },
          "note": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "mode", "paper_ids", "content", "created_at"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 40 },
              "title": { "type": "string", "minLength": 1, "maxLength": 100 },
              "mode": { "type": "string", "enum": ["related_work", "research_gaps", "experiment_plan", "peer_review", "custom"] },
              "paper_ids": {
                "type": "array",
                "items": { "type": "string", "minLength": 1, "maxLength": 40 }
              },
              "content": { "type": "string", "maxLength": 6000 },
              "created_at": { "type": "string", "maxLength": 24 }
            }
          }
        }
      }
    },
    {
      "id": "note.save",
      "title": "保存 AI 文献综述或科研笔记",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "id", "title", "mode", "paper_ids", "content"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "id": { "type": "string", "minLength": 1, "maxLength": 40 },
          "title": { "type": "string", "minLength": 1, "maxLength": 100 },
          "mode": { "type": "string", "enum": ["related_work", "research_gaps", "experiment_plan", "peer_review", "custom"] },
          "paper_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 40 }
          },
          "content": { "type": "string", "minLength": 1, "maxLength": 6000 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision", "id"],
        "properties": {
          "status": { "type": "string", "enum": ["saved", "conflict", "limit", "invalid_input"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "id": { "type": "string", "maxLength": 40 }
        }
      }
    },
    {
      "id": "note.delete",
      "title": "删除科研综述笔记",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "id"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "id": { "type": "string", "minLength": 1, "maxLength": 40 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["deleted", "not_found", "conflict"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    },
    {
      "id": "lab.seed_demo",
      "title": "加载经典 LLM Agent / RAG / Sandbox 演示文献集",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision", "seeded_papers", "seeded_notes"],
        "properties": {
          "status": { "type": "string", "enum": ["seeded", "conflict", "limit"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "seeded_papers": { "type": "integer", "minimum": 0, "maximum": 32 },
          "seeded_notes": { "type": "integer", "minimum": 0, "maximum": 32 }
        }
      }
    },
    {
      "id": "session.turn.request",
      "title": "委托当前会话生成文献综述或研究空白",
      "permissions": ["tasks.start"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prompt", "work_id"],
        "properties": {
          "prompt": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "work_id": { "type": "string", "minLength": 36, "maxLength": 36 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "state"],
        "properties": {
          "task_id": { "type": "string", "minLength": 36, "maxLength": 36 },
          "state": { "type": "string", "enum": ["dispatching"] }
        }
      }
    },
    {
      "id": "session.turn.result",
      "title": "核对当前会话文献综述生成结果",
      "permissions": ["tasks.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["work_id"],
        "properties": {
          "work_id": { "type": "string", "minLength": 36, "maxLength": 36 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": true,
        "required": ["work_id", "state", "truncated"],
        "properties": {
          "work_id": { "type": "string", "minLength": 36, "maxLength": 36 },
          "state": { "type": "string", "enum": ["dispatching", "running", "waiting", "completed", "cancelled", "failed", "unknown", "unavailable"] },
          "truncated": { "type": "boolean" }
        }
      }
    },
    {
      "id": "document.list",
      "title": "列出可导出的文献库与科研笔记",
      "permissions": ["data.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {}
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 48 },
                "label": { "type": "string", "minLength": 1, "maxLength": 120 }
              }
            }
          }
        }
      }
    },
    {
      "id": "document.export",
      "title": "导出文献库或单篇科研笔记 JSON",
      "permissions": ["data.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 48 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "filename": { "type": "string", "maxLength": 80 },
          "text": { "type": "string", "maxLength": 12288 },
          "error": { "type": "string", "maxLength": 64 }
        }
      }
    },
    {
      "id": "document.import",
      "title": "导入文献库或科研笔记 JSON",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "minLength": 2, "maxLength": 12288 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["imported"],
        "properties": {
          "imported": { "type": "boolean" },
          "reason": { "type": "string", "maxLength": 64 },
          "count": { "type": "integer", "minimum": 0, "maximum": 128 }
        }
      }
    }
  ],
  "tools": [
    {
      "id": "paper.search",
      "title": "检索学术文献库",
      "description": "按关键词、阅读状态、领域标签或最低星级检索账号文献库中的论文摘要与引用统计。",
      "permissions": ["data.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "keyword": { "type": "string", "maxLength": 64 },
          "status": { "type": "string", "enum": ["unread", "reading", "annotated", "cited"] },
          "tag": { "type": "string", "maxLength": 24 },
          "min_rating": { "type": "integer", "minimum": 1, "maximum": 5 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["success", "status", "total", "papers"],
        "properties": {
          "success": { "type": "boolean" },
          "status": { "type": "string", "enum": ["ready", "storage_error"] },
          "total": { "type": "integer", "minimum": 0, "maximum": 128 },
          "papers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title", "authors", "year", "venue", "rating", "status", "tags", "cites_count"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 40 },
                "title": { "type": "string", "minLength": 1, "maxLength": 160 },
                "authors": { "type": "string", "maxLength": 120 },
                "year": { "type": "integer", "minimum": 1950, "maximum": 2100 },
                "venue": { "type": "string", "maxLength": 48 },
                "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
                "status": { "type": "string", "enum": ["unread", "reading", "annotated", "cited"] },
                "tags": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1, "maxLength": 24 }
                },
                "cites_count": { "type": "integer", "minimum": 0, "maximum": 128 }
              }
            }
          }
        }
      }
    },
    {
      "id": "paper.read",
      "title": "精读单篇论文详情与引用链",
      "description": "按论文 ID 读取完整的核心方法、主要贡献、局限性、上下游引用关系及方法论对比矩阵条目。",
      "permissions": ["data.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 40 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["success", "status"],
        "properties": {
          "success": { "type": "boolean" },
          "status": { "type": "string", "enum": ["ready", "not_found", "storage_error"] },
          "paper": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "authors", "year", "venue", "tags", "rating", "status", "method", "contribution", "limitations", "cites"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 40 },
              "title": { "type": "string", "minLength": 1, "maxLength": 160 },
              "authors": { "type": "string", "maxLength": 120 },
              "year": { "type": "integer", "minimum": 1950, "maximum": 2100 },
              "venue": { "type": "string", "maxLength": 48 },
              "tags": { "type": "array", "items": { "type": "string", "maxLength": 24 } },
              "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
              "status": { "type": "string", "enum": ["unread", "reading", "annotated", "cited"] },
              "method": { "type": "string", "maxLength": 260 },
              "contribution": { "type": "string", "maxLength": 260 },
              "limitations": { "type": "string", "maxLength": 260 },
              "cites": { "type": "array", "items": { "type": "string", "maxLength": 40 } }
            }
          },
          "cited_by": {
            "type": "array",
            "items": { "type": "string", "maxLength": 40 }
          },
          "matrix_row": {
            "type": "object",
            "additionalProperties": false,
            "required": ["architecture", "datasets", "metrics", "limitations", "reusable"],
            "properties": {
              "architecture": { "type": "string", "maxLength": 240 },
              "datasets": { "type": "string", "maxLength": 180 },
              "metrics": { "type": "string", "maxLength": 180 },
              "limitations": { "type": "string", "maxLength": 240 },
              "reusable": { "type": "string", "maxLength": 240 }
            }
          }
        }
      }
    },
    {
      "id": "paper.add",
      "title": "收录新论文到文献库",
      "description": "向科研文献库新增一篇论文，支持指定作者、年份、会议期刊、标签、核心方法、贡献、局限与引用关系。",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "authors", "year", "venue"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 40 },
          "title": { "type": "string", "minLength": 1, "maxLength": 160 },
          "authors": { "type": "string", "maxLength": 120 },
          "year": { "type": "integer", "minimum": 1950, "maximum": 2100 },
          "venue": { "type": "string", "maxLength": 48 },
          "tags": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 24 } },
          "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
          "status": { "type": "string", "enum": ["unread", "reading", "annotated", "cited"] },
          "method": { "type": "string", "maxLength": 260 },
          "contribution": { "type": "string", "maxLength": 260 },
          "limitations": { "type": "string", "maxLength": 260 },
          "cites": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 40 } }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["success", "status"],
        "properties": {
          "success": { "type": "boolean" },
          "status": { "type": "string", "enum": ["saved", "conflict", "limit", "invalid_input"] },
          "id": { "type": "string", "maxLength": 40 }
        }
      }
    }
  ],
  "data": [
    { "collection": "papers", "scope": "account", "schema_version": 1 },
    { "collection": "matrix", "scope": "account", "schema_version": 1 },
    { "collection": "notes", "scope": "account", "schema_version": 1 }
  ],
  "http": [],
  "tasks": [],
  "files": []
}
