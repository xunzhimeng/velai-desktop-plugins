{
  "manifest_version": 2,
  "plugin_id": "stock-ai-terminal",
  "name": "股票 AI 投研与量化终端",
  "version": "2.0.0",
  "host_api": 2,
  "backend": "backend/index.js",
  "page": "ui/index.html",
  "ui": {
    "icon": "table",
    "surfaces": ["workspace", "chat", "assistant"]
  },
  "permissions": ["data.read", "data.write", "http.request"],
  "settings": [
    {
      "key": "default_market",
      "type": "string",
      "secret": false,
      "required": false,
      "default": "US"
    },
    {
      "key": "risk_profile",
      "type": "string",
      "secret": false,
      "required": false,
      "default": "balanced"
    },
    {
      "key": "enable_live_quotes",
      "type": "boolean",
      "secret": false,
      "required": false,
      "default": true
    },
    {
      "key": "market_api_key",
      "type": "string",
      "secret": true,
      "required": false
    }
  ],
  "http": [
    {
      "host": "query1.finance.yahoo.com",
      "port": 443,
      "path_prefix": "/v8/finance/chart",
      "methods": ["GET"],
      "query_keys": ["interval", "range"],
      "headers": ["accept"],
      "redirects": 2
    },
    {
      "host": "finnhub.io",
      "port": 443,
      "path": "/api/v1/quote",
      "methods": ["GET"],
      "credential": {
        "slot": "market_api_key",
        "header": "x-api-key",
        "prefix": "",
        "projection": [
          { "path": ["c"], "type": "number" },
          { "path": ["d"], "type": "number" },
          { "path": ["dp"], "type": "number" },
          { "path": ["h"], "type": "number" },
          { "path": ["l"], "type": "number" },
          { "path": ["o"], "type": "number" },
          { "path": ["pc"], "type": "number" }
        ]
      }
    },
    {
      "host": "api.frankfurter.app",
      "port": 443,
      "path_prefix": "/v1",
      "methods": ["GET"],
      "query_keys": ["base", "symbols"],
      "headers": ["accept"],
      "redirects": 1
    }
  ],
  "actions": [
    {
      "id": "stock.bootstrap",
      "title": "读取投研终端总览与公开配置",
      "permissions": ["data.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {}
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revision", "cash", "watchlist", "positions", "notes", "summary", "settings", "snapshots"],
        "properties": {
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "cash": { "type": "number", "minimum": 0, "maximum": 100000000000 },
          "settings": {
            "type": "object",
            "additionalProperties": false,
            "required": ["default_market", "risk_profile", "enable_live_quotes"],
            "properties": {
              "default_market": { "type": "string", "maxLength": 32 },
              "risk_profile": { "type": "string", "maxLength": 32 },
              "enable_live_quotes": { "type": "boolean" }
            }
          },
          "snapshots": {
            "type": "array",
            "items": { "type": "string", "maxLength": 96 }
          },
          "summary": {
            "type": "object",
            "additionalProperties": false,
            "required": ["total_assets", "market_value", "total_cost", "unrealized_pnl", "pnl_pct", "cash_pct"],
            "properties": {
              "total_assets": { "type": "number" },
              "market_value": { "type": "number" },
              "total_cost": { "type": "number" },
              "unrealized_pnl": { "type": "number" },
              "pnl_pct": { "type": "number" },
              "cash_pct": { "type": "number" }
            }
          },
          "watchlist": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["symbol", "name", "market", "sector", "price", "change_pct", "pe", "pb", "roe", "rev_growth"],
              "properties": {
                "symbol": { "type": "string", "minLength": 1, "maxLength": 16 },
                "name": { "type": "string", "minLength": 1, "maxLength": 48 },
                "market": { "type": "string", "enum": ["US", "HK", "CN"] },
                "sector": { "type": "string", "maxLength": 32 },
                "price": { "type": "number", "minimum": 0.01, "maximum": 1000000 },
                "change_pct": { "type": "number", "minimum": -100, "maximum": 1000 },
                "pe": { "type": "number", "minimum": -1000, "maximum": 10000 },
                "pb": { "type": "number", "minimum": 0, "maximum": 1000 },
                "roe": { "type": "number", "minimum": -200, "maximum": 500 },
                "rev_growth": { "type": "number", "minimum": -100, "maximum": 1000 }
              }
            }
          },
          "positions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["symbol", "shares", "avg_cost", "stop_loss", "target_price"],
              "properties": {
                "symbol": { "type": "string", "minLength": 1, "maxLength": 16 },
                "shares": { "type": "number", "minimum": 0, "maximum": 100000000 },
                "avg_cost": { "type": "number", "minimum": 0.01, "maximum": 1000000 },
                "stop_loss": { "type": "number", "minimum": 0, "maximum": 1000000 },
                "target_price": { "type": "number", "minimum": 0, "maximum": 1000000 }
              }
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "symbol", "rating", "target_price", "thesis", "risks", "date"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 48 },
                "symbol": { "type": "string", "minLength": 1, "maxLength": 16 },
                "rating": { "type": "string", "enum": ["strong_buy", "buy", "hold", "reduce", "sell"] },
                "target_price": { "type": "number", "minimum": 0, "maximum": 1000000 },
                "thesis": { "type": "string", "maxLength": 800 },
                "risks": { "type": "string", "maxLength": 400 },
                "date": { "type": "string", "minLength": 10, "maxLength": 10 }
              }
            }
          }
        }
      }
    },
    {
      "id": "stock.fetch_live_quote",
      "title": "拉取实时行情（Yahoo 公开 / Finnhub 密钥槽）",
      "permissions": ["http.request", "data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol"],
        "properties": {
          "symbol": { "type": "string", "minLength": 1, "maxLength": 16 },
          "source": { "type": "string", "enum": ["yahoo", "finnhub_secret"] },
          "range": { "type": "string", "enum": ["5d", "1mo", "3mo"] },
          "persist": { "type": "boolean" }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ok", "status", "source", "symbol"],
        "properties": {
          "ok": { "type": "boolean" },
          "status": { "type": "string", "maxLength": 48 },
          "source": { "type": "string", "enum": ["yahoo", "finnhub_secret"] },
          "symbol": { "type": "string", "maxLength": 16 },
          "name": { "type": "string", "maxLength": 64 },
          "currency": { "type": "string", "maxLength": 12 },
          "price": { "type": "number" },
          "change": { "type": "number" },
          "change_pct": { "type": "number" },
          "open": { "type": "number" },
          "high": { "type": "number" },
          "low": { "type": "number" },
          "prev_close": { "type": "number" },
          "bars_count": { "type": "integer", "minimum": 0, "maximum": 500 },
          "persisted": { "type": "boolean" },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "http_status": { "type": "integer", "minimum": 0, "maximum": 999 },
          "error": { "type": "string", "maxLength": 320 }
        }
      }
    },
    {
      "id": "stock.fetch_fx_rate",
      "title": "获取实时跨市场汇率",
      "permissions": ["http.request"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "base": { "type": "string", "minLength": 3, "maxLength": 3 },
          "symbols": { "type": "string", "minLength": 3, "maxLength": 64 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ok", "status", "base", "rates"],
        "properties": {
          "ok": { "type": "boolean" },
          "status": { "type": "string", "maxLength": 48 },
          "base": { "type": "string", "maxLength": 8 },
          "date": { "type": "string", "maxLength": 16 },
          "rates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["currency", "rate"],
              "properties": {
                "currency": { "type": "string", "maxLength": 8 },
                "rate": { "type": "number" }
              }
            }
          },
          "http_status": { "type": "integer", "minimum": 0, "maximum": 999 },
          "error": { "type": "string", "maxLength": 320 }
        }
      }
    },
    {
      "id": "stock.kline.get",
      "title": "读取标的 K 线与技术指标",
      "permissions": ["data.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol"],
        "properties": { "symbol": { "type": "string", "minLength": 1, "maxLength": 16 } }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["found", "bars", "indicators"],
        "properties": {
          "found": { "type": "boolean" },
          "bars": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["d", "o", "h", "l", "c", "v"],
              "properties": {
                "d": { "type": "string", "maxLength": 12 },
                "o": { "type": "number" },
                "h": { "type": "number" },
                "l": { "type": "number" },
                "c": { "type": "number" },
                "v": { "type": "number" }
              }
            }
          },
          "indicators": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ma5", "ma10", "ma20", "rsi14", "volatility_pct", "signal"],
            "properties": {
              "ma5": { "type": "number" },
              "ma10": { "type": "number" },
              "ma20": { "type": "number" },
              "rsi14": { "type": "number" },
              "volatility_pct": { "type": "number" },
              "signal": { "type": "string", "maxLength": 32 }
            }
          }
        }
      }
    },
    {
      "id": "stock.backtest",
      "title": "运行量化策略回测",
      "permissions": ["data.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol", "strategy", "fast", "slow"],
        "properties": {
          "symbol": { "type": "string", "minLength": 1, "maxLength": 16 },
          "strategy": { "type": "string", "enum": ["ma_cross", "rsi_revert", "bollinger"] },
          "fast": { "type": "integer", "minimum": 2, "maximum": 20 },
          "slow": { "type": "integer", "minimum": 5, "maximum": 30 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ok", "metrics", "equity", "benchmark", "trades"],
        "properties": {
          "ok": { "type": "boolean" },
          "metrics": {
            "type": "object",
            "additionalProperties": false,
            "required": ["strategy_return_pct", "benchmark_return_pct", "alpha_pct", "max_drawdown_pct", "win_rate_pct", "sharpe", "trade_count"],
            "properties": {
              "strategy_return_pct": { "type": "number" },
              "benchmark_return_pct": { "type": "number" },
              "alpha_pct": { "type": "number" },
              "max_drawdown_pct": { "type": "number" },
              "win_rate_pct": { "type": "number" },
              "sharpe": { "type": "number" },
              "trade_count": { "type": "integer", "minimum": 0, "maximum": 200 }
            }
          },
          "equity": { "type": "array", "items": { "type": "number" } },
          "benchmark": { "type": "array", "items": { "type": "number" } },
          "trades": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["date", "side", "price", "pnl_pct"],
              "properties": {
                "date": { "type": "string", "maxLength": 12 },
                "side": { "type": "string", "enum": ["BUY", "SELL"] },
                "price": { "type": "number" },
                "pnl_pct": { "type": "number" }
              }
            }
          }
        }
      }
    },
    {
      "id": "stock.dcf",
      "title": "DCF 现金流折现估值测算",
      "permissions": [],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fcf_billion", "growth_pct", "terminal_pct", "wacc_pct", "shares_billion", "current_price"],
        "properties": {
          "fcf_billion": { "type": "number", "minimum": 0.01, "maximum": 100000 },
          "growth_pct": { "type": "number", "minimum": -20, "maximum": 100 },
          "terminal_pct": { "type": "number", "minimum": 0, "maximum": 8 },
          "wacc_pct": { "type": "number", "minimum": 4, "maximum": 30 },
          "shares_billion": { "type": "number", "minimum": 0.01, "maximum": 10000 },
          "current_price": { "type": "number", "minimum": 0.01, "maximum": 1000000 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["intrinsic_value", "margin_of_safety_pct", "enterprise_value_billion", "verdict"],
        "properties": {
          "intrinsic_value": { "type": "number" },
          "margin_of_safety_pct": { "type": "number" },
          "enterprise_value_billion": { "type": "number" },
          "verdict": { "type": "string", "enum": ["undervalued", "fair", "overvalued"] }
        }
      }
    },
    {
      "id": "stock.watchlist.upsert",
      "title": "新增或更新自选标的",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "symbol", "name", "market", "sector", "price", "change_pct", "pe", "pb", "roe", "rev_growth"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "symbol": { "type": "string", "minLength": 1, "maxLength": 16 },
          "name": { "type": "string", "minLength": 1, "maxLength": 48 },
          "market": { "type": "string", "enum": ["US", "HK", "CN"] },
          "sector": { "type": "string", "maxLength": 32 },
          "price": { "type": "number", "minimum": 0.01, "maximum": 1000000 },
          "change_pct": { "type": "number", "minimum": -100, "maximum": 1000 },
          "pe": { "type": "number", "minimum": -1000, "maximum": 10000 },
          "pb": { "type": "number", "minimum": 0, "maximum": 1000 },
          "roe": { "type": "number", "minimum": -200, "maximum": 500 },
          "rev_growth": { "type": "number", "minimum": -100, "maximum": 1000 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["saved", "conflict", "limit", "invalid_input"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    },
    {
      "id": "stock.portfolio.save",
      "title": "保存持仓组合与现金",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "cash", "positions"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "cash": { "type": "number", "minimum": 0, "maximum": 100000000000 },
          "positions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["symbol", "shares", "avg_cost", "stop_loss", "target_price"],
              "properties": {
                "symbol": { "type": "string", "minLength": 1, "maxLength": 16 },
                "shares": { "type": "number", "minimum": 0, "maximum": 100000000 },
                "avg_cost": { "type": "number", "minimum": 0.01, "maximum": 1000000 },
                "stop_loss": { "type": "number", "minimum": 0, "maximum": 1000000 },
                "target_price": { "type": "number", "minimum": 0, "maximum": 1000000 }
              }
            }
          }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["saved", "conflict", "limit"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    },
    {
      "id": "stock.note.save",
      "title": "保存投研笔记",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "id", "symbol", "rating", "target_price", "thesis", "risks"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "id": { "type": "string", "minLength": 1, "maxLength": 48 },
          "symbol": { "type": "string", "minLength": 1, "maxLength": 16 },
          "rating": { "type": "string", "enum": ["strong_buy", "buy", "hold", "reduce", "sell"] },
          "target_price": { "type": "number", "minimum": 0, "maximum": 1000000 },
          "thesis": { "type": "string", "minLength": 1, "maxLength": 800 },
          "risks": { "type": "string", "maxLength": 400 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["saved", "conflict", "limit"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    },
    {
      "id": "stock.snapshot.save",
      "title": "保存自定义组合快照或独立研报键",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "key"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "key": { "type": "string", "minLength": 5, "maxLength": 64 },
          "memo": { "type": "string", "maxLength": 400 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["saved", "conflict", "limit", "invalid_key"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "key": { "type": "string", "maxLength": 64 }
        }
      }
    },
    {
      "id": "stock.snapshot.list",
      "title": "列出自定义快照与研报键",
      "permissions": ["data.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "prefix": { "type": "string", "maxLength": 32 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 50 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keys", "revision"],
        "properties": {
          "keys": {
            "type": "array",
            "items": { "type": "string", "maxLength": 96 }
          },
          "next_cursor": { "type": ["string", "null"], "maxLength": 128 },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    },
    {
      "id": "stock.record.delete",
      "title": "删除自定义快照或笔记键",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "collection", "key"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "collection": { "type": "string", "enum": ["research", "strategies"] },
          "key": { "type": "string", "minLength": 2, "maxLength": 64 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["deleted", "conflict", "invalid_key"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "key": { "type": "string", "maxLength": 64 }
        }
      }
    },
    {
      "id": "stock.seed_demo",
      "title": "加载跨市场演示投研组合",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision"],
        "properties": { "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 } }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["seeded", "conflict"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    },
    {
      "id": "document.list",
      "title": "列出可导出的组合报告",
      "permissions": ["data.read"],
      "input_schema": { "type": "object", "additionalProperties": false, "required": [], "properties": {} },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label"],
              "properties": {
                "id": { "type": "string", "maxLength": 64 },
                "label": { "type": "string", "maxLength": 100 }
              }
            }
          }
        }
      }
    },
    {
      "id": "document.export",
      "title": "导出投研组合快照",
      "permissions": ["data.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": { "id": { "type": "string", "maxLength": 64 } }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "filename": { "type": "string", "maxLength": 80 },
          "text": { "type": "string", "maxLength": 200000 },
          "error": { "type": "string", "maxLength": 64 }
        }
      }
    },
