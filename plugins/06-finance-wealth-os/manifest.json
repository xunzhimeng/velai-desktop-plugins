  "tools": [
    {
      "id": "finance.summary",
      "title": "获取财务总览与超支预警",
      "description": "查询净资产、总资产、总负债、储蓄率、资产配置分布、本月分类支出与超支预警清单。",
      "permissions": ["data.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "month": { "type": "string", "minLength": 7, "maxLength": 7, "description": "可选月份 YYYY-MM，默认当月" }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["success", "status", "month", "summary", "allocation", "budget_alerts", "top_expenses"],
        "properties": {
          "success": { "type": "boolean" },
          "status": { "type": "string", "enum": ["ready", "empty"] },
          "month": { "type": "string", "minLength": 7, "maxLength": 7 },
          "summary": {
            "type": "object",
            "additionalProperties": false,
            "required": ["total_assets", "total_liabilities", "net_worth", "debt_ratio", "monthly_income", "monthly_expense", "savings_rate"],
            "properties": {
              "total_assets": { "type": "number", "minimum": 0, "maximum": 9999999999 },
              "total_liabilities": { "type": "number", "minimum": 0, "maximum": 9999999999 },
              "net_worth": { "type": "number", "minimum": -9999999999, "maximum": 9999999999 },
              "debt_ratio": { "type": "number", "minimum": 0, "maximum": 999 },
              "monthly_income": { "type": "number", "minimum": 0, "maximum": 9999999999 },
              "monthly_expense": { "type": "number", "minimum": 0, "maximum": 9999999999 },
              "savings_rate": { "type": "number", "minimum": -999, "maximum": 100 }
            }
          },
          "allocation": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["asset_class", "amount", "share"],
              "properties": {
                "asset_class": { "type": "string", "minLength": 1, "maxLength": 24 },
                "amount": { "type": "number", "minimum": 0, "maximum": 9999999999 },
                "share": { "type": "number", "minimum": 0, "maximum": 100 }
              }
            }
          },
          "budget_alerts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["category", "label", "limit", "spent", "ratio", "level"],
              "properties": {
                "category": { "type": "string", "minLength": 1, "maxLength": 32 },
                "label": { "type": "string", "minLength": 1, "maxLength": 48 },
                "limit": { "type": "number", "minimum": 1, "maximum": 999999999 },
                "spent": { "type": "number", "minimum": 0, "maximum": 999999999 },
                "ratio": { "type": "number", "minimum": 0, "maximum": 9999 },
                "level": { "type": "string", "enum": ["ok", "warn", "over"] }
              }
            }
          },
          "top_expenses": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["category", "amount", "share"],
              "properties": {
                "category": { "type": "string", "minLength": 1, "maxLength": 32 },
                "amount": { "type": "number", "minimum": 0, "maximum": 999999999 },
                "share": { "type": "number", "minimum": 0, "maximum": 100 }
              }
            }
          }
        }
      }
    },
    {
      "id": "finance.tx.add",
      "title": "快速记一笔收入或支出流水",
      "description": "向个人账本快速记录一条收入或支出流水，并实时返回该分类本月预算消耗比例与预警状态。",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "category", "amount"],
        "properties": {
          "type": { "type": "string", "enum": ["income", "expense"] },
          "category": { "type": "string", "enum": ["salary", "bonus", "dividend", "housing", "food", "transport", "health", "shopping", "education", "entertainment", "travel", "invest", "other"] },
          "amount": { "type": "number", "minimum": 0.01, "maximum": 99999999 },
          "date": { "type": "string", "minLength": 10, "maxLength": 10, "description": "交易日期 YYYY-MM-DD，默认当天" },
          "account_name": { "type": "string", "maxLength": 48, "description": "可选账户名称或 ID" },
          "note": { "type": "string", "maxLength": 100, "description": "备注说明" }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["success", "status"],
        "properties": {
          "success": { "type": "boolean" },
          "status": { "type": "string", "enum": ["recorded", "invalid_input", "limit", "conflict"] },
          "tx_id": { "type": "string", "minLength": 1, "maxLength": 48 },
          "budget_ratio": { "type": "number", "minimum": 0, "maximum": 9999 },
          "budget_level": { "type": "string", "enum": ["none", "ok", "warn", "over"] }
        }
      }
    }
  ],
