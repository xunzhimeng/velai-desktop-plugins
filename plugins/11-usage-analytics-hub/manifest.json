{
  "manifest_version": 1,
  "plugin_id": "usage-analytics-hub",
  "name": "个人会话与用量统计大屏",
  "version": "1.0.0",
  "host_api": 1,
  "backend": "backend/index.js",
  "page": "ui/index.html",
  "ui": {
    "icon": "table",
    "surfaces": ["workspace", "chat", "assistant"]
  },
  "permissions": ["data.read", "data.write", "tasks.start", "tasks.read", "tasks.cancel"],
  "actions": [
    {
      "id": "usage.dashboard",
      "title": "读取个人会话与用量统计大屏",
      "permissions": ["data.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "range": { "type": "string", "enum": ["7d", "30d", "all"] }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revision", "range", "kpis", "budget", "daily", "models", "categories", "hours", "sessions", "latest_review"],
        "properties": {
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "range": { "type": "string", "enum": ["7d", "30d", "all"] },
          "kpis": {
            "type": "object",
            "additionalProperties": false,
            "required": ["session_count", "total_tokens", "input_tokens", "output_tokens", "cached_tokens", "cache_hit_pct", "total_cost_usd", "total_minutes", "total_turns", "avg_rating", "active_days", "streak_days", "peak_hour"],
            "properties": {
              "session_count": { "type": "integer", "minimum": 0 },
              "total_tokens": { "type": "integer", "minimum": 0 },
              "input_tokens": { "type": "integer", "minimum": 0 },
              "output_tokens": { "type": "integer", "minimum": 0 },
              "cached_tokens": { "type": "integer", "minimum": 0 },
              "cache_hit_pct": { "type": "number", "minimum": 0, "maximum": 100 },
              "total_cost_usd": { "type": "number", "minimum": 0 },
              "total_minutes": { "type": "integer", "minimum": 0 },
              "total_turns": { "type": "integer", "minimum": 0 },
              "avg_rating": { "type": "number", "minimum": 0, "maximum": 5 },
              "active_days": { "type": "integer", "minimum": 0 },
              "streak_days": { "type": "integer", "minimum": 0 },
              "peak_hour": { "type": "integer", "minimum": 0, "maximum": 23 }
            }
          },
          "budget": {
            "type": "object",
            "additionalProperties": false,
            "required": ["monthly_cost_usd", "monthly_tokens_m", "cost_used_pct", "token_used_pct", "alert_level"],
            "properties": {
              "monthly_cost_usd": { "type": "number", "minimum": 1, "maximum": 100000 },
              "monthly_tokens_m": { "type": "number", "minimum": 0.1, "maximum": 10000 },
              "cost_used_pct": { "type": "number", "minimum": 0 },
              "token_used_pct": { "type": "number", "minimum": 0 },
              "alert_level": { "type": "string", "enum": ["ok", "warn", "critical"] }
            }
          },
          "daily": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["date", "sessions", "tokens", "cached", "cost_usd", "minutes"],
              "properties": {
                "date": { "type": "string", "minLength": 10, "maxLength": 10 },
                "sessions": { "type": "integer", "minimum": 0 },
                "tokens": { "type": "integer", "minimum": 0 },
                "cached": { "type": "integer", "minimum": 0 },
                "cost_usd": { "type": "number", "minimum": 0 },
                "minutes": { "type": "integer", "minimum": 0 }
              }
            }
          },
          "models": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["model", "sessions", "tokens", "cost_usd", "avg_rating", "share_pct", "cache_pct"],
              "properties": {
                "model": { "type": "string", "maxLength": 48 },
                "sessions": { "type": "integer", "minimum": 0 },
                "tokens": { "type": "integer", "minimum": 0 },
                "cost_usd": { "type": "number", "minimum": 0 },
                "avg_rating": { "type": "number", "minimum": 0, "maximum": 5 },
                "share_pct": { "type": "number", "minimum": 0, "maximum": 100 },
                "cache_pct": { "type": "number", "minimum": 0, "maximum": 100 }
              }
            }
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["category", "sessions", "tokens", "cost_usd", "avg_rating", "share_pct"],
              "properties": {
                "category": { "type": "string", "enum": ["coding", "writing", "research", "planning", "ops", "chat"] },
                "sessions": { "type": "integer", "minimum": 0 },
                "tokens": { "type": "integer", "minimum": 0 },
                "cost_usd": { "type": "number", "minimum": 0 },
                "avg_rating": { "type": "number", "minimum": 0, "maximum": 5 },
                "share_pct": { "type": "number", "minimum": 0, "maximum": 100 }
              }
            }
          },
          "hours": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0 }
          },
          "sessions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "date", "hour", "title", "category", "model", "input_tokens", "output_tokens", "cached_tokens", "cost_usd", "turns", "minutes", "rating", "summary", "tags"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 48 },
                "date": { "type": "string", "minLength": 10, "maxLength": 10 },
                "hour": { "type": "integer", "minimum": 0, "maximum": 23 },
                "title": { "type": "string", "minLength": 1, "maxLength": 100 },
                "category": { "type": "string", "enum": ["coding", "writing", "research", "planning", "ops", "chat"] },
                "model": { "type": "string", "minLength": 1, "maxLength": 48 },
                "input_tokens": { "type": "integer", "minimum": 0 },
                "output_tokens": { "type": "integer", "minimum": 0 },
                "cached_tokens": { "type": "integer", "minimum": 0 },
                "cost_usd": { "type": "number", "minimum": 0 },
                "turns": { "type": "integer", "minimum": 1, "maximum": 10000 },
                "minutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
                "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
                "summary": { "type": "string", "maxLength": 260 },
                "tags": { "type": "string", "maxLength": 80 }
              }
            }
          },
          "latest_review": { "type": "string", "maxLength": 1600 }
        }
      }
    },
    {
      "id": "usage.session.save",
      "title": "新增或更新单条会话用量记录",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "id", "date", "hour", "title", "category", "model", "input_tokens", "output_tokens", "cached_tokens", "cost_usd", "turns", "minutes", "rating", "summary", "tags"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "id": { "type": "string", "minLength": 1, "maxLength": 48 },
          "date": { "type": "string", "minLength": 10, "maxLength": 10 },
          "hour": { "type": "integer", "minimum": 0, "maximum": 23 },
          "title": { "type": "string", "minLength": 1, "maxLength": 100 },
          "category": { "type": "string", "enum": ["coding", "writing", "research", "planning", "ops", "chat"] },
          "model": { "type": "string", "minLength": 1, "maxLength": 48 },
          "input_tokens": { "type": "integer", "minimum": 0, "maximum": 50000000 },
          "output_tokens": { "type": "integer", "minimum": 0, "maximum": 50000000 },
          "cached_tokens": { "type": "integer", "minimum": 0, "maximum": 50000000 },
          "cost_usd": { "type": "number", "minimum": 0, "maximum": 10000 },
          "turns": { "type": "integer", "minimum": 1, "maximum": 10000 },
          "minutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
          "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
          "summary": { "type": "string", "maxLength": 260 },
          "tags": { "type": "string", "maxLength": 80 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["saved", "conflict", "limit", "invalid_input"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    },
    {
      "id": "usage.session.batch_ingest",
      "title": "批量合并 AI 整理的近期会话记录",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "items"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["date", "title", "category", "model", "input_tokens", "output_tokens"],
              "properties": {
                "id": { "type": "string", "maxLength": 48 },
                "date": { "type": "string", "minLength": 10, "maxLength": 10 },
                "hour": { "type": "integer", "minimum": 0, "maximum": 23 },
                "title": { "type": "string", "minLength": 1, "maxLength": 100 },
                "category": { "type": "string", "enum": ["coding", "writing", "research", "planning", "ops", "chat"] },
                "model": { "type": "string", "minLength": 1, "maxLength": 48 },
                "input_tokens": { "type": "integer", "minimum": 0, "maximum": 50000000 },
                "output_tokens": { "type": "integer", "minimum": 0, "maximum": 50000000 },
                "cached_tokens": { "type": "integer", "minimum": 0, "maximum": 50000000 },
                "cost_usd": { "type": "number", "minimum": 0, "maximum": 10000 },
                "turns": { "type": "integer", "minimum": 1, "maximum": 10000 },
                "minutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
                "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
                "summary": { "type": "string", "maxLength": 260 },
                "tags": { "type": "string", "maxLength": 80 }
              }
            }
          }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision", "ingested"],
        "properties": {
          "status": { "type": "string", "enum": ["saved", "conflict", "limit", "invalid_input"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "ingested": { "type": "integer", "minimum": 0, "maximum": 64 }
        }
      }
    },
    {
      "id": "usage.session.delete",
      "title": "删除会话记录",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "id"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "id": { "type": "string", "minLength": 1, "maxLength": 48 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["deleted", "not_found", "conflict"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    },
    {
      "id": "usage.config.save",
      "title": "更新个人预算与最新复盘报告",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "monthly_cost_usd", "monthly_tokens_m"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "monthly_cost_usd": { "type": "number", "minimum": 1, "maximum": 100000 },
          "monthly_tokens_m": { "type": "number", "minimum": 0.1, "maximum": 10000 },
          "latest_review": { "type": "string", "maxLength": 1600 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["saved", "conflict", "limit"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    },
    {
      "id": "usage.seed_demo",
      "title": "加载 30 天个人用量全景演示数据",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision"],
        "properties": { "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 } }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["seeded", "conflict"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    },
    {
      "id": "session.turn.request",
      "title": "请当前会话整理近期会话或生成效率复盘",
      "permissions": ["tasks.start"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prompt", "work_id"],
        "properties": {
          "prompt": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "work_id": { "type": "string", "minLength": 36, "maxLength": 36 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "state"],
        "properties": {
          "task_id": { "type": "string", "minLength": 36, "maxLength": 36 },
          "state": { "type": "string", "enum": ["dispatching"] }
        }
      }
    },
    {
      "id": "session.turn.result",
      "title": "核对会话整理结果",
      "permissions": ["tasks.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["work_id"],
        "properties": { "work_id": { "type": "string", "minLength": 36, "maxLength": 36 } }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": true,
        "required": ["work_id", "state", "truncated"],
        "properties": {
          "work_id": { "type": "string", "minLength": 36, "maxLength": 36 },
          "state": { "type": "string", "enum": ["dispatching", "running", "waiting", "completed", "cancelled", "failed", "unknown", "unavailable"] },
          "truncated": { "type": "boolean" }
        }
      }
    },
    {
      "id": "document.list",
      "title": "列出可导出的用量档案",
      "permissions": ["data.read"],
      "input_schema": { "type": "object", "additionalProperties": false, "required": [], "properties": {} },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label"],
              "properties": {
                "id": { "type": "string", "maxLength": 32 },
                "label": { "type": "string", "maxLength": 100 }
              }
            }
          }
        }
      }
    },
    {
      "id": "document.export",
      "title": "导出个人会话与用量快照",
      "permissions": ["data.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": { "id": { "type": "string", "maxLength": 32 } }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "filename": { "type": "string", "maxLength": 64 },
          "text": { "type": "string", "maxLength": 12288 },
          "error": { "type": "string", "maxLength": 64 }
        }
      }
    },
    {
      "id": "document.import",
      "title": "导入个人会话与用量 JSON",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": { "text": { "type": "string", "minLength": 2, "maxLength": 12288 } }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["imported"],
        "properties": {
          "imported": { "type": "boolean" },
          "reason": { "type": "string", "maxLength": 64 }
        }
      }
    }
  ],
  "tools": [
    {
      "id": "usage.dashboard.summary",
      "title": "读取个人 AI 使用量与效率统计",
      "description": "获取用户近 7 天或 30 天的会话总数、总 Token、缓存命中率、估算费用、预算消耗、各模型占比及高峰时段，用于个人使用复盘。",
      "permissions": ["data.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "range": { "type": "string", "enum": ["7d", "30d", "all"] }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["success", "status", "session_count", "total_tokens", "total_cost_usd"],
        "properties": {
          "success": { "type": "boolean" },
          "status": { "type": "string", "enum": ["ready", "empty"] },
          "session_count": { "type": "integer", "minimum": 0 },
          "total_tokens": { "type": "integer", "minimum": 0 },
          "cache_hit_pct": { "type": "number", "minimum": 0, "maximum": 100 },
          "total_cost_usd": { "type": "number", "minimum": 0 },
          "budget_alert": { "type": "string", "enum": ["ok", "warn", "critical"] },
          "top_model": { "type": "string", "maxLength": 48 },
          "top_category": { "type": "string", "maxLength": 24 },
          "peak_hour": { "type": "integer", "minimum": 0, "maximum": 23 }
        }
      }
    },
    {
      "id": "usage.session.record",
      "title": "归档一条近期会话与用量记录",
      "description": "将一条整理好的会话标题、场景分类、使用模型、输入/输出 Token、估算费用与产出摘要写入个人统计大屏。",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "category", "model", "input_tokens", "output_tokens"],
        "properties": {
          "date": { "type": "string", "minLength": 10, "maxLength": 10 },
          "hour": { "type": "integer", "minimum": 0, "maximum": 23 },
          "title": { "type": "string", "minLength": 1, "maxLength": 100 },
          "category": { "type": "string", "enum": ["coding", "writing", "research", "planning", "ops", "chat"] },
          "model": { "type": "string", "minLength": 1, "maxLength": 48 },
          "input_tokens": { "type": "integer", "minimum": 0, "maximum": 50000000 },
          "output_tokens": { "type": "integer", "minimum": 0, "maximum": 50000000 },
          "cached_tokens": { "type": "integer", "minimum": 0, "maximum": 50000000 },
          "cost_usd": { "type": "number", "minimum": 0, "maximum": 10000 },
          "turns": { "type": "integer", "minimum": 1, "maximum": 10000 },
          "minutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
          "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
          "summary": { "type": "string", "maxLength": 260 },
          "tags": { "type": "string", "maxLength": 80 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["success", "status"],
        "properties": {
          "success": { "type": "boolean" },
          "status": { "type": "string", "enum": ["saved", "conflict", "limit", "invalid_input"] },
          "id": { "type": "string", "maxLength": 48 }
        }
      }
    },
    {
      "id": "usage.budget.status",
      "title": "检查个人月度 AI 预算与限额状态",
      "description": "查看本月累计费用和 Token 用量占个人月度预算的比例以及超支风险等级。",
      "permissions": ["data.read"],
      "input_schema": { "type": "object", "additionalProperties": false, "required": [], "properties": {} },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["success", "status", "alert_level", "cost_used_pct", "token_used_pct"],
        "properties": {
          "success": { "type": "boolean" },
          "status": { "type": "string", "enum": ["ready"] },
          "alert_level": { "type": "string", "enum": ["ok", "warn", "critical"] },
          "cost_used_pct": { "type": "number", "minimum": 0 },
          "token_used_pct": { "type": "number", "minimum": 0 },
          "monthly_cost_usd": { "type": "number", "minimum": 0 },
          "spent_cost_usd": { "type": "number", "minimum": 0 }
        }
      }
    }
  ],
  "data": [
    { "collection": "sessions", "scope": "account", "schema_version": 1 },
    { "collection": "metrics", "scope": "account", "schema_version": 1 },
    { "collection": "goals", "scope": "account", "schema_version": 1 }
  ],
  "http": [],
  "tasks": [],
  "files": []
}
