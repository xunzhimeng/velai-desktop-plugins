{
  "manifest_version": 2,
  "plugin_id": "usage-analytics-hub",
  "name": "个人会话与用量统计大屏",
  "version": "2.0.0",
  "host_api": 2,
  "backend": "backend/index.js",
  "page": "ui/index.html",
  "ui": {
    "icon": "table",
    "surfaces": ["workspace", "chat", "assistant"]
  },
  "permissions": [
    "host.usage.read",
    "host.sessions.read",
    "host.projects.read",
    "data.read",
    "data.write"
  ],
  "actions": [
    {
      "id": "usage.dashboard",
      "title": "读取宿主实时用量、会话、项目与预算大屏",
      "permissions": [
        "host.usage.read",
        "host.sessions.read",
        "host.projects.read",
        "data.read"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "days": { "type": "integer", "enum": [7, 30] },
          "include_archived": { "type": "boolean" }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision",
          "days",
          "as_of",
          "timezone",
          "models_truncated",
          "windows",
          "by_day",
          "by_model",
          "budget",
          "sessions",
          "projects",
          "notes"
        ],
        "properties": {
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "days": { "type": "integer", "enum": [7, 30] },
          "as_of": { "type": "string", "maxLength": 64 },
          "timezone": { "type": "string", "maxLength": 64 },
          "models_truncated": { "type": "boolean" },
          "windows": {
            "type": "object",
            "additionalProperties": false,
            "required": ["5m", "1h", "today", "7d", "30d"],
            "properties": {
              "5m": {
                "type": "object",
                "additionalProperties": false,
                "required": ["input_tokens", "output_tokens", "total_tokens", "cached_input_tokens", "cache_rate", "tokens_per_second"],
                "properties": {
                  "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
                  "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
                  "total_tokens": { "type": ["integer", "null"], "minimum": 0 },
                  "cached_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
                  "cache_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
                  "tokens_per_second": { "type": ["number", "null"], "minimum": 0 }
                }
              },
              "1h": {
                "type": "object",
                "additionalProperties": false,
                "required": ["input_tokens", "output_tokens", "total_tokens", "cached_input_tokens", "cache_rate", "tokens_per_second"],
                "properties": {
                  "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
                  "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
                  "total_tokens": { "type": ["integer", "null"], "minimum": 0 },
                  "cached_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
                  "cache_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
                  "tokens_per_second": { "type": ["number", "null"], "minimum": 0 }
                }
              },
              "today": {
                "type": "object",
                "additionalProperties": false,
                "required": ["input_tokens", "output_tokens", "total_tokens", "cached_input_tokens", "cache_rate", "tokens_per_second"],
                "properties": {
                  "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
                  "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
                  "total_tokens": { "type": ["integer", "null"], "minimum": 0 },
                  "cached_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
                  "cache_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
                  "tokens_per_second": { "type": ["number", "null"], "minimum": 0 }
                }
              },
              "7d": {
                "type": "object",
                "additionalProperties": false,
                "required": ["input_tokens", "output_tokens", "total_tokens", "cached_input_tokens", "cache_rate", "tokens_per_second"],
                "properties": {
                  "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
                  "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
                  "total_tokens": { "type": ["integer", "null"], "minimum": 0 },
                  "cached_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
                  "cache_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
                  "tokens_per_second": { "type": ["number", "null"], "minimum": 0 }
                }
              },
              "30d": {
                "type": "object",
                "additionalProperties": false,
                "required": ["input_tokens", "output_tokens", "total_tokens", "cached_input_tokens", "cache_rate", "tokens_per_second"],
                "properties": {
                  "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
                  "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
                  "total_tokens": { "type": ["integer", "null"], "minimum": 0 },
                  "cached_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
                  "cache_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
                  "tokens_per_second": { "type": ["number", "null"], "minimum": 0 }
                }
              }
            }
          },
          "by_day": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["date", "input_tokens", "output_tokens", "total_tokens"],
              "properties": {
                "date": { "type": "string", "minLength": 1, "maxLength": 32 },
                "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
                "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
                "total_tokens": { "type": ["integer", "null"], "minimum": 0 }
              }
            }
          },
          "by_model": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["model", "input_tokens", "output_tokens", "total_tokens", "share_pct"],
              "properties": {
                "model": { "type": "string", "minLength": 1, "maxLength": 128 },
                "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
                "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
                "total_tokens": { "type": ["integer", "null"], "minimum": 0 },
                "share_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
              }
            }
          },
          "budget": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "monthly_tokens_m",
              "warn_pct",
              "critical_pct",
              "used_tokens_30d",
              "token_used_pct",
              "alert_level",
              "alert_note"
            ],
            "properties": {
              "monthly_tokens_m": { "type": "number", "minimum": 0.1, "maximum": 10000 },
              "warn_pct": { "type": "integer", "minimum": 1, "maximum": 99 },
              "critical_pct": { "type": "integer", "minimum": 2, "maximum": 100 },
              "used_tokens_30d": { "type": ["integer", "null"], "minimum": 0 },
              "token_used_pct": { "type": ["number", "null"], "minimum": 0 },
              "alert_level": { "type": "string", "enum": ["ok", "warn", "critical", "unknown"] },
              "alert_note": { "type": "string", "maxLength": 400 }
            }
          },
          "sessions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["items", "next_offset"],
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "title", "status", "created_at", "is_archived"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
                    "title": { "type": ["string", "null"], "maxLength": 200 },
                    "status": { "type": ["string", "null"], "maxLength": 64 },
                    "created_at": { "type": ["string", "null"], "maxLength": 64 },
                    "is_archived": { "type": "boolean" }
                  }
                }
              },
              "next_offset": { "type": ["integer", "null"], "minimum": 0 }
            }
          },
          "projects": {
            "type": "object",
            "additionalProperties": false,
            "required": ["items", "next_offset"],
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "name", "status"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
                    "name": { "type": ["string", "null"], "maxLength": 200 },
                    "status": { "type": ["string", "null"], "maxLength": 64 }
                  }
                }
              },
              "next_offset": { "type": ["integer", "null"], "minimum": 0 }
            }
          },
          "notes": {
            "type": "object",
            "additionalProperties": false,
            "required": ["items", "next_cursor"],
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["key", "id", "title", "range_days", "tags", "body", "updated_at"],
                  "properties": {
                    "key": { "type": "string", "minLength": 1, "maxLength": 96 },
                    "id": { "type": "string", "minLength": 1, "maxLength": 64 },
                    "title": { "type": "string", "minLength": 1, "maxLength": 100 },
                    "range_days": { "type": "integer", "enum": [7, 30] },
                    "tags": { "type": "string", "maxLength": 120 },
                    "body": { "type": "string", "maxLength": 4000 },
                    "updated_at": { "type": "string", "maxLength": 64 }
                  }
                }
              },
              "next_cursor": { "type": ["string", "null"], "maxLength": 128 }
            }
          }
        }
      }
    },
    {
      "id": "usage.host.sessions",
      "title": "分页读取宿主会话列表",
      "permissions": ["host.sessions.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "offset": { "type": "integer", "minimum": 0, "maximum": 10000 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 50 },
          "is_archived": { "type": "boolean" }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items", "next_offset"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title", "status", "created_at", "is_archived"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 128 },
                "title": { "type": ["string", "null"], "maxLength": 200 },
                "status": { "type": ["string", "null"], "maxLength": 64 },
                "created_at": { "type": ["string", "null"], "maxLength": 64 },
                "is_archived": { "type": "boolean" }
              }
            }
          },
          "next_offset": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    },
    {
      "id": "usage.host.session_detail",
      "title": "读取单条宿主会话元数据",
      "permissions": ["host.sessions.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["session_id"],
        "properties": {
          "session_id": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["found", "session"],
        "properties": {
          "found": { "type": "boolean" },
          "session": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["id", "title", "status", "created_at", "is_archived"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 128 },
              "title": { "type": ["string", "null"], "maxLength": 200 },
              "status": { "type": ["string", "null"], "maxLength": 64 },
              "created_at": { "type": ["string", "null"], "maxLength": 64 },
              "is_archived": { "type": "boolean" }
            }
          }
        }
      }
    },
    {
      "id": "usage.host.projects",
      "title": "分页读取宿主项目列表",
      "permissions": ["host.projects.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "offset": { "type": "integer", "minimum": 0, "maximum": 10000 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 50 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items", "next_offset"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "status"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 128 },
                "name": { "type": ["string", "null"], "maxLength": 200 },
                "status": { "type": ["string", "null"], "maxLength": 64 }
              }
            }
          },
          "next_offset": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    },
    {
      "id": "usage.budget.save",
      "title": "更新月度 Token 预算与告警阈值",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "monthly_tokens_m", "warn_pct", "critical_pct"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "monthly_tokens_m": { "type": "number", "minimum": 0.1, "maximum": 10000 },
          "warn_pct": { "type": "integer", "minimum": 1, "maximum": 99 },
          "critical_pct": { "type": "integer", "minimum": 2, "maximum": 100 },
          "alert_note": { "type": "string", "maxLength": 400 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["saved", "conflict", "limit", "invalid_input"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    },
    {
      "id": "usage.note.save",
      "title": "新增或更新手动复盘笔记",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "title", "body"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "title": { "type": "string", "minLength": 1, "maxLength": 100 },
          "range_days": { "type": "integer", "enum": [7, 30] },
          "tags": { "type": "string", "maxLength": 120 },
          "body": { "type": "string", "minLength": 1, "maxLength": 4000 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision", "key", "id"],
        "properties": {
          "status": { "type": "string", "enum": ["saved", "conflict", "limit", "invalid_input"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "key": { "type": "string", "maxLength": 96 },
          "id": { "type": "string", "maxLength": 64 }
        }
      }
    },
    {
      "id": "usage.note.list",
      "title": "分页列举手动复盘笔记",
      "permissions": ["data.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "prefix": { "type": "string", "maxLength": 64 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 30 },
          "cursor": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revision", "items", "next_cursor"],
        "properties": {
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "id", "title", "range_days", "tags", "body", "updated_at"],
              "properties": {
                "key": { "type": "string", "minLength": 1, "maxLength": 96 },
                "id": { "type": "string", "minLength": 1, "maxLength": 64 },
                "title": { "type": "string", "minLength": 1, "maxLength": 100 },
                "range_days": { "type": "integer", "enum": [7, 30] },
                "tags": { "type": "string", "maxLength": 120 },
                "body": { "type": "string", "maxLength": 4000 },
                "updated_at": { "type": "string", "maxLength": 64 }
              }
            }
          },
          "next_cursor": { "type": ["string", "null"], "maxLength": 128 }
        }
      }
    },
    {
      "id": "usage.note.delete",
      "title": "删除单条手动复盘笔记",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "key"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
          "key": { "type": "string", "minLength": 1, "maxLength": 96 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "revision"],
        "properties": {
          "status": { "type": "string", "enum": ["deleted", "not_found", "conflict", "invalid_input"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    }
  ],
  "tools": [
    {
      "id": "usage.get_host_summary",
      "title": "读取宿主真实 Token 用量与预算健康状态",
      "description": "从 Velai Desktop 宿主读取近 7 天或 30 天真实用量遥测（保留缺测为 null），结合个人月度 Token 预算计算消耗占比与告警等级。",
      "permissions": ["host.usage.read", "data.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "days": { "type": "integer", "enum": [7, 30] }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "success",
          "status",
          "days",
          "as_of",
          "timezone",
          "window_total_tokens",
          "window_input_tokens",
          "window_output_tokens",
          "window_cached_tokens",
          "cache_rate",
          "tokens_per_second",
          "budget_monthly_tokens_m",
          "token_used_pct",
          "budget_alert_level",
          "top_model",
          "models_truncated",
          "by_model_count"
        ],
        "properties": {
          "success": { "type": "boolean" },
          "status": { "type": "string", "enum": ["ready", "missing_metrics"] },
          "days": { "type": "integer", "enum": [7, 30] },
          "as_of": { "type": "string", "maxLength": 64 },
          "timezone": { "type": "string", "maxLength": 64 },
          "window_total_tokens": { "type": ["integer", "null"], "minimum": 0 },
          "window_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
          "window_output_tokens": { "type": ["integer", "null"], "minimum": 0 },
          "window_cached_tokens": { "type": ["integer", "null"], "minimum": 0 },
          "cache_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
          "tokens_per_second": { "type": ["number", "null"], "minimum": 0 },
          "budget_monthly_tokens_m": { "type": "number", "minimum": 0.1, "maximum": 10000 },
          "token_used_pct": { "type": ["number", "null"], "minimum": 0 },
          "budget_alert_level": { "type": "string", "enum": ["ok", "warn", "critical", "unknown"] },
          "top_model": { "type": ["string", "null"], "maxLength": 128 },
          "models_truncated": { "type": "boolean" },
          "by_model_count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    {
      "id": "usage.list_host_sessions",
      "title": "列举宿主近期会话与关联项目元数据",
      "description": "从 Velai Desktop 宿主分页读取当前账号可见的会话元数据（不含消息正文）及项目列表，便于整理工作上下文。",
      "permissions": ["host.sessions.read", "host.projects.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "offset": { "type": "integer", "minimum": 0, "maximum": 10000 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 50 },
          "is_archived": { "type": "boolean" },
          "include_projects": { "type": "boolean" }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "success",
          "status",
          "sessions",
          "next_offset",
          "projects",
          "projects_next_offset"
        ],
        "properties": {
          "success": { "type": "boolean" },
          "status": { "type": "string", "enum": ["ready", "empty"] },
          "sessions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title", "status", "created_at", "is_archived"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 128 },
                "title": { "type": ["string", "null"], "maxLength": 200 },
                "status": { "type": ["string", "null"], "maxLength": 64 },
                "created_at": { "type": ["string", "null"], "maxLength": 64 },
                "is_archived": { "type": "boolean" }
              }
            }
          },
          "next_offset": { "type": ["integer", "null"], "minimum": 0 },
          "projects": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "status"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 128 },
                "name": { "type": ["string", "null"], "maxLength": 200 },
                "status": { "type": ["string", "null"], "maxLength": 64 }
              }
            }
          },
          "projects_next_offset": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    },
    {
      "id": "usage.update_budget_alert",
      "title": "更新个人月度 Token 预算告警规则",
      "description": "配置个人 30 天 Token 预算上限（百万级）、预警/严重告警百分比阈值以及复盘提醒备注。",
      "permissions": ["data.read", "data.write"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["monthly_tokens_m"],
        "properties": {
          "monthly_tokens_m": { "type": "number", "minimum": 0.1, "maximum": 10000 },
          "warn_pct": { "type": "integer", "minimum": 1, "maximum": 99 },
          "critical_pct": { "type": "integer", "minimum": 2, "maximum": 100 },
          "alert_note": { "type": "string", "maxLength": 400 }
        }
      },
      "output_schema": {
