{
  "manifest_version": 2,
  "plugin_id": "novel-ai-writer",
  "name": "小说 AI 流式写作助手",
  "version": "2.0.0",
  "host_api": 2,
  "backend": "backend/index.js",
  "page": "ui/index.html",
  "ui": {
    "icon": "edit",
    "surfaces": ["workspace"]
  },
  "permissions": ["ai.complete"],
  "ai": {
    "model": "gpt/gpt-6.2-astra",
    "max_output_tokens": 1024,
    "max_call_microcredits": 50000,
    "max_day_microcredits": 500000
  },
  "actions": [
    {
      "id": "writer.stream_chapter",
      "title": "流式续写小说章节正文",
      "permissions": ["ai.complete"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "book_title", "chapter_title", "context"],
        "properties": {
          "request_id": { "type": "string", "minLength": 36, "maxLength": 36 },
          "book_title": { "type": "string", "minLength": 1, "maxLength": 100 },
          "chapter_title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "genre": { "type": "string", "maxLength": 48 },
          "pov": { "type": "string", "maxLength": 64 },
          "tone": { "type": "string", "enum": ["literary", "suspense", "fast_paced", "poetic", "dramatic"] },
          "context": { "type": "string", "minLength": 1, "maxLength": 3600 },
          "instruction": { "type": "string", "maxLength": 1200 },
          "target_words": { "type": "integer", "minimum": 100, "maximum": 3000 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "status", "prompt_bytes"],
        "properties": {
          "request_id": { "type": "string", "minLength": 36, "maxLength": 36 },
          "status": { "type": "string", "enum": ["started"] },
          "prompt_bytes": { "type": "integer", "minimum": 1, "maximum": 8192 }
        }
      }
    },
    {
      "id": "writer.outline_json",
      "title": "生成结构化 JSON 章节细纲",
      "permissions": ["ai.complete"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "book_title", "premise"],
        "properties": {
          "request_id": { "type": "string", "minLength": 36, "maxLength": 36 },
          "book_title": { "type": "string", "minLength": 1, "maxLength": 100 },
          "chapter_no": { "type": "integer", "minimum": 1, "maximum": 5000 },
          "premise": { "type": "string", "minLength": 1, "maxLength": 3000 },
          "characters": { "type": "string", "maxLength": 1200 },
          "foreshadowing": { "type": "string", "maxLength": 1000 },
          "scene_count": { "type": "integer", "minimum": 2, "maximum": 8 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "model", "outline", "input_tokens", "output_tokens", "cost_microcredits"],
        "properties": {
          "request_id": { "type": "string", "minLength": 36, "maxLength": 36 },
          "model": { "type": "string", "minLength": 1, "maxLength": 128 },
          "outline": { "type": ["object", "null"], "additionalProperties": true },
          "input_tokens": { "type": "integer", "minimum": 0 },
          "output_tokens": { "type": "integer", "minimum": 0 },
          "cost_microcredits": { "type": "integer", "minimum": 0 }
        }
      }
    },
    {
      "id": "writer.cancel",
      "title": "取消进行中的流式写作请求",
      "permissions": ["ai.complete"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id"],
        "properties": {
          "request_id": { "type": "string", "minLength": 36, "maxLength": 36 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "status"],
        "properties": {
          "request_id": { "type": "string", "minLength": 36, "maxLength": 36 },
          "status": { "type": "string", "enum": ["cancel_requested"] }
        }
      }
    }
  ],
  "tools": [],
  "data": [],
  "http": [],
  "tasks": [],
  "files": []
}
