{
  "manifest_version": 1,
  "plugin_id": "reply-polisher",
  "name": "回复改写与格式助手",
  "version": "1.0.0",
  "host_api": 1,
  "backend": "backend/index.js",
  "page": "ui/index.html",
  "ui": {
    "icon": "edit",
    "surfaces": ["workspace", "chat", "assistant"]
  },
  "permissions": ["tasks.start", "tasks.read", "tasks.cancel"],
  "actions": [
    {
      "id": "text.transform",
      "title": "本地清洗与格式化文本",
      "permissions": [],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mode", "text"],
        "properties": {
          "mode": { "type": "string", "enum": ["tidy", "strip_markdown", "to_bullets", "quote_reply"] },
          "text": { "type": "string", "minLength": 1, "maxLength": 6000 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["result", "chars", "words", "lines"],
        "properties": {
          "result": { "type": "string", "maxLength": 8000 },
          "chars": { "type": "integer", "minimum": 0, "maximum": 100000 },
          "words": { "type": "integer", "minimum": 0, "maximum": 100000 },
          "lines": { "type": "integer", "minimum": 0, "maximum": 10000 }
        }
      }
    },
    {
      "id": "session.turn.request",
      "title": "交给当前会话改写",
      "permissions": ["tasks.start"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prompt", "work_id"],
        "properties": {
          "prompt": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "work_id": { "type": "string", "minLength": 36, "maxLength": 36 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "state"],
        "properties": {
          "task_id": { "type": "string", "minLength": 36, "maxLength": 36 },
          "state": { "type": "string", "enum": ["dispatching"] }
        }
      }
    },
    {
      "id": "session.turn.result",
      "title": "核对改写结果",
      "permissions": ["tasks.read"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["work_id"],
        "properties": {
          "work_id": { "type": "string", "minLength": 36, "maxLength": 36 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": true,
        "required": ["work_id", "state", "truncated"],
        "properties": {
          "work_id": { "type": "string", "minLength": 36, "maxLength": 36 },
          "state": { "type": "string", "enum": ["dispatching", "running", "waiting", "completed", "cancelled", "failed", "unknown", "unavailable"] },
          "truncated": { "type": "boolean" }
        }
      }
    }
  ],
  "tools": [],
  "data": [],
  "http": [],
  "tasks": [],
  "files": []
}
