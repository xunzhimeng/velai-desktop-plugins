{
  "manifest_version": 1,
  "plugin_id": "fx-market-board",
  "name": "实时汇率换算看板",
  "version": "1.0.0",
  "host_api": 1,
  "backend": "backend/index.js",
  "page": "ui/index.html",
  "ui": {
    "icon": "table",
    "surfaces": ["workspace", "chat"]
  },
  "permissions": ["http.request"],
  "actions": [
    {
      "id": "fx.rates",
      "title": "拉取欧央行最新参考汇率",
      "permissions": ["http.request"],
      "input_schema": { "type": "object", "additionalProperties": false, "required": [], "properties": {} },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ok"],
        "properties": {
          "ok": { "type": "boolean" },
          "base": { "type": "string", "minLength": 3, "maxLength": 3 },
          "date": { "type": "string", "minLength": 10, "maxLength": 10 },
          "rates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "rate"],
              "properties": {
                "code": { "type": "string", "minLength": 3, "maxLength": 3 },
                "rate": { "type": "number", "minimum": 0.000001, "maximum": 10000000 }
              }
            }
          },
          "code": { "type": "string", "maxLength": 48 }
        }
      }
    },
    {
      "id": "fx.currencies",
      "title": "拉取支持币种目录",
      "permissions": ["http.request"],
      "input_schema": { "type": "object", "additionalProperties": false, "required": [], "properties": {} },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ok"],
        "properties": {
          "ok": { "type": "boolean" },
          "currencies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "name"],
              "properties": {
                "code": { "type": "string", "minLength": 3, "maxLength": 3 },
                "name": { "type": "string", "minLength": 1, "maxLength": 80 }
              }
            }
          },
          "code": { "type": "string", "maxLength": 48 }
        }
      }
    },
    {
      "id": "fx.convert",
      "title": "交叉汇率计算",
      "permissions": [],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["amount", "from_rate", "to_rate"],
        "properties": {
          "amount": { "type": "number", "minimum": 0, "maximum": 1000000000000 },
          "from_rate": { "type": "number", "minimum": 0.000001, "maximum": 10000000 },
          "to_rate": { "type": "number", "minimum": 0.000001, "maximum": 10000000 }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["converted", "unit_rate"],
        "properties": {
          "converted": { "type": "number", "minimum": 0, "maximum": 100000000000000 },
          "unit_rate": { "type": "number", "minimum": 0, "maximum": 100000000 }
        }
      }
    }
  ],
  "tools": [],
  "data": [],
  "http": [
    { "host": "api.frankfurter.dev", "port": 443, "path": "/v1/latest", "methods": ["GET"] },
    { "host": "api.frankfurter.dev", "port": 443, "path": "/v1/currencies", "methods": ["GET"] }
  ],
  "tasks": [],
  "files": []
}
