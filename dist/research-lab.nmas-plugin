{"files":[{"content":"const COL_PAPERS = 'papers';\nconst COL_MATRIX = 'matrix';\nconst COL_NOTES = 'notes';\nconst KEY_CATALOG = 'catalog';\nconst KEY_GRID = 'grid';\nconst KEY_NOTES_IDX = 'index';\n\nconst MAX_RECORD_BYTES = 240 * 1024;\nconst MAX_BYTES = MAX_RECORD_BYTES;\nconst MAX_PAPERS = 80;\nconst MAX_NOTES = 64;\nconst STATUSES = ['unread', 'reading', 'annotated', 'cited'];\nconst MODES = ['related_work', 'research_gaps', 'experiment_plan', 'peer_review', 'custom'];\nconst LIB_FORMAT = 'velai.research-lab.library';\nconst NOTE_FORMAT = 'velai.research-lab.note';\n\nfunction jsonBytes(value) {\n  let bytes = 0;\n  const s = JSON.stringify(value);\n  for (let i = 0; i < s.length; i++) {\n    const cp = s.codePointAt(i);\n    if (cp > 0xffff) i++;\n    bytes += cp <= 0x7f ? 1 : cp <= 0x7ff ? 2 : cp <= 0xffff ? 3 : 4;\n  }\n  return bytes;\n}\n\nfunction today() {\n  return new Date().toISOString().slice(0, 10);\n}\n\nfunction cleanStrList(arr, maxCount, maxLen) {\n  if (!Array.isArray(arr)) return [];\n  const out = [];\n  const seen = new Set();\n  for (const item of arr) {\n    if (typeof item !== 'string') continue;\n    const t = item.trim().slice(0, maxLen);\n    if (!t || seen.has(t)) continue;\n    seen.add(t);\n    out.push(t);\n    if (out.length >= maxCount) break;\n  }\n  return out;\n}\n\nfunction defaultMatrixRow(paper) {\n  return {\n    architecture: paper?.method || '',\n    datasets: '',\n    metrics: paper?.contribution || '',\n    limitations: paper?.limitations || '',\n    reusable: '',\n  };\n}\n\nasync function readPapers() {\n  const r = await globalThis.nmas.data.read({ collection: COL_PAPERS, key: KEY_CATALOG });\n  const doc = r.value === null ? { schema_version: 1, items: [] } : r.value;\n  if (!doc || doc.schema_version !== 1 || !Array.isArray(doc.items)) {\n    throw new Error('文献库数据格式无效');\n  }\n  return { revision: r.revision, items: doc.items };\n}\n\nasync function readMatrix() {\n  const r = await globalThis.nmas.data.read({ collection: COL_MATRIX, key: KEY_GRID });\n  const doc = r.value === null ? { schema_version: 1, selected_ids: [], rows: {} } : r.value;\n  if (!doc || doc.schema_version !== 1 || !Array.isArray(doc.selected_ids) || typeof doc.rows !== 'object' || doc.rows === null) {\n    throw new Error('对比矩阵数据格式无效');\n  }\n  return { revision: r.revision, matrix: { selected_ids: doc.selected_ids, rows: doc.rows } };\n}\n\nasync function readNotesIndex() {\n  const r = await globalThis.nmas.data.read({ collection: COL_NOTES, key: KEY_NOTES_IDX });\n  const doc = r.value === null ? { schema_version: 1, items: [] } : r.value;\n  if (!doc || doc.schema_version !== 1 || !Array.isArray(doc.items)) {\n    throw new Error('科研笔记索引格式无效');\n  }\n  return { revision: r.revision, items: doc.items };\n}\n\nasync function readNoteDoc(id) {\n  const r = await globalThis.nmas.data.read({ collection: COL_NOTES, key: `doc:${id}` });\n  if (r.value === null) return { revision: r.revision, found: false };\n  const n = r.value;\n  return {\n    revision: r.revision,\n    found: true,\n    note: {\n      id: n.id || id,\n      title: n.title || '未命名笔记',\n      mode: MODES.includes(n.mode) ? n.mode : 'custom',\n      paper_ids: Array.isArray(n.paper_ids) ? n.paper_ids : [],\n      content: n.content || '',\n      created_at: n.created_at || '',\n    },\n  };\n}\n\nasync function safeWrite(collection, key, expectedRevision, value) {\n  if (jsonBytes(value) > MAX_BYTES) {\n    return { ok: false, status: 'limit', revision: expectedRevision };\n  }\n  try {\n    const receipt = await globalThis.nmas.data.write({\n      collection,\n      key,\n      expected_revision: expectedRevision,\n      value,\n    });\n    return { ok: true, status: 'saved', revision: receipt.revision };\n  } catch (err) {\n    if (err?.code === 'conflict' && err.outcome_unknown === false) {\n      return { ok: false, status: 'conflict', revision: expectedRevision };\n    }\n    if (err?.code === 'resource_limit') {\n      return { ok: false, status: 'limit', revision: expectedRevision };\n    }\n    throw err;\n  }\n}\n\nasync function safeDelete(collection, key, expectedRevision) {\n  try {\n    const receipt = await globalThis.nmas.data.delete({\n      collection,\n      key,\n      expected_revision: expectedRevision,\n    });\n    return { ok: true, status: 'deleted', revision: receipt.revision };\n  } catch (err) {\n    if (err?.code === 'conflict' && err.outcome_unknown === false) {\n      return { ok: false, status: 'conflict', revision: expectedRevision };\n    }\n    throw err;\n  }\n}\n\nasync function readPluginSettings() {\n  const raw = await globalThis.nmas.settings.get();\n  const citation_style = typeof raw?.citation_style === 'string' && raw.citation_style.trim()\n    ? raw.citation_style.trim().slice(0, 32)\n    : 'APA';\n  const rowsNum = Number.isInteger(raw?.default_rows) ? raw.default_rows : 5;\n  const default_rows = Math.max(1, Math.min(20, rowsNum));\n  return { citation_style, default_rows };\n}\n\nfunction formatCitation(style, { authors, year, title, venue, doi }) {\n  const upper = String(style || 'APA').toUpperCase();\n  if (upper === 'IEEE') {\n    return `${authors || 'Unknown'}, \"${title},\" ${venue || 'Crossref'}, ${year}.${doi ? ` doi: ${doi}.` : ''}`.slice(0, 400);\n  }\n  if (upper === 'MLA') {\n    return `${authors || 'Unknown'}. \"${title}.\" ${venue || 'Crossref'}, ${year}.`.slice(0, 400);\n  }\n  return `${authors || 'Unknown'} (${year}). ${title}. ${venue || 'Crossref'}.${doi ? ` https://doi.org/${doi}` : ''}`.slice(0, 400);\n}\n\nfunction parseCrossrefItem(raw, citationStyle) {\n  const doi = typeof raw?.DOI === 'string' ? raw.DOI.trim().slice(0, 120) : '';\n  const titleArr = Array.isArray(raw?.title) ? raw.title : typeof raw?.title === 'string' ? [raw.title] : [];\n  const title = (titleArr[0] || 'Untitled Work').replace(/\\s+/g, ' ').trim().slice(0, 240);\n  const authorList = Array.isArray(raw?.author)\n    ? raw.author\n        .slice(0, 4)\n        .map(a => [a?.given, a?.family].filter(Boolean).join(' ').trim())\n        .filter(Boolean)\n    : [];\n  const authors = (authorList.length\n    ? authorList.join(', ') + (Array.isArray(raw?.author) && raw.author.length > 4 ? ' et al.' : '')\n    : 'Unknown').slice(0, 160);\n  const parts = raw?.published?.['date-parts']?.[0] || raw?.['published-print']?.['date-parts']?.[0] || raw?.issued?.['date-parts']?.[0] || [];\n  const rawYear = Number(parts[0] ?? raw?.year ?? 2024);\n  const year = Number.isInteger(rawYear) && rawYear >= 1900 && rawYear <= 2100 ? rawYear : 2024;\n  const venueArr = Array.isArray(raw?.['container-title']) ? raw['container-title'] : [];\n  const venue = (venueArr[0] || raw?.publisher || 'Crossref').replace(/\\s+/g, ' ').trim().slice(0, 96);\n  const url = (typeof raw?.URL === 'string' && raw.URL.trim() ? raw.URL.trim() : doi ? `https://doi.org/${doi}` : '').slice(0, 240);\n  const citation = formatCitation(citationStyle, { authors, year, title, venue, doi });\n  return { doi, title, authors, year, venue, url, citation };\n}\n\nasync function searchCrossref(queryInput, rowsInput) {\n  const cleanQuery = String(queryInput || '').trim().slice(0, 200);\n  const settings = await readPluginSettings();\n  if (!cleanQuery) {\n    return { status: 'invalid_input', query: '', citation_style: settings.citation_style, total_results: 0, items: [], error: '检索关键词不能为空' };\n  }\n  const rows = Number.isInteger(rowsInput) ? Math.max(1, Math.min(20, rowsInput)) : settings.default_rows;\n  try {\n    const res = await globalThis.nmas.http.request({\n      rule: 0,\n      method: 'GET',\n      path: '/works',\n      query: { query: cleanQuery, rows: String(rows) },\n      headers: { accept: 'application/json' },\n      responseType: 'json',\n    });\n    if (res.status && res.status >= 400) {\n      return {\n        status: 'http_error',\n        query: cleanQuery,\n        citation_style: settings.citation_style,\n        total_results: 0,\n        items: [],\n        error: `Crossref HTTP ${res.status}`,\n      };\n    }\n    const msg = res.json?.message ?? res.json ?? {};\n    const rawItems = Array.isArray(msg.items) ? msg.items : [];\n    const total = Number.isInteger(msg['total-results']) && msg['total-results'] >= 0 ? msg['total-results'] : rawItems.length;\n    const items = rawItems.slice(0, rows).map(it => parseCrossrefItem(it, settings.citation_style));\n    return {\n      status: 'ok',\n      query: cleanQuery,\n      citation_style: settings.citation_style,\n      total_results: total,\n      items,\n    };\n  } catch (err) {\n    return {\n      status: 'http_error',\n      query: cleanQuery,\n      citation_style: settings.citation_style,\n      total_results: 0,\n      items: [],\n      error: String(err?.message || 'network_error').slice(0, 160),\n    };\n  }\n}\n\nfunction computeKpi(papers, notes) {\n  const total_papers = papers.length;\n  const annotated_or_cited = papers.filter(p => p.status === 'annotated' || p.status === 'cited').length;\n  const idSet = new Set(papers.map(p => p.id));\n  let citation_edges = 0;\n  for (const p of papers) {\n    for (const c of p.cites || []) {\n      if (idSet.has(c) && c !== p.id) citation_edges += 1;\n    }\n  }\n  const avg_rating = total_papers === 0\n    ? 0\n    : Math.round((papers.reduce((s, p) => s + p.rating, 0) / total_papers) * 10) / 10;\n  return {\n    total_papers,\n    annotated_or_cited,\n    citation_edges,\n    total_notes: notes.length,\n    avg_rating,\n  };\n}\n\nfunction buildDemoData() {\n  const papers = [\n    {\n      id: 'lewis2020rag',\n      title: 'Retrieval-Augmented Generation for Knowledge-Intensive NLP Tasks',\n      authors: 'Patrick Lewis, Ethan Perez, Aleksandra Piktus et al.',\n      year: 2020,\n      venue: 'NeurIPS 2020',\n      tags: ['RAG', 'Knowledge', 'Retrieval'],\n      rating: 5,\n      status: 'cited',\n      method: '将稠密检索器 DPR 与 seq2seq 生成器 BART 端到端联合微调，通过边缘化隐变量文档分布实现非参数知识注入。',\n      contribution: '奠定现代 RAG 范式，显著降低知识密集型问答幻觉并支持无需重训即可热更新外部知识库。',\n      limitations: '固定 Top-K 检索难以应对多跳推理；检索噪声与生成器上下文截断容易导致信息失真。',\n      cites: [],\n    },\n    {\n      id: 'yao2023react',\n      title: 'ReAct: Synergizing Reasoning and Acting in Language Models',\n      authors: 'Shunyu Yao, Jeffrey Zhao, Dian Yu, Nan Du et al.',\n      year: 2023,\n      venue: 'ICLR 2023',\n      tags: ['Agent', 'Reasoning', 'ToolUse'],\n      rating: 5,\n      status: 'cited',\n      method: '交替生成 Thought 推理轨迹与 Action 工具调用，利用外部环境 Observation 闭环修正推理错误。',\n      contribution: '首次系统证明推理与行动协同优于纯 CoT 或纯 Act，极大增强轨迹可解释性与事实接地能力。',\n      limitations: '长链路任务易陷入重复循环并耗尽上下文窗口；对提示词格式与基础模型指令遵循敏感。',\n      cites: ['lewis2020rag'],\n    },\n    {\n      id: 'schick2023toolformer',\n      title: 'Toolformer: Language Models Can Teach Themselves to Use Tools',\n      authors: 'Timo Schick, Jane Dwivedi-Yu, Roberto Dessi et al.',\n      year: 2023,\n      venue: 'NeurIPS 2023',\n      tags: ['ToolUse', 'Agent', 'SelfSup'],\n      rating: 4,\n      status: 'annotated',\n      method: '基于自监督困惑度过滤机制，自动采样并筛选能降低后续 token 预测损失的 API 调用样本进行微调。',\n      contribution: '证明中等规模语言模型无需大量人工标注即可学会自主判断何时、如何调用外部工具。',\n      limitations: '仅支持单步无状态工具调用，缺乏链式组合、多轮交互与工具执行失败后的恢复机制。',\n      cites: ['lewis2020rag'],\n    },\n    {\n      id: 'asai2024selfrag',\n      title: 'Self-RAG: Learning to Retrieve, Generate, and Critique through Self-Reflection',\n      authors: 'Akari Asai, Zeqiu Wu, Yizhong Wang, Hannaneh Hajishirzi',\n      year: 2024,\n      venue: 'ICLR 2024',\n      tags: ['RAG', 'Reflection', 'Critique'],\n      rating: 5,\n      status: 'annotated',\n      method: '引入特殊反思令牌 (Retrieve/ISREL/ISSUP/ISUSE)，让模型按需触发检索并在生成阶段自评相关性与事实支撑度。',\n      contribution: '突破固定检索瓶颈，在开放域问答与长文引用准确性上显著超越标准 RAG 与更大参数基线。',\n      limitations: '反思令牌解码与树搜索带来推理延迟上升；训练依赖高质量评判模型蒸馏数据。',\n      cites: ['lewis2020rag', 'schick2023toolformer'],\n    },\n    {\n      id: 'wang2024voyager',\n      title: 'Voyager: An Open-Ended Embodied Agent with Large Language Models',\n      authors: 'Guanzhi Wang, Yuqi Xie, Yunfan Jiang, Linxi Fan et al.',\n      year: 2024,\n      venue: 'TMLR 2024',\n      tags: ['Agent', 'Sandbox', 'CodeExec'],\n      rating: 4,\n      status: 'reading',\n      method: '结合自动课程生成、可执行代码技能库与环境反馈自校验循环，在开放沙箱中持续积累可复用程序技能。',\n      contribution: '提出以可执行代码作为长期记忆的终身学习智能体架构，显著提升探索广度与跨任务泛化。',\n      limitations: '严重依赖强代码大模型与高成本闭环试错；沙箱执行安全隔离与技能版本漂移仍待治理。',\n      cites: ['yao2023react', 'schick2023toolformer'],\n    },\n    {\n      id: 'jimenez2024swebench',\n      title: 'SWE-bench: Can Language Models Resolve Real-World GitHub Issues?',\n      authors: 'Carlos E. Jimenez, John Yang, Alexander Wettig, Karthik Narasimhan',\n      year: 2024,\n      venue: 'ICLR 2024',\n      tags: ['Sandbox', 'Benchmark', 'Agent'],\n      rating: 5,\n      status: 'annotated',\n      method: '从 12 个真实 Python 开源仓库构建 2294 个 Issue-PR 评测任务，在隔离容器沙箱中运行单元测试客观验证补丁。',\n      contribution: '建立软件工程 Agent 黄金评测基准，揭示长上下文跨文件定位、工具编排与测试驱动修复的真实瓶颈。',\n      limitations: '容器镜像构建与执行开销大；部分旧 Issue 存在测试覆盖盲区及训练语料污染风险。',\n      cites: ['lewis2020rag', 'yao2023react', 'wang2024voyager'],\n    },\n  ];\n\n  const rows = {\n    lewis2020rag: {\n      architecture: 'DPR 稠密双塔检索 + BART-Large 生成器端到端边缘化',\n      datasets: 'Natural Questions, TriviaQA, WebQuestions, FEVER',\n      metrics: 'NQ EM 44.5%，开放域问答大幅领先纯参数模型',\n      limitations: '固定 Top-K 检索，无法按需触发或自检证据冲突',\n      reusable: '非参数索引热更新设计，适合企业私有知识库接入',\n    },\n    yao2023react: {\n      architecture: 'Prompt 驱动的 Thought-Action-Observation 交替循环',\n      datasets: 'HotpotQA, Fever, ALFWorld, WebShop',\n      metrics: 'ALFWorld 成功率较纯 Act +34%，HotpotQA 显著降幻觉',\n      limitations: '轨迹冗长易超上下文，缺乏显式回溯与预算控制',\n      reusable: '标准化工具调用日志与可观测推理轨迹协议',\n    },\n    schick2023toolformer: {\n      architecture: 'GPT-J 6B + 自监督困惑度收益过滤微调',\n      datasets: 'ASDiv, SVAMP, LAMA, WebQS, TempLAMA',\n      metrics: '6.7B 模型在计算/问答工具任务超越 175B GPT-3',\n      limitations: '仅限单步无状态 API，不支持多工具组合编排',\n      reusable: '基于损失下降量自动筛选高质量工具轨迹的数据飞轮',\n    },\n    asai2024selfrag: {\n      architecture: 'Llama2-7B/13B + 自适应反思令牌 + 束搜索打分',\n      datasets: 'PopQA, TriviaQA, PubHealth, ASQA, FactScore',\n      metrics: 'FactScore 提升 15%+，长文引用精确度明显优于 ChatGPT+RAG',\n      limitations: '多候选片段打分增加首字与整句延迟',\n      reusable: '按需检索开关与生成后事实支撑度自检机制',\n    },\n    wang2024voyager: {\n      architecture: '自动课程 + 向量检索代码技能库 + 执行反馈迭代修复',\n      datasets: 'Minecraft 开放世界探索与科技树解锁基准',\n      metrics: '解锁物品数 3.3× 于基线，科技树速度提升 15.3×',\n      limitations: '高度依赖强推理模型 API 成本，缺乏沙箱安全策略',\n      reusable: '把验证通过的脚本沉淀为可检索技能库的长期记忆模式',\n    },\n    jimenez2024swebench: {\n      architecture: 'Docker 隔离代码执行沙箱 + 真实仓库 Git Patch 测试验证',\n      datasets: 'SWE-bench (2294 tasks) / SWE-bench Lite (300 tasks)',\n      metrics: '早期直接补丁仅 1.96%，推动 Agentic SWE 系统跃升至 50%+',\n      limitations: '环境复现耗资源，部分任务存在隐式环境依赖',\n      reusable: '基于确定性单元测试验收 Agent 输出的闭环评估框架',\n    },\n  };\n\n  const stamp = today();\n  const noteDocs = [\n    {\n      id: 'note-rw-agent-rag',\n      title: 'Related Work：从静态 RAG 到沙箱验证型自主智能体',\n      mode: 'related_work',\n      paper_ids: ['lewis2020rag', 'yao2023react', 'asai2024selfrag', 'jimenez2024swebench'],\n      created_at: stamp,\n      content: [\n        '## 相关工作脉络综述',\n        '',\n        '早期检索增强生成工作（Lewis et al., 2020）通过将非参数文档索引与预训练序列生成器解耦，有效缓解了知识密集型任务中的参数过时与幻觉问题。然而静态 Top-K 检索难以适配动态信息需求；Self-RAG（Asai et al., 2024）进一步引入反思令牌，使模型能够自适应决定检索时机并对证据支撑度进行细粒度自检。',\n        '',\n        '与此同时，语言模型智能体研究沿「推理—行动协同」方向迅速演进：ReAct（Yao et al., 2023）奠定了 Thought-Action-Observation 交替范式，Toolformer（Schick et al., 2023）探索了工具使用的自监督习得，Voyager（Wang et al., 2024）将可执行代码沉淀为可组合技能库。近期 SWE-bench（Jimenez et al., 2024）将上述能力推向真实软件工程沙箱，揭示了跨文件检索、受控工具执行与测试驱动验证深度融合的迫切需求。',\n      ].join('\\n'),\n    },\n    {\n      id: 'note-gaps-sandbox',\n      title: '核心研究空白：低延迟自反思检索与受控沙箱编排',\n      mode: 'research_gaps',\n      paper_ids: ['asai2024selfrag', 'wang2024voyager', 'jimenez2024swebench'],\n      created_at: stamp,\n      content: [\n        '## 跨文献共性研究空白与切入点',\n        '',\n        '1. **证据自检与执行成本的帕累托权衡**：Self-RAG 与 ReAct 在多步决策中均面临高延迟与上下文膨胀问题，缺乏基于置信度预算的早停与轻量化校验机制。',\n        '2. **可复用技能的沙箱安全边界**：Voyager 证明了代码技能库的威力，但未解决跨项目权限隔离、确定性回滚与版本漂移问题。',\n        '3. **检索—推理—沙箱测试联合优化**：现有 SWE Agent 大多将代码检索与补丁验证割裂处理，未来可探索以单元测试反馈作为检索重排与技能提炼的统一奖励信号。',\n      ].join('\\n'),\n    },\n  ];\n\n  const noteIndex = noteDocs.map(n => ({\n    id: n.id,\n    title: n.title,\n    mode: n.mode,\n    paper_ids: n.paper_ids,\n    created_at: n.created_at,\n    preview: n.content.replace(/\\s+/g, ' ').trim().slice(0, 140),\n  }));\n\n  return {\n    papers,\n    matrix: {\n      schema_version: 1,\n      selected_ids: ['lewis2020rag', 'yao2023react', 'asai2024selfrag', 'jimenez2024swebench'],\n      rows,\n    },\n    noteIndex,\n    noteDocs,\n  };\n}\n\nexport default async function (request) {\n  const { kind, contribution, input } = request ?? {};\n\n  if (kind === 'action') {\n    if (contribution === 'lab.load') {\n      const pData = await readPapers();\n      const mData = await readMatrix();\n      const nData = await readNotesIndex();\n      const settings = await readPluginSettings();\n      return {\n        revision: nData.revision,\n        kpi: computeKpi(pData.items, nData.items),\n        papers: pData.items,\n        matrix: mData.matrix,\n        notes: nData.items,\n        settings,\n      };\n    }\n\n    if (contribution === 'paper.save') {\n      const { expected_revision, id, title, authors, year, venue, tags, rating, status, method, contribution: contrib, limitations, cites } = input;\n      const cleanId = id.trim();\n      const cleanTitle = title.trim();\n      if (!cleanTitle || !/^[a-zA-Z0-9._-]+$/.test(cleanId) || !STATUSES.includes(status)) {\n        return { status: 'invalid_input', revision: expected_revision };\n      }\n      const pData = await readPapers();\n      if (pData.revision !== expected_revision) {\n        return { status: 'conflict', revision: pData.revision };\n      }\n      const exists = pData.items.some(p => p.id === cleanId);\n      if (!exists && pData.items.length >= MAX_PAPERS) {\n        return { status: 'limit', revision: pData.revision };\n      }\n      const record = {\n        id: cleanId,\n        title: cleanTitle,\n        authors: (authors || '').trim(),\n        year,\n        venue: (venue || '').trim(),\n        tags: cleanStrList(tags, 6, 24),\n        rating,\n        status,\n        method: (method || '').trim(),\n        contribution: (contrib || '').trim(),\n        limitations: (limitations || '').trim(),\n        cites: cleanStrList(cites, 12, 40).filter(c => c !== cleanId),\n      };\n      const next = exists ? pData.items.map(p => (p.id === cleanId ? record : p)) : [...pData.items, record];\n      const w = await safeWrite(COL_PAPERS, KEY_CATALOG, expected_revision, { schema_version: 1, items: next });\n      return { status: w.status, revision: w.revision };\n    }\n\n    if (contribution === 'paper.delete') {\n      const { expected_revision, id } = input;\n      const pData = await readPapers();\n      if (pData.revision !== expected_revision) return { status: 'conflict', revision: pData.revision };\n      if (!pData.items.some(p => p.id === id)) return { status: 'not_found', revision: pData.revision };\n      const mData = await readMatrix();\n\n      const nextPapers = pData.items\n        .filter(p => p.id !== id)\n        .map(p => ({ ...p, cites: (p.cites || []).filter(c => c !== id) }));\n      const w1 = await safeWrite(COL_PAPERS, KEY_CATALOG, expected_revision, { schema_version: 1, items: nextPapers });\n      if (!w1.ok) return { status: 'conflict', revision: w1.revision };\n      let rev = w1.revision;\n\n      const nextSel = mData.matrix.selected_ids.filter(x => x !== id);\n      const nextRows = { ...mData.matrix.rows };\n      const hadRow = Object.prototype.hasOwnProperty.call(nextRows, id);\n      delete nextRows[id];\n      if (hadRow || nextSel.length !== mData.matrix.selected_ids.length) {\n        const w2 = await safeWrite(COL_MATRIX, KEY_GRID, rev, { schema_version: 1, selected_ids: nextSel, rows: nextRows });\n        if (w2.ok) rev = w2.revision;\n      }\n      return { status: 'deleted', revision: rev };\n    }\n\n    if (contribution === 'matrix.save') {\n      const { expected_revision, selected_ids, paper_id, row } = input;\n      const mData = await readMatrix();\n      if (mData.revision !== expected_revision) return { status: 'conflict', revision: mData.revision };\n      const nextSel = Array.isArray(selected_ids) ? cleanStrList(selected_ids, 8, 40) : mData.matrix.selected_ids;\n      const nextRows = { ...mData.matrix.rows };\n      if (paper_id && row) {\n        nextRows[paper_id] = {\n          architecture: (row.architecture || '').trim(),\n          datasets: (row.datasets || '').trim(),\n          metrics: (row.metrics || '').trim(),\n          limitations: (row.limitations || '').trim(),\n          reusable: (row.reusable || '').trim(),\n        };\n      }\n      const w = await safeWrite(COL_MATRIX, KEY_GRID, expected_revision, {\n        schema_version: 1,\n        selected_ids: nextSel,\n        rows: nextRows,\n      });\n      return { status: w.status, revision: w.revision };\n    }\n\n    if (contribution === 'note.get') {\n      return readNoteDoc(input.id);\n    }\n\n    if (contribution === 'note.save') {\n      const { expected_revision, id, title, mode, paper_ids, content } = input;\n      const cleanId = id.trim();\n      const cleanTitle = title.trim();\n      const cleanContent = content.trim();\n      if (!cleanTitle || !cleanContent || !/^[a-zA-Z0-9._-]+$/.test(cleanId) || !MODES.includes(mode)) {\n        return { status: 'invalid_input', revision: expected_revision, id: cleanId };\n      }\n      const nIdx = await readNotesIndex();\n      if (nIdx.revision !== expected_revision) return { status: 'conflict', revision: nIdx.revision, id: cleanId };\n      const exists = nIdx.items.some(n => n.id === cleanId);\n      if (!exists && nIdx.items.length >= MAX_NOTES) {\n        return { status: 'limit', revision: nIdx.revision, id: cleanId };\n      }\n      const cleanPaperIds = cleanStrList(paper_ids, 8, 40);\n      const stamp = today();\n      const doc = {\n        schema_version: 1,\n        id: cleanId,\n        title: cleanTitle,\n        mode,\n        paper_ids: cleanPaperIds,\n        content: cleanContent,\n        created_at: stamp,\n      };\n      const w1 = await safeWrite(COL_NOTES, `doc:${cleanId}`, expected_revision, doc);\n      if (!w1.ok) return { status: w1.status, revision: w1.revision, id: cleanId };\n\n      const entry = {\n        id: cleanId,\n        title: cleanTitle,\n        mode,\n        paper_ids: cleanPaperIds,\n        created_at: stamp,\n        preview: cleanContent.replace(/\\s+/g, ' ').slice(0, 140),\n      };\n      const nextIdx = exists ? nIdx.items.map(n => (n.id === cleanId ? entry : n)) : [entry, ...nIdx.items];\n      const w2 = await safeWrite(COL_NOTES, KEY_NOTES_IDX, w1.revision, { schema_version: 1, items: nextIdx });\n      if (!w2.ok) return { status: w2.status, revision: w1.revision, id: cleanId };\n      return { status: 'saved', revision: w2.revision, id: cleanId };\n    }\n\n    if (contribution === 'note.delete') {\n      const { expected_revision, id } = input;\n      const nIdx = await readNotesIndex();\n      if (nIdx.revision !== expected_revision) return { status: 'conflict', revision: nIdx.revision };\n      if (!nIdx.items.some(n => n.id === id)) return { status: 'not_found', revision: nIdx.revision };\n      const nextIdx = nIdx.items.filter(n => n.id !== id);\n      const w1 = await safeWrite(COL_NOTES, KEY_NOTES_IDX, expected_revision, { schema_version: 1, items: nextIdx });\n      if (!w1.ok) return { status: 'conflict', revision: w1.revision };\n      let rev = w1.revision;\n      const w2 = await safeDelete(COL_NOTES, `doc:${id}`, rev);\n      if (w2.ok) rev = w2.revision;\n      return { status: 'deleted', revision: rev };\n    }\n\n    if (contribution === 'lab.seed_demo') {\n      const { expected_revision } = input;\n      const pData = await readPapers();\n      if (pData.revision !== expected_revision) {\n        return { status: 'conflict', revision: pData.revision, seeded_papers: 0, seeded_notes: 0 };\n      }\n      const demo = buildDemoData();\n      let rev = expected_revision;\n      const w1 = await safeWrite(COL_PAPERS, KEY_CATALOG, rev, { schema_version: 1, items: demo.papers });\n      if (!w1.ok) return { status: w1.status, revision: w1.revision, seeded_papers: 0, seeded_notes: 0 };\n      rev = w1.revision;\n\n      const w2 = await safeWrite(COL_MATRIX, KEY_GRID, rev, demo.matrix);\n      if (!w2.ok) return { status: w2.status, revision: rev, seeded_papers: 0, seeded_notes: 0 };\n      rev = w2.revision;\n\n      const w3 = await safeWrite(COL_NOTES, KEY_NOTES_IDX, rev, { schema_version: 1, items: demo.noteIndex });\n      if (!w3.ok) return { status: w3.status, revision: rev, seeded_papers: 0, seeded_notes: 0 };\n      rev = w3.revision;\n\n      for (const n of demo.noteDocs) {\n        const wn = await safeWrite(COL_NOTES, `doc:${n.id}`, rev, { schema_version: 1, ...n });\n        if (!wn.ok) return { status: wn.status, revision: rev, seeded_papers: 0, seeded_notes: 0 };\n        rev = wn.revision;\n      }\n\n      return { status: 'seeded', revision: rev, seeded_papers: demo.papers.length, seeded_notes: demo.noteDocs.length };\n    }\n\n    if (contribution === 'research.search_crossref') {\n      return searchCrossref(input.query, input.rows);\n    }\n\n    if (contribution === 'document.list') {\n      const pData = await readPapers();\n      const nIdx = await readNotesIndex();\n      const items = [];\n      if (pData.items.length > 0) {\n        items.push({ id: 'library', label: `文献库与方法论矩阵 (${pData.items.length} 篇论文)` });\n      }\n      for (const n of nIdx.items) {\n        items.push({ id: `note:${n.id}`, label: `科研笔记: ${n.title.slice(0, 56)}` });\n      }\n      return { items };\n    }\n\n    if (contribution === 'document.export') {\n      const id = input.id;\n      if (id === 'library') {\n        const pData = await readPapers();\n        const mData = await readMatrix();\n        const payload = { format: LIB_FORMAT, version: 1, papers: pData.items, matrix: mData.matrix };\n        const text = JSON.stringify(payload, null, 2);\n        if (jsonBytes(text) > MAX_BYTES) return { error: 'export_too_large' };\n        return { filename: 'research-lab-library.json', text };\n      }\n      if (id.startsWith('note:')) {\n        const noteId = id.slice(5);\n        const doc = await readNoteDoc(noteId);\n        if (!doc.found) return { error: 'not_found' };\n        const payload = { format: NOTE_FORMAT, version: 1, note: doc.note };\n        const text = JSON.stringify(payload, null, 2);\n        if (jsonBytes(text) > MAX_BYTES) return { error: 'export_too_large' };\n        return { filename: `research-note-${noteId}.json`, text };\n      }\n      return { error: 'not_found' };\n    }\n\n    if (contribution === 'document.import') {\n      let parsed;\n      try { parsed = JSON.parse(input.text); } catch { return { imported: false, reason: 'invalid_json', count: 0 }; }\n\n      if (parsed?.format === LIB_FORMAT && parsed?.version === 1 && Array.isArray(parsed.papers)) {\n        const pData = await readPapers();\n        const mData = await readMatrix();\n        const byId = new Map(pData.items.map(p => [p.id, p]));\n        let count = 0;\n        for (let i = 0; i < parsed.papers.length; i++) {\n          const raw = parsed.papers[i];\n          if (typeof raw?.title !== 'string' || !raw.title.trim()) continue;\n          const pid = typeof raw.id === 'string' && /^[a-zA-Z0-9._-]+$/.test(raw.id)\n            ? raw.id.slice(0, 40)\n            : `paper-${Date.now().toString(36)}-${i}`;\n          byId.set(pid, {\n            id: pid,\n            title: raw.title.trim().slice(0, 160),\n            authors: typeof raw.authors === 'string' ? raw.authors.trim().slice(0, 120) : '',\n            year: Number.isInteger(raw.year) && raw.year >= 1950 && raw.year <= 2100 ? raw.year : 2024,\n            venue: typeof raw.venue === 'string' ? raw.venue.trim().slice(0, 48) : '',\n            tags: cleanStrList(raw.tags, 6, 24),\n            rating: Number.isInteger(raw.rating) && raw.rating >= 1 && raw.rating <= 5 ? raw.rating : 4,\n            status: STATUSES.includes(raw.status) ? raw.status : 'unread',\n            method: typeof raw.method === 'string' ? raw.method.trim().slice(0, 260) : '',\n            contribution: typeof raw.contribution === 'string' ? raw.contribution.trim().slice(0, 260) : '',\n            limitations: typeof raw.limitations === 'string' ? raw.limitations.trim().slice(0, 260) : '',\n            cites: cleanStrList(raw.cites, 12, 40).filter(c => c !== pid),\n          });\n          count++;\n        }\n        const nextPapers = Array.from(byId.values());\n        if (nextPapers.length > MAX_PAPERS) return { imported: false, reason: 'limit', count: 0 };\n        const w1 = await safeWrite(COL_PAPERS, KEY_CATALOG, pData.revision, { schema_version: 1, items: nextPapers });\n        if (!w1.ok) return { imported: false, reason: w1.status, count: 0 };\n\n        if (parsed.matrix && typeof parsed.matrix.rows === 'object' && parsed.matrix.rows !== null) {\n          const nextRows = { ...mData.matrix.rows };\n          for (const [pid, row] of Object.entries(parsed.matrix.rows)) {\n            if (!byId.has(pid) || typeof row !== 'object' || row === null) continue;\n            nextRows[pid] = {\n              architecture: String(row.architecture || '').trim().slice(0, 240),\n              datasets: String(row.datasets || '').trim().slice(0, 180),\n              metrics: String(row.metrics || '').trim().slice(0, 180),\n              limitations: String(row.limitations || '').trim().slice(0, 240),\n              reusable: String(row.reusable || '').trim().slice(0, 240),\n            };\n          }\n          const nextSel = Array.isArray(parsed.matrix.selected_ids)\n            ? cleanStrList(parsed.matrix.selected_ids, 8, 40).filter(id => byId.has(id))\n            : mData.matrix.selected_ids;\n          await safeWrite(COL_MATRIX, KEY_GRID, w1.revision, { schema_version: 1, selected_ids: nextSel, rows: nextRows });\n        }\n        return { imported: true, count };\n      }\n\n      if (parsed?.format === NOTE_FORMAT && parsed?.version === 1 && parsed?.note && typeof parsed.note.content === 'string') {\n        const raw = parsed.note;\n        const nid = typeof raw.id === 'string' && /^[a-zA-Z0-9._-]+$/.test(raw.id)\n          ? raw.id.slice(0, 40)\n          : `note-${Date.now().toString(36)}`;\n        const title = typeof raw.title === 'string' && raw.title.trim() ? raw.title.trim().slice(0, 100) : '导入的科研笔记';\n        const content = raw.content.trim().slice(0, 6000);\n        if (!content) return { imported: false, reason: 'invalid_document', count: 0 };\n        const nIdx = await readNotesIndex();\n        const mode = MODES.includes(raw.mode) ? raw.mode : 'custom';\n        const paper_ids = cleanStrList(raw.paper_ids, 8, 40);\n        const stamp = today();\n        const doc = { schema_version: 1, id: nid, title, mode, paper_ids, content, created_at: stamp };\n        const w1 = await safeWrite(COL_NOTES, `doc:${nid}`, nIdx.revision, doc);\n        if (!w1.ok) return { imported: false, reason: w1.status, count: 0 };\n        const entry = { id: nid, title, mode, paper_ids, created_at: stamp, preview: content.replace(/\\s+/g, ' ').slice(0, 140) };\n        const exists = nIdx.items.some(n => n.id === nid);\n        const nextIdx = exists ? nIdx.items.map(n => (n.id === nid ? entry : n)) : [entry, ...nIdx.items];\n        const w2 = await safeWrite(COL_NOTES, KEY_NOTES_IDX, w1.revision, { schema_version: 1, items: nextIdx });\n        return w2.ok ? { imported: true, count: 1 } : { imported: false, reason: w2.status, count: 0 };\n      }\n\n      return { imported: false, reason: 'invalid_document', count: 0 };\n    }\n  }\n\n  if (kind === 'tool') {\n    if (contribution === 'paper.search') {\n      const pData = await readPapers();\n      const kw = (input.keyword || '').trim().toLowerCase();\n      const tagQ = (input.tag || '').trim().toLowerCase();\n      const filtered = pData.items\n        .filter(p => {\n          if (input.status && p.status !== input.status) return false;\n          if (input.min_rating && p.rating < input.min_rating) return false;\n          if (tagQ && !(p.tags || []).some(t => t.toLowerCase() === tagQ)) return false;\n          if (kw) {\n            const hay = `${p.id} ${p.title} ${p.authors} ${p.venue} ${(p.tags || []).join(' ')} ${p.method} ${p.contribution}`.toLowerCase();\n            if (!hay.includes(kw)) return false;\n          }\n          return true;\n        })\n        .sort((a, b) => b.year - a.year || b.rating - a.rating)\n        .map(p => ({\n          id: p.id,\n          title: p.title,\n          authors: p.authors,\n          year: p.year,\n          venue: p.venue,\n          rating: p.rating,\n          status: p.status,\n          tags: p.tags,\n          cites_count: (p.cites || []).length,\n        }));\n      return { success: true, status: 'ready', total: filtered.length, papers: filtered };\n    }\n\n    if (contribution === 'paper.read') {\n      const pData = await readPapers();\n      const paper = pData.items.find(p => p.id === input.id);\n      if (!paper) return { success: false, status: 'not_found' };\n      const mData = await readMatrix();\n      const cited_by = pData.items.filter(p => (p.cites || []).includes(paper.id)).map(p => p.id);\n      const matrix_row = mData.matrix.rows[paper.id] || defaultMatrixRow(paper);\n      return { success: true, status: 'ready', paper, cited_by, matrix_row };\n    }\n\n    if (contribution === 'paper.add') {\n      const cleanTitle = (input.title || '').trim();\n      const cleanAuthors = (input.authors || '').trim();\n      if (!cleanTitle || !cleanAuthors) return { success: false, status: 'invalid_input' };\n      const pData = await readPapers();\n      if (pData.items.length >= MAX_PAPERS) return { success: false, status: 'limit' };\n      const slug = cleanTitle.toLowerCase().replace(/[^a-z0-9]+/g, '').slice(0, 12) || 'paper';\n      const id = input.id && /^[a-zA-Z0-9._-]+$/.test(input.id.trim())\n        ? input.id.trim().slice(0, 40)\n        : `${slug}${input.year}-${pData.items.length + 1}`;\n      const record = {\n        id,\n        title: cleanTitle,\n        authors: cleanAuthors,\n        year: input.year,\n        venue: (input.venue || '').trim(),\n        tags: cleanStrList(input.tags, 6, 24),\n        rating: input.rating ?? 4,\n        status: STATUSES.includes(input.status) ? input.status : 'unread',\n        method: (input.method || '').trim(),\n        contribution: (input.contribution || '').trim(),\n        limitations: (input.limitations || '').trim(),\n        cites: cleanStrList(input.cites, 12, 40).filter(c => c !== id),\n      };\n      const exists = pData.items.some(p => p.id === id);\n      const next = exists ? pData.items.map(p => (p.id === id ? record : p)) : [...pData.items, record];\n      const w = await safeWrite(COL_PAPERS, KEY_CATALOG, pData.revision, { schema_version: 1, items: next });\n      return w.ok ? { success: true, status: 'saved', id } : { success: false, status: w.status };\n    }\n\n    if (contribution === 'research.search_literature') {\n      const res = await searchCrossref(input.query, input.rows);\n      return {\n        success: res.status === 'ok',\n        ...res,\n      };\n    }\n  }\n\n  throw new Error(`不支持的调用: ${kind}/${contribution}`);\n}\n","path":"backend/index.js"},{"content":"<!doctype html>\n<html lang=\"zh-CN\" data-theme=\"dark\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>AI 学术科研与文献综述工作台</title>\n<style>\n:root{--bg:#0a0d14;--bg-elev:#111622;--bg-card:#151c2c;--bg-hover:#1d263b;--bg-input:#0d121d;--border:#233049;--border-strong:#354769;--fg:#eef2fa;--fg-muted:#94a3bd;--fg-dim:#64748b;--accent:#818cf8;--accent-solid:#6366f1;--accent-soft:rgba(129,140,248,0.16);--sky:#38bdf8;--emerald:#34d399;--amber:#fbbf24;--rose:#fb7185;--shadow:0 12px 30px rgba(0,0,0,0.38);--radius:12px;font:13px/1.5 -apple-system,BlinkMacSystemFont,\"SF Pro Text\",\"PingFang SC\",\"Segoe UI\",system-ui,sans-serif;}\nhtml[data-theme=\"light\"]{--bg:#f4f6fb;--bg-elev:#ffffff;--bg-card:#ffffff;--bg-hover:#f1f5fb;--bg-input:#f8fafc;--border:#e2e8f0;--border-strong:#cbd5e1;--fg:#0f172a;--fg-muted:#475569;--fg-dim:#64748b;--accent:#4f46e5;--accent-solid:#4f46e5;--accent-soft:rgba(79,70,229,0.1);--sky:#0284c7;--emerald:#059669;--amber:#d97706;--rose:#e11d48;--shadow:0 8px 22px rgba(15,23,42,0.08);}\n*{box-sizing:border-box;}\nhtml,body{height:100%;margin:0;background:var(--bg);color:var(--fg);overflow:hidden;}\n::-webkit-scrollbar{width:7px;height:7px;}::-webkit-scrollbar-track{background:transparent;}::-webkit-scrollbar-thumb{background:var(--border-strong);border-radius:99px;}\n.app{display:grid;grid-template-columns:214px minmax(0,1fr);height:100vh;}\n.sidebar{background:var(--bg-elev);border-right:1px solid var(--border);display:flex;flex-direction:column;padding:14px 12px;gap:14px;overflow-y:auto;}\n.brand{display:flex;align-items:center;gap:10px;padding:4px 6px;}\n.brand-icon{width:30px;height:30px;border-radius:9px;flex-shrink:0;background:linear-gradient(135deg,#6366f1,#38bdf8);display:grid;place-items:center;color:#fff;font-weight:800;font-size:13px;box-shadow:0 4px 14px rgba(99,102,241,0.4);}\n.brand-title{font-size:13.5px;font-weight:700;line-height:1.2;}\n.brand-sub{font-size:11px;color:var(--fg-dim);}\n.nav{display:flex;flex-direction:column;gap:4px;}\n.nav-btn{display:flex;align-items:center;justify-content:space-between;gap:8px;width:100%;border:1px solid transparent;border-radius:9px;padding:9px 10px;background:transparent;color:var(--fg-muted);cursor:pointer;font:inherit;font-weight:500;text-align:left;transition:0.15s;}\n.nav-btn:hover{background:var(--bg-hover);color:var(--fg);}\n.nav-btn.active{background:var(--accent-soft);color:var(--fg);border-color:rgba(129,140,248,0.36);font-weight:600;}\n.nav-left{display:flex;align-items:center;gap:8px;}\n.nav-badge{font-size:11px;padding:1px 6px;border-radius:99px;background:var(--bg-card);border:1px solid var(--border);color:var(--fg-muted);}\n.side-foot{margin-top:auto;padding-top:12px;border-top:1px solid var(--border);display:flex;flex-direction:column;gap:8px;}\n.side-meta{font-size:11px;color:var(--fg-dim);display:flex;justify-content:space-between;padding:0 4px;}\n.workspace{display:flex;flex-direction:column;min-width:0;height:100vh;overflow:hidden;}\n.topbar{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;padding:11px 18px;border-bottom:1px solid var(--border);background:var(--bg-elev);}\n.top-title{display:flex;align-items:center;gap:10px;}\n.top-title h1{margin:0;font-size:15px;font-weight:700;}\n.rev-pill{font-size:11px;color:var(--fg-muted);background:var(--bg-card);border:1px solid var(--border);border-radius:99px;padding:2px 8px;}\n.toolbar{display:flex;align-items:center;gap:7px;flex-wrap:wrap;}\n.btn{display:inline-flex;align-items:center;gap:5px;border:1px solid var(--border);border-radius:8px;padding:6px 11px;background:var(--bg-card);color:var(--fg);font:inherit;font-weight:500;cursor:pointer;transition:0.15s;white-space:nowrap;}\n.btn:hover:not(:disabled){border-color:var(--border-strong);background:var(--bg-hover);}\n.btn.primary{background:var(--accent-solid);border-color:var(--accent-solid);color:#fff;}\n.btn.primary:hover:not(:disabled){filter:brightness(1.1);}\n.btn.ghost{background:transparent;}\n.btn.danger{color:var(--rose);border-color:rgba(251,113,133,0.35);}\n.btn.danger:hover:not(:disabled){background:rgba(251,113,133,0.12);}\n.btn.sm{padding:4px 8px;font-size:12px;border-radius:7px;}\n.btn:disabled{opacity:0.5;cursor:not-allowed;}\n.kpi-strip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;padding:12px 18px 4px;}\n.kpi-card{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:11px 14px;display:flex;flex-direction:column;gap:4px;position:relative;overflow:hidden;}\n.kpi-card::after{content:\"\";position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--kpi-c,var(--accent));}\n.kpi-label{font-size:11.5px;color:var(--fg-muted);display:flex;justify-content:space-between;}\n.kpi-val{font-size:22px;font-weight:800;letter-spacing:-0.02em;line-height:1.15;}\n.kpi-sub{font-size:11px;color:var(--fg-dim);}\n.main-scroll{flex:1;overflow-y:auto;padding:12px 18px 24px;display:flex;flex-direction:column;gap:14px;}\n.card{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:14px;display:flex;flex-direction:column;gap:12px;}\n.card-head{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;}\n.card-title{margin:0;font-size:14px;font-weight:700;display:flex;align-items:center;gap:8px;}\n.card-sub{font-size:12px;color:var(--fg-muted);}\ninput[type=\"text\"],input[type=\"search\"],input[type=\"number\"],select,textarea{font:inherit;color:var(--fg);background:var(--bg-input);border:1px solid var(--border);border-radius:8px;padding:6px 10px;outline:none;transition:border-color 0.15s;}\ninput:focus,select:focus,textarea:focus{border-color:var(--accent);}\ntextarea{resize:vertical;line-height:1.55;}\n.chips{display:flex;gap:5px;flex-wrap:wrap;align-items:center;}\n.chip{border:1px solid var(--border);background:var(--bg-input);color:var(--fg-muted);border-radius:99px;padding:3px 10px;font-size:12px;cursor:pointer;font-family:inherit;}\n.chip.active{background:var(--accent-soft);border-color:var(--accent);color:var(--fg);font-weight:600;}\n.pill{display:inline-flex;align-items:center;gap:4px;font-size:11px;font-weight:600;padding:2px 7px;border-radius:99px;border:1px solid transparent;white-space:nowrap;}\n.st-unread{background:rgba(148,163,184,0.14);color:#94a3b8;border-color:rgba(148,163,184,0.3);}\n.st-reading{background:rgba(56,189,248,0.15);color:#38bdf8;border-color:rgba(56,189,248,0.32);}\n.st-annotated{background:rgba(129,140,248,0.18);color:#818cf8;border-color:rgba(129,140,248,0.36);}\n.st-cited{background:rgba(52,211,153,0.16);color:#34d399;border-color:rgba(52,211,153,0.35);}\n.tag-pill{font-size:11px;padding:1px 7px;border-radius:6px;background:var(--bg-input);border:1px solid var(--border);color:var(--fg-muted);}\n.stars{color:var(--amber);letter-spacing:1px;font-size:12px;}\n.paper-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(330px,1fr));gap:12px;}\n.paper-card{background:var(--bg-input);border:1px solid var(--border);border-radius:11px;padding:12px 13px;display:flex;flex-direction:column;gap:8px;transition:0.15s;}\n.paper-card:hover{border-color:var(--border-strong);}\n.paper-card.checked{border-color:var(--accent);box-shadow:0 0 0 1px rgba(129,140,248,0.35);}\n.paper-top{display:flex;align-items:flex-start;justify-content:space-between;gap:8px;}\n.paper-title{font-size:13.5px;font-weight:700;line-height:1.35;}\n.paper-meta{font-size:11.5px;color:var(--fg-muted);}\n.paper-snippet{font-size:12px;color:var(--fg-muted);display:flex;flex-direction:column;gap:4px;}\n.paper-snippet b{color:var(--fg);font-weight:600;}\n.graph-layout{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(260px,0.85fr);gap:14px;}\n.svg-wrap{position:relative;width:100%;border:1px solid var(--border);border-radius:10px;background:var(--bg-input);overflow:hidden;}\n.svg-wrap svg{display:block;width:100%;height:auto;}\n.drawer{display:flex;flex-direction:column;gap:10px;}\n.link-chip{display:inline-flex;align-items:center;gap:5px;padding:4px 8px;border-radius:7px;background:var(--bg-input);border:1px solid var(--border);color:var(--fg);font-size:11.5px;cursor:pointer;text-align:left;}\n.link-chip:hover{border-color:var(--accent);background:var(--bg-hover);}\n.matrix-table{width:100%;border-collapse:collapse;font-size:12.5px;}\n.matrix-table th,.matrix-table td{border:1px solid var(--border);padding:9px 10px;vertical-align:top;text-align:left;}\n.matrix-table th{background:var(--bg-elev);font-weight:700;min-width:170px;}\n.matrix-table th:first-child{min-width:96px;width:104px;color:var(--fg-muted);}\n.md-pre{margin:0;white-space:pre-wrap;word-break:break-word;padding:10px 12px;border:1px solid var(--border);border-radius:9px;background:var(--bg-input);font:12px/1.55 ui-monospace,SFMono-Regular,Menlo,monospace;max-height:220px;overflow:auto;}\n.ai-grid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(270px,0.85fr);gap:14px;}\n.mode-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;}\n.mode-card{text-align:left;border:1px solid var(--border);border-radius:10px;padding:10px;background:var(--bg-input);color:var(--fg);cursor:pointer;display:flex;flex-direction:column;gap:3px;transition:0.15s;}\n.mode-card:hover{border-color:var(--border-strong);}\n.mode-card.active{border-color:var(--accent);background:var(--accent-soft);}\n.ai-result-box{border:1px solid var(--border-strong);border-radius:10px;padding:11px 12px;background:var(--bg-input);display:flex;flex-direction:column;gap:8px;}\n.note-list{display:flex;flex-direction:column;gap:8px;max-height:460px;overflow-y:auto;}\n.note-item{border:1px solid var(--border);border-radius:10px;padding:10px;background:var(--bg-input);cursor:pointer;display:flex;flex-direction:column;gap:4px;}\n.note-item:hover{border-color:var(--border-strong);}\n.note-item.active{border-color:var(--accent);background:var(--accent-soft);}\n.empty-state{padding:38px 20px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:10px;border:1px dashed var(--border-strong);border-radius:var(--radius);background:var(--bg-input);}\n.empty-state h3{margin:0;font-size:15px;}\n.empty-state p{margin:0;color:var(--fg-muted);max-width:460px;}\n.modal-backdrop{position:fixed;inset:0;background:rgba(5,8,15,0.7);backdrop-filter:blur(4px);display:grid;place-items:center;z-index:50;padding:16px;}\n.modal-backdrop[hidden]{display:none;}\n.modal{width:min(660px,100%);max-height:88vh;overflow-y:auto;background:var(--bg-elev);border:1px solid var(--border-strong);border-radius:14px;padding:16px 18px;box-shadow:var(--shadow);display:flex;flex-direction:column;gap:12px;}\n.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;}\n.field{display:flex;flex-direction:column;gap:5px;}\n.field-label{font-size:12px;font-weight:600;color:var(--fg-muted);display:flex;justify-content:space-between;}\n.cites-pick{display:flex;flex-wrap:wrap;gap:6px;padding:8px;border:1px solid var(--border);border-radius:8px;background:var(--bg-input);max-height:110px;overflow-y:auto;}\n.cites-pick label{display:inline-flex;align-items:center;gap:4px;font-size:12px;padding:2px 7px;border-radius:6px;background:var(--bg-card);border:1px solid var(--border);cursor:pointer;}\n.toast{position:fixed;right:18px;bottom:18px;z-index:60;padding:9px 14px;border-radius:10px;background:var(--bg-elev);border:1px solid var(--border-strong);box-shadow:var(--shadow);font-size:12.5px;font-weight:500;max-width:380px;}\n.toast[data-type=\"error\"]{border-color:var(--rose);color:var(--rose);}\n.toast[data-type=\"ok\"]{border-color:var(--emerald);color:var(--emerald);}\n.toast[hidden],[hidden]{display:none !important;}\n@media (max-width:860px){\n.app{grid-template-columns:1fr;grid-template-rows:auto 1fr;}\n.sidebar{flex-direction:row;align-items:center;overflow-x:auto;padding:8px 12px;border-right:none;border-bottom:1px solid var(--border);}\n.brand-sub,.side-foot{display:none;}\n.nav{flex-direction:row;}\n.kpi-strip{grid-template-columns:repeat(2,minmax(0,1fr));}\n.graph-layout,.ai-grid,.form-grid,.mode-grid{grid-template-columns:1fr;}\n}\n\n    /* === V2 Host Theme & Compact Surface Start === */\n    :root[data-theme=\"dark\"], html[data-theme=\"dark\"] { color-scheme: dark; --bg: #0a0d14; --bg-elev: #111622; --bg-card: #151c2c; --fg: #eef2fa; --fg-muted: #94a3bd; --border: #233049; --accent: #818cf8; --v2-host-accent: #818cf8; }\n    :root[data-theme=\"light\"], html[data-theme=\"light\"] { color-scheme: light; --bg: #f4f6fb; --bg-elev: #ffffff; --bg-card: #ffffff; --fg: #0f172a; --fg-muted: #475569; --border: #e2e8f0; --accent: #4f46e5; --v2-host-accent: #4f46e5; }\n    :root[data-theme=\"dark\"]:not([data-theme-override=\"1\"]), html[data-theme=\"dark\"]:not([data-theme-override=\"1\"]) { --bg: var(--host-bg, #0a0d14); --bg-elev: var(--host-surface, #111622); --bg-card: var(--host-surface, #151c2c); --fg: var(--host-fg, #eef2fa); --fg-muted: var(--host-muted, #94a3bd); --border: var(--host-border, #233049); --v2-host-accent: var(--host-primary, #818cf8); }\n    :root[data-theme=\"light\"]:not([data-theme-override=\"1\"]), html[data-theme=\"light\"]:not([data-theme-override=\"1\"]) { --bg: var(--host-bg, #f4f6fb); --bg-elev: var(--host-surface, #ffffff); --bg-card: var(--host-surface, #ffffff); --fg: var(--host-fg, #0f172a); --fg-muted: var(--host-muted, #475569); --border: var(--host-border, #e2e8f0); --v2-host-accent: var(--host-primary, #4f46e5); }\n    :is(button, input, select, textarea, .v2-surface-tab):focus-visible { outline: 2px solid var(--v2-host-accent, var(--accent)); outline-offset: 1px; }\n    html[data-theme=\"light\"] .st-unread { color: #475569; }\n    html[data-theme=\"light\"] .st-reading { color: #0284c7; }\n    html[data-theme=\"light\"] .st-annotated { color: #4f46e5; }\n    html[data-theme=\"light\"] .st-cited { color: #059669; }\n    html[data-surface=\"chat\"], html[data-surface=\"assistant\"],\n    html[data-surface=\"chat\"] body, html[data-surface=\"assistant\"] body { overflow-x: hidden; }\n    html[data-surface=\"chat\"] .sidebar, html[data-surface=\"assistant\"] .sidebar { display: none !important; }\n    html[data-surface=\"chat\"] .app, html[data-surface=\"assistant\"] .app { grid-template-columns: 1fr !important; grid-template-rows: minmax(0, 1fr) !important; }\n    html[data-surface=\"chat\"] .paper-grid, html[data-surface=\"assistant\"] .paper-grid, html[data-surface=\"chat\"] .graph-layout, html[data-surface=\"assistant\"] .graph-layout, html[data-surface=\"chat\"] .ai-grid, html[data-surface=\"assistant\"] .ai-grid, html[data-surface=\"chat\"] .mode-grid, html[data-surface=\"assistant\"] .mode-grid, html[data-surface=\"chat\"] .form-grid, html[data-surface=\"assistant\"] .form-grid { grid-template-columns: 1fr !important; }\n    html[data-surface=\"chat\"] .kpi-strip, html[data-surface=\"assistant\"] .kpi-strip { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; gap: 8px; }\n    html[data-surface=\"chat\"] :is(section, article, main, .card, .panel, .view),\n    html[data-surface=\"assistant\"] :is(section, article, main, .card, .panel, .view) { min-width: 0; }\n    html[data-surface=\"chat\"] :is(svg, canvas, pre),\n    html[data-surface=\"assistant\"] :is(svg, canvas, pre) { max-width: 100%; }\n    html[data-surface=\"chat\"] .topbar, html[data-surface=\"assistant\"] .topbar { padding: 8px 10px; gap: 6px; }\n    html[data-surface=\"chat\"] .kpi-strip, html[data-surface=\"assistant\"] .kpi-strip { padding: 8px 10px 2px; gap: 6px; }\n    html[data-surface=\"chat\"] .main-scroll, html[data-surface=\"assistant\"] .main-scroll { padding: 8px 10px 16px; gap: 10px; }\n    .v2-surface-nav { display: none; }\n    html[data-surface=\"chat\"] .v2-surface-nav, html[data-surface=\"assistant\"] .v2-surface-nav {\n      display: flex; align-items: center; gap: 6px; padding: 7px 10px; \n      overflow-x: auto; scrollbar-width: none; flex-shrink: 0;\n      background: var(--bg-elev); border-bottom: 1px solid var(--border);\n      position: sticky; top: 0; z-index: 30;\n    }\n    html[data-surface=\"chat\"] .v2-surface-nav::-webkit-scrollbar, html[data-surface=\"assistant\"] .v2-surface-nav::-webkit-scrollbar { display: none; }\n    .v2-surface-tab {\n      appearance: none; border: 1px solid var(--border); background: transparent;\n      color: var(--fg-muted); border-radius: 999px; padding: 4px 10px; font-size: 12px;\n      line-height: 1.35; font-weight: 500; white-space: nowrap; flex-shrink: 0; cursor: pointer;\n      transition: background 0.14s ease, border-color 0.14s ease, color 0.14s ease;\n    }\n    .v2-surface-tab:hover { color: var(--fg); border-color: var(--v2-host-accent, var(--accent)); }\n    .v2-surface-tab.active {\n      color: var(--v2-host-accent, var(--accent));\n      border-color: var(--v2-host-accent, var(--accent));\n      background: color-mix(in srgb, var(--v2-host-accent, var(--accent)) 14%, transparent);\n      font-weight: 600;\n    }\n    /* === V2 Host Theme & Compact Surface End === */\n  </style>\n</head>\n<body>\n<div class=\"app\">\n<aside class=\"sidebar\">\n<div class=\"brand\">\n<div class=\"brand-icon\">RL</div>\n<div>\n<div class=\"brand-title\">Research Lab</div>\n<div class=\"brand-sub\">文献 · 引用网 · 矩阵 · AI 综述</div>\n</div>\n</div>\n<nav class=\"nav\" aria-label=\"主导航\">\n<button class=\"nav-btn active\" data-view=\"library\" type=\"button\">\n<span class=\"nav-left\"><span>▤</span><span>文献卡片库</span></span>\n<span class=\"nav-badge\" id=\"nav-papers\">0</span>\n</button>\n<button class=\"nav-btn\" data-view=\"graph\" type=\"button\">\n<span class=\"nav-left\"><span>❖</span><span>引用脉络图谱</span></span>\n<span class=\"nav-badge\" id=\"nav-edges\">0</span>\n</button>\n<button class=\"nav-btn\" data-view=\"matrix\" type=\"button\">\n<span class=\"nav-left\"><span>⊞</span><span>方法论对比矩阵</span></span>\n<span class=\"nav-badge\" id=\"nav-sel\">0</span>\n</button>\n<button class=\"nav-btn\" data-view=\"ai\" type=\"button\">\n<span class=\"nav-left\"><span>✦</span><span>AI 文献综述台</span></span>\n<span class=\"nav-badge\" id=\"nav-notes\">0</span>\n</button>\n</nav>\n<div class=\"side-foot\">\n<div class=\"side-meta\"><span>作用域</span><span>Account 跨项目</span></div>\n<div class=\"side-meta\"><span>联网检索</span><span>Crossref HTTP v2</span></div>\n<div class=\"side-meta\"><span>引用格式</span><span id=\"side-cite-style\">APA · 5条</span></div>\n<div class=\"side-meta\"><span>Tools</span><span>4 个 Agent Tools</span></div>\n<button id=\"btn-seed-side\" class=\"btn sm\" type=\"button\" style=\"justify-content:center\">✦ 加载 LLM 经典论文集</button>\n</div>\n</aside>\n<div class=\"workspace\">\n<header class=\"topbar\">\n<div class=\"top-title\">\n<h1 id=\"view-heading\">学术文献卡片库与筛选</h1>\n<span class=\"rev-pill\" id=\"rev-badge\">修订 #0</span>\n<span class=\"rev-pill\" id=\"sel-badge\">已勾选 0 篇用于对比/综述</span>\n</div>\n<div class=\"toolbar\">\n<button id=\"btn-seed\" class=\"btn sm\" type=\"button\">✦ 演示文献集</button>\n<button id=\"btn-io\" class=\"btn sm\" type=\"button\">⇅ 导入 / 导出</button>\n<button id=\"btn-theme\" class=\"btn sm ghost\" type=\"button\">☀ 浅色</button>\n<button id=\"btn-new-paper\" class=\"btn sm primary\" type=\"button\">+ 收录论文</button>\n</div>\n</header>\n<section class=\"kpi-strip\">\n<div class=\"kpi-card\" style=\"--kpi-c:#818cf8\">\n<div class=\"kpi-label\"><span>文献总量</span><span>Account Library</span></div>\n<div class=\"kpi-val\" id=\"kpi-papers\">0</div>\n<div class=\"kpi-sub\" id=\"kpi-rating\">平均星级 0.0 ★</div>\n</div>\n<div class=\"kpi-card\" style=\"--kpi-c:#34d399\">\n<div class=\"kpi-label\"><span>已批注 / 已引用</span><span>Deep Read</span></div>\n<div class=\"kpi-val\" id=\"kpi-read\">0</div>\n<div class=\"kpi-sub\" id=\"kpi-read-sub\">精读完成率 0%</div>\n</div>\n<div class=\"kpi-card\" style=\"--kpi-c:#38bdf8\">\n<div class=\"kpi-label\"><span>引用网络连边</span><span>Citation Graph</span></div>\n<div class=\"kpi-val\" id=\"kpi-edges\">0</div>\n<div class=\"kpi-sub\">有向知识演进关系</div>\n</div>\n<div class=\"kpi-card\" style=\"--kpi-c:#fbbf24\">\n<div class=\"kpi-label\"><span>科研综述笔记</span><span>AI Synthesis</span></div>\n<div class=\"kpi-val\" id=\"kpi-notes\">0</div>\n<div class=\"kpi-sub\">支持会话协同采纳</div>\n</div>\n</section>\n<main class=\"main-scroll\">\n<section id=\"view-library\" class=\"view-pane\">\n<div id=\"empty-lib\" class=\"empty-state\" hidden>\n<h3>欢迎使用 AI 学术科研与文献综述工作台</h3>\n<p>支持文献结构化管理、原生 SVG 有向引用图谱、方法论对比矩阵以及通过 Velai 当前会话一键生成 Related Work 与研究空白。点击下方加载 6 篇经典 LLM Agent / RAG / Sandbox 演示论文集！</p>\n<div class=\"toolbar\">\n<button id=\"btn-seed-empty\" class=\"btn primary\" type=\"button\">✦ 加载 6 篇经典演示论文集</button>\n<button id=\"btn-new-empty\" class=\"btn\" type=\"button\">+ 手动收录首篇论文</button>\n</div>\n</div>\n<div id=\"lib-content\" class=\"card\">\n<div class=\"toolbar\" style=\"padding:10px 12px;border:1px solid var(--border);border-radius:10px;background:var(--bg-input)\">\n<strong style=\"font-size:12px\">Crossref 学术联网检索 (V2)</strong>\n<input id=\"cr-query\" type=\"search\" placeholder=\"输入英文/中文关键词检索 Crossref 论文元数据…\" style=\"flex:1;min-width:200px\">\n<button id=\"btn-cr-search\" class=\"btn sm primary\" type=\"button\">联网检索</button>\n</div>\n<div id=\"cr-results\" style=\"display:flex;flex-direction:column;gap:6px\" hidden></div>\n<div class=\"card-head\">\n<div class=\"toolbar\" style=\"flex:1\">\n<input id=\"search-paper\" type=\"search\" placeholder=\"搜索论文标题、作者、会议期刊、核心方法或标签…\" style=\"min-width:220px;flex:1;max-width:380px\">\n<select id=\"sort-paper\">\n<option value=\"year_desc\">按年份降序</option>\n<option value=\"rating_desc\">按星级降序</option>\n<option value=\"cites_desc\">按被引用度降序</option>\n</select>\n</div>\n<div class=\"chips\" id=\"status-chips\">\n<button class=\"chip active\" data-st=\"all\" type=\"button\">全部</button>\n<button class=\"chip\" data-st=\"unread\" type=\"button\">未读</button>\n<button class=\"chip\" data-st=\"reading\" type=\"button\">在读</button>\n<button class=\"chip\" data-st=\"annotated\" type=\"button\">已批注</button>\n<button class=\"chip\" data-st=\"cited\" type=\"button\">已引用</button>\n</div>\n</div>\n<div class=\"chips\" id=\"tag-chips\"></div>\n<div id=\"paper-grid\" class=\"paper-grid\"></div>\n</div>\n</section>\n<section id=\"view-graph\" class=\"view-pane\" hidden>\n<div class=\"graph-layout\">\n<div class=\"card\">\n<div class=\"card-head\">\n<div>\n<h2 class=\"card-title\">有向引用脉络与主题演进图谱 (SVG)</h2>\n<div class=\"card-sub\">按发表年份分层排布，贝塞尔曲线展示知识演进（基础文献 → 后续施引）；点击任意节点高亮上下游引用链</div>\n</div>\n<div class=\"chips\" style=\"font-size:11.5px;color:var(--fg-muted)\">\n<span>● <span style=\"color:#38bdf8\">蓝色：上游参考文献</span></span>\n<span>● <span style=\"color:#34d399\">绿色：下游施引文献</span></span>\n</div>\n</div>\n<div class=\"svg-wrap\">\n<svg id=\"graph-svg\" viewBox=\"0 0 760 440\" role=\"img\" aria-label=\"论文引用脉络图谱\"></svg>\n</div>\n</div>\n<div class=\"card\">\n<div class=\"card-head\">\n<h2 class=\"card-title\">节点详情抽屉</h2>\n<span class=\"card-sub\" id=\"graph-hint\">点击左侧节点查看</span>\n</div>\n<div id=\"graph-drawer\" class=\"drawer\"></div>\n</div>\n</div>\n</section>\n<section id=\"view-matrix\" class=\"view-pane\" hidden>\n<div class=\"card\">\n<div class=\"card-head\">\n<div>\n<h2 class=\"card-title\">方法论横向对比矩阵</h2>\n<div class=\"card-sub\">勾选 1~6 篇论文对比「核心架构 / 数据集 / 指标亮点 / 局限性 / 可复用点」，自动生成 Markdown 表格</div>\n</div>\n<div class=\"toolbar\">\n<button id=\"btn-matrix-insert\" class=\"btn sm primary\" type=\"button\" hidden>↗ 插入对比表到会话</button>\n<button id=\"btn-matrix-copy\" class=\"btn sm\" type=\"button\">复制 Markdown 表格</button>\n</div>\n</div>\n<div class=\"chips\" id=\"matrix-picker\"></div>\n<div style=\"overflow-x:auto\">\n<table class=\"matrix-table\" id=\"matrix-table\"></table>\n</div>\n<div class=\"field\">\n<span class=\"field-label\">自动生成的 Markdown 对比表预览</span>\n<pre id=\"matrix-md\" class=\"md-pre\"></pre>\n</div>\n</div>\n</section>\n<section id=\"view-ai\" class=\"view-pane\" hidden>\n<div class=\"ai-grid\">\n<div class=\"card\">\n<div class=\"card-head\">\n<div>\n<h2 class=\"card-title\">文献综述模板与提示词工作台</h2>\n<div class=\"card-sub\">勾选 1~6 篇论文，一键生成本地结构化综述草稿，或复制/插入提示词至 Velai 工作台聊天或独立 AI 伴生插件深度写作</div>\n</div>\n<span class=\"rev-pill\" id=\"ai-sel-count\">已选 0 / 6 篇</span>\n</div>\n<div class=\"chips\" id=\"ai-paper-picker\"></div>\n<div class=\"mode-grid\" id=\"ai-modes\">\n<button class=\"mode-card active\" data-mode=\"related_work\" type=\"button\">\n<strong>① 生成 Related Work 综述</strong>\n<span class=\"card-sub\">按技术演进脉络串联对比，输出学术论文风格相关工作章节</span>\n</button>\n<button class=\"mode-card\" data-mode=\"research_gaps\" type=\"button\">\n<strong>② 提炼共同研究空白</strong>\n<span class=\"card-sub\">交叉比对各文局限性，归纳 3 个可发表的创新研究切入点</span>\n</button>\n<button class=\"mode-card\" data-mode=\"experiment_plan\" type=\"button\">\n<strong>③ 生成实验对比方案</strong>\n<span class=\"card-sub\">设计 Baseline 对比矩阵、评测数据集、核心指标与消融实验</span>\n</button>\n<button class=\"mode-card\" data-mode=\"peer_review\" type=\"button\">\n<strong>④ 审稿意见模拟 (Peer Review)</strong>\n<span class=\"card-sub\">以顶会审稿人视角输出 Strengths / Weaknesses / Questions</span>\n</button>\n</div>\n<label class=\"field\">\n<span class=\"field-label\">补充研究问题或聚焦方向（可选）</span>\n<input id=\"ai-focus\" type=\"text\" maxlength=\"200\" placeholder=\"例如：聚焦桌面端低延迟沙箱插件编排与事实验证场景…\">\n</label>\n<div class=\"toolbar\">\n<button id=\"btn-ai-draft\" class=\"btn primary\" type=\"button\">✦ 生成本地结构化草稿</button>\n<button id=\"btn-ai-copy-prompt\" class=\"btn\" type=\"button\">复制 AI 写作提示词</button>\n<button id=\"btn-ai-insert-prompt\" class=\"btn\" type=\"button\" hidden>↗ 插入提示词到工作台聊天</button>\n</div>\n<div id=\"ai-turn-box\" class=\"ai-result-box\" hidden>\n<div class=\"card-head\">\n<strong id=\"ai-turn-state\" style=\"font-size:12.5px\">本地结构化草稿已就绪</strong>\n<div class=\"toolbar\">\n<button id=\"btn-ai-adopt\" class=\"btn sm primary\" type=\"button\" hidden>✓ 采纳并存为科研笔记</button>\n</div>\n</div>\n<pre id=\"ai-turn-preview\" class=\"md-pre\" hidden></pre>\n</div>\n</div>\n<div class=\"card\">\n<div class=\"card-head\">\n<h2 class=\"card-title\">科研综述笔记库 (<span id=\"notes-count\">0</span>)</h2>\n<button id=\"btn-new-note\" class=\"btn sm\" type=\"button\">+ 手动新建笔记</button>\n</div>\n<div id=\"note-list\" class=\"note-list\"></div>\n<div id=\"note-viewer\" class=\"ai-result-box\" hidden>\n<div class=\"card-head\">\n<input id=\"nv-title\" type=\"text\" maxlength=\"100\" style=\"flex:1;font-weight:700\">\n<button id=\"nv-save\" class=\"btn sm primary\" type=\"button\">保存</button>\n<button id=\"nv-insert\" class=\"btn sm\" type=\"button\" hidden>↗ 插入</button>\n<button id=\"nv-del\" class=\"btn sm danger\" type=\"button\">删除</button>\n</div>\n<textarea id=\"nv-content\" rows=\"9\" maxlength=\"6000\"></textarea>\n</div>\n</div>\n</div>\n</section>\n</main>\n</div>\n</div>\n<div id=\"modal-paper\" class=\"modal-backdrop\" hidden>\n<div class=\"modal\" role=\"dialog\" aria-modal=\"true\">\n<div class=\"card-head\">\n<h2 class=\"card-title\" id=\"mp-heading\">收录论文</h2>\n<button id=\"mp-close\" class=\"btn sm ghost\" type=\"button\">✕</button>\n</div>\n<div class=\"form-grid\">\n<label class=\"field\" style=\"grid-column:1/-1\">\n<span class=\"field-label\">论文标题 *</span>\n<input id=\"pf-title\" type=\"text\" maxlength=\"160\" placeholder=\"例如：Self-RAG: Learning to Retrieve, Generate, and Critique\">\n</label>\n<label class=\"field\">\n<span class=\"field-label\">论文短 ID（英文/数字）</span>\n<input id=\"pf-id\" type=\"text\" maxlength=\"40\" placeholder=\"例如：asai2024selfrag（留空自动生成）\">\n</label>\n<label class=\"field\">\n<span class=\"field-label\">作者 *</span>\n<input id=\"pf-authors\" type=\"text\" maxlength=\"120\" placeholder=\"Akari Asai, Zeqiu Wu et al.\">\n</label>\n<label class=\"field\">\n<span class=\"field-label\">年份 *</span>\n<input id=\"pf-year\" type=\"number\" min=\"1950\" max=\"2100\" value=\"2024\">\n</label>\n<label class=\"field\">\n<span class=\"field-label\">会议 / 期刊 *</span>\n<input id=\"pf-venue\" type=\"text\" maxlength=\"48\" placeholder=\"ICLR 2024 / NeurIPS 2024\">\n</label>\n<label class=\"field\">\n<span class=\"field-label\">阅读状态</span>\n<select id=\"pf-status\">\n<option value=\"unread\">未读 (Unread)</option>\n<option value=\"reading\">在读 (Reading)</option>\n<option value=\"annotated\">已批注 (Annotated)</option>\n<option value=\"cited\">已引用 (Cited)</option>\n</select>\n</label>\n<label class=\"field\">\n<span class=\"field-label\">重要度星级 (1-5)</span>\n<select id=\"pf-rating\">\n<option value=\"5\">★★★★★ (5 必读核心)</option>\n<option value=\"4\" selected>★★★★☆ (4 重点参考)</option>\n<option value=\"3\">★★★☆☆ (3 一般参考)</option>\n<option value=\"2\">★★☆☆☆ (2 略读)</option>\n<option value=\"1\">★☆☆☆☆ (1 边缘相关)</option>\n</select>\n</label>\n<label class=\"field\" style=\"grid-column:1/-1\">\n<span class=\"field-label\">领域标签（逗号分隔，最多 6 个）</span>\n<input id=\"pf-tags\" type=\"text\" maxlength=\"120\" placeholder=\"RAG, Agent, Sandbox, Reflection\">\n</label>\n<label class=\"field\" style=\"grid-column:1/-1\">\n<span class=\"field-label\">核心方法</span>\n<textarea id=\"pf-method\" rows=\"2\" maxlength=\"260\"></textarea>\n</label>\n<label class=\"field\" style=\"grid-column:1/-1\">\n<span class=\"field-label\">主要贡献</span>\n<textarea id=\"pf-contrib\" rows=\"2\" maxlength=\"260\"></textarea>\n</label>\n<label class=\"field\" style=\"grid-column:1/-1\">\n<span class=\"field-label\">局限性 / 研究空白</span>\n<textarea id=\"pf-limit\" rows=\"2\" maxlength=\"260\"></textarea>\n</label>\n<div class=\"field\" style=\"grid-column:1/-1\">\n<span class=\"field-label\">该论文引用的库内上游文献 (Cites)</span>\n<div id=\"pf-cites-box\" class=\"cites-pick\"></div>\n</div>\n</div>\n<div class=\"card-head\">\n<button id=\"mp-del\" class=\"btn danger\" type=\"button\" hidden>删除论文</button>\n<div class=\"toolbar\" style=\"margin-left:auto\">\n<button id=\"mp-cancel\" class=\"btn\" type=\"button\">取消</button>\n<button id=\"mp-save\" class=\"btn primary\" type=\"button\">保存论文</button>\n</div>\n</div>\n</div>\n</div>\n<div id=\"modal-matrix\" class=\"modal-backdrop\" hidden>\n<div class=\"modal\" role=\"dialog\" aria-modal=\"true\">\n<div class=\"card-head\">\n<h2 class=\"card-title\" id=\"mm-heading\">编辑对比矩阵维度</h2>\n<button id=\"mm-close\" class=\"btn sm ghost\" type=\"button\">✕</button>\n</div>\n<label class=\"field\"><span class=\"field-label\">核心架构</span><textarea id=\"mf-arch\" rows=\"2\" maxlength=\"240\"></textarea></label>\n<label class=\"field\"><span class=\"field-label\">数据集 / 基准</span><input id=\"mf-data\" type=\"text\" maxlength=\"180\"></label>\n<label class=\"field\"><span class=\"field-label\">指标亮点</span><input id=\"mf-met\" type=\"text\" maxlength=\"180\"></label>\n<label class=\"field\"><span class=\"field-label\">局限性</span><textarea id=\"mf-lim\" rows=\"2\" maxlength=\"240\"></textarea></label>\n<label class=\"field\"><span class=\"field-label\">可复用点</span><textarea id=\"mf-reu\" rows=\"2\" maxlength=\"240\"></textarea></label>\n<div class=\"card-head\">\n<div class=\"toolbar\" style=\"margin-left:auto\">\n<button id=\"mm-cancel\" class=\"btn\" type=\"button\">取消</button>\n<button id=\"mm-save\" class=\"btn primary\" type=\"button\">保存对比条目</button>\n</div>\n</div>\n</div>\n</div>\n<div id=\"modal-io\" class=\"modal-backdrop\" hidden>\n<div class=\"modal\" role=\"dialog\" aria-modal=\"true\">\n<div class=\"card-head\">\n<h2 class=\"card-title\">导入 / 导出文献库与科研笔记 (JSON)</h2>\n<button id=\"io-close\" class=\"btn sm ghost\" type=\"button\">✕</button>\n</div>\n<div class=\"toolbar\">\n<select id=\"io-select\" style=\"flex:1\"></select>\n<button id=\"io-export\" class=\"btn sm primary\" type=\"button\">导出预览</button>\n<button id=\"io-copy\" class=\"btn sm\" type=\"button\">复制</button>\n</div>\n<textarea id=\"io-text\" rows=\"10\" placeholder=\"导出预览 JSON，或粘贴文献库 / 科研笔记 JSON 进行导入…\"></textarea>\n<div class=\"card-head\">\n<span class=\"card-sub\">单次导入/导出上限 12 KiB</span>\n<button id=\"io-import\" class=\"btn primary\" type=\"button\">执行导入</button>\n</div>\n</div>\n</div>\n<div id=\"toast\" class=\"toast\" role=\"status\" hidden></div>\n<script>\n(() => {\nconst plugin = globalThis.nmasPlugin;\nconst $ = id => document.getElementById(id);\nconst SVG_NS = 'http://www.w3.org/2000/svg';\nconst ST_LBL = { unread: '未读', reading: '在读', annotated: '已批注', cited: '已引用' };\nconst MODE_LBL = {\nrelated_work: 'Related Work 综述',\nresearch_gaps: '共同研究空白',\nexperiment_plan: '实验对比方案',\npeer_review: '审稿意见模拟',\ncustom: '科研笔记',\n};\nconst VIEW_TITLES = {\nlibrary: '学术文献卡片库与筛选',\ngraph: '引用脉络与主题演进图谱',\nmatrix: '方法论横向对比矩阵',\nai: 'AI 文献综述与研究空白工作台',\n};\nconst state = {\nview: 'library',\nrevision: 0,\nkpi: { total_papers: 0, annotated_or_cited: 0, citation_edges: 0, total_notes: 0, avg_rating: 0 },\npapers: [],\nmatrix: { selected_ids: [], rows: {} },\nnotes: [],\nfilterStatus: 'all',\nfilterTag: 'all',\nsearch: '',\nsortBy: 'year_desc',\ngraphFocusId: null,\neditingPaperId: null,\neditingMatrixId: null,\nactiveNoteId: null,\naiMode: 'related_work',\npendingWorkId: null,\nlatestAiText: '',\ncanInsert: false,\nbusy: false,\n};\nlet toastTimer = null;\nfunction toast(msg, type = 'info') {\nconst el = $('toast');\nel.textContent = msg;\nel.dataset.type = type;\nel.hidden = false;\nclearTimeout(toastTimer);\ntoastTimer = setTimeout(() => { el.hidden = true; }, 3400);\n}\nfunction esc(s) {\nreturn String(s ?? '').replace(/[&<>\"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]));\n}\nfunction svgEl(tag, attrs = {}, text = '') {\nconst n = document.createElementNS(SVG_NS, tag);\nfor (const [k, v] of Object.entries(attrs)) n.setAttribute(k, String(v));\nif (text) n.textContent = text;\nreturn n;\n}\nfunction uuid() {\nconst b = crypto.getRandomValues(new Uint8Array(16));\nb[6] = (b[6] & 0x0f) | 0x40;\nb[8] = (b[8] & 0x3f) | 0x80;\nconst h = Array.from(b, x => x.toString(16).padStart(2, '0')).join('');\nreturn `${h.slice(0, 8)}-${h.slice(8, 12)}-${h.slice(12, 16)}-${h.slice(16, 20)}-${h.slice(20)}`;\n}\nfunction stars(n) { return '★'.repeat(n) + '☆'.repeat(Math.max(0, 5 - n)); }\nfunction getCitedBy(id) { return state.papers.filter(p => (p.cites || []).includes(id)); }\nfunction getMatrixRow(p) {\nconst r = state.matrix.rows?.[p.id];\nreturn {\narchitecture: r?.architecture || p.method || '—',\ndatasets: r?.datasets || '—',\nmetrics: r?.metrics || p.contribution || '—',\nlimitations: r?.limitations || p.limitations || '—',\nreusable: r?.reusable || '—',\n};\n}\nfunction switchView(v) {\nstate.view = v;\n$('view-heading').textContent = VIEW_TITLES[v] || '';\ndocument.querySelectorAll('.nav-btn').forEach(b => b.classList.toggle('active', b.dataset.view === v));\ndocument.querySelectorAll('.view-pane').forEach(p => { p.hidden = p.id !== `view-${v}`; });\nrenderView();\n}\nfunction renderChrome() {\nconst selCount = state.matrix.selected_ids.filter(id => state.papers.some(p => p.id === id)).length;\n$('rev-badge').textContent = `修订 #${state.revision}`;\n$('sel-badge').textContent = `已勾选 ${selCount} 篇用于对比/综述`;\n$('kpi-papers').textContent = String(state.kpi.total_papers);\n$('kpi-rating').textContent = `平均星级 ${state.kpi.avg_rating.toFixed(1)} ★`;\n$('kpi-read').textContent = String(state.kpi.annotated_or_cited);\nconst pct = state.kpi.total_papers ? Math.round((state.kpi.annotated_or_cited * 100) / state.kpi.total_papers) : 0;\n$('kpi-read-sub').textContent = `精读完成率 ${pct}%`;\n$('kpi-edges').textContent = String(state.kpi.citation_edges);\n$('kpi-notes').textContent = String(state.kpi.total_notes);\n$('nav-papers').textContent = String(state.papers.length);\n$('nav-edges').textContent = String(state.kpi.citation_edges);\n$('nav-sel').textContent = String(selCount);\n$('nav-notes').textContent = String(state.notes.length);\n$('btn-matrix-insert').hidden = !state.canInsert;\n$('btn-ai-insert-prompt').hidden = !state.canInsert;\n$('nv-insert').hidden = !state.canInsert;\n}\nfunction renderView() {\nrenderChrome();\nif (state.view === 'library') renderLibrary();\nelse if (state.view === 'graph') renderGraph();\nelse if (state.view === 'matrix') renderMatrix();\nelse if (state.view === 'ai') renderAiView();\n}\nasync function toggleSelectPaper(id) {\nif (state.busy) return;\nconst set = new Set(state.matrix.selected_ids.filter(x => state.papers.some(p => p.id === x)));\nif (set.has(id)) set.delete(id);\nelse {\nif (set.size >= 6) { toast('最多同时勾选 6 篇论文用于对比与综述。', 'error'); return; }\nset.add(id);\n}\nconst nextSel = Array.from(set);\nstate.matrix.selected_ids = nextSel;\nrenderView();\nstate.busy = true;\ntry {\nconst r = await plugin.action('matrix.save', { expected_revision: state.revision, selected_ids: nextSel });\nif (r.status === 'saved') state.revision = r.revision;\nelse if (r.status === 'conflict') await loadAll();\nrenderChrome();\n} catch (e) { toast(`同步勾选失败：${e?.message || '未知错误'}`, 'error'); }\nfinally { state.busy = false; }\n}\nfunction renderLibrary() {\nconst has = state.papers.length > 0;\n$('empty-lib').hidden = has;\n$('lib-content').hidden = !has;\nif (!has) return;\nconst allTags = Array.from(new Set(state.papers.flatMap(p => p.tags || []))).sort();\nconst tagBox = $('tag-chips');\ntagBox.replaceChildren();\nconst mkTag = (val, label) => {\nconst b = document.createElement('button');\nb.type = 'button';\nb.className = `chip${state.filterTag === val ? ' active' : ''}`;\nb.textContent = label;\nb.addEventListener('click', () => { state.filterTag = val; renderLibrary(); });\nreturn b;\n};\ntagBox.appendChild(mkTag('all', '全部领域'));\nfor (const t of allTags) tagBox.appendChild(mkTag(t, `#${t}`));\nconst kw = state.search.trim().toLowerCase();\nconst selSet = new Set(state.matrix.selected_ids);\nlet list = state.papers.filter(p => {\nif (state.filterStatus !== 'all' && p.status !== state.filterStatus) return false;\nif (state.filterTag !== 'all' && !(p.tags || []).includes(state.filterTag)) return false;\nif (kw) {\nconst hay = `${p.id} ${p.title} ${p.authors} ${p.venue} ${(p.tags || []).join(' ')} ${p.method} ${p.contribution} ${p.limitations}`.toLowerCase();\nif (!hay.includes(kw)) return false;\n}\nreturn true;\n});\nif (state.sortBy === 'year_desc') list.sort((a, b) => b.year - a.year || b.rating - a.rating);\nelse if (state.sortBy === 'rating_desc') list.sort((a, b) => b.rating - a.rating || b.year - a.year);\nelse list.sort((a, b) => getCitedBy(b.id).length - getCitedBy(a.id).length);\nconst grid = $('paper-grid');\ngrid.replaceChildren();\nif (!list.length) {\ngrid.innerHTML = `<div style=\"grid-column:1/-1;text-align:center;color:var(--fg-dim);padding:26px\">没有匹配的论文</div>`;\nreturn;\n}\nfor (const p of list) {\nconst checked = selSet.has(p.id);\nconst citedBy = getCitedBy(p.id).length;\nconst card = document.createElement('article');\ncard.className = `paper-card${checked ? ' checked' : ''}`;\ncard.innerHTML = `\n<div class=\"paper-top\">\n<label style=\"display:flex;align-items:flex-start;gap:7px;cursor:pointer;flex:1\">\n<input type=\"checkbox\" ${checked ? 'checked' : ''} style=\"margin-top:3px\">\n<span class=\"paper-title\">${esc(p.title)}</span>\n</label>\n<span class=\"pill st-${esc(p.status)}\">${esc(ST_LBL[p.status] || p.status)}</span>\n</div>\n<div class=\"paper-meta\">${esc(p.authors)} · <strong>${p.year}</strong> · ${esc(p.venue)}</div>\n<div class=\"toolbar\" style=\"justify-content:space-between\">\n<div class=\"chips\">${(p.tags || []).map(t => `<span class=\"tag-pill\">#${esc(t)}</span>`).join('')}</div>\n<span class=\"stars\">${stars(p.rating)}</span>\n</div>\n<div class=\"paper-snippet\">\n<div><b>方法：</b>${esc(p.method || '待补充')}</div>\n<div><b>贡献：</b>${esc(p.contribution || '待补充')}</div>\n<div><b>局限：</b>${esc(p.limitations || '待补充')}</div>\n</div>\n<div class=\"toolbar\" style=\"justify-content:space-between;margin-top:auto;padding-top:6px;border-top:1px solid var(--border)\">\n<span style=\"font-size:11.5px;color:var(--fg-dim)\">引用 ${(p.cites || []).length} · 被引 ${citedBy} · ID:${esc(p.id)}</span>\n<div class=\"toolbar\">\n<button class=\"btn sm\" data-act=\"graph\" type=\"button\">图谱</button>\n<button class=\"btn sm\" data-act=\"edit\" type=\"button\">编辑</button>\n</div>\n</div>\n`;\ncard.querySelector('input[type=\"checkbox\"]').addEventListener('change', () => toggleSelectPaper(p.id));\ncard.querySelector('[data-act=\"graph\"]').addEventListener('click', () => { state.graphFocusId = p.id; switchView('graph'); });\ncard.querySelector('[data-act=\"edit\"]').addEventListener('click', () => openPaperModal(p));\ngrid.appendChild(card);\n}\n}\nfunction renderGraph() {\nconst svg = $('graph-svg');\nsvg.replaceChildren();\nconst drawer = $('graph-drawer');\nif (!state.papers.length) {\nsvg.appendChild(svgEl('text', { x: 380, y: 210, 'text-anchor': 'middle', fill: 'var(--fg-dim)', 'font-size': 13 }, '暂无文献数据，请先加载演示集或收录论文'));\ndrawer.innerHTML = `<div class=\"card-sub\">暂无节点</div>`;\nreturn;\n}\nif (!state.graphFocusId || !state.papers.some(p => p.id === state.graphFocusId)) {\nstate.graphFocusId = state.papers[state.papers.length - 1].id;\n}\nconst years = Array.from(new Set(state.papers.map(p => p.year))).sort((a, b) => a - b);\nconst byYear = new Map(years.map(y => [y, []]));\nfor (const p of state.papers) byYear.get(p.year).push(p);\nconst W = 760;\nconst maxPerYear = Math.max(1, ...Array.from(byYear.values()).map(a => a.length));\nconst H = Math.max(400, 96 + maxPerYear * 102);\nsvg.setAttribute('viewBox', `0 0 ${W} ${H}`);\nconst defs = svgEl('defs');\nconst mkMarker = (id, color) => {\nconst m = svgEl('marker', { id, viewBox: '0 0 10 10', refX: 9, refY: 5, markerWidth: 7, markerHeight: 7, orient: 'auto-start-reverse' });\nm.appendChild(svgEl('path', { d: 'M 0 1.5 L 9 5 L 0 8.5 z', fill: color }));\nreturn m;\n};\ndefs.append(mkMarker('arr-muted', '#475569'), mkMarker('arr-up', '#38bdf8'), mkMarker('arr-down', '#34d399'));\nsvg.appendChild(defs);\nconst colW = (W - 60) / Math.max(1, years.length);\nconst nodeW = Math.min(182, colW - 26);\nconst nodeH = 66;\nconst pos = new Map();\nyears.forEach((yr, ci) => {\nconst cx = 30 + colW * ci + colW / 2;\nsvg.appendChild(svgEl('line', { x1: cx, y1: 42, x2: cx, y2: H - 18, stroke: 'var(--border)', 'stroke-dasharray': '4 4' }));\nsvg.appendChild(svgEl('rect', { x: cx - 32, y: 12, width: 64, height: 22, rx: 11, fill: 'var(--bg-elev)', stroke: 'var(--border-strong)' }));\nsvg.appendChild(svgEl('text', { x: cx, y: 27, 'text-anchor': 'middle', fill: 'var(--fg)', 'font-size': 11.5, 'font-weight': 700 }, String(yr)));\nconst arr = byYear.get(yr);\nconst stepY = (H - 76) / arr.length;\narr.forEach((p, ri) => {\nconst cy = 58 + stepY * ri + stepY / 2;\npos.set(p.id, { x: cx, y: cy, w: nodeW, h: nodeH });\n});\n});\nconst focus = state.papers.find(p => p.id === state.graphFocusId);\nconst upSet = new Set(focus?.cites || []);\nconst downSet = new Set(getCitedBy(focus.id).map(p => p.id));\nfor (const citing of state.papers) {\nconst dst = pos.get(citing.id);\nif (!dst) continue;\nfor (const citedId of citing.cites || []) {\nconst src = pos.get(citedId);\nif (!src || citedId === citing.id) continue;\nconst isUpEdge = citing.id === focus.id;\nconst isDownEdge = citedId === focus.id;\nconst sameCol = Math.abs(src.x - dst.x) < 10;\nlet d;\nif (sameCol) {\nconst sx = src.x + src.w / 2;\nconst dx = dst.x + dst.w / 2;\nconst bend = 46;\nd = `M ${sx} ${src.y} C ${sx + bend} ${src.y}, ${dx + bend} ${dst.y}, ${dx} ${dst.y}`;\n} else {\nconst sx = src.x < dst.x ? src.x + src.w / 2 : src.x - src.w / 2;\nconst dx = src.x < dst.x ? dst.x - dst.w / 2 - 3 : dst.x + dst.w / 2 + 3;\nconst mx = (sx + dx) / 2;\nd = `M ${sx} ${src.y} C ${mx} ${src.y}, ${mx} ${dst.y}, ${dx} ${dst.y}`;\n}\nconst stroke = isUpEdge ? '#38bdf8' : isDownEdge ? '#34d399' : '#475569';\nconst marker = isUpEdge ? 'url(#arr-up)' : isDownEdge ? 'url(#arr-down)' : 'url(#arr-muted)';\nsvg.appendChild(svgEl('path', {\nd, fill: 'none', stroke, 'stroke-width': (isUpEdge || isDownEdge) ? 2.4 : 1.3,\n'stroke-opacity': (isUpEdge || isDownEdge) ? 0.95 : 0.35, 'marker-end': marker,\n}));\n}\n}\nfor (const p of state.papers) {\nconst b = pos.get(p.id);\nconst isFocus = p.id === focus.id;\nconst isUp = upSet.has(p.id);\nconst isDown = downSet.has(p.id);\nconst related = isFocus || isUp || isDown;\nconst stroke = isFocus ? '#818cf8' : isUp ? '#38bdf8' : isDown ? '#34d399' : 'var(--border-strong)';\nconst g = svgEl('g', { style: 'cursor:pointer', opacity: related ? 1 : 0.42 });\ng.appendChild(svgEl('rect', {\nx: b.x - b.w / 2, y: b.y - b.h / 2, width: b.w, height: b.h, rx: 10,\nfill: isFocus ? 'rgba(99,102,241,0.22)' : 'var(--bg-card)',\nstroke, 'stroke-width': isFocus ? 2.4 : related ? 1.8 : 1.1,\n}));\nconst shortT = p.title.length > 22 ? `${p.title.slice(0, 22)}…` : p.title;\ng.appendChild(svgEl('text', { x: b.x - b.w / 2 + 10, y: b.y - 10, fill: 'var(--fg)', 'font-size': 11, 'font-weight': 700 }, shortT));\ng.appendChild(svgEl('text', { x: b.x - b.w / 2 + 10, y: b.y + 8, fill: 'var(--fg-muted)', 'font-size': 10 }, `${p.venue} · ${stars(p.rating)}`));\ng.appendChild(svgEl('text', { x: b.x - b.w / 2 + 10, y: b.y + 23, fill: stroke, 'font-size': 9.5, 'font-weight': 600 }, `${p.id} · ${(p.tags || []).slice(0, 2).join('/')}`));\ng.addEventListener('click', () => { state.graphFocusId = p.id; renderGraph(); });\nsvg.appendChild(g);\n}\nconst ups = (focus.cites || []).map(id => state.papers.find(p => p.id === id)).filter(Boolean);\nconst downs = getCitedBy(focus.id);\nconst isChecked = state.matrix.selected_ids.includes(focus.id);\ndrawer.innerHTML = `\n<div style=\"font-size:14px;font-weight:700;line-height:1.35\">${esc(focus.title)}</div>\n<div class=\"paper-meta\">${esc(focus.authors)} · ${focus.year} · ${esc(focus.venue)}</div>\n<div class=\"toolbar\">\n<span class=\"pill st-${esc(focus.status)}\">${esc(ST_LBL[focus.status] || focus.status)}</span>\n<span class=\"stars\">${stars(focus.rating)}</span>\n</div>\n<div class=\"paper-snippet\">\n<div><b>核心方法：</b>${esc(focus.method || '—')}</div>\n<div><b>主要贡献：</b>${esc(focus.contribution || '—')}</div>\n<div><b>研究局限：</b>${esc(focus.limitations || '—')}</div>\n</div>\n<div class=\"field\">\n<span class=\"field-label\" style=\"color:#38bdf8\">↑ 上游参考文献 (${ups.length})</span>\n<div id=\"dr-up\" class=\"chips\"></div>\n</div>\n<div class=\"field\">\n<span class=\"field-label\" style=\"color:#34d399\">↓ 下游施引文献 (${downs.length})</span>\n<div id=\"dr-down\" class=\"chips\"></div>\n</div>\n<div class=\"toolbar\" style=\"margin-top:4px\">\n<button id=\"dr-toggle\" class=\"btn sm primary\" type=\"button\">${isChecked ? '✓ 已在对比/综述队列' : '+ 加入对比/综述队列'}</button>\n<button id=\"dr-edit\" class=\"btn sm\" type=\"button\">编辑文献</button>\n</div>\n`;\nconst upBox = $('dr-up');\nif (!ups.length) upBox.innerHTML = `<span class=\"card-sub\">无库内上游文献（奠基论文）</span>`;\nelse for (const u of ups) {\nconst b = document.createElement('button'); b.type = 'button'; b.className = 'link-chip';\nb.textContent = `${u.year} · ${u.id}`;\nb.addEventListener('click', () => { state.graphFocusId = u.id; renderGraph(); });\nupBox.appendChild(b);\n}\nconst downBox = $('dr-down');\nif (!downs.length) downBox.innerHTML = `<span class=\"card-sub\">暂无库内后续施引</span>`;\nelse for (const d of downs) {\nconst b = document.createElement('button'); b.type = 'button'; b.className = 'link-chip';\nb.textContent = `${d.year} · ${d.id}`;\nb.addEventListener('click', () => { state.graphFocusId = d.id; renderGraph(); });\ndownBox.appendChild(b);\n}\n$('dr-toggle').addEventListener('click', () => toggleSelectPaper(focus.id));\n$('dr-edit').addEventListener('click', () => openPaperModal(focus));\n}\nfunction buildMatrixMarkdown(selPapers) {\nif (!selPapers.length) return '（请先勾选至少 1 篇论文生成方法论对比矩阵）';\nconst clean = s => String(s || '—').replace(/\\|/g, '\\\\|').replace(/\\r?\\n/g, ' ');\nconst dims = [\n['核心架构', 'architecture'],\n['数据集 / 基准', 'datasets'],\n['指标亮点', 'metrics'],\n['局限性', 'limitations'],\n['可复用点', 'reusable'],\n];\nconst head = `| 对比维度 | ${selPapers.map(p => `${clean(p.id)} (${p.year})`).join(' | ')} |`;\nconst sep = `| --- | ${selPapers.map(() => '---').join(' | ')} |`;\nconst body = dims.map(([lbl, key]) => `| **${lbl}** | ${selPapers.map(p => clean(getMatrixRow(p)[key])).join(' | ')} |`);\nreturn [head, sep, ...body].join('\\n');\n}\nfunction renderMatrix() {\nconst picker = $('matrix-picker');\npicker.replaceChildren();\nconst selSet = new Set(state.matrix.selected_ids);\nfor (const p of state.papers) {\nconst b = document.createElement('button');\nb.type = 'button';\nb.className = `chip${selSet.has(p.id) ? ' active' : ''}`;\nb.textContent = `${selSet.has(p.id) ? '✓ ' : ''}${p.id} (${p.year})`;\nb.addEventListener('click', () => toggleSelectPaper(p.id));\npicker.appendChild(b);\n}\nconst selPapers = state.papers.filter(p => selSet.has(p.id));\nconst table = $('matrix-table');\ntable.replaceChildren();\nif (!selPapers.length) {\ntable.innerHTML = `<tr><td style=\"text-align:center;color:var(--fg-dim);padding:24px\">点击上方论文胶囊勾选 1~6 篇论文进行横向方法论对比</td></tr>`;\n$('matrix-md').textContent = buildMatrixMarkdown([]);\nreturn;\n}\nconst thead = document.createElement('thead');\nconst htr = document.createElement('tr');\nhtr.innerHTML = `<th>对比维度</th>`;\nfor (const p of selPapers) {\nconst th = document.createElement('th');\nth.innerHTML = `\n<div style=\"display:flex;justify-content:space-between;align-items:center;gap:6px\">\n<span>${esc(p.id)} (${p.year})</span>\n<button class=\"btn sm\" type=\"button\">编辑</button>\n</div>\n<div style=\"font-size:11px;font-weight:400;color:var(--fg-muted);margin-top:3px\">${esc(p.venue)}</div>\n`;\nth.querySelector('button').addEventListener('click', () => openMatrixModal(p));\nhtr.appendChild(th);\n}\nthead.appendChild(htr);\ntable.appendChild(thead);\nconst tbody = document.createElement('tbody');\nconst dims = [\n['核心架构', 'architecture'],\n['数据集', 'datasets'],\n['指标亮点', 'metrics'],\n['局限性', 'limitations'],\n['可复用点', 'reusable'],\n];\nfor (const [label, key] of dims) {\nconst tr = document.createElement('tr');\ntr.innerHTML = `<th>${label}</th>${selPapers.map(p => `<td>${esc(getMatrixRow(p)[key])}</td>`).join('')}`;\ntbody.appendChild(tr);\n}\ntable.appendChild(tbody);\n$('matrix-md').textContent = buildMatrixMarkdown(selPapers);\n}\nfunction buildAiPrompt() {\nconst selPapers = state.papers.filter(p => state.matrix.selected_ids.includes(p.id)).slice(0, 6);\nif (!selPapers.length) return '';\nconst modeInst = {\nrelated_work: '请基于以下论文撰写一段学术顶会风格的 Related Work 文献综述：按演进脉络分组串讲，准确指出各自方法差异，并用 Markdown 输出。',\nresearch_gaps: '请交叉分析以下论文的局限性，提炼 3 个共性研究空白（Research Gaps）并给出可落地的创新切入点与验证假设。',\nexperiment_plan: '请基于以下论文设计一套完整的实验对比方案，包含 Baseline 选择、评测数据集、核心指标与关键消融实验表。',\npeer_review: '请模拟顶会领域主席与审稿人，综合评述以下文献脉络并输出 Strengths / Weaknesses / Key Questions。',\n}[state.aiMode];\nconst focus = $('ai-focus').value.trim();\nconst lines = selPapers.map(p => `- [${p.id}, ${p.year}, ${p.venue}] ${p.title.slice(0, 80)} | 方法:${p.method.slice(0, 75)} | 局限:${p.limitations.slice(0, 75)}`);\nconst raw = `${modeInst}${focus ? `\\n聚焦方向：${focus}` : ''}\\n\\n文献清单：\\n${lines.join('\\n')}`;\nreturn Array.from(raw).slice(0, 2000).join('');\n}\nfunction renderAiView() {\nconst selSet = new Set(state.matrix.selected_ids.filter(id => state.papers.some(p => p.id === id)));\n$('ai-sel-count').textContent = `已选 ${selSet.size} / 6 篇`;\nconst picker = $('ai-paper-picker');\npicker.replaceChildren();\nfor (const p of state.papers) {\nconst b = document.createElement('button');\nb.type = 'button';\nb.className = `chip${selSet.has(p.id) ? ' active' : ''}`;\nb.textContent = `${selSet.has(p.id) ? '✓ ' : ''}${p.id} (${p.year})`;\nb.addEventListener('click', () => toggleSelectPaper(p.id));\npicker.appendChild(b);\n}\n$('notes-count').textContent = String(state.notes.length);\nconst nBox = $('note-list');\nnBox.replaceChildren();\nif (!state.notes.length) {\nnBox.innerHTML = `<div class=\"card-sub\" style=\"padding:12px\">暂无科研笔记，可由左侧 AI 综述采纳保存或手动新建。</div>`;\n} else {\nfor (const n of state.notes) {\nconst div = document.createElement('div');\ndiv.className = `note-item${n.id === state.activeNoteId ? ' active' : ''}`;\ndiv.innerHTML = `\n<div style=\"display:flex;justify-content:space-between;gap:6px;align-items:center\">\n<strong style=\"font-size:12.5px\">${esc(n.title)}</strong>\n<span class=\"tag-pill\">${esc(MODE_LBL[n.mode] || n.mode)}</span>\n</div>\n<div class=\"card-sub\">${esc(n.created_at)} · 关联 ${n.paper_ids.length} 篇</div>\n<div style=\"font-size:11.5px;color:var(--fg-dim)\">${esc(n.preview)}</div>\n`;\ndiv.addEventListener('click', () => openNote(n.id));\nnBox.appendChild(div);\n}\n}\n}\nasync function openNote(id) {\nstate.activeNoteId = id;\nrenderAiView();\ntry {\nconst r = await plugin.action('note.get', { id });\nstate.revision = r.revision;\nif (r.found && r.note) {\n$('note-viewer').hidden = false;\n$('nv-title').value = r.note.title;\n$('nv-content').value = r.note.content;\n}\n} catch (e) { toast(`读取笔记失败：${e?.message || '未知错误'}`, 'error'); }\n}\nfunction openPaperModal(paper = null) {\nstate.editingPaperId = paper ? paper.id : null;\n$('mp-heading').textContent = paper ? `编辑论文 · ${paper.id}` : '收录新论文';\n$('pf-id').value = paper?.id || '';\n$('pf-id').disabled = Boolean(paper);\n$('pf-title').value = paper?.title || '';\n$('pf-authors').value = paper?.authors || '';\n$('pf-year').value = String(paper?.year || 2024);\n$('pf-venue').value = paper?.venue || '';\n$('pf-status').value = paper?.status || 'unread';\n$('pf-rating').value = String(paper?.rating || 4);\n$('pf-tags').value = (paper?.tags || []).join(', ');\n$('pf-method').value = paper?.method || '';\n$('pf-contrib').value = paper?.contribution || '';\n$('pf-limit').value = paper?.limitations || '';\n$('mp-del').hidden = !paper;\nconst cBox = $('pf-cites-box');\ncBox.replaceChildren();\nconst citeSet = new Set(paper?.cites || []);\nconst others = state.papers.filter(p => p.id !== paper?.id);\nif (!others.length) {\ncBox.innerHTML = `<span class=\"card-sub\">库中暂无其他论文可设为引用</span>`;\n} else {\nfor (const o of others) {\nconst lbl = document.createElement('label');\nlbl.innerHTML = `<input type=\"checkbox\" value=\"${esc(o.id)}\" ${citeSet.has(o.id) ? 'checked' : ''}><span>${esc(o.id)} (${o.year})</span>`;\ncBox.appendChild(lbl);\n}\n}\n$('modal-paper').hidden = false;\n$('pf-title').focus();\n}\nfunction openMatrixModal(p) {\nstate.editingMatrixId = p.id;\nconst r = getMatrixRow(p);\n$('mm-heading').textContent = `编辑对比维度 · ${p.id}`;\n$('mf-arch').value = r.architecture === '—' ? '' : r.architecture;\n$('mf-data').value = r.datasets === '—' ? '' : r.datasets;\n$('mf-met').value = r.metrics === '—' ? '' : r.metrics;\n$('mf-lim').value = r.limitations === '—' ? '' : r.limitations;\n$('mf-reu').value = r.reusable === '—' ? '' : r.reusable;\n$('modal-matrix').hidden = false;\n}\nasync function loadAll() {\nif (typeof plugin?.action !== 'function') { toast('请在 Velai Desktop 中打开此插件。', 'error'); return; }\ntry {\nconst caps = await plugin.action('host.capabilities', {}).catch(() => ({ actions: [] }));\nstate.canInsert = Array.isArray(caps?.actions) && caps.actions.includes('host.draft.insert');\nconst res = await plugin.action('lab.load', {});\nstate.revision = res.revision;\nstate.kpi = res.kpi;\nstate.papers = res.papers;\nstate.matrix = res.matrix;\nstate.notes = res.notes;\nif (res.settings && $('side-cite-style')) {\n$('side-cite-style').textContent = `${res.settings.citation_style} · ${res.settings.default_rows}条`;\n}\nrenderView();\n} catch (e) { toast(`加载失败：${e?.message || '未知错误'}`, 'error'); }\n}\nasync function seedDemo() {\nif (state.busy) return;\nstate.busy = true;\ntry {\nconst r = await plugin.action('lab.seed_demo', { expected_revision: state.revision });\nif (r.status === 'seeded') {\nstate.activeNoteId = null;\n$('note-viewer').hidden = true;\nawait loadAll();\ntoast(`已加载 ${r.seeded_papers} 篇经典论文与 ${r.seeded_notes} 篇综述笔记`, 'ok');\n} else if (r.status === 'conflict') {\nawait loadAll();\ntoast('版本有更新，已刷新，请再次点击加载。', 'error');\n} else {\ntoast(`加载未完成：${r.status}`, 'error');\n}\n} catch (e) { toast(`加载演示集失败：${e?.message || '未知错误'}`, 'error'); }\nfinally { state.busy = false; }\n}\ndocument.querySelectorAll('.nav-btn').forEach(b => b.addEventListener('click', () => switchView(b.dataset.view)));\n$('btn-theme').addEventListener('click', () => {\nconst isDark = document.documentElement.dataset.theme !== 'light';\ndocument.documentElement.dataset.theme = isDark ? 'light' : 'dark';\n$('btn-theme').textContent = isDark ? '☾ 深色' : '☀ 浅色';\n});\n$('btn-seed').addEventListener('click', seedDemo);\n$('btn-seed-side').addEventListener('click', seedDemo);\n$('btn-seed-empty').addEventListener('click', seedDemo);\n$('btn-new-paper').addEventListener('click', () => openPaperModal(null));\n$('btn-new-empty').addEventListener('click', () => openPaperModal(null));\n$('search-paper').addEventListener('input', e => { state.search = e.target.value; renderLibrary(); });\n$('sort-paper').addEventListener('change', e => { state.sortBy = e.target.value; renderLibrary(); });\n$('status-chips').querySelectorAll('.chip').forEach(ch => ch.addEventListener('click', () => {\nstate.filterStatus = ch.dataset.st;\n$('status-chips').querySelectorAll('.chip').forEach(x => x.classList.toggle('active', x === ch));\nrenderLibrary();\n}));\n$('mp-close').addEventListener('click', () => { $('modal-paper').hidden = true; });\n$('mp-cancel').addEventListener('click', () => { $('modal-paper').hidden = true; });\n$('mp-save').addEventListener('click', async () => {\nif (state.busy) return;\nconst title = $('pf-title').value.trim();\nconst authors = $('pf-authors').value.trim();\nconst year = Math.round(Number($('pf-year').value) || 2024);\nif (!title || !authors) { toast('请填写论文标题与作者。', 'error'); return; }\nconst rawId = $('pf-id').value.trim();\nconst id = state.editingPaperId || (rawId && /^[a-zA-Z0-9._-]+$/.test(rawId) ? rawId : `paper-${Date.now().toString(36)}`);\nconst tags = $('pf-tags').value.split(/[,，]/).map(s => s.trim()).filter(Boolean).slice(0, 6);\nconst cites = Array.from($('pf-cites-box').querySelectorAll('input:checked')).map(i => i.value);\nstate.busy = true;\ntry {\nconst r = await plugin.action('paper.save', {\nexpected_revision: state.revision,\nid, title, authors, year,\nvenue: $('pf-venue').value.trim(),\ntags,\nrating: Number($('pf-rating').value) || 4,\nstatus: $('pf-status').value,\nmethod: $('pf-method').value.trim(),\ncontribution: $('pf-contrib').value.trim(),\nlimitations: $('pf-limit').value.trim(),\ncites,\n});\nif (r.status === 'saved') {\n$('modal-paper').hidden = true;\nawait loadAll();\ntoast('论文已保存。', 'ok');\n} else {\ntoast(`保存未完成：${r.status}`, 'error');\nif (r.status === 'conflict') await loadAll();\n}\n} catch (e) { toast(`保存失败：${e?.message || '未知错误'}`, 'error'); }\nfinally { state.busy = false; }\n});\n$('mp-del').addEventListener('click', async () => {\nif (state.busy || !state.editingPaperId) return;\nstate.busy = true;\ntry {\nconst r = await plugin.action('paper.delete', { expected_revision: state.revision, id: state.editingPaperId });\nif (r.status === 'deleted') {\n$('modal-paper').hidden = true;\nawait loadAll();\ntoast('已删除论文并清理引用关系。', 'ok');\n} else toast(`删除未完成：${r.status}`, 'error');\n} catch (e) { toast(`删除失败：${e?.message || '未知错误'}`, 'error'); }\nfinally { state.busy = false; }\n});\n$('mm-close').addEventListener('click', () => { $('modal-matrix').hidden = true; });\n$('mm-cancel').addEventListener('click', () => { $('modal-matrix').hidden = true; });\n$('mm-save').addEventListener('click', async () => {\nif (state.busy || !state.editingMatrixId) return;\nstate.busy = true;\ntry {\nconst r = await plugin.action('matrix.save', {\nexpected_revision: state.revision,\npaper_id: state.editingMatrixId,\nrow: {\narchitecture: $('mf-arch').value.trim(),\ndatasets: $('mf-data').value.trim(),\nmetrics: $('mf-met').value.trim(),\nlimitations: $('mf-lim').value.trim(),\nreusable: $('mf-reu').value.trim(),\n},\n});\nif (r.status === 'saved') {\n$('modal-matrix').hidden = true;\nawait loadAll();\ntoast('对比矩阵条目已保存。', 'ok');\n} else toast(`保存未完成：${r.status}`, 'error');\n} catch (e) { toast(`保存失败：${e?.message || '未知错误'}`, 'error'); }\nfinally { state.busy = false; }\n});\n$('btn-matrix-copy').addEventListener('click', async () => {\ntry { await navigator.clipboard.writeText($('matrix-md').textContent); toast('已复制 Markdown 对比表。', 'ok'); }\ncatch { toast('沙箱不支持剪贴板直写，请直接选中预览区复制。'); }\n});\n$('btn-matrix-insert').addEventListener('click', async () => {\nconst text = $('matrix-md').textContent;\nif (!text) return;\ntry {\nconst r = await plugin.action('host.draft.insert', { text });\ntoast(r?.inserted ? '已插入对比表到当前会话输入框。' : '未确认插入结果。', r?.inserted ? 'ok' : 'error');\n} catch (e) { toast(`插入失败：${e?.message || '未知错误'}`, 'error'); }\n});\n$('ai-modes').querySelectorAll('.mode-card').forEach(card => card.addEventListener('click', () => {\nstate.aiMode = card.dataset.mode;\n$('ai-modes').querySelectorAll('.mode-card').forEach(c => c.classList.toggle('active', c === card));\n}));\n$('btn-cr-search').addEventListener('click', async () => {\nconst q = $('cr-query').value.trim();\nif (!q) { toast('请输入检索关键词。', 'error'); return; }\nconst box = $('cr-results');\nbox.hidden = false;\nbox.innerHTML = '<div style=\"font-size:12px;color:var(--fg-muted)\">正在通过 Crossref API 联网检索…</div>';\ntry {\nconst r = await plugin.action('research.search_crossref', { query: q });\nbox.replaceChildren();\nif (r.status !== 'ok') {\nbox.innerHTML = `<div style=\"font-size:12px;color:var(--rose)\">检索失败：${esc(r.error || r.status)}</div>`;\nreturn;\n}\nif (!r.items.length) {\nbox.innerHTML = '<div style=\"font-size:12px;color:var(--fg-muted)\">未找到匹配的 Crossref 文献。</div>';\nreturn;\n}\nfor (const it of r.items) {\nconst row = document.createElement('div');\nrow.style.cssText = 'display:flex;justify-content:space-between;align-items:center;gap:10px;padding:8px 10px;border:1px solid var(--border);border-radius:8px;background:var(--bg-input)';\nrow.innerHTML = `<div style=\"min-width:0\"><div style=\"font-weight:600;font-size:12.5px\">${esc(it.title)}</div><div style=\"font-size:11.5px;color:var(--fg-muted)\">${esc(it.authors)} · ${it.year} · ${esc(it.venue)}</div><div style=\"font-size:11px;color:var(--fg-dim)\">${esc(it.citation)}</div></div>`;\nconst btn = document.createElement('button');\nbtn.type = 'button';\nbtn.className = 'btn sm primary';\nbtn.textContent = '+ 收录';\nbtn.addEventListener('click', async () => {\nconst slug = it.title.toLowerCase().replace(/[^a-z0-9]+/g, '').slice(0, 12) || 'cr';\nconst id = `${slug}${it.year}-${Date.now().toString(36).slice(-3)}`.slice(0, 40);\nconst saved = await plugin.action('paper.save', {\nexpected_revision: state.revision,\nid,\ntitle: it.title.slice(0, 160),\nauthors: it.authors.slice(0, 120),\nyear: Math.max(1950, Math.min(2100, it.year)),\nvenue: it.venue.slice(0, 48),\ntags: ['Crossref'],\nrating: 4,\nstatus: 'unread',\nmethod: '',\ncontribution: it.citation.slice(0, 260),\nlimitations: '',\ncites: [],\n});\nif (saved.status === 'saved') { await loadAll(); toast(`已收录：${it.title.slice(0, 32)}`, 'ok'); }\nelse toast(`收录未完成：${saved.status}`, 'error');\n});\nrow.appendChild(btn);\nbox.appendChild(row);\n}\n} catch (e) { box.innerHTML = `<div style=\"font-size:12px;color:var(--rose)\">请求异常：${esc(e?.message || '未知错误')}</div>`; }\n});\n$('btn-ai-draft').addEventListener('click', () => {\nconst selPapers = state.matrix.selected_ids.map(id => state.papers.find(p => p.id === id)).filter(Boolean).slice(0, 6);\nif (!selPapers.length) { toast('请先勾选至少 1 篇论文。', 'error'); return; }\nconst focus = $('ai-focus').value.trim();\nconst lines = [\n`## ${MODE_LBL[state.aiMode]}（本地结构化草稿）`,\nfocus ? `> 聚焦方向：${focus}` : '',\n'',\n...selPapers.map((p, idx) => `${idx + 1}. **${p.title}** (${p.authors}, ${p.year}, ${p.venue})\\n   - 方法：${p.method || '待补充'}\\n   - 贡献：${p.contribution || '待补充'}\\n   - 局限：${p.limitations || '待补充'}`),\n'',\n'### 综合分析与下一步建议',\n'- 可直接点击「采纳并存为科研笔记」保存本草稿，或点击「插入提示词到工作台聊天」交给 Velai 会话 / 独立 AI 伴生插件深度扩写。',\n].filter(Boolean);\nstate.latestAiText = lines.join('\\n');\n$('ai-turn-box').hidden = false;\n$('ai-turn-state').textContent = '已生成本地结构化草稿，可直接采纳存为科研笔记，或复制提示词至工作台聊天深化。';\n$('ai-turn-preview').textContent = state.latestAiText;\n$('ai-turn-preview').hidden = false;\n$('btn-ai-adopt').hidden = false;\n});\n$('btn-ai-copy-prompt').addEventListener('click', async () => {\nconst prompt = buildAiPrompt();\nif (!prompt) { toast('请先勾选至少 1 篇论文。', 'error'); return; }\ntry { await navigator.clipboard.writeText(prompt); toast('已复制综述提示词，可粘贴至工作台聊天或 AI 伴生插件。', 'ok'); }\ncatch { toast('请使用「插入提示词到工作台聊天」按钮。'); }\n});\n$('btn-ai-adopt').addEventListener('click', async () => {\nif (!state.latestAiText || state.busy) return;\nstate.busy = true;\ntry {\nconst id = `note-${Date.now().toString(36)}`;\nconst selIds = state.matrix.selected_ids.filter(x => state.papers.some(p => p.id === x)).slice(0, 6);\nconst r = await plugin.action('note.save', {\nexpected_revision: state.revision,\nid,\ntitle: `${MODE_LBL[state.aiMode]} (${selIds.length}篇)`,\nmode: state.aiMode,\npaper_ids: selIds,\ncontent: state.latestAiText.slice(0, 6000),\n});\nif (r.status === 'saved') {\nstate.latestAiText = '';\n$('ai-turn-box').hidden = true;\nawait loadAll();\nawait openNote(id);\ntoast('已采纳并保存为科研笔记！', 'ok');\n} else toast(`保存笔记未完成：${r.status}`, 'error');\n} catch (e) { toast(`保存失败：${e?.message || '未知错误'}`, 'error'); }\nfinally { state.busy = false; }\n});\n$('btn-ai-insert-prompt').addEventListener('click', async () => {\nconst prompt = buildAiPrompt();\nif (!prompt) { toast('请先勾选至少 1 篇论文。', 'error'); return; }\ntry {\nconst r = await plugin.action('host.draft.insert', { text: prompt });\ntoast(r?.inserted ? '已将综述提示词插入会话输入框。' : '未确认插入结果。', r?.inserted ? 'ok' : 'error');\n} catch (e) { toast(`插入失败：${e?.message || '未知错误'}`, 'error'); }\n});\n$('btn-new-note').addEventListener('click', () => {\nstate.activeNoteId = `note-${Date.now().toString(36)}`;\n$('note-viewer').hidden = false;\n$('nv-title').value = '新建科研综述笔记';\n$('nv-content').value = '';\n$('nv-title').focus();\n});\n$('nv-save').addEventListener('click', async () => {\nif (state.busy || !state.activeNoteId) return;\nconst title = $('nv-title').value.trim();\nconst content = $('nv-content').value.trim();\nif (!title || !content) { toast('笔记标题与正文不能为空。', 'error'); return; }\nstate.busy = true;\ntry {\nconst exist = state.notes.find(n => n.id === state.activeNoteId);\nconst r = await plugin.action('note.save', {\nexpected_revision: state.revision,\nid: state.activeNoteId,\ntitle,\nmode: exist?.mode || 'custom',\npaper_ids: exist?.paper_ids || state.matrix.selected_ids.slice(0, 6),\ncontent,\n});\nif (r.status === 'saved') { await loadAll(); toast('科研笔记已保存。', 'ok'); }\nelse toast(`保存未完成：${r.status}`, 'error');\n} catch (e) { toast(`保存失败：${e?.message || '未知错误'}`, 'error'); }\nfinally { state.busy = false; }\n});\n$('nv-insert').addEventListener('click', async () => {\nconst text = `# ${$('nv-title').value.trim()}\\n\\n${$('nv-content').value.trim()}`;\ntry {\nconst r = await plugin.action('host.draft.insert', { text });\ntoast(r?.inserted ? '已插入笔记到会话输入框。' : '未确认插入结果。', r?.inserted ? 'ok' : 'error');\n} catch (e) { toast(`插入失败：${e?.message || '未知错误'}`, 'error'); }\n});\n$('nv-del').addEventListener('click', async () => {\nif (state.busy || !state.activeNoteId) return;\nstate.busy = true;\ntry {\nconst r = await plugin.action('note.delete', { expected_revision: state.revision, id: state.activeNoteId });\nif (r.status === 'deleted') {\nstate.activeNoteId = null;\n$('note-viewer').hidden = true;\nawait loadAll();\ntoast('已删除科研笔记。', 'ok');\n} else toast(`删除未完成：${r.status}`, 'error');\n} catch (e) { toast(`删除失败：${e?.message || '未知错误'}`, 'error'); }\nfinally { state.busy = false; }\n});\n$('btn-io').addEventListener('click', async () => {\n$('modal-io').hidden = false;\n$('io-text').value = '';\nconst sel = $('io-select');\nsel.replaceChildren();\ntry {\nconst list = await plugin.action('document.list', {});\nif (!list.items.length) {\nconst opt = document.createElement('option'); opt.value = ''; opt.textContent = '暂无可导出文档（可粘贴 JSON 导入）';\nsel.appendChild(opt);\n} else {\nfor (const it of list.items) {\nconst opt = document.createElement('option'); opt.value = it.id; opt.textContent = it.label;\nsel.appendChild(opt);\n}\n}\n} catch (e) { toast(`读取导出清单失败：${e?.message || '未知错误'}`, 'error'); }\n});\n$('io-close').addEventListener('click', () => { $('modal-io').hidden = true; });\n$('io-export').addEventListener('click', async () => {\nconst id = $('io-select').value;\nif (!id) return;\ntry {\nconst r = await plugin.action('document.export', { id });\nif (r.text) { $('io-text').value = r.text; toast(`已导出：${r.filename}`, 'ok'); }\nelse toast(`导出失败：${r.error || '未知错误'}`, 'error');\n} catch (e) { toast(`导出失败：${e?.message || '未知错误'}`, 'error'); }\n});\n$('io-copy').addEventListener('click', async () => {\ntry { await navigator.clipboard.writeText($('io-text').value); toast('已复制 JSON。', 'ok'); }\ncatch { toast('请手动全选文本框复制。'); }\n});\n$('io-import').addEventListener('click', async () => {\nconst text = $('io-text').value.trim();\nif (!text) { toast('请先粘贴 JSON 内容。', 'error'); return; }\ntry {\nconst r = await plugin.action('document.import', { text });\nif (r.imported) { $('modal-io').hidden = true; await loadAll(); toast(`导入成功（共 ${r.count ?? 1} 项）。`, 'ok'); }\nelse toast(`导入失败：${r.reason || '格式无效'}`, 'error');\n} catch (e) { toast(`导入失败：${e?.message || '未知错误'}`, 'error'); }\n});\nvoid loadAll();\n})();\n\n/* === V2 Host Theme & Compact Surface JS Start === */\n(() => {\n  const root = document.documentElement;\n  const BTN_MODE = \"short\";\n  const HAS_SIDEBAR = true;\n  const MAIN_SEL = \".workspace\";\n  const INIT_MQ = false;\n  const VALID_THEMES = new Set(['light', 'dark']);\n  const VALID_SURFACES = new Set(['workspace', 'chat', 'assistant']);\n\n  const normalizeTheme = val => (val === 'light' || val === 'dark' ? val : null);\n\n  if (INIT_MQ && !normalizeTheme(root.getAttribute('data-theme'))) {\n    try {\n      const dark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;\n      root.setAttribute('data-theme', dark ? 'dark' : 'light');\n    } catch {}\n  }\n\n  let hostTheme = normalizeTheme(root.getAttribute('data-theme'));\n\n  function syncThemeButton(theme) {\n    const btn = document.getElementById('btn-theme');\n    if (!btn || !VALID_THEMES.has(theme)) return;\n    btn.setAttribute('aria-pressed', String(theme === 'dark'));\n    btn.dataset.activeTheme = theme;\n    btn.title = theme === 'dark' ? '当前深色主题，点击切换浅色' : '当前浅色主题，点击切换深色';\n    if (BTN_MODE === 'short') {\n      btn.textContent = theme === 'light' ? '☾ 深色' : '☀ 浅色';\n    } else if (BTN_MODE === 'emoji') {\n      const txt = (btn.textContent || '').trim();\n      const rest = txt.replace(/^(?:☀️|☀|🌙|☾|◐)\\s*/, '');\n      btn.textContent = (theme === 'light' ? '🌙 ' : '☀️ ') + (rest || '外观');\n    } else {\n      btn.textContent = theme === 'dark' ? '☀ 切换浅色' : '☾ 切换深色';\n    }\n  }\n\n  function applyHostTheme(raw) {\n    const data = raw && typeof raw === 'object'\n      ? (raw.theme || raw.surface || raw.tokens ? raw : (raw.payload && typeof raw.payload === 'object' ? raw.payload : raw))\n      : null;\n    if (!data || typeof data !== 'object') return;\n    const nextTheme = normalizeTheme(data.theme);\n    if (nextTheme) {\n      hostTheme = nextTheme;\n      root.removeAttribute('data-theme-override');\n      root.setAttribute('data-theme', nextTheme);\n      syncThemeButton(nextTheme);\n    }\n    if (typeof data.surface === 'string' && VALID_SURFACES.has(data.surface)) {\n      root.setAttribute('data-surface', data.surface);\n    }\n    if (data.tokens && typeof data.tokens === 'object') {\n      for (const [k, v] of Object.entries(data.tokens)) {\n        if (typeof v === 'string' && k) {\n          try { root.style.setProperty(k.startsWith('--') ? k : '--' + k, v); } catch {}\n        }\n      }\n    }\n  }\n\n  const initialTheme = normalizeTheme(root.getAttribute('data-theme'));\n  if (initialTheme) syncThemeButton(initialTheme);\n\n  const themeBtn = document.getElementById('btn-theme');\n  if (themeBtn) {\n    themeBtn.addEventListener('click', () => {\n      const cur = normalizeTheme(root.getAttribute('data-theme'));\n      if (!cur) return;\n      if (hostTheme && cur !== hostTheme) root.setAttribute('data-theme-override', '1');\n      else root.removeAttribute('data-theme-override');\n      syncThemeButton(cur);\n    });\n  }\n\n  try {\n    window.addEventListener('host.theme.changed', ev => {\n      try { applyHostTheme(ev && typeof ev === 'object' && 'detail' in ev ? ev.detail : ev); } catch {}\n    });\n  } catch {}\n  try {\n    const sub = globalThis.nmasPlugin?.subscribe?.('host.theme.changed', payload => {\n      try { applyHostTheme(payload); } catch {}\n    });\n    if (sub && typeof sub.catch === 'function') sub.catch(() => {});\n  } catch {}\n\n  if (HAS_SIDEBAR) {\n    const sidebar = document.querySelector('.sidebar');\n    const hostMain = document.querySelector(MAIN_SEL) || document.querySelector('.main, .main-area, .main-col, .workspace');\n    const srcBtns = sidebar ? Array.from(sidebar.querySelectorAll('button[data-view]')) : [];\n    if (sidebar && hostMain && srcBtns.length > 0 && !hostMain.querySelector('.v2-surface-nav')) {\n      const nav = document.createElement('nav');\n      nav.className = 'v2-surface-nav';\n      nav.setAttribute('aria-label', '视图切换');\n      const pairs = srcBtns.map(src => {\n        const clone = src.cloneNode(true);\n        clone.querySelectorAll('svg, .nav-badge, .pill, .mono').forEach(el => el.remove());\n        const navLeft = clone.querySelector('.nav-left');\n        let label = '';\n        if (navLeft) {\n          label = Array.from(navLeft.children).map(el => (el.textContent || '').trim()).filter(Boolean).join(' ');\n        } else {\n          label = (clone.textContent || '').replace(/\\s+/g, ' ').trim();\n        }\n        const tab = document.createElement('button');\n        tab.type = 'button';\n        tab.className = 'v2-surface-tab';\n        tab.dataset.surfaceView = src.dataset.view || '';\n        tab.textContent = label || src.dataset.view || '视图';\n        tab.addEventListener('click', () => { try { src.click(); } catch {} });\n        nav.appendChild(tab);\n        return [src, tab];\n      });\n      const syncNav = () => {\n        for (const [src, tab] of pairs) {\n          const active = src.classList.contains('active');\n          tab.classList.toggle('active', active);\n          if (active) tab.setAttribute('aria-current', 'page');\n          else tab.removeAttribute('aria-current');\n        }\n      };\n      syncNav();\n      hostMain.prepend(nav);\n      try {\n        const obs = new MutationObserver(syncNav);\n        obs.observe(sidebar, { subtree: true, attributes: true, attributeFilter: ['class'] });\n      } catch {}\n    }\n  }\n})();\n/* === V2 Host Theme & Compact Surface JS End === */\n</script>\n</body>\n</html>\n","path":"ui/index.html"}],"format":"nmas-plugin","manifest":{"actions":[{"id":"lab.load","input_schema":{"additionalProperties":false,"properties":{},"required":[],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"kpi":{"additionalProperties":false,"properties":{"annotated_or_cited":{"maximum":128,"minimum":0,"type":"integer"},"avg_rating":{"maximum":5,"minimum":0,"type":"number"},"citation_edges":{"maximum":1024,"minimum":0,"type":"integer"},"total_notes":{"maximum":128,"minimum":0,"type":"integer"},"total_papers":{"maximum":128,"minimum":0,"type":"integer"}},"required":["total_papers","annotated_or_cited","citation_edges","total_notes","avg_rating"],"type":"object"},"matrix":{"additionalProperties":false,"properties":{"rows":{"additionalProperties":true,"type":"object"},"selected_ids":{"items":{"maxLength":40,"minLength":1,"type":"string"},"type":"array"}},"required":["selected_ids","rows"],"type":"object"},"notes":{"items":{"additionalProperties":false,"properties":{"created_at":{"maxLength":24,"type":"string"},"id":{"maxLength":40,"minLength":1,"type":"string"},"mode":{"enum":["related_work","research_gaps","experiment_plan","peer_review","custom"],"type":"string"},"paper_ids":{"items":{"maxLength":40,"