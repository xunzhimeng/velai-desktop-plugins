{"files":[{"content":"const COL_ACCOUNTS = 'accounts';\nconst COL_LEDGER = 'ledger';\nconst COL_GOALS = 'goals';\nconst KEY_LIST = 'list';\nconst DOC_FORMAT = 'velai-finance-wealth-os';\n\nconst MAX_RECORD_BYTES = 240 * 1024;\nconst MAX_ACCOUNTS = 64;\nconst MAX_LEDGER = 500;\nconst MAX_GOALS = 48;\n\nconst ACC_KINDS = ['asset', 'liability'];\nconst ASSET_CLASSES = ['cash', 'equity', 'fund', 'real_estate', 'fixed_income', 'debt', 'other'];\nconst TX_TYPES = ['income', 'expense', 'transfer'];\nconst TX_CATS = [\n  'salary', 'bonus', 'dividend', 'housing', 'food', 'transport',\n  'health', 'shopping', 'education', 'entertainment', 'travel', 'invest', 'other',\n];\nconst GOAL_KINDS = ['budget', 'target'];\n\nfunction jsonBytes(v) {\n  let b = 0;\n  for (const ch of JSON.stringify(v)) {\n    const cp = ch.codePointAt(0);\n    b += cp <= 0x7f ? 1 : cp <= 0x7ff ? 2 : cp <= 0xffff ? 3 : 4;\n  }\n  return b;\n}\n\nfunction todayStr() {\n  return new Date().toISOString().slice(0, 10);\n}\n\nfunction monthStr(offsetMonths = 0) {\n  const now = new Date();\n  const d = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth() + offsetMonths, 1));\n  return `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}`;\n}\n\nfunction isDate(s) {\n  return typeof s === 'string' && /^\\d{4}-\\d{2}-\\d{2}$/.test(s);\n}\n\nfunction isMonth(s) {\n  return typeof s === 'string' && /^\\d{4}-\\d{2}$/.test(s);\n}\n\nfunction validId(s) {\n  return typeof s === 'string' && s.length >= 1 && s.length <= 48 && /^[a-zA-Z0-9._-]+$/.test(s);\n}\n\nfunction round2(n) {\n  return Math.round(n * 100) / 100;\n}\n\nfunction makeId(prefix) {\n  const rand = Math.floor(Math.random() * 0xffffff).toString(36).padStart(4, '0');\n  return `${prefix}-${Date.now().toString(36)}-${rand}`.slice(0, 48);\n}\n\nasync function readAccounts() {\n  const receipt = await globalThis.nmas.data.read({ collection: COL_ACCOUNTS, key: KEY_LIST });\n  const doc = receipt.value === null ? { schema_version: 1, items: [] } : receipt.value;\n  if (!doc || doc.schema_version !== 1 || !Array.isArray(doc.items)) throw new Error('accounts 数据格式无效');\n  return { revision: receipt.revision, items: doc.items };\n}\n\nasync function readLedger() {\n  const receipt = await globalThis.nmas.data.read({ collection: COL_LEDGER, key: KEY_LIST });\n  const doc = receipt.value === null ? { schema_version: 1, items: [] } : receipt.value;\n  if (!doc || doc.schema_version !== 1 || !Array.isArray(doc.items)) throw new Error('ledger 数据格式无效');\n  return { revision: receipt.revision, items: doc.items };\n}\n\nasync function readGoalsDoc() {\n  const receipt = await globalThis.nmas.data.read({ collection: COL_GOALS, key: KEY_LIST });\n  const doc = receipt.value === null\n    ? { schema_version: 1, items: [], snapshots: [], cfo_memo: '' }\n    : receipt.value;\n  if (!doc || doc.schema_version !== 1 || !Array.isArray(doc.items)) throw new Error('goals 数据格式无效');\n  return {\n    revision: receipt.revision,\n    items: doc.items,\n    snapshots: Array.isArray(doc.snapshots) ? doc.snapshots : [],\n    cfo_memo: typeof doc.cfo_memo === 'string' ? doc.cfo_memo : '',\n  };\n}\n\nasync function readAll() {\n  const acc = await readAccounts();\n  const led = await readLedger();\n  const goalDoc = await readGoalsDoc();\n  return {\n    revision: Math.max(acc.revision, led.revision, goalDoc.revision),\n    accounts: acc.items,\n    ledger: led.items,\n    goals: goalDoc.items,\n    snapshots: goalDoc.snapshots,\n    cfo_memo: goalDoc.cfo_memo,\n  };\n}\n\nasync function writeDoc(collection, expectedRevision, value) {\n  if (jsonBytes(value) > MAX_RECORD_BYTES) return { status: 'limit', revision: expectedRevision };\n  try {\n    const receipt = await globalThis.nmas.data.write({\n      collection,\n      key: KEY_LIST,\n      expected_revision: expectedRevision,\n      value,\n    });\n    return { status: 'saved', revision: receipt.revision };\n  } catch (err) {\n    if (err?.code === 'conflict' && err.outcome_unknown === false) {\n      return { status: 'conflict', revision: expectedRevision };\n    }\n    throw err;\n  }\n}\n\nasync function readPluginSettings() {\n  const raw = await globalThis.nmas.settings.get();\n  const base_currency = typeof raw?.base_currency === 'string' && /^[A-Z]{3,8}$/.test(raw.base_currency.trim().toUpperCase())\n    ? raw.base_currency.trim().toUpperCase()\n    : 'CNY';\n  const pct = Number.isInteger(raw?.target_savings_pct) ? raw.target_savings_pct : 30;\n  const target_savings_pct = Math.max(1, Math.min(95, pct));\n  return { base_currency, target_savings_pct };\n}\n\nfunction sanitizeAccount(raw) {\n  if (!raw || typeof raw !== 'object') return null;\n  const id = String(raw.id || '').trim();\n  const name = String(raw.name || '').trim();\n  const kind = String(raw.kind || '').trim();\n  const assetClass = String(raw.asset_class || '').trim();\n  const balance = Number(raw.balance);\n  const apy = Number(raw.apy);\n  const institution = String(raw.institution || '').trim().slice(0, 36);\n  const note = String(raw.note || '').trim().slice(0, 120);\n  const updatedAt = isDate(raw.updated_at) ? raw.updated_at : todayStr();\n\n  if (\n    !validId(id) ||\n    !name ||\n    name.length > 48 ||\n    !ACC_KINDS.includes(kind) ||\n    !ASSET_CLASSES.includes(assetClass) ||\n    !Number.isFinite(balance) ||\n    balance < 0 ||\n    balance > 999999999 ||\n    !Number.isFinite(apy) ||\n    apy < -50 ||\n    apy > 100\n  ) {\n    return null;\n  }\n  return {\n    id,\n    name,\n    kind,\n    asset_class: kind === 'liability' ? 'debt' : assetClass,\n    balance: round2(balance),\n    apy: round2(apy),\n    institution,\n    note,\n    updated_at: updatedAt,\n  };\n}\n\nfunction sanitizeTx(raw) {\n  if (!raw || typeof raw !== 'object') return null;\n  const id = String(raw.id || '').trim();\n  const date = String(raw.date || '').trim();\n  const type = String(raw.type || '').trim();\n  const category = String(raw.category || '').trim();\n  const amount = Number(raw.amount);\n  const accountId = String(raw.account_id || '').trim();\n  const targetAccountId = String(raw.target_account_id || '').trim();\n  const note = String(raw.note || '').trim().slice(0, 100);\n\n  if (\n    !validId(id) ||\n    !isDate(date) ||\n    !TX_TYPES.includes(type) ||\n    !TX_CATS.includes(category) ||\n    !Number.isFinite(amount) ||\n    amount < 0.01 ||\n    amount > 99999999 ||\n    !validId(accountId) ||\n    (targetAccountId && !validId(targetAccountId))\n  ) {\n    return null;\n  }\n  return {\n    id,\n    date,\n    type,\n    category,\n    amount: round2(amount),\n    account_id: accountId,\n    target_account_id: type === 'transfer' ? targetAccountId : '',\n    note,\n  };\n}\n\nfunction sanitizeGoal(raw) {\n  if (!raw || typeof raw !== 'object') return null;\n  const id = String(raw.id || '').trim();\n  const kind = String(raw.kind || '').trim();\n  const category = String(raw.category || '').trim().slice(0, 32);\n  const label = String(raw.label || '').trim().slice(0, 48);\n  const monthlyLimit = Number(raw.monthly_limit);\n  const currentSaved = Number(raw.current_saved ?? 0);\n  const targetDate = String(raw.target_date || '').trim();\n\n  if (\n    !validId(id) ||\n    !GOAL_KINDS.includes(kind) ||\n    !category ||\n    !label ||\n    !Number.isFinite(monthlyLimit) ||\n    monthlyLimit < 1 ||\n    monthlyLimit > 999999999 ||\n    !Number.isFinite(currentSaved) ||\n    currentSaved < 0 ||\n    currentSaved > 999999999 ||\n    (targetDate && !isDate(targetDate))\n  ) {\n    return null;\n  }\n  return {\n    id,\n    kind,\n    category,\n    label,\n    monthly_limit: round2(monthlyLimit),\n    current_saved: round2(currentSaved),\n    target_date: targetDate,\n  };\n}\n\nfunction budgetLevel(ratio) {\n  if (ratio > 95) return 'over';\n  if (ratio >= 75) return 'warn';\n  return 'ok';\n}\n\nfunction computeAnalytics(state, targetMonth) {\n  const month = isMonth(targetMonth) ? targetMonth : monthStr(0);\n\n  let totalAssets = 0;\n  let totalLiabilities = 0;\n  const classTotals = {\n    cash: 0,\n    equity: 0,\n    fund: 0,\n    real_estate: 0,\n    fixed_income: 0,\n    other: 0,\n  };\n\n  for (const a of state.accounts) {\n    const bal = Number(a.balance) || 0;\n    if (a.kind === 'liability') {\n      totalLiabilities = round2(totalLiabilities + bal);\n    } else {\n      totalAssets = round2(totalAssets + bal);\n      const cls = Object.prototype.hasOwnProperty.call(classTotals, a.asset_class) ? a.asset_class : 'other';\n      classTotals[cls] = round2(classTotals[cls] + bal);\n    }\n  }\n\n  const netWorth = round2(totalAssets - totalLiabilities);\n  const debtRatio = totalAssets > 0 ? round2((totalLiabilities / totalAssets) * 100) : 0;\n\n  const allocation = Object.entries(classTotals)\n    .filter(([, amt]) => amt > 0)\n    .map(([asset_class, amount]) => ({\n      asset_class,\n      amount,\n      share: totalAssets > 0 ? round2((amount / totalAssets) * 100) : 0,\n    }))\n    .sort((a, b) => b.amount - a.amount);\n\n  let monthlyIncome = 0;\n  let monthlyExpense = 0;\n  const catExpense = {};\n\n  for (const tx of state.ledger) {\n    if (!tx.date.startsWith(month)) continue;\n    const amt = Number(tx.amount) || 0;\n    if (tx.type === 'income') {\n      monthlyIncome = round2(monthlyIncome + amt);\n    } else if (tx.type === 'expense') {\n      monthlyExpense = round2(monthlyExpense + amt);\n      catExpense[tx.category] = round2((catExpense[tx.category] || 0) + amt);\n    }\n  }\n\n  const monthlySurplus = round2(monthlyIncome - monthlyExpense);\n  const savingsRate = monthlyIncome > 0 ? round2((monthlySurplus / monthlyIncome) * 100) : 0;\n\n  let overBudgetCount = 0;\n  let warnBudgetCount = 0;\n  const budgets = state.goals\n    .filter(g => g.kind === 'budget')\n    .map(g => {\n      const spent = round2(catExpense[g.category] || 0);\n      const ratio = round2((spent / g.monthly_limit) * 100);\n      const level = budgetLevel(ratio);\n      if (level === 'over') overBudgetCount += 1;\n      else if (level === 'warn') warnBudgetCount += 1;\n      return {\n        id: g.id,\n        category: g.category,\n        label: g.label,\n        limit: g.monthly_limit,\n        spent,\n        ratio,\n        level,\n      };\n    })\n    .sort((a, b) => b.ratio - a.ratio);\n\n  const topExpenses = Object.entries(catExpense)\n    .map(([category, amount]) => ({\n      category,\n      amount,\n      share: monthlyExpense > 0 ? round2((amount / monthlyExpense) * 100) : 0,\n    }))\n    .sort((a, b) => b.amount - a.amount)\n    .slice(0, 6);\n\n  // Merge historical snapshots with current month live metrics\n  const snapMap = new Map();\n  for (const s of state.snapshots) {\n    if (isMonth(s.month)) {\n      snapMap.set(s.month, {\n        month: s.month,\n        net_worth: round2(Number(s.net_worth) || 0),\n        income: round2(Math.max(0, Number(s.income) || 0)),\n        expense: round2(Math.max(0, Number(s.expense) || 0)),\n      });\n    }\n  }\n  snapMap.set(month, {\n    month,\n    net_worth: netWorth,\n    income: monthlyIncome,\n    expense: monthlyExpense,\n  });\n  const trend = Array.from(snapMap.values())\n    .sort((a, b) => a.month.localeCompare(b.month))\n    .slice(-6);\n\n  return {\n    month,\n    summary: {\n      total_assets: totalAssets,\n      total_liabilities: totalLiabilities,\n      net_worth: netWorth,\n      debt_ratio: debtRatio,\n      monthly_income: monthlyIncome,\n      monthly_expense: monthlyExpense,\n      monthly_surplus: monthlySurplus,\n      savings_rate: savingsRate,\n      over_budget_count: overBudgetCount,\n      warn_budget_count: warnBudgetCount,\n    },\n    allocation,\n    budgets,\n    top_expenses: topExpenses,\n    trend,\n  };\n}\n\nfunction runFireScenario(startNw, monthlyInvest, nominalRatePct, inflationPct, fireTarget, horizonYears) {\n  const nom = nominalRatePct / 100;\n  const inf = inflationPct / 100;\n  const realAnnual = (1 + nom) / (1 + inf) - 1;\n  const realMonthly = Math.pow(1 + realAnnual, 1 / 12) - 1;\n\n  const yearlyValues = [round2(startNw)];\n  let bal = startNw;\n  let yearsToFire = startNw >= fireTarget ? 0 : -1;\n  const maxSimYears = Math.max(horizonYears, 80);\n\n  for (let y = 1; y <= maxSimYears; y++) {\n    for (let m = 0; m < 12; m++) {\n      bal = bal * (1 + realMonthly) + monthlyInvest;\n    }\n    if (yearsToFire === -1 && bal >= fireTarget) {\n      yearsToFire = y;\n    }\n    if (y <= horizonYears) {\n      yearlyValues.push(round2(bal));\n    }\n  }\n\n  const startYear = new Date().getUTCFullYear();\n  return {\n    rate: round2(nominalRatePct),\n    real_rate: round2(realAnnual * 100),\n    final_real: yearlyValues[horizonYears],\n    fire_year: yearsToFire >= 0 ? startYear + yearsToFire : 0,\n    years_to_fire: yearsToFire,\n    yearlyValues,\n  };\n}\n\nfunction computeMortgage(m) {\n  const P = Number(m.principal);\n  const r = Number(m.annual_rate) / 100 / 12;\n  const totalMonths = Number(m.total_years) * 12;\n  const paid = Math.min(Number(m.paid_months), totalMonths - 1);\n  const remainMonths = Math.max(1, totalMonths - paid);\n  const powN = Math.pow(1 + r, totalMonths);\n  const powK = Math.pow(1 + r, paid);\n\n  const origMonthly = (P * r * powN) / (powN - 1);\n  const remPrincipal = paid === 0 ? P : (P * (powN - powK)) / (powN - 1);\n  const origRemInterest = Math.max(0, origMonthly * remainMonths - remPrincipal);\n\n  const prepay = Math.min(Math.max(0, Number(m.prepay_amount)), remPrincipal);\n  const newPrincipal = Math.max(0, remPrincipal - prepay);\n\n  if (newPrincipal <= 0.01) {\n    return {\n      original_monthly: round2(origMonthly),\n      remaining_principal: round2(remPrincipal),\n      original_remaining_interest: round2(origRemInterest),\n      new_monthly: 0,\n      new_remaining_months: 0,\n      new_remaining_interest: 0,\n      interest_saved: round2(origRemInterest),\n      months_saved: remainMonths,\n    };\n  }\n\n  if (m.mode === 'reduce_payment') {\n    const powR = Math.pow(1 + r, remainMonths);\n    const newMonthly = (newPrincipal * r * powR) / (powR - 1);\n    const newRemInterest = Math.max(0, newMonthly * remainMonths - newPrincipal);\n    return {\n      original_monthly: round2(origMonthly),\n      remaining_principal: round2(remPrincipal),\n      original_remaining_interest: round2(origRemInterest),\n      new_monthly: round2(newMonthly),\n      new_remaining_months: remainMonths,\n      new_remaining_interest: round2(newRemInterest),\n      interest_saved: round2(Math.max(0, origRemInterest - newRemInterest)),\n      months_saved: 0,\n    };\n  }\n\n  // reduce_term: keep original monthly payment, amortize month-by-month for exact precision\n  let bal = newPrincipal;\n  let months = 0;\n  let totalInterest = 0;\n  while (bal > 0.01 && months < remainMonths) {\n    const interest = bal * r;\n    const principalPaid = Math.min(bal, Math.max(0.01, origMonthly - interest));\n    bal -= principalPaid;\n    totalInterest += interest;\n    months += 1;\n  }\n\n  return {\n    original_monthly: round2(origMonthly),\n    remaining_principal: round2(remPrincipal),\n    original_remaining_interest: round2(origRemInterest),\n    new_monthly: round2(origMonthly),\n    new_remaining_months: months,\n    new_remaining_interest: round2(totalInterest),\n    interest_saved: round2(Math.max(0, origRemInterest - totalInterest)),\n    months_saved: Math.max(0, remainMonths - months),\n  };\n}\n\nfunction buildDemoDataset() {\n  const m0 = monthStr(0);\n  const d0 = todayStr();\n  const day = n => `${m0}-${String(n).padStart(2, '0')}`;\n\n  const accounts = [\n    {\n      id: 'fin-cash',\n      name: '招商活期与货币基金',\n      kind: 'asset',\n      asset_class: 'cash',\n      balance: 265000,\n      apy: 2.1,\n      institution: '招商银行',\n      note: '含 6 个月家庭应急储备金',\n      updated_at: d0,\n    },\n    {\n      id: 'fin-equity',\n      name: '港美股科技精选账户',\n      kind: 'asset',\n      asset_class: 'equity',\n      balance: 640000,\n      apy: 11.5,\n      institution: '富途证券',\n      note: '核心持股：AI 基础设施与消费龙头',\n      updated_at: d0,\n    },\n    {\n      id: 'fin-fund',\n      name: '全球宽基指数 ETF 定投',\n      kind: 'asset',\n      asset_class: 'fund',\n      balance: 485000,\n      apy: 8.2,\n      institution: '雪球基金',\n      note: '沪深300 + 标普500 + 黄金ETF 组合',\n      updated_at: d0,\n    },\n    {\n      id: 'fin-fixed',\n      name: '国债与纯债固收组合',\n      kind: 'asset',\n      asset_class: 'fixed_income',\n      balance: 310000,\n      apy: 3.4,\n      institution: '中银理财',\n      note: '低波防御底仓',\n      updated_at: d0,\n    },\n    {\n      id: 'fin-house',\n      name: '自住改善型住宅估值',\n      kind: 'asset',\n      asset_class: 'real_estate',\n      balance: 2600000,\n      apy: 1.5,\n      institution: '自有产权',\n      note: '按同小区近期成交均价保守估值',\n      updated_at: d0,\n    },\n    {\n      id: 'fin-mortgage',\n      name: '住房商业按揭贷款',\n      kind: 'liability',\n      asset_class: 'debt',\n      balance: 1180000,\n      apy: 3.45,\n      institution: '建设银行',\n      note: '剩余 22 年，LPR 重定价日每年 1 月',\n      updated_at: d0,\n    },\n  ];\n\n  const ledger = [\n    { id: 'tx-01', date: day(1), type: 'income', category: 'salary', amount: 42000, account_id: 'fin-cash', target_account_id: '', note: '本月税后主业薪资' },\n    { id: 'tx-02', date: day(3), type: 'income', category: 'dividend', amount: 3600, account_id: 'fin-fund', target_account_id: '', note: '红利低波 ETF 季度分红' },\n    { id: 'tx-03', date: day(5), type: 'income', category: 'bonus', amount: 6500, account_id: 'fin-cash', target_account_id: '', note: '技术顾问与专栏稿费' },\n    { id: 'tx-04', date: day(2), type: 'expense', category: 'housing', amount: 7200, account_id: 'fin-cash', target_account_id: '', note: '本月房贷月供与物业费' },\n    { id: 'tx-05', date: day(4), type: 'expense', category: 'food', amount: 1850, account_id: 'fin-cash', target_account_id: '', note: '家庭生鲜商超采购' },\n    { id: 'tx-06', date: day(7), type: 'expense', category: 'transport', amount: 680, account_id: 'fin-cash', target_account_id: '', note: '通勤充电、停车与打车' },\n    { id: 'tx-07', date: day(8), type: 'expense', category: 'shopping', amount: 2480, account_id: 'fin-cash', target_account_id: '', note: '人体工学外设与冬季服饰' },\n    { id: 'tx-08', date: day(10), type: 'expense', category: 'food', amount: 1460, account_id: 'fin-cash', target_account_id: '', note: '周末家庭聚餐与咖啡' },\n    { id: 'tx-09', date: day(11), type: 'expense', category: 'education', amount: 1680, account_id: 'fin-cash', target_account_id: '', note: '专业技术书籍与云算力订阅' },\n    { id: 'tx-10', date: day(12), type: 'expense', category: 'health', amount: 920, account_id: 'fin-cash', target_account_id: '', note: '年度体检升级与健身年卡分摊' },\n    { id: 'tx-11', date: day(14), type: 'expense', category: 'entertainment', amount: 1580, account_id: 'fin-cash', target_account_id: '', note: '演唱会门票与流媒体会员' },\n    { id: 'tx-12', date: day(15), type: 'expense', category: 'shopping', amount: 1750, account_id: 'fin-cash', target_account_id: '', note: '家庭智能家电升级' },\n    { id: 'tx-13', date: day(16), type: 'expense', category: 'food', amount: 1290, account_id: 'fin-cash', target_account_id: '', note: '工作日午餐与外卖' },\n    { id: 'tx-14', date: day(18), type: 'transfer', category: 'invest', amount: 18000, account_id: 'fin-cash', target_account_id: 'fin-fund', note: '月度自动定投宽基指数 ETF' },\n  ];\n\n  const goals = [\n    { id: 'goal-b-housing', kind: 'budget', category: 'housing', label: '居住与月供', monthly_limit: 8000, current_saved: 0, target_date: '' },\n    { id: 'goal-b-food', kind: 'budget', category: 'food', label: '餐饮美食', monthly_limit: 5200, current_saved: 0, target_date: '' },\n    { id: 'goal-b-shopping', kind: 'budget', category: 'shopping', label: '购物与数码', monthly_limit: 4000, current_saved: 0, target_date: '' },\n    { id: 'goal-b-ent', kind: 'budget', category: 'entertainment', label: '休闲娱乐', monthly_limit: 1800, current_saved: 0, target_date: '' },\n    { id: 'goal-b-edu', kind: 'budget', category: 'education', label: '学习成长', monthly_limit: 2500, current_saved: 0, target_date: '' },\n    { id: 'goal-t-fire', kind: 'target', category: 'invest', label: '金融净资产 200 万里程碑', monthly_limit: 2000000, current_saved: 1700000, target_date: '2028-12-31' },\n  ];\n\n  const snapshots = [\n    { month: monthStr(-5), net_worth: 2945000, income: 44500, expense: 20100 },\n    { month: monthStr(-4), net_worth: 2982000, income: 46200, expense: 19400 },\n    { month: monthStr(-3), net_worth: 3018000, income: 45800, expense: 21500 },\n    { month: monthStr(-2), net_worth: 3054000, income: 48000, expense: 18900 },\n    { month: monthStr(-1), net_worth: 3088000, income: 49500, expense: 20200 },\n  ];\n\n  return { accounts, ledger, goals, snapshots };\n}\n\nexport default async function (request) {\n  const { kind, contribution, input } = request ?? {};\n\n  if (kind === 'action') {\n    if (contribution === 'finance.snapshot') {\n      const state = await readAll();\n      const settings = await readPluginSettings();\n      const analytics = computeAnalytics(state, input.month);\n      return {\n        revision: state.revision,\n        month: analytics.month,\n        accounts: state.accounts,\n        ledger: state.ledger,\n        goals: state.goals,\n        summary: analytics.summary,\n        allocation: analytics.allocation,\n        budgets: analytics.budgets,\n        top_expenses: analytics.top_expenses,\n        trend: analytics.trend,\n        cfo_memo: state.cfo_memo,\n        settings,\n      };\n    }\n\n    if (contribution === 'finance.account.save') {\n      const record = sanitizeAccount({ ...input, updated_at: todayStr() });\n      if (!record) return { status: 'invalid_input', revision: input.expected_revision };\n      const cur = await readAccounts();\n      if (cur.revision !== input.expected_revision) return { status: 'conflict', revision: cur.revision };\n      const exists = cur.items.some(a => a.id === record.id);\n      const next = exists ? cur.items.map(a => (a.id === record.id ? record : a)) : [...cur.items, record];\n      if (next.length > MAX_ACCOUNTS) return { status: 'limit', revision: cur.revision };\n      return writeDoc(COL_ACCOUNTS, input.expected_revision, { schema_version: 1, items: next });\n    }\n\n    if (contribution === 'finance.account.delete') {\n      const cur = await readAccounts();\n      if (cur.revision !== input.expected_revision) return { status: 'conflict', revision: cur.revision };\n      if (!cur.items.some(a => a.id === input.id)) return { status: 'not_found', revision: cur.revision };\n      const next = cur.items.filter(a => a.id !== input.id);\n      const res = await writeDoc(COL_ACCOUNTS, input.expected_revision, { schema_version: 1, items: next });\n      return res.status === 'saved' ? { status: 'deleted', revision: res.revision } : { status: 'conflict', revision: res.revision };\n    }\n\n    if (contribution === 'finance.tx.save') {\n      const record = sanitizeTx(input);\n      if (!record) return { status: 'invalid_input', revision: input.expected_revision };\n      const acc = await readAccounts();\n      const led = await readLedger();\n      const rev = Math.max(acc.revision, led.revision);\n      if (rev !== input.expected_revision) return { status: 'conflict', revision: rev };\n\n      const exists = led.items.some(t => t.id === record.id);\n      const nextLedger = exists ? led.items.map(t => (t.id === record.id ? record : t)) : [record, ...led.items];\n      if (nextLedger.length > MAX_LEDGER) return { status: 'limit', revision: rev };\n\n      const r1 = await writeDoc(COL_LEDGER, input.expected_revision, { schema_version: 1, items: nextLedger });\n      if (r1.status !== 'saved') return r1;\n\n      if (input.sync_balance && !exists) {\n        let changed = false;\n        const nextAccounts = acc.items.map(a => {\n          if (a.id === record.account_id) {\n            changed = true;\n            const delta = record.type === 'income' ? record.amount : -record.amount;\n            return { ...a, balance: round2(Math.max(0, a.balance + delta)), updated_at: todayStr() };\n          }\n          if (record.type === 'transfer' && record.target_account_id && a.id === record.target_account_id) {\n            changed = true;\n            return { ...a, balance: round2(a.balance + record.amount), updated_at: todayStr() };\n          }\n          return a;\n        });\n        if (changed) {\n          const r2 = await writeDoc(COL_ACCOUNTS, r1.revision, { schema_version: 1, items: nextAccounts });\n          if (r2.status === 'saved') return r2;\n        }\n      }\n      return r1;\n    }\n\n    if (contribution === 'finance.tx.delete') {\n      const led = await readLedger();\n      if (led.revision !== input.expected_revision) return { status: 'conflict', revision: led.revision };\n      if (!led.items.some(t => t.id === input.id)) return { status: 'not_found', revision: led.revision };\n      const next = led.items.filter(t => t.id !== input.id);\n      const res = await writeDoc(COL_LEDGER, input.expected_revision, { schema_version: 1, items: next });\n      return res.status === 'saved' ? { status: 'deleted', revision: res.revision } : { status: 'conflict', revision: res.revision };\n    }\n\n    if (contribution === 'finance.goal.save') {\n      const record = sanitizeGoal(input);\n      if (!record) return { status: 'invalid_input', revision: input.expected_revision };\n      const cur = await readGoalsDoc();\n      if (cur.revision !== input.expected_revision) return { status: 'conflict', revision: cur.revision };\n      const exists = cur.items.some(g => g.id === record.id);\n      const next = exists ? cur.items.map(g => (g.id === record.id ? record : g)) : [...cur.items, record];\n      if (next.length > MAX_GOALS) return { status: 'limit', revision: cur.revision };\n      return writeDoc(COL_GOALS, input.expected_revision, {\n        schema_version: 1,\n        items: next,\n        snapshots: cur.snapshots,\n        cfo_memo: cur.cfo_memo,\n      });\n    }\n\n    if (contribution === 'finance.goal.delete') {\n      const cur = await readGoalsDoc();\n      if (cur.revision !== input.expected_revision) return { status: 'conflict', revision: cur.revision };\n      if (!cur.items.some(g => g.id === input.id)) return { status: 'not_found', revision: cur.revision };\n      const next = cur.items.filter(g => g.id !== input.id);\n      const res = await writeDoc(COL_GOALS, input.expected_revision, {\n        schema_version: 1,\n        items: next,\n        snapshots: cur.snapshots,\n        cfo_memo: cur.cfo_memo,\n      });\n      return res.status === 'saved' ? { status: 'deleted', revision: res.revision } : { status: 'conflict', revision: res.revision };\n    }\n\n    if (contribution === 'finance.cfo.memo') {\n      const cur = await readGoalsDoc();\n      if (cur.revision !== input.expected_revision) return { status: 'conflict', revision: cur.revision };\n      return writeDoc(COL_GOALS, input.expected_revision, {\n        schema_version: 1,\n        items: cur.items,\n        snapshots: cur.snapshots,\n        cfo_memo: String(input.memo || '').trim().slice(0, 2048),\n      });\n    }\n\n    if (contribution === 'finance.simulate') {\n      const nw = Number(input.current_net_worth);\n      const monthly = Number(input.monthly_invest);\n      const ret = Number(input.expected_return);\n      const inf = Number(input.inflation);\n      const annualExp = Number(input.annual_expense);\n      const swr = Number(input.swr ?? 4);\n      const years = Number(input.years ?? 20);\n      const fireTarget = round2(annualExp / (swr / 100));\n      const startYear = new Date().getUTCFullYear();\n\n      const cons = runFireScenario(nw, monthly, Math.max(0, ret - 2.5), inf, fireTarget, years);\n      const base = runFireScenario(nw, monthly, ret, inf, fireTarget, years);\n      const opt = runFireScenario(nw, monthly, ret + 2.5, inf, fireTarget, years);\n\n      const series = [];\n      for (let i = 0; i <= years; i++) {\n        series.push({\n          year: startYear + i,\n          conservative: cons.yearlyValues[i],\n          base: base.yearlyValues[i],\n          optimistic: opt.yearlyValues[i],\n        });\n      }\n\n      const out = {\n        fire_target: fireTarget,\n        start_year: startYear,\n        years,\n        scenarios: {\n          conservative: {\n            rate: cons.rate,\n            real_rate: cons.real_rate,\n            final_real: cons.final_real,\n            fire_year: cons.fire_year,\n            years_to_fire: cons.years_to_fire,\n          },\n          base: {\n            rate: base.rate,\n            real_rate: base.real_rate,\n            final_real: base.final_real,\n            fire_year: base.fire_year,\n            years_to_fire: base.years_to_fire,\n          },\n          optimistic: {\n            rate: opt.rate,\n            real_rate: opt.real_rate,\n            final_real: opt.final_real,\n            fire_year: opt.fire_year,\n            years_to_fire: opt.years_to_fire,\n          },\n        },\n        series,\n      };\n      if (input.mortgage) {\n        out.mortgage_result = computeMortgage(input.mortgage);\n      }\n      return out;\n    }\n\n    if (contribution === 'finance.demo.seed') {\n      const cur = await readAccounts();\n      if (cur.revision !== input.expected_revision) return { status: 'conflict', revision: cur.revision };\n      const demo = buildDemoDataset();\n      let rev = input.expected_revision;\n      const r1 = await writeDoc(COL_ACCOUNTS, rev, { schema_version: 1, items: demo.accounts });\n      if (r1.status !== 'saved') return { status: 'conflict', revision: r1.revision };\n      rev = r1.revision;\n      const r2 = await writeDoc(COL_LEDGER, rev, { schema_version: 1, items: demo.ledger });\n      if (r2.status !== 'saved') return { status: 'conflict', revision: r2.revision };\n      rev = r2.revision;\n      const r3 = await writeDoc(COL_GOALS, rev, {\n        schema_version: 1,\n        items: demo.goals,\n        snapshots: demo.snapshots,\n        cfo_memo: '',\n      });\n      if (r3.status !== 'saved') return { status: 'conflict', revision: r3.revision };\n      return {\n        status: 'seeded',\n        revision: r3.revision,\n        counts: {\n          accounts: demo.accounts.length,\n          ledger: demo.ledger.length,\n          goals: demo.goals.length,\n        },\n      };\n    }\n\n    if (contribution === 'document.list') {\n      const state = await readAll();\n      return {\n        items: [\n          {\n            id: 'all',\n            label: `完整财务数据包（${state.accounts.length} 账户 / ${state.ledger.length} 流水 / ${state.goals.length} 预算目标）`,\n          },\n          { id: 'balance-sheet', label: `资产负债表快照（${state.accounts.length} 个账户）` },\n          { id: 'ledger', label: `收支流水账本（${state.ledger.length} 笔）` },\n        ],\n      };\n    }\n\n    if (contribution === 'document.export') {\n      const state = await readAll();\n      let payload;\n      let filename;\n      if (input.id === 'all') {\n        payload = {\n          format: DOC_FORMAT,\n          version: 1,\n          scope: 'full',\n          accounts: state.accounts,\n          ledger: state.ledger,\n          goals: state.goals,\n          snapshots: state.snapshots,\n        };\n        filename = `finance-wealth-os-${todayStr()}.json`;\n      } else if (input.id === 'balance-sheet') {\n        payload = { format: DOC_FORMAT, version: 1, scope: 'accounts', accounts: state.accounts };\n        filename = `balance-sheet-${todayStr()}.json`;\n      } else if (input.id === 'ledger') {\n        payload = { format: DOC_FORMAT, version: 1, scope: 'ledger', ledger: state.ledger };\n        filename = `ledger-${todayStr()}.json`;\n      } else {\n        return { error: 'not_found' };\n      }\n      const text = JSON.stringify(payload);\n      if (jsonBytes(text) > MAX_RECORD_BYTES) return { error: 'payload_too_large' };\n      return { filename, text };\n    }\n\n    if (contribution === 'document.import') {\n      let parsed;\n      try {\n        parsed = JSON.parse(input.text);\n      } catch {\n        return { imported: false, reason: 'invalid_json' };\n      }\n      if (!parsed || parsed.format !== DOC_FORMAT || parsed.version !== 1) {\n        return { imported: false, reason: 'invalid_document' };\n      }\n      const state = await readAll();\n      let rev = state.revision;\n\n      if (Array.isArray(parsed.accounts)) {\n        const cleanAcc = parsed.accounts.map(sanitizeAccount).filter(Boolean).slice(0, MAX_ACCOUNTS);\n        const r = await writeDoc(COL_ACCOUNTS, rev, { schema_version: 1, items: cleanAcc });\n        if (r.status !== 'saved') return { imported: false, reason: r.status };\n        rev = r.revision;\n      }\n      if (Array.isArray(parsed.ledger)) {\n        const cleanLed = parsed.ledger.map(sanitizeTx).filter(Boolean).slice(0, MAX_LEDGER);\n        const r = await writeDoc(COL_LEDGER, rev, { schema_version: 1, items: cleanLed });\n        if (r.status !== 'saved') return { imported: false, reason: r.status };\n        rev = r.revision;\n      }\n      if (Array.isArray(parsed.goals)) {\n        const cleanGoals = parsed.goals.map(sanitizeGoal).filter(Boolean).slice(0, MAX_GOALS);\n        const cleanSnaps = Array.isArray(parsed.snapshots) ? parsed.snapshots.slice(-12) : state.snapshots;\n        const r = await writeDoc(COL_GOALS, rev, {\n          schema_version: 1,\n          items: cleanGoals,\n          snapshots: cleanSnaps,\n          cfo_memo: state.cfo_memo,\n        });\n        if (r.status !== 'saved') return { imported: false, reason: r.status };\n      }\n      return { imported: true };\n    }\n\n    if (contribution === 'finance.fetch_fx_rates') {\n      const settings = await readPluginSettings();\n      const rawBase = typeof input.base === 'string' && input.base.trim() ? input.base.trim().toUpperCase() : settings.base_currency;\n      if (!/^[A-Z]{3,8}$/.test(rawBase)) {\n        return { status: 'invalid_input', base: settings.base_currency, date: '', rates: [], target_savings_pct: settings.target_savings_pct, error: '无效的基础币种代码' };\n      }\n      const defaults = ['USD', 'EUR', 'HKD', 'JPY', 'GBP'].filter(c => c !== rawBase);\n      const rawSymbols = Array.isArray(input.symbols) && input.symbols.length\n        ? input.symbols.map(s => String(s || '').trim().toUpperCase()).filter(s => /^[A-Z]{3,8}$/.test(s) && s !== rawBase)\n        : defaults;\n      const symbolsList = [...new Set(rawSymbols)].slice(0, 12);\n      const query = { base: rawBase };\n      if (symbolsList.length) query.symbols = symbolsList.join(',');\n      try {\n        const res = await globalThis.nmas.http.request({\n          rule: 0,\n          method: 'GET',\n          path: '/v1/latest',\n          query,\n          headers: { accept: 'application/json' },\n          responseType: 'json',\n        });\n        if (res.status && res.status >= 400) {\n          return {\n            status: 'http_error',\n            base: rawBase,\n            date: '',\n            rates: [],\n            target_savings_pct: settings.target_savings_pct,\n            error: `Frankfurter HTTP ${res.status}`,\n          };\n        }\n        const data = res.json ?? {};\n        const ratesObj = data.rates && typeof data.rates === 'object' ? data.rates : {};\n        const rates = Object.entries(ratesObj)\n          .filter(([k, v]) => typeof k === 'string' && typeof v === 'number' && Number.isFinite(v) && v >= 0)\n          .map(([currency, rate]) => ({ currency: currency.toUpperCase().slice(0, 8), rate }))\n          .sort((a, b) => a.currency.localeCompare(b.currency));\n        return {\n          status: 'ok',\n          base: typeof data.base === 'string' ? data.base.toUpperCase().slice(0, 8) : rawBase,\n          date: typeof data.date === 'string' ? data.date.slice(0, 16) : todayStr(),\n          rates,\n          target_savings_pct: settings.target_savings_pct,\n        };\n      } catch (err) {\n        return {\n          status: 'http_error',\n          base: rawBase,\n          date: '',\n          rates: [],\n          target_savings_pct: settings.target_savings_pct,\n          error: String(err?.message || 'network_error').slice(0, 160),\n        };\n      }\n    }\n  }\n\n  if (kind === 'tool') {\n    if (contribution === 'finance.summary') {\n      const state = await readAll();\n      const a = computeAnalytics(state, input.month);\n      const hasData = state.accounts.length > 0 || state.ledger.length > 0;\n      return {\n        success: true,\n        status: hasData ? 'ready' : 'empty',\n        month: a.month,\n        summary: {\n          total_assets: a.summary.total_assets,\n          total_liabilities: a.summary.total_liabilities,\n          net_worth: a.summary.net_worth,\n          debt_ratio: a.summary.debt_ratio,\n          monthly_income: a.summary.monthly_income,\n          monthly_expense: a.summary.monthly_expense,\n          savings_rate: a.summary.savings_rate,\n        },\n        allocation: a.allocation,\n        budget_alerts: a.budgets.map(({ category, label, limit, spent, ratio, level }) => ({\n          category,\n          label,\n          limit,\n          spent,\n          ratio,\n          level,\n        })),\n        top_expenses: a.top_expenses,\n      };\n    }\n\n    if (contribution === 'finance.tx.add') {\n      const state = await readAll();\n      const q = String(input.account_name || '').trim().toLowerCase();\n      const matchedAcc =\n        (q && state.accounts.find(a => a.id.toLowerCase() === q || a.name.toLowerCase().includes(q))) ||\n        state.accounts.find(a => a.asset_class === 'cash') ||\n        state.accounts[0];\n      const accountId = matchedAcc ? matchedAcc.id : 'default-cash';\n      const date = input.date || todayStr();\n\n      const record = sanitizeTx({\n        id: makeId('tx'),\n        date,\n        type: input.type,\n        category: input.category,\n        amount: input.amount,\n        account_id: accountId,\n        target_account_id: '',\n        note: input.note || '',\n      });\n      if (!record) return { success: false, status: 'invalid_input' };\n      const nextLedger = [record, ...state.ledger];\n      if (nextLedger.length > MAX_LEDGER) return { success: false, status: 'limit' };\n      const res = await writeDoc(COL_LEDGER, state.revision, { schema_version: 1, items: nextLedger });\n      if (res.status !== 'saved') {\n        return { success: false, status: res.status === 'limit' ? 'limit' : 'conflict' };\n      }\n\n      // Compute updated category budget status\n      const m = date.slice(0, 7);\n      const budgetGoal = state.goals.find(g => g.kind === 'budget' && g.category === record.category);\n      let budgetRatio = 0;\n      let level = 'none';\n      if (budgetGoal && record.type === 'expense') {\n        const spent = nextLedger\n          .filter(t => t.type === 'expense' && t.category === record.category && t.date.startsWith(m))\n          .reduce((s, t) => s + t.amount, 0);\n        budgetRatio = round2((spent / budgetGoal.monthly_limit) * 100);\n        level = budgetLevel(budgetRatio);\n      }\n\n      return {\n        success: true,\n        status: 'recorded',\n        tx_id: record.id,\n        budget_ratio: budgetRatio,\n        budget_level: level,\n      };\n    }\n  }\n\n  throw new Error(`不支持的调用: ${kind}/${contribution}`);\n}\n","path":"backend/index.js"},{"content":"<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>智能财务与资产配置 CFO 系统 · Finance Wealth OS</title>\n<style>\n:root{color-scheme:light dark;--bg:#f3f7f6;--surface:#fff;--surface-2:#f7faf9;--surface-hover:#edf4f2;--fg:#0b1720;--fg-2:#334857;--muted:#647887;--border:#dde7e5;--border-strong:#c4d4d1;--accent:#059669;--accent-2:#10b981;--accent-soft:rgba(5,150,105,.11);--sky:#0284c7;--sky-soft:rgba(2,132,199,.12);--indigo:#4f46e5;--warn:#d97706;--warn-soft:rgba(217,119,6,.14);--danger:#e11d48;--danger-soft:rgba(225,29,72,.12);--shadow-sm:0 1px 2px rgba(11,23,32,.05);--shadow-md:0 8px 24px rgba(11,23,32,.08);--r:12px;--rs:8px;font:13.5px/1.5 -apple-system,BlinkMacSystemFont,\"SF Pro Text\",\"PingFang SC\",\"Segoe UI\",sans-serif}\n:root[data-theme=\"dark\"]{--bg:#081016;--surface:#0f1b24;--surface-2:#14232e;--surface-hover:#1b2f3d;--fg:#eef6f7;--fg-2:#c6d7de;--muted:#8aa0ad;--border:#1e313f;--border-strong:#2d4659;--accent:#10b981;--accent-2:#34d399;--accent-soft:rgba(16,185,129,.17);--sky:#38bdf8;--sky-soft:rgba(56,189,248,.16);--indigo:#818cf8;--warn:#f59e0b;--warn-soft:rgba(245,158,11,.17);--danger:#fb7185;--danger-soft:rgba(251,113,133,.16);--shadow-sm:0 1px 2px rgba(0,0,0,.28);--shadow-md:0 12px 30px rgba(0,0,0,.42)}\n*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--fg);min-height:100vh}.num{font-variant-numeric:tabular-nums}[hidden]{display:none!important}\n.shell{display:grid;grid-template-columns:224px minmax(0,1fr);min-height:100vh}\n.sidebar{background:var(--surface);border-right:1px solid var(--border);padding:16px 12px;display:flex;flex-direction:column;gap:14px;position:sticky;top:0;height:100vh;overflow-y:auto}\n.brand{display:flex;align-items:center;gap:10px;padding:4px 6px 10px;border-bottom:1px solid var(--border)}\n.brand-icon{width:34px;height:34px;border-radius:10px;background:linear-gradient(135deg,var(--accent),var(--sky));display:grid;place-items:center;color:#fff;flex-shrink:0;box-shadow:0 4px 12px rgba(5,150,105,.28)}\n.brand-title{font-weight:750;font-size:14px;letter-spacing:-.01em;line-height:1.25}.brand-sub{font-size:11px;color:var(--muted)}\n.nav{display:flex;flex-direction:column;gap:4px}\n.nav-btn{display:flex;align-items:center;gap:8px;width:100%;padding:9px 10px;border-radius:9px;border:1px solid transparent;background:transparent;color:var(--fg-2);font:inherit;font-weight:500;cursor:pointer;text-align:left;transition:all .15s}\n.nav-btn:hover{background:var(--surface-hover);color:var(--fg)}.nav-btn.active{background:var(--accent-soft);color:var(--accent);border-color:rgba(16,185,129,.26);font-weight:650}\n.nav-badge{margin-left:auto;font-size:11px;font-weight:650;padding:1px 7px;border-radius:999px;background:var(--surface-2);color:var(--muted)}.nav-badge.alert{background:var(--danger-soft);color:var(--danger)}\n.side-footer{margin-top:auto;display:flex;flex-direction:column;gap:6px;padding-top:12px;border-top:1px solid var(--border)}\n.side-tool{width:100%;padding:7px 10px;border-radius:8px;border:1px solid var(--border);background:var(--surface-2);color:var(--fg-2);font:inherit;font-size:12.5px;font-weight:500;cursor:pointer}\n.side-tool:hover{border-color:var(--accent);color:var(--accent);background:var(--accent-soft)}\n.main{padding:16px 20px 28px;display:flex;flex-direction:column;gap:14px;min-width:0}\n.topbar{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px}\n.page-title{font-size:18px;font-weight:750;margin:0;letter-spacing:-.015em}\n.status-pill{font-size:12px;color:var(--muted);background:var(--surface);border:1px solid var(--border);padding:4px 10px;border-radius:999px;display:inline-flex;align-items:center;gap:6px}\n.status-pill[data-error=\"true\"]{color:var(--danger);border-color:var(--danger);background:var(--danger-soft)}\n.dot{width:7px;height:7px;border-radius:50%;background:var(--accent);display:inline-block}.status-pill[data-error=\"true\"] .dot{background:var(--danger)}\n.kpi-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}\n.kpi-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:13px 15px;box-shadow:var(--shadow-sm);display:flex;flex-direction:column;gap:4px;position:relative;overflow:hidden}\n.kpi-card::before{content:\"\";position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--accent)}.kpi-card.danger::before{background:var(--danger)}.kpi-card.sky::before{background:var(--sky)}.kpi-card.indigo::before{background:var(--indigo)}\n.kpi-label{font-size:12px;color:var(--muted);font-weight:500;display:flex;justify-content:space-between;align-items:center}\n.kpi-val{font-size:21px;font-weight:780;letter-spacing:-.02em}.kpi-sub{font-size:11.5px;color:var(--muted)}\n.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:14px 16px;box-shadow:var(--shadow-sm)}\n.card-head{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px;margin-bottom:12px}\n.card-title{font-size:14px;font-weight:700;margin:0;display:flex;align-items:center;gap:7px}.row{display:flex;flex-wrap:wrap;gap:8px;align-items:center}\ninput,select,textarea,button{font:inherit;color:var(--fg);border:1px solid var(--border-strong);border-radius:var(--rs);padding:6px 10px;background:var(--surface);transition:border-color .15s,box-shadow .15s}\ninput:focus,select:focus,textarea:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)}\ntextarea{resize:vertical;min-height:76px;width:100%}\nbutton{cursor:pointer;font-weight:550;display:inline-flex;align-items:center;justify-content:center;gap:5px}\nbutton:hover:not(:disabled){border-color:var(--accent)}button.primary{background:var(--accent);border-color:var(--accent);color:#fff}button.primary:hover:not(:disabled){background:var(--accent-2);border-color:var(--accent-2)}\nbutton.sky{background:var(--sky);border-color:var(--sky);color:#fff}button.ghost{background:transparent;border-color:var(--border);color:var(--fg-2)}button.ghost:hover:not(:disabled){background:var(--surface-hover);color:var(--fg)}\nbutton.danger{color:var(--danger);border-color:rgba(225,29,72,.35);background:var(--danger-soft)}button.sm{padding:4px 8px;font-size:12px;border-radius:6px}button:disabled{opacity:.5;cursor:not-allowed}\n.tag{display:inline-flex;align-items:center;gap:4px;font-size:11.5px;font-weight:650;padding:2px 8px;border-radius:999px;background:var(--surface-2);color:var(--fg-2);border:1px solid var(--border)}\n.tag.ok{background:var(--accent-soft);color:var(--accent);border-color:transparent}.tag.sky{background:var(--sky-soft);color:var(--sky);border-color:transparent}.tag.warn{background:var(--warn-soft);color:var(--warn);border-color:transparent}.tag.danger{background:var(--danger-soft);color:var(--danger);border-color:transparent}\n.grid-2{display:grid;grid-template-columns:1fr 1.15fr;gap:12px}.grid-2-eq{display:grid;grid-template-columns:1fr 1fr;gap:12px}.grid-3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}\n.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.field{display:flex;flex-direction:column;gap:4px;font-size:12.5px;font-weight:600;color:var(--fg-2)}.field.full{grid-column:1/-1}\n.svg-wrap{width:100%;overflow:hidden}.svg-wrap svg{width:100%;height:auto;display:block}\n.table-wrap{overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:13px}\nth,td{padding:9px 10px;text-align:left;border-bottom:1px solid var(--border);white-space:nowrap}\nth{font-size:11.5px;font-weight:650;color:var(--muted);background:var(--surface-2)}tr:hover td{background:var(--surface-hover)}.right{text-align:right}\n.donut-layout{display:grid;grid-template-columns:195px minmax(0,1fr);gap:14px;align-items:center}\n.legend{display:flex;flex-direction:column;gap:7px}.legend-item{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:12.5px}.swatch{width:10px;height:10px;border-radius:3px;flex-shrink:0}\n.budget-item{background:var(--surface-2);border:1px solid var(--border);border-radius:10px;padding:10px 12px;display:flex;flex-direction:column;gap:6px}\n.bar-track{height:8px;border-radius:999px;background:var(--border);overflow:hidden}.bar-fill{height:100%;border-radius:999px;transition:width .25s}\n.bar-fill.ok{background:var(--accent)}.bar-fill.warn{background:var(--warn)}.bar-fill.over{background:var(--danger)}\n.sim-box{background:var(--surface-2);border:1px solid var(--border);border-radius:10px;padding:11px 13px;display:flex;flex-direction:column;gap:3px}\n.sim-box.highlight{border-color:var(--accent);background:var(--accent-soft)}.sim-label{font-size:11.5px;color:var(--muted);font-weight:600}.sim-val{font-size:18px;font-weight:780}.sim-sub{font-size:11.5px;color:var(--fg-2)}\n.scenario-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}\n.scenario-card{text-align:left;padding:11px 12px;border-radius:10px;border:1.5px solid var(--border);background:var(--surface-2);cursor:pointer;display:flex;flex-direction:column;gap:4px}\n.scenario-card:hover{border-color:var(--accent)}.scenario-card.active{border-color:var(--accent);background:var(--accent-soft)}\n.ai-output{white-space:pre-wrap;word-break:break-word;background:var(--surface-2);border:1px solid var(--border);border-radius:10px;padding:14px;font:13.5px/1.65 inherit;max-height:360px;overflow-y:auto;margin:0}\n.modal-backdrop{position:fixed;inset:0;background:rgba(8,16,22,.58);display:grid;place-items:center;padding:16px;z-index:50}\n.modal{width:min(600px,100%);max-height:90vh;overflow-y:auto;background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:18px 20px;box-shadow:var(--shadow-md);display:flex;flex-direction:column;gap:12px}\n@media(max-width:960px){.shell{grid-template-columns:1fr}.sidebar{position:static;height:auto;border-right:none;border-bottom:1px solid var(--border);padding:10px 12px;gap:10px}.nav{flex-direction:row;overflow-x:auto}.nav-btn{width:auto;white-space:nowrap}.side-footer{flex-direction:row;margin-top:0;padding-top:8px}.kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.grid-2,.grid-2-eq,.donut-layout{grid-template-columns:1fr}.scenario-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}\n@media(max-width:560px){.kpi-grid,.grid-3,.form-grid,.scenario-grid{grid-template-columns:1fr}}\n</style>\n</head>\n<body>\n<div class=\"shell\">\n<aside class=\"sidebar\">\n<div class=\"brand\">\n<div class=\"brand-icon\" aria-hidden=\"true\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v10\"/><path d=\"M15 9.5a2.5 2.5 0 0 0-5 0c0 2.5 5 1.8 5 4.5a2.5 2.5 0 0 1-5 0\"/></svg></div>\n<div><div class=\"brand-title\">Finance Wealth OS</div><div class=\"brand-sub\">智能财务与资产配置 CFO</div></div>\n</div>\n<nav class=\"nav\">\n<button type=\"button\" class=\"nav-btn active\" data-view=\"dashboard\"><span>资产负债总览</span><span class=\"nav-badge num\" id=\"badge-acc\">0</span></button>\n<button type=\"button\" class=\"nav-btn\" data-view=\"ledger\"><span>智能账本与预算</span><span class=\"nav-badge num\" id=\"badge-budget\">0</span></button>\n<button type=\"button\" class=\"nav-btn\" data-view=\"fire\"><span>FIRE 复利与房贷</span><span class=\"nav-badge\">引擎</span></button>\n<button type=\"button\" class=\"nav-btn\" data-view=\"cfo\"><span>AI 私人 CFO 诊断</span><span class=\"nav-badge\">AI</span></button>\n</nav>\n<div class=\"side-footer\">\n<button type=\"button\" class=\"side-tool\" id=\"btn-seed\">加载完整财务演示数据</button>\n<button type=\"button\" class=\"side-tool\" id=\"btn-io\">JSON 导入 / 导出</button>\n<button type=\"button\" class=\"side-tool\" id=\"btn-theme\">切换亮/暗主题</button>\n</div>\n</aside>\n<main class=\"main\">\n<header class=\"topbar\">\n<h1 class=\"page-title\" id=\"view-heading\">资产负债总览</h1>\n<div class=\"row\">\n<span class=\"status-pill\" id=\"status-pill\" role=\"status\"><span class=\"dot\"></span><span id=\"status-text\">正在初始化…</span></span>\n<button type=\"button\" class=\"ghost sm\" id=\"btn-refresh\">刷新</button>\n</div>\n</header>\n<section class=\"kpi-grid\">\n<div class=\"kpi-card\"><div class=\"kpi-label\"><span>总资产</span><span class=\"tag ok num\" id=\"kpi-asset-cnt\">0 账户</span></div><div class=\"kpi-val num\" id=\"kpi-assets\">¥0</div><div class=\"kpi-sub\">跨现金/权益/基金/房产/固收</div></div>\n<div class=\"kpi-card danger\"><div class=\"kpi-label\"><span>总负债</span><span class=\"tag danger num\" id=\"kpi-debt-ratio\">负债率 0%</span></div><div class=\"kpi-val num\" id=\"kpi-liab\">¥0</div><div class=\"kpi-sub\">按揭与信用负债合计</div></div>\n<div class=\"kpi-card sky\"><div class=\"kpi-label\"><span>净资产 (Net Worth)</span><span class=\"tag sky\" id=\"kpi-month\">--</span></div><div class=\"kpi-val num\" id=\"kpi-nw\">¥0</div><div class=\"kpi-sub\" id=\"kpi-nw-sub\">本月净结余 ¥0</div></div>\n<div class=\"kpi-card indigo\"><div class=\"kpi-label\"><span>本月储蓄率</span><span class=\"tag warn num\" id=\"kpi-alert-cnt\">0 预警</span></div><div class=\"kpi-val num\" id=\"kpi-savings\">0%</div><div class=\"kpi-sub\" id=\"kpi-flow-sub\">收 ¥0 · 支 ¥0</div></div>\n</section>\n<section id=\"view-dashboard\" class=\"view\">\n<div class=\"card\" style=\"margin-bottom:12px\">\n<div class=\"card-head\" style=\"margin-bottom:8px\">\n<h2 class=\"card-title\">多币种实时参考汇率 (Frankfurter HTTP v2)</h2>\n<div class=\"row\">\n<span class=\"tag\" id=\"fx-meta\">基准币种 CNY · 目标储蓄率 30%</span>\n<button type=\"button\" class=\"sm sky\" id=\"btn-fx-fetch\">刷新实时汇率</button>\n</div>\n</div>\n<div id=\"fx-rates-row\" class=\"row\" style=\"gap:8px;flex-wrap:wrap;font-size:12px;color:var(--muted)\">点击「刷新实时汇率」联网查询外币参考汇率。</div>\n</div>\n<div class=\"grid-2\" style=\"margin-bottom:12px\">\n<div class=\"card\"><div class=\"card-head\"><h2 class=\"card-title\">资产配置环形结构</h2><span class=\"tag\">按资产大类实时占比</span></div><div class=\"donut-layout\"><div class=\"svg-wrap\" id=\"svg-donut\"></div><div class=\"legend\" id=\"donut-legend\"></div></div></div>\n<div class=\"card\"><div class=\"card-head\"><h2 class=\"card-title\">净资产与月度现金流双轨趋势</h2><div class=\"row\" style=\"font-size:11.5px;color:var(--muted)\"><span><strong style=\"color:var(--sky)\">━●━</strong> 净资产</span><span><strong style=\"color:var(--accent)\">■</strong> 收入</span><span><strong style=\"color:var(--danger)\">■</strong> 支出</span></div></div><div class=\"svg-wrap\" id=\"svg-trend\"></div></div>\n</div>\n<div class=\"card\">\n<div class=\"card-head\"><h2 class=\"card-title\">资产与负债账户明细表</h2><button type=\"button\" class=\"primary sm\" id=\"btn-new-acc\">+ 新增账户</button></div>\n<div class=\"table-wrap\"><table><thead><tr><th>账户名称</th><th>类型 / 分类</th><th>所属机构</th><th class=\"right\">参考年化 / 利率</th><th class=\"right\">当前余额</th><th class=\"right\">操作</th></tr></thead><tbody id=\"acc-tbody\"></tbody></table></div>\n</div>\n</section>\n<section id=\"view-ledger\" class=\"view\" hidden>\n<div class=\"grid-2-eq\" style=\"margin-bottom:12px\">\n<div class=\"card\">\n<div class=\"card-head\"><h2 class=\"card-title\">分类月度预算预警</h2><button type=\"button\" class=\"primary sm\" id=\"btn-new-goal\">+ 预算 / 目标</button></div>\n<div style=\"font-size:11.5px;color:var(--muted);margin-bottom:8px\">绿灯 &lt;75% 安全 · 黄灯 75-95% 预警 · 红灯 &gt;95% 超支告警</div>\n<div id=\"budget-list\" style=\"display:flex;flex-direction:column;gap:8px\"></div>\n<div id=\"target-wrap\" style=\"margin-top:12px;padding-top:10px;border-top:1px dashed var(--border)\" hidden>\n<div style=\"font-size:12px;font-weight:700;color:var(--muted);margin-bottom:7px\">长期财务里程碑目标</div>\n<div id=\"target-list\" style=\"display:flex;flex-direction:column;gap:8px\"></div>\n</div>\n</div>\n<div style=\"display:flex;flex-direction:column;gap:12px\">\n<div class=\"card\">\n<div class=\"card-head\"><h2 class=\"card-title\">快速记一笔流水</h2><span class=\"tag\">支持收入 / 支出 / 转账</span></div>\n<div class=\"form-grid\">\n<label class=\"field\">流水类型<select id=\"tx-type\"><option value=\"expense\">支出 (Expense)</option><option value=\"income\">收入 (Income)</option><option value=\"transfer\">账户转账 / 定投</option></select></label>\n<label class=\"field\">收支分类<select id=\"tx-cat\"></select></label>\n<label class=\"field\">金额 (¥) *<input id=\"tx-amt\" type=\"number\" min=\"0.01\" step=\"0.01\" placeholder=\"例如：320\"></label>\n<label class=\"field\">交易日期<input id=\"tx-date\" type=\"date\"></label>\n<label class=\"field\">资金账户<select id=\"tx-acc\"></select></label>\n<label class=\"field\" id=\"tx-target-wrap\" hidden>转入目标账户<select id=\"tx-target-acc\"></select></label>\n<label class=\"field full\">备注<input id=\"tx-note\" maxlength=\"100\" placeholder=\"例如：生鲜商超采购 / 宽基指数定投\"></label>\n</div>\n<div class=\"row\" style=\"margin-top:10px;justify-content:space-between\">\n<label style=\"display:inline-flex;align-items:center;gap:6px;font-size:12.5px;color:var(--fg-2);cursor:pointer\"><input id=\"tx-sync\" type=\"checkbox\" checked style=\"width:auto;padding:0\"> 同步更新账户余额</label>\n<button type=\"button\" class=\"primary\" id=\"btn-tx-add\">记入账本</button>\n</div>\n</div>\n<div class=\"card\"><div class=\"card-head\"><h2 class=\"card-title\">本月支出 Top 榜单</h2><span class=\"tag num\" id=\"top-exp-total\">¥0</span></div><div id=\"top-exp-list\" style=\"display:flex;flex-direction:column;gap:8px\"></div></div>\n</div>\n</div>\n<div class=\"card\">\n<div class=\"card-head\"><h2 class=\"card-title\">收支流水明细</h2><div class=\"row\"><select id=\"tx-filter-type\"><option value=\"\">全部类型</option><option value=\"income\">收入</option><option value=\"expense\">支出</option><option value=\"transfer\">转账</option></select><input id=\"tx-search\" placeholder=\"搜索分类或备注…\" style=\"width:170px\"></div></div>\n<div class=\"table-wrap\"><table><thead><tr><th>日期</th><th>类型</th><th>分类</th><th>账户</th><th>备注</th><th class=\"right\">金额</th><th class=\"right\">操作</th></tr></thead><tbody id=\"tx-tbody\"></tbody></table></div>\n</div>\n</section>\n<section id=\"view-fire\" class=\"view\" hidden>\n<div class=\"card\" style=\"margin-bottom:12px\">\n<div class=\"card-head\"><h2 class=\"card-title\">FIRE 财务自由与复利多场景推演器（后端金融引擎）</h2><div class=\"row\"><button type=\"button\" class=\"ghost sm\" id=\"btn-sync-nw\">一键带入当前净资产</button><button type=\"button\" class=\"primary sm\" id=\"btn-run-sim\">重新计算</button></div></div>\n<div class=\"grid-3\" style=\"margin-bottom:12px\">\n<label class=\"field\">当前净资产 (¥)<input id=\"sim-nw\" type=\"number\" step=\"10000\" value=\"1700000\"></label>\n<label class=\"field\">每月定投金额 (¥)<input id=\"sim-monthly\" type=\"number\" step=\"500\" value=\"18000\"></label>\n<label class=\"field\">基准年化收益率 (%)<input id=\"sim-ret\" type=\"number\" step=\"0.5\" min=\"0\" max=\"35\" value=\"8\"></label>\n<label class=\"field\">年均通胀率 (%)<input id=\"sim-inf\" type=\"number\" step=\"0.2\" min=\"0\" max=\"15\" value=\"2.5\"></label>\n<label class=\"field\">目标年支出 (¥)<input id=\"sim-exp\" type=\"number\" step=\"5000\" value=\"220000\"></label>\n<label class=\"field\">安全提取率 SWR (%)<input id=\"sim-swr\" type=\"number\" step=\"0.2\" min=\"2\" max=\"8\" value=\"4\"></label>\n</div>\n<div class=\"grid-3\" style=\"margin-bottom:12px\" id=\"fire-cards\"></div>\n<div class=\"card-head\" style=\"margin-bottom:6px\"><h3 class=\"card-title\">20 年实值购买力三档增长曲线（保守 / 基准 / 乐观）</h3><span class=\"tag sky num\" id=\"fire-target-badge\">FIRE 目标：¥0</span></div>\n<div class=\"svg-wrap\" id=\"svg-fire\"></div>\n</div>\n<div class=\"card\">\n<div class=\"card-head\"><h2 class=\"card-title\">房贷等额本息 vs 提前还款省息测算器</h2><span class=\"tag\">精确逐月摊还引擎</span></div>\n<div class=\"grid-3\" style=\"margin-bottom:12px\">\n<label class=\"field\">原贷款本金 (¥)<input id=\"mg-principal\" type=\"number\" step=\"50000\" value=\"1500000\"></label>\n<label class=\"field\">贷款年利率 (%)<input id=\"mg-rate\" type=\"number\" step=\"0.05\" value=\"3.45\"></label>\n<label class=\"field\">原贷款总年限 (年)<input id=\"mg-years\" type=\"number\" min=\"1\" max=\"40\" value=\"30\"></label>\n<label class=\"field\">已还期数 (月)<input id=\"mg-paid\" type=\"number\" min=\"0\" max=\"479\" value=\"60\"></label>\n<label class=\"field\">计划提前还款额 (¥)<input id=\"mg-prepay\" type=\"number\" step=\"10000\" value=\"300000\"></label>\n<label class=\"field\">提前还款方式<select id=\"mg-mode\"><option value=\"reduce_term\">月供不变 · 缩短年限（最省息）</option><option value=\"reduce_payment\">年限不变 · 减少月供（降压）</option></select></label>\n</div>\n<div class=\"grid-3\" id=\"mortgage-cards\"></div>\n</div>\n</section>\n<section id=\"view-cfo\" class=\"view\" hidden>\n<div class=\"card\" style=\"display:flex;flex-direction:column;gap:14px\">\n<div class=\"card-head\" style=\"margin-bottom:0\"><h2 class=\"card-title\">私人 CFO 财务诊断模板与提示词台</h2><span class=\"tag ok\">本地诊断模板 · 可协同工作台聊天 / AI 伴生插件</span></div>\n<div class=\"sim-box\" id=\"cfo-context\" style=\"font-size:12.5px;line-height:1.65;color:var(--fg-2);white-space:pre-line\"></div>\n<div>\n<div style=\"font-size:12.5px;font-weight:700;margin-bottom:7px;color:var(--fg-2)\">选择 CFO 专项财务诊断维度</div>\n<div class=\"scenario-grid\" id=\"cfo-scenarios\">\n<button type=\"button\" class=\"scenario-card active\" data-sc=\"rebalance\"><strong style=\"font-size:13px\">资产再平衡方案</strong><span style=\"font-size:11.5px;color:var(--muted)\">诊断权益/固收/房产/现金集中度风险，输出分步调仓建议</span></button>\n<button type=\"button\" class=\"scenario-card\" data-sc=\"cashflow\"><strong style=\"font-size:13px\">节流与预算优化</strong><span style=\"font-size:11.5px;color:var(--muted)\">拆解超支与黄灯分类、优化储蓄率与现金流防线</span></button>\n<button type=\"button\" class=\"scenario-card\" data-sc=\"debt\"><strong style=\"font-size:13px\">负债与提前还贷决策</strong><span style=\"font-size:11.5px;color:var(--muted)\">对比房贷利率与组合预期收益，评估还贷 vs 定投最优解</span></button>\n<button type=\"button\" class=\"scenario-card\" data-sc=\"tax_fire\"><strong style=\"font-size:13px\">税务筹划与 FIRE 加速</strong><span style=\"font-size:11.5px;color:var(--muted)\">结合净资产与储蓄率制定年度税务优化与 FIRE 加速路线</span></button>\n</div>\n</div>\n<label class=\"field\">补充个人目标或约束（可选）<input id=\"cfo-extra\" maxlength=\"200\" placeholder=\"例如：3 年内有子女教育大额支出，偏好中等偏稳健风险\"></label>\n<div class=\"row\">\n<button type=\"button\" class=\"primary\" id=\"btn-cfo-draft\">生成本地结构化 CFO 诊断报告</button>\n<button type=\"button\" class=\"ghost\" id=\"btn-cfo-prompt\">复制 AI 诊断提示词</button>\n<span id=\"cfo-state\" style=\"font-size:12.5px;color:var(--muted)\"></span>\n</div>\n<div id=\"cfo-result-box\" hidden style=\"display:flex;flex-direction:column;gap:10px;padding-top:10px;border-top:1px dashed var(--border)\">\n<pre class=\"ai-output\" id=\"cfo-output\"></pre>\n<div class=\"row\">\n<button type=\"button\" class=\"primary sm\" id=\"btn-cfo-insert\">一键插入会话输入框</button>\n<button type=\"button\" class=\"sky sm\" id=\"btn-cfo-save\">核对并保存为 CFO 备忘</button>\n<button type=\"button\" class=\"ghost sm\" id=\"btn-cfo-copy\">复制报告</button>\n</div>\n</div>\n<div id=\"cfo-saved-wrap\" hidden style=\"padding-top:10px;border-top:1px solid var(--border)\">\n<div style=\"font-size:12.5px;font-weight:700;margin-bottom:6px;color:var(--muted)\">已保存的 CFO 诊断备忘</div>\n<pre class=\"ai-output\" id=\"cfo-saved-memo\" style=\"max-height:200px\"></pre>\n</div>\n</div>\n</section>\n</main>\n</div>\n<div class=\"modal-backdrop\" id=\"modal-acc\" hidden><div class=\"modal\">\n<div class=\"card-head\" style=\"margin-bottom:0\"><h2 class=\"card-title\" id=\"m-acc-title\">新增资产/负债账户</h2><button type=\"button\" class=\"ghost sm\" data-close=\"modal-acc\">关闭</button></div>\n<div class=\"form-grid\">\n<label class=\"field\">账户名称 *<input id=\"m-acc-name\" maxlength=\"48\"></label>\n<label class=\"field\">账户性质<select id=\"m-acc-kind\"><option value=\"asset\">资产账户 (Asset)</option><option value=\"liability\">负债账户 (Liability)</option></select></label>\n<label class=\"field\">资产大类<select id=\"m-acc-cls\"><option value=\"cash\">现金与货币</option><option value=\"equity\">股票权益</option><option value=\"fund\">指数与基金</option><option value=\"real_estate\">房产不动产</option><option value=\"fixed_income\">债券与固收</option><option value=\"other\">其他资产</option><option value=\"debt\">按揭与负债</option></select></label>\n<label class=\"field\">当前余额 (¥) *<input id=\"m-acc-bal\" type=\"number\" min=\"0\" step=\"100\" value=\"100000\"></label>\n<label class=\"field\">参考年化 / 利率 (%)<input id=\"m-acc-apy\" type=\"number\" step=\"0.1\" value=\"3.5\"></label>\n<label class=\"field\">所属机构<input id=\"m-acc-inst\" maxlength=\"36\"></label>\n<label class=\"field full\">备注<input id=\"m-acc-note\" maxlength=\"120\"></label>\n</div>\n<div class=\"row\" style=\"justify-content:flex-end\"><button type=\"button\" class=\"ghost\" data-close=\"modal-acc\">取消</button><button type=\"button\" class=\"primary\" id=\"btn-m-acc-save\">保存账户</button></div>\n</div></div>\n<div class=\"modal-backdrop\" id=\"modal-goal\" hidden><div class=\"modal\">\n<div class=\"card-head\" style=\"margin-bottom:0\"><h2 class=\"card-title\">新增月度预算 / 财务目标</h2><button type=\"button\" class=\"ghost sm\" data-close=\"modal-goal\">关闭</button></div>\n<div class=\"form-grid\">\n<label class=\"field\">类型<select id=\"m-goal-kind\"><option value=\"budget\">分类月度预算上限</option><option value=\"target\">长期储蓄 / 资产目标</option></select></label>\n<label class=\"field\">关联分类<select id=\"m-goal-cat\"></select></label>\n<label class=\"field\">显示名称 *<input id=\"m-goal-label\" maxlength=\"48\" placeholder=\"例如：餐饮月度预算\"></label>\n<label class=\"field\">预算上限 / 目标金额 (¥) *<input id=\"m-goal-limit\" type=\"number\" min=\"1\" value=\"4000\"></label>\n<label class=\"field\">已达成金额 (目标用)<input id=\"m-goal-saved\" type=\"number\" min=\"0\" value=\"0\"></label>\n<label class=\"field\">目标日期 (可选)<input id=\"m-goal-date\" type=\"date\"></label>\n</div>\n<div class=\"row\" style=\"justify-content:flex-end\"><button type=\"button\" class=\"ghost\" data-close=\"modal-goal\">取消</button><button type=\"button\" class=\"primary\" id=\"btn-m-goal-save\">保存设置</button></div>\n</div></div>\n<div class=\"modal-backdrop\" id=\"modal-io\" hidden><div class=\"modal\">\n<div class=\"card-head\" style=\"margin-bottom:0\"><h2 class=\"card-title\">财务数据导入与导出（document.*）</h2><button type=\"button\" class=\"ghost sm\" data-close=\"modal-io\">关闭</button></div>\n<div class=\"row\"><select id=\"io-select\" style=\"flex:1\"></select><button type=\"button\" class=\"primary sm\" id=\"btn-io-export\">导出 JSON</button></div>\n<label class=\"field\">JSON 数据内容<textarea id=\"io-text\" style=\"min-height:170px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px\"></textarea></label>\n<div class=\"row\" style=\"justify-content:space-between\"><span id=\"io-msg\" style=\"font-size:12px;color:var(--muted)\"></span><div class=\"row\"><button type=\"button\" class=\"ghost sm\" id=\"btn-io-copy\">复制 JSON</button><button type=\"button\" class=\"primary sm\" id=\"btn-io-import\">校验并导入</button></div></div>\n</div></div>\n<script>\n(() => {\nconst plugin = globalThis.nmasPlugin;\nconst $ = id => document.getElementById(id);\nconst on = (id, ev, fn) => $(id).addEventListener(ev, fn);\nconst CLASS_META = {\ncash: { label: '现金与货币', color: '#059669' }, equity: { label: '股票权益', color: '#4f46e5' },\nfund: { label: '指数与基金', color: '#0284c7' }, real_estate: { label: '房产不动产', color: '#d97706' },\nfixed_income: { label: '国债与固收', color: '#0d9488' }, other: { label: '其他资产', color: '#7c3aed' },\ndebt: { label: '负债按揭', color: '#e11d48' },\n};\nconst CAT_LABEL = {\nsalary: '薪资收入', bonus: '奖金副业', dividend: '股息分红', housing: '居住月供', food: '餐饮美食',\ntransport: '交通出行', health: '医疗健康', shopping: '购物数码', education: '学习成长',\nentertainment: '休闲娱乐', travel: '差旅度假', invest: '投资定投', other: '其他',\n};\nconst VIEW_TITLE = { dashboard: '资产负债总览', ledger: '智能账本与预算预警', fire: 'FIRE 复利推演与房贷省息引擎', cfo: 'AI 私人 CFO 财务诊断' };\nlet state = { revision: 0, month: '', accounts: [], ledger: [], goals: [], summary: null, allocation: [], budgets: [], top_expenses: [], trend: [], cfo_memo: '' };\nlet simResult = null, editingAccId = null, activeScenario = 'rebalance', canInsert = false, pendingWorkId = null, latestCfoText = '', busy = false;\nconst today = () => new Date().toISOString().slice(0, 10);\nconst esc = s => String(s ?? '').replace(/[&<>\"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]));\nconst fmtWan = n => { const v = Number(n) || 0, a = Math.abs(v), s = v < 0 ? '-' : ''; return a >= 1e8 ? `${s}¥${(a/1e8).toFixed(2)}亿` : a >= 1e4 ? `${s}¥${(a/1e4).toFixed(a>=1e6?1:2)}万` : `${s}¥${Math.round(a).toLocaleString('zh-CN')}`; };\nconst fmtFull = n => `${Number(n) < 0 ? '-' : ''}¥${Math.round(Math.abs(Number(n) || 0)).toLocaleString('zh-CN')}`;\nconst setStatus = (msg, err = false) => { $('status-text').textContent = msg; $('status-pill').dataset.error = String(err); };\nconst runBusy = async fn => { if (busy) return; busy = true; try { await fn(); } catch (e) { setStatus(`操作失败：${e?.message || '未知错误'}`, true); } finally { busy = false; } };\nconst uuid = () => { const b = crypto.getRandomValues(new Uint8Array(16)); b[6] = (b[6] & 15) | 64; b[8] = (b[8] & 63) | 128; const h = Array.from(b, x => x.toString(16).padStart(2, '0')).join(''); return `${h.slice(0,8)}-${h.slice(8,12)}-${h.slice(12,16)}-${h.slice(16,20)}-${h.slice(20)}`; };\nconst mkBtn = (text, cls, fn) => { const b = document.createElement('button'); b.type = 'button'; b.className = cls; b.textContent = text; b.addEventListener('click', fn); return b; };\nfunction initCats() {\nconst opts = Object.entries(CAT_LABEL).map(([k, v]) => `<option value=\"${k}\">${v}</option>`).join('');\n$('tx-cat').innerHTML = opts; $('tx-cat').value = 'food';\n$('m-goal-cat').innerHTML = opts; $('m-goal-cat').value = 'food';\nif (!$('tx-date').value) $('tx-date').value = today();\n}\nfunction switchView(view) {\n$('view-heading').textContent = VIEW_TITLE[view] || view;\ndocument.querySelectorAll('.nav-btn').forEach(b => b.classList.toggle('active', b.dataset.view === view));\ndocument.querySelectorAll('.view').forEach(el => { el.hidden = el.id !== `view-${view}`; });\nif (view === 'fire' && !simResult) void runSimulation();\nif (view === 'cfo') renderCfoContext();\n}\nasync function loadSnapshot() {\nif (typeof plugin?.action !== 'function') { setStatus('请在 Velai Desktop 中打开此插件', true); return; }\ntry {\nconst caps = await plugin.action('host.capabilities', {}).catch(() => ({ actions: [] }));\ncanInsert = Array.isArray(caps?.actions) && caps.actions.includes('host.draft.insert');\nstate = await plugin.action('finance.snapshot', {});\nrenderAll();\nsetStatus(`已同步 · ${state.accounts.length} 账户 · ${state.ledger.length} 流水 · Rev #${state.revision}`);\n} catch (e) { setStatus(`加载失败：${e?.message || '未知错误'}`, true); }\n}\nfunction renderAll() {\nrenderKpis(); renderDonutSvg(); renderTrendSvg(); renderAccountsTable();\nrenderBudgets(); renderTxFormAccounts(); renderTopExpenses(); renderLedgerTable(); renderCfoContext();\n}\nfunction renderKpis() {\nconst s = state.summary || { total_assets: 0, total_liabilities: 0, net_worth: 0, debt_ratio: 0, monthly_income: 0, monthly_expense: 0, monthly_surplus: 0, savings_rate: 0, over_budget_count: 0, warn_budget_count: 0 };\n$('kpi-assets').textContent = fmtWan(s.total_assets);\n$('kpi-asset-cnt').textContent = `${state.accounts.filter(a => a.kind === 'asset').length} 资产账户`;\n$('kpi-liab').textContent = fmtWan(s.total_liabilities);\n$('kpi-debt-ratio').textContent = `负债率 ${s.debt_ratio}%`;\n$('kpi-nw').textContent = fmtWan(s.net_worth);\n$('kpi-month').textContent = state.month || '--';\n$('kpi-nw-sub').textContent = `本月净结余 ${fmtFull(s.monthly_surplus)}`;\n$('kpi-savings').textContent = `${s.savings_rate}%`;\nconst alerts = s.over_budget_count + s.warn_budget_count;\n$('kpi-alert-cnt').textContent = s.over_budget_count > 0 ? `${s.over_budget_count} 超支 / ${s.warn_budget_count} 预警` : `${alerts} 预警`;\n$('kpi-alert-cnt').className = `tag num ${s.over_budget_count > 0 ? 'danger' : (s.warn_budget_count > 0 ? 'warn' : 'ok')}`;\n$('kpi-flow-sub').textContent = `收 ${fmtFull(s.monthly_income)} · 支 ${fmtFull(s.monthly_expense)}`;\n$('badge-acc').textContent = String(state.accounts.length);\n$('badge-budget').textContent = String(alerts || state.budgets.length);\n$('badge-budget').classList.toggle('alert', s.over_budget_count > 0);\nif (state.settings && $('fx-meta')) {\n$('fx-meta').textContent = `基准币种 ${state.settings.base_currency} · 目标储蓄率 ${state.settings.target_savings_pct}%`;\n}\n}\nfunction renderDonutSvg() {\nconst alloc = state.allocation || [], total = state.summary?.total_assets || 0;\nconst size = 190, cx = 95, cy = 95, r = 68, circ = 2 * Math.PI * r;\nlet offset = 0, arcs = `<circle cx=\"${cx}\" cy=\"${cy}\" r=\"${r}\" fill=\"none\" stroke=\"var(--border)\" stroke-width=\"22\"/>`;\nfor (const item of alloc) {\nconst meta = CLASS_META[item.asset_class] || CLASS_META.other;\nconst len = total > 0 ? (item.amount / total) * circ : 0;\narcs += `<circle cx=\"${cx}\" cy=\"${cy}\" r=\"${r}\" fill=\"none\" stroke=\"${meta.color}\" stroke-width=\"22\" stroke-dasharray=\"${Math.max(1,len-1.5).toFixed(2)} ${circ.toFixed(2)}\" stroke-dashoffset=\"${(-offset).toFixed(2)}\" transform=\"rotate(-90 ${cx} ${cy})\"><title>${esc(meta.label)}：${esc(fmtFull(item.amount))} (${item.share}%)</title></circle>`;\noffset += len;\n}\n$('svg-donut').innerHTML = `<svg viewBox=\"0 0 ${size} ${size}\" role=\"img\" aria-label=\"资产配置环形饼图\">${arcs}<text x=\"${cx}\" y=\"${cy-4}\" text-anchor=\"middle\" fill=\"var(--muted)\" font-size=\"10.5\">总资产</text><text x=\"${cx}\" y=\"${cy+15}\" text-anchor=\"middle\" fill=\"var(--fg)\" font-size=\"14.5\" font-weight=\"800\">${esc(fmtWan(total))}</text></svg>`;\nconst leg = $('donut-legend'); leg.replaceChildren();\nif (!alloc.length) { leg.innerHTML = `<div style=\"font-size:12.5px;color:var(--muted)\">暂无资产数据，点击左下角「加载完整财务演示数据」即可体验。</div>`; return; }\nfor (const item of alloc) {\nconst meta = CLASS_META[item.asset_class] || CLASS_META.other;\nleg.insertAdjacentHTML('beforeend', `<div class=\"legend-item\"><span class=\"row\" style=\"gap:7px\"><span class=\"swatch\" style=\"background:${meta.color}\"></span><strong>${esc(meta.label)}</strong></span><span class=\"num\" style=\"color:var(--fg-2)\">${esc(fmtWan(item.amount))} <span style=\"color:var(--muted)\">(${item.share}%)</span></span></div>`);\n}\n}\nfunction renderTrendSvg() {\nconst trend = state.trend || [];\nif (!trend.length) { $('svg-trend').innerHTML = `<div style=\"padding:46px 12px;text-align:center;color:var(--muted)\">暂无月度趋势数据</div>`; return; }\nconst W = 460, H = 216, padL = 54, padR = 46, padT = 20, padB = 30, cW = W - padL - padR, cH = H - padT - padB;\nconst maxFlow = Math.max(...trend.map(t => Math.max(t.income, t.expense)), 10000) * 1.15;\nconst nws = trend.map(t => t.net_worth), minNw = Math.min(...nws), maxNw = Math.max(...nws);\nconst span = Math.max(maxNw - minNw, Math.abs(maxNw) * 0.08, 10000), nwF = minNw - span * 0.25, nwC = maxNw + span * 0.2;\nlet svg = '';\nfor (let i = 0; i <= 3; i++) {\nconst y = padT + cH - (cH * i) / 3;\nsvg += `<line x1=\"${padL}\" y1=\"${y}\" x2=\"${W-padR}\" y2=\"${y}\" stroke=\"var(--border)\" stroke-dasharray=\"${i?'3 3':''}\"/>`\n+ `<text x=\"${padL-6}\" y=\"${y+4}\" text-anchor=\"end\" fill=\"var(--sky)\" font-size=\"10\">${esc(fmtWan(nwF+((nwC-nwF)*i)/3))}</text>`\n+ `<text x=\"${W-padR+5}\" y=\"${y+4}\" fill=\"var(--muted)\" font-size=\"10\">${esc(fmtWan((maxFlow*i)/3))}</text>`;\n}\nconst step = cW / trend.length, pts = [];\ntrend.forEach((t, i) => {\nconst cx = padL + i * step + step / 2, bw = Math.min(14, step * 0.22);\nconst hi = (t.income / maxFlow) * cH, he = (t.expense / maxFlow) * cH;\nsvg += `<rect x=\"${(cx-bw-1.5).toFixed(1)}\" y=\"${(padT+cH-hi).toFixed(1)}\" width=\"${bw}\" height=\"${Math.max(2,hi).toFixed(1)}\" rx=\"3\" fill=\"var(--accent)\" opacity=\".72\"><title>${esc(t.month)} 收入：${esc(fmtFull(t.income))}</title></rect>`\n+ `<rect x=\"${(cx+1.5).toFixed(1)}\" y=\"${(padT+cH-he).toFixed(1)}\" width=\"${bw}\" height=\"${Math.max(2,he).toFixed(1)}\" rx=\"3\" fill=\"var(--danger)\" opacity=\".65\"><title>${esc(t.month)} 支出：${esc(fmtFull(t.expense))}</title></rect>`\n+ `<text x=\"${cx.toFixed(1)}\" y=\"${H-10}\" text-anchor=\"middle\" fill=\"var(--muted)\" font-size=\"10.5\">${esc(t.month.slice(2))}</text>`;\npts.push({ x: cx, y: padT + cH - ((t.net_worth - nwF) / (nwC - nwF)) * cH, t });\n});\nsvg += `<path d=\"${pts.map((p, i) => `${i?'L':'M'}${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ')}\" fill=\"none\" stroke=\"var(--sky)\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>`;\nfor (const p of pts) svg += `<circle cx=\"${p.x.toFixed(1)}\" cy=\"${p.y.toFixed(1)}\" r=\"4\" fill=\"var(--surface)\" stroke=\"var(--sky)\" stroke-width=\"2.3\"><title>${esc(p.t.month)} 净资产：${esc(fmtFull(p.t.net_worth))}</title></circle>`;\n$('svg-trend').innerHTML = `<svg viewBox=\"0 0 ${W} ${H}\" role=\"img\" aria-label=\"净资产与现金流双轨趋势图\">${svg}</svg>`;\n}\nfunction renderAccountsTable() {\nconst tbody = $('acc-tbody'); tbody.replaceChildren();\nif (!state.accounts.length) { tbody.innerHTML = `<tr><td colspan=\"6\" style=\"text-align:center;color:var(--muted);padding:22px\">暂无账户记录</td></tr>`; return; }\nconst sorted = [...state.accounts].sort((a, b) => (a.kind === b.kind ? b.balance - a.balance : (a.kind === 'asset' ? -1 : 1)));\nfor (const a of sorted) {\nconst meta = CLASS_META[a.asset_class] || CLASS_META.other;\nconst tr = document.createElement('tr');\ntr.innerHTML = `<td><strong>${esc(a.name)}</strong>${a.note ? `<div style=\"font-size:11.5px;color:var(--muted)\">${esc(a.note)}</div>` : ''}</td>`\n+ `<td><span class=\"tag ${a.kind==='liability'?'danger':'ok'}\">${a.kind==='liability'?'负债':'资产'} · ${esc(meta.label)}</span></td>`\n+ `<td style=\"color:var(--fg-2)\">${esc(a.institution||'—')}</td><td class=\"right num\">${a.apy}%</td>`\n+ `<td class=\"right num\" style=\"font-weight:700;color:${a.kind==='liability'?'var(--danger)':'var(--fg)'}\">${a.kind==='liability'?'-':''}${esc(fmtFull(a.balance))}</td><td class=\"right\"></td>`;\nconst td = tr.lastElementChild;\nconst b1 = mkBtn('编辑', 'ghost sm', () => openAccModal(a));\nconst b2 = mkBtn('删除', 'ghost sm', () => runBusy(async () => {\nconst res = await plugin.action('finance.account.delete', { expected_revision: state.revision, id: a.id });\nif (res.status === 'deleted') { await loadSnapshot(); setStatus('已删除账户'); } else setStatus(`删除失败：${res.status}`, true);\n})); b2.style.marginLeft = '4px';\ntd.append(b1, b2); tbody.appendChild(tr);\n}\n}\nfunction renderBudgets() {\nconst bBox = $('budget-list'); bBox.replaceChildren();\nif (!state.budgets.length) bBox.innerHTML = `<div style=\"font-size:12.5px;color:var(--muted);padding:12px 0\">暂未设置分类月度预算</div>`;\nconst delGoal = id => runBusy(async () => {\nconst res = await plugin.action('finance.goal.delete', { expected_revision: state.revision, id });\nif (res.status === 'deleted') { await loadSnapshot(); setStatus('已删除预算/目标'); } else setStatus(`删除失败：${res.status}`, true);\n});\nfor (const b of state.budgets) {\nconst txt = b.level === 'over' ? '红灯超支' : b.level === 'warn' ? '黄灯预警' : '安全';\nconst cls = b.level === 'over' ? 'danger' : b.level === 'warn' ? 'warn' : 'ok';\nconst card = document.createElement('div'); card.className = 'budget-item';\ncard.innerHTML = `<div class=\"row\" style=\"justify-content:space-between\"><div class=\"row\"><strong>${esc(b.label)}</strong><span class=\"tag\">${esc(CAT_LABEL[b.category]||b.category)}</span></div><div class=\"row\"><span class=\"tag ${cls} num\">${txt} ${b.ratio}%</span><button type=\"button\" class=\"ghost sm\" data-dg>x</button></div></div><div class=\"bar-track\"><div class=\"bar-fill ${b.level}\" style=\"width:${Math.min(100,b.ratio)}%\"></div></div><div class=\"row\" style=\"justify-content:space-between;font-size:12px;color:var(--muted)\"><span class=\"num\">已用 ${esc(fmtFull(b.spent))}</span><span class=\"num\">月度预算 ${esc(fmtFull(b.limit))}</span></div>`;\ncard.querySelector('[data-dg]').addEventListener('click', () => delGoal(b.id));\nbBox.appendChild(card);\n}\nconst targets = state.goals.filter(g => g.kind === 'target');\n$('target-wrap').hidden = !targets.length;\nconst tBox = $('target-list'); tBox.replaceChildren();\nfor (const t of targets) {\nconst pct = Math.min(100, Math.round((t.current_saved / t.monthly_limit) * 100));\nconst card = document.createElement('div'); card.className = 'budget-item';\ncard.innerHTML = `<div class=\"row\" style=\"justify-content:space-between\"><strong>${esc(t.label)}</strong><div class=\"row\"><span class=\"tag sky num\">${pct}%</span><button type=\"button\" class=\"ghost sm\" data-dt>x</button></div></div><div class=\"bar-track\"><div class=\"bar-fill ok\" style=\"width:${pct}%\"></div></div><div class=\"row\" style=\"justify-content:space-between;font-size:12px;color:var(--muted)\"><span class=\"num\">${esc(fmtWan(t.current_saved))} / ${esc(fmtWan(t.monthly_limit))}</span><span>${esc(t.target_date||'长期目标')}</span></div>`;\ncard.querySelector('[data-dt]').addEventListener('click', () => delGoal(t.id));\ntBox.appendChild(card);\n}\n}\nfunction renderTxFormAccounts() {\nconst opts = state.accounts.length ? state.accounts.map(a => `<option value=\"${esc(a.id)}\">${esc(a.name)}</option>`).join('') : `<option value=\"default-cash\">默认现金账户</option>`;\n$('tx-acc').innerHTML = opts; $('tx-target-acc').innerHTML = opts;\n}\nfunction renderTopExpenses() {\nconst list = state.top_expenses || [];\n$('top-exp-total').textContent = fmtFull(state.summary?.monthly_expense || 0);\nconst box = $('top-exp-list'); box.replaceChildren();\nif (!list.length) { box.innerHTML = `<div style=\"font-size:12.5px;color:var(--muted)\">本月暂无支出记录</div>`; return; }\nconst maxAmt = Math.max(...list.map(x => x.amount), 1);\nfor (const item of list) {\nbox.insertAdjacentHTML('beforeend', `<div><div class=\"row\" style=\"justify-content:space-between;font-size:12.5px;margin-bottom:3px\"><strong>${esc(CAT_LABEL[item.category]||item.category)}</strong><span class=\"num\">${esc(fmtFull(item.amount))} <span style=\"color:var(--muted)\">(${item.share}%)</span></span></div><div class=\"bar-track\"><div class=\"bar-fill\" style=\"width:${Math.max(4,Math.round((item.amount/maxAmt)*100))}%;background:linear-gradient(90deg,var(--sky),var(--indigo))\"></div></div></div>`);\n}\n}\nfunction renderLedgerTable() {\nconst tf = $('tx-filter-type').value, kw = $('tx-search').value.trim().toLowerCase();\nconst accMap = new Map(state.accounts.map(a => [a.id, a.name]));\nconst rows = [...state.ledger].filter(t => (!tf || t.type === tf) && (!kw || `${CAT_LABEL[t.category]||t.category} ${t.note} ${accMap.get(t.account_id)||''}`.toLowerCase().includes(kw))).sort((a, b) => b.date.localeCompare(a.date));\nconst tbody = $('tx-tbody'); tbody.replaceChildren();\nif (!rows.length) { tbody.innerHTML = `<tr><td colspan=\"7\" style=\"text-align:center;color:var(--muted);padding:20px\">暂无符合条件的流水</td></tr>`; return; }\nconst tl = { income: '收入', expense: '支出', transfer: '转账' }, tt = { income: 'ok', expense: 'danger', transfer: 'sky' };\nfor (const t of rows) {\nconst tr = document.createElement('tr');\nconst sign = t.type === 'income' ? '+' : t.type === 'expense' ? '-' : '⇄ ';\nconst accTxt = t.type === 'transfer' && t.target_account_id ? `${accMap.get(t.account_id)||t.account_id} → ${accMap.get(t.target_account_id)||t.target_account_id}` : (accMap.get(t.account_id)||t.account_id);\ntr.innerHTML = `<td class=\"num\">${esc(t.date)}</td><td><span class=\"tag ${tt[t.type]}\">${tl[t.type]}</span></td><td>${esc(CAT_LABEL[t.category]||t.category)}</td><td style=\"color:var(--fg-2)\">${esc(accTxt)}</td><td style=\"color:var(--muted)\">${esc(t.note||'—')}</td><td class=\"right num\" style=\"font-weight:700;color:${t.type==='income'?'var(--accent)':t.type==='expense'?'var(--danger)':'var(--sky)'}\">${sign}${esc(fmtFull(t.amount))}</td><td class=\"right\"></td>`;\ntr.lastElementChild.appendChild(mkBtn('删除', 'ghost sm', () => runBusy(async () => {\nconst res = await plugin.action('finance.tx.delete', { expected_revision: state.revision, id: t.id });\nif (res.status === 'deleted') { await loadSnapshot(); setStatus('已删除流水'); } else setStatus(`删除失败：${res.status}`, true);\n})));\ntbody.appendChild(tr);\n}\n}\nasync function runSimulation() {\nif (typeof plugin?.action !== 'function') return;\ntry {\nconst res = await plugin.action('finance.simulate', {\ncurrent_net_worth: Number($('sim-nw').value) || 0,\nmonthly_invest: Math.max(0, Number($('sim-monthly').value) || 0),\nexpected_return: Math.max(0, Math.min(40, Number($('sim-ret').value) || 0)),\ninflation: Math.max(0, Math.min(20, Number($('sim-inf').value) || 0)),\nannual_expense: Math.max(1000, Number($('sim-exp').value) || 100000),\nswr: Math.max(2, Math.min(10, Number($('sim-swr').value) || 4)),\nyears: 20,\nmortgage: {\nprincipal: Math.max(10000, Number($('mg-principal').value) || 1000000),\nannual_rate: Math.max(0.1, Math.min(25, Number($('mg-rate').value) || 3.45)),\ntotal_years: Math.max(1, Math.min(40, Math.round(Number($('mg-years').value) || 30))),\npaid_months: Math.max(0, Math.min(479, Math.round(Number($('mg-paid').value) || 0))),\nprepay_amount: Math.max(0, Number($('mg-prepay').value) || 0),\nmode: $('mg-mode').value,\n},\n});\nsimResult = res; renderFireResult(res); renderMortgageResult(res.mortgage_result);\n} catch (e) { setStatus(`金融推演失败：${e?.message || '参数超限'}`, true); }\n}\nfunction renderFireResult(res) {\n$('fire-target-badge').textContent = `FIRE 实值目标：${fmtWan(res.fire_target)}`;\nconst defs = [{ k: 'conservative', t: '保守情景', c: '#d97706', cls: '' }, { k: 'base', t: '基准情景', c: '#059669', cls: 'highlight' }, { k: 'optimistic', t: '乐观情景', c: '#4f46e5', cls: '' }];\n$('fire-cards').innerHTML = defs.map(d => {\nconst it = res.scenarios[d.k];\nconst ft = it.years_to_fire === 0 ? '已达成 FIRE' : it.years_to_fire > 0 ? `${it.fire_year} 年达成（${it.years_to_fire} 年后）` : '80 年内未达标';\nreturn `<div class=\"sim-box ${d.cls}\"><div class=\"sim-label\" style=\"color:${d.c}\">${d.t}（名义 ${it.rate}% / 实值 ${it.real_rate}%）</div><div class=\"sim-val num\">${esc(fmtWan(it.final_real))}</div><div class=\"sim-sub\">20 年末实值资产 · <strong>${esc(ft)}</strong></div></div>`;\n}).join('');\nconst series = res.series || [], W = 720, H = 260, padL = 62, padR = 24, padT = 22, padB = 34, cW = W - padL - padR, cH = H - padT - padB;\nconst maxV = Math.max(res.fire_target * 1.15, ...series.map(p => p.optimistic), 100000), minV = Math.min(0, ...series.map(p => p.conservative)), span = Math.max(maxV - minV, 1);\nconst toX = i => padL + (i / Math.max(1, series.length - 1)) * cW, toY = v => padT + cH - ((v - minV) / span) * cH;\nlet svg = `<defs><linearGradient id=\"baseArea\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0%\" stop-color=\"#059669\" stop-opacity=\".22\"/><stop offset=\"100%\" stop-color=\"#059669\" stop-opacity=\".01\"/></linearGradient></defs>`;\nfor (let i = 0; i <= 4; i++) {\nconst y = padT + cH - (cH * i) / 4;\nsvg += `<line x1=\"${padL}\" y1=\"${y}\" x2=\"${W-padR}\" y2=\"${y}\" stroke=\"var(--border)\" stroke-dasharray=\"${i?'3 3':''}\"/><text x=\"${padL-8}\" y=\"${y+4}\" text-anchor=\"end\" fill=\"var(--muted)\" font-size=\"10.5\">${esc(fmtWan(minV+(span*i)/4))}</text>`;\n}\nconst fy = toY(res.fire_target);\nsvg += `<line x1=\"${padL}\" y1=\"${fy.toFixed(1)}\" x2=\"${W-padR}\" y2=\"${fy.toFixed(1)}\" stroke=\"#e11d48\" stroke-width=\"1.6\" stroke-dasharray=\"6 4\"/><text x=\"${W-padR-4}\" y=\"${(fy-6).toFixed(1)}\" text-anchor=\"end\" fill=\"#e11d48\" font-size=\"11\" font-weight=\"700\">FIRE 自由线 ${esc(fmtWan(res.fire_target))}</text>`;\nconst mkP = k => series.map((p, i) => `${i?'L':'M'}${toX(i).toFixed(1)},${toY(p[k]).toFixed(1)}`).join(' ');\nconst bp = mkP('base');\nsvg += `<path d=\"${bp} L${toX(series.length-1).toFixed(1)},${toY(minV).toFixed(1)} L${toX(0).toFixed(1)},${toY(minV).toFixed(1)} Z\" fill=\"url(#baseArea)\"/><path d=\"${mkP('conservative')}\" fill=\"none\" stroke=\"#d97706\" stroke-width=\"2\" stroke-dasharray=\"5 3\"/><path d=\"${bp}\" fill=\"none\" stroke=\"#059669\" stroke-width=\"2.8\"/><path d=\"${mkP('optimistic')}\" fill=\"none\" stroke=\"#4f46e5\" stroke-width=\"2.2\"/>`;\nseries.forEach((p, i) => {\nif (i % 4 === 0 || i === series.length - 1) {\nconst x = toX(i);\nsvg += `<text x=\"${x.toFixed(1)}\" y=\"${H-10}\" text-anchor=\"middle\" fill=\"var(--muted)\" font-size=\"10.5\">${p.year}</text><circle cx=\"${x.toFixed(1)}\" cy=\"${toY(p.base).toFixed(1)}\" r=\"3.6\" fill=\"var(--surface)\" stroke=\"#059669\" stroke-width=\"2\"><title>${p.year}年｜保守 ${esc(fmtWan(p.conservative))} · 基准 ${esc(fmtWan(p.base))} · 乐观 ${esc(fmtWan(p.optimistic))}</title></circle>`;\n}\n});\n$('svg-fire').innerHTML = `<svg viewBox=\"0 0 ${W} ${H}\" role=\"img\" aria-label=\"20年复利增长三档曲线\">${svg}</svg>`;\n}\nfunction renderMortgageResult(m) {\nif (!m) return;\nconst pct = m.original_remaining_interest > 0 ? Math.round((m.interest_saved / m.original_remaining_interest) * 100) : 0;\n$('mortgage-cards').innerHTML = `<div class=\"sim-box\"><div class=\"sim-label\">原等额本息月供 / 剩余本金</div><div class=\"sim-val num\">${esc(fmtFull(m.original_monthly))}/月</div><div class=\"sim-sub num\">剩余本金 ${esc(fmtWan(m.remaining_principal))} · 原剩息 ${esc(fmtWan(m.original_remaining_interest))}</div></div>`\n+ `<div class=\"sim-box highlight\"><div class=\"sim-label\" style=\"color:var(--accent)\">提前还款预计节省总利息</div><div class=\"sim-val num\" style=\"color:var(--accent)\">${esc(fmtFull(m.interest_saved))}</div><div class=\"sim-sub num\">剩余利息直降 ${pct}% · 缩短 ${m.months_saved} 期（约 ${(m.months_saved/12).toFixed(1)} 年）</div></div>`\n+ `<div class=\"sim-box\"><div class=\"sim-label\">方案调整后新月供 / 新剩期</div><div class=\"sim-val num\">${esc(fmtFull(m.new_monthly))}/月</div><div class=\"sim-sub num\">剩余 ${m.new_remaining_months} 期 · 新剩余利息 ${esc(fmtWan(m.new_remaining_interest))}</div></div>`;\n}\nfunction buildCfoCtx() {\nconst s = state.summary; if (!s) return '请先加载财务演示数据或录入账户与收支流水。';\nconst alloc = state.allocation.map(a => `${(CLASS_META[a.asset_class]||CLASS_META.other).label} ${a.share}% (${fmtWan(a.amount)})`).join('、') || '无';\nconst over = state.budgets.filter(b => b.level !== 'ok').map(b => `${b.label} ${b.ratio}% (${fmtFull(b.spent)}/${fmtFull(b.limit)})`).join('；') || '当前无超支或预警分类';\nconst top = state.top_expenses.slice(0, 4).map(e => `${CAT_LABEL[e.category]||e.category} ${fmtFull(e.amount)} (${e.share}%)`).join('、') || '无';\nreturn `【资产负债】总资产 ${fmtWan(s.total_assets)}｜总负债 ${fmtWan(s.total_liabilities)}｜净资产 ${fmtWan(s.net_worth)}｜资产负债率 ${s.debt_ratio}%\\n【资产结构】${alloc}\\n【本月现金流 ${state.month}】月收入 ${fmtFull(s.monthly_income)}｜月支出 ${fmtFull(s.monthly_expense)}｜净结余 ${fmtFull(s.monthly_surplus)}｜储蓄率 ${s.savings_rate}%\\n【预算预警】${over}\\n【支出 Top 分类】${top}`;\n}\nfunction renderCfoContext() {\n$('cfo-context').textContent = buildCfoCtx();\n$('btn-cfo-insert').hidden = !canInsert;\n$('cfo-saved-wrap').hidden = !state.cfo_memo;\n$('cfo-saved-memo').textContent = state.cfo_memo || '';\n}\nfunction openAccModal(acc = null) {\neditingAccId = acc?.id || null;\n$('m-acc-title').textContent = acc ? `编辑账户：${acc.name}` : '新增资产/负债账户';\n$('m-acc-name').value = acc?.name ?? ''; $('m-acc-kind').value = acc?.kind ?? 'asset';\n$('m-acc-cls').value = acc?.asset_class ?? 'cash'; $('m-acc-bal').value = acc?.balance ?? 100000;\n$('m-acc-apy').value = acc?.apy ?? 3.5; $('m-acc-inst').value = acc?.institution ?? '';\n$('m-acc-note').value = acc?.note ?? ''; $('modal-acc').hidden = false;\n}\ndocument.querySelectorAll('.nav-btn').forEach(b => b.addEventListener('click', () => switchView(b.dataset.view)));\ndocument.querySelectorAll('[data-close]').forEach(b => b.addEventListener('click', () => { $(b.dataset.close).hidden = true; }));\non('btn-refresh', 'click', () => void loadSnapshot());\nconst mqDark = matchMedia('(prefers-color-scheme: dark)');\nlet userTheme = false;\nif (mqDark.matches) document.documentElement.dataset.theme = 'dark';\nmqDark.addEventListener?.('change', e => { if (!userTheme) document.documentElement.dataset.theme = e.matches ? 'dark' : 'light'; });\non('btn-theme', 'click', () => { userTheme = true; document.documentElement.dataset.theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'; });\non('btn-seed', 'click', () => runBusy(async () => {\nconst res = await plugin.action('finance.demo.seed', { expected_revision: state.revision });\nif (res.status === 'seeded') { await loadSnapshot(); setStatus(`已加载完整财务演示数据（${res.counts.accounts} 账户 / ${res.counts.ledger} 流水 / ${res.counts.goals} 预算目标）`); }\nelse setStatus(`加载演示数据冲突：${res.status}`, true);\n}));\non('btn-new-acc', 'click', () => openAccModal(null));\non('btn-new-goal', 'click', () => { $('modal-goal').hidden = false; });\non('btn-m-acc-save', 'click', () => runBusy(async () => {\nconst name = $('m-acc-name').value.trim(); if (!name) { setStatus('请填写账户名称', true); return; }\nconst kind = $('m-acc-kind').value;\nconst res = await plugin.action('finance.account.save', {\nexpected_revision: state.revision, id: editingAccId || `fin-${Date.now().toString(36)}`, name, kind,\nasset_class: kind === 'liability' ? 'debt' : $('m-acc-cls').value, balance: Math.max(0, Number($('m-acc-bal').value) || 0),\napy: Number($('m-acc-apy').value) || 0, institution: $('m-acc-inst').value.trim(), note: $('m-acc-note').value.trim(),\n});\nif (res.status === 'saved') { $('modal-acc').hidden = true; await loadSnapshot(); setStatus('账户已保存'); } else setStatus(`保存未完成：${res.status}`, true);\n}));\non('btn-m-goal-save', 'click', () => runBusy(async () => {\nconst label = $('m-goal-label').value.trim(), limit = Number($('m-goal-limit').value) || 0;\nif (!label || limit < 1) { setStatus('请填写名称与有效金额', true); return; }\nconst res = await plugin.action('finance.goal.save', {\nexpected_revision: state.revision, id: `goal-${Date.now().toString(36)}`, kind: $('m-goal-kind').value,\ncategory: $('m-goal-cat').value, label, monthly_limit: limit,\ncurrent_saved: Math.max(0, Number($('m-goal-saved').value) || 0), target_date: $('m-goal-date').value || '',\n});\nif (res.status === 'saved') { $('modal-goal').hidden = true; await loadSnapshot(); setStatus('预算/目标已保存'); } else setStatus(`保存未完成：${res.status}`, true);\n}));\non('tx-type', 'change', () => { const t = $('tx-type').value; $('tx-target-wrap').hidden = t !== 'transfer'; $('tx-cat').value = t === 'income' ? 'salary' : t === 'transfer' ? 'invest' : 'food'; });\non('tx-filter-type', 'change', renderLedgerTable); on('tx-search', 'input', renderLedgerTable);\non('btn-tx-add', 'click', () => runBusy(async () => {\nconst amount = Number($('tx-amt').value); if (!amount || amount < 0.01) { setStatus('请输入有效金额', true); return; }\nconst type = $('tx-type').value;\nconst res = await plugin.action('finance.tx.save', {\nexpected_revision: state.revision, id: `tx-${Date.now().toString(36)}`, date: $('tx-date').value || today(),\ntype, category: $('tx-cat').value, amount, account_id: $('tx-acc').value || 'default-cash',\ntarget_account_id: type === 'transfer' ? ($('tx-target-acc').value || '') : '', note: $('tx-note').value.trim(), sync_balance: $('tx-sync').checked,\n});\nif (res.status === 'saved') { $('tx-amt').value = ''; $('tx-note').value = ''; await loadSnapshot(); setStatus('流水已记入账本'); }\nelse setStatus(`记账未完成：${res.status}`, true);\n}));\n['sim-nw','sim-monthly','sim-ret','sim-inf','sim-exp','sim-swr','mg-principal','mg-rate','mg-years','mg-paid','mg-prepay','mg-mode'].forEach(id => on(id, 'change', () => void runSimulation()));\non('btn-run-sim', 'click', () => void runSimulation());\non('btn-sync-nw', 'click', () => {\nif (state.summary) { $('sim-nw').value = Math.round(state.summary.net_worth); if (state.summary.monthly_surplus > 0) $('sim-monthly').value = Math.round(state.summary.monthly_surplus); void runSimulation(); }\n});\ndocument.querySelectorAll('#cfo-scenarios .scenario-card').forEach(btn => btn.addEventListener('click', () => {\nactiveScenario = btn.dataset.sc;\ndocument.querySelectorAll('#cfo-scenarios .scenario-card').forEach(c => c.classList.toggle('active', c === btn));\n}));\non('btn-fx-fetch', 'click', async () => {\nconst box = $('fx-rates-row');\nbox.textContent = '正在从 Frankfurter API 获取最新参考汇率…';\ntry {\nconst r = await plugin.action('finance.fetch_fx_rates', {});\nif (r.status !== 'ok') { box.textContent = `汇率查询失败：${r.error || r.status}`; return; }\nif (!r.rates.length) { box.textContent = '暂无返回汇率数据。'; return; }\nbox.innerHTML = `<span class=\"tag ok\">1 ${esc(r.base)} (${esc(r.date)})</span>` + r.rates.map(it => `<span class=\"tag num\">${esc(it.currency)} ${it.rate}</span>`).join('');\nsetStatus(`已更新 ${r.base} 参考汇率 (${r.date})`);\n} catch (e) { box.textContent = `查询异常：${e?.message || '未知错误'}`; }\n});\nfunction buildCfoPromptText() {\nconst scText = {\nrebalance: '请作为专业私人 CFO 诊断我的资产配置与负债率，指出集中度与流动性风险，给出可执行的季度再平衡调仓方案。',\ncashflow: '请基于我本月收支、储蓄率与预算超支/预警项，拆解消费漏洞并给出 3 条可落地的节流优化建议。',\ndebt: '请结合我的负债率、房贷利率与组合结构，评估应优先提前还贷还是继续指数定投，给出资金分配比例建议。',\ntax_fire: '请从年度个人税务合规筹划与 FIRE 财务自由加速两维度，给出 12 个月行动路线图。',\n}[activeScenario];\nconst extra = $('cfo-extra').value.trim();\nreturn `${scText}\\n${extra ? `补充背景：${extra}\\n` : ''}\\n--- 当前个人财务实时快照 ---\\n${buildCfoCtx()}`;\n}\non('btn-cfo-draft', 'click', () => {\nconst s = state.summary || { net_worth: 0, debt_ratio: 0, savings_rate: 0, monthly_surplus: 0 };\nconst targetPct = state.settings?.target_savings_pct ?? 30;\nconst extra = $('cfo-extra').value.trim();\nconst titleMap = { rebalance: '资产再平衡诊断', cashflow: '现金流与预算优化', debt: '负债与提前还贷决策', tax_fire: '税务与 FIRE 加速路线' };\nlatestCfoText = [\n`# ${titleMap[activeScenario] || '私人 CFO 诊断'}（本地结构化报告）`,\nextra ? `> 个人约束：${extra}` : '',\n'',\n'## 核心财务快照',\nbuildCfoCtx(),\n'',\n'## 关键规则体检',\n`- 储蓄率评估：当前 ${s.savings_rate}% vs 目标 ${targetPct}%（${s.savings_rate >= targetPct ? '已达标' : '低于目标，建议优化高频非刚性支出'}）`,\n`- 负债水平：负债率 ${s.debt_ratio}%（${s.debt_ratio > 45 ? '偏高，优先保留 6 个月应急金后评估降杠杆' : '处于可控区间'}）`,\n'- 下一步：可保存为 CFO 备忘，或点击「复制 AI 诊断提示词」/「一键插入会话输入框」交由 Velai 工作台聊天或独立 AI 伴生插件深度分析。',\n].filter(Boolean).join('\\n');\n$('cfo-output').textContent = latestCfoText;\n$('cfo-result-box').hidden = false;\n$('btn-cfo-insert').hidden = !canInsert;\n$('cfo-state').textContent = '已生成本地结构化 CFO 报告，可核对保存或发送到工作台聊天深度推演。';\n});\non('btn-cfo-prompt', 'click', async () => {\nconst prompt = buildCfoPromptText();\ntry { await navigator.clipboard.writeText(prompt); $('cfo-state').textContent = '已复制 CFO 诊断提示词，可粘贴至工作台聊天或 AI 伴生插件。'; }\ncatch { $('cfo-state').textContent = '剪贴板不可用，请点击「生成本地结构化 CFO 诊断报告」后使用插入按钮。'; }\n});\non('btn-cfo-insert', 'click', async () => {\nif (!latestCfoText) return;\ntry { const r = await plugin.action('host.draft.insert', { text: latestCfoText }); setStatus(r?.inserted ? '已插入 Velai 会话输入框' : '未能确认插入', !r?.inserted); }\ncatch (e) { setStatus(`插入失败：${e?.message || ''}`, true); }\n});\non('btn-cfo-save', 'click', () => { if (!latestCfoText) return; void runBusy(async () => {\nconst res = await plugin.action('finance.cfo.memo', { expected_revision: state.revision, memo: latestCfoText.slice(0, 2048) });\nif (res.status === 'saved') { await loadSnapshot(); setStatus('已保存 CFO 财务诊断备忘'); } else setStatus(`保存未完成：${res.status}`, true);\n}); });\non('btn-cfo-copy', 'click', async () => { if (!latestCfoText) return; try { await navigator.clipboard.writeText(latestCfoText); setStatus('已复制 CFO 诊断报告'); } catch { setStatus('请手动选中复制'); } });\non('btn-io', 'click', async () => {\n$('modal-io').hidden = false; $('io-msg').textContent = '';\ntry { const r = await plugin.action('document.list', {}); $('io-select').innerHTML = (r.items || []).map(it => `<option value=\"${esc(it.id)}\">${esc(it.label)}</option>`).join(''); }\ncatch (e) { $('io-msg').textContent = `获取列表失败：${e?.message || ''}`; }\n});\non('btn-io-export', 'click', async () => {\nconst id = $('io-select').value; if (!id) return;\ntry { const r = await plugin.action('document.export', { id }); if (r.text) { $('io-text').value = r.text; $('io-msg').textContent = `已导出 ${r.filename}（${r.text.length} 字符）`; } else $('io-msg').textContent = `导出失败：${r.error || ''}`; }\ncatch (e) { $('io-msg').textContent = `导出失败：${e?.message || ''}`; }\n});\non('btn-io-import', 'click', async () => {\nconst text = $('io-text').value.trim(); if (!text) { $('io-msg').textContent = '请先粘贴 JSON'; return; }\ntry { const r = await plugin.action('document.import', { text }); if (r.imported) { await loadSnapshot(); $('io-msg').textContent = '导入成功，工作台已刷新。'; } else $('io-msg').textContent = `导入失败：${r.reason || ''}`; }\ncatch (e) { $('io-msg').textContent = `导入失败：${e?.message || ''}`; }\n});\non('btn-io-copy', 'click', asy