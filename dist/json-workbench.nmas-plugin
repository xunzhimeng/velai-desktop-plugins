{"files":[{"content":"function sortKeys(v) {\n  if (Array.isArray(v)) return v.map(sortKeys);\n  if (v !== null && typeof v === 'object') {\n    const out = {};\n    for (const k of Object.keys(v).sort()) out[k] = sortKeys(v[k]);\n    return out;\n  }\n  return v;\n}\n\nfunction stats(v, depth = 0) {\n  if (Array.isArray(v)) {\n    let maxD = depth;\n    let keys = 0;\n    for (const item of v) {\n      const s = stats(item, depth + 1);\n      if (s.depth > maxD) maxD = s.depth;\n      keys += s.keys;\n    }\n    return { depth: maxD, keys };\n  }\n  if (v !== null && typeof v === 'object') {\n    const entries = Object.values(v);\n    let maxD = depth;\n    let keys = entries.length;\n    for (const child of entries) {\n      const s = stats(child, depth + 1);\n      if (s.depth > maxD) maxD = s.depth;\n      keys += s.keys;\n    }\n    return { depth: maxD, keys };\n  }\n  return { depth, keys: 0 };\n}\n\nfunction typeOf(v) {\n  if (v === null) return 'null';\n  if (Array.isArray(v)) return 'array';\n  return typeof v;\n}\n\nfunction queryPath(root, path) {\n  const clean = path.trim().replace(/^\\$\\.?/, '');\n  if (!clean) return { found: true, value: root };\n  const tokens = [];\n  const re = /([^[.\\]]+)|\\[(\\d+)\\]/g;\n  let m;\n  while ((m = re.exec(clean)) !== null) {\n    tokens.push(m[1] !== undefined ? m[1] : Number(m[2]));\n  }\n  let cur = root;\n  for (const tok of tokens) {\n    if (cur === null || typeof cur !== 'object') return { found: false };\n    if (typeof tok === 'number') {\n      if (!Array.isArray(cur) || tok < 0 || tok >= cur.length) return { found: false };\n      cur = cur[tok];\n    } else {\n      if (!Object.prototype.hasOwnProperty.call(cur, tok)) return { found: false };\n      cur = cur[tok];\n    }\n  }\n  return { found: true, value: cur };\n}\n\nfunction preview(v) {\n  const s = JSON.stringify(v);\n  return s.length > 100 ? `${s.slice(0, 97)}...` : s;\n}\n\nfunction diffValues(a, b, path, out) {\n  if (out.length >= 64) return;\n  if (a === b) return;\n  if (a === null || b === null || typeof a !== 'object' || typeof b !== 'object' || Array.isArray(a) !== Array.isArray(b)) {\n    out.push({ path, kind: 'changed', detail: `${preview(a)} -> ${preview(b)}` });\n    return;\n  }\n  if (Array.isArray(a)) {\n    const maxLen = Math.max(a.length, b.length);\n    for (let i = 0; i < maxLen && out.length < 64; i++) {\n      const p = `${path}[${i}]`;\n      if (i >= a.length) out.push({ path: p, kind: 'added', detail: preview(b[i]) });\n      else if (i >= b.length) out.push({ path: p, kind: 'removed', detail: preview(a[i]) });\n      else diffValues(a[i], b[i], p, out);\n    }\n    return;\n  }\n  const allKeys = Array.from(new Set([...Object.keys(a), ...Object.keys(b)])).sort();\n  for (const k of allKeys) {\n    if (out.length >= 64) break;\n    const p = `${path}.${k}`;\n    const hasA = Object.prototype.hasOwnProperty.call(a, k);\n    const hasB = Object.prototype.hasOwnProperty.call(b, k);\n    if (!hasA) out.push({ path: p, kind: 'added', detail: preview(b[k]) });\n    else if (!hasB) out.push({ path: p, kind: 'removed', detail: preview(a[k]) });\n    else diffValues(a[k], b[k], p, out);\n  }\n}\n\nexport default async function (request) {\n  const { kind, contribution, input } = request ?? {};\n\n  if (kind === 'action' && contribution === 'json.format') {\n    let parsed;\n    try { parsed = JSON.parse(input.text); } catch (e) { return { valid: false, error: String(e?.message || 'JSON 解析失败').slice(0, 200) }; }\n    const s = stats(parsed);\n    const output = input.mode === 'minify'\n      ? JSON.stringify(parsed)\n      : input.mode === 'canonical'\n        ? JSON.stringify(sortKeys(parsed), null, 2)\n        : JSON.stringify(parsed, null, 2);\n    return { valid: true, output, root_type: typeOf(parsed), depth: s.depth, keys: s.keys };\n  }\n\n  if (kind === 'action' && contribution === 'json.query') {\n    let parsed;\n    try { parsed = JSON.parse(input.text); } catch (e) { return { found: false, error: String(e?.message || 'JSON 解析失败').slice(0, 200) }; }\n    const q = queryPath(parsed, input.path);\n    if (!q.found) return { found: false, error: `未找到路径：${input.path}` };\n    return { found: true, result: JSON.stringify(q.value, null, 2) };\n  }\n\n  if (kind === 'action' && contribution === 'json.diff') {\n    let a, b;\n    try { a = JSON.parse(input.left); } catch (e) { return { ok: false, error: `左侧 JSON 无效：${e?.message}`, changes: [] }; }\n    try { b = JSON.parse(input.right); } catch (e) { return { ok: false, error: `右侧 JSON 无效：${e?.message}`, changes: [] }; }\n    const changes = [];\n    diffValues(a, b, '$', changes);\n    return { ok: true, changes };\n  }\n\n  if (kind === 'tool' && contribution === 'json.analyze') {\n    let parsed;\n    try { parsed = JSON.parse(input.text); } catch (e) {\n      return { success: false, status: 'invalid_json', error: String(e?.message || 'JSON 解析失败').slice(0, 200) };\n    }\n    const s = stats(parsed);\n    return {\n      success: true,\n      status: 'valid',\n      root_type: typeOf(parsed),\n      depth: s.depth,\n      keys: s.keys,\n      canonical: JSON.stringify(sortKeys(parsed)),\n    };\n  }\n\n  throw new Error(`不支持的调用: ${kind}/${contribution}`);\n}\n","path":"backend/index.js"},{"content":"<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>JSON 与结构化数据工坊</title>\n  <style>\n    :root {\n      color-scheme: light dark;\n      --bg: Canvas; --fg: CanvasText; --muted: color-mix(in srgb, CanvasText 60%, transparent);\n      --border: color-mix(in srgb, CanvasText 18%, transparent);\n      --card: color-mix(in srgb, CanvasText 4%, Canvas);\n      --accent: #2563eb; --ok: #16a34a; --warn: #d97706; --danger: #dc2626;\n      font: 14px/1.5 system-ui, -apple-system, sans-serif;\n    }\n    * { box-sizing: border-box; }\n    body { margin: 0; background: var(--bg); color: var(--fg); }\n    main { max-width: 960px; margin: 0 auto; padding: clamp(12px, 2.5vw, 20px); display: flex; flex-direction: column; gap: 10px; }\n    header, .row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: space-between; }\n    h1 { font-size: 18px; margin: 0; }\n    .tabs { display: flex; gap: 6px; }\n    .tab.active { background: var(--accent); border-color: var(--accent); color: #fff; }\n    .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }\n    @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }\n    textarea, input, button { font: inherit; color: inherit; border: 1px solid var(--border); border-radius: 7px; padding: 6px 10px; background: var(--bg); }\n    textarea { width: 100%; min-height: 200px; resize: vertical; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12.5px; }\n    button { cursor: pointer; }\n    button.primary { background: var(--accent); border-color: var(--accent); color: #fff; }\n    .panel { border: 1px solid var(--border); border-radius: 10px; padding: 12px; background: var(--card); display: flex; flex-direction: column; gap: 8px; }\n    .diff-item { padding: 6px 8px; border-radius: 6px; border: 1px solid var(--border); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12.5px; background: var(--bg); }\n    .k-added { border-left: 3px solid var(--ok); }\n    .k-removed { border-left: 3px solid var(--danger); }\n    .k-changed { border-left: 3px solid var(--warn); }\n    .status { font-size: 13px; color: var(--muted); margin: 0; }\n    .status[data-error=\"true\"] { color: var(--danger); }\n    [hidden] { display: none !important; }\n  </style>\n</head>\n<body>\n  <main>\n    <header>\n      <h1>JSON 与结构化数据工坊</h1>\n      <div class=\"tabs\">\n        <button class=\"tab active\" data-tab=\"format\" type=\"button\">格式化与查询</button>\n        <button class=\"tab\" data-tab=\"diff\" type=\"button\">结构 Diff</button>\n        <button id=\"btn-read\" type=\"button\" hidden>读入选中回复</button>\n        <button id=\"btn-insert\" class=\"primary\" type=\"button\" hidden>插入输入框</button>\n      </div>\n    </header>\n\n    <p id=\"status\" class=\"status\" role=\"status\">零权限纯本地计算，随时粘贴 JSON 开始处理。</p>\n\n    <section id=\"pane-format\" class=\"panel\">\n      <div class=\"row\" style=\"justify-content:flex-start\">\n        <button data-mode=\"pretty\" class=\"primary\" type=\"button\">美化缩进</button>\n        <button data-mode=\"canonical\" type=\"button\">键名排序 (Canonical)</button>\n        <button data-mode=\"minify\" type=\"button\">压缩为单行</button>\n        <input id=\"q-path\" placeholder=\"路径提取，如 $.items[0].name\" style=\"flex:1;min-width:180px\">\n        <button id=\"btn-query\" type=\"button\">提取</button>\n      </div>\n      <div class=\"grid\">\n        <textarea id=\"src\" placeholder='粘贴 JSON，例如 {\"b\": 1, \"a\": [{\"name\": \"velai\"}]}'></textarea>\n        <textarea id=\"out\" readonly placeholder=\"输出结果…\"></textarea>\n      </div>\n    </section>\n\n    <section id=\"pane-diff\" class=\"panel\" hidden>\n      <div class=\"grid\">\n        <textarea id=\"left\" placeholder=\"左侧（旧版）JSON\"></textarea>\n        <textarea id=\"right\" placeholder=\"右侧（新版）JSON\"></textarea>\n      </div>\n      <div class=\"row\" style=\"justify-content:flex-start\">\n        <button id=\"btn-diff\" class=\"primary\" type=\"button\">开始结构对比</button>\n      </div>\n      <div id=\"diff-out\" style=\"display:flex;flex-direction:column;gap:6px\"></div>\n    </section>\n  </main>\n  <script>\n    (() => {\n      const plugin = globalThis.nmasPlugin;\n      const $ = id => document.getElementById(id);\n      const setStatus = (t, err = false) => { $('status').textContent = t; $('status').dataset.error = String(err); };\n\n      document.querySelectorAll('.tab').forEach(btn => {\n        btn.addEventListener('click', () => {\n          const tab = btn.dataset.tab;\n          document.querySelectorAll('.tab').forEach(b => b.classList.toggle('active', b === btn));\n          $('pane-format').hidden = tab !== 'format';\n          $('pane-diff').hidden = tab !== 'diff';\n        });\n      });\n\n      document.querySelectorAll('button[data-mode]').forEach(btn => {\n        btn.addEventListener('click', async () => {\n          const text = $('src').value.trim();\n          if (!text) { setStatus('请先输入 JSON。', true); return; }\n          try {\n            const res = await plugin.action('json.format', { text, mode: btn.dataset.mode });\n            if (res.valid) {\n              $('out').value = res.output;\n              setStatus(`合法 JSON · 类型 ${res.root_type} · 深度 ${res.depth} · 键数 ${res.keys}`);\n            } else {\n              $('out').value = '';\n              setStatus(`解析错误：${res.error}`, true);\n            }\n          } catch (e) { setStatus(`执行失败：${e?.message || '未知错误'}`, true); }\n        });\n      });\n\n      $('btn-query').addEventListener('click', async () => {\n        const text = $('src').value.trim();\n        if (!text) { setStatus('请先输入 JSON。', true); return; }\n        try {\n          const res = await plugin.action('json.query', { text, path: $('q-path').value });\n          if (res.found) {\n            $('out').value = res.result;\n            setStatus(`提取成功：${$('q-path').value || '$'}`);\n          } else {\n            setStatus(res.error || '路径未命中', true);\n          }\n        } catch (e) { setStatus(`查询失败：${e?.message || '未知错误'}`, true); }\n      });\n\n      $('btn-diff').addEventListener('click', async () => {\n        const left = $('left').value.trim(), right = $('right').value.trim();\n        if (!left || !right) { setStatus('请在左右两侧都填入 JSON。', true); return; }\n        try {\n          const res = await plugin.action('json.diff', { left, right });\n          const box = $('diff-out');\n          box.replaceChildren();\n          if (!res.ok) { setStatus(res.error || '对比失败', true); return; }\n          if (!res.changes.length) {\n            setStatus('两段 JSON 结构与值完全一致。');\n            return;\n          }\n          setStatus(`共发现 ${res.changes.length} 处差异。`);\n          for (const c of res.changes) {\n            const div = document.createElement('div');\n            div.className = `diff-item k-${c.kind}`;\n            div.textContent = `[${c.kind.toUpperCase()}] ${c.path}: ${c.detail}`;\n            box.appendChild(div);\n          }\n        } catch (e) { setStatus(`对比失败：${e?.message || '未知错误'}`, true); }\n      });\n\n      $('btn-read').addEventListener('click', async () => {\n        try {\n          const r = await plugin.action('host.selection.read', {});\n          if (typeof r?.text === 'string' && r.text.trim()) {\n            $('src').value = r.text;\n            setStatus('已读入选中内容。');\n          }\n        } catch { setStatus('无法读取选中回复。', true); }\n      });\n\n      $('btn-insert').addEventListener('click', async () => {\n        const text = ($('out').value || $('src').value).trim();\n        if (!text) return;\n        try {\n          const r = await plugin.action('host.draft.insert', { text });\n          setStatus(r?.inserted ? '已插入会话输入框。' : '插入未确认。', !r?.inserted);\n        } catch (e) { setStatus(`插入失败：${e?.message || '未知错误'}`, true); }\n      });\n\n      if (typeof plugin?.action === 'function') {\n        plugin.action('host.capabilities', {}).then(c => {\n          const acts = Array.isArray(c?.actions) ? c.actions : [];\n          $('btn-read').hidden = !acts.includes('host.selection.read');\n          $('btn-insert').hidden = !acts.includes('host.draft.insert');\n        }).catch(() => {});\n      }\n    })();\n  </script>\n</body>\n</html>\n","path":"ui/index.html"}],"format":"nmas-plugin","manifest":{"actions":[{"id":"json.format","input_schema":{"additionalProperties":false,"properties":{"mode":{"enum":["pretty","minify","canonical"],"type":"string"},"text":{"maxLength":10000,"minLength":1,"type":"string"}},"required":["text","mode"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"depth":{"maximum":64,"minimum":0,"type":"integer"},"error":{"maxLength":200,"type":"string"},"keys":{"maximum":10000,"minimum":0,"type":"integer"},"output":{"maxLength":12000,"type":"string"},"root_type":{"maxLength":16,"type":"string"},"valid":{"type":"boolean"}},"required":["valid"],"type":"object"},"permissions":[],"title":"格式化或压缩 JSON"},{"id":"json.query","input_schema":{"additionalProperties":false,"properties":{"path":{"maxLength":256,"type":"string"},"text":{"maxLength":10000,"minLength":1,"type":"string"}},"required":["text","path"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"error":{"maxLength":200,"type":"string"},"found":{"type":"boolean"},"result":{"maxLength":12000,"type":"string"}},"required":["found"],"type":"object"},"permissions":[],"title":"按路径提取 JSON 值"},{"id":"json.diff","input_schema":{"additionalProperties":false,"properties":{"left":{"maxLength":6000,"minLength":1,"type":"string"},"right":{"maxLength":6000,"minLength":1,"type":"string"}},"required":["left","right"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"changes":{"items":{"additionalProperties":false,"properties":{"detail":{"maxLength":300,"type":"string"},"kind":{"enum":["added","removed","changed"],"type":"string"},"path":{"maxLength":256,"type":"string"}},"required":["path","kind","detail"],"type":"object"},"type":"array"},"error":{"maxLength":200,"type":"string"},"ok":{"type":"boolean"}},"required":["ok","changes"],"type":"object"},"permissions":[],"title":"结构化对比两段 JSON"}],"backend":"backend/index.js","data":[],"files":[{"path":"backend/index.js","sha256":"a337efa46cc358991d5e98d81641a8142223f305c5969eac8c9de3d237fdcea1"},{"path":"ui/index.html","sha256":"6ce85dcebaefc9ecca33943ce9e5d1c254e2d5e70e904a0553d7edc15096c630"}],"host_api":1,"http":[],"manifest_version":1,"name":"JSON 与结构化数据工坊","page":"ui/index.html","permissions":[],"plugin_id":"json-workbench","tasks":[],"tools":[{"description":"校验一段 JSON 字符串的合法性，返回根类型、嵌套深度、键总数及按键名排序后的规范 JSON。","id":"json.analyze","input_schema":{"additionalProperties":false,"properties":{"text":{"maxLength":8000,"minLength":1,"type":"string"}},"required":["text"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"canonical":{"maxLength":8000,"type":"string"},"depth":{"maximum":64,"minimum":0,"type":"integer"},"error":{"maxLength":200,"type":"string"},"keys":{"maximum":10000,"minimum":0,"type":"integer"},"root_type":{"maxLength":16,"type":"string"},"status":{"enum":["valid","invalid_json"],"type":"string"},"success":{"type":"boolean"}},"required":["success","status"],"type":"object"},"permissions":[],"title":"分析并规范化 JSON"}],"ui":{"icon":"app","surfaces":["workspace","chat","assistant"]},"version":"1.0.0"},"version":1}