{"files":[{"content":"const COL_REQ = 'requirements';\nconst COL_MAP = 'roadmap';\nconst COL_SPEC = 'specs';\nconst KEY_REQ = 'list';\nconst KEY_MAP = 'plan';\nconst KEY_SPEC_IDX = 'index';\n\nconst MAX_RECORD_BYTES = 240 * 1024;\nconst MAX_BYTES = MAX_RECORD_BYTES;\nconst MAX_REQS = 80;\nconst STATUSES = ['backlog', 'planned', 'in_progress', 'review', 'shipped'];\nconst BUNDLE_FORMAT = 'velai.product-studio.bundle';\nconst PRD_FORMAT = 'velai.product-studio.prd';\n\nfunction jsonBytes(value) {\n  let bytes = 0;\n  const s = JSON.stringify(value);\n  for (let i = 0; i < s.length; i++) {\n    const cp = s.codePointAt(i);\n    if (cp > 0xffff) i++;\n    bytes += cp <= 0x7f ? 1 : cp <= 0x7ff ? 2 : cp <= 0xffff ? 3 : 4;\n  }\n  return bytes;\n}\n\nfunction today() {\n  return new Date().toISOString().slice(0, 10);\n}\n\nfunction clampNum(v, min, max) {\n  const n = Number(v);\n  if (!Number.isFinite(n)) return min;\n  return Math.min(max, Math.max(min, n));\n}\n\nfunction calcRice(reach, impact, confidence, effort) {\n  const value_score = Math.round(reach * impact * (confidence / 100));\n  const rice = Math.round(value_score / effort);\n  const priority = rice >= 1200 ? 'P0' : rice >= 600 ? 'P1' : rice >= 250 ? 'P2' : 'P3';\n  return { value_score, rice, priority };\n}\n\nfunction calcSpecScore(spec) {\n  const len = s => (typeof s === 'string' ? Array.from(s.trim()).length : 0);\n  const lines = s => (typeof s === 'string' ? s.trim().split(/\\r?\\n/).filter(l => l.trim().length > 0).length : 0);\n  let score = 0;\n  const bg = len(spec.background);\n  if (bg >= 35) score += 20;\n  else if (bg >= 15) score += 10;\n\n  const us = len(spec.user_stories);\n  if (us >= 35) score += 20;\n  else if (us >= 15) score += 10;\n\n  const cf = len(spec.core_flow);\n  const cfLines = lines(spec.core_flow);\n  if (cf >= 40 || cfLines >= 2) score += 20;\n  else if (cf >= 15) score += 10;\n\n  const ac = len(spec.acceptance_criteria);\n  const acLines = lines(spec.acceptance_criteria);\n  if (ac >= 40 || acLines >= 2) score += 25;\n  else if (ac >= 15 || acLines >= 1) score += 12;\n\n  const rk = len(spec.risks);\n  if (rk >= 25) score += 15;\n  else if (rk >= 10) score += 8;\n\n  return Math.min(100, score);\n}\n\nfunction defaultRoadmap() {\n  return {\n    schema_version: 1,\n    total_weeks: 12,\n    current_week: 5,\n    milestones: [],\n    lanes: [],\n  };\n}\n\nasync function readReqs() {\n  const r = await globalThis.nmas.data.read({ collection: COL_REQ, key: KEY_REQ });\n  const doc = r.value === null ? { schema_version: 1, items: [] } : r.value;\n  if (!doc || doc.schema_version !== 1 || !Array.isArray(doc.items)) {\n    throw new Error('需求池数据格式无效');\n  }\n  return { revision: r.revision, items: doc.items };\n}\n\nasync function readRoadmap() {\n  const r = await globalThis.nmas.data.read({ collection: COL_MAP, key: KEY_MAP });\n  const doc = r.value === null ? defaultRoadmap() : r.value;\n  if (!doc || doc.schema_version !== 1 || !Array.isArray(doc.lanes)) {\n    throw new Error('路线图数据格式无效');\n  }\n  return {\n    revision: r.revision,\n    roadmap: {\n      total_weeks: doc.total_weeks || 12,\n      current_week: doc.current_week || 5,\n      milestones: Array.isArray(doc.milestones) ? doc.milestones : [],\n      lanes: doc.lanes,\n    },\n  };\n}\n\nasync function readSpecIndex() {\n  const r = await globalThis.nmas.data.read({ collection: COL_SPEC, key: KEY_SPEC_IDX });\n  const doc = r.value === null ? { schema_version: 1, scores: {} } : r.value;\n  if (!doc || doc.schema_version !== 1 || typeof doc.scores !== 'object' || doc.scores === null) {\n    throw new Error('PRD 索引数据格式无效');\n  }\n  return { revision: r.revision, scores: doc.scores };\n}\n\nasync function readSpecDoc(reqId) {\n  const r = await globalThis.nmas.data.read({ collection: COL_SPEC, key: `doc:${reqId}` });\n  if (r.value === null) {\n    return {\n      revision: r.revision,\n      spec: {\n        req_id: reqId,\n        background: '',\n        user_stories: '',\n        core_flow: '',\n        acceptance_criteria: '',\n        risks: '',\n        score: 0,\n        updated_at: '',\n      },\n    };\n  }\n  const s = r.value;\n  return {\n    revision: r.revision,\n    spec: {\n      req_id: reqId,\n      background: s.background || '',\n      user_stories: s.user_stories || '',\n      core_flow: s.core_flow || '',\n      acceptance_criteria: s.acceptance_criteria || '',\n      risks: s.risks || '',\n      score: typeof s.score === 'number' ? s.score : calcSpecScore(s),\n      updated_at: s.updated_at || '',\n    },\n  };\n}\n\nasync function safeWrite(collection, key, expectedRevision, value) {\n  if (jsonBytes(value) > MAX_BYTES) {\n    return { ok: false, status: 'limit', revision: expectedRevision };\n  }\n  try {\n    const receipt = await globalThis.nmas.data.write({\n      collection,\n      key,\n      expected_revision: expectedRevision,\n      value,\n    });\n    return { ok: true, status: 'saved', revision: receipt.revision };\n  } catch (err) {\n    if (err?.code === 'conflict' && err.outcome_unknown === false) {\n      return { ok: false, status: 'conflict', revision: expectedRevision };\n    }\n    if (err?.code === 'resource_limit') {\n      return { ok: false, status: 'limit', revision: expectedRevision };\n    }\n    throw err;\n  }\n}\n\nasync function safeDelete(collection, key, expectedRevision) {\n  try {\n    const receipt = await globalThis.nmas.data.delete({\n      collection,\n      key,\n      expected_revision: expectedRevision,\n    });\n    return { ok: true, status: 'deleted', revision: receipt.revision };\n  } catch (err) {\n    if (err?.code === 'conflict' && err.outcome_unknown === false) {\n      return { ok: false, status: 'conflict', revision: expectedRevision };\n    }\n    throw err;\n  }\n}\n\nfunction formatPrdMarkdown(req, spec) {\n  return [\n    `# PRD: ${req.title}`,\n    `- ID: \\`${req.id}\\` | 模块：${req.module} | 优先级：${req.priority} (RICE ${req.rice}) | 负责人：${req.owner || '-'} | 迭代：${req.sprint || '-'}`,\n    '',\n    '## 1. 背景与目标',\n    spec.background || '（待补充）',\n    '',\n    '## 2. 用户故事',\n    spec.user_stories || '（待补充）',\n    '',\n    '## 3. 核心业务流程',\n    spec.core_flow || '（待补充）',\n    '',\n    '## 4. 验收标准 (AC)',\n    spec.acceptance_criteria || '（待补充）',\n    '',\n    '## 5. 边界与风险',\n    spec.risks || '（待补充）',\n    '',\n  ].join('\\n');\n}\n\nfunction formatRoadmapMarkdown(items, roadmap) {\n  const lines = [\n    '# 产品需求与路线图总览',\n    `- 周期：共 ${roadmap.total_weeks} 周（当前 W${roadmap.current_week}） | 需求总数：${items.length}`,\n    '',\n    '## 里程碑',\n    ...(roadmap.milestones.length\n      ? roadmap.milestones.map(m => `- W${m.week}: ${m.title}`)\n      : ['- （暂无里程碑）']),\n    '',\n    '## 需求优先级列表 (按 RICE 降序)',\n    '| ID | 需求 | 模块 | 状态 | 优先级 | RICE | 负责人 | 迭代 |',\n    '| --- | --- | --- | --- | --- | --- | --- | --- |',\n  ];\n  const sorted = [...items].sort((a, b) => b.rice - a.rice);\n  for (const r of sorted) {\n    lines.push(`| ${r.id} | ${r.title} | ${r.module} | ${r.status} | ${r.priority} | ${r.rice} | ${r.owner || '-'} | ${r.sprint || '-'} |`);\n  }\n  return `${lines.join('\\n')}\\n`;\n}\n\nfunction buildKpi(items, scores) {\n  const total = items.length;\n  const in_progress = items.filter(i => i.status === 'in_progress' || i.status === 'review').length;\n  const shipped = items.filter(i => i.status === 'shipped').length;\n  const avg_rice = total === 0 ? 0 : Math.round(items.reduce((s, i) => s + i.rice, 0) / total);\n  const avg_spec_score =\n    total === 0\n      ? 0\n      : Math.round(\n          items.reduce((s, i) => s + (typeof scores[i.id]?.score === 'number' ? scores[i.id].score : 0), 0) / total,\n        );\n  return { total, in_progress, shipped, avg_rice, avg_spec_score };\n}\n\nfunction buildDemoData() {\n  const rawReqs = [\n    {\n      id: 'req-sandbox-qjs',\n      title: 'QuickJS 零冷启动沙箱内核',\n      module: '运行时内核',\n      status: 'shipped',\n      reach: 4200,\n      impact: 3,\n      confidence: 95,\n      effort: 3,\n      owner: '林晓',\n      sprint: 'S1 · 内核筑基',\n      summary: '预热 QuickJS 实例池并将单次插件 Action 调用冷启动延迟压至 8ms 以内。',\n      lane: { start_week: 1, duration_weeks: 3, progress: 100 },\n      spec: {\n        background: 'v1 插件运行时每次调用重新初始化 JS 上下文，导致交互高频操作出现 60~120ms 卡顿，亟需构建可复用且严格隔离的沙箱内核。',\n        user_stories: '作为插件用户，我希望点击按钮与切换视图几乎零延迟；作为安全审计员，我希望每次执行结束后彻底清理内存与全局状态。',\n        core_flow: '1. 启动期预创建 4 个冻结全局原型的 QuickJS Runtime\\n2. 收到 Action 请求时借出上下文并注入受限 Broker 代理\\n3. 超时 2s 强杀并回收内存，归还池前校验无泄露',\n        acceptance_criteria: '1. P95 Action 响应耗时 <= 12ms\\n2. 单次调用内存硬上限 32 MiB，超限返回确定性 resource_limit\\n3. 连续 1000 次调用零跨插件状态污染',\n        risks: '需防止 Promise 微任务在归还池后残留触发；需与 macOS Seatbelt 沙箱协同验证。',\n      },\n    },\n    {\n      id: 'req-tool-bridge',\n      title: 'Agent Tools 统一声明与权限确认流',\n      module: 'AI 编排',\n      status: 'shipped',\n      reach: 3600,\n      impact: 3,\n      confidence: 90,\n      effort: 2.5,\n      owner: '陈默',\n      sprint: 'S1 · 内核筑基',\n      summary: '支持插件注册结构化 Agent Tools，自动校验 JSON Schema 并在写入时弹出明确授权提示。',\n      lane: { start_week: 2, duration_weeks: 3, progress: 100 },\n      spec: {\n        background: '用户希望 Velai AI 助手能直接读写插件内项目数据，但缺乏统一工具注册、Schema 强校验及最小权限隔离机制。',\n        user_stories: '作为开发者，我只需在 manifest.json 声明 tools 即可被会话调用；作为用户，我能清晰看到每个工具的读写权限并一键启停。',\n        core_flow: '1. 安装阶段静态审计 tools Schema 与权限子集\\n2. 会话加载时将启用插件的工具注入模型工具目录\\n3. 调用前校验入参 Schema，调用后校验出参 success/status 字段',\n        acceptance_criteria: '1. 单账号严格限制最多注册 32 个插件工具\\n2. 非法 Schema 或越权声明在安装期 100% 拦截\\n3. 工具调用失败时显式返回结构化错误而非静默降级',\n        risks: '工具描述过长可能挤占上下文窗口，需要强制限制 description <= 512 字节。',\n      },\n    },\n    {\n      id: 'req-cas-kv',\n      title: '分域 CAS 乐观锁本地数据引擎',\n      module: '运行时内核',\n      status: 'review',\n      reach: 2800,\n      impact: 2,\n      confidence: 95,\n      effort: 2,\n      owner: '林晓',\n      sprint: 'S2 · 存储与安全',\n      summary: '提供 project / account 双域隔离 KV 存储，强制 expected_revision CAS 防止多窗口并发覆盖。',\n      lane: { start_week: 4, duration_weeks: 3, progress: 88 },\n      spec: {\n        background: '同一插件可能同时在主工作区与聊天侧栏打开，若直接覆盖写入极易丢失用户编辑内容。',\n        user_stories: '作为多窗口重度用户，当我同时在两个面板编辑数据时，系统应及时发现版本冲突并提示刷新，而不是静默覆盖。',\n        core_flow: '1. 按 plugin_id + scope + collection 物理分库\\n2. 每次写入强制校验 expected_revision 与当前修订号一致\\n3. 冲突时返回确定性 conflict 错误且不递增修订号',\n        acceptance_criteria: '1. project 域数据切换项目后 100% 不可见\\n2. 单条记录超过 16 KiB 时明确拒绝并返回 resource_limit\\n3. 并发写入压测下零数据损坏',\n        risks: '插件开发者可能忘记拆分大对象，需在文档与校验器中给出 12 KiB 推荐阈值预警。',\n      },\n    },\n    {\n      id: 'req-market-verify',\n      title: '插件市场签名验证与 GitHub 自动更新源',\n      module: '插件生态',\n      status: 'in_progress',\n      reach: 3200,\n      impact: 3,\n      confidence: 85,\n      effort: 5,\n      owner: '周晴',\n      sprint: 'S2 · 存储与安全',\n      summary: '支持从 GitHub Release 拉取 .nmas-plugin 归档包，自动校验 SHA-256 摘要并灰度升级。',\n      lane: { start_week: 4, duration_weeks: 4, progress: 62 },\n      spec: {\n        background: '目前用户只能手工下载本地插件包导入，升级流程繁琐且难以核验包完整性与权限变更。',\n        user_stories: '作为团队管理员，我希望配置公司 GitHub 仓库作为更新源，一键安装并检查全员插件更新。',\n        core_flow: '1. 定时拉取 catalog.json 并比对已安装版本与 package_digest\\n2. 下载归档包并在临时隔离目录完成全量文件 SHA-256 校验\\n3. 若新版本新增高危权限则弹窗等待用户重新确认',\n        acceptance_criteria: '1. 摘要不匹配立即中止安装并清理临时文件\\n2. 新增权限未获授权前保持旧版本运行\\n3. 支持一键回滚至上一个已验证快照',\n        risks: 'GitHub API 限流可能导致检查失败，需支持 ETag 条件请求与清晰错误提示。',\n      },\n    },\n    {\n      id: 'req-turn-orchestrator',\n      title: '受管 AI 伴生与 Workspace FS 协同协议',\n      module: 'AI 编排',\n      status: 'in_progress',\n      reach: 2400,\n      impact: 2,\n      confidence: 80,\n      effort: 3.5,\n      owner: '陈默',\n      sprint: 'S3 · 体验跃升',\n      summary: '支持独立 AI 伴生插件与项目工作区 FS CAS 双向同步，实现文档草稿审阅与确定性落盘。',\n      lane: { start_week: 5, duration_weeks: 3, progress: 45 },\n      spec: {\n        background: '产品 PRD、架构 ADR 等深度文档场景需要结合工作区文件读写与受管 AI 伴生能力。',\n        user_stories: '作为产品经理，我希望在工作区浏览并导入已有文档，经审阅后以 CAS 方式安全写回项目仓库。',\n        core_flow: '1. 插件调用 nmas.fs.listDir/readText 读取项目工作区文件并获取 SHA-256\\n2. 编辑或通过独立 AI 伴生插件完善内容\\n3. 通过 expected_sha256 或 create_only 原子写回工作区',\n        acceptance_criteria: '1. workspace.fs.* 仅限 project scope 插件且禁止 assistant surface\\n2. 严禁访问 .env / .git / 密钥等敏感路径\\n3. 并发写入冲突时返回确定性 conflict 错误',\n        risks: '需校验父目录存在性且不自动建目录，避免误写至未预期路径。',\n      },\n    },\n    {\n      id: 'req-ui-kit-tokens',\n      title: '插件宿主自适应主题令牌桥接',\n      module: '开发者工具',\n      status: 'planned',\n      reach: 1800,\n      impact: 1,\n      confidence: 90,\n      effort: 1,\n      owner: '陆川',\n      sprint: 'S3 · 体验跃升',\n      summary: '向插件 WebView 注入统一明暗色阶与圆角间距变量，降低社区插件视觉割裂感。',\n      lane: { start_week: 7, duration_weeks: 2, progress: 15 },\n      spec: {\n        background: '社区插件风格参差不齐，尤其在深浅色模式切换时易出现对比度不足问题。',\n        user_stories: '作为插件作者，我希望开箱即用一套精致高对比 CSS 变量，自动跟随桌面端主题。',\n        core_flow: '1. 宿主在 WebView 初始化时注入主题配色 token 与 color-scheme\\n2. 主题切换时通过事件通知插件页面平滑过渡',\n        acceptance_criteria: '1. 深浅色模式正文对比度均 >= 7:1 (WCAG AAA)\\n2. 零外部字体与 CDN 依赖',\n        risks: '需避免覆盖插件自定义主题切换开关的显式选择。',\n      },\n    },\n    {\n      id: 'req-sandbox-audit',\n      title: '可视化沙箱权限与调用审计面板',\n      module: '安全沙箱',\n      status: 'planned',\n      reach: 1500,\n      impact: 2,\n      confidence: 75,\n      effort: 4.5,\n      owner: '周晴',\n      sprint: 'S3 · 体验跃升',\n      summary: '实时记录每个插件的存储读写次数、HTTP 只读请求与 Broker 预算消耗，支持异常一键熔断。',\n      lane: { start_week: 8, duration_weeks: 3, progress: 10 },\n      spec: {\n        background: '企业级用户安装第三方插件前需要明确的可观测性保障，实时掌握数据访问行为。',\n        user_stories: '作为安全敏感用户，我希望随时查看插件最近 50 次调用的耗时、数据读写大小与被拒记录。',\n        core_flow: '1. Broker 层汇总每次调用的延迟、读写字节数与错误码\\n2. 审计面板按插件聚合展示趋势并支持导出诊断报告',\n        acceptance_criteria: '1. 审计日志不记录敏感业务明文，仅记录脱敏元数据\\n2. 异常插件可一键禁用并立即终止后续调用',\n        risks: '高频日志写入不能拖慢主调用路径，需采用环形内存缓冲异步落盘。',\n      },\n    },\n    {\n      id: 'req-cli-debugger',\n      title: '插件热重载 CLI 与模拟器套件',\n      module: '开发者工具',\n      status: 'backlog',\n      reach: 650,\n      impact: 1,\n      confidence: 65,\n      effort: 5.5,\n      owner: '陆川',\n      sprint: 'S4 · 开发者生态',\n      summary: '提供本地热更新、Mock Broker 断点调试与自动化契约验收 CLI，缩短社区开发周期。',\n      lane: { start_week: 10, duration_weeks: 3, progress: 0 },\n      spec: {\n        background: '外部开发者目前需要手工打包并导入桌面端验证 UI 效果，调试反馈链路较长。',\n        user_stories: '作为社区开发者，我希望运行一条命令即可在本地预览 UI 并实时校验 Schema 与字节预算。',\n        core_flow: '1. 监听 manifest/backend/ui 文件变化自动重跑校验器\\n2. 本地启动沙箱代理模拟 nmasPlugin 桥与 CAS 存储',\n        acceptance_criteria: '1. 错误精准定位到具体 Schema 字段与行号\\n2. 零第三方重型依赖，支持 Node 20+ 开箱运行',\n        risks: '本地模拟器行为必须与 macOS 真实宿主保持严格一致，避免误导开发者。',\n      },\n    },\n  ];\n\n  const reqItems = [];\n  const lanes = [];\n  const specScores = {};\n  const specDocs = {};\n  const stamp = today();\n\n  for (const r of rawReqs) {\n    const { value_score, rice, priority } = calcRice(r.reach, r.impact, r.confidence, r.effort);\n    reqItems.push({\n      id: r.id,\n      title: r.title,\n      module: r.module,\n      status: r.status,\n      reach: r.reach,\n      impact: r.impact,\n      confidence: r.confidence,\n      effort: r.effort,\n      value_score,\n      rice,\n      priority,\n      owner: r.owner,\n      sprint: r.sprint,\n      summary: r.summary,\n    });\n    lanes.push({\n      req_id: r.id,\n      lane: r.module,\n      start_week: r.lane.start_week,\n      duration_weeks: r.lane.duration_weeks,\n      progress: r.lane.progress,\n    });\n    const score = calcSpecScore(r.spec);\n    specScores[r.id] = { score, updated_at: stamp };\n    specDocs[r.id] = {\n      schema_version: 1,\n      req_id: r.id,\n      ...r.spec,\n      score,\n      updated_at: stamp,\n    };\n  }\n\n  const roadmap = {\n    schema_version: 1,\n    total_weeks: 12,\n    current_week: 5,\n    milestones: [\n      { id: 'ms-1', title: 'M1 内核冻结', week: 3, color: '#10b981' },\n      { id: 'ms-2', title: 'M2 商店内测', week: 6, color: '#6366f1' },\n      { id: 'ms-3', title: 'M3 v2.0 GA', week: 10, color: '#f59e0b' },\n      { id: 'ms-4', title: 'M4 生态发布', week: 12, color: '#22d3ee' },\n    ],\n    lanes,\n  };\n\n  return { reqItems, roadmap, specScores, specDocs };\n}\n\nexport default async function (request) {\n  const { kind, contribution, input } = request ?? {};\n\n  if (kind === 'action') {\n    if (contribution === 'studio.load') {\n      const reqData = await readReqs();\n      const mapData = await readRoadmap();\n      const specIdx = await readSpecIndex();\n      return {\n        revision: specIdx.revision,\n        kpi: buildKpi(reqData.items, specIdx.scores),\n        requirements: reqData.items,\n        roadmap: mapData.roadmap,\n        spec_scores: specIdx.scores,\n      };\n    }\n\n    if (contribution === 'req.save') {\n      const { expected_revision, id, title, module, status, reach, impact, confidence, effort, owner, sprint, summary } = input;\n      const cleanTitle = title.trim();\n      const cleanId = id.trim();\n      if (!cleanTitle || !/^[a-zA-Z0-9._-]+$/.test(cleanId) || !STATUSES.includes(status)) {\n        return { status: 'invalid_input', revision: expected_revision };\n      }\n      const reqData = await readReqs();\n      if (reqData.revision !== expected_revision) {\n        return { status: 'conflict', revision: reqData.revision };\n      }\n      const mapData = await readRoadmap();\n      const { value_score, rice, priority } = calcRice(reach, impact, confidence, effort);\n      const record = {\n        id: cleanId,\n        title: cleanTitle,\n        module: (module || '核心模块').trim() || '核心模块',\n        status,\n        reach,\n        impact,\n        confidence,\n        effort,\n        value_score,\n        rice,\n        priority,\n        owner: (owner || '').trim(),\n        sprint: (sprint || '').trim(),\n        summary: (summary || '').trim(),\n      };\n      const exists = reqData.items.some(i => i.id === cleanId);\n      if (!exists && reqData.items.length >= MAX_REQS) {\n        return { status: 'limit', revision: reqData.revision };\n      }\n      const nextReqs = exists ? reqData.items.map(i => (i.id === cleanId ? record : i)) : [...reqData.items, record];\n      const w1 = await safeWrite(COL_REQ, KEY_REQ, expected_revision, { schema_version: 1, items: nextReqs });\n      if (!w1.ok) return { status: w1.status, revision: w1.revision };\n\n      // Keep roadmap lane synced\n      let nextRev = w1.revision;\n      const existingLane = mapData.roadmap.lanes.find(l => l.req_id === cleanId);\n      const wantLaneUpdate =\n        !existingLane ||\n        input.start_week !== undefined ||\n        input.duration_weeks !== undefined ||\n        input.progress !== undefined ||\n        existingLane.lane !== record.module;\n      if (wantLaneUpdate) {\n        const defaultProg = status === 'shipped' ? 100 : status === 'review' ? 85 : status === 'in_progress' ? 45 : 0;\n        const laneItem = {\n          req_id: cleanId,\n          lane: record.module,\n          start_week: input.start_week ?? existingLane?.start_week ?? Math.min(mapData.roadmap.total_weeks, mapData.roadmap.current_week),\n          duration_weeks: input.duration_weeks ?? existingLane?.duration_weeks ?? Math.max(1, Math.min(6, Math.ceil(effort))),\n          progress: input.progress ?? existingLane?.progress ?? defaultProg,\n        };\n        const nextLanes = existingLane\n          ? mapData.roadmap.lanes.map(l => (l.req_id === cleanId ? laneItem : l))\n          : [...mapData.roadmap.lanes, laneItem];\n        const w2 = await safeWrite(COL_MAP, KEY_MAP, nextRev, {\n          schema_version: 1,\n          ...mapData.roadmap,\n          lanes: nextLanes,\n        });\n        if (!w2.ok) return { status: w2.status, revision: nextRev };\n        nextRev = w2.revision;\n      }\n      return { status: 'saved', revision: nextRev, rice, priority };\n    }\n\n    if (contribution === 'req.delete') {\n      const { expected_revision, id } = input;\n      const reqData = await readReqs();\n      if (reqData.revision !== expected_revision) return { status: 'conflict', revision: reqData.revision };\n      if (!reqData.items.some(i => i.id === id)) return { status: 'not_found', revision: reqData.revision };\n      const mapData = await readRoadmap();\n      const specIdx = await readSpecIndex();\n\n      const nextReqs = reqData.items.filter(i => i.id !== id);\n      const w1 = await safeWrite(COL_REQ, KEY_REQ, expected_revision, { schema_version: 1, items: nextReqs });\n      if (!w1.ok) return { status: 'conflict', revision: w1.revision };\n      let nextRev = w1.revision;\n\n      if (mapData.roadmap.lanes.some(l => l.req_id === id)) {\n        const nextLanes = mapData.roadmap.lanes.filter(l => l.req_id !== id);\n        const w2 = await safeWrite(COL_MAP, KEY_MAP, nextRev, { schema_version: 1, ...mapData.roadmap, lanes: nextLanes });\n        if (w2.ok) nextRev = w2.revision;\n      }\n\n      if (Object.prototype.hasOwnProperty.call(specIdx.scores, id)) {\n        const nextScores = { ...specIdx.scores };\n        delete nextScores[id];\n        const w3 = await safeWrite(COL_SPEC, KEY_SPEC_IDX, nextRev, { schema_version: 1, scores: nextScores });\n        if (w3.ok) nextRev = w3.revision;\n      }\n      const w4 = await safeDelete(COL_SPEC, `doc:${id}`, nextRev);\n      if (w4.ok) nextRev = w4.revision;\n\n      return { status: 'deleted', revision: nextRev };\n    }\n\n    if (contribution === 'roadmap.save') {\n      const { expected_revision, total_weeks, current_week, milestones, lanes } = input;\n      const mapData = await readRoadmap();\n      if (mapData.revision !== expected_revision) return { status: 'conflict', revision: mapData.revision };\n      const cleanMilestones = milestones.slice(0, 10).map(m => ({\n        id: m.id.trim(),\n        title: m.title.trim(),\n        week: clampNum(Math.round(m.week), 1, total_weeks),\n        color: m.color.trim() || '#6366f1',\n      }));\n      const cleanLanes = lanes.slice(0, MAX_REQS).map(l => ({\n        req_id: l.req_id.trim(),\n        lane: (l.lane || '核心模块').trim(),\n        start_week: clampNum(Math.round(l.start_week), 1, total_weeks),\n        duration_weeks: clampNum(Math.round(l.duration_weeks), 1, 16),\n        progress: clampNum(Math.round(l.progress), 0, 100),\n      }));\n      const w = await safeWrite(COL_MAP, KEY_MAP, expected_revision, {\n        schema_version: 1,\n        total_weeks,\n        current_week: clampNum(current_week, 1, total_weeks),\n        milestones: cleanMilestones,\n        lanes: cleanLanes,\n      });\n      return { status: w.status, revision: w.revision };\n    }\n\n    if (contribution === 'spec.get') {\n      const data = await readSpecDoc(input.req_id);\n      return { revision: data.revision, spec: data.spec };\n    }\n\n    if (contribution === 'spec.save') {\n      const { expected_revision, req_id, background, user_stories, core_flow, acceptance_criteria, risks } = input;\n      const cleanId = req_id.trim();\n      if (!/^[a-zA-Z0-9._-]+$/.test(cleanId)) {\n        return { status: 'invalid_input', revision: expected_revision, score: 0 };\n      }\n      const specIdx = await readSpecIndex();\n      if (specIdx.revision !== expected_revision) {\n        return { status: 'conflict', revision: specIdx.revision, score: specIdx.scores[cleanId]?.score || 0 };\n      }\n      const doc = {\n        schema_version: 1,\n        req_id: cleanId,\n        background: background.trim(),\n        user_stories: user_stories.trim(),\n        core_flow: core_flow.trim(),\n        acceptance_criteria: acceptance_criteria.trim(),\n        risks: risks.trim(),\n        updated_at: today(),\n      };\n      const score = calcSpecScore(doc);\n      doc.score = score;\n\n      const w1 = await safeWrite(COL_SPEC, `doc:${cleanId}`, expected_revision, doc);\n      if (!w1.ok) return { status: w1.status, revision: w1.revision, score };\n\n      const nextScores = { ...specIdx.scores, [cleanId]: { score, updated_at: doc.updated_at } };\n      const w2 = await safeWrite(COL_SPEC, KEY_SPEC_IDX, w1.revision, { schema_version: 1, scores: nextScores });\n      if (!w2.ok) return { status: w2.status, revision: w1.revision, score };\n\n      return { status: 'saved', revision: w2.revision, score };\n    }\n\n    if (contribution === 'studio.seed_demo') {\n      const { expected_revision } = input;\n      const reqData = await readReqs();\n      if (reqData.revision !== expected_revision) {\n        return { status: 'conflict', revision: reqData.revision, seeded_count: 0 };\n      }\n      const demo = buildDemoData();\n      let rev = expected_revision;\n\n      const w1 = await safeWrite(COL_REQ, KEY_REQ, rev, { schema_version: 1, items: demo.reqItems });\n      if (!w1.ok) return { status: w1.status, revision: w1.revision, seeded_count: 0 };\n      rev = w1.revision;\n\n      const w2 = await safeWrite(COL_MAP, KEY_MAP, rev, demo.roadmap);\n      if (!w2.ok) return { status: w2.status, revision: rev, seeded_count: 0 };\n      rev = w2.revision;\n\n      const w3 = await safeWrite(COL_SPEC, KEY_SPEC_IDX, rev, { schema_version: 1, scores: demo.specScores });\n      if (!w3.ok) return { status: w3.status, revision: rev, seeded_count: 0 };\n      rev = w3.revision;\n\n      for (const reqId of Object.keys(demo.specDocs)) {\n        const ws = await safeWrite(COL_SPEC, `doc:${reqId}`, rev, demo.specDocs[reqId]);\n        if (!ws.ok) return { status: ws.status, revision: rev, seeded_count: 0 };\n        rev = ws.revision;\n      }\n\n      return { status: 'seeded', revision: rev, seeded_count: demo.reqItems.length };\n    }\n\n    if (contribution === 'document.list') {\n      const reqData = await readReqs();\n      const specIdx = await readSpecIndex();\n      const items = [];\n      if (reqData.items.length > 0) {\n        items.push({ id: 'all', label: `需求池与路线图总览 (${reqData.items.length} 条需求)` });\n        for (const r of reqData.items) {\n          const sc = specIdx.scores[r.id]?.score || 0;\n          items.push({ id: `prd:${r.id}`, label: `PRD: ${r.title.slice(0, 48)} (${sc}分)` });\n        }\n      }\n      return { items };\n    }\n\n    if (contribution === 'document.export') {\n      const id = input.id;\n      if (id === 'all') {\n        const reqData = await readReqs();\n        const mapData = await readRoadmap();\n        const payload = {\n          format: BUNDLE_FORMAT,\n          version: 1,\n          requirements: reqData.items,\n          roadmap: mapData.roadmap,\n        };\n        const text = JSON.stringify(payload, null, 2);\n        if (jsonBytes(text) > MAX_BYTES) return { error: 'export_too_large' };\n        return { filename: 'product-studio-roadmap.json', text };\n      }\n      if (id.startsWith('prd:')) {\n        const reqId = id.slice(4);\n        const reqData = await readReqs();\n        const req = reqData.items.find(i => i.id === reqId);\n        if (!req) return { error: 'not_found' };\n        const specData = await readSpecDoc(reqId);\n        const payload = {\n          format: PRD_FORMAT,\n          version: 1,\n          requirement: req,\n          spec: specData.spec,\n        };\n        const text = JSON.stringify(payload, null, 2);\n        if (jsonBytes(text) > MAX_BYTES) return { error: 'export_too_large' };\n        return { filename: `prd-${reqId}.json`, text };\n      }\n      return { error: 'not_found' };\n    }\n\n    if (contribution === 'document.import') {\n      let parsed;\n      try {\n        parsed = JSON.parse(input.text);\n      } catch {\n        return { imported: false, reason: 'invalid_json', count: 0 };\n      }\n      if (parsed?.format === BUNDLE_FORMAT && parsed?.version === 1 && Array.isArray(parsed.requirements)) {\n        const reqData = await readReqs();\n        const mapData = await readRoadmap();\n        const byId = new Map(reqData.items.map(i => [i.id, i]));\n        let importedCount = 0;\n        for (let idx = 0; idx < parsed.requirements.length; idx++) {\n          const raw = parsed.requirements[idx];\n          if (typeof raw?.title !== 'string' || !raw.title.trim()) continue;\n          const rid = typeof raw.id === 'string' && /^[a-zA-Z0-9._-]+$/.test(raw.id)\n            ? raw.id.slice(0, 40)\n            : `imp-${Date.now().toString(36)}-${idx}`;\n          const reach = clampNum(Math.round(raw.reach ?? 500), 1, 100000);\n          const impact = clampNum(raw.impact ?? 1, 0.25, 3);\n          const confidence = clampNum(Math.round(raw.confidence ?? 80), 10, 100);\n          const effort = clampNum(raw.effort ?? 2, 0.5, 52);\n          const { value_score, rice, priority } = calcRice(reach, impact, confidence, effort);\n          byId.set(rid, {\n            id: rid,\n            title: raw.title.trim().slice(0, 100),\n            module: typeof raw.module === 'string' && raw.module.trim() ? raw.module.trim().slice(0, 32) : '核心模块',\n            status: STATUSES.includes(raw.status) ? raw.status : 'backlog',\n            reach,\n            impact,\n            confidence,\n            effort,\n            value_score,\n            rice,\n            priority,\n            owner: typeof raw.owner === 'string' ? raw.owner.trim().slice(0, 32) : '',\n            sprint: typeof raw.sprint === 'string' ? raw.sprint.trim().slice(0, 32) : '',\n            summary: typeof raw.summary === 'string' ? raw.summary.trim().slice(0, 160) : '',\n          });\n          importedCount++;\n        }\n        const nextReqs = Array.from(byId.values());\n        if (nextReqs.length > MAX_REQS) return { imported: false, reason: 'limit', count: 0 };\n        const w1 = await safeWrite(COL_REQ, KEY_REQ, reqData.revision, { schema_version: 1, items: nextReqs });\n        if (!w1.ok) return { imported: false, reason: w1.status, count: 0 };\n\n        if (parsed.roadmap && Array.isArray(parsed.roadmap.lanes)) {\n          const totalW = clampNum(Math.round(parsed.roadmap.total_weeks ?? mapData.roadmap.total_weeks), 4, 24);\n          const curW = clampNum(Math.round(parsed.roadmap.current_week ?? mapData.roadmap.current_week), 1, totalW);\n          const laneMap = new Map(mapData.roadmap.lanes.map(l => [l.req_id, l]));\n          for (const l of parsed.roadmap.lanes) {\n            if (typeof l?.req_id !== 'string' || !byId.has(l.req_id)) continue;\n            laneMap.set(l.req_id, {\n              req_id: l.req_id,\n              lane: typeof l.lane === 'string' ? l.lane.slice(0, 32) : byId.get(l.req_id).module,\n              start_week: clampNum(Math.round(l.start_week ?? 1), 1, totalW),\n              duration_weeks: clampNum(Math.round(l.duration_weeks ?? 2), 1, 16),\n              progress: clampNum(Math.round(l.progress ?? 0), 0, 100),\n            });\n          }\n          const ms = Array.isArray(parsed.roadmap.milestones)\n            ? parsed.roadmap.milestones.slice(0, 10).map((m, i) => ({\n                id: typeof m?.id === 'string' && m.id ? m.id.slice(0, 24) : `ms-${i + 1}`,\n                title: typeof m?.title === 'string' && m.title ? m.title.slice(0, 48) : `里程碑 ${i + 1}`,\n                week: clampNum(Math.round(m?.week ?? 1), 1, totalW),\n                color: typeof m?.color === 'string' ? m.color.slice(0, 16) : '#6366f1',\n              }))\n            : mapData.roadmap.milestones;\n          await safeWrite(COL_MAP, KEY_MAP, w1.revision, {\n            schema_version: 1,\n            total_weeks: totalW,\n            current_week: curW,\n            milestones: ms,\n            lanes: Array.from(laneMap.values()),\n          });\n        }\n        return { imported: true, count: importedCount };\n      }\n\n      if (parsed?.format === PRD_FORMAT && parsed?.version === 1 && parsed?.spec && typeof parsed.spec.req_id === 'string') {\n        const reqId = parsed.spec.req_id.trim().slice(0, 40);\n        if (!/^[a-zA-Z0-9._-]+$/.test(reqId)) return { imported: false, reason: 'invalid_document', count: 0 };\n        const specIdx = await readSpecIndex();\n        const doc = {\n          schema_version: 1,\n          req_id: reqId,\n          background: String(parsed.spec.background || '').trim().slice(0, 1400),\n          user_stories: String(parsed.spec.user_stories || '').trim().slice(0, 1400),\n          core_flow: String(parsed.spec.core_flow || '').trim().slice(0, 1400),\n          acceptance_criteria: String(parsed.spec.acceptance_criteria || '').trim().slice(0, 1400),\n          risks: String(parsed.spec.risks || '').trim().slice(0, 1000),\n          updated_at: today(),\n        };\n        doc.score = calcSpecScore(doc);\n        const w1 = await safeWrite(COL_SPEC, `doc:${reqId}`, specIdx.revision, doc);\n        if (!w1.ok) return { imported: false, reason: w1.status, count: 0 };\n        const nextScores = { ...specIdx.scores, [reqId]: { score: doc.score, updated_at: doc.updated_at } };\n        const w2 = await safeWrite(COL_SPEC, KEY_SPEC_IDX, w1.revision, { schema_version: 1, scores: nextScores });\n        return w2.ok ? { imported: true, count: 1 } : { imported: false, reason: w2.status, count: 0 };\n      }\n\n      return { imported: false, reason: 'invalid_document', count: 0 };\n    }\n\n    if (contribution === 'fs_list') {\n      const relPath = typeof input.path === 'string' ? input.path.trim() : '';\n      const limit = input.limit ?? 50;\n      const cursor = input.cursor;\n      try {\n        const res = await globalThis.nmas.fs.listDir({ path: relPath, limit, cursor });\n        return {\n          status: 'ok',\n          path: relPath,\n          entries: res.entries || [],\n          next_cursor: res.next_cursor ?? null,\n        };\n      } catch (err) {\n        const code = err?.code === 'invalid_input' ? 'invalid_input' : 'permission_denied';\n        return { status: code, path: relPath, entries: [], next_cursor: null, error: String(err?.message || code).slice(0, 160) };\n      }\n    }\n\n    if (contribution === 'fs_import_doc') {\n      const relPath = (input.path || '').trim();\n      if (!relPath) {\n        return { status: 'invalid_input', path: '', content: '', size_bytes: 0, sha256: '', format: 'text', error: '缺少文件路径' };\n      }\n      try {\n        const res = await globalThis.nmas.fs.readText({ path: relPath });\n        let format = relPath.toLowerCase().endsWith('.md') ? 'markdown' : 'text';\n        try {\n          const parsed = JSON.parse(res.content);\n          if (parsed?.format === BUNDLE_FORMAT) format = 'bundle_json';\n          else if (parsed?.format === PRD_FORMAT) format = 'prd_json';\n        } catch {\n          // non-JSON content\n        }\n        return {\n          status: 'ok',\n          path: relPath,\n          content: res.content,\n          size_bytes: res.size_bytes,\n          sha256: res.sha256,\n          format,\n        };\n      } catch (err) {\n        const code = err?.code === 'resource_limit' ? 'resource_limit' : err?.code === 'invalid_input' ? 'invalid_input' : 'permission_denied';\n        return { status: code, path: relPath, content: '', size_bytes: 0, sha256: '', format: 'text', error: String(err?.message || code).slice(0, 160) };\n      }\n    }\n\n    if (contribution === 'fs_export_doc') {\n      const docId = (input.id || '').trim();\n      const relPath = (input.path || '').trim();\n      const fmt = input.format === 'json' ? 'json' : 'markdown';\n      const hasCreate = input.create_only === true;\n      const hasSha = typeof input.expected_sha256 === 'string' && /^[0-9a-f]{64}$/.test(input.expected_sha256);\n      if (!relPath || hasCreate === hasSha) {\n        return {\n          status: 'invalid_input',\n          path: relPath,\n          size_bytes: 0,\n          sha256: '',\n          error: 'create_only 与 expected_sha256 必须二选一',\n        };\n      }\n      let content = '';\n      if (docId === 'all') {\n        const reqData = await readReqs();\n        const mapData = await readRoadmap();\n        content = fmt === 'json'\n          ? JSON.stringify({ format: BUNDLE_FORMAT, version: 1, requirements: reqData.items, roadmap: mapData.roadmap }, null, 2)\n          : formatRoadmapMarkdown(reqData.items, mapData.roadmap);\n      } else if (docId.startsWith('prd:')) {\n        const reqId = docId.slice(4);\n        const reqData = await readReqs();\n        const req = reqData.items.find(i => i.id === reqId);\n        if (!req) {\n          return { status: 'not_found', path: relPath, size_bytes: 0, sha256: '', error: '未找到指定需求' };\n        }\n        const specData = await readSpecDoc(reqId);\n        content = fmt === 'json'\n          ? JSON.stringify({ format: PRD_FORMAT, version: 1, requirement: req, spec: specData.spec }, null, 2)\n          : formatPrdMarkdown(req, specData.spec);\n      } else {\n        return { status: 'not_found', path: relPath, size_bytes: 0, sha256: '', error: '不支持的文档标识' };\n      }\n      try {\n        const writeReq = hasCreate\n          ? { path: relPath, content, create_only: true }\n          : { path: relPath, content, expected_sha256: input.expected_sha256 };\n        const receipt = await globalThis.nmas.fs.writeText(writeReq);\n        return { status: 'written', path: relPath, size_bytes: receipt.size_bytes, sha256: receipt.sha256 };\n      } catch (err) {\n        const mapCode = {\n          conflict: 'conflict',\n          resource_limit: 'resource_limit',\n          invalid_input: 'invalid_input',\n          permission_denied: 'permission_denied',\n        };\n        const status = mapCode[err?.code] || 'permission_denied';\n        return { status, path: relPath, size_bytes: 0, sha256: '', error: String(err?.message || status).slice(0, 160) };\n      }\n    }\n  }\n\n  if (kind === 'tool') {\n    if (contribution === 'prd.list') {\n      const reqData = await readReqs();\n      const specIdx = await readSpecIndex();\n      const kw = (input.keyword || '').trim().toLowerCase();\n      const filtered = reqData.items\n        .filter(item => {\n          if (input.status && item.status !== input.status) return false;\n          if (input.priority && item.priority !== input.priority) return false;\n          if (kw) {\n            const hay = `${item.title} ${item.module} ${item.owner} ${item.sprint} ${item.summary}`.toLowerCase();\n            if (!hay.includes(kw)) return false;\n          }\n          return true;\n        })\n        .sort((a, b) => b.rice - a.rice)\n        .map(item => ({\n          id: item.id,\n          title: item.title,\n          module: item.module,\n          status: item.status,\n          rice: item.rice,\n          priority: item.priority,\n          owner: item.owner,\n          sprint: item.sprint,\n          spec_score: specIdx.scores[item.id]?.score || 0,\n        }));\n      const avg_rice = filtered.length === 0 ? 0 : Math.round(filtered.reduce((s, i) => s + i.rice, 0) / filtered.length);\n      return { success: true, status: 'ready', total: filtered.length, avg_rice, items: filtered };\n    }\n\n    if (contribution === 'prd.create') {\n      const cleanTitle = (input.title || '').trim();\n      if (!cleanTitle) return { success: false, status: 'invalid_input' };\n      const reqData = await readReqs();\n      if (reqData.items.length >= MAX_REQS) return { success: false, status: 'limit' };\n      const mapData = await readRoadmap();\n      const id = `req-${Date.now().toString(36)}-${reqData.items.length + 1}`;\n      const status = STATUSES.includes(input.status) ? input.status : 'backlog';\n      const { value_score, rice, priority } = calcRice(input.reach, input.impact, input.confidence, input.effort);\n      const record = {\n        id,\n        title: cleanTitle,\n        module: (input.module || '核心模块').trim() || '核心模块',\n        status,\n        reach: input.reach,\n        impact: input.impact,\n        confidence: input.confidence,\n        effort: input.effort,\n        value_score,\n        rice,\n        priority,\n        owner: (input.owner || '').trim(),\n        sprint: (input.sprint || '').trim(),\n        summary: (input.summary || '').trim(),\n      };\n      const w1 = await safeWrite(COL_REQ, KEY_REQ, reqData.revision, {\n        schema_version: 1,\n        items: [...reqData.items, record],\n      });\n      if (!w1.ok) return { success: false, status: w1.status };\n\n      const laneItem = {\n        req_id: id,\n        lane: record.module,\n        start_week: Math.min(mapData.roadmap.total_weeks, mapData.roadmap.current_week),\n        duration_weeks: Math.max(1, Math.min(6, Math.ceil(input.effort))),\n        progress: status === 'shipped' ? 100 : status === 'in_progress' ? 30 : 0,\n      };\n      await safeWrite(COL_MAP, KEY_MAP, w1.revision, {\n        schema_version: 1,\n        ...mapData.roadmap,\n        lanes: [...mapData.roadmap.lanes, laneItem],\n      });\n\n      return { success: true, status: 'saved', id, rice, priority };\n    }\n  }\n\n  throw new Error(`不支持的调用: ${kind}/${contribution}`);\n}\n","path":"backend/index.js"},{"content":"<!doctype html>\n<html lang=\"zh-CN\" data-theme=\"dark\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>产品需求与路线图设计台</title>\n<style>\n:root{--bg:#0b0e14;--bg-elev:#111622;--bg-card:#151c2b;--bg-hover:#1c2538;--bg-input:#0e131e;--border:#243046;--border-strong:#334362;--fg:#eef2f9;--fg-muted:#93a3bd;--fg-dim:#64748b;--accent:#6366f1;--accent-soft:rgba(99, 102, 241, 0.16);--accent-hover:#818cf8;--cyan:#22d3ee;--emerald:#10b981;--amber:#f59e0b;--rose:#f43f5e;--violet:#a855f7;--shadow:0 10px 30px rgba(0, 0, 0, 0.35);--radius:12px;--radius-sm:8px;font:13px/1.5 -apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"PingFang SC\", \"Segoe UI\", system-ui, sans-serif;}\nhtml[data-theme=\"light\"]{--bg:#f4f6fa;--bg-elev:#ffffff;--bg-card:#ffffff;--bg-hover:#f1f5fb;--bg-input:#f8fafc;--border:#e2e8f0;--border-strong:#cbd5e1;--fg:#0f172a;--fg-muted:#475569;--fg-dim:#64748b;--accent:#4f46e5;--accent-soft:rgba(79, 70, 229, 0.1);--accent-hover:#4338ca;--shadow:0 6px 20px rgba(15, 23, 42, 0.08);}\n*{box-sizing:border-box;}\nhtml, body{height:100%;margin:0;background:var(--bg);color:var(--fg);overflow:hidden;}::-webkit-scrollbar{width:7px;height:7px;}::-webkit-scrollbar-track{background:transparent;}::-webkit-scrollbar-thumb{background:var(--border-strong);border-radius:99px;}\n.app{display:grid;grid-template-columns:212px minmax(0, 1fr);height:100vh;}\n.sidebar{background:var(--bg-elev);border-right:1px solid var(--border);display:flex;flex-direction:column;padding:14px 12px;gap:14px;overflow-y:auto;}\n.brand{display:flex;align-items:center;gap:10px;padding:4px 6px;}\n.brand-icon{width:30px;height:30px;border-radius:9px;flex-shrink:0;background:linear-gradient(135deg, #6366f1, #22d3ee);display:grid;place-items:center;color:#fff;font-weight:800;font-size:13px;box-shadow:0 4px 14px rgba(99, 102, 241, 0.4);}\n.brand-title{font-size:13.5px;font-weight:700;letter-spacing:-0.01em;line-height:1.2;}\n.brand-sub{font-size:11px;color:var(--fg-dim);}\n.nav{display:flex;flex-direction:column;gap:4px;}\n.nav-btn{display:flex;align-items:center;justify-content:space-between;gap:8px;width:100%;border:1px solid transparent;border-radius:9px;padding:9px 10px;background:transparent;color:var(--fg-muted);cursor:pointer;font:inherit;font-weight:500;text-align:left;transition:0.15s ease;}\n.nav-btn:hover{background:var(--bg-hover);color:var(--fg);}\n.nav-btn.active{background:var(--accent-soft);color:var(--fg);border-color:rgba(99, 102, 241, 0.35);font-weight:600;}\n.nav-left{display:flex;align-items:center;gap:8px;}\n.nav-badge{font-size:11px;padding:1px 6px;border-radius:99px;background:var(--bg-card);border:1px solid var(--border);color:var(--fg-muted);}\n.side-section{margin-top:auto;padding-top:12px;border-top:1px solid var(--border);display:flex;flex-direction:column;gap:8px;}\n.side-meta{font-size:11px;color:var(--fg-dim);display:flex;justify-content:space-between;padding:0 4px;}\n.workspace{display:flex;flex-direction:column;min-width:0;height:100vh;overflow:hidden;}\n.topbar{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;padding:11px 18px;border-bottom:1px solid var(--border);background:var(--bg-elev);}\n.top-title{display:flex;align-items:center;gap:10px;}\n.top-title h1{margin:0;font-size:15px;font-weight:700;}\n.rev-pill{font-size:11px;color:var(--fg-muted);background:var(--bg-card);border:1px solid var(--border);border-radius:99px;padding:2px 8px;}\n.top-actions{display:flex;align-items:center;gap:7px;flex-wrap:wrap;}\n.btn{display:inline-flex;align-items:center;gap:5px;border:1px solid var(--border);border-radius:8px;padding:6px 11px;background:var(--bg-card);color:var(--fg);font:inherit;font-weight:500;cursor:pointer;transition:0.15s ease;white-space:nowrap;}\n.btn:hover:not(:disabled){border-color:var(--border-strong);background:var(--bg-hover);}\n.btn.primary{background:var(--accent);border-color:var(--accent);color:#fff;}\n.btn.primary:hover:not(:disabled){background:var(--accent-hover);border-color:var(--accent-hover);}\n.btn.ghost{background:transparent;}\n.btn.danger{color:var(--rose);border-color:rgba(244, 63, 94, 0.35);}\n.btn.danger:hover:not(:disabled){background:rgba(244, 63, 94, 0.12);}\n.btn.sm{padding:4px 8px;font-size:12px;border-radius:7px;}\n.btn:disabled{opacity:0.5;cursor:not-allowed;}\n.kpi-strip{display:grid;grid-template-columns:repeat(4, minmax(0, 1fr));gap:10px;padding:12px 18px 4px;}\n.kpi-card{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:11px 14px;display:flex;flex-direction:column;gap:4px;position:relative;overflow:hidden;}\n.kpi-card::after{content:\"\";position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--kpi-c, var(--accent));}\n.kpi-label{font-size:11.5px;color:var(--fg-muted);display:flex;justify-content:space-between;align-items:center;}\n.kpi-val{font-size:22px;font-weight:800;letter-spacing:-0.02em;line-height:1.15;}\n.kpi-sub{font-size:11px;color:var(--fg-dim);}\n.main-scroll{flex:1;overflow-y:auto;padding:12px 18px 24px;display:flex;flex-direction:column;gap:14px;}\n.card{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:14px;display:flex;flex-direction:column;gap:12px;}\n.card-head{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;}\n.card-title{margin:0;font-size:14px;font-weight:700;display:flex;align-items:center;gap:8px;}\n.card-sub{font-size:12px;color:var(--fg-muted);}\n.overview-grid{display:grid;grid-template-columns:minmax(0, 1.55fr) minmax(260px, 0.85fr);gap:14px;}\n.svg-wrap{position:relative;width:100%;border:1px solid var(--border);border-radius:10px;background:var(--bg-input);overflow:hidden;}\n.svg-wrap svg{display:block;width:100%;height:auto;}\n.tooltip{position:absolute;pointer-events:none;z-index:20;min-width:195px;max-width:260px;background:var(--bg-elev);border:1px solid var(--border-strong);border-radius:10px;padding:9px 11px;box-shadow:var(--shadow);font-size:12px;transition:opacity 0.1s ease;}\n.tooltip[hidden]{display:none;}\n.pill{display:inline-flex;align-items:center;gap:4px;font-size:11px;font-weight:600;padding:2px 7px;border-radius:99px;border:1px solid transparent;white-space:nowrap;}\n.st-backlog{background:rgba(148, 163, 184, 0.14);color:#94a3b8;border-color:rgba(148, 163, 184, 0.3);}\n.st-planned{background:rgba(56, 189, 248, 0.14);color:#38bdf8;border-color:rgba(56, 189, 248, 0.3);}\n.st-in_progress{background:rgba(99, 102, 241, 0.18);color:#818cf8;border-color:rgba(99, 102, 241, 0.38);}\n.st-review{background:rgba(245, 158, 11, 0.16);color:#f59e0b;border-color:rgba(245, 158, 11, 0.35);}\n.st-shipped{background:rgba(16, 185, 129, 0.16);color:#10b981;border-color:rgba(16, 185, 129, 0.35);}\n.p-P0{background:rgba(244, 63, 94, 0.16);color:#fb7185;border-color:rgba(244, 63, 94, 0.35);}\n.p-P1{background:rgba(245, 158, 11, 0.16);color:#fbbf24;border-color:rgba(245, 158, 11, 0.35);}\n.p-P2{background:rgba(99, 102, 241, 0.16);color:#818cf8;border-color:rgba(99, 102, 241, 0.35);}\n.p-P3{background:rgba(148, 163, 184, 0.14);color:#94a3b8;border-color:rgba(148, 163, 184, 0.25);}\n.legend{display:flex;flex-wrap:wrap;gap:10px;font-size:11.5px;color:var(--fg-muted);align-items:center;}\n.legend-dot{width:9px;height:9px;border-radius:50%;display:inline-block;margin-right:4px;}\n.toolbar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;}\ninput[type=\"text\"], input[type=\"search\"], input[type=\"number\"], select, textarea{font:inherit;color:var(--fg);background:var(--bg-input);border:1px solid var(--border);border-radius:8px;padding:6px 10px;outline:none;transition:border-color 0.15s;}\ninput:focus, select:focus, textarea:focus{border-color:var(--accent);}\ntextarea{resize:vertical;line-height:1.55;}\n.filter-pills{display:flex;gap:5px;flex-wrap:wrap;}\n.chip{border:1px solid var(--border);background:var(--bg-input);color:var(--fg-muted);border-radius:99px;padding:4px 10px;font-size:12px;cursor:pointer;font-family:inherit;}\n.chip.active{background:var(--accent-soft);border-color:var(--accent);color:var(--fg);font-weight:600;}\n.req-table{width:100%;border-collapse:collapse;}\n.req-table th{text-align:left;font-size:11.5px;font-weight:600;color:var(--fg-dim);padding:8px 10px;border-bottom:1px solid var(--border);white-space:nowrap;}\n.req-table td{padding:10px;border-bottom:1px solid var(--border);vertical-align:middle;}\n.req-table tbody tr{transition:background 0.12s;cursor:pointer;}\n.req-table tbody tr:hover{background:var(--bg-hover);}\n.req-table tbody tr.selected{background:var(--accent-soft);}\n.rice-meter{display:flex;align-items:center;gap:8px;}\n.bar-bg{flex:1;min-width:52px;height:6px;border-radius:99px;background:var(--bg-input);border:1px solid var(--border);overflow:hidden;}\n.bar-fill{height:100%;border-radius:99px;background:linear-gradient(90deg, #6366f1, #22d3ee);}\n.rank-list{display:flex;flex-direction:column;gap:8px;max-height:360px;overflow-y:auto;}\n.rank-item{border:1px solid var(--border);border-radius:10px;padding:10px 11px;background:var(--bg-input);display:flex;flex-direction:column;gap:5px;cursor:pointer;transition:0.15s;}\n.rank-item:hover{border-color:var(--accent);background:var(--bg-hover);}\n.rank-top{display:flex;justify-content:space-between;align-items:center;gap:8px;}\n.prd-layout{display:grid;grid-template-columns:245px minmax(0, 1fr);gap:14px;min-height:460px;}\n.prd-picker{display:flex;flex-direction:column;gap:6px;max-height:600px;overflow-y:auto;}\n.prd-pick{text-align:left;width:100%;border:1px solid var(--border);border-radius:9px;padding:9px 10px;background:var(--bg-input);color:var(--fg);cursor:pointer;display:flex;flex-direction:column;gap:4px;}\n.prd-pick:hover{border-color:var(--border-strong);}\n.prd-pick.active{border-color:var(--accent);background:var(--accent-soft);}\n.prd-form{display:flex;flex-direction:column;gap:12px;}\n.field{display:flex;flex-direction:column;gap:5px;}\n.field-label{font-size:12px;font-weight:600;color:var(--fg-muted);display:flex;justify-content:space-between;align-items:center;}\n.score-ring{display:inline-flex;align-items:center;gap:8px;padding:4px 10px;border-radius:99px;background:var(--bg-input);border:1px solid var(--border);font-weight:700;font-size:12.5px;}\n.gantt-controls{display:grid;grid-template-columns:repeat(auto-fit, minmax(150px, 1fr));gap:10px;padding:12px;border:1px solid var(--border);border-radius:10px;background:var(--bg-input);}\n.empty-state{padding:40px 20px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:10px;border:1px dashed var(--border-strong);border-radius:var(--radius);background:var(--bg-input);}\n.empty-state h3{margin:0;font-size:15px;}\n.empty-state p{margin:0;color:var(--fg-muted);max-width:440px;}\n.modal-backdrop{position:fixed;inset:0;background:rgba(5, 8, 15, 0.68);backdrop-filter:blur(4px);display:grid;place-items:center;z-index:50;padding:16px;}\n.modal-backdrop[hidden]{display:none;}\n.modal{width:min(640px, 100%);max-height:88vh;overflow-y:auto;background:var(--bg-elev);border:1px solid var(--border-strong);border-radius:14px;padding:16px 18px;box-shadow:var(--shadow);display:flex;flex-direction:column;gap:12px;}\n.form-grid{display:grid;grid-template-columns:repeat(2, minmax(0, 1fr));gap:10px;}\n.rice-preview{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;padding:10px 12px;border-radius:10px;background:var(--accent-soft);border:1px solid rgba(99, 102, 241, 0.35);}\n.toast{position:fixed;right:18px;bottom:18px;z-index:60;padding:9px 14px;border-radius:10px;background:var(--bg-elev);border:1px solid var(--border-strong);box-shadow:var(--shadow);font-size:12.5px;font-weight:500;max-width:360px;transition:opacity 0.2s;}\n.toast[data-type=\"error\"]{border-color:var(--rose);color:var(--rose);}\n.toast[data-type=\"ok\"]{border-color:var(--emerald);color:var(--emerald);}\n.toast[hidden]{display:none;}\n[hidden]{display:none !important;}\n@media (max-width:820px){.app{grid-template-columns:1fr;grid-template-rows:auto 1fr;}\n.sidebar{flex-direction:row;align-items:center;overflow-x:auto;padding:8px 12px;border-right:none;border-bottom:1px solid var(--border);}\n.brand-sub, .side-section{display:none;}\n.nav{flex-direction:row;}\n.kpi-strip{grid-template-columns:repeat(2, minmax(0, 1fr));}\n.overview-grid, .prd-layout{grid-template-columns:1fr;}\n.form-grid{grid-template-columns:1fr;}\n}\n</style>\n</head>\n<body>\n<div class=\"app\">\n<aside class=\"sidebar\">\n<div class=\"brand\">\n<div class=\"brand-icon\">PS</div>\n<div>\n<div class=\"brand-title\">Product Studio</div>\n<div class=\"brand-sub\">需求 · RICE · 路线图 · PRD</div>\n</div>\n</div>\n<nav class=\"nav\" aria-label=\"主导航\">\n<button class=\"nav-btn active\" data-view=\"overview\" type=\"button\">\n<span class=\"nav-left\"><span>◈</span><span>RICE 矩阵总览</span></span>\n<span class=\"nav-badge\" id=\"nav-count-all\">0</span>\n</button>\n<button class=\"nav-btn\" data-view=\"backlog\" type=\"button\">\n<span class=\"nav-left\"><span>☰</span><span>需求池与打分</span></span>\n<span class=\"nav-badge\" id=\"nav-count-p0\">P0:0</span>\n</button>\n<button class=\"nav-btn\" data-view=\"roadmap\" type=\"button\">\n<span class=\"nav-left\"><span>▤</span><span>甘特图路线图</span></span>\n<span class=\"nav-badge\" id=\"nav-week-tag\">W5</span>\n</button>\n<button class=\"nav-btn\" data-view=\"prd\" type=\"button\">\n<span class=\"nav-left\"><span>✎</span><span>PRD 规格文档</span></span>\n<span class=\"nav-badge\" id=\"nav-prd-score\">0%</span>\n</button>\n</nav>\n<div class=\"side-section\">\n<div class=\"side-meta\"><span>作用域</span><span>Project 隔离</span></div>\n<div class=\"side-meta\"><span>Agent Tools</span><span>prd.list / create</span></div>\n<button id=\"btn-seed-side\" class=\"btn sm\" type=\"button\" style=\"justify-content:center\">✦ 加载行业演示数据</button>\n</div>\n</aside>\n<div class=\"workspace\">\n<header class=\"topbar\">\n<div class=\"top-title\">\n<h1 id=\"view-heading\">总览与 RICE 优先级矩阵</h1>\n<span class=\"rev-pill\" id=\"rev-badge\">修订 #0</span>\n</div>\n<div class=\"top-actions\">\n<button id=\"btn-seed\" class=\"btn sm\" type=\"button\">✦ 演示数据集</button>\n<button id=\"btn-io\" class=\"btn sm\" type=\"button\">⇅ 导入 / 导出</button>\n<button id=\"btn-theme\" class=\"btn sm ghost\" type=\"button\" title=\"切换明暗主题\">☀ 浅色</button>\n<button id=\"btn-new-req\" class=\"btn sm primary\" type=\"button\">+ 新建需求</button>\n</div>\n</header>\n<section class=\"kpi-strip\" aria-label=\"关键指标\">\n<div class=\"kpi-card\" style=\"--kpi-c:#6366f1\">\n<div class=\"kpi-label\"><span>总需求数</span><span>Backlog → Shipped</span></div>\n<div class=\"kpi-val\" id=\"kpi-total\">0</div>\n<div class=\"kpi-sub\" id=\"kpi-total-sub\">项目级隔离存储</div>\n</div>\n<div class=\"kpi-card\" style=\"--kpi-c:#22d3ee\">\n<div class=\"kpi-label\"><span>推进中 / 评审</span><span>Active Sprint</span></div>\n<div class=\"kpi-val\" id=\"kpi-active\">0</div>\n<div class=\"kpi-sub\" id=\"kpi-active-sub\">含开发中与待验收</div>\n</div>\n<div class=\"kpi-card\" style=\"--kpi-c:#10b981\">\n<div class=\"kpi-label\"><span>已交付上线</span><span>Shipped</span></div>\n<div class=\"kpi-val\" id=\"kpi-shipped\">0</div>\n<div class=\"kpi-sub\" id=\"kpi-shipped-sub\">交付率 0%</div>\n</div>\n<div class=\"kpi-card\" style=\"--kpi-c:#f59e0b\">\n<div class=\"kpi-label\"><span>平均 RICE 评分</span><span>PRD 完整度</span></div>\n<div class=\"kpi-val\" id=\"kpi-rice\">0</div>\n<div class=\"kpi-sub\" id=\"kpi-prd-sub\">平均文档完整度 0 分</div>\n</div>\n</section>\n<main class=\"main-scroll\">\n<section id=\"view-overview\" class=\"view-pane\">\n<div id=\"empty-overview\" class=\"empty-state\" hidden>\n<h3>欢迎来到产品需求与路线图设计台</h3>\n<p>当前项目尚未录入需求。你可以一键加载「AI 桌面插件平台 v2.0」行业级演示数据集（含 8 条需求、多泳道甘特排期与 8 篇完整 PRD），或直接新建第一条需求。</p>\n<div class=\"toolbar\">\n<button id=\"btn-seed-empty\" class=\"btn primary\" type=\"button\">✦ 一键加载 v2.0 演示数据集</button>\n<button id=\"btn-new-empty\" class=\"btn\" type=\"button\">+ 创建首条需求</button>\n</div>\n</div>\n<div id=\"overview-content\" class=\"overview-grid\">\n<div class=\"card\">\n<div class=\"card-head\">\n<div>\n<h2 class=\"card-title\">RICE 四象限价值矩阵</h2>\n<div class=\"card-sub\">横轴：Effort 工作量（人周）· 纵轴：价值分（Reach × Impact × Confidence%）· 气泡大小映射 RICE 分</div>\n</div>\n<div class=\"legend\">\n<span><i class=\"legend-dot\" style=\"background:#10b981\"></i>已交付</span>\n<span><i class=\"legend-dot\" style=\"background:#f59e0b\"></i>评审中</span>\n<span><i class=\"legend-dot\" style=\"background:#6366f1\"></i>进行中</span>\n<span><i class=\"legend-dot\" style=\"background:#38bdf8\"></i>已排期</span>\n<span><i class=\"legend-dot\" style=\"background:#94a3b8\"></i>需求池</span>\n</div>\n</div>\n<div class=\"svg-wrap\" id=\"rice-wrap\">\n<svg id=\"rice-svg\" viewBox=\"0 0 760 410\" role=\"img\" aria-label=\"RICE 四象限气泡散点图\"></svg>\n<div id=\"rice-tip\" class=\"tooltip\" hidden></div>\n</div>\n</div>\n<div class=\"card\">\n<div class=\"card-head\">\n<h2 class=\"card-title\">优先级焦点与详情</h2>\n<span class=\"card-sub\" id=\"focus-hint\">点击气泡或条目进入 PRD</span>\n</div>\n<div id=\"focus-box\" style=\"display:flex;flex-direction:column;gap:8px\"></div>\n<div class=\"card-head\" style=\"margin-top:4px\">\n<h2 class=\"card-title\">Top RICE 排行</h2>\n</div>\n<div id=\"rank-list\" class=\"rank-list\"></div>\n</div>\n</div>\n</section>\n<section id=\"view-backlog\" class=\"view-pane\" hidden>\n<div class=\"card\">\n<div class=\"card-head\">\n<div class=\"toolbar\" style=\"flex:1\">\n<input id=\"search-req\" type=\"search\" placeholder=\"搜索需求标题、模块、负责人或迭代…\" style=\"min-width:210px;flex:1;max-width:340px\">\n<select id=\"sort-req\" aria-label=\"排序方式\">\n<option value=\"rice_desc\">按 RICE 分降序</option>\n<option value=\"rice_asc\">按 RICE 分升序</option>\n<option value=\"effort_asc\">按工作量升序</option>\n<option value=\"status\">按状态分组</option>\n</select>\n</div>\n<div class=\"filter-pills\" id=\"status-filters\">\n<button class=\"chip active\" data-st=\"all\" type=\"button\">全部</button>\n<button class=\"chip\" data-st=\"backlog\" type=\"button\">需求池</button>\n<button class=\"chip\" data-st=\"planned\" type=\"button\">已排期</button>\n<button class=\"chip\" data-st=\"in_progress\" type=\"button\">进行中</button>\n<button class=\"chip\" data-st=\"review\" type=\"button\">评审中</button>\n<button class=\"chip\" data-st=\"shipped\" type=\"button\">已交付</button>\n</div>\n</div>\n<div style=\"overflow-x:auto\">\n<table class=\"req-table\">\n<thead>\n<tr>\n<th>需求 / 模块</th>\n<th>状态</th>\n<th>RICE 分 & 建议等级</th>\n<th>R / I / C / E</th>\n<th>负责人 / 迭代</th>\n<th>PRD 完整度</th>\n<th>操作</th>\n</tr>\n</thead>\n<tbody id=\"req-tbody\"></tbody>\n</table>\n</div>\n</div>\n</section>\n<section id=\"view-roadmap\" class=\"view-pane\" hidden>\n<div class=\"card\">\n<div class=\"card-head\">\n<div>\n<h2 class=\"card-title\">多泳道甘特图路线图 (SVG)</h2>\n<div class=\"card-sub\">按产品模块分组排期，展示里程碑菱形标记、当前周进度线及状态色带；点击任意排期条调整起止周与完成度</div>\n</div>\n<div class=\"toolbar\">\n<label style=\"display:flex;align-items:center;gap:6px;font-size:12px;color:var(--fg-muted)\">\n当前周 W<strong id=\"cur-week-lbl\" style=\"color:var(--fg)\">5</strong>\n<input id=\"cur-week-range\" type=\"range\" min=\"1\" max=\"12\" value=\"5\" style=\"width:90px\">\n</label>\n<button id=\"btn-save-roadmap\" class=\"btn sm primary\" type=\"button\">保存排期</button>\n</div>\n</div>\n<div class=\"svg-wrap\" id=\"gantt-wrap\">\n<svg id=\"gantt-svg\" viewBox=\"0 0 860 380\" role=\"img\" aria-label=\"多泳道甘特图路线图\"></svg>\n<div id=\"gantt-tip\" class=\"tooltip\" hidden></div>\n</div>\n<div id=\"lane-editor\" class=\"gantt-controls\" hidden>\n<div class=\"field\">\n<span class=\"field-label\">选中排期需求</span>\n<strong id=\"le-title\" style=\"padding:5px 0;font-size:13px\">-</strong>\n</div>\n<div class=\"field\">\n<span class=\"field-label\">开始周 (W1-W12)</span>\n<input id=\"le-start\" type=\"number\" min=\"1\" max=\"24\" value=\"1\">\n</div>\n<div class=\"field\">\n<span class=\"field-label\">持续周数</span>\n<input id=\"le-dur\" type=\"number\" min=\"1\" max=\"16\" value=\"2\">\n</div>\n<div class=\"field\">\n<span class=\"field-label\">进度 (<span id=\"le-prog-val\">0</span>%)</span>\n<input id=\"le-prog\" type=\"range\" min=\"0\" max=\"100\" value=\"0\">\n</div>\n<div class=\"field\" style=\"justify-content:flex-end;flex-direction:row;align-items:flex-end;gap:6px\">\n<button id=\"le-apply\" class=\"btn sm primary\" type=\"button\">应用并保存</button>\n<button id=\"le-open-prd\" class=\"btn sm\" type=\"button\">打开 PRD</button>\n</div>\n</div>\n</div>\n</section>\n<section id=\"view-prd\" class=\"view-pane\" hidden>\n<div class=\"prd-layout\">\n<div class=\"card\">\n<div class=\"card-head\">\n<h2 class=\"card-title\">选择需求</h2>\n<span class=\"card-sub\" id=\"prd-count-lbl\">0 条</span>\n</div>\n<div id=\"prd-picker\" class=\"prd-picker\"></div>\n</div>\n<div class=\"card\">\n<div class=\"card-head\">\n<div>\n<h2 class=\"card-title\" id=\"prd-title\">请选择一条需求</h2>\n<div class=\"card-sub\" id=\"prd-meta\">在左侧点击需求加载结构化 PRD 规格</div>\n</div>\n<div class=\"toolbar\">\n<span class=\"score-ring\" id=\"prd-score-badge\">完整度 0 / 100</span>\n<button id=\"btn-prd-insert\" class=\"btn sm\" type=\"button\" hidden>↗ 插入会话</button>\n<button id=\"btn-prd-copy\" class=\"btn sm\" type=\"button\">复制 Markdown</button>\n<button id=\"btn-prd-save\" class=\"btn sm primary\" type=\"button\">保存 PRD</button>\n</div>\n</div>\n<div id=\"prd-editor-body\" class=\"prd-form\">\n<div class=\"field\">\n<div class=\"field-label\"><span>1. 背景与业务目标 (20分)</span><span id=\"sc-bg\">0/20</span></div>\n<textarea id=\"sp-bg\" rows=\"3\" maxlength=\"1400\" placeholder=\"说明当前痛点、为什么现在做、核心衡量指标…\"></textarea>\n</div>\n<div class=\"field\">\n<div class=\"field-label\"><span>2. 用户故事与角色场景 (20分)</span><span id=\"sc-us\">0/20</span></div>\n<textarea id=\"sp-us\" rows=\"3\" maxlength=\"1400\" placeholder=\"作为 [角色]，我希望 [能力]，以便 [业务价值]…\"></textarea>\n</div>\n<div class=\"field\">\n<div class=\"field-label\"><span>3. 核心业务流程与交互 (20分)</span><span id=\"sc-cf\">0/20</span></div>\n<textarea id=\"sp-cf\" rows=\"3\" maxlength=\"1400\" placeholder=\"1. 入口触发 -> 2. 状态流转 -> 3. 数据落盘与异常兜底…\"></textarea>\n</div>\n<div class=\"field\">\n<div class=\"field-label\"><span>4. 验收标准 Acceptance Criteria (25分)</span><span id=\"sc-ac\">0/25</span></div>\n<textarea id=\"sp-ac\" rows=\"4\" maxlength=\"1400\" placeholder=\"逐条列出可量化、可测试的验收条件（建议至少 3 条）…\"></textarea>\n</div>\n<div class=\"field\">\n<div class=\"field-label\"><span>5. 边界条件、依赖与风险 (15分)</span><span id=\"sc-rk\">0/15</span></div>\n<textarea id=\"sp-rk\" rows=\"3\" maxlength=\"1000\" placeholder=\"列出并发冲突、权限约束、容量边界及降级策略…\"></textarea>\n</div>\n</div>\n</div>\n</div>\n</section>\n</main>\n</div>\n</div>\n<div id=\"modal-req\" class=\"modal-backdrop\" hidden>\n<div class=\"modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"m-req-title\">\n<div class=\"card-head\">\n<h2 class=\"card-title\" id=\"m-req-title\">新建产品需求</h2>\n<button id=\"m-req-close\" class=\"btn sm ghost\" type=\"button\">✕</button>\n</div>\n<div class=\"form-grid\">\n<label class=\"field\" style=\"grid-column:1/-1\">\n<span class=\"field-label\">需求标题 *</span>\n<input id=\"f-title\" type=\"text\" maxlength=\"100\" placeholder=\"例如：QuickJS 零冷启动沙箱内核\">\n</label>\n<label class=\"field\">\n<span class=\"field-label\">所属模块 / 泳道</span>\n<input id=\"f-module\" type=\"text\" maxlength=\"32\" placeholder=\"运行时内核 / 安全沙箱 / 插件生态\">\n</label>\n<label class=\"field\">\n<span class=\"field-label\">当前状态</span>\n<select id=\"f-status\">\n<option value=\"backlog\">需求池 (Backlog)</option>\n<option value=\"planned\">已排期 (Planned)</option>\n<option value=\"in_progress\">进行中 (In Progress)</option>\n<option value=\"review\">评审中 (Review)</option>\n<option value=\"shipped\">已交付 (Shipped)</option>\n</select>\n</label>\n<label class=\"field\">\n<span class=\"field-label\">负责人</span>\n<input id=\"f-owner\" type=\"text\" maxlength=\"32\" placeholder=\"例如：林晓\">\n</label>\n<label class=\"field\">\n<span class=\"field-label\">目标迭代</span>\n<input id=\"f-sprint\" type=\"text\" maxlength=\"32\" placeholder=\"例如：S2 · 存储与安全\">\n</label>\n<label class=\"field\">\n<span class=\"field-label\">Reach 月触达用户数 (1-100000)</span>\n<input id=\"f-reach\" type=\"number\" min=\"1\" max=\"100000\" value=\"1500\">\n</label>\n<label class=\"field\">\n<span class=\"field-label\">Impact 影响力系数</span>\n<select id=\"f-impact\">\n<option value=\"3\">3.0 · 变革性影响</option>\n<option value=\"2\" selected>2.0 · 高影响</option>\n<option value=\"1\">1.0 · 中等影响</option>\n<option value=\"0.5\">0.5 · 低影响</option>\n<option value=\"0.25\">0.25 · 极微影响</option>\n</select>\n</label>\n<label class=\"field\">\n<span class=\"field-label\">Confidence 信心度 (<span id=\"f-conf-lbl\">80</span>%)</span>\n<input id=\"f-conf\" type=\"range\" min=\"10\" max=\"100\" step=\"5\" value=\"80\">\n</label>\n<label class=\"field\">\n<span class=\"field-label\">Effort 工作量 (人周 0.5-52)</span>\n<input id=\"f-effort\" type=\"number\" min=\"0.5\" max=\"52\" step=\"0.5\" value=\"2\">\n</label>\n<div class=\"rice-preview\" style=\"grid-column:1/-1\">\n<div>\n<div style=\"font-size:11.5px;color:var(--fg-muted)\">RICE 实时打分 = (Reach × Impact × Confidence%) / Effort</div>\n<div style=\"font-size:16px;font-weight:800;margin-top:2px\">RICE: <span id=\"prev-rice\">1200</span> · 价值分: <span id=\"prev-val\">2400</span></div>\n</div>\n<span id=\"prev-pri\" class=\"pill p-P0\">P0 · 立即排期</span>\n</div>\n<label class=\"field\" style=\"grid-column:1/-1\">\n<span class=\"field-label\">一句话核心说明</span>\n<input id=\"f-summary\" type=\"text\" maxlength=\"160\" placeholder=\"简述该需求解决的核心问题与预期收益…\">\n</label>\n</div>\n<div class=\"card-head\" style=\"margin-top:4px\">\n<button id=\"m-req-del\" class=\"btn danger\" type=\"button\" hidden>删除需求</button>\n<div class=\"toolbar\" style=\"margin-left:auto\">\n<button id=\"m-req-cancel\" class=\"btn\" type=\"button\">取消</button>\n<button id=\"m-req-save\" class=\"btn primary\" type=\"button\">保存需求</button>\n</div>\n</div>\n</div>\n</div>\n<div id=\"modal-io\" class=\"modal-backdrop\" hidden>\n<div class=\"modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"m-io-title\">\n<div class=\"card-head\">\n<h2 class=\"card-title\" id=\"m-io-title\">导入 / 导出产品文档 (JSON)</h2>\n<button id=\"m-io-close\" class=\"btn sm ghost\" type=\"button\">✕</button>\n</div>\n<div class=\"field\">\n<span class=\"field-label\">选择导出文档</span>\n<div class=\"toolbar\">\n<select id=\"io-select\" style=\"flex:1\"></select>\n<button id=\"io-export\" class=\"btn sm primary\" type=\"button\">导出预览</button>\n<button id=\"io-copy\" class=\"btn sm\" type=\"button\">复制 JSON</button>\n</div>\n</div>\n<div class=\"field\">\n<span class=\"field-label\">JSON 内容（可直接粘贴导出的 Bundle 或单篇 PRD JSON 进行导入）</span>\n<textarea id=\"io-text\" rows=\"10\" placeholder=\"点击「导出预览」查看当前项目数据，或在此粘贴 JSON 后点击「执行导入」…\"></textarea>\n</div>\n<div class=\"card-head\">\n<span class=\"card-sub\" id=\"io-hint\">单次导入/导出上限 240 KiB (V2)</span>\n<div class=\"toolbar\">\n<button id=\"io-import\" class=\"btn primary\" type=\"button\">执行导入</button>\n</div>\n</div>\n<div style=\"border-top:1px solid var(--border);padding-top:12px;display:flex;flex-direction:column;gap:8px\">\n<div class=\"field-label\"><span>项目工作区文件同步 (V2 Workspace FS)</span><span id=\"fs-sha-hint\" style=\"font-weight:400;color:var(--fg-dim)\">支持新建或 CAS 覆盖发布</span></div>\n<div class=\"toolbar\">\n<input id=\"fs-dir\" type=\"text\" placeholder=\"工作区目录（空表示根目录，如 docs）\" style=\"flex:1;min-width:140px\">\n<button id=\"fs-btn-list\" class=\"btn sm\" type=\"button\">浏览目录</button>\n</div>\n<div id=\"fs-entries\" style=\"display:flex;flex-wrap:wrap;gap:6px;font-size:11.5px;color:var(--fg-muted)\"></div>\n<div class=\"toolbar\">\n<input id=\"fs-path\" type=\"text\" placeholder=\"相对路径，如 docs/prd-roadmap.md\" style=\"flex:1;min-width:160px\">\n<select id=\"fs-fmt\" aria-label=\"同步格式\">\n<option value=\"markdown\">Markdown</option>\n<option value=\"json\">JSON</option>\n</select>\n<button id=\"fs-btn-read\" class=\"btn sm\" type=\"button\">从项目读取</button>\n<button id=\"fs-btn-write\" class=\"btn sm primary\" type=\"button\">发布到项目</button>\n</div>\n</div>\n</div>\n</div>\n<div id=\"toast\" class=\"toast\" role=\"status\" hidden></div>\n<script>\n(() => {\nconst plugin = globalThis.nmasPlugin;\nconst $ = id => document.getElementById(id);\nconst SVG_NS = 'http://www.w3.org/2000/svg';\nconst ST_META = {\nbacklog: { label: '需求池', color: '#94a3b8' },\nplanned: { label: '已排期', color: '#38bdf8' },\nin_progress: { label: '进行中', color: '#6366f1' },\nreview: { label: '评审中', color: '#f59e0b' },\nshipped: { label: '已交付', color: '#10b981' },\n};\nconst VIEW_TITLES = {\noverview: '总览与 RICE 优先级矩阵',\nbacklog: '需求池与 RICE 打分引擎',\nroadmap: '多泳道甘特图路线图',\nprd: 'PRD 结构化规格编辑器',\n};\nconst state = {\nview: 'overview',\nrevision: 0,\nkpi: { total: 0, in_progress: 0, shipped: 0, avg_rice: 0, avg_spec_score: 0 },\nrequirements: [],\nroadmap: { total_weeks: 12, current_week: 5, milestones: [], lanes: [] },\nspecScores: {},\nselectedId: null,\neditingId: null,\nselectedLaneId: null,\ncurrentSpec: null,\nfilterStatus: 'all',\nsearch: '',\nsortBy: 'rice_desc',\ncanInsert: false,\nbusy: false,\n};\nlet toastTimer = null;\nfunction toast(msg, type = 'info') {\nconst el = $('toast');\nel.textContent = msg;\nel.dataset.type = type;\nel.hidden = false;\nclearTimeout(toastTimer);\ntoastTimer = setTimeout(() => { el.hidden = true; }, 3200);\n}\nfunction esc(s) {\nreturn String(s ?? '').replace(/[&<>\"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]));\n}\nfunction svgEl(tag, attrs = {}, text = '') {\nconst node = document.createElementNS(SVG_NS, tag);\nfor (const [k, v] of Object.entries(attrs)) node.setAttribute(k, String(v));\nif (text) node.textContent = text;\nreturn node;\n}\nfunction calcRiceLocal(reach, impact, conf, effort) {\nconst val = Math.round(reach * impact * (conf / 100));\nconst rice = Math.round(val / Math.max(0.5, effort));\nconst pri = rice >= 1200 ? 'P0' : rice >= 600 ? 'P1' : rice >= 250 ? 'P2' : 'P3';\nreturn { val, rice, pri };\n}\nfunction calcSpecSections(sp) {\nconst len = s => Array.from((s || '').trim()).length;\nconst lines = s => (s || '').trim().split(/\\r?\\n/).filter(l => l.trim()).length;\nconst bg = len(sp.background) >= 35 ? 20 : len(sp.background) >= 15 ? 10 : 0;\nconst us = len(sp.user_stories) >= 35 ? 20 : len(sp.user_stories) >= 15 ? 10 : 0;\nconst cf = (len(sp.core_flow) >= 40 || lines(sp.core_flow) >= 2) ? 20 : len(sp.core_flow) >= 15 ? 10 : 0;\nconst ac = (len(sp.acceptance_criteria) >= 40 || lines(sp.acceptance_criteria) >= 2) ? 25 : (len(sp.acceptance_criteria) >= 15 || lines(sp.acceptance_criteria) >= 1) ? 12 : 0;\nconst rk = len(sp.risks) >= 25 ? 15 : len(sp.risks) >= 10 ? 8 : 0;\nreturn { bg, us, cf, ac, rk, total: Math.min(100, bg + us + cf + ac + rk) };\n}\nfunction switchView(v) {\nstate.view = v;\n$('view-heading').textContent = VIEW_TITLES[v] || '';\ndocument.querySelectorAll('.nav-btn').forEach(b => b.classList.toggle('active', b.dataset.view === v));\ndocument.querySelectorAll('.view-pane').forEach(p => { p.hidden = p.id !== `view-${v}`; });\nrenderCurrentView();\n}\nfunction renderChrome() {\n$('rev-badge').textContent = `修订 #${state.revision}`;\n$('kpi-total').textContent = String(state.kpi.total);\n$('kpi-active').textContent = String(state.kpi.in_progress);\n$('kpi-shipped').textContent = String(state.kpi.shipped);\n$('kpi-rice').textContent = String(state.kpi.avg_rice);\nconst pct = state.kpi.total ? Math.round((state.kpi.shipped * 100) / state.kpi.total) : 0;\n$('kpi-shipped-sub').textContent = `交付率 ${pct}%`;\n$('kpi-prd-sub').textContent = `平均 PRD 完整度 ${state.kpi.avg_spec_score} 分`;\nconst p0Count = state.requirements.filter(r => r.priority === 'P0').length;\n$('nav-count-all').textContent = String(state.requirements.length);\n$('nav-count-p0').textContent = `P0:${p0Count}`;\n$('nav-week-tag').textContent = `W${state.roadmap.current_week}`;\n$('nav-prd-score').textContent = `${state.kpi.avg_spec_score}%`;\n$('btn-prd-insert').hidden = !state.canInsert;\n}\nfunction renderCurrentView() {\nrenderChrome();\nif (state.view === 'overview') renderOverview();\nelse if (state.view === 'backlog') renderBacklog();\nelse if (state.view === 'roadmap') renderRoadmap();\nelse if (state.view === 'prd') renderPrdPicker();\n}\nfunction renderOverview() {\nconst hasData = state.requirements.length > 0;\n$('empty-overview').hidden = hasData;\n$('overview-content').hidden = !hasData;\nif (!hasData) return;\nif (!state.selectedId || !state.requirements.some(r => r.id === state.selectedId)) {\nconst top = [...state.requirements].sort((a, b) => b.rice - a.rice)[0];\nstate.selectedId = top ? top.id : null;\n}\nrenderRiceSvg();\nrenderFocusAndRank();\n}\nfunction renderRiceSvg() {\nconst svg = $('rice-svg');\nsvg.replaceChildren();\nconst W = 760, H = 410;\nconst pad = { l: 64, r: 28, t: 28, b: 46 };\nconst pw = W - pad.l - pad.r;\nconst ph = H - pad.t - pad.b;\nconst reqs = state.requirements;\nconst maxEff = Math.max(6, ...reqs.map(r => r.effort)) * 1.15;\nconst maxVal = Math.max(2000, ...reqs.map(r => r.value_score)) * 1.15;\nconst midEff = maxEff * 0.48;\nconst midVal = maxVal * 0.45;\nconst maxRice = Math.max(500, ...reqs.map(r => r.rice));\nconst xOf = eff => pad.l + (eff / maxEff) * pw;\nconst yOf = val => pad.t + ph - (val / maxVal) * ph;\nconst mx = xOf(midEff);\nconst my = yOf(midVal);\nsvg.appendChild(svgEl('rect', { x: pad.l, y: pad.t, width: mx - pad.l, height: my - pad.t, fill: 'rgba(16,185,129,0.08)' }));\nsvg.appendChild(svgEl('rect', { x: mx, y: pad.t, width: pad.l + pw - mx, height: my - pad.t, fill: 'rgba(99,102,241,0.08)' }));\nsvg.appendChild(svgEl('rect', { x: pad.l, y: my, width: mx - pad.l, height: pad.t + ph - my, fill: 'rgba(148,163,184,0.05)' }));\nsvg.appendChild(svgEl('rect', { x: mx, y: my, width: pad.l + pw - mx, height: pad.t + ph - my, fill: 'rgba(244,63,94,0.07)' }));\nfor (let i = 0; i <= 4; i++) {\nconst gy = pad.t + (ph * i) / 4;\nsvg.appendChild(svgEl('line', { x1: pad.l, y1: gy, x2: pad.l + pw, y2: gy, stroke: 'var(--border)', 'stroke-width': 1 }));\nconst valLbl = Math.round(maxVal * (1 - i / 4));\nsvg.appendChild(svgEl('text', { x: pad.l - 8, y: gy + 4, 'text-anchor': 'end', fill: 'var(--fg-dim)', 'font-size': 10.5 }, valLbl >= 1000 ? `${(valLbl / 1000).toFixed(1)}k` : String(valLbl)));\n}\nfor (let i = 0; i <= 5; i++) {\nconst gx = pad.l + (pw * i) / 5;\nsvg.appendChild(svgEl('line', { x1: gx, y1: pad.t, x2: gx, y2: pad.t + ph, stroke: 'var(--border)', 'stroke-width': 1 }));\nconst effLbl = ((maxEff * i) / 5).toFixed(1);\nsvg.appendChild(svgEl('text', { x: gx, y: pad.t + ph + 18, 'text-anchor': 'middle', fill: 'var(--fg-dim)', 'font-size': 10.5 }, `${effLbl}w`));\n}\nsvg.appendChild(svgEl('line', { x1: mx, y1: pad.t, x2: mx, y2: pad.t + ph, stroke: 'var(--border-strong)', 'stroke-dasharray': '5 4', 'stroke-width': 1.2 }));\nsvg.appendChild(svgEl('line', { x1: pad.l, y1: my, x2: pad.l + pw, y2: my, stroke: 'var(--border-strong)', 'stroke-dasharray': '5 4', 'stroke-width': 1.2 }));\nsvg.appendChild(svgEl('text', { x: pad.l + 10, y: pad.t + 18, fill: '#10b981', 'font-size': 11, 'font-weight': 700 }, '★ 速赢高价值 (Quick Wins)'));\nsvg.appendChild(svgEl('text', { x: pad.l + pw - 10, y: pad.t + 18, 'text-anchor': 'end', fill: '#818cf8', 'font-size': 11, 'font-weight': 700 }, '◆ 战略大项目 (Big Bets)'));\nsvg.appendChild(svgEl('text', { x: pad.l + 10, y: pad.t + ph - 10, fill: '#94a3b8', 'font-size': 11, 'font-weight': 600 }, '○ 轻量补充项 (Fill-ins)'));\nsvg.appendChild(svgEl('text', { x: pad.l + pw - 10, y: pad.t + ph - 10, 'text-anchor': 'end', fill: '#fb7185', 'font-size': 11, 'font-weight': 600 }, '△ 高耗低效区 (Reconsider)'));\nsvg.appendChild(svgEl('text', { x: pad.l + pw / 2, y: H - 8, 'text-anchor': 'middle', fill: 'var(--fg-muted)', 'font-size': 11.5, 'font-weight': 600 }, 'Effort 工作量（人周）→'));\nconst yAxisText = svgEl('text', { x: 16, y: pad.t + ph / 2, 'text-anchor': 'middle', fill: 'var(--fg-muted)', 'font-size': 11.5, 'font-weight': 600, transform: `rotate(-90 16 ${pad.t + ph / 2})` }, '价值分 (Reach×Impact×Conf%) →');\nsvg.appendChild(yAxisText);\nconst tip = $('rice-tip');\nconst wrap = $('rice-wrap');\nfor (const r of reqs) {\nconst cx = xOf(r.effort);\nconst cy = yOf(r.value_score);\nconst radius = 11 + Math.round((r.rice / maxRice) * 16);\nconst color = ST_META[r.status]?.color || '#6366f1';\nconst isSel = r.id === state.selectedId;\nconst g = svgEl('g', { style: 'cursor:pointer' });\nif (isSel) {\ng.appendChild(svgEl('circle', { cx, cy, r: radius + 6, fill: 'none', stroke: color, 'stroke-width': 2, 'stroke-opacity': 0.75, 'stroke-dasharray': '3 2' }));\n}\nconst c = svgEl('circle', {\ncx, cy, r: radius, fill: color, 'fill-opacity': isSel ? 0.92 : 0.72,\nstroke: isSel ? '#ffffff' : color, 'stroke-width': isSel ? 2.2 : 1.4,\n});\ng.appendChild(c);\ng.appendChild(svgEl('text', { x: cx, y: cy + 3.5, 'text-anchor': 'middle', fill: '#ffffff', 'font-size': 10, 'font-weight': 700, style: 'pointer-events:none' }, r.priority));\nconst shortTitle = r.title.length > 10 ? `${r.title.slice(0, 10)}…` : r.title;\nconst lblX = cx + radius + 6 > W - 80 ? cx - radius - 6 : cx + radius + 6;\nconst anchor = cx + radius + 6 > W - 80 ? 'end' : 'start';\ng.appendChild(svgEl('text', { x: lblX, y: cy + 4, 'text-anchor': anchor, fill: 'var(--fg)', 'font-size': 11, 'font-weight': isSel ? 700 : 500 }, shortTitle));\ng.addEventListener('mouseenter', ev => {\nc.setAttribute('fill-opacity', '0.98');\ntip.innerHTML = `\n<div style=\"font-weight:700;margin-bottom:4px\">${esc(r.title)}</div>\n<div style=\"display:flex;gap:5px;margin-bottom:5px\">\n<span class=\"pill p-${esc(r.priority)}\">${esc(r.priority)}</span>\n<span class=\"pill st-${esc(r.status)}\">${esc(ST_META[r.status]?.label || r.status)}</span>\n</div>\n<div style=\"color:var(--fg-muted)\">RICE: <strong style=\"color:var(--fg)\">${r.rice}</strong> · 价值分: ${r.value_score}</div>\n<div style=\"color:var(--fg-muted)\">Effort: ${r.effort}人周 · 负责人: ${esc(r.owner || '未指派')}</div>\n`;\ntip.hidden = false;\nconst rect = wrap.getBoundingClientRect();\nconst tx = Math.min(rect.width - 230, Math.max(8, ev.clientX - rect.left + 14));\nconst ty = Math.min(rect.height - 110, Math.max(8, ev.clientY - rect.top - 10));\ntip.style.left = `${tx}px`;\ntip.style.top = `${ty}px`;\n});\ng.addEventListener('mouseleave', () => {\nc.setAttribute('fill-opacity', isSel ? '0.92' : '0.72');\ntip.hidden = true;\n});\ng.addEventListener('click', () => {\nstate.selectedId = r.id;\nrenderRiceSvg();\nrenderFocusAndRank();\n});\nsvg.appendChild(g);\n}\n}\nfunction renderFocusAndRank() {\nconst focusBox = $('focus-box');\nconst sel = state.requirements.find(r => r.id === state.selectedId);\nif (sel) {\nconst sc = state.specScores[sel.id]?.score || 0;\nfocusBox.innerHTML = `\n<div class=\"rank-item\" style=\"border-color:var(--accent);background:var(--accent-soft);cursor:default\">\n<div class=\"rank-top\">\n<strong style=\"font-size:13.5px\">${esc(sel.title)}</strong>\n<span class=\"pill p-${esc(sel.priority)}\">${esc(sel.priority)} · ${sel.rice}</span>\n</div>\n<div style=\"font-size:12px;color:var(--fg-muted)\">${esc(sel.summary || '暂无简介')}</div>\n<div style=\"display:flex;gap:6px;flex-wrap:wrap;font-size:11.5px;color:var(--fg-muted)\">\n<span class=\"pill st-${esc(sel.status)}\">${esc(ST_META[sel.status]?.label || sel.status)}</span>\n<span>模块：${esc(sel.module)}</span>\n<span>工作量：${sel.effort}w</span>\n<span>PRD：${sc}分</span>\n</div>\n<div class=\"toolbar\" style=\"margin-top:4px\">\n<button class=\"btn sm primary\" id=\"focus-open-prd\" type=\"button\">✎ 打开 PRD 编辑器</button>\n<button class=\"btn sm\" id=\"focus-edit-req\" type=\"button\">编辑打分</button>\n</div>\n</div>\n`;\n$('focus-open-prd').addEventListener('click', () => openPrdFor(sel.id));\n$('focus-edit-req').addEventListener('click', () => openReqModal(sel));\n} else {\nfocusBox.innerHTML = '';\n}\nconst list = $('rank-list');\nlist.replaceChildren();\nconst sorted = [...state.requirements].sort((a, b) => b.rice - a.rice);\nfor (const r of sorted) {\nconst div = document.createElement('div');\ndiv.className = 'rank-item';\nif (r.id === state.selectedId) div.style.borderColor = 'var(--accent)';\nconst sc = state.specScores[r.id]?.score || 0;\ndiv.innerHTML = `\n<div class=\"rank-top\">\n<strong style=\"font-size:12.5px\">${esc(r.title)}</strong>\n<span class=\"pill p-${esc(r.priority)}\">${r.rice}</span>\n</div>\n<div class=\"rank-top\" style=\"font-size:11.5px;color:var(--fg-muted)\">\n<span>${esc(r.module)} · ${esc(r.sprint || '未排迭代')}</span>\n<span>PRD ${sc}%</span>\n</div>\n`;\ndiv.addEventListener('click', () => {\nstate.selectedId = r.id;\nrenderRiceSvg();\nrenderFocusAndRank();\n});\nlist.appendChild(div);\n}\n}\nfunction renderBacklog() {\nconst tbody = $('req-tbody');\ntbody.replaceChildren();\nconst kw = state.search.trim().toLowerCase();\nlet list = state.requirements.filter(r => {\nif (state.filterStatus !== 'all' && r.status !== state.filterStatus) return false;\nif (kw) {\nconst hay = `${r.title} ${r.module} ${r.owner} ${r.sprint} ${r.summary}`.toLowerCase();\nif (!hay.includes(kw)) return false;\n}\nreturn true;\n});\nif (state.sortBy === 'rice_desc') list.sort((a, b) => b.rice - a.rice);\nelse if (state.sortBy === 'rice_asc') list.sort((a, b) => a.rice - b.rice);\nelse if (state.sortBy === 'effort_asc') list.sort((a, b) => a.effort - b.effort);\nelse if (state.sortBy === 'status') {\nconst order = { in_progress: 0, review: 1, planned: 2, backlog: 3, shipped: 4 };\nlist.sort((a, b) => (order[a.status] ?? 9) - (order[b.status] ?? 9));\n}\nconst maxRice = Math.max(100, ...state.requirements.map(r => r.rice));\nif (!list.length) {\nconst tr = document.createElement('tr');\ntr.innerHTML = `<td colspan=\"7\" style=\"text-align:center;color:var(--fg-dim);padding:28px\">暂无符合条件的需求</td>`;\ntbody.appendChild(tr);\nreturn;\n}\nfor (const r of list) {\nconst tr = document.createElement('tr');\nif (r.id === state.selectedId) tr.className = 'selected';\nconst sc = state.specScores[r.id]?.score || 0;\nconst pct = Math.min(100, Math.round((r.rice * 100) / maxRice));\ntr.innerHTML = `\n<td>\n<div style=\"font-weight:600\">${esc(r.title)}</div>\n<div style=\"font-size:11.5px;color:var(--fg-dim)\">${esc(r.module)} · ${esc(r.summary || '')}</div>\n</td>\n<td><span class=\"pill st-${esc(r.status)}\">${esc(ST_META[r.status]?.label || r.status)}</span></td>\n<td>\n<div class=\"rice-meter\">\n<span class=\"pill p-${esc(r.priority)}\">${esc(r.priority)}</span>\n<strong style=\"min-width:44px\">${r.rice}</strong>\n<div class=\"bar-bg\"><div class=\"bar-fill\" style=\"width:${pct}%\"></div></div>\n</div>\n</td>\n<td style=\"font-size:11.5px;color:var(--fg-muted);white-space:nowrap\">${r.reach} / ${r.impact}× / ${r.confidence}% / ${r.effort}w</td>\n<td style=\"font-size:12px\">\n<div>${esc(r.owner || '-')}</div>\n<div style=\"font-size:11px;color:var(--fg-dim)\">${esc(r.sprint || '-')}</div>\n</td>\n<td><span class=\"pill\" style=\"background:var(--bg-input);border-color:var(--border);color:${sc >= 80 ? '#10b981' : sc >= 40 ? '#f59e0b' : 'var(--fg-muted)'}\">${sc} 分</span></td>\n<td style=\"white-space:nowrap\">\n<button class=\"btn sm\" data-act=\"edit\" type=\"button\">编辑</button>\n<button class=\"btn sm\" data-act=\"prd\" type=\"button\">PRD</button>\n</td>\n`;\ntr.querySelector('[data-act=\"edit\"]').addEventListener('click', e => { e.stopPropagation(); openReqModal(r); });\ntr.querySelector('[data-act=\"prd\"]').addEventListener('click', e => { e.stopPropagation(); openPrdFor(r.id); });\ntr.addEventListener('click', () => { state.selectedId = r.id; openReqModal(r); });\ntbody.appendChild(tr);\n}\n}\nfunction renderRoadmap() {\nconst svg = $('gantt-svg');\nsvg.replaceChildren();\nconst rm = state.roadmap;\nconst totalWeeks = Math.max(8, rm.total_weeks || 12);\n$('cur-week-range').max = String(totalWeeks);\n$('cur-week-range').value = String(rm.current_week || 1);\n$('cur-week-lbl').textContent = String(rm.current_week || 1);\nconst reqById = new Map(state.requirements.map(r => [r.id, r]));\nconst lanes = rm.lanes.filter(l => reqById.has(l.req_id));\nconst groups = new Map();\nfor (const l of lanes) {\nconst gName = l.lane || reqById.get(l.req_id).module || '默认泳道';\nif (!groups.has(gName)) groups.set(gName, []);\ngroups.get(gName).push(l);\n}\nconst rows = [];\nfor (const [gName, items] of groups.entries()) {\nitems.sort((a, b) => a.start_week - b.start_week);\nrows.push({ kind: 'group', label: gName, count: items.length });\nfor (const item of items) rows.push({ kind: 'bar', lane: item, req: reqById.get(item.req_id) });\n}\nconst W = 860;\nconst leftCol = 215;\nconst topHead = 58;\nconst rowH = 34;\nconst H = Math.max(240, topHead + rows.length * rowH + 26);\nsvg.setAttribute('viewBox', `0 0 ${W} ${H}`);\nconst gridW = W - leftCol - 20;\nconst weekW = gridW / totalWeeks;\nconst xWeek = w => leftCol + (w - 1) * weekW;\nsvg.appendChild(svgEl('rect', { x: 0, y: 0, width: W, height: topHead, fill: 'var(--bg-elev)' }));\nsvg.appendChild(svgEl('line', { x1: 0, y1: topHead, x2: W, y2: topHead, stroke: 'var(--border-strong)', 'stroke-width': 1 }));\nsvg.appendChild(svgEl('line', { x1: leftCol, y1: 0, x2: leftCol, y2: H, stroke: 'var(--border-strong)', 'stroke-width': 1 }));\nsvg.appendChild(svgEl('text', { x: 14, y: 35, fill: 'var(--fg-muted)', 'font-size': 12, 'font-weight': 700 }, '模块泳道 / 需求条目'));\nfor (let w = 1; w <= totalWeeks; w++) {\nconst x = xWeek(w);\nif (w % 2 === 0) {\nsvg.appendChild(svgEl('rect', { x, y: topHead, width: weekW, height: H - topHead, fill: 'rgba(148,163,184,0.03)' }));\n}\nsvg.appendChild(svgEl('line', { x1: x, y1: topHead - 18, x2: x, y2: H, stroke: 'var(--border)', 'stroke-width': 1 }));\nsvg.appendChild(svgEl('text', { x: x + weekW / 2, y: topHead - 6, 'text-anchor': 'middle', fill: 'var(--fg-dim)', 'font-size': 10.5, 'font-weight': 600 }, `W${w}`));\n}\nfor (const ms of rm.milestones || []) {\nconst mx = xWeek(ms.week) + weekW * 0.5;\nsvg.appendChild(svgEl('line', { x1: mx, y1: 24, x2: mx, y2: H, stroke: ms.color || '#6366f1', 'stroke-opacity': 0.25, 'stroke-dasharray': '3 3', 'stroke-width': 1.2 }));\nsvg.appendChild(svgEl('polygon', { points: `${mx},12 ${mx + 6},18 ${mx},24 ${mx - 6},18`, fill: ms.color || '#6366f1' }));\nsvg.appendChild(svgEl('text', { x: mx + 9, y: 21, fill: ms.color || '#6366f1', 'font-size': 10, 'font-weight': 700 }, ms.title));\n}\nconst tip = $('gantt-tip');\nconst wrap = $('gantt-wrap');\nrows.forEach((row, idx) => {\nconst y = topHead + idx * rowH;\nif (row.kind === 'group') {\nsvg.appendChild(svgEl('rect', { x: 0, y, width: W, height: rowH, fill: 'rgba(99,102,241,0.07)' }));\nsvg.appendChild(svgEl('text', { x: 14, y: y + 21, fill: 'var(--accent-hover)', 'font-size': 11.5, 'font-weight': 700 }, `▸ ${row.label} (${row.count})`));\nsvg.appendChild(svgEl('line', { x1: 0, y1: y + rowH, x2: W, y2: y + rowH, stroke: 'var(--border)', 'stroke-width': 1 }));\n} else {\nconst { lane, req } = row;\nconst color = ST_META[req.status]?.color || '#6366f1';\nconst isSel = state.selectedLaneId === lane.req_id;\nif (isSel) svg.appendChild(svgEl('rect', { x: 0, y, width: W, height: rowH, fill: 'var(--accent-soft)' }));\nsvg.appendChild(svgEl('line', { x1: 0, y1: y + rowH, x2: W, y2: y + rowH, stroke: 'var(--border)', 'stroke-width': 0.8 }));\nconst shortName = req.title.length > 14 ? `${req.title.slice(0, 14)}…` : req.title;\nsvg.appendChild(svgEl('text', { x: 20, y: y + 21, fill: 'var(--fg)', 'font-size': 11.5, 'font-weight': isSel ? 700 : 500 }, shortName));\nconst bx = xWeek(lane.start_week) + 2;\nconst bw = Math.max(18, lane.duration_weeks * weekW - 4);\nconst by = y + 6;\nconst bh = rowH - 12;\nconst g = svgEl('g', { style: 'cursor:pointer' });\ng.appendChild(svgEl('rect', {\nx: bx, y: by, width: bw, height: bh, rx: 6,\nfill: color, 'fill-opacity': 0.24, stroke: isSel ? '#ffffff' : color, 'stroke-width': isSel ? 1.8 : 1.1,\n}));\nconst progW = Math.round((bw * Math.min(100, Math.max(0, lane.progress))) / 100);\nif (progW > 0) {\ng.appendChild(svgEl('rect', { x: bx, y: by, width: progW, height: bh, rx: 6, fill: color, 'fill-opacity': 0.85 }));\n}\ng.appendChild(svgEl('text', { x: bx + 8, y: by + 15, fill: '#ffffff', 'font-size': 10.5, 'font-weight': 700, style: 'pointer-events:none' }, `${req.priority} · ${lane.progress}%`));\ng.addEventListener('mouseenter', ev => {\ntip.innerHTML = `\n<div style=\"font-weight:700;margin-bottom:3px\">${esc(req.title)}</div>\n<div style=\"color:var(--fg-muted)\">周期：W${lane.start_week} → W${lane.start_week + lane.duration_weeks - 1}（${lane.duration_weeks} 周）</div>\n<div style=\"color:var(--fg-muted)\">进度：${lane.progress}% · RICE：${req.rice} · ${esc(req.owner || '')}</div>\n`;\ntip.hidden = false;\nconst rect = wrap.getBoundingClientRect();\ntip.style.left = `${Math.min(rect.width - 230, Math.max(8, ev.clientX - rect.left + 12))}px`;\ntip.style.top = `${Math.min(rect.height - 90, Math.max(8, ev.clientY - rect.top - 10))}px`;\n});\ng.addEventListener('mouseleave', () => { tip.hidden = true; });\ng.addEventListener('click', () => selectLaneEditor(lane, req));\nsvg.appendChild(g);\n}\n});\nconst curX = xWeek(rm.current_week) + weekW * 0.5;\nsvg.appendChild(svgEl('line', { x1: curX, y1: topHead - 18, x2: curX, y2: H, stroke: '#f43f5e', 'stroke-width': 2 }));\nsvg.appendChild(svgEl('rect', { x: curX - 24, y: topHead - 36, width: 48, height: 17, rx: 8, fill: '#f43f5e' }));\nsvg.appendChild(svgEl('text', { x: curX, y: topHead - 24, 'text-anchor': 'middle', fill: '#ffffff', 'font-size': 10, 'font-weight': 700 }, `当前 W${rm.current_week}`));\nif (!rows.length) {\nsvg.appendChild(svgEl('text', { x: W / 2, y: 140, 'text-anchor': 'middle', fill: 'var(--fg-dim)', 'font-size': 13 }, '暂无排期数据，请先新建需求或加载演示数据集'));\n}\n}\nfunction selectLaneEditor(lane, req) {\nstate.selectedLaneId = lane.req_id;\n$('lane-editor').hidden = false;\n$('le-title').textContent = `${req.title} (${req.priority})`;\n$('le-start').value = String(lane.start_week);\n$('le-dur').value = String(lane.duration_weeks);\n$('le-prog').value = String(lane.progress);\n$('le-prog-val').textContent = String(lane.progress);\nrenderRoadmap();\n}\nfunction renderPrdPicker() {\nconst box = $('prd-picker');\nbox.replaceChildren();\n$('prd-count-lbl').textContent = `${state.requirements.length} 条`;\nif (!state.requirements.length) {\nbox.innerHTML = `<div style=\"color:var(--fg-dim);font-size:12px;padding:12px\">暂无需求</div>`;\n$('prd-title').textContent = '暂无可选需求';\n$('prd-meta').textContent = '请先创建需求或加载演示数据';\nreturn;\n}\nif (!state.selectedId || !state.requirements.some(r => r.id === state.selectedId)) {\nstate.selectedId = state.requirements[0].id;\n}\nfor (const r of state.requirements) {\nconst btn = document.createElement('button');\nbtn.type = 'button';\nbtn.className = `prd-pick${r.id === state.selectedId ? ' active' : ''}`;\nconst sc = state.specScores[r.id]?.score || 0;\nbtn.innerHTML = `\n<div style=\"display:flex;justify-content:space-between;gap:6px;align-items:center\">\n<strong style=\"font-size:12.5px\">${esc(r.title)}</strong>\n<span class=\"pill p-${esc(r.priority)}\">${esc(r.priority)}</span>\n</div>\n<div style=\"display:flex;justify-content:space-between;font-size:11px;color:var(--fg-muted)\">\n<span>${esc(r.module)}</span>\n<span style=\"color:${sc >= 80 ? '#10b981' : sc >= 40 ? '#f59e0b' : 'var(--fg-dim)'}\">完整度 ${sc}%</span>\n</div>\n`;\nbtn.addEventListener('click', () => loadSpec(r.id));\nbox.appendChild(btn);\n}\nif (!state.currentSpec || state.currentSpec.req_id !== state.selectedId) {\nvoid loadSpec(state.selectedId);\n}\n}\nasync function openPrdFor(reqId) {\nstate.selectedId = reqId;\nswitchView('prd');\nawait loadSpec(reqId);\n}\nasync function loadSpec(reqId) {\nstate.selectedId = reqId;\nconst req = state.requirements.find(r => r.id === reqId);\nif (!req) return;\n$('prd-title').textContent = req.title;\n$('prd-meta').textContent = `${req.module} · ${req.priority} (RICE ${req.rice}) · 负责人 ${req.owner || '未指派'} · ${req.sprint || '未排迭代'}`;\ndocument.querySelectorAll('.prd-pick').forEach((el, idx) => {\nel.classList.toggle('active', state.requirements[idx]?.id === reqId);\n});\ntry {\nconst res = await plugin.action('spec.get', { req_id: reqId });\nstate.revision = res.revision;\nstate.currentSpec = res.spec;\n$('sp-bg').value = res.spec.background || '';\n$('sp-us').value = res.spec.user_stories || '';\n$('sp-cf').value = res.spec.core_flow || '';\n$('sp-ac').value = res.spec.acceptance_criteria || '';\n$('sp-rk').value = res.spec.risks || '';\nupdateSpecScoreLive();\n} catch (e) {\ntoast(`读取 PRD 失败：${e?.message || '未知错误'}`, 'error');\n}\n}\nfunction updateSpecScoreLive() {\nconst s = calcSpecSections({\nbackground: $('sp-bg').value,\nuser_stories: $('sp-us').value,\ncore_flow: $('sp-cf').value,\nacceptance_criteria: $('sp-ac').value,\nrisks: $('sp-rk').value,\n});\n$('sc-bg').textContent = `${s.bg}/20`;\n$('sc-us').textContent = `${s.us}/20`;\n$('sc-cf').textContent = `${s.cf}/20`;\n$('sc-ac').textContent = `${s.ac}/25`;\n$('sc-rk').textContent = `${s.rk}/15`;\nconst badge = $('prd-score-badge');\nbadge.textContent = `完整度 ${s.total} / 100`;\nbadge.style.color = s.total >= 80 ? '#10b981' : s.total >= 40 ? '#f59e0b' : 'var(--fg-muted)';\n}\nfunction buildPrdMarkdown() {\nconst req = state.requirements.find(r => r.id === state.selectedId);\nif (!req) return '';\nreturn [\n`# PRD: ${req.title}`,\n`- 模块：${req.module} | 优先级：${req.priority} (RICE ${req.rice}) | 负责人：${req.owner || '-'} | 迭代：${req.sprint || '-'}`,\n'',\n'## 1. 背景与目标',\n$('sp-bg').value.trim() || '（待补充）',\n'',\n'## 2. 用户故事',\n$('sp-us').value.trim() || '（待补充）',\n'',\n'## 3. 核心业务流程',\n$('sp-cf').value.trim() || '（待补充）',\n'',\n'## 4. 验收标准 (AC)',\n$('sp-ac').value.trim() || '（待补充）',\n'',\n'## 5. 边界与风险',\n$('sp-rk').value.trim() || '（待补充）',\n].join('\\n');\n}\nfunction updateRiceModalPreview() {\nconst reach = Math.max(1, Number($('f-reach').value) || 1);\nconst impact = Number($('f-impact').value) || 1;\nconst conf = Number($('f-conf').value) || 80;\nconst effort = Math.max(0.5, Number($('f-effort').value) || 1);\n$('f-conf-lbl').textContent = String(conf);\nconst { val, rice, pri } = calcRiceLocal(reach, impact, conf, effort);\n$('prev-rice').textContent = String(rice);\n$('prev-val').textContent = String(val);\nconst priMap = { P0: 'P0 · 立即排期', P1: 'P1 · 重点推进', P2: 'P2 · 常规排期', P3: 'P3 · 暂缓观察' };\nconst el = $('prev-pri');\nel.className = `pill p-${pri}`;\nel.textContent = priMap[pri];\n}\nfunction openReqModal(req = null) {\nstate.editingId = req ? req.id : null;\n$('m-req-title').textContent = req ? '编辑需求与 RICE 评分' : '新建产品需求';\n$('f-title').value = req?.title || '';\n$('f-module').value = req?.module || '运行时内核';\n$('f-status').value = req?.status || 'planned';\n$('f-owner').value = req?.owner || '';\n$('f-sprint').value = req?.sprint || 'S2 · 插件生态';\n$('f-reach').value = String(req?.reach ?? 1500);\n$('f-impact').value = String(req?.impact ?? 2);\n$('f-conf').value = String(req?.confidence ?? 80);\n$('f-effort').value = String(req?.effort ?? 2);\n$('f-summary').value = req?.summary || '';\n$('m-req-del').hidden = !req;\nupdateRiceModalPreview();\n$('modal-req').hidden = false;\n$('f-title').focus();\n}\nasync function loadAll(preferId = null) {\nif (typeof plugin?.action !== 'function') {\ntoast('请在 Velai Desktop 中打开此插件。', 'error');\nreturn;\n}\ntry {\nconst caps = await plugin.action('host.capabilities', {}).catch(() => ({ actions: [] }));\nstate.canInsert = Array.isArray(caps?.actions) && caps.actions.includes('host.draft.insert');\nconst res = await plugin.action('studio.load', {});\nstate.revision = res.revision;\nstate.kpi = res.kpi;\nstate.requirements = res.requirements;\nstate.roadmap = res.roadmap;\nstate.specScores = res.spec_scores || {};\nif (preferId && state.requirements.some(r => r.id === preferId)) state.selectedId = preferId;\nrenderCurrentView();\n} catch (e) {\ntoast(`加载数据失败：${e?.message || '未知错误'}`, 'error');\n}\n}\nasync function seedDemo() {\nif (state.busy) return;\nstate.busy = true;\ntry {\nconst res = await plugin.action('studio.seed_demo', { expected_revision: state.revision });\nif (res.status === 'seeded') {\nstate.currentSpec = null;\nawait loadAll();\ntoast(`已加载「AI 桌面插件平台 v2.0」演示数据集（${res.seeded_count} 条需求与完整 PRD）`, 'ok');\n} else if (res.status === 'conflict') {\nawait loadAll();\ntoast('数据版本有变化，已刷新，请再次点击加载。', 'error');\n} else {\ntoast(`加载未完成：${res.status}`, 'error');\n}\n} catch (e) {\ntoast(`加载演示数据失败：${e?.message || '未知错误'}`, 'error');\n} finally {\nstate.busy = false;\n}\n}\ndocument.querySelectorAll('.nav-btn').forEach(btn => {\nbtn.addEventListener('click', () => switchView(btn.dataset.view));\n});\n$('btn-theme').addEventListener('click', () => {\nconst isDark = document.documentElement.dataset.theme !== 'light';\ndocument.documentElement.dataset.theme = isDark ? 'light' : 'dark';\n$('btn-theme').textContent = isDark ? '☾ 深色' : '☀ 浅色';\n});\n$('btn-seed').addEventListener('click', seedDemo);\n$('btn-seed-side').addEventListener('click', seedDemo);\n$('btn-seed-empty').addEventListener('click', seedDemo);\n$('btn-new-req').addEventListener('click', () => openReqModal(null));\n$('btn-new-empty').addEventListener('click', () => openReqModal(null));\n$('m-req-close').addEventListener('click', () => { $('modal-req').hidden = true; });\n$('m-req-cancel').addEventListener('click', () => { $('modal-req').hidden = true; });\n['f-reach', 'f-impact', 'f-conf', 'f-effort'].forEach(id => $(id).addEventListener('input', updateRiceModalPreview));\n$('m-req-save').addEventListener('click', async () => {\nif (state.busy) return;\nconst title = $('f-title').value.trim();\nif (!title) { toast('请填写需求标题。', 'error'); return; }\nstate.busy = true;\ntry {\nconst id = state.editingId || `req-${Date.now().toString(36)}`;\nconst res = await plugin.action('req.save', {\nexpected_revision: state.revision,\nid,\ntitle,\nmodule: $('f-module').value.trim() || '核心模块',\nstatus: $('f-status').value,\nreach: Math.max(1, Math.round(Number($('f-reach').value) || 1)),\nimpact: Number($('f-impact').value) || 1,\nconfidence: Math.round(Number($('f-conf').value) || 80),\neffort: Math.max(0.5, Number($('f-effort').value) || 1),\nowner: $('f-owner').value.trim(),\nsprint: $('f-sprint').value.trim(),\nsummary: $('f-summary').value.trim(),\n});\nif (res.status === 'saved') {\n$('modal-req').hidden = true;\nawait loadAll(id);\ntoast(`已保存需求（RICE ${res.rice} · ${res.priority}）`, 'ok');\n} else {\ntoast(`保存未完成：${res.status}`, 'error');\nif (res.status === 'conflict') await loadAll();\n}\n} catch (e) {\ntoast(`保存失败：${e?.message || '未知错误'}`, 'error');\n} finally { state.busy = false; }\n});\n$('m-req-del').addEventListener('click', async () => {\nif (state.busy || !state.editingId) return;\nstate.busy = true;\ntry {\nconst res = await plugin.action('req.delete', { expected_revision: state.revision, id: state.editingId });\nif (res.status === 'deleted') {\n$('modal-req').hidden = true;\nstate.currentSpec = null;\nawait loadAll();\ntoast('已删除需求及关联排期。', 'ok');\n} else {\ntoast(`删除未完成：${res.status}`, 'error');\n}\n} catch (e) {\ntoast(`删除失败：${e?.message || '未知错误'}`, 'error');\n} finally { state.busy = false; }\n});\n$('search-req').addEventListener('input', e => { state.search = e.target.value; renderBacklog(); });\n$('sort-req').addEventListener('change', e => { state.sortBy = e.target.value; renderBacklog(); });\n$('status-filters').querySelectorAll('.chip').forEach(ch => {\nch.addEventListener('click', () => {\nstate.filterStatus = ch.dataset.st;\n$('status-filters').querySelectorAll('.chip').forEach(x => x.classList.toggle('active', x === ch));\nrenderBacklog();\n});\n});\n$('cur-week-range').addEventListener('input', e => {\nstate.roadmap.current_week = Number(e.target.value);\n$('cur-week-lbl').textContent = String(state.roadmap.current_week);\nrenderRoadmap();\n});\n$('le-prog').addEventListener('input', e => { $('le-prog-val').textContent = e.target.value; });\n$('le-open-prd').addEventListener('click', () => { if (state.selectedLaneId) void openPrdFor(state.selectedLaneId); });\nasync function persistRoadmap() {\nif (state.busy) return;\nstate.busy = true;\ntry {\nconst res = await plugin.action('roadmap.save', {\nexpected_revision: state.revision,\ntotal_weeks: state.roadmap.total_weeks,\ncurrent_week: state.roadmap.current_week,\nmilestones: state.roadmap.milestones,\nlanes: state.roadmap.lanes,\n});\nif (res.status === 'saved') {\nawait loadAll();\ntoast('路线图排期已保存。', 'ok');\n} else {\ntoast(`保存排期未完成：${res.status}`, 'error');\n}\n} catch (e) {\ntoast(`保存排期失败：${e?.message || '未知错误'}`, 'error');\n} finally { state.busy = false; }\n}\n$('btn-save-roadmap').addEventListener('click', persistRoadmap);\n$('le-apply').addEventListener('click', () => {\nconst lane = state.roadmap.lanes.find(l => l.req_id === state.selectedLaneId);\nif (!lane) return;\nlane.start_week = Math.max(1, Math.min(state.roadmap.total_weeks, Number($('le-start').value) || 1));\nlane.duration_weeks = Math.max(1, Math.min(16, Number($('le-dur').value) || 1));\nlane.progress = Math.max(0, Math.min(100, Number($('le-prog').value) || 0));\nvoid persistRoadmap();\n});\n['sp-bg', 'sp-us', 'sp-cf', 'sp-ac', 'sp-rk'].forEach(id => $(id).addEventListener('input', updateSpecScoreLive));\n$('btn-prd-save').addEventListener('click', async () => {\nif (state.busy || !state.selectedId) return;\nstate.busy = true;\ntry {\nconst res = await plugin.action('spec.save', {\nexpected_revision: state.revision,\nreq_id: state.selectedId,\nbackground: $('sp-bg').value,\nuser_stories: $('sp-us').value,\ncore_flow: $('sp-cf').value,\nacceptance_criteria: $('sp-ac').value,\nrisks: $('sp-rk').value,\n});\nif (res.status === 'saved') {\nawait loadAll(state.selectedId);\ntoast(`PRD 已保存（文档完整度 ${res.score} 分）`, 'ok');\n} else {\ntoast(`保存 PRD 未完成：${res.status}`, 'error');\nif (res.status === 'conflict') await loadAll(state.selectedId);\n}\n} catch (e) {\ntoast(`保存 PRD 失败：${e?.message || '未知错误'}`, 'error');\n} finally { state.busy = false; }\n});\n$('btn-prd-copy').addEventListener('click', async () => {\nconst md = buildPrdMarkdown();\nif (!md) return;\ntry { await navigator.clipboard.writeText(md); toast('已复制 PRD Markdown。', 'ok'); }\ncatch { toast('当前沙箱禁止直接访问剪贴板，请通过导入导出复制。'); }\n});\n$('btn-prd-insert').addEventListener('click', async () => {\nconst md = buildPrdMarkdown();\nif (!md) return;\ntry {\nconst r = await plugin.action('host.draft.insert', { text: md });\ntoast(r?.inserted ? '已插入当前会话输入框。' : '未能确认插入，请检查输入框。', r?.inserted ? 'ok' : 'error');\n} catch (e) { toast(`插入失败：${e?.message || '未知错误'}`, 'error'); }\n});\n$('btn-io').addEventListener('click', async () => {\n$('modal-io').hidden = false;\n$('io-text').value = '';\nconst sel = $('io-select');\nsel.replaceChildren();\ntry {\nconst list = await plugin.action('document.list', {});\nif (!list.items.length) {\nconst opt = document.createElement('option');\nopt.value = '';\nopt.textContent = '暂无可导出文档（仍可直接粘贴 JSON 导入）';\nsel.appendChild(opt);\n} else {\nfor (const it of list.items) {\nconst opt = document.createElement('option');\nopt.value = it.id;\nopt.textContent = it.label;\nsel.appendChild(opt);\n}\n}\n} catch (e) { toast(`读取导出列表失败：${e?.message || '未知错误'}`, 'error'); }\n});\n$('m-io-close').addEventListener('click', () => { $('modal-io').hidden = true; });\n$('io-export').addEventListener('click', async () => {\nconst id = $('io-select').value;\nif (!id) return;\ntry {\nconst r = await plugin.action('document.export', { id });\nif (r.text) {\n$('io-text').value = r.text;\ntoast(`已生成导出内容：${r.filename}`, 'ok');\n} else {\ntoast(`导出失败：${r.error || '未知错误'}`, 'error');\n}\n} catch (e) { toast(`导出失败：${e?.message || '未知错误'}`, 'error'); }\n});\n$('io-copy').addEventListener('click', async () => {\nconst txt = $('io-text').value;\nif (!txt) return;\ntry { await navigator.clipboard.writeText(txt); toast('已复制 JSON 内容。', 'ok'); }\ncatch { toast('请手动全选文本框内容复制。'); }\n});\n$('io-import').addEventListener('click', async () => {\nconst text = $('io-text').value.trim();\nif (!text) { toast('请先粘贴要导入的 JSON。', 'error'); return; }\ntry {\nconst r = await plugin.action('document.import', { text });\nif (r.imported) {\n$('modal-io').hidden = true;\nstate.currentSpec = null;\nawait loadAll();\ntoast(`导入成功（共 ${r.count ?? 1} 项）。`, 'ok');\n} else {\ntoast(`导入被拒绝：${r.reason || '格式无效'}`, 'error');\n}\n} catch (e) { toast(`导入失败：${e?.message || '未知错误'}`, 'error'); }\n});\nlet lastFsSha = '';\nlet lastFsPath = '';\n$('fs-btn-list').addEventListener('click', async () => {\nconst dir = $('fs-dir').value.trim();\ntry {\nconst r = await plugin.action('fs_list', { path: dir, limit: 50 });\nconst box = $('fs-entries');\nbox.replaceChildren();\nif (r.status !== 'ok') { toast(`读取目录失败：${r.error || r.status}`, 'error'); return; }\nif (!r.entries.length) { box.textContent = '（当前目录为空）'; return; }\nfor (const ent of r.entries) {\nconst chip = document.createElement('button');\nchip.type = 'button';\nchip.className = 'chip';\nchip.textContent = ent.kind === 'dir' ? `📁 ${ent.name}/` : `📄 ${ent.name}`;\nchip.addEventListener('click', () => {\nconst next = dir ? `${dir}/${ent.name}` : ent.name;\nif (ent.kind === 'dir') { $('fs-dir').value = next; $('fs-btn-list').click(); }\nelse { $('fs-path').value = next; }\n});\nbox.appendChild(chip);\n}\n} catch (e) { toast(`浏览目录失败：${e?.message || '未知错误'}`, 'error'); }\n});\n$('fs-btn-read').addEventListener('click', async () => {\nconst relPath = $('fs-path').value.trim();\nif (!relPath) { toast('请输入工作区相对路径。', 'error'); return; }\ntry {\nconst r = await plugin.action('fs_import_doc', { path: relPath });\nif (r.status === 'ok') {\n$('io-text').value = r.content;\nlastFsSha = r.sha256;\nlastFsPath = relPath;\n$('fs-sha-hint').textContent = `已加载 SHA-256: ${r.sha256.slice(0, 10)}… (${r.size_bytes} B)`;\ntoast(`已读取 ${relPath}（格式：${r.format}）`, 'ok');\n} else {\ntoast(`读取失败：${r.error || r.status}`, 'error');\n}\n} catch (e) { toast(`读取失败：${e?.message || '未知错误'}`, 'error'); }\n});\n$('fs-btn-write').addEventListener('click', async () => {\nconst id = $('io-select').value || 'all';\nconst relPath = $('fs-path').value.trim();\nif (!relPath) { toast('请输入要发布的相对路径。', 'error'); return; }\nconst fmt = $('fs-fmt').value;\nconst payload = { id, path: relPath, format: fmt };\nif (lastFsSha && lastFsPath === relPath) payload.expected_sha256 = lastFsSha;\nelse payload.create_only = true;\ntry {\nconst r = await plugin.action('fs_export_doc', payload);\nif (r.status === 'written') {\nlastFsSha = r.sha256;\nlastFsPath = relPath;\n$('fs-sha-hint').textContent = `已发布 SHA-256: ${r.sha256.slice(0, 10)}… (${r.size_bytes} B)`;\ntoast(`已同步写入 ${relPath}（${r.size_bytes} B）`, 'ok');\n} else {\ntoast(`发布未完成 (${r.status})：${r.error || '若文件已存在请先点击「从项目读取」获取最新 SHA-256'}`, 'error');\n}\n} catch (e) { toast(`发布失败：${e?.message || '未知错误'}`, 'error'); }\n});\nvoid loadAll();\n})();\n</script>\n</body>\n</html>\n","path":"ui/index.html"}],"format":"nmas-plugin","manifest":{"actions":[{"id":"studio.load","input_schema":{"additionalProperties":false,"properties":{},"required":[],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"kpi":{"additionalProperties":false,"properties":{"avg_rice":{"maximum":1000000,"minimum":0,"type":"integer"},"avg_spec_score":{"maximum":100,"minimum":0,"type":"integer"},"in_progress":{"maximum":128,"minimum":0,"type":"integer"},"shipped":{"maximum":128,"minimum":0,"type":"integer"},"total":{"maximum":128,"minimum":0,"type":"integer"}},"required":["total","in_progress","shipped","avg_rice","avg_spec_score"],"type":"object"},"requirements":{"items":{"additionalProperties":false,"properties":{"confidence":{"maximum":100,"minimum":10,"type":"integer"},"effort":{"maximum":52,"minimum":0.5,"type":"number"},"id":{"maxLength":40,"minLength":1,"type":"string"},"impact":{"maximum":3,"minimum":0.25,"type":"number"},"module":{"maxLength":32,"type":"string"},"owner":{"maxLength":32,"type":"string"},"priority":{"enum":["P0","P1","P2","P3"],"type":"string"},"reach":{"maximum":100000,"minimum":1,"type":"integer"},"rice":{"maximum":1000000,"minimum":0,"type":"integer"},"sprint":{"maxLength":32,"type":"string"},"status":{"enum":["backlog","planned","in_progress","review","shipped"],"type":"string"},"summary":{"maxLength":160,"type":"string"},"title":{"maxLength":100,"minLength":1,"type":"string"},"value_score":{"maximum":1000000,"minimum":0,"type":"integer"}},"required":["id","title","module","status","reach","impact","confidence","effort","value_score","rice","priority","owner","sprint","summary"],"type":"object"},"type":"array"},"revision":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"roadmap":{"additionalProperties":false,"properties":{"current_week":{"maximum":24,"minimum":1,"type":"integer"},"lanes":{"items":{"additionalProperties":false,"properties":{"duration_weeks":{"maximum":16,"minimum":1,"type":"integer"},"lane":{"maxLength":32,"type":"string"},"progress":{"maximum":100,"minimum":0,"type":"integer"},"req_id":{"maxLength":40,"minLength":1,"type":"string"},"start_week":{"maximum":24,"minimum":1,"type":"integer"}},"required":["req_id",