{"files":[{"content":"const MAX_RECORD_BYTES = 240 * 1024;\nconst DOC_FORMAT = 'velai.stock-ai-terminal';\nconst VALID_MARKETS = new Set(['US', 'HK', 'CN']);\n\nconst r2 = n => Math.round(n * 100) / 100;\nconst r4 = n => Math.round(n * 10000) / 10000;\n\nfunction jsonBytes(v) {\n  let b = 0;\n  for (const ch of JSON.stringify(v)) {\n    const cp = ch.codePointAt(0);\n    b += cp <= 0x7f ? 1 : cp <= 0x7ff ? 2 : cp <= 0xffff ? 3 : 4;\n  }\n  return b;\n}\n\nfunction clipText(val, maxLen) {\n  return String(val ?? '').trim().slice(0, maxLen);\n}\n\nfunction inferMarket(symbol, currency, defaultMarket) {\n  if (symbol.endsWith('.HK') || currency === 'HKD') return 'HK';\n  if (symbol.endsWith('.SS') || symbol.endsWith('.SZ') || currency === 'CNY') return 'CN';\n  if (currency === 'USD') return 'US';\n  return VALID_MARKETS.has(defaultMarket) ? defaultMarket : 'US';\n}\n\nasync function readPublicSettings() {\n  const raw = await globalThis.nmas.settings.get();\n  const defaultMarket = typeof raw?.default_market === 'string' && raw.default_market.trim()\n    ? raw.default_market.trim().slice(0, 32)\n    : 'US';\n  const riskProfile = typeof raw?.risk_profile === 'string' && raw.risk_profile.trim()\n    ? raw.risk_profile.trim().slice(0, 32)\n    : 'balanced';\n  const enableLiveQuotes = typeof raw?.enable_live_quotes === 'boolean'\n    ? raw.enable_live_quotes\n    : true;\n  return {\n    default_market: defaultMarket,\n    risk_profile: riskProfile,\n    enable_live_quotes: enableLiveQuotes,\n  };\n}\n\nasync function readKey(collection, key, fallback) {\n  const res = await globalThis.nmas.data.read({ collection, key });\n  return { revision: res.revision, value: res.value === null ? fallback : res.value };\n}\n\nasync function writeKey(collection, key, expectedRevision, value) {\n  if (jsonBytes(value) > MAX_RECORD_BYTES) return { status: 'limit', revision: expectedRevision };\n  try {\n    const res = await globalThis.nmas.data.write({ collection, key, expected_revision: expectedRevision, value });\n    return { status: 'saved', revision: res.revision };\n  } catch (e) {\n    if (e?.code === 'conflict' && e.outcome_unknown === false) return { status: 'conflict', revision: expectedRevision };\n    throw e;\n  }\n}\n\nasync function deleteKey(collection, key, expectedRevision) {\n  try {\n    const res = await globalThis.nmas.data.delete({ collection, key, expected_revision: expectedRevision });\n    return { status: 'deleted', revision: res.revision };\n  } catch (e) {\n    if (e?.code === 'conflict' && e.outcome_unknown === false) return { status: 'conflict', revision: expectedRevision };\n    throw e;\n  }\n}\n\n// 确定性伪随机 K 线生成器（支持新建自选股及高质量演示 K 线）\nfunction synthBars(symbol, endPrice, drift = 0.0025, vol = 0.022, count = 42) {\n  let seed = 0;\n  for (const ch of symbol) seed = (seed * 131 + ch.charCodeAt(0)) % 2147483647;\n  const rand = () => {\n    seed = (seed * 16807) % 2147483647;\n    return (seed - 1) / 2147483646;\n  };\n  const closes = [100];\n  for (let i = 1; i < count; i++) {\n    const wave = Math.sin(i / 4.2) * (vol * 0.45);\n    const shock = (rand() - 0.48) * vol * 1.9;\n    closes.push(Math.max(10, closes[i - 1] * (1 + drift + wave + shock)));\n  }\n  const scale = endPrice / closes[closes.length - 1];\n  const bars = [];\n  const baseDate = new Date('2026-09-25T00:00:00Z');\n  for (let i = 0; i < count; i++) {\n    const dt = new Date(baseDate.getTime() + i * 86400000);\n    const c = r2(closes[i] * scale);\n    const prev = i === 0 ? c * (1 - drift) : r2(closes[i - 1] * scale);\n    const o = r2(prev * (1 + (rand() - 0.5) * vol * 0.45));\n    const spread = Math.max(Math.abs(c - o) * (0.4 + rand() * 0.7), c * vol * 0.35);\n    const h = r2(Math.max(o, c) + spread * (0.4 + rand() * 0.6));\n    const l = r2(Math.max(0.01, Math.min(o, c) - spread * (0.4 + rand() * 0.6)));\n    const v = Math.round((12 + rand() * 38 + Math.abs(c - o) / c * 600) * 100000);\n    bars.push({ d: dt.toISOString().slice(5, 10), o, h, l, c, v });\n  }\n  return bars;\n}\n\nfunction sma(arr, period) {\n  if (!arr.length) return 0;\n  const slice = arr.slice(-Math.min(period, arr.length));\n  return r2(slice.reduce((a, b) => a + b, 0) / slice.length);\n}\n\nfunction calcRSI(closes, period = 14) {\n  if (closes.length < 3) return 50;\n  const n = Math.min(period, closes.length - 1);\n  let gains = 0, losses = 0;\n  for (let i = closes.length - n; i < closes.length; i++) {\n    const diff = closes[i] - closes[i - 1];\n    if (diff >= 0) gains += diff;\n    else losses -= diff;\n  }\n  if (losses === 0) return 100;\n  const rs = gains / losses;\n  return r2(100 - 100 / (1 + rs));\n}\n\nfunction calcIndicators(bars) {\n  const closes = bars.map(b => b.c);\n  if (!closes.length) return { ma5: 0, ma10: 0, ma20: 0, rsi14: 50, volatility_pct: 0, signal: '无数据' };\n  const ma5 = sma(closes, 5), ma10 = sma(closes, 10), ma20 = sma(closes, 20);\n  const rsi14 = calcRSI(closes, 14);\n  const rets = [];\n  for (let i = 1; i < closes.length; i++) rets.push((closes[i] - closes[i - 1]) / closes[i - 1]);\n  const mean = rets.reduce((a, b) => a + b, 0) / Math.max(1, rets.length);\n  const variance = rets.reduce((a, b) => a + (b - mean) ** 2, 0) / Math.max(1, rets.length);\n  const volatility_pct = r2(Math.sqrt(variance) * Math.sqrt(252) * 100);\n  let signal = '中性震荡';\n  if (ma5 > ma10 && ma10 > ma20 && rsi14 < 72) signal = '多头排列 · 趋势偏强';\n  else if (rsi14 >= 72) signal = 'RSI 高位超买 · 警惕回调';\n  else if (rsi14 <= 32) signal = 'RSI 超卖区间 · 关注反弹';\n  else if (ma5 < ma10 && ma10 < ma20) signal = '空头排列 · 防守为主';\n  return { ma5, ma10, ma20, rsi14, volatility_pct, signal };\n}\n\nfunction runBacktest(bars, strategy, fast, slow) {\n  if (bars.length < 10) {\n    return {\n      ok: false,\n      metrics: { strategy_return_pct: 0, benchmark_return_pct: 0, alpha_pct: 0, max_drawdown_pct: 0, win_rate_pct: 0, sharpe: 0, trade_count: 0 },\n      equity: [],\n      benchmark: [],\n      trades: [],\n    };\n  }\n  const closes = bars.map(b => b.c);\n  let cash = 1, shares = 0, entryPrice = 0;\n  let wins = 0, closedTrades = 0;\n  const equity = [], benchmark = [], trades = [];\n  const startClose = closes[0];\n\n  const avgAt = (idx, win) => {\n    const from = Math.max(0, idx - win + 1);\n    let s = 0;\n    for (let j = from; j <= idx; j++) s += closes[j];\n    return s / (idx - from + 1);\n  };\n  const stdAt = (idx, win, mean) => {\n    const from = Math.max(0, idx - win + 1);\n    let s = 0;\n    for (let j = from; j <= idx; j++) s += (closes[j] - mean) ** 2;\n    return Math.sqrt(s / (idx - from + 1));\n  };\n\n  for (let i = 0; i < bars.length; i++) {\n    const price = closes[i];\n    benchmark.push(r4(price / startClose));\n    let buySig = false, sellSig = false;\n\n    if (i >= Math.max(fast, slow, 5)) {\n      if (strategy === 'ma_cross') {\n        const fNow = avgAt(i, fast), sNow = avgAt(i, slow);\n        const fPrev = avgAt(i - 1, fast), sPrev = avgAt(i - 1, slow);\n        buySig = fPrev <= sPrev && fNow > sNow;\n        sellSig = fPrev >= sPrev && fNow < sNow;\n      } else if (strategy === 'rsi_revert') {\n        const rsi = calcRSI(closes.slice(0, i + 1), Math.max(6, fast));\n        buySig = rsi < 38;\n        sellSig = rsi > 65;\n      } else if (strategy === 'bollinger') {\n        const win = Math.max(10, slow);\n        const m = avgAt(i, win);\n        const sd = stdAt(i, win, m);\n        buySig = price <= m - 1.5 * sd;\n        sellSig = price >= m + 1.5 * sd;\n      }\n    }\n\n    if (buySig && shares === 0) {\n      shares = cash / price;\n      cash = 0;\n      entryPrice = price;\n      trades.push({ date: bars[i].d, side: 'BUY', price, pnl_pct: 0 });\n    } else if (sellSig && shares > 0) {\n      cash = shares * price;\n      const pnlPct = r2(((price - entryPrice) / entryPrice) * 100);\n      if (pnlPct > 0) wins += 1;\n      closedTrades += 1;\n      shares = 0;\n      trades.push({ date: bars[i].d, side: 'SELL', price, pnl_pct: pnlPct });\n    }\n    equity.push(r4(cash + shares * price));\n  }\n\n  let peak = equity[0], maxDd = 0;\n  const dailyRets = [];\n  for (let i = 0; i < equity.length; i++) {\n    if (equity[i] > peak) peak = equity[i];\n    const dd = (peak - equity[i]) / peak;\n    if (dd > maxDd) maxDd = dd;\n    if (i > 0) dailyRets.push((equity[i] - equity[i - 1]) / equity[i - 1]);\n  }\n  const meanR = dailyRets.reduce((a, b) => a + b, 0) / Math.max(1, dailyRets.length);\n  const sdR = Math.sqrt(dailyRets.reduce((a, b) => a + (b - meanR) ** 2, 0) / Math.max(1, dailyRets.length));\n  const sharpe = sdR > 0 ? r2((meanR / sdR) * Math.sqrt(252)) : 0;\n  const stratRet = r2((equity[equity.length - 1] - 1) * 100);\n  const benchRet = r2((benchmark[benchmark.length - 1] - 1) * 100);\n  const winRate = closedTrades > 0 ? r2((wins / closedTrades) * 100) : (stratRet > 0 ? 100 : 0);\n\n  return {\n    ok: true,\n    metrics: {\n      strategy_return_pct: stratRet,\n      benchmark_return_pct: benchRet,\n      alpha_pct: r2(stratRet - benchRet),\n      max_drawdown_pct: r2(maxDd * 100),\n      win_rate_pct: winRate,\n      sharpe,\n      trade_count: trades.length,\n    },\n    equity,\n    benchmark,\n    trades: trades.slice(-16),\n  };\n}\n\nfunction summarizePortfolio(cash, watchlist, positions) {\n  const priceMap = new Map(watchlist.map(w => [w.symbol, w.price]));\n  let market_value = 0, total_cost = 0;\n  for (const p of positions) {\n    const px = priceMap.get(p.symbol) ?? p.avg_cost;\n    market_value += px * p.shares;\n    total_cost += p.avg_cost * p.shares;\n  }\n  const total_assets = r2(cash + market_value);\n  const unrealized_pnl = r2(market_value - total_cost);\n  const pnl_pct = total_cost > 0 ? r2((unrealized_pnl / total_cost) * 100) : 0;\n  const cash_pct = total_assets > 0 ? r2((cash / total_assets) * 100) : 100;\n  return { total_assets, market_value: r2(market_value), total_cost: r2(total_cost), unrealized_pnl, pnl_pct, cash_pct };\n}\n\nfunction parseYahooChart(json, sym) {\n  if (json?.chart?.error) {\n    const errMsg = json.chart.error.description || json.chart.error.code || 'Yahoo chart 返回错误';\n    return { ok: false, status: 'upstream_error', error: clipText(errMsg, 320) };\n  }\n  const result = json?.chart?.result?.[0];\n  if (!result || typeof result !== 'object') {\n    return { ok: false, status: 'parse_error', error: 'Yahoo 行情响应缺少 chart.result[0]' };\n  }\n  const meta = result.meta || {};\n  const timestamps = Array.isArray(result.timestamp) ? result.timestamp : [];\n  const quote = result.indicators?.quote?.[0] || {};\n  const opens = Array.isArray(quote.open) ? quote.open : [];\n  const highs = Array.isArray(quote.high) ? quote.high : [];\n  const lows = Array.isArray(quote.low) ? quote.low : [];\n  const closes = Array.isArray(quote.close) ? quote.close : [];\n  const volumes = Array.isArray(quote.volume) ? quote.volume : [];\n\n  const bars = [];\n  for (let i = 0; i < timestamps.length; i++) {\n    const ts = timestamps[i];\n    const o = opens[i], h = highs[i], l = lows[i], c = closes[i];\n    if (!Number.isFinite(ts) || !Number.isFinite(o) || !Number.isFinite(h) || !Number.isFinite(l) || !Number.isFinite(c) || c <= 0) {\n      continue;\n    }\n    const v = Number.isFinite(volumes[i]) && volumes[i] >= 0 ? Math.round(volumes[i]) : 0;\n    const d = new Date(ts * 1000).toISOString().slice(5, 10);\n    bars.push({ d, o: r2(o), h: r2(h), l: r2(l), c: r2(c), v });\n  }\n  const trimmedBars = bars.slice(-120);\n  const lastBar = trimmedBars.length ? trimmedBars[trimmedBars.length - 1] : null;\n  const prevBar = trimmedBars.length >= 2 ? trimmedBars[trimmedBars.length - 2] : null;\n\n  const rawPrice = Number.isFinite(meta.regularMarketPrice) && meta.regularMarketPrice > 0\n    ? meta.regularMarketPrice\n    : lastBar?.c;\n  if (!Number.isFinite(rawPrice) || rawPrice <= 0) {\n    return { ok: false, status: 'parse_error', error: '无法从 Yahoo 响应中解析有效现价' };\n  }\n\n  const prevCloseCandidates = [\n    meta.regularMarketPreviousClose,\n    meta.previousClose,\n    prevBar?.c,\n    meta.chartPreviousClose,\n  ];\n  const rawPrevClose = prevCloseCandidates.find(v => Number.isFinite(v) && v > 0) ?? rawPrice;\n  const price = r2(rawPrice);\n  const prevClose = r2(rawPrevClose);\n  const change = r2(price - prevClose);\n  const changePct = prevClose > 0 ? r2((change / prevClose) * 100) : 0;\n  const open = r2(lastBar?.o ?? (Number.isFinite(meta.regularMarketOpen) ? meta.regularMarketOpen : price));\n  const high = r2(lastBar?.h ?? (Number.isFinite(meta.regularMarketDayHigh) ? meta.regularMarketDayHigh : price));\n  const low = r2(lastBar?.l ?? (Number.isFinite(meta.regularMarketDayLow) ? meta.regularMarketDayLow : price));\n\n  return {\n    ok: true,\n    status: 'ok',\n    name: clipText(meta.shortName || meta.longName || sym, 64),\n    currency: clipText(meta.currency || 'USD', 12),\n    price,\n    change,\n    change_pct: changePct,\n    open,\n    high,\n    low,\n    prev_close: prevClose,\n    bars: trimmedBars,\n  };\n}\n\nasync function fetchLiveQuoteCore(symbolRaw, sourceRaw = 'yahoo', rangeRaw = '1mo') {\n  const source = sourceRaw === 'finnhub_secret' ? 'finnhub_secret' : 'yahoo';\n  const range = rangeRaw === '5d' || rangeRaw === '3mo' ? rangeRaw : '1mo';\n  const sym = String(symbolRaw || '').trim().toUpperCase();\n  if (!sym || sym.length > 16 || !/^[A-Z0-9._-]+$/.test(sym) || sym.includes('..')) {\n    return { ok: false, status: 'invalid_symbol', source, symbol: sym.slice(0, 16), error: '无效股票代码格式' };\n  }\n\n  const settings = await readPublicSettings();\n  if (!settings.enable_live_quotes) {\n    return {\n      ok: false,\n      status: 'live_quotes_disabled',\n      source,\n      symbol: sym,\n      error: '实时行情已在插件设置中关闭（enable_live_quotes = false）。',\n    };\n  }\n\n  if (source === 'yahoo') {\n    let res;\n    try {\n      res = await globalThis.nmas.http.request({\n        rule: 0,\n        method: 'GET',\n        path: `/v8/finance/chart/${sym}`,\n        query: { interval: '1d', range },\n        headers: { accept: 'application/json' },\n        responseType: 'json',\n      });\n    } catch (e) {\n      return {\n        ok: false,\n        status: clipText(e?.code || 'http_error', 48),\n        source,\n        symbol: sym,\n        error: clipText(e?.message || 'Yahoo 实时行情请求失败', 320),\n      };\n    }\n\n    if (typeof res?.status === 'number' && (res.status < 200 || res.status >= 300)) {\n      return {\n        ok: false,\n        status: 'upstream_error',\n        source,\n        symbol: sym,\n        http_status: res.status,\n        error: `Yahoo 行情上游返回非 2xx 状态码: HTTP ${res.status}`,\n      };\n    }\n\n    const parsed = parseYahooChart(res?.json, sym);\n    if (!parsed.ok) {\n      return {\n        ok: false,\n        status: parsed.status,\n        source,\n        symbol: sym,\n        http_status: typeof res?.status === 'number' ? res.status : 200,\n        error: parsed.error,\n      };\n    }\n    return {\n      ok: true,\n      status: 'ok',\n      source,\n      symbol: sym,\n      name: parsed.name,\n      currency: parsed.currency,\n      price: parsed.price,\n      change: parsed.change,\n      change_pct: parsed.change_pct,\n      open: parsed.open,\n      high: parsed.high,\n      low: parsed.low,\n      prev_close: parsed.prev_close,\n      bars: parsed.bars,\n      bars_count: parsed.bars.length,\n      settings,\n    };\n  }\n\n  // source === 'finnhub_secret'（Rule #1：宿主加密密钥槽注入 + 窄标量投影）\n  let res;\n  try {\n    res = await globalThis.nmas.http.request({\n      rule: 1,\n      method: 'GET',\n      responseType: 'json',\n    });\n  } catch (e) {\n    const code = clipText(e?.code || 'http_error', 48);\n    const msg = code === 'credential_missing'\n      ? '密钥槽 market_api_key 未配置或未确认，请在插件设置中填写 Finnhub API Key 后重试。'\n      : clipText(e?.message || 'Finnhub 密钥槽行情请求失败', 320);\n    return {\n      ok: false,\n      status: code,\n      source,\n      symbol: sym,\n      error: msg,\n    };\n  }\n\n  if (typeof res?.status === 'number' && (res.status < 200 || res.status >= 300)) {\n    return {\n      ok: false,\n      status: 'upstream_error',\n      source,\n      symbol: sym,\n      http_status: res.status,\n      error: `Finnhub 上游返回非 2xx 状态码: HTTP ${res.status}`,\n    };\n  }\n\n  const j = res?.json;\n  if (\n    !j ||\n    typeof j !== 'object' ||\n    !Number.isFinite(j.c) ||\n    !Number.isFinite(j.d) ||\n    !Number.isFinite(j.dp) ||\n    !Number.isFinite(j.h) ||\n    !Number.isFinite(j.l) ||\n    !Number.isFinite(j.o) ||\n    !Number.isFinite(j.pc)\n  ) {\n    return {\n      ok: false,\n      status: 'parse_error',\n      source,\n      symbol: sym,\n      http_status: typeof res?.status === 'number' ? res.status : 200,\n      error: 'Finnhub 标量投影缺少预期数值字段 (c/d/dp/h/l/o/pc)',\n    };\n  }\n  if (j.c <= 0) {\n    return {\n      ok: false,\n      status: 'empty_quote',\n      source,\n      symbol: sym,\n      http_status: typeof res?.status === 'number' ? res.status : 200,\n      error: 'Finnhub 返回当前价格 <= 0，未获取到有效行情',\n    };\n  }\n\n  return {\n    ok: true,\n    status: 'ok',\n    source,\n    symbol: sym,\n    name: sym,\n    currency: 'USD',\n    price: r2(j.c),\n    change: r2(j.d),\n    change_pct: r2(j.dp),\n    open: r2(j.o),\n    high: r2(j.h),\n    low: r2(j.l),\n    prev_close: r2(j.pc),\n    bars: [],\n    bars_count: 0,\n    settings,\n  };\n}\n\nfunction demoData() {\n  const watchlist = [\n    { symbol: 'NVDA', name: '英伟达', market: 'US', sector: 'AI 算力芯片', price: 146.8, change_pct: 2.84, pe: 48.2, pb: 38.5, roe: 112.4, rev_growth: 94.2 },\n    { symbol: 'AAPL', name: '苹果', market: 'US', sector: '消费电子与生态', price: 234.5, change_pct: 0.92, pe: 34.1, pb: 49.2, roe: 147.8, rev_growth: 6.4 },\n    { symbol: '00700', name: '腾讯控股', market: 'HK', sector: '互联网与 AI 应用', price: 428.6, change_pct: 1.65, pe: 19.4, pb: 4.1, roe: 21.8, rev_growth: 10.5 },\n    { symbol: '600519', name: '贵州茅台', market: 'CN', sector: '高端消费', price: 1568.0, change_pct: -0.42, pe: 22.8, pb: 8.6, roe: 36.2, rev_growth: 13.8 },\n    { symbol: '300750', name: '宁德时代', market: 'CN', sector: '新能源与储能', price: 268.4, change_pct: 3.15, pe: 24.5, pb: 5.3, roe: 24.1, rev_growth: 16.2 },\n  ];\n  const klines = {\n    NVDA: synthBars('NVDA', 146.8, 0.0055, 0.032, 42),\n    AAPL: synthBars('AAPL', 234.5, 0.0022, 0.016, 42),\n    '00700': synthBars('00700', 428.6, 0.0031, 0.023, 42),\n    '600519': synthBars('600519', 1568.0, -0.0008, 0.015, 42),\n    '300750': synthBars('300750', 268.4, 0.0042, 0.026, 42),\n  };\n  const portfolio = {\n    schema_version: 1,\n    cash: 128000,\n    positions: [\n      { symbol: 'NVDA', shares: 1200, avg_cost: 118.5, stop_loss: 125.0, target_price: 175.0 },\n      { symbol: '00700', shares: 400, avg_cost: 372.0, stop_loss: 360.0, target_price: 510.0 },\n      { symbol: '300750', shares: 500, avg_cost: 224.0, stop_loss: 215.0, target_price: 320.0 },\n      { symbol: '600519', shares: 60, avg_cost: 1610.0, stop_loss: 1450.0, target_price: 1850.0 },\n    ],\n  };\n  const notes = [\n    { id: 'n-nvda', symbol: 'NVDA', rating: 'strong_buy', target_price: 175, thesis: 'Blackwell 机架出货爬坡带动数据中心毛利率维持高位，CUDA 与 NVLink 生态护城河短期难以被替代。', risks: '云厂商资本开支增速见顶预期、出口管制政策扰动。', date: '2026-11-20' },\n    { id: 'n-00700', symbol: '00700', rating: 'buy', target_price: 510, thesis: '微信生态视频号广告与高毛利长青游戏共振，持续大额回购提供极强估值底保护。', risks: '宏观消费恢复斜率偏缓。', date: '2026-11-18' },\n    { id: 'n-300750', symbol: '300750', rating: 'buy', target_price: 320, thesis: '海外储能大单放量与神行电池渗透率提升，单位瓦时盈利维持行业断层第一。', risks: '欧美关税壁垒与碳酸锂价格剧烈波动。', date: '2026-11-15' },\n  ];\n  return { watchlist, klines, portfolio, notes };\n}\n\nexport default async function (request) {\n  const { kind, contribution, input } = request ?? {};\n\n  if (kind === 'action') {\n    if (contribution === 'stock.bootstrap') {\n      const settings = await readPublicSettings();\n      const wRes = await readKey('watchlist', 'list', { schema_version: 1, items: [] });\n      const pRes = await readKey('portfolio', 'book', { schema_version: 1, cash: 200000, positions: [] });\n      const rRes = await readKey('research', 'notes', { schema_version: 1, notes: [] });\n      const sList = await globalThis.nmas.data.list({ collection: 'research', prefix: 'snap:', limit: 50 });\n      const watchlist = wRes.value.items || [];\n      const positions = pRes.value.positions || [];\n      const cash = pRes.value.cash ?? 200000;\n      return {\n        revision: sList.revision,\n        cash,\n        settings,\n        snapshots: sList.keys || [],\n        watchlist,\n        positions,\n        notes: rRes.value.notes || [],\n        summary: summarizePortfolio(cash, watchlist, positions),\n      };\n    }\n\n    if (contribution === 'stock.fetch_live_quote') {\n      const quote = await fetchLiveQuoteCore(input.symbol, input.source, input.range);\n      if (!quote.ok) {\n        const out = {\n          ok: false,\n          status: quote.status,\n          source: quote.source,\n          symbol: quote.symbol,\n          error: quote.error,\n        };\n        if (quote.http_status !== undefined) out.http_status = quote.http_status;\n        return out;\n      }\n\n      let persisted = false;\n      let latestRevision;\n      if (input.persist === true) {\n        const wRes = await readKey('watchlist', 'list', { schema_version: 1, items: [] });\n        let rev = wRes.revision;\n        const items = wRes.value.items || [];\n        const existing = items.find(x => x.symbol === quote.symbol);\n        const clampedPrice = Math.min(1000000, Math.max(0.01, quote.price));\n        const clampedChg = Math.min(1000, Math.max(-100, quote.change_pct));\n        const nextItem = existing\n          ? { ...existing, price: clampedPrice, change_pct: clampedChg }\n          : {\n              symbol: quote.symbol,\n              name: clipText(quote.name || quote.symbol, 48),\n              market: inferMarket(quote.symbol, quote.currency, quote.settings?.default_market),\n              sector: '实时行情标的',\n              price: clampedPrice,\n              change_pct: clampedChg,\n              pe: 0,\n              pb: 0,\n              roe: 0,\n              rev_growth: 0,\n            };\n        const nextList = existing\n          ? items.map(x => (x.symbol === quote.symbol ? nextItem : x))\n          : [...items, nextItem];\n        const w1 = await writeKey('watchlist', 'list', rev, { schema_version: 1, items: nextList });\n        if (w1.status === 'saved') {\n          rev = w1.revision;\n          persisted = true;\n          if (Array.isArray(quote.bars) && quote.bars.length >= 2) {\n            const w2 = await writeKey('strategies', `k:${quote.symbol}`, rev, { schema_version: 1, bars: quote.bars });\n            if (w2.status === 'saved') rev = w2.revision;\n          }\n        }\n        latestRevision = rev;\n      }\n\n      const out = {\n        ok: true,\n        status: 'ok',\n        source: quote.source,\n        symbol: quote.symbol,\n        name: quote.name,\n        currency: quote.currency,\n        price: quote.price,\n        change: quote.change,\n        change_pct: quote.change_pct,\n        open: quote.open,\n        high: quote.high,\n        low: quote.low,\n        prev_close: quote.prev_close,\n        bars_count: quote.bars_count,\n        persisted,\n      };\n      if (latestRevision !== undefined) out.revision = latestRevision;\n      return out;\n    }\n\n    if (contribution === 'stock.fetch_fx_rate') {\n      const base = String(input.base || 'USD').trim().toUpperCase();\n      const symbols = String(input.symbols || 'CNY,HKD,EUR').trim().toUpperCase();\n      if (!/^[A-Z]{3}$/.test(base) || !/^[A-Z]{3}(,[A-Z]{3})*$/.test(symbols)) {\n        return { ok: false, status: 'invalid_input', base: base.slice(0, 8), rates: [], error: '货币代码格式无效（需 3 位 ISO 币种，如 USD / CNY,HKD）' };\n      }\n\n      let res;\n      try {\n        res = await globalThis.nmas.http.request({\n          rule: 2,\n          method: 'GET',\n          path: '/v1/latest',\n          query: { base, symbols },\n          headers: { accept: 'application/json' },\n          responseType: 'json',\n        });\n      } catch (e) {\n        return {\n          ok: false,\n          status: clipText(e?.code || 'http_error', 48),\n          base,\n          rates: [],\n          error: clipText(e?.message || '实时汇率请求失败', 320),\n        };\n      }\n\n      if (typeof res?.status === 'number' && (res.status < 200 || res.status >= 300)) {\n        return {\n          ok: false,\n          status: 'upstream_error',\n          base,\n          rates: [],\n          http_status: res.status,\n          error: `汇率上游返回非 2xx 状态码: HTTP ${res.status}`,\n        };\n      }\n\n      const rawRates = res?.json?.rates;\n      if (!rawRates || typeof rawRates !== 'object' || Array.isArray(rawRates)) {\n        return {\n          ok: false,\n          status: 'parse_error',\n          base,\n          rates: [],\n          http_status: typeof res?.status === 'number' ? res.status : 200,\n          error: '汇率上游响应缺少 rates 字段',\n        };\n      }\n\n      const rates = Object.entries(rawRates)\n        .filter(([k, v]) => typeof k === 'string' && /^[A-Z]{3}$/.test(k) && Number.isFinite(v))\n        .map(([currency, rate]) => ({ currency, rate: r4(rate) }))\n        .sort((a, b) => a.currency.localeCompare(b.currency));\n\n      if (!rates.length) {\n        return {\n          ok: false,\n          status: 'parse_error',\n          base,\n          rates: [],\n          http_status: typeof res?.status === 'number' ? res.status : 200,\n          error: '未解析到有效汇率条目',\n        };\n      }\n\n      return {\n        ok: true,\n        status: 'ok',\n        base: clipText(res.json.base || base, 8),\n        date: clipText(res.json.date || '', 16),\n        rates,\n      };\n    }\n\n    if (contribution === 'stock.kline.get') {\n      const kRes = await readKey('strategies', `k:${input.symbol.toUpperCase()}`, null);\n      if (!kRes.value || !Array.isArray(kRes.value.bars)) {\n        return { found: false, bars: [], indicators: calcIndicators([]) };\n      }\n      return { found: true, bars: kRes.value.bars, indicators: calcIndicators(kRes.value.bars) };\n    }\n\n    if (contribution === 'stock.backtest') {\n      const kRes = await readKey('strategies', `k:${input.symbol.toUpperCase()}`, null);\n      const bars = kRes.value?.bars || [];\n      return runBacktest(bars, input.strategy, input.fast, input.slow);\n    }\n\n    if (contribution === 'stock.dcf') {\n      const { fcf_billion, growth_pct, terminal_pct, wacc_pct, shares_billion, current_price } = input;\n      const g = growth_pct / 100, tg = terminal_pct / 100, r = wacc_pct / 100;\n      const effR = Math.max(r, tg + 0.01);\n      let pv = 0, fcf = fcf_billion;\n      for (let yr = 1; yr <= 5; yr++) {\n        fcf *= (1 + g);\n        pv += fcf / ((1 + effR) ** yr);\n      }\n      const tv = (fcf * (1 + tg)) / (effR - tg);\n      const pvTv = tv / ((1 + effR) ** 5);\n      const ev = r2(pv + pvTv);\n      const intrinsic = r2(ev / shares_billion);\n      const mos = r2(((intrinsic - current_price) / intrinsic) * 100);\n      const verdict = mos >= 15 ? 'undervalued' : mos <= -15 ? 'overvalued' : 'fair';\n      return { intrinsic_value: intrinsic, margin_of_safety_pct: mos, enterprise_value_billion: ev, verdict };\n    }\n\n    if (contribution === 'stock.watchlist.upsert') {\n      const sym = input.symbol.trim().toUpperCase();\n      if (!sym || !/^[A-Z0-9._-]+$/.test(sym)) return { status: 'invalid_input', revision: input.expected_revision };\n      const wRes = await readKey('watchlist', 'list', { schema_version: 1, items: [] });\n      if (wRes.revision !== input.expected_revision) return { status: 'conflict', revision: wRes.revision };\n      const item = {\n        symbol: sym, name: input.name.trim(), market: input.market, sector: input.sector.trim(),\n        price: r2(input.price), change_pct: r2(input.change_pct), pe: r2(input.pe),\n        pb: r2(input.pb), roe: r2(input.roe), rev_growth: r2(input.rev_growth),\n      };\n      const items = wRes.value.items || [];\n      const exists = items.some(x => x.symbol === sym);\n      const next = exists ? items.map(x => (x.symbol === sym ? item : x)) : [...items, item];\n      const w1 = await writeKey('watchlist', 'list', input.expected_revision, { schema_version: 1, items: next });\n      if (w1.status !== 'saved') return w1;\n      const bars = synthBars(sym, item.price, 0.002, 0.022, 42);\n      const w2 = await writeKey('strategies', `k:${sym}`, w1.revision, { schema_version: 1, bars });\n      return w2.status === 'saved' ? { status: 'saved', revision: w2.revision } : w2;\n    }\n\n    if (contribution === 'stock.portfolio.save') {\n      const pRes = await readKey('portfolio', 'book', { schema_version: 1, cash: 200000, positions: [] });\n      if (pRes.revision !== input.expected_revision) return { status: 'conflict', revision: pRes.revision };\n      return writeKey('portfolio', 'book', input.expected_revision, {\n        schema_version: 1,\n        cash: r2(input.cash),\n        positions: input.positions.filter(p => p.shares > 0),\n      });\n    }\n\n    if (contribution === 'stock.note.save') {\n      const rRes = await readKey('research', 'notes', { schema_version: 1, notes: [] });\n      if (rRes.revision !== input.expected_revision) return { status: 'conflict', revision: rRes.revision };\n      const rec = {\n        id: input.id, symbol: input.symbol.trim().toUpperCase(), rating: input.rating,\n        target_price: r2(input.target_price), thesis: input.thesis.trim(), risks: input.risks.trim(),\n        date: new Date().toISOString().slice(0, 10),\n      };\n      const list = rRes.value.notes || [];\n      const exists = list.some(n => n.id === rec.id);\n      const next = exists ? list.map(n => (n.id === rec.id ? rec : n)) : [rec, ...list];\n      return writeKey('research', 'notes', input.expected_revision, { schema_version: 1, notes: next });\n    }\n\n    if (contribution === 'stock.snapshot.save') {\n      const key = String(input.key || '').trim();\n      if (!/^(snap|note):[A-Za-z0-9._-]{1,56}$/.test(key)) {\n        return { status: 'invalid_key', revision: input.expected_revision };\n      }\n      const wRes = await readKey('watchlist', 'list', { schema_version: 1, items: [] });\n      if (wRes.revision !== input.expected_revision) return { status: 'conflict', revision: wRes.revision };\n      const pRes = await readKey('portfolio', 'book', { schema_version: 1, cash: 200000, positions: [] });\n      const rRes = await readKey('research', 'notes', { schema_version: 1, notes: [] });\n      const payload = {\n        schema_version: 1,\n        saved_at: new Date().toISOString(),\n        memo: clipText(input.memo || '', 400),\n        watchlist: wRes.value.items || [],\n        portfolio: pRes.value,\n        notes: rRes.value.notes || [],\n      };\n      const wr = await writeKey('research', key, input.expected_revision, payload);\n      return { status: wr.status, revision: wr.revision, key };\n    }\n\n    if (contribution === 'stock.snapshot.list') {\n      const prefix = typeof input.prefix === 'string' ? input.prefix : 'snap:';\n      const limit = Number.isInteger(input.limit) ? input.limit : 20;\n      const listed = await globalThis.nmas.data.list({ collection: 'research', prefix, limit });\n      return {\n        keys: listed.keys || [],\n        next_cursor: listed.next_cursor ?? null,\n        revision: listed.revision,\n      };\n    }\n\n    if (contribution === 'stock.record.delete') {\n      const collection = input.collection;\n      const key = String(input.key || '').trim();\n      const allowed =\n        (collection === 'research' && /^(snap|note):[A-Za-z0-9._-]{1,56}$/.test(key)) ||\n        (collection === 'strategies' && /^k:[A-Z0-9._-]{1,16}$/.test(key));\n      if (!allowed) {\n        return { status: 'invalid_key', revision: input.expected_revision };\n      }\n      const cur = await readKey(collection, key, null);\n      if (cur.revision !== input.expected_revision) {\n        return { status: 'conflict', revision: cur.revision };\n      }\n      const del = await deleteKey(collection, key, input.expected_revision);\n      return { status: del.status, revision: del.revision, key };\n    }\n\n    if (contribution === 'stock.seed_demo') {\n      const wRes = await readKey('watchlist', 'list', { schema_version: 1, items: [] });\n      if (wRes.revision !== input.expected_revision) return { status: 'conflict', revision: wRes.revision };\n      const d = demoData();\n      let rev = input.expected_revision;\n      for (const [sym, bars] of Object.entries(d.klines)) {\n        const wr = await writeKey('strategies', `k:${sym}`, rev, { schema_version: 1, bars });\n        if (wr.status !== 'saved') return { status: 'conflict', revision: wr.revision };\n        rev = wr.revision;\n      }\n      const wp = await writeKey('portfolio', 'book', rev, d.portfolio);\n      if (wp.status !== 'saved') return { status: 'conflict', revision: wp.revision };\n      rev = wp.revision;\n      const wn = await writeKey('research', 'notes', rev, { schema_version: 1, notes: d.notes });\n      if (wn.status !== 'saved') return { status: 'conflict', revision: wn.revision };\n      rev = wn.revision;\n      const ww = await writeKey('watchlist', 'list', rev, { schema_version: 1, items: d.watchlist });\n      if (ww.status !== 'saved') return { status: 'conflict', revision: ww.revision };\n      return { status: 'seeded', revision: ww.revision };\n    }\n\n    if (contribution === 'document.list') {\n      const wRes = await readKey('watchlist', 'list', { schema_version: 1, items: [] });\n      const sList = await globalThis.nmas.data.list({ collection: 'research', prefix: 'snap:', limit: 20 });\n      const items = [];\n      if (wRes.value.items?.length) {\n        items.push({ id: 'snapshot', label: `投研组合与研报快照 (${wRes.value.items.length} 标的)` });\n      }\n      for (const k of sList.keys || []) {\n        items.push({ id: k, label: `自定义快照 ${k}` });\n      }\n      return { items };\n    }\n\n    if (contribution === 'document.export') {\n      if (input.id === 'snapshot') {\n        const w = await readKey('watchlist', 'list', { items: [] });\n        const p = await readKey('portfolio', 'book', { cash: 0, positions: [] });\n        const r = await readKey('research', 'notes', { notes: [] });\n        const text = JSON.stringify({ format: DOC_FORMAT, version: 1, watchlist: w.value.items, portfolio: p.value, notes: r.value.notes }, null, 2);\n        return { filename: 'stock-ai-terminal.json', text };\n      }\n      if (/^snap:[A-Za-z0-9._-]{1,56}$/.test(input.id)) {\n        const s = await readKey('research', input.id, null);\n        if (!s.value) return { error: 'not_found' };\n        const text = JSON.stringify({ format: DOC_FORMAT, version: 1, ...s.value }, null, 2);\n        const safeName = input.id.replace(/[^A-Za-z0-9._-]/g, '_');\n        return { filename: `${safeName}.json`, text };\n      }\n      return { error: 'not_found' };\n    }\n\n    if (contribution === 'document.import') {\n      let parsed;\n      try { parsed = JSON.parse(input.text); } catch { return { imported: false, reason: 'invalid_json' }; }\n      if (parsed?.format !== DOC_FORMAT || parsed?.version !== 1 || !Array.isArray(parsed.watchlist)) {\n        return { imported: false, reason: 'invalid_document' };\n      }\n      const wRes = await readKey('watchlist', 'list', { schema_version: 1, items: [] });\n      let rev = wRes.revision;\n      const w1 = await writeKey('watchlist', 'list', rev, { schema_version: 1, items: parsed.watchlist.slice(0, 50) });\n      if (w1.status !== 'saved') return { imported: false, reason: w1.status };\n      rev = w1.revision;\n      if (parsed.portfolio) {\n        const w2 = await writeKey('portfolio', 'book', rev, { schema_version: 1, cash: Number(parsed.portfolio.cash) || 0, positions: parsed.portfolio.positions || [] });\n        if (w2.status !== 'saved') return { imported: false, reason: w2.status };\n        rev = w2.revision;\n      }\n      if (Array.isArray(parsed.notes)) {\n        const w3 = await writeKey('research', 'notes', rev, { schema_version: 1, notes: parsed.notes.slice(0, 100) });\n        if (w3.status !== 'saved') return { imported: false, reason: w3.status };\n      }\n      return { imported: true };\n    }\n  }\n\n  if (kind === 'tool') {\n    if (contribution === 'stock.get_portfolio_summary') {\n      const settings = await readPublicSettings();\n      const wRes = await readKey('watchlist', 'list', { items: [] });\n      const pRes = await readKey('portfolio', 'book', { cash: 200000, positions: [] });\n      const wl = wRes.value.items || [];\n      const pos = pRes.value.positions || [];\n      const cash = pRes.value.cash ?? 200000;\n      const sum = summarizePortfolio(cash, wl, pos);\n      const map = new Map(wl.map(x => [x.symbol, x]));\n      const detail = pos.map(p => {\n        const info = map.get(p.symbol);\n        const price = info?.price ?? p.avg_cost;\n        const mv = price * p.shares;\n        return {\n          symbol: p.symbol,\n          name: info?.name || p.symbol,\n          shares: p.shares,\n          price,\n          avg_cost: p.avg_cost,\n          pnl_pct: r2(((price - p.avg_cost) / p.avg_cost) * 100),\n          weight_pct: sum.total_assets > 0 ? r2((mv / sum.total_assets) * 100) : 0,\n          stop_loss: p.stop_loss ?? 0,\n          target_price: p.target_price ?? 0,\n        };\n      });\n      return {\n        success: true,\n        status: detail.length ? 'ready' : 'empty',\n        total_assets: sum.total_assets,\n        market_value: sum.market_value,\n        cash,\n        cash_pct: sum.cash_pct,\n        unrealized_pnl: sum.unrealized_pnl,\n        pnl_pct: sum.pnl_pct,\n        risk_profile: settings.risk_profile,\n        default_market: settings.default_market,\n        positions: detail,\n      };\n    }\n\n    if (contribution === 'stock.fetch_quote_live') {\n      const quote = await fetchLiveQuoteCore(input.symbol, input.source, input.range);\n      if (!quote.ok) {\n        const out = {\n          success: false,\n          status: quote.status,\n          source: quote.source,\n          symbol: quote.symbol,\n          error: quote.error,\n        };\n        if (quote.http_status !== undefined) out.http_status = quote.http_status;\n        return out;\n      }\n\n      const wRes = await readKey('watchlist', 'list', { items: [] });\n      const rRes = await readKey('research', 'notes', { notes: [] });\n      const localStock = (wRes.value.items || []).find(x => x.symbol === quote.symbol);\n      const localNote = (rRes.value.notes || []).find(n => n.symbol === quote.symbol);\n\n      let barsForInd = quote.bars;\n      if (!barsForInd.length) {\n        const kRes = await readKey('strategies', `k:${quote.symbol}`, null);\n        barsForInd = kRes.value?.bars || [];\n      }\n      const ind = barsForInd.length ? calcIndicators(barsForInd) : null;\n\n      const out = {\n        success: true,\n        status: 'ready',\n        source: quote.source,\n        symbol: quote.symbol,\n        name: localStock?.name || quote.name,\n        currency: quote.currency,\n        price: quote.price,\n        change: quote.change,\n        change_pct: quote.change_pct,\n        open: quote.open,\n        high: quote.high,\n        low: quote.low,\n        prev_close: quote.prev_close,\n        bars_count: quote.bars_count,\n        latest_thesis: localNote?.thesis || '暂无投研笔记',\n      };\n      if (ind) {\n        out.rsi14 = ind.rsi14;\n        out.signal = ind.signal;\n      }\n      if (localStock) {\n        out.pe = localStock.pe;\n        out.roe = localStock.roe;\n      }\n      return out;\n    }\n\n    if (contribution === 'stock.record_research_note') {\n      const rRes = await readKey('research', 'notes', { schema_version: 1, notes: [] });\n      const id = `n-${Date.now().toString(36)}`;\n      const rec = {\n        id,\n        symbol: input.symbol.trim().toUpperCase(),\n        rating: input.rating,\n        target_price: r2(Number(input.target_price) || 0),\n        thesis: input.thesis.trim(),\n        risks: (input.risks || '').trim(),\n        date: new Date().toISOString().slice(0, 10),\n      };\n      const saved = await writeKey('research', 'notes', rRes.revision, { schema_version: 1, notes: [rec, ...(rRes.value.notes || [])] });\n      return { success: saved.status === 'saved', status: saved.status, id };\n    }\n  }\n\n  throw new Error(`不支持的调用: ${kind}/${contribution}`);\n}\n","path":"backend/index.js"},{"content":"<!doctype html>\n<html lang=\"zh-CN\" data-theme=\"dark\" data-cn-color=\"true\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>股票 AI 投研与量化终端 v2</title>\n  <style>\n    :root {\n      --bg: #070b12;\n      --bg-elev: #0d131f;\n      --bg-card: #121a29;\n      --bg-input: #0a0f18;\n      --fg: #e7eef9;\n      --fg-muted: #7f8ea8;\n      --border: rgba(148, 163, 184, 0.15);\n      --border-strong: rgba(148, 163, 184, 0.28);\n      --accent: #38bdf8;\n      --accent-soft: rgba(56, 189, 248, 0.14);\n      --gold: #f59e0b;\n      --violet: #a78bfa;\n      --up: #ef4444;\n      --down: #10b981;\n      --up-soft: rgba(239, 68, 68, 0.14);\n      --down-soft: rgba(16, 185, 129, 0.14);\n      --err: #fb7185;\n      --err-soft: rgba(251, 113, 133, 0.14);\n      font: 13px/1.5 -apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"PingFang SC\", system-ui, sans-serif;\n    }\n    html[data-cn-color=\"false\"] {\n      --up: #10b981;\n      --down: #ef4444;\n      --up-soft: rgba(16, 185, 129, 0.14);\n      --down-soft: rgba(239, 68, 68, 0.14);\n    }\n    html[data-theme=\"light\"] {\n      --bg: #f1f5f9;\n      --bg-elev: #ffffff;\n      --bg-card: #ffffff;\n      --bg-input: #f8fafc;\n      --fg: #0f172a;\n      --fg-muted: #64748b;\n      --border: rgba(15, 23, 42, 0.11);\n      --border-strong: rgba(15, 23, 42, 0.22);\n      --accent: #0284c7;\n      --accent-soft: rgba(2, 132, 199, 0.1);\n    }\n    * { box-sizing: border-box; }\n    body { margin: 0; background: var(--bg); color: var(--fg); min-height: 100vh; }\n    .mono { font-family: ui-monospace, \"SF Mono\", Menlo, Consolas, monospace; font-variant-numeric: tabular-nums; }\n    .app { display: grid; grid-template-columns: 220px minmax(0, 1fr); min-height: 100vh; }\n    @media (max-width: 820px) { .app { grid-template-columns: 1fr; } .sidebar { border-right: 0; border-bottom: 1px solid var(--border); } }\n\n    .sidebar { background: var(--bg-elev); border-right: 1px solid var(--border); padding: 14px 10px; display: flex; flex-direction: column; gap: 12px; }\n    .brand { padding: 4px 8px; }\n    .brand-kicker { font-size: 10px; letter-spacing: 0.14em; color: var(--accent); font-weight: 700; }\n    .brand h1 { margin: 2px 0; font-size: 15.5px; font-weight: 700; }\n    .brand span { font-size: 11.5px; color: var(--fg-muted); }\n\n    .nav { display: flex; flex-direction: column; gap: 4px; }\n    .nav button { text-align: left; border: 1px solid transparent; background: transparent; color: var(--fg-muted); padding: 9px 10px; border-radius: 8px; cursor: pointer; font: inherit; font-weight: 500; display: flex; justify-content: space-between; align-items: center; }\n    .nav button:hover { background: var(--bg-card); color: var(--fg); }\n    .nav button.active { background: var(--accent-soft); color: var(--accent); border-color: rgba(56, 189, 248, 0.35); font-weight: 600; }\n\n    .settings-box { background: var(--bg-card); border: 1px solid var(--border); border-radius: 9px; padding: 9px 10px; display: flex; flex-direction: column; gap: 5px; font-size: 11.5px; }\n    .settings-title { font-size: 10.5px; font-weight: 700; color: var(--accent); letter-spacing: 0.06em; text-transform: uppercase; }\n    .settings-row { display: flex; justify-content: space-between; align-items: center; gap: 6px; color: var(--fg-muted); }\n    .settings-row strong { color: var(--fg); font-weight: 600; }\n    .settings-note { font-size: 10.5px; color: var(--fg-muted); line-height: 1.4; border-top: 1px solid var(--border); padding-top: 5px; margin-top: 2px; }\n\n    .sidebar-foot { margin-top: auto; display: flex; flex-direction: column; gap: 6px; }\n\n    .main { display: flex; flex-direction: column; min-width: 0; }\n    .topbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; padding: 10px 16px; border-bottom: 1px solid var(--border); background: var(--bg-elev); }\n    .kpi-strip { display: flex; flex-wrap: wrap; gap: 16px; }\n    .kpi { display: flex; flex-direction: column; }\n    .kpi strong { font-size: 15.5px; font-weight: 700; }\n    .kpi span { font-size: 11px; color: var(--fg-muted); }\n    .up { color: var(--up); }\n    .down { color: var(--down); }\n\n    .content { padding: 14px 16px; display: flex; flex-direction: column; gap: 12px; min-width: 0; }\n    .status-bar { font-size: 12px; color: var(--fg-muted); padding: 7px 11px; border-radius: 8px; background: var(--bg-card); border: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; gap: 10px; }\n    .status-bar[data-kind=\"error\"] { color: var(--err); border-color: rgba(251, 113, 133, 0.45); background: var(--err-soft); }\n    .status-bar[data-kind=\"ok\"] { color: var(--accent); }\n\n    button, input, select, textarea { font: inherit; color: var(--fg); background: var(--bg-input); border: 1px solid var(--border); border-radius: 7px; padding: 6px 9px; }\n    button { cursor: pointer; background: var(--bg-card); }\n    button:disabled { opacity: 0.55; cursor: not-allowed; }\n    button.primary { background: var(--accent); border-color: var(--accent); color: #06101c; font-weight: 600; }\n    html[data-theme=\"light\"] button.primary { color: #fff; }\n    button.danger { color: var(--err); }\n    .row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }\n    .between { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: space-between; }\n\n    .card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 11px; padding: 13px; display: flex; flex-direction: column; gap: 10px; min-width: 0; }\n    .card h3 { margin: 0; font-size: 13.5px; font-weight: 700; }\n    .term-grid { display: grid; grid-template-columns: 248px minmax(0, 1fr); gap: 12px; align-items: start; }\n    @media (max-width: 860px) { .term-grid { grid-template-columns: 1fr; } }\n    .split-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; align-items: start; }\n    @media (max-width: 860px) { .split-2 { grid-template-columns: 1fr; } }\n\n    .ticker-btn { text-align: left; width: 100%; border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; background: var(--bg-input); display: flex; justify-content: space-between; align-items: center; gap: 8px; }\n    .ticker-btn.active { border-color: var(--accent); background: var(--accent-soft); }\n    .mkt { font-size: 10px; padding: 1px 5px; border-radius: 4px; background: var(--bg-card); border: 1px solid var(--border); color: var(--fg-muted); margin-right: 4px; }\n    .pill { font-size: 10.5px; padding: 2px 7px; border-radius: 99px; border: 1px solid var(--border); background: var(--bg-input); color: var(--fg-muted); }\n    .pill-accent { color: var(--accent); border-color: rgba(56, 189, 248, 0.4); background: var(--accent-soft); }\n    .chg-pill { font-size: 11.5px; font-weight: 700; padding: 2px 7px; border-radius: 6px; }\n    .chg-up { color: var(--up); background: var(--up-soft); }\n    .chg-down { color: var(--down); background: var(--down-soft); }\n\n    .live-box { border: 1px solid var(--border); border-radius: 9px; padding: 10px; background: var(--bg-input); display: flex; flex-direction: column; gap: 8px; }\n    .live-box[data-state=\"error\"] { border-color: rgba(251, 113, 133, 0.5); background: var(--err-soft); color: var(--err); }\n    .fx-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(115px, 1fr)); gap: 8px; }\n\n    .svg-box { background: var(--bg-input); border: 1px solid var(--border); border-radius: 9px; overflow: hidden; }\n    svg { display: block; width: 100%; height: auto; }\n    .factor-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }\n    @media (max-width: 640px) { .factor-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n    .factor { border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; background: var(--bg-input); }\n    .factor span { font-size: 11px; color: var(--fg-muted); display: block; }\n    .factor strong { font-size: 14.5px; }\n\n    table { width: 100%; border-collapse: collapse; font-size: 12.5px; }\n    th, td { text-align: left; padding: 7px 8px; border-bottom: 1px solid var(--border); }\n    th { font-size: 11px; color: var(--fg-muted); text-transform: uppercase; letter-spacing: 0.04em; }\n    label.field { display: flex; flex-direction: column; gap: 3px; font-size: 11.5px; color: var(--fg-muted); font-weight: 600; }\n    textarea { width: 100%; min-height: 76px; resize: vertical; }\n    .rating { font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 99px; border: 1px solid var(--border); }\n    .r-strong_buy, .r-buy { color: var(--up); border-color: var(--up); background: var(--up-soft); }\n    .r-hold { color: var(--gold); border-color: var(--gold); }\n    .r-reduce, .r-sell { color: var(--down); border-color: var(--down); background: var(--down-soft); }\n    .copilot-banner { border: 1px solid rgba(56, 189, 248, 0.35); background: var(--accent-soft); border-radius: 9px; padding: 10px 12px; display: flex; flex-direction: column; gap: 5px; font-size: 12px; }\n    .copilot-banner strong { color: var(--accent); font-size: 12.5px; }\n    pre.ai-box { margin: 0; white-space: pre-wrap; word-break: break-word; padding: 10px; border-radius: 8px; border: 1px dashed var(--accent); background: var(--bg-input); max-height: 220px; overflow: auto; font-size: 12px; line-height: 1.6; }\n    .snap-row { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 6px 9px; border-radius: 7px; border: 1px solid var(--border); background: var(--bg-input); }\n    [hidden] { display: none !important; }\n  </style>\n</head>\n<body>\n  <div class=\"app\">\n    <aside class=\"sidebar\">\n      <div class=\"brand\">\n        <div class=\"brand-kicker\">QUANT TERMINAL · V2</div>\n        <h1>股票 AI 投研终端</h1>\n        <span>实时行情 · K线 · 回测 · DCF</span>\n      </div>\n      <nav class=\"nav\">\n        <button class=\"active\" data-view=\"market\" type=\"button\"><span>📊 行情与 K 线图</span><span id=\"nav-wl\" class=\"mono\">0</span></button>\n        <button data-view=\"quant\" type=\"button\"><span>⚡ 量化策略回测</span><span class=\"mono\">3</span></button>\n        <button data-view=\"portfolio\" type=\"button\"><span>💼 持仓与 DCF 估值</span><span id=\"nav-pos\" class=\"mono\">0</span></button>\n        <button data-view=\"research\" type=\"button\"><span>🧠 投研与伴生副驾</span><span id=\"nav-notes\" class=\"mono\">0</span></button>\n      </nav>\n\n      <div class=\"settings-box\">\n        <div class=\"settings-title\">插件公开配置 (V2 Settings)</div>\n        <div class=\"settings-row\"><span>默认市场</span><strong id=\"cfg-market\" class=\"mono\">--</strong></div>\n        <div class=\"settings-row\"><span>风险偏好</span><strong id=\"cfg-risk\" class=\"mono\">--</strong></div>\n        <div class=\"settings-row\"><span>实时行情</span><strong id=\"cfg-live\" class=\"mono\">--</strong></div>\n        <div class=\"settings-note\">密钥槽 <code class=\"mono\">market_api_key</code> 由宿主加密托管注入 Finnhub，插件前端与脚本不可读取。</div>\n      </div>\n\n      <div class=\"sidebar-foot\">\n        <button id=\"btn-demo\" class=\"primary\" type=\"button\">✨ 加载跨市场演示组合</button>\n        <button id=\"btn-color\" type=\"button\">🔴 红涨绿跌 (CN)</button>\n        <button id=\"btn-theme\" type=\"button\">☀️ 切换深浅外观</button>\n      </div>\n    </aside>\n\n    <div class=\"main\">\n      <header class=\"topbar\">\n        <div class=\"kpi-strip\">\n          <div class=\"kpi\"><strong id=\"kpi-assets\" class=\"mono\">--</strong><span>组合总资产</span></div>\n          <div class=\"kpi\"><strong id=\"kpi-mv\" class=\"mono\">--</strong><span>持仓市值</span></div>\n          <div class=\"kpi\"><strong id=\"kpi-pnl\" class=\"mono\">--</strong><span>浮动盈亏</span></div>\n          <div class=\"kpi\"><strong id=\"kpi-cash\" class=\"mono\">--</strong><span>现金储备占比</span></div>\n        </div>\n        <button id=\"btn-refresh\" type=\"button\">刷新终端</button>\n      </header>\n\n      <div class=\"content\">\n        <div id=\"status\" class=\"status-bar\"><span id=\"status-text\">正在初始化股票投研终端 v2…</span><span id=\"rev-tag\" class=\"mono\">rev #0</span></div>\n\n        <!-- VIEW 1: 行情与 K 线 + 实时行情/汇率 -->\n        <section id=\"view-market\" class=\"term-grid\">\n          <div class=\"card\">\n            <div class=\"between\">\n              <h3>自选标的池</h3>\n              <button id=\"btn-toggle-add\" type=\"button\">+ 新增</button>\n            </div>\n            <div id=\"add-ticker-box\" style=\"display:flex;flex-direction:column;gap:6px\" hidden>\n              <div class=\"row\">\n                <input id=\"w-sym\" placeholder=\"代码如 TSLA\" maxlength=\"16\" style=\"flex:1\">\n                <select id=\"w-mkt\" style=\"width:68px\"><option value=\"US\">US</option><option value=\"HK\">HK</option><option value=\"CN\">CN</option></select>\n              </div>\n              <input id=\"w-name\" placeholder=\"公司名称\" maxlength=\"48\">\n              <div class=\"row\">\n                <input id=\"w-price\" type=\"number\" step=\"0.01\" placeholder=\"现价\" style=\"flex:1\">\n                <input id=\"w-pe\" type=\"number\" step=\"0.1\" placeholder=\"PE\" style=\"width:72px\">\n                <input id=\"w-roe\" type=\"number\" step=\"0.1\" placeholder=\"ROE%\" style=\"width:74px\">\n              </div>\n              <button id=\"btn-save-wl\" class=\"primary\" type=\"button\">加入自选并生成 K 线</button>\n            </div>\n            <div id=\"wl-list\" style=\"display:flex;flex-direction:column;gap:6px\"></div>\n          </div>\n\n          <div style=\"display:flex;flex-direction:column;gap:12px;min-width:0\">\n            <!-- 实时行情拉取（Yahoo / 密钥槽 Pro） -->\n            <div class=\"card\">\n              <div class=\"between\">\n                <h3>🌐 实时行情拉取（Yahoo 公开 / Finnhub 密钥槽 Pro）</h3>\n                <span class=\"pill pill-accent mono\">V2 HTTPS Rule #0 &amp; #1</span>\n              </div>\n              <div class=\"row\">\n                <input id=\"live-sym\" placeholder=\"标的如 NVDA / AAPL / 0700.HK\" maxlength=\"16\" style=\"width:150px\">\n                <select id=\"live-source\" style=\"width:205px\">\n                  <option value=\"yahoo\">Yahoo 公开行情 (Rule #0)</option>\n                  <option value=\"finnhub_secret\">Finnhub 密钥槽 Pro (Rule #1)</option>\n                </select>\n                <select id=\"live-range\" style=\"width:92px\">\n                  <option value=\"5d\">5 日</option>\n                  <option value=\"1mo\" selected>1 个月</option>\n                  <option value=\"3mo\">3 个月</option>\n                </select>\n                <label class=\"row\" style=\"font-size:12px;color:var(--fg-muted);gap:4px\">\n                  <input id=\"live-persist\" type=\"checkbox\" checked> 写回自选与 K 线\n                </label>\n                <button id=\"btn-live-fetch\" class=\"primary\" type=\"button\">拉取实时行情</button>\n              </div>\n              <div id=\"live-result\" class=\"live-box\" hidden></div>\n            </div>\n\n            <!-- K 线图与因子 -->\n            <div class=\"card\">\n              <div class=\"between\">\n                <div>\n                  <h3 id=\"chart-title\" style=\"font-size:16px\">请选择左侧标的</h3>\n                  <span id=\"chart-sub\" class=\"mono\" style=\"font-size:12px;color:var(--fg-muted)\">MA5 金 · MA10 蓝 · MA20 紫</span>\n                </div>\n                <div id=\"hover-ohlc\" class=\"mono\" style=\"font-size:11.5px;color:var(--fg-muted)\">悬停 K 线查看当日 OHLCV</div>\n              </div>\n              <div class=\"svg-box\"><svg id=\"kline-svg\" viewBox=\"0 0 760 320\"></svg></div>\n              <div id=\"factor-grid\" class=\"factor-grid\"></div>\n            </div>\n\n            <!-- 实时汇率 -->\n            <div class=\"card\">\n              <div class=\"between\">\n                <h3>💱 实时跨市场汇率（Frankfurter）</h3>\n                <div class=\"row\">\n                  <select id=\"fx-base\" style=\"width:82px\">\n                    <option value=\"USD\" selected>USD</option>\n                    <option value=\"HKD\">HKD</option>\n                    <option value=\"CNY\">CNY</option>\n                    <option value=\"EUR\">EUR</option>\n                  </select>\n                  <input id=\"fx-symbols\" value=\"CNY,HKD,EUR\" maxlength=\"64\" style=\"width:130px\" placeholder=\"CNY,HKD,EUR\">\n                  <button id=\"btn-fx-fetch\" type=\"button\">刷新汇率</button>\n                </div>\n              </div>\n              <div id=\"fx-result\" class=\"fx-grid\">\n                <div class=\"factor\"><span>提示</span><strong style=\"font-size:12px;color:var(--fg-muted)\">点击「刷新汇率」通过 Rule #2 实时拉取</strong></div>\n              </div>\n            </div>\n          </div>\n        </section>\n\n        <!-- VIEW 2: 量化回测 -->\n        <section id=\"view-quant\" style=\"display:flex;flex-direction:column;gap:12px\" hidden>\n          <div class=\"card\">\n            <div class=\"between\">\n              <h3>量化回测参数配置</h3>\n              <div class=\"row\">\n                <select id=\"bt-symbol\" style=\"width:130px\"></select>\n                <select id=\"bt-strategy\" style=\"width:165px\">\n                  <option value=\"ma_cross\">双均线趋势 (MA Cross)</option>\n                  <option value=\"rsi_revert\">RSI 均值回归策略</option>\n                  <option value=\"bollinger\">布林带均值突破</option>\n                </select>\n                <label class=\"row\" style=\"font-size:12px;color:var(--fg-muted)\">快周期 <input id=\"bt-fast\" type=\"number\" min=\"2\" max=\"20\" value=\"5\" style=\"width:58px\"></label>\n                <label class=\"row\" style=\"font-size:12px;color:var(--fg-muted)\">慢周期 <input id=\"bt-slow\" type=\"number\" min=\"5\" max=\"30\" value=\"15\" style=\"width:58px\"></label>\n                <button id=\"btn-run-bt\" class=\"primary\" type=\"button\">▶ 运行回测</button>\n              </div>\n            </div>\n            <div id=\"bt-metrics\" class=\"factor-grid\"></div>\n            <div class=\"svg-box\"><svg id=\"bt-svg\" viewBox=\"0 0 820 240\"></svg></div>\n          </div>\n          <div class=\"card\">\n            <h3>回测交易信号明细</h3>\n            <div style=\"overflow-x:auto\">\n              <table>\n                <thead><tr><th>日期</th><th>方向</th><th>成交价</th><th>单笔收益</th></tr></thead>\n                <tbody id=\"bt-trades\"></tbody>\n              </table>\n            </div>\n          </div>\n        </section>\n\n        <!-- VIEW 3: 持仓与 DCF -->\n        <section id=\"view-portfolio\" class=\"split-2\" hidden>\n          <div class=\"card\">\n            <div class=\"between\">\n              <h3>持仓配置环形图与风控表</h3>\n              <div class=\"row\">\n                <label class=\"row\" style=\"font-size:12px;color:var(--fg-muted)\">现金 <input id=\"p-cash\" type=\"number\" min=\"0\" style=\"width:110px\"></label>\n                <button id=\"btn-save-cash\" type=\"button\">更新现金</button>\n              </div>\n            </div>\n            <div class=\"svg-box\"><svg id=\"pie-svg\" viewBox=\"0 0 460 220\"></svg></div>\n            <div style=\"overflow-x:auto\">\n              <table>\n                <thead><tr><th>标的</th><th>股数</th><th>成本/现价</th><th>浮盈</th><th>止损/目标</th><th></th></tr></thead>\n                <tbody id=\"pos-tbody\"></tbody>\n              </table>\n            </div>\n            <div class=\"row\">\n              <select id=\"p-sym\" style=\"width:105px\"></select>\n              <input id=\"p-shares\" type=\"number\" min=\"1\" placeholder=\"股数\" style=\"width:76px\">\n              <input id=\"p-cost\" type=\"number\" step=\"0.01\" placeholder=\"成本价\" style=\"width:86px\">\n              <input id=\"p-stop\" type=\"number\" step=\"0.01\" placeholder=\"止损\" style=\"width:76px\">\n              <input id=\"p-tgt\" type=\"number\" step=\"0.01\" placeholder=\"目标\" style=\"width:76px\">\n              <button id=\"btn-add-pos\" class=\"primary\" type=\"button\">+ 记录持仓</button>\n            </div>\n          </div>\n\n          <div class=\"card\">\n            <h3>DCF 自由现金流折现估值计算器</h3>\n            <div class=\"split-2\">\n              <label class=\"field\">基期 FCF (十亿) <input id=\"dcf-fcf\" type=\"number\" step=\"0.1\" value=\"60\"></label>\n              <label class=\"field\">未来5年复合增速 (%) <input id=\"dcf-g\" type=\"number\" step=\"0.5\" value=\"22\"></label>\n              <label class=\"field\">永续增长率 (%) <input id=\"dcf-tg\" type=\"number\" step=\"0.1\" value=\"3.5\"></label>\n              <label class=\"field\">折现率 WACC (%) <input id=\"dcf-wacc\" type=\"number\" step=\"0.2\" value=\"9.5\"></label>\n              <label class=\"field\">总股本 (十亿股) <input id=\"dcf-sh\" type=\"number\" step=\"0.1\" value=\"24.5\"></label>\n              <label class=\"field\">当前股价 <input id=\"dcf-px\" type=\"number\" step=\"0.1\" value=\"146.8\"></label>\n            </div>\n            <button id=\"btn-dcf\" class=\"primary\" type=\"button\">计算内在价值与安全边际</button>\n            <div id=\"dcf-out\" class=\"factor-grid\" style=\"grid-template-columns:repeat(2,1fr)\"></div>\n          </div>\n        </section>\n\n        <!-- VIEW 4: 投研、伴生插件引导与快照账本 -->\n        <section id=\"view-research\" class=\"split-2\" hidden>\n          <div style=\"display:flex;flex-direction:column;gap:12px\">\n            <div class=\"card\">\n              <h3>🤝 伴生实时流式 AI 投研与 V2 Agent 工具</h3>\n              <div class=\"copilot-banner\">\n                <strong>搭配伴生插件 stock-ai-copilot 进行实时流式 AI 投研</strong>\n                <span>V2 架构将联网行情/数据账本与受管流式 AI 推理严格解耦：如需实时 SSE 流式研报，请切换至伴生插件 <code class=\"mono\">stock-ai-copilot</code>；或在 Velai 对话中直接调用本终端提供的 3 个 V2 Agent Tools：</span>\n                <div class=\"row\">\n                  <span class=\"pill mono\">stock.get_portfolio_summary</span>\n                  <span class=\"pill mono\">stock.fetch_quote_live</span>\n                  <span class=\"pill mono\">stock.record_research_note</span>\n                </div>\n              </div>\n              <div class=\"row\">\n                <select id=\"ctx-sym\" style=\"flex:1\"></select>\n                <select id=\"ctx-mode\" style=\"flex:1.4\">\n                  <option value=\"deep\">深度基本面与护城河研报</option>\n                  <option value=\"bull_bear\">多空博弈辩论与风险清单</option>\n                  <option value=\"tech\">量价形态与交易纪律建议</option>\n                  <option value=\"rebalance\">整仓风控与再平衡诊断</option>\n                </select>\n              </div>\n              <div class=\"row\">\n                <button id=\"btn-ctx-build\" class=\"primary\" type=\"button\" style=\"flex:1\">打包投研上下文 Prompt</button>\n                <button id=\"btn-ctx-copy\" type=\"button\" hidden>复制给 stock-ai-copilot</button>\n              </div>\n              <pre id=\"ctx-preview\" class=\"ai-box\" hidden></pre>\n            </div>\n\n            <div class=\"card\">\n              <div class=\"between\">\n                <h3>🗂️ 自定义快照账本 (V2 Data List / Delete)</h3>\n                <span class=\"pill mono\">research/snap:*</span>\n              </div>\n              <div class=\"row\">\n                <input id=\"snap-slug\" placeholder=\"快照标识如 q4-rebalance\" maxlength=\"40\" style=\"width:165px\">\n                <input id=\"snap-memo\" placeholder=\"备注（可选）\" maxlength=\"120\" style=\"flex:1\">\n                <button id=\"btn-snap-save\" class=\"primary\" type=\"button\">保存快照</button>\n              </div>\n              <div id=\"snap-list\" style=\"display:flex;flex-direction:column;gap:6px\"></div>\n            </div>\n          </div>\n\n          <div class=\"card\">\n            <h3>投研评级与多空笔记库</h3>\n            <div class=\"row\">\n              <select id=\"n-sym\" style=\"width:105px\"></select>\n              <select id=\"n-rating\" style=\"width:110px\">\n                <option value=\"strong_buy\">强烈推荐</option>\n                <option value=\"buy\" selected>买入</option>\n                <option value=\"hold\">持有观望</option>\n                <option value=\"reduce\">逢高减仓</option>\n                <option value=\"sell\">卖出规避</option>\n              </select>\n              <input id=\"n-tgt\" type=\"number\" step=\"0.1\" placeholder=\"目标价\" style=\"width:92px\">\n              <button id=\"btn-save-note\" class=\"primary\" type=\"button\">保存研报</button>\n            </div>\n            <textarea id=\"n-thesis\" maxlength=\"800\" placeholder=\"核心多头逻辑与估值锚…\"></textarea>\n            <input id=\"n-risks\" maxlength=\"400\" placeholder=\"关键证伪条件与下行风险…\">\n            <div id=\"notes-list\" style=\"display:flex;flex-direction:column;gap:8px;max-height:360px;overflow:auto\"></div>\n          </div>\n        </section>\n      </div>\n    </div>\n  </div>\n  <script>\n    (() => {\n      const plugin = globalThis.nmasPlugin;\n      const $ = id => document.getElementById(id);\n      const RATING_LABEL = { strong_buy: '强烈推荐', buy: '买入', hold: '持有', reduce: '减仓', sell: '卖出' };\n      const PIE_COLORS = ['#38bdf8', '#f59e0b', '#a78bfa', '#34d399', '#fb7185', '#94a3b8'];\n\n      let state = {\n        revision: 0,\n        cash: 0,\n        watchlist: [],\n        positions: [],\n        notes: [],\n        snapshots: [],\n        settings: { default_market: 'US', risk_profile: 'balanced', enable_live_quotes: true },\n        summary: null,\n      };\n      let activeSym = null, activeKline = null, busy = false, latestPrompt = '';\n\n      const setStatus = (t, kind = '') => {\n        $('status-text').textContent = t;\n        $('status').dataset.kind = kind;\n        $('rev-tag').textContent = `rev #${state.revision}`;\n      };\n      const fmtMoney = n => Number(n || 0).toLocaleString('zh-CN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\n      const svgEl = (tag, attrs = {}, text = '') => {\n        const el = document.createElementNS('http://www.w3.org/2000/svg', tag);\n        for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, String(v));\n        if (text) el.textContent = text;\n        return el;\n      };\n      const cssVar = name => getComputedStyle(document.documentElement).getPropertyValue(name).trim();\n\n      function switchView(view) {\n        document.querySelectorAll('.nav button').forEach(b => b.classList.toggle('active', b.dataset.view === view));\n        ['market', 'quant', 'portfolio', 'research'].forEach(v => { $(`view-${v}`).hidden = v !== view; });\n        if (view === 'portfolio') renderPie();\n        if (view === 'quant' && activeSym) void runBacktest();\n      }\n\n      function populateSelects() {\n        for (const id of ['bt-symbol', 'p-sym', 'ctx-sym', 'n-sym']) {\n          const sel = $(id), prev = sel.value;\n          sel.replaceChildren();\n          for (const w of state.watchlist) sel.add(new Option(`${w.symbol} ${w.name}`, w.symbol));\n          if (prev && state.watchlist.some(w => w.symbol === prev)) sel.value = prev;\n          else if (activeSym) sel.value = activeSym;\n        }\n      }\n\n      function renderSettings() {\n        const cfg = state.settings || {};\n        $('cfg-market').textContent = cfg.default_market || 'US';\n        $('cfg-risk').textContent = cfg.risk_profile || 'balanced';\n        $('cfg-live').textContent = cfg.enable_live_quotes === false ? '已关闭' : '已开启';\n        if (['US', 'HK', 'CN'].includes(cfg.default_market)) {\n          $('w-mkt').value = cfg.default_market;\n        }\n      }\n\n      function renderTopKpis() {\n        const s = state.summary;\n        if (!s) return;\n        $('kpi-assets').textContent = fmtMoney(s.total_assets);\n        $('kpi-mv').textContent = fmtMoney(s.market_value);\n        const pnlEl = $('kpi-pnl');\n        pnlEl.textContent = `${s.unrealized_pnl >= 0 ? '+' : ''}${fmtMoney(s.unrealized_pnl)} (${s.pnl_pct >= 0 ? '+' : ''}${s.pnl_pct}%)`;\n        pnlEl.className = `mono ${s.unrealized_pnl >= 0 ? 'up' : 'down'}`;\n        $('kpi-cash').textContent = `${s.cash_pct}%`;\n        $('nav-wl').textContent = String(state.watchlist.length);\n        $('nav-pos').textContent = String(state.positions.length);\n        $('nav-notes').textContent = String(state.notes.length);\n        $('p-cash').value = String(state.cash);\n      }\n\n      function renderWatchlist() {\n        const box = $('wl-list');\n        box.replaceChildren();\n        if (!state.watchlist.length) {\n          const p = document.createElement('p');\n          p.style.color = 'var(--fg-muted)';\n          p.textContent = '暂无自选标的，点击左侧「✨ 加载跨市场演示组合」或直接拉取实时行情！';\n          box.appendChild(p);\n          return;\n        }\n        for (const w of state.watchlist) {\n          const btn = document.createElement('button');\n          btn.type = 'button';\n          btn.className = `ticker-btn${w.symbol === activeSym ? ' active' : ''}`;\n          const left = document.createElement('div');\n          const top = document.createElement('div');\n          const mkt = document.createElement('span'); mkt.className = 'mkt'; mkt.textContent = w.market;\n          const sym = document.createElement('strong'); sym.className = 'mono'; sym.textContent = w.symbol;\n          top.append(mkt, sym);\n          const sub = document.createElement('div'); sub.style.cssText = 'font-size:11.5px;color:var(--fg-muted)'; sub.textContent = `${w.name} · ${w.sector}`;\n          left.append(top, sub);\n\n          const right = document.createElement('div'); right.style.textAlign = 'right';\n          const px = document.createElement('div'); px.className = 'mono'; px.style.fontWeight = '700'; px.textContent = fmtMoney(w.price);\n          const chg = document.createElement('span');\n          chg.className = `chg-pill mono ${w.change_pct >= 0 ? 'chg-up' : 'chg-down'}`;\n          chg.textContent = `${w.change_pct >= 0 ? '+' : ''}${w.change_pct}%`;\n          right.append(px, chg);\n\n          btn.append(left, right);\n          btn.addEventListener('click', () => selectSymbol(w.symbol));\n          box.appendChild(btn);\n        }\n      }\n\n      function renderKline(stock, kline) {\n        const svg = $('kline-svg');\n        svg.replaceChildren();\n        const bars = kline?.bars || [];\n        $('chart-title').textContent = `${stock.symbol} ${stock.name}  ${fmtMoney(stock.price)} (${stock.change_pct >= 0 ? '+' : ''}${stock.change_pct}%)`;\n        $('chart-sub').textContent = `${stock.market} · ${stock.sector} · 信号：${kline?.indicators?.signal || '--'}`;\n        if (!bars.length) return;\n\n        const W = 760, H = 320, padL = 54, padR = 18, padT = 16, priceH = 205, volTop = 236, volH = 58;\n        const innerW = W - padL - padR;\n        const upColor = cssVar('--up'), downColor = cssVar('--down');\n        const hi = Math.max(...bars.map(b => b.h)), lo = Math.min(...bars.map(b => b.l));\n        const span = Math.max(0.01, hi - lo);\n        const yOf = p => padT + (1 - (p - lo) / span) * priceH;\n        const maxVol = Math.max(1, ...bars.map(b => b.v));\n\n        for (let i = 0; i <= 4; i++) {\n          const y = padT + (i / 4) * priceH;\n          const pv = hi - (i / 4) * span;\n          svg.appendChild(svgEl('line', { x1: padL, y1: y, x2: W - padR, y2: y, stroke: 'rgba(148,163,184,0.12)' }));\n          svg.appendChild(svgEl('text', { x: padL - 6, y: y + 4, 'text-anchor': 'end', fill: '#7f8ea8', 'font-size': 10.5 }, pv.toFixed(2)));\n        }\n\n        const step = innerW / bars.length;\n        const candleW = Math.max(4, step * 0.62);\n        const maSeries = period => bars.map((_, idx) => {\n          const from = Math.max(0, idx - period + 1);\n          let s = 0;\n          for (let j = from; j <= idx; j++) s += bars[j].c;\n          return { x: padL + (idx + 0.5) * step, y: yOf(s / (idx - from + 1)) };\n        });\n\n        bars.forEach((b, i) => {\n          const x = padL + (i + 0.5) * step;\n          const rising = b.c >= b.o;\n          const col = rising ? upColor : downColor;\n          const yH = yOf(b.h), yL = yOf(b.l), yO = yOf(b.o), yC = yOf(b.c);\n          svg.appendChild(svgEl('line', { x1: x, y1: yH, x2: x, y2: yL, stroke: col, 'stroke-width': 1.2 }));\n          svg.appendChild(svgEl('rect', {\n            x: x - candleW / 2, y: Math.min(yO, yC), width: candleW, height: Math.max(1.5, Math.abs(yC - yO)),\n            fill: col, rx: 1,\n          }));\n          const vh = (b.v / maxVol) * volH;\n          svg.appendChild(svgEl('rect', {\n            x: x - candleW / 2, y: volTop + volH - vh, width: candleW, height: vh, fill: col, opacity: 0.42, rx: 1,\n          }));\n          if (i % 7 === 0 || i === bars.length - 1) {\n            svg.appendChild(svgEl('text', { x, y: H - 6, 'text-anchor': 'middle', fill: '#7f8ea8', 'font-size': 10 }, b.d));\n          }\n          const hit = svgEl('rect', { x: x - step / 2, y: padT, width: step, height: H - padT - 18, fill: 'transparent', style: 'cursor:crosshair' });\n          hit.addEventListener('mouseenter', () => {\n            $('hover-ohlc').textContent = `${b.d}  开 ${b.o}  高 ${b.h}  低 ${b.l}  收 ${b.c}  量 ${(b.v / 10000).toFixed(1)}万`;\n          });\n          svg.appendChild(hit);\n        });\n\n        for (const [period, color] of [[5, '#f59e0b'], [10, '#38bdf8'], [20, '#a78bfa']]) {\n          const pts = maSeries(period);\n          const d = pts.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(' ');\n          svg.appendChild(svgEl('path', { d, fill: 'none', stroke: color, 'stroke-width': 1.6, 'pointer-events': 'none' }));\n        }\n\n        const lastY = yOf(bars.at(-1).c);\n        svg.appendChild(svgEl('line', { x1: padL, y1: lastY, x2: W - padR, y2: lastY, stroke: '#38bdf8', 'stroke-dasharray': '4 4', opacity: 0.7 }));\n\n        const ind = kline.indicators;\n        const factors = [\n          ['PE (市盈率)', `${stock.pe}x`],\n          ['PB (市净率)', `${stock.pb}x`],\n          ['ROE 净资产收益', `${stock.roe}%`],\n          ['营收同比增速', `${stock.rev_growth}%`],\n          ['MA5 / MA20', `${ind.ma5} / ${ind.ma20}`],\n          ['RSI (14)', `${ind.rsi14}`],\n          ['年化波动率', `${ind.volatility_pct}%`],\n          ['量化趋势灯', ind.signal],\n        ];\n        const fg = $('factor-grid');\n        fg.replaceChildren();\n        for (const [label, val] of factors) {\n          const div = document.createElement('div');\n          div.className = 'factor';\n          const sp = document.createElement('span'); sp.textContent = label;\n          const st = document.createElement('strong'); st.className = 'mono'; st.textContent = val;\n          div.append(sp, st);\n          fg.appendChild(div);\n        }\n      }\n\n      async function selectSymbol(sym) {\n        activeSym = sym;\n        $('live-sym').value = sym;\n        renderWatchlist();\n        const stock = state.watchlist.find(w => w.symbol === sym);\n        if (!stock) return;\n        $('dcf-px').value = String(stock.price);\n        try {\n          activeKline = await plugin.action('stock.kline.get', { symbol: sym });\n          renderKline(stock, activeKline);\n        } catch (e) { setStatus(`读取 K 线失败：${e?.message}`, 'error'); }\n      }\n\n      function renderLiveQuote(res) {\n        const box = $('live-result');\n        box.hidden = false;\n        box.replaceChildren();\n        if (!res.ok) {\n          box.dataset.state = 'error';\n          const title = document.createElement('strong');\n          title.textContent = `拉取失败 [${res.status}${res.http_status ? ` · HTTP ${res.http_status}` : ''}]`;\n          const desc = document.createElement('div');\n          desc.textContent = res.error || '上游行情不可用';\n          box.append(title, desc);\n          return;\n        }\n        box.dataset.state = 'ok';\n        const top = document.createElement('div');\n        top.className = 'between';\n        const left = document.createElement('strong');\n        left.className = 'mono';\n        left.textContent = `${res.symbol} ${res.name ? `(${res.name})` : ''} · ${fmtMoney(res.price)} ${res.currency || ''}`;\n        const badge = document.createElement('span');\n        badge.className = `chg-pill mono ${(res.change_pct ?? 0) >= 0 ? 'chg-up' : 'chg-down'}`;\n        badge.textContent = `${(res.change ?? 0) >= 0 ? '+' : ''}${res.change ?? 0} (${(res.change_pct ?? 0) >= 0 ? '+' : ''}${res.change_pct ?? 0}%)`;\n        top.append(left, badge);\n\n        const meta = document.createElement('div');\n        meta.className = 'mono';\n        meta.style.cssText = 'font-size:11.5px;color:var(--fg-muted)';\n        const srcLabel = res.source === 'finnhub_secret' ? 'Finnhub 密钥槽标量投影 (Rule #1)' : `Yahoo Finance (Rule #0 · ${res.bars_count ?? 0} 根K线)`;\n        meta.textContent = `来源：${srcLabel} · 开 ${res.open ?? '-'} / 高 ${res.high ?? '-'} / 低 ${res.low ?? '-'} / 昨收 ${res.prev_close ?? '-'}${res.persisted ? ' · 已写回自选' : ''}`;\n        box.append(top, meta);\n      }\n\n      async function runBacktest() {\n        const sym = $('bt-symbol').value || activeSym;\n        if (!sym) return;\n        try {\n          const res = await plugin.action('stock.backtest', {\n            symbol: sym,\n            strategy: $('bt-strategy').value,\n            fast: Number($('bt-fast').value) || 5,\n            slow: Number($('bt-slow').value) || 15,\n          });\n          if (!res.ok) { setStatus('该标的 K 线不足，无法回测。', 'error'); return; }\n          const m = res.metrics;\n          const bm = $('bt-metrics');\n          bm.replaceChildren();\n          for (const [k, v] of [\n            ['策略区间收益', `${m.strategy_return_pct >= 0 ? '+' : ''}${m.strategy_return_pct}%`],\n            ['超额收益 Alpha', `${m.alpha_pct >= 0 ? '+' : ''}${m.alpha_pct}%`],\n            ['最大回撤 MaxDD', `-${m.max_drawdown_pct}%`],\n            ['夏普 / 胜率', `${m.sharpe} / ${m.win_rate_pct}%`],\n          ]) {\n            const d = document.createElement('div'); d.className = 'factor';\n            const s = document.createElement('span'); s.textContent = k;\n            const st = document.createElement('strong'); st.className = 'mono'; st.textContent = v;\n            d.append(s, st); bm.appendChild(d);\n          }\n\n          const svg = $('bt-svg'); svg.replaceChildren();\n          const W = 820, H = 240, padL = 52, padR = 24, padT = 20, padB = 28;\n          const all = [...res.equity, ...res.benchmark];\n          const hi = Math.max(...all) * 1.01, lo = Math.min(...all) * 0.99;\n          const yOf = v => padT + (1 - (v - lo) / Math.max(0.001, hi - lo)) * (H - padT - padB);\n          const xOf = i => padL + (i / Math.max(1, res.equity.length - 1)) * (W - padL - padR);\n          for (let i = 0; i <= 4; i++) {\n            const y = padT + (i / 4) * (H - padT - padB);\n            const val = hi - (i / 4) * (hi - lo);\n            svg.appendChild(svgEl('line', { x1: padL, y1: y, x2: W - padR, y2: y, stroke: 'rgba(148,163,184,0.14)' }));\n            svg.appendChild(svgEl('text', { x: padL - 6, y: y + 4, 'text-anchor': 'end', fill: '#7f8ea8', 'font-size': 10.5 }, val.toFixed(2)));\n          }\n          const mkPath = arr => arr.map((v, i) => `${i === 0 ? 'M' : 'L'} ${xOf(i).toFixed(1)} ${yOf(v).toFixed(1)}`).join(' ');\n          svg.appendChild(svgEl('path', { d: mkPath(res.benchmark), fill: 'none', stroke: '#64748b', 'stroke-width': 1.8, 'stroke-dasharray': '5 4' }));\n          svg.appendChild(svgEl('path', { d: mkPath(res.equity), fill: 'none', stroke: '#38bdf8', 'stroke-width': 2.6 }));\n          svg.appendChild(svgEl('text', { x: padL + 8, y: padT + 12, fill: '#38bdf8', 'font-size': 11, 'font-weight': 700 }, `■ 量化策略净值 (${m.strategy_return_pct}%)`));\n          svg.appendChild(svgEl('text', { x: padL + 190, y: padT + 12, fill: '#94a3b8', 'font-size': 11 }, `--- 买入持有基准 (${m.benchmark_return_pct}%)`));\n\n          const tb = $('bt-trades'); tb.replaceChildren();\n          if (!res.trades.length) {\n            const tr = document.createElement('tr'); const td = document.createElement('td'); td.colSpan = 4; td.textContent = '该参数区间未触发交易信号，可调整快慢周期。'; tr.appendChild(td); tb.appendChild(tr);\n          }\n          for (const t of res.trades) {\n            const tr = document.createElement('tr');\n            const c1 = document.createElement('td'); c1.className = 'mono'; c1.textContent = t.date;\n            const c2 = document.createElement('td'); c2.className = t.side === 'BUY' ? 'up' : 'down'; c2.textContent = t.side;\n            const c3 = document.createElement('td'); c3.className = 'mono'; c3.textContent = fmtMoney(t.price);\n            const c4 = document.createElement('td'); c4.className = `mono ${t.pnl_pct >= 0 ? 'up' : 'down'}`; c4.textContent = t.side === 'SELL' ? `${t.pnl_pct >= 0 ? '+' : ''}${t.pnl_pct}%` : '建仓';\n            tr.append(c1, c2, c3, c4); tb.appendChild(tr);\n          }\n        } catch (e) { setStatus(`回测失败：${e?.message}`, 'error'); }\n      }\n\n      function renderPie() {\n        const svg = $('pie-svg'); svg.replaceChildren();\n        const priceMap = new Map(state.watchlist.map(w => [w.symbol, w]));\n        const slices = state.positions.map(p => {\n          const px = priceMap.get(p.symbol)?.price ?? p.avg_cost;\n          return { label: `${p.symbol} ${priceMap.get(p.symbol)?.name || ''}`, value: px * p.shares };\n        });\n        if (state.cash > 0) slices.push({ label: '现金储备', value: state.cash });\n        const total = slices.reduce((a, b) => a + b.value, 0);\n        if (total <= 0) return;\n        const cx = 110, cy = 110, r = 74;\n        let angle = -Math.PI / 2;\n        slices.forEach((s, idx) => {\n          const frac = s.value / total;\n          const next = angle + frac * Math.PI * 2;\n          const col = PIE_COLORS[idx % PIE_COLORS.length];\n          if (frac > 0.999) {\n            svg.appendChild(svgEl('circle', { cx, cy, r, fill: 'none', stroke: col, 'stroke-width': 26 }));\n          } else {\n            const x1 = cx + Math.cos(angle) * r, y1 = cy + Math.sin(angle) * r;\n            const x2 = cx + Math.cos(next) * r, y2 = cy + Math.sin(next) * r;\n            const large = frac > 0.5 ? 1 : 0;\n            svg.appendChild(svgEl('path', {\n              d: `M ${x1} ${y1} A ${r} ${r} 0 ${large} 1 ${x2} ${y2}`,\n              fill: 'none', stroke: col, 'stroke-width': 26,\n            }));\n          }\n          const ly = 32 + idx * 28;\n          svg.appendChild(svgEl('rect', { x: 224, y: ly - 9, width: 10, height: 10, rx: 2, fill: col }));\n          svg.appendChild(svgEl('text', { x: 242, y: ly, fill: '#cbd5e1', 'font-size': 12 }, `${s.label}  ${(frac * 100).toFixed(1)}%`));\n          angle = next;\n        });\n        svg.appendChild(svgEl('text', { x: cx, y: cy - 3, 'text-anchor': 'middle', fill: '#7f8ea8', 'font-size': 10.5 }, '总资产'));\n        svg.appendChild(svgEl('text', { x: cx, y: cy + 15, 'text-anchor': 'middle', fill: '#e7eef9', 'font-size': 12.5, 'font-weight': 700 }, `${(total / 10000).toFixed(1)}万`));\n\n        const tb = $('pos-tbody'); tb.replaceChildren();\n        for (const p of state.positions) {\n          const px = priceMap.get(p.symbol)?.price ?? p.avg_cost;\n          const pnl = (px - p.avg_cost) * p.shares;\n          const pnlPct = ((px - p.avg_cost) / p.avg_cost) * 100;\n          const tr = document.createElement('tr');\n          const td1 = document.createElement('td'); td1.className = 'mono'; td1.textContent = p.symbol;\n          const td2 = document.createElement('td'); td2.className = 'mono'; td2.textContent = String(p.shares);\n          const td3 = document.createElement('td'); td3.className = 'mono'; td3.textContent = `${p.avg_cost} / ${px}`;\n          const td4 = document.createElement('td'); td4.className = `mono ${pnl >= 0 ? 'up' : 'down'}`; td4.textContent = `${pnl >= 0 ? '+' : ''}${pnlPct.toFixed(1)}%`;\n          const td5 = document.createElement('td'); td5.className = 'mono'; td5.textContent = `${p.stop_loss || '-'} / ${p.target_price || '-'}`;\n          const td6 = document.createElement('td');\n          const del = document.createElement('button'); del.type = 'button'; del.className = 'danger'; del.textContent = '平仓';\n          del.addEventListener('click', () => savePortfolio(state.cash, state.positions.filter(x => x.symbol !== p.symbol)));\n          td6.appendChild(del);\n          tr.append(td1, td2, td3, td4, td5, td6);\n          tb.appendChild(tr);\n        }\n      }\n\n      function renderSnapshots() {\n        const box = $('snap-list');\n        box.replaceChildren();\n        const keys = state.snapshots || [];\n        if (!keys.length) {\n          const p = document.createElement('p');\n          p.style.cssText = 'margin:0;color:var(--fg-muted);font-size:12px';\n          p.textContent = '暂无自定义快照键，输入标识点击「保存快照」即可归档。';\n          box.appendChild(p);\n          return;\n        }\n        for (const key of keys) {\n          const row = document.createElement('div');\n          row.className = 'snap-row';\n          const label = document.createElement('span');\n          label.className = 'mono';\n          label.textContent = key;\n          const del = document.createElement('button');\n          del.type = 'button';\n          del.className = 'danger';\n          del.textContent = '删除键';\n          del.addEventListener('click', async () => {\n            if (busy) return;\n            busy = true;\n            try {\n              const r = await plugin.action('stock.record.delete', {\n                expected_revision: state.revision,\n                collection: 'research',\n                key,\n              });\n              if (r.status === 'deleted') {\n                await load(activeSym);\n                setStatus(`已删除快照键 ${key}。`, 'ok');\n              } else {\n                setStatus(`删除未完成：${r.status}`, 'error');\n              }\n            } catch (e) { setStatus(`删除失败：${e?.message}`, 'error'); }\n            finally { busy = false; }\n          });\n          row.append(label, del);\n          box.appendChild(row);\n        }\n      }\n\n      function renderNotes() {\n        const box = $('notes-list'); box.replaceChildren();\n        if (!state.notes.length) {\n          const p = document.createElement('p'); p.style.color = 'var(--fg-muted)'; p.textContent = '暂无投研笔记。'; box.appendChild(p); return;\n        }\n        for (const n of state.notes) {\n          const card = document.createElement('article');\n          card.style.cssText = 'border:1px solid var(--border);border-radius:8px;padding:9px;background:var(--bg-input);display:flex;flex-direction:column;gap:4px';\n          const top = document.createElement('div'); top.className = 'between';\n          const left = document.createElement('strong'); left.className = 'mono'; left.textContent = `${n.symbol}  目标价 ${n.target_price || '--'}`;\n          const badge = document.createElement('span'); badge.className = `rating r-${n.rating}`; badge.textContent = `${RATING_LABEL[n.rating]} · ${n.date}`;\n          top.append(left, badge);\n          const th = document.createElement('div'); th.textContent = n.thesis;\n          const rk = document.createElement('div'); rk.style.cssText = 'font-size:11.5px;color:var(--fg-muted)'; rk.textContent = n.risks ? `风险：${n.risks}` : '';\n          card.append(top, th, rk);\n          box.appendChild(card);\n        }\n      }\n\n      async function savePortfolio(cash, positions) {\n        if (busy) return; busy = true;\n        try {\n          const r = await plugin.action('stock.portfolio.save', { expected_revision: state.revision, cash, positions });\n          if (r.status === 'saved') { await load(activeSym); setStatus('持仓组合已更新。', 'ok'); }\n          else setStatus(`保存未完成：${r.status}`, 'error');\n        } catch (e) { setStatus(`保存失败：${e?.message}`, 'error'); }\n        finally { busy = false; }\n      }\n\n      async function load(preferSym) {\n        if (typeof plugin?.action !== 'function') { setStatus('请在 Velai Desktop 中打开股票 AI 投研终端。', 'error'); return; }\n        try {\n          state = await plugin.action('stock.bootstrap', {});\n          renderSettings();\n          renderTopKpis();\n          renderWatchlist();\n          renderNotes();\n          renderSnapshots();\n          populateSelects();\n          const sym = preferSym && state.watchlist.some(w => w.symbol === preferSym) ? preferSym : (state.watchlist[0]?.symbol ?? null);\n          if (sym) await selectSymbol(sym);\n          renderPie();\n          setStatus(`终端已同步 · 自选 ${state.watchlist.length} 标的 · 持仓 ${state.positions.length} 笔 · 快照 ${(state.snapshots || []).length} 份`);\n        } catch (e) { setStatus(`加载失败：${e?.message}`, 'error'); }\n      }\n\n      document.querySelectorAll('.nav button').forEach(b => b.addEventListener('click', () => switchView(b.dataset.view)));\n      $('btn-theme').addEventListener('click', () => {\n        document.documentElement.dataset.theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';\n      });\n      $('btn-color').addEventListener('click', () => {\n        const cn = document.documentElement.dataset.cnColor === 'true';\n        document.documentElement.dataset.cnColor = String(!cn);\n        $('btn-color').textContent = !cn ? '🔴 红涨绿跌 (CN)' : '🟢 绿涨红跌 (US)';\n        const st = state.watchlist.find(w => w.symbol === activeSym);\n        if (st && activeKline) renderKline(st, activeKline);\n      });\n      $('btn-refresh').addEventListener('click', () => load(activeSym));\n      $('btn-toggle-add').addEventListener('click', () => { $('add-ticker-box').hidden = !$('add-ticker-box').hidden; });\n\n      $('live-source').addEventListener('change', () => {\n        $('live-range').disabled = $('live-source').value === 'finnhub_secret';\n      });\n\n      $('btn-live-fetch').addEventListener('click', async () => {\n        if (busy) return;\n        const symbol = ($('live-sym').value || activeSym || '').trim().toUpperCase();\n        if (!symbol) { setStatus('请输入需要查询实时行情的股票代码。', 'error'); return; }\n        const source = $('live-source').value;\n        const range = $('live-range').value;\n        const persist = $('live-persist').checked;\n        busy = true;\n        setStatus(`正在通过 ${source === 'finnhub_secret' ? 'Finnhub 密钥槽 (Rule #1)' : 'Yahoo 公开行情 (Rule #0)'} 拉取 ${symbol}…`);\n        try {\n          const res = await plugin.action('stock.fetch_live_quote', { symbol, source, range, persist });\n          renderLiveQuote(res);\n          if (res.ok) {\n            if (res.persisted) await load(res.symbol);\n            setStatus(`已获取 ${res.symbol} 实时行情：${fmtMoney(res.price)} (${res.change_pct >= 0 ? '+' : ''}${res.change_pct}%)`, 'ok');\n          } else {\n            setStatus(`实时行情获取失败 [${res.status}]：${res.error || '未知错误'}`, 'error');\n          }\n        } catch (e) {\n          renderLiveQuote({ ok: false, status: 'exception', source, symbol, error: e?.message || '请求异常' });\n          setStatus(`实时行情调用失败：${e?.message}`, 'error');\n        } finally { busy = false; }\n      });\n\n      $('btn-fx-fetch').addEventListener('click', async () => {\n        if (busy) return;\n        const base = $('fx-base').value;\n        const symbols = $('fx-symbols').value.trim().toUpperCase();\n        busy = true;\n        setStatus(`正在通过 Frankfurter (Rule #2) 拉取 ${base} -> ${symbols} 实时汇率…`);\n        try {\n          const res = await plugin.action('stock.fetch_fx_rate', { base, symbols });\n          const grid = $('fx-result');\n          grid.replaceChildren();\n          if (!res.ok) {\n            const box = document.createElement('div');\n            box.className = 'live-box';\n            box.dataset.state = 'error';\n            box.style.gridColumn = '1 / -1';\n            box.textContent = `汇率拉取失败 [${res.status}${res.http_status ? ` · HTTP ${res.http_status}` : ''}]：${res.error || '上游错误'}`;\n            grid.appendChild(box);\n            setStatus(`汇率拉取失败：${res.error || res.status}`, 'error');\n            return;\n          }\n          for (const r of res.rates) {\n            const div = document.createElement('div');\n            div.className = 'factor';\n            const sp = document.createElement('span'); sp.textContent = `1 ${res.base} -> ${r.currency}`;\n            const st = document.createElement('strong'); st.className = 'mono'; st.textContent = String(r.rate);\n            div.append(sp, st);\n            grid.appendChild(div);\n          }\n          setStatus(`汇率已更新 (${res.date || 'latest'}) · 基准 ${res.base}`, 'ok');\n        } catch (e) { setStatus(`汇率拉取异常：${e?.message}`, 'error'); }\n        finally { busy = false; }\n      });\n\n      $('btn-demo').addEventListener('click', async () => {\n        if (busy) return; busy = true;\n        setStatus('正在装配 5 支跨市场标的、42 日 K 线与持仓组合…');\n        try {\n          const r = await plugin.action('stock.seed_demo', { expected_revision: state.revision });\n          if (r.status === 'seeded') { await load('NVDA'); setStatus('演示投研组合已加载完成！', 'ok'); }\n          else setStatus(`冲突：${r.status}`, 'error');\n        } catch (e) { setStatus(`加载失败：${e?.message}`, 'error'); }\n        finally { busy = false; }\n      });\n\n      $('btn-save-wl').addEventListener('click', async () => {\n        if (busy) return;\n        const symbol = $('w-sym').value.trim().toUpperCase(), name = $('w-name').value.trim(), price = Number($('w-price').value);\n        if (!symbol || !name || !Number.isFinite(price) || price <= 0) { setStatus('请填写有效代码、名称与现价。', 'error'); return; }\n        busy = true;\n        try {\n          const r = await plugin.action('stock.watchlist.upsert', {\n            expected_revision: state.revision, symbol, name, market: $('w-mkt').value, sector: '自选标的',\n            price, change_pct: 0, pe: Number($('w-pe').value) || 20, pb: 3, roe: Number($('w-roe').value) || 15, rev_growth: 12,\n          });\n          if (r.status === 'saved') { $('add-ticker-box').hidden = true; await load(symbol); setStatus(`已添加 ${symbol}。`, 'ok'); }\n          else setStatus(`添加未完成：${r.status}`, 'error');\n        } catch (e) { setStatus(`添加失败：${e?.message}`, 'error'); }\n        finally { busy = false; }\n      });\n\n      $('btn-run-bt').addEventListener('click', () => void runBacktest());\n      $('btn-save-cash').addEventListener('click', () => savePortfolio(Math.max(0, Number($('p-cash').value) || 0), state.positions));\n      $('btn-add-pos').addEventListener('click', () => {\n        const sym = $('p-sym').value, shares = Number($('p-shares').value), avg_cost = Number($('p-cost').value);\n        if (!sym || !shares || !avg_cost) { setStatus('请完整填写标的、股数与成本价。', 'error'); return; }\n        const rec = { symbol: sym, shares, avg_cost, stop_loss: Number($('p-stop').value) || 0, target_price: Number($('p-tgt').value) || 0 };\n        const next = state.positions.some(p => p.symbol === sym) ? state.positions.map(p => p.symbol === sym ? rec : p) : [...state.positions, rec];\n        void savePortfolio(state.cash, next);\n      });\n\n      $('btn-dcf').addEventListener('click', async () => {\n        try {\n          const res = await plugin.action('stock.dcf', {\n            fcf_billion: Number($('dcf-fcf').value), growth_pct: Number($('dcf-g').value),\n            terminal_pct: Number($('dcf-tg').value), wacc_pct: Number($('dcf-wacc').value),\n            shares_billion: Number($('dcf-sh').value), current_price: Number($('dcf-px').value),\n          });\n          const label = { undervalued: '明显低估 (具安全边际)', fair: '估值合理区间', overvalued: '溢价偏高 (谨慎追高)' }[res.verdict];\n          const box = $('dcf-out'); box.replaceChildren();\n          for (const [k, v] of [\n            ['每股内在价值', fmtMoney(res.intrinsic_value)],\n            ['安全边际', `${res.margin_of_safety_pct >= 0 ? '+' : ''}${res.margin_of_safety_pct}%`],\n            ['隐含企业价值 (十亿)', fmtMoney(res.enterprise_value_billion)],\n            ['DCF 估值结论', label],\n          ]) {\n            const d = document.createElement('div'); d.className = 'factor';\n            const s = document.createElement('span'); s.textContent = k;\n            const st = document.createElement('strong'); st.className = 'mono'; st.textContent = v;\n            d.append(s, st); box.appendChild(d);\n          }\n        } catch (e) { setStatus(`DCF 测算失败：${e?.message}`, 'error'); }\n      });\n\n      $('btn-save-note').addEventListener('click', async () => {\n        if (busy) return;\n        const symbol = $('n-sym').value, thesis = $('n-thesis').value.trim();\n        if (!symbol || !thesis) { setStatus('请选择标的并填写核心逻辑。', 'error'); return; }\n        busy = true;\n        try {\n          const r = await plugin.action('stock.note.save', {\n            expected_revision: state.revision, id: `n-${Date.now().toString(36)}`, symbol,\n            rating: $('n-rating').value, target_price: Number($('n-tgt').value) || 0, thesis, risks: $('n-risks').value.trim(),\n          });\n          if (r.status === 'saved') { $('n-thesis').value = ''; $('n-risks').value = ''; await load(activeSym); setStatus('投研笔记已归档。', 'ok'); }\n          else setStatus(`保存未完成：${r.status}`, 'error');\n        } catch (e) { setStatus(`保存失败：${e?.message}`, 'error'); }\n        finally { busy = false; }\n      });\n\n      $('btn-ctx-build').addEventListener('click', () => {\n        const sym = $('ctx-sym').value;\n        const stock = state.watchlist.find(w => w.symbol === sym);\n        if (!stock) { setStatus('请先加载或添加至少一个自选标的。', 'error'); return; }\n        const pos = state.positions.find(p => p.symbol === sym);\n        const mode = $('ctx-mode').value;\n        const instructions = {\n          deep: '请作为买方资深行业研究员，结合以下财务与量化因子，输出结构化深度研报：1) 商业模式与护城河；2) 估值合理性；3) 关键催化剂；4) 明确风险与证伪点。',\n          bull_bear: '请分别以“多头基金经理”和“空头对冲基金”双视角辩论该标的未来 12 个月赔率，最后给出综合仓位建议。',\n          tech: '请基于以下均线、RSI14、年化波动率及持仓成本，给出分批建仓/止盈/止损交易纪律方案。',\n          rebalance: '请评估以下整个持仓组合的集中度、现金比例和盈亏结构，给出具体再平衡建议。',\n        };\n        const ind = activeKline?.indicators;\n        const ctx = [\n          instructions[mode],\n          '',\n          `风险偏好配置：${state.settings?.risk_profile || 'balanced'}（默认市场：${state.settings?.default_market || 'US'}）`,\n          `标的：${stock.symbol} ${stock.name} (${stock.market} / ${stock.sector})`,\n          `最新价=${stock.price}，涨跌幅=${stock.change_pct}%，PE=${stock.pe}，PB=${stock.pb}，ROE=${stock.roe}%，营收增速=${stock.rev_growth}%`,\n          ind ? `技术面：MA5=${ind.ma5}，MA10=${ind.ma10}，MA20=${ind.ma20}，RSI14=${ind.rsi14}，年化波动=${ind.volatility_pct}%，信号=${ind.signal}` : '',\n          pos ? `当前持仓：${pos.shares} 股，均价 ${pos.avg_cost}，止损 ${pos.stop_loss}，目标 ${pos.target_price}` : '当前未持仓',\n          state.summary ? `组合总资产=${state.summary.total_assets}，现金占比=${state.summary.cash_pct}%，总浮盈=${state.summary.pnl_pct}%` : '',\n        ].filter(Boolean).join('\\n');\n        latestPrompt = ctx;\n        $('ctx-preview').textContent = ctx;\n        $('ctx-preview').hidden = false;\n        $('btn-ctx-copy').hidden = false;\n        setStatus('已打包结构化投研 Prompt，可复制到伴生插件 stock-ai-copilot 进行流式深度研报。', 'ok');\n      });\n\n      $('btn-ctx-copy').addEventListener('click', async () => {\n        if (!latestPrompt) return;\n        try {\n          await navigator.clipboard.writeText(latestPrompt);\n          setStatus('已复制投研 Prompt，请粘贴至伴生插件 stock-ai-copilot。', 'ok');\n        } catch {\n          setStatus('当前环境不支持剪贴板写入，请手动选中上方文本框复制。', 'error');\n        }\n      });\n\n      $('btn-snap-save').addEventListener('click', async () => {\n        if (busy) return;\n        const rawSlug = $('snap-slug').value.trim() || `s-${Date.now().toString(36)}`;\n        const key = rawSlug.startsWith('snap:') ? rawSlug : `snap:${rawSlug}`;\n        busy = true;\n        try {\n          const r = await plugin.action('stock.snapshot.save', {\n            expected_revision: state.revision,\n            key,\n            memo: $('snap-memo').value.trim(),\n          });\n          if (r.status === 'saved') {\n            $('snap-slug').value = '';\n            $('snap-memo').value = '';\n            await load(activeSym);\n            setStatus(`已保存自定义快照 ${key}。`, 'ok');\n          } else {\n            setStatus(`保存快照未完成：${r.status}`, 'error');\n          }\n        } catch (e) { setStatus(`保存快照失败：${e?.message}`, 'error'); }\n        finally { busy = false; }\n      });\n\n      void load();\n    })();\n  </script>\n</body>\n</html>\n","path":"ui/index.html"}],"format":"nmas-plugin","manifest":{"actions":[{"id":"stock.bootstrap","input_schema":{"additionalProperties":false,"properties":{},"required":[],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"cash":{"maximum":100000000000,"minimum":0,"type":"number"},"notes":{"items":{"additionalProperties":false,"properties":{"date":{"maxLength":10,"minLength":10,"type":"string"},"id":{"maxLength":48,"minLength":1,"type":"string"},"rating":{"enum":["strong_buy","buy","hold","reduce","sell"],"type":"string"},"risks":{"maxLength":400,"type":"string"},"symbol":{"maxLength":16,"minLength":1,"type":"string"},"target_price":{"maximum":1000000,"minimum":0,"type":"number"},"thesis":{"maxLength":800,"type":"string"}},"required":["id","symbol","rating","target_price","thesis","risks","date"],"type":"object"},"type":"array"},"positions":{"items":{"additionalProperties":false,"properties":{"avg_cost":{"maximum":1000000,"minimum":0.01,"type":"number"},"shares":{"maximum":100000000,"minimum":0,"type":"number"},"stop_loss":{"maximum":1000000,"minimum":0,"type":"number"},"symbol":{"maxLength":16,"minLength":1,"type":"string"},"target_price":{"maximum":1000000,"minimum":0,"type":"number"}},"required":["symbol","shares","avg_cost","stop_loss","target_price"],"type":"object"},"type":"array"},"revision":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"settings":{"additionalProperties":false,"properties":{"default_market":{"maxLength":32,"type":"string"},"enable_live_quotes":{"type":"boolean"},"risk_profile":{"maxLength":32,"type":"string"}},"required":["default_market","risk_profile","enable_live_quotes"],"type":"object"},"snapshots":{"items":{"maxLength":96,"type":"string"},"type":"array"},"summary":{"additionalProperties":false,"properties":{"cash_pct":{"type":"number"},"market_value":{"type":"number"},"pnl_pct":{"type":"number"},"total_assets":{"type":"number"},"total_cost":{"type":"number"},"unrealized_pnl":{"type":"number"}},"required":["total_assets","market_value","total_cost","unrealized_pnl","pnl_pct","cash_pct"],"type":"object"},"watchlist":{"items":{"additionalProperties":false,"properties":{"change_pct":{"maximum":1000,"minimum":-100,"type":"number"},"market":{"enum":["US","HK","CN"],"type":"string"},"name":{"maxLength":48,"minLength":1,"type":"string"},"pb":{"maximum":1000,"minimum":0,"type":"number"},"pe":{"maximum":10000,"minimum":-1000,"type":"number"},"price":{"maximum":1000000,"minimum":0.01,"type":"number"},"rev_growth":{"maximum":1000,"minimum":-100,"type":"number"},"roe":{"maximum":500,"minimum":-200,"type":"number"},"sector":{"maxLength":32,"type":"string"},"symbol":{"maxLength":16,"minLength":1,"type":"string"}},"required":["symbol","name","market","sector","price","change_pct","pe","pb","roe","rev_growth"],"type":"object"},"type":"array"}},"required":["revision","cash","watchlist","positions","notes","summary","settings","snapshots"],"type":"object"},"permissions":["data.read"],"title":"读取投研终端总览与公开配置"},{"id":"stock.fetch_live_quote","input_schema":{"additionalProperties":false,"properties":{"persist":{"type":"boolean"},"range":{"enum":["5d","1mo","3mo"],"type":"string"},"source":{"enum":["yahoo","finnhub_secret"],"type":"string"},"symbol":{"maxLength":16,"minLength":1,"type":"string"}},"required":["symbol"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"bars_count":{"maximum":500,"minimum":0,"type":"integer"},"change":{"type":"number"},"change_pct":{"type":"number"},"currency":{"maxLength":12,"type":"string"},"error":{"maxLength":320,"type":"string"},"high":{"type":"number"},"http_status":{"maximum":999,"minimum":0,"type":"integer"},"low":{"type":"number"},"name":{"maxLength":64,"type":"string"},"ok":{"type":"boolean"},"open":{"type":"number"},"persisted":{"type":"boolean"},"prev_close":{"type":"number"},"price":{"type":"number"},"revision":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"source":{"enum":["yahoo","finnhub_secret"],"type":"string"},"status":{"maxLength":48,"type":"string"},"symbol":{"maxLength":16,"type":"string"}},"required":["ok","status","source","symbol"],"type":"object"},"permissions":["http.request","data.read","data.write"],"title":"拉取实时行情（Yahoo 公开 / Finnhub 密钥槽）"},{"id":"stock.fetch_fx_rate","input_schema":{"additionalProperties":false,"properties":{"base":{"maxLength":3,"minLength":3,"type":"string"},"symbols":{"maxLength":64,"minLength":3,"type":"string"}},"required":[],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"base":{"maxLength":8,"type":"string"},"date":{"maxLength":16,"type":"string"},"error":{"maxLength":320,"type":"string"},"http_status":{"maximum":999,"minimum":0,"type":"integer"},"ok":{"type":"boolean"},"rates":{"items":{"additionalProperties":false,"properties":{"currency":{"maxLength":8,"type":"string"},"rate":{"type":"number"}},"required":["currency","rate"],"type":"object"},"type":"array"},"status":{"maxLength":48,"type":"string"}},"required":["ok","status","base","rates"],"type":"object"},"permissions":["http.request"],"title":"获取实时跨市场汇率"},{"id":"stock.kline.get","input_schema":{"additionalProperties":false,"properties":{"symbol":{"maxLength":16,"minLength":1,"type":"string"}},"required":["symbol"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"bars":{"items":{"additionalProperties":false,"properties":{"c":{"type":"number"},"d":{"maxLength":12,"type":"string"},"h":{"type":"number"},"l":{"type":"number"},"o":{"type":"number"},"v":{"type":"number"}},"required":["d","o","h","l","c","v"],"type":"object"},"type":"array"},"found":{"type":"boolean"},"indicators":{"additionalProperties":false,"properties":{"ma10":{"type":"number"},"ma20":{"type":"number"},"ma5":{"type":"number"},"rsi14":{"type":"number"},"signal":{"maxLength":32,"type":"string"},"volatility_pct":{"type":"number"}},"required":["ma5","ma10","ma20","rsi14","volatility_pct","signal"],"type":"object"}},"required":["found","bars","indicators"],"type":"object"},"permissions":["data.read"],"title":"读取标的 K 线与技术指标"},{"id":"stock.backtest","input_schema":{"additionalProperties":false,"properties":{"fast":{"maximum":20,"minimum":2,"type":"integer"},"slow":{"maximum":30,"minimum":5,"type":"integer"},"strategy":{"enum":["ma_cross","rsi_revert","bollinger"],"type":"string"},"symbol":{"maxLength":16,"minLength":1,"type":"string"}},"required":["symbol","strategy","fast","slow"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"benchmark":{"items":{"type":"number"},"type":"array"},"equity":{"items":{"type":"number"},"type":"array"},"metrics":{"additionalProperties":false,"properties":{"alpha_pct":{"type":"number"},"benchmark_return_pct":{"type":"number"},"max_drawdown_pct":{"type":"number"},"sharpe":{"type":"number"},"strategy_return_pct":{"type":"number"},"trade_count":{"maximum":200,"minimum":0,"type":"integer"},"win_rate_pct":{"type":"num