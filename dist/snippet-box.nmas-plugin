{"files":[{"content":"const COLLECTION = 'snippets';\nconst KEY = 'box';\nconst MAX_BYTES = 12 * 1024;\nconst MAX_SNIPPETS = 60;\n\nfunction jsonBytes(v) {\n  let b = 0;\n  for (const ch of JSON.stringify(v)) {\n    const cp = ch.codePointAt(0);\n    b += cp <= 0x7f ? 1 : cp <= 0x7ff ? 2 : cp <= 0xffff ? 3 : 4;\n  }\n  return b;\n}\n\nfunction sortSnippets(list) {\n  return list.slice().sort((a, b) => Number(b.pinned) - Number(a.pinned));\n}\n\nasync function readBox() {\n  const receipt = await globalThis.nmas.data.read({ collection: COLLECTION, key: KEY });\n  const doc = receipt.value === null ? { schema_version: 1, snippets: [] } : receipt.value;\n  if (!doc || doc.schema_version !== 1 || !Array.isArray(doc.snippets)) {\n    throw new Error('片段库数据格式无效');\n  }\n  return { revision: receipt.revision, snippets: sortSnippets(doc.snippets) };\n}\n\nasync function writeBox(expectedRevision, snippets) {\n  const value = { schema_version: 1, snippets: sortSnippets(snippets) };\n  if (snippets.length > MAX_SNIPPETS || jsonBytes(value) > MAX_BYTES) {\n    return { status: 'limit', revision: expectedRevision };\n  }\n  try {\n    const receipt = await globalThis.nmas.data.write({\n      collection: COLLECTION,\n      key: KEY,\n      expected_revision: expectedRevision,\n      value,\n    });\n    return { status: 'saved', revision: receipt.revision };\n  } catch (err) {\n    if (err?.code === 'conflict' && err.outcome_unknown === false) {\n      return { status: 'conflict', revision: expectedRevision };\n    }\n    throw err;\n  }\n}\n\nexport default async function (request) {\n  const { kind, contribution, input } = request ?? {};\n\n  if (kind === 'action') {\n    if (contribution === 'snippet.list') return readBox();\n\n    if (contribution === 'snippet.save') {\n      const { expected_revision, id, title, tag, pinned, body } = input;\n      if (!title.trim() || !body.trim() || !/^[a-zA-Z0-9._-]+$/.test(id)) {\n        return { status: 'invalid_input', revision: expected_revision };\n      }\n      const box = await readBox();\n      if (box.revision !== expected_revision) return { status: 'conflict', revision: box.revision };\n      const record = { id, title: title.trim(), tag: tag.trim(), pinned: Boolean(pinned), body: body.trim() };\n      const exists = box.snippets.some(s => s.id === id);\n      const next = exists ? box.snippets.map(s => (s.id === id ? record : s)) : [...box.snippets, record];\n      return writeBox(expected_revision, next);\n    }\n\n    if (contribution === 'snippet.delete') {\n      const box = await readBox();\n      if (box.revision !== input.expected_revision) return { status: 'conflict', revision: box.revision };\n      if (!box.snippets.some(s => s.id === input.id)) return { status: 'not_found', revision: box.revision };\n      const res = await writeBox(input.expected_revision, box.snippets.filter(s => s.id !== input.id));\n      return res.status === 'saved' ? { status: 'deleted', revision: res.revision } : { status: 'conflict', revision: res.revision };\n    }\n  }\n\n  if (kind === 'tool' && contribution === 'snippet.search') {\n    const box = await readBox();\n    const kw = (input.keyword || '').trim().toLowerCase();\n    const tag = (input.tag || '').trim().toLowerCase();\n    const matched = box.snippets.filter(s => {\n      if (tag && s.tag.toLowerCase() !== tag) return false;\n      if (kw && !`${s.title} ${s.tag} ${s.body}`.toLowerCase().includes(kw)) return false;\n      return true;\n    });\n    return { success: true, status: 'ready', snippets: matched.slice(0, 12) };\n  }\n\n  throw new Error(`不支持的调用: ${kind}/${contribution}`);\n}\n","path":"backend/index.js"},{"content":"<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>常用片段剪贴箱</title>\n  <style>\n    :root {\n      color-scheme: light dark;\n      --bg: Canvas; --fg: CanvasText; --muted: color-mix(in srgb, CanvasText 60%, transparent);\n      --border: color-mix(in srgb, CanvasText 18%, transparent);\n      --card: color-mix(in srgb, CanvasText 4%, Canvas);\n      --accent: #2563eb; --danger: #dc2626;\n      font: 14px/1.5 system-ui, -apple-system, sans-serif;\n    }\n    * { box-sizing: border-box; }\n    body { margin: 0; background: var(--bg); color: var(--fg); }\n    main { max-width: 900px; margin: 0 auto; padding: clamp(12px, 2.5vw, 20px); display: flex; flex-direction: column; gap: 12px; }\n    header, .row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: space-between; }\n    h1 { font-size: 18px; margin: 0; }\n    .composer { border: 1px solid var(--border); border-radius: 10px; padding: 12px; background: var(--card); display: flex; flex-direction: column; gap: 8px; }\n    input, textarea, button { font: inherit; color: inherit; border: 1px solid var(--border); border-radius: 7px; padding: 6px 10px; background: var(--bg); }\n    textarea { width: 100%; min-height: 78px; resize: vertical; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; }\n    button { cursor: pointer; }\n    button.primary { background: var(--accent); border-color: var(--accent); color: #fff; }\n    button.danger { color: var(--danger); }\n    .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 10px; }\n    .card { border: 1px solid var(--border); border-radius: 10px; padding: 10px; background: var(--card); display: flex; flex-direction: column; gap: 8px; }\n    .card pre { margin: 0; white-space: pre-wrap; word-break: break-word; font-size: 12.5px; max-height: 120px; overflow: auto; padding: 8px; border-radius: 6px; background: var(--bg); border: 1px solid var(--border); }\n    .tag { font-size: 11px; padding: 1px 7px; border-radius: 99px; border: 1px solid var(--border); color: var(--muted); }\n    .status { font-size: 13px; color: var(--muted); margin: 0; }\n    .status[data-error=\"true\"] { color: var(--danger); }\n    [hidden] { display: none !important; }\n  </style>\n</head>\n<body>\n  <main>\n    <header>\n      <h1>常用片段剪贴箱</h1>\n      <div class=\"row\">\n        <input id=\"search\" type=\"search\" placeholder=\"搜索标题、标签或正文…\" autocomplete=\"off\">\n        <button id=\"btn-from-selection\" type=\"button\" hidden>收藏当前选中回复</button>\n      </div>\n    </header>\n\n    <section class=\"composer\">\n      <div class=\"row\">\n        <input id=\"f-title\" placeholder=\"片段名称（如：SQL 慢查询排查）\" maxlength=\"80\" style=\"flex:1;min-width:160px\" autocomplete=\"off\">\n        <input id=\"f-tag\" placeholder=\"标签（如：sql / shell）\" maxlength=\"32\" style=\"width:140px\" autocomplete=\"off\">\n        <label style=\"display:flex;align-items:center;gap:4px;font-size:13px\"><input id=\"f-pinned\" type=\"checkbox\"> 置顶</label>\n        <button id=\"btn-save\" class=\"primary\" type=\"button\">保存片段</button>\n      </div>\n      <textarea id=\"f-body\" maxlength=\"2048\" placeholder=\"粘贴常用命令、代码模板或回复话术…\"></textarea>\n    </section>\n\n    <p id=\"status\" class=\"status\" role=\"status\">正在加载片段箱…</p>\n    <section id=\"cards\" class=\"cards\"></section>\n  </main>\n  <script>\n    (() => {\n      const plugin = globalThis.nmasPlugin;\n      const $ = id => document.getElementById(id);\n      let revision = 0, snippets = [], editingId = null, canReadSel = false, canInsert = false, busy = false;\n      const setStatus = (t, err = false) => { $('status').textContent = t; $('status').dataset.error = String(err); };\n\n      function render() {\n        const kw = $('search').value.trim().toLowerCase();\n        const shown = snippets.filter(s => !kw || `${s.title} ${s.tag} ${s.body}`.toLowerCase().includes(kw));\n        const box = $('cards');\n        box.replaceChildren();\n        if (!shown.length) {\n          const p = document.createElement('p');\n          p.className = 'status';\n          p.textContent = snippets.length ? '未找到匹配片段' : '还没有保存任何片段';\n          box.appendChild(p);\n          return;\n        }\n        for (const s of shown) {\n          const card = document.createElement('article');\n          card.className = 'card';\n          const top = document.createElement('div');\n          top.className = 'row';\n          const title = document.createElement('strong');\n          title.textContent = `${s.pinned ? '★ ' : ''}${s.title}`;\n          top.appendChild(title);\n          if (s.tag) {\n            const tag = document.createElement('span');\n            tag.className = 'tag';\n            tag.textContent = s.tag;\n            top.appendChild(tag);\n          }\n          const pre = document.createElement('pre');\n          pre.textContent = s.body;\n          const actions = document.createElement('div');\n          actions.className = 'row';\n          if (canInsert) {\n            const ins = document.createElement('button');\n            ins.type = 'button';\n            ins.className = 'primary';\n            ins.textContent = '插入输入框';\n            ins.addEventListener('click', async () => {\n              try {\n                const r = await plugin.action('host.draft.insert', { text: s.body });\n                setStatus(r?.inserted ? `已插入「${s.title}」` : '未能确认插入结果', !r?.inserted);\n              } catch (e) { setStatus(`插入失败：${e?.message || '未知错误'}`, true); }\n            });\n            actions.appendChild(ins);\n          }\n          const edit = document.createElement('button');\n          edit.type = 'button';\n          edit.textContent = '编辑';\n          edit.addEventListener('click', () => {\n            editingId = s.id;\n            $('f-title').value = s.title;\n            $('f-tag').value = s.tag;\n            $('f-pinned').checked = s.pinned;\n            $('f-body').value = s.body;\n            $('f-title').focus();\n          });\n          const del = document.createElement('button');\n          del.type = 'button';\n          del.className = 'danger';\n          del.textContent = '删除';\n          del.addEventListener('click', () => remove(s.id));\n          actions.append(edit, del);\n          card.append(top, pre, actions);\n          box.appendChild(card);\n        }\n      }\n\n      async function load() {\n        if (typeof plugin?.action !== 'function') { setStatus('请在 Velai Desktop 中打开此插件。', true); return; }\n        try {\n          const caps = await plugin.action('host.capabilities', {}).catch(() => ({ actions: [] }));\n          const list = Array.isArray(caps?.actions) ? caps.actions : [];\n          canReadSel = list.includes('host.selection.read');\n          canInsert = list.includes('host.draft.insert');\n          $('btn-from-selection').hidden = !canReadSel;\n          const res = await plugin.action('snippet.list', {});\n          revision = res.revision;\n          snippets = res.snippets;\n          render();\n          setStatus(`共 ${snippets.length} 条片段（修订 #${revision}）`);\n        } catch (e) { setStatus(`加载失败：${e?.message || '未知错误'}`, true); }\n      }\n\n      async function remove(id) {\n        if (busy) return;\n        busy = true;\n        try {\n          const res = await plugin.action('snippet.delete', { expected_revision: revision, id });\n          if (res.status === 'deleted') await load();\n          else setStatus(`删除未完成：${res.status}`, true);\n        } catch (e) { setStatus(`删除失败：${e?.message || '未知错误'}`, true); }\n        finally { busy = false; }\n      }\n\n      $('btn-save').addEventListener('click', async () => {\n        if (busy) return;\n        const title = $('f-title').value.trim();\n        const body = $('f-body').value.trim();\n        if (!title || !body) { setStatus('请填写片段名称和内容。', true); return; }\n        busy = true;\n        try {\n          const id = editingId || `sn-${Date.now().toString(36)}`;\n          const res = await plugin.action('snippet.save', {\n            expected_revision: revision,\n            id,\n            title,\n            tag: $('f-tag').value.trim(),\n            pinned: $('f-pinned').checked,\n            body,\n          });\n          if (res.status === 'saved') {\n            editingId = null;\n            $('f-title').value = '';\n            $('f-tag').value = '';\n            $('f-pinned').checked = false;\n            $('f-body').value = '';\n            await load();\n            setStatus('片段已保存。');\n          } else setStatus(`保存未完成：${res.status}`, true);\n        } catch (e) { setStatus(`保存失败：${e?.message || '未知错误'}`, true); }\n        finally { busy = false; }\n      });\n\n      $('btn-from-selection').addEventListener('click', async () => {\n        try {\n          const res = await plugin.action('host.selection.read', {});\n          if (typeof res?.text === 'string' && res.text.trim()) {\n            $('f-body').value = res.text.slice(0, 2048);\n            if (!$('f-title').value.trim()) $('f-title').value = res.text.trim().split('\\n')[0].slice(0, 40);\n            setStatus('已读入当前选中的回复，确认后点击保存。');\n          } else setStatus('请先在聊天中点选一条回复。', true);\n        } catch { setStatus('无法读取选中回复，请先在聊天中点选消息。', true); }\n      });\n\n      $('search').addEventListener('input', render);\n      void load();\n    })();\n  </script>\n</body>\n</html>\n","path":"ui/index.html"}],"format":"nmas-plugin","manifest":{"actions":[{"id":"snippet.list","input_schema":{"additionalProperties":false,"properties":{},"required":[],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"revision":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"snippets":{"items":{"additionalProperties":false,"properties":{"body":{"maxLength":2048,"minLength":1,"type":"string"},"id":{"maxLength":48,"minLength":1,"type":"string"},"pinned":{"type":"boolean"},"tag":{"maxLength":32,"type":"string"},"title":{"maxLength":80,"minLength":1,"type":"string"}},"required":["id","title","tag","pinned","body"],"type":"object"},"type":"array"}},"required":["revision","snippets"],"type":"object"},"permissions":["data.read"],"title":"读取片段列表"},{"id":"snippet.save","input_schema":{"additionalProperties":false,"properties":{"body":{"maxLength":2048,"minLength":1,"type":"string"},"expected_revision":{"maximum":9007199254740990,"minimum":0,"type":"integer"},"id":{"maxLength":48,"minLength":1,"type":"string"},"pinned":{"type":"boolean"},"tag":{"maxLength":32,"type":"string"},"title":{"maxLength":80,"minLength":1,"type":"string"}},"required":["expected_revision","id","title","tag","pinned","body"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"revision":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"status":{"enum":["saved","conflict","limit","invalid_input"],"type":"string"}},"required":["status","revision"],"type":"object"},"permissions":["data.read","data.write"],"title":"保存片段"},{"id":"snippet.delete","input_schema":{"additionalProperties":false,"properties":{"expected_revision":{"maximum":9007199254740990,"minimum":0,"type":"integer"},"id":{"maxLength":48,"minLength":1,"type":"string"}},"required":["expected_revision","id"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"revision":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"status":{"enum":["deleted","not_found","conflict"],"type":"string"}},"required":["status","revision"],"type":"object"},"permissions":["data.read","data.write"],"title":"删除片段"}],"backend":"backend/index.js","data":[{"collection":"snippets","schema_version":1,"scope":"account"}],"files":[{"path":"backend/index.js","sha256":"e8e02a2bf67c8e006f80c0a1cde3f7f6f5d89b76d4d66487aa74cd5d893f6f78"},{"path":"ui/index.html","sha256":"19bfc3e89d9ccb40c03f4567f54b2844894fe8020654af30d32005aa8bc0be70"}],"host_api":1,"http":[],"manifest_version":1,"name":"常用片段剪贴箱","page":"ui/index.html","permissions":["data.read","data.write"],"plugin_id":"snippet-box","tasks":[],"tools":[{"description":"按关键词或标签搜索当前账号收藏的代码片段、命令或回复话术。","id":"snippet.search","input_schema":{"additionalProperties":false,"properties":{"keyword":{"maxLength":64,"type":"string"},"tag":{"maxLength":32,"type":"string"}},"required":[],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"snippets":{"items":{"additionalProperties":false,"properties":{"body":{"maxLength":2048,"minLength":1,"type":"string"},"id":{"maxLength":48,"minLength":1,"type":"string"},"pinned":{"type":"boolean"},"tag":{"maxLength":32,"type":"string"},"title":{"maxLength":80,"minLength":1,"type":"string"}},"required":["id","title","tag","pinned","body"],"type":"object"},"type":"array"},"status":{"enum":["ready","storage_error"],"type":"string"},"success":{"type":"boolean"}},"required":["success","status","snippets"],"type":"object"},"permissions":["data.read"],"title":"检索常用片段"}],"ui":{"icon":"app","surfaces":["workspace","chat","assistant"]},"version":"1.0.0"},"version":1}