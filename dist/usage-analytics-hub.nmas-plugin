{"files":[{"content":"const MAX_RECORD_BYTES = 13 * 1024;\nconst MAX_SESSIONS = 40;\nconst CATEGORIES = ['coding', 'writing', 'research', 'planning', 'ops', 'chat'];\nconst DOC_FORMAT = 'velai.usage-analytics-hub';\n\nconst r2 = n => Math.round(n * 100) / 100;\nconst r3 = n => Math.round(n * 1000) / 1000;\n\nfunction jsonBytes(v) {\n  let b = 0;\n  for (const ch of JSON.stringify(v)) {\n    const cp = ch.codePointAt(0);\n    b += cp <= 0x7f ? 1 : cp <= 0x7ff ? 2 : cp <= 0xffff ? 3 : 4;\n  }\n  return b;\n}\n\nconst DEFAULT_CONFIG = {\n  schema_version: 1,\n  monthly_cost_usd: 45,\n  monthly_tokens_m: 12,\n  latest_review: '',\n};\n\nasync function readKey(collection, key, fallback) {\n  const res = await globalThis.nmas.data.read({ collection, key });\n  return { revision: res.revision, value: res.value === null ? fallback : res.value };\n}\n\nasync function writeKey(collection, key, expectedRevision, value) {\n  if (jsonBytes(value) > MAX_RECORD_BYTES) return { status: 'limit', revision: expectedRevision };\n  try {\n    const res = await globalThis.nmas.data.write({ collection, key, expected_revision: expectedRevision, value });\n    return { status: 'saved', revision: res.revision };\n  } catch (e) {\n    if (e?.code === 'conflict' && e.outcome_unknown === false) return { status: 'conflict', revision: expectedRevision };\n    throw e;\n  }\n}\n\nfunction estimateCost(model, inTok, outTok, cachedTok) {\n  const m = (model || '').toLowerCase();\n  let inRate = 2.0, outRate = 8.0; // USD per 1M tokens\n  if (m.includes('flash') || m.includes('mini') || m.includes('haiku')) { inRate = 0.25; outRate = 1.0; }\n  else if (m.includes('deepseek')) { inRate = 0.55; outRate = 2.19; }\n  else if (m.includes('claude') && m.includes('opus')) { inRate = 15.0; outRate = 75.0; }\n  else if (m.includes('claude')) { inRate = 3.0; outRate = 15.0; }\n  else if (m.includes('gemini') && m.includes('pro')) { inRate = 1.25; outRate = 10.0; }\n  else if (m.includes('gpt-4')) { inRate = 2.5; outRate = 10.0; }\n  const billableIn = Math.max(0, inTok - cachedTok) + cachedTok * 0.25;\n  return r3((billableIn * inRate + outTok * outRate) / 1_000_000);\n}\n\nfunction validDate(d) {\n  return typeof d === 'string' && /^\\d{4}-\\d{2}-\\d{2}$/.test(d);\n}\n\nfunction sanitizeSession(raw, fallbackId) {\n  const date = validDate(raw.date) ? raw.date : new Date().toISOString().slice(0, 10);\n  const title = typeof raw.title === 'string' ? raw.title.trim().slice(0, 100) : '';\n  const model = typeof raw.model === 'string' ? raw.model.trim().slice(0, 48) : '';\n  const category = CATEGORIES.includes(raw.category) ? raw.category : 'chat';\n  if (!title || !model) return null;\n  const input_tokens = Math.max(0, Math.round(Number(raw.input_tokens) || 0));\n  const output_tokens = Math.max(0, Math.round(Number(raw.output_tokens) || 0));\n  const cached_tokens = Math.min(input_tokens, Math.max(0, Math.round(Number(raw.cached_tokens) || 0)));\n  const cost_usd = raw.cost_usd !== undefined && Number.isFinite(Number(raw.cost_usd)) && Number(raw.cost_usd) >= 0\n    ? r3(Number(raw.cost_usd))\n    : estimateCost(model, input_tokens, output_tokens, cached_tokens);\n  const hour = Number.isInteger(raw.hour) && raw.hour >= 0 && raw.hour <= 23 ? raw.hour : 14;\n  const turns = Math.min(10000, Math.max(1, Math.round(Number(raw.turns) || 6)));\n  const minutes = Math.min(1440, Math.max(1, Math.round(Number(raw.minutes) || 12)));\n  const rating = Math.min(5, Math.max(1, Math.round(Number(raw.rating) || 4)));\n  const id = typeof raw.id === 'string' && /^[a-zA-Z0-9._-]+$/.test(raw.id) ? raw.id.slice(0, 48) : fallbackId;\n  return {\n    id,\n    date,\n    hour,\n    title,\n    category,\n    model,\n    input_tokens,\n    output_tokens,\n    cached_tokens,\n    cost_usd,\n    turns,\n    minutes,\n    rating,\n    summary: typeof raw.summary === 'string' ? raw.summary.trim().slice(0, 260) : '',\n    tags: typeof raw.tags === 'string' ? raw.tags.trim().slice(0, 80) : '',\n  };\n}\n\nfunction sortSessions(list) {\n  return list.slice().sort((a, b) => (b.date + String(b.hour).padStart(2, '0')).localeCompare(a.date + String(a.hour).padStart(2, '0')));\n}\n\nfunction dateDiffDays(a, b) {\n  const ta = Date.parse(`${a}T00:00:00Z`), tb = Date.parse(`${b}T00:00:00Z`);\n  return Math.round((ta - tb) / 86400000);\n}\n\nfunction aggregate(allSessions, config, range = '30d') {\n  const sorted = sortSessions(allSessions);\n  const anchorDate = sorted.length ? sorted[0].date : new Date().toISOString().slice(0, 10);\n  const maxDays = range === '7d' ? 7 : range === '30d' ? 30 : 3650;\n  const filtered = range === 'all'\n    ? sorted\n    : sorted.filter(s => {\n        const diff = dateDiffDays(anchorDate, s.date);\n        return diff >= 0 && diff < maxDays;\n      });\n\n  let input_tokens = 0, output_tokens = 0, cached_tokens = 0, total_cost_usd = 0;\n  let total_minutes = 0, total_turns = 0, ratingSum = 0;\n  const dayMap = new Map();\n  const modelMap = new Map();\n  const catMap = new Map();\n  const hours = new Array(24).fill(0);\n\n  for (const s of filtered) {\n    const tok = s.input_tokens + s.output_tokens;\n    input_tokens += s.input_tokens;\n    output_tokens += s.output_tokens;\n    cached_tokens += s.cached_tokens;\n    total_cost_usd += s.cost_usd;\n    total_minutes += s.minutes;\n    total_turns += s.turns;\n    ratingSum += s.rating;\n    hours[s.hour] += 1;\n\n    const d = dayMap.get(s.date) || { date: s.date, sessions: 0, tokens: 0, cached: 0, cost_usd: 0, minutes: 0 };\n    d.sessions += 1; d.tokens += tok; d.cached += s.cached_tokens; d.cost_usd = r3(d.cost_usd + s.cost_usd); d.minutes += s.minutes;\n    dayMap.set(s.date, d);\n\n    const m = modelMap.get(s.model) || { model: s.model, sessions: 0, tokens: 0, inTok: 0, cached: 0, cost_usd: 0, ratingSum: 0 };\n    m.sessions += 1; m.tokens += tok; m.inTok += s.input_tokens; m.cached += s.cached_tokens; m.cost_usd = r3(m.cost_usd + s.cost_usd); m.ratingSum += s.rating;\n    modelMap.set(s.model, m);\n\n    const c = catMap.get(s.category) || { category: s.category, sessions: 0, tokens: 0, cost_usd: 0, ratingSum: 0 };\n    c.sessions += 1; c.tokens += tok; c.cost_usd = r3(c.cost_usd + s.cost_usd); c.ratingSum += s.rating;\n    catMap.set(s.category, c);\n  }\n\n  const total_tokens = input_tokens + output_tokens;\n  const cache_hit_pct = input_tokens > 0 ? r2((cached_tokens / input_tokens) * 100) : 0;\n  const avg_rating = filtered.length ? r2(ratingSum / filtered.length) : 0;\n\n  // daily ascending\n  const daily = Array.from(dayMap.values()).sort((a, b) => a.date.localeCompare(b.date));\n  // streak calculation from anchorDate\n  let streak_days = 0;\n  if (daily.length) {\n    const activeSet = new Set(daily.map(d => d.date));\n    let cursor = new Date(`${anchorDate}T00:00:00Z`);\n    while (activeSet.has(cursor.toISOString().slice(0, 10))) {\n      streak_days += 1;\n      cursor = new Date(cursor.getTime() - 86400000);\n    }\n  }\n  let peak_hour = 0;\n  for (let h = 1; h < 24; h++) if (hours[h] > hours[peak_hour]) peak_hour = h;\n\n  const models = Array.from(modelMap.values())\n    .map(m => ({\n      model: m.model,\n      sessions: m.sessions,\n      tokens: m.tokens,\n      cost_usd: r2(m.cost_usd),\n      avg_rating: r2(m.ratingSum / m.sessions),\n      share_pct: total_tokens > 0 ? r2((m.tokens / total_tokens) * 100) : 0,\n      cache_pct: m.inTok > 0 ? r2((m.cached / m.inTok) * 100) : 0,\n    }))\n    .sort((a, b) => b.tokens - a.tokens);\n\n  const categories = Array.from(catMap.values())\n    .map(c => ({\n      category: c.category,\n      sessions: c.sessions,\n      tokens: c.tokens,\n      cost_usd: r2(c.cost_usd),\n      avg_rating: r2(c.ratingSum / c.sessions),\n      share_pct: total_tokens > 0 ? r2((c.tokens / total_tokens) * 100) : 0,\n    }))\n    .sort((a, b) => b.tokens - a.tokens);\n\n  // 月度预算口径：统计最近 30 天汇总\n  const monthSessions = sorted.filter(s => {\n    const diff = dateDiffDays(anchorDate, s.date);\n    return diff >= 0 && diff < 30;\n  });\n  const monthCost = monthSessions.reduce((a, s) => a + s.cost_usd, 0);\n  const monthTokens = monthSessions.reduce((a, s) => a + s.input_tokens + s.output_tokens, 0);\n  const cost_used_pct = r2((monthCost / Math.max(0.01, config.monthly_cost_usd)) * 100);\n  const token_used_pct = r2(((monthTokens / 1_000_000) / Math.max(0.01, config.monthly_tokens_m)) * 100);\n  const peakPct = Math.max(cost_used_pct, token_used_pct);\n  const alert_level = peakPct >= 90 ? 'critical' : peakPct >= 70 ? 'warn' : 'ok';\n\n  return {\n    range,\n    kpis: {\n      session_count: filtered.length,\n      total_tokens,\n      input_tokens,\n      output_tokens,\n      cached_tokens,\n      cache_hit_pct,\n      total_cost_usd: r2(total_cost_usd),\n      total_minutes,\n      total_turns,\n      avg_rating,\n      active_days: daily.length,\n      streak_days,\n      peak_hour,\n    },\n    budget: {\n      monthly_cost_usd: config.monthly_cost_usd,\n      monthly_tokens_m: config.monthly_tokens_m,\n      cost_used_pct,\n      token_used_pct,\n      alert_level,\n    },\n    daily,\n    models,\n    categories,\n    hours,\n    sessions: filtered,\n    latest_review: config.latest_review || '',\n  };\n}\n\nfunction demoData() {\n  const raw = [\n    ['s-01', '2026-11-21', 19, 'Velai 旗舰原生插件套件架构与 Seatbelt 实测', 'coding', 'Gemini 2.5 Pro', 420000, 96000, 295000, 1.38, 28, 64, 5, '完成 10 个旗舰插件并通过真实 macOS QuickJS Seatbelt 验证', 'plugins,rust,quickjs'],\n    ['s-02', '2026-11-21', 15, '股票 AI 投研终端回测策略与 DCF 模型推导', 'research', 'Claude Sonnet 4', 185000, 42000, 110000, 0.94, 16, 38, 5, '实现双均线/RSI/布林带回测与安全边际估值引擎', 'quant,finance'],\n    ['s-03', '2026-11-20', 22, '长篇科幻《星渊回响》第一卷人物关系与伏笔设计', 'writing', 'Claude Sonnet 4', 142000, 58000, 88000, 1.10, 19, 45, 5, '确立林深/沈清秋/陆沉舟三角张力及 4 条核心伏笔', 'novel,creative'],\n    ['s-04', '2026-11-20', 16, 'macOS 原生插件 GitHub Release 签名更新验收', 'ops', 'Gemini 2.5 Flash', 96000, 21000, 62000, 0.04, 11, 18, 4, '核对 ed25519 签名与代理回滚路径', 'release,ci'],\n    ['s-05', '2026-11-19', 20, '桌面端 Session Store 分片压缩性能诊断', 'coding', 'Gemini 2.5 Pro', 310000, 68000, 215000, 0.96, 22, 52, 5, '定位 SQLite WAL 写入热点并将加载耗时降低 42%', 'sqlite,perf'],\n    ['s-06', '2026-11-19', 11, 'Q4 桌面端产品路线图与 RICE 需求排期评审', 'planning', 'GPT-4.1', 88000, 26000, 45000, 0.40, 12, 24, 4, '完成 8 个重点需求打分与 12 周里程碑拆解', 'roadmap,prd'],\n    ['s-07', '2026-11-18', 21, 'Agent Tool 沙箱权限模型安全论文精读与对比', 'research', 'Claude Sonnet 4', 215000, 49000, 148000, 1.05, 17, 42, 5, '对比 6 篇主流 Agent 隔离与工具调用协议论文', 'papers,security'],\n    ['s-08', '2026-11-18', 14, '每日站会纪要提炼与客户跟进邮件起草', 'writing', 'Gemini 2.5 Flash', 42000, 14000, 24000, 0.02, 7, 10, 4, '生成 3 封高回复率 B2B 方案推进邮件', 'email,crm'],\n    ['s-09', '2026-11-17', 19, 'React + Antd 插件页隔离 iframe 通信重构', 'coding', 'Gemini 2.5 Pro', 268000, 61000, 180000, 0.85, 21, 48, 5, '消除跨页 lease 竞争并补齐回归单测', 'frontend,ipc'],\n    ['s-10', '2026-11-16', 17, '家庭资产配置再平衡与 20 年 FIRE 现金流测算', 'planning', 'DeepSeek R1', 124000, 38000, 72000, 0.12, 14, 30, 5, '制定股债 60/40 再平衡策略与房贷提前还款方案', 'finance,fire'],\n    ['s-11', '2026-11-15', 22, 'QuickJS 内存限制与 Promise Rejection Tracker 排查', 'coding', 'Claude Sonnet 4', 240000, 52000, 165000, 1.12, 18, 41, 5, '解决未处理拒绝计数边界条件', 'rust,quickjs'],\n    ['s-12', '2026-11-14', 15, 'Syncthing 跨端文件冲突排查脚本编写', 'ops', 'Gemini 2.5 Flash', 64000, 19000, 36000, 0.03, 9, 14, 4, '输出一键冲突文件扫描与归档命令', 'shell,sync'],\n    ['s-13', '2026-11-12', 20, '公众号与小红书爆款技术长文一稿多改', 'writing', 'GPT-4.1', 112000, 44000, 58000, 0.62, 13, 28, 4, '产出公众号深度文 + 小红书卡片 + X 串推', 'content,growth'],\n    ['s-14', '2026-11-10', 10, '分布式订单与风控微服务 OpenAPI 契约设计', 'coding', 'Gemini 2.5 Pro', 198000, 54000, 128000, 0.72, 16, 36, 5, '消除支付与风控循环依赖并生成 TS SDK 类型', 'api,arch'],\n    ['s-15', '2026-11-08', 21, '日常技术概念速查与英语地道表达润色', 'chat', 'Gemini 2.5 Flash', 36000, 12000, 18000, 0.02, 8, 9, 3, '高频短问答与英文文档语法润色', 'quick,english'],\n    ['s-16', '2026-11-05', 16, 'LLM Prompt Caching 成本优化方案测算', 'research', 'DeepSeek R1', 156000, 41000, 112000, 0.14, 14, 33, 5, '通过前缀稳定化将系统提示缓存命中率提升至 72%', 'llm,cache'],\n    ['s-17', '2026-11-02', 19, 'Tauri 桌面应用安装包体积瘦身与签名排查', 'ops', 'Gemini 2.5 Pro', 175000, 39000, 115000, 0.56, 15, 34, 4, '优化产物打包流程并清理冗余依赖', 'tauri,macos'],\n    ['s-18', '2026-10-29', 14, '季度 OKR 目标拆解与关键指标复盘', 'planning', 'GPT-4.1', 78000, 24000, 41000, 0.36, 10, 22, 4, '对齐 Q4 研发交付与插件生态建设核心 KR', 'okr,review'],\n  ];\n\n  const sessions = raw.map(([id, date, hour, title, category, model, input_tokens, output_tokens, cached_tokens, cost_usd, turns, minutes, rating, summary, tags]) => ({\n    id, date, hour, title, category, model, input_tokens, output_tokens, cached_tokens, cost_usd, turns, minutes, rating, summary, tags,\n  }));\n\n  const config = {\n    schema_version: 1,\n    monthly_cost_usd: 15,\n    monthly_tokens_m: 6,\n    latest_review: '【近 30 天个人 AI 使用复盘】\\n1. 效率亮点：编程与架构类会话占比最高（约 52%），且高价值（5 星）会话集中在晚间 19:00–22:00 深度专注时段。\\n2. 成本控制：整体 Prompt 缓存命中率达 66%+，轻量任务合理分流至 Flash/DeepSeek，有效拉低综合千 Token 成本。\\n3. 优化建议：可继续把常规摘要与润色固定在轻量模型，将高阶模型额度留给跨文件重构与深度投研。',\n  };\n\n  return { sessions, config };\n}\n\nexport default async function (request) {\n  const { kind, contribution, input } = request ?? {};\n\n  if (kind === 'action') {\n    if (contribution === 'usage.dashboard') {\n      const sRes = await readKey('sessions', 'index', { schema_version: 1, items: [] });\n      const gRes = await readKey('goals', 'config', DEFAULT_CONFIG);\n      const data = aggregate(sRes.value.items || [], { ...DEFAULT_CONFIG, ...gRes.value }, input.range || '30d');\n      return { revision: Math.max(sRes.revision, gRes.revision), ...data };\n    }\n\n    if (contribution === 'usage.session.save') {\n      const sRes = await readKey('sessions', 'index', { schema_version: 1, items: [] });\n      if (sRes.revision !== input.expected_revision) return { status: 'conflict', revision: sRes.revision };\n      const rec = sanitizeSession(input, input.id);\n      if (!rec) return { status: 'invalid_input', revision: sRes.revision };\n      const list = sRes.value.items || [];\n      const exists = list.some(s => s.id === rec.id);\n      const next = sortSessions(exists ? list.map(s => (s.id === rec.id ? rec : s)) : [rec, ...list]).slice(0, MAX_SESSIONS);\n      return writeKey('sessions', 'index', input.expected_revision, { schema_version: 1, items: next });\n    }\n\n    if (contribution === 'usage.session.batch_ingest') {\n      const sRes = await readKey('sessions', 'index', { schema_version: 1, items: [] });\n      if (sRes.revision !== input.expected_revision) return { status: 'conflict', revision: sRes.revision, ingested: 0 };\n      if (!Array.isArray(input.items) || !input.items.length) return { status: 'invalid_input', revision: sRes.revision, ingested: 0 };\n      const map = new Map((sRes.value.items || []).map(s => [s.id, s]));\n      let ingested = 0;\n      for (let i = 0; i < input.items.length; i++) {\n        const rec = sanitizeSession(input.items[i], `s-${Date.now().toString(36)}-${i}`);\n        if (!rec) continue;\n        map.set(rec.id, rec);\n        ingested += 1;\n      }\n      if (!ingested) return { status: 'invalid_input', revision: sRes.revision, ingested: 0 };\n      const next = sortSessions(Array.from(map.values())).slice(0, MAX_SESSIONS);\n      const w = await writeKey('sessions', 'index', input.expected_revision, { schema_version: 1, items: next });\n      return { status: w.status, revision: w.revision, ingested: w.status === 'saved' ? ingested : 0 };\n    }\n\n    if (contribution === 'usage.session.delete') {\n      const sRes = await readKey('sessions', 'index', { schema_version: 1, items: [] });\n      if (sRes.revision !== input.expected_revision) return { status: 'conflict', revision: sRes.revision };\n      const list = sRes.value.items || [];\n      if (!list.some(s => s.id === input.id)) return { status: 'not_found', revision: sRes.revision };\n      const w = await writeKey('sessions', 'index', input.expected_revision, { schema_version: 1, items: list.filter(s => s.id !== input.id) });\n      return w.status === 'saved' ? { status: 'deleted', revision: w.revision } : { status: 'conflict', revision: w.revision };\n    }\n\n    if (contribution === 'usage.config.save') {\n      const gRes = await readKey('goals', 'config', DEFAULT_CONFIG);\n      if (gRes.revision !== input.expected_revision) return { status: 'conflict', revision: gRes.revision };\n      const next = {\n        schema_version: 1,\n        monthly_cost_usd: r2(input.monthly_cost_usd),\n        monthly_tokens_m: r2(input.monthly_tokens_m),\n        latest_review: input.latest_review !== undefined ? input.latest_review.trim() : (gRes.value.latest_review || ''),\n      };\n      return writeKey('goals', 'config', input.expected_revision, next);\n    }\n\n    if (contribution === 'usage.seed_demo') {\n      const sRes = await readKey('sessions', 'index', { schema_version: 1, items: [] });\n      if (sRes.revision !== input.expected_revision) return { status: 'conflict', revision: sRes.revision };\n      const d = demoData();\n      const w1 = await writeKey('sessions', 'index', input.expected_revision, { schema_version: 1, items: d.sessions });\n      if (w1.status !== 'saved') return { status: 'conflict', revision: w1.revision };\n      const w2 = await writeKey('goals', 'config', w1.revision, d.config);\n      if (w2.status !== 'saved') return { status: 'conflict', revision: w2.revision };\n      return { status: 'seeded', revision: w2.revision };\n    }\n\n    if (contribution === 'document.list') {\n      const sRes = await readKey('sessions', 'index', { items: [] });\n      return { items: sRes.value.items?.length ? [{ id: 'telemetry', label: `个人会话与用量档案 (${sRes.value.items.length} 条)` }] : [] };\n    }\n\n    if (contribution === 'document.export') {\n      if (input.id !== 'telemetry') return { error: 'not_found' };\n      const sRes = await readKey('sessions', 'index', { items: [] });\n      const gRes = await readKey('goals', 'config', DEFAULT_CONFIG);\n      const text = JSON.stringify({ format: DOC_FORMAT, version: 1, sessions: sRes.value.items, config: gRes.value }, null, 2);\n      return { filename: 'velai-usage-analytics.json', text };\n    }\n\n    if (contribution === 'document.import') {\n      let parsed;\n      try { parsed = JSON.parse(input.text); } catch { return { imported: false, reason: 'invalid_json' }; }\n      if (parsed?.format !== DOC_FORMAT || parsed?.version !== 1 || !Array.isArray(parsed.sessions)) {\n        return { imported: false, reason: 'invalid_document' };\n      }\n      const sRes = await readKey('sessions', 'index', { items: [] });\n      const map = new Map((sRes.value.items || []).map(s => [s.id, s]));\n      for (let i = 0; i < parsed.sessions.length; i++) {\n        const rec = sanitizeSession(parsed.sessions[i], `imp-${Date.now().toString(36)}-${i}`);\n        if (rec) map.set(rec.id, rec);\n      }\n      const next = sortSessions(Array.from(map.values())).slice(0, MAX_SESSIONS);\n      const w1 = await writeKey('sessions', 'index', sRes.revision, { schema_version: 1, items: next });\n      if (w1.status !== 'saved') return { imported: false, reason: w1.status };\n      if (parsed.config) {\n        await writeKey('goals', 'config', w1.revision, {\n          schema_version: 1,\n          monthly_cost_usd: Math.max(1, Number(parsed.config.monthly_cost_usd) || 45),\n          monthly_tokens_m: Math.max(0.1, Number(parsed.config.monthly_tokens_m) || 12),\n          latest_review: typeof parsed.config.latest_review === 'string' ? parsed.config.latest_review.slice(0, 1600) : '',\n        });\n      }\n      return { imported: true };\n    }\n  }\n\n  if (kind === 'tool') {\n    if (contribution === 'usage.dashboard.summary') {\n      const sRes = await readKey('sessions', 'index', { items: [] });\n      const gRes = await readKey('goals', 'config', DEFAULT_CONFIG);\n      const agg = aggregate(sRes.value.items || [], { ...DEFAULT_CONFIG, ...gRes.value }, input.range || '30d');\n      return {\n        success: true,\n        status: agg.kpis.session_count ? 'ready' : 'empty',\n        session_count: agg.kpis.session_count,\n        total_tokens: agg.kpis.total_tokens,\n        cache_hit_pct: agg.kpis.cache_hit_pct,\n        total_cost_usd: agg.kpis.total_cost_usd,\n        budget_alert: agg.budget.alert_level,\n        top_model: agg.models[0]?.model || '暂无',\n        top_category: agg.categories[0]?.category || '暂无',\n        peak_hour: agg.kpis.peak_hour,\n      };\n    }\n\n    if (contribution === 'usage.session.record') {\n      const sRes = await readKey('sessions', 'index', { schema_version: 1, items: [] });\n      const id = `s-${Date.now().toString(36)}`;\n      const rec = sanitizeSession(input, id);\n      if (!rec) return { success: false, status: 'invalid_input' };\n      const next = sortSessions([rec, ...(sRes.value.items || [])]).slice(0, MAX_SESSIONS);\n      const saved = await writeKey('sessions', 'index', sRes.revision, { schema_version: 1, items: next });\n      return { success: saved.status === 'saved', status: saved.status, id };\n    }\n\n    if (contribution === 'usage.budget.status') {\n      const sRes = await readKey('sessions', 'index', { items: [] });\n      const gRes = await readKey('goals', 'config', DEFAULT_CONFIG);\n      const agg = aggregate(sRes.value.items || [], { ...DEFAULT_CONFIG, ...gRes.value }, '30d');\n      return {\n        success: true,\n        status: 'ready',\n        alert_level: agg.budget.alert_level,\n        cost_used_pct: agg.budget.cost_used_pct,\n        token_used_pct: agg.budget.token_used_pct,\n        monthly_cost_usd: agg.budget.monthly_cost_usd,\n        spent_cost_usd: agg.kpis.total_cost_usd,\n      };\n    }\n  }\n\n  throw new Error(`不支持的调用: ${kind}/${contribution}`);\n}\n","path":"backend/index.js"},{"content":"<!doctype html>\n<html lang=\"zh-CN\" data-theme=\"dark\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>个人会话与用量统计大屏</title>\n  <style>\n    :root {\n      --bg: #060a12;\n      --bg-elev: #0b111d;\n      --bg-card: #101827;\n      --bg-input: #080d17;\n      --fg: #eaf1fc;\n      --fg-muted: #7c8da8;\n      --border: rgba(148, 163, 184, 0.16);\n      --border-strong: rgba(56, 189, 248, 0.35);\n      --cyan: #38bdf8;\n      --cyan-soft: rgba(56, 189, 248, 0.14);\n      --emerald: #34d399;\n      --emerald-soft: rgba(52, 211, 153, 0.14);\n      --amber: #f59e0b;\n      --amber-soft: rgba(245, 158, 11, 0.14);\n      --violet: #a78bfa;\n      --rose: #fb7185;\n      --rose-soft: rgba(251, 113, 133, 0.14);\n      --shadow: 0 12px 30px rgba(0, 0, 0, 0.34);\n      font: 13px/1.55 -apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"PingFang SC\", system-ui, sans-serif;\n    }\n    html[data-theme=\"light\"] {\n      --bg: #f1f5f9;\n      --bg-elev: #ffffff;\n      --bg-card: #ffffff;\n      --bg-input: #f8fafc;\n      --fg: #0f172a;\n      --fg-muted: #64748b;\n      --border: rgba(15, 23, 42, 0.11);\n      --border-strong: rgba(2, 132, 199, 0.38);\n      --cyan: #0284c7;\n      --cyan-soft: rgba(2, 132, 199, 0.1);\n      --emerald: #059669;\n      --amber: #d97706;\n      --violet: #7c3aed;\n      --rose: #e11d48;\n      --shadow: 0 8px 22px rgba(15, 23, 42, 0.06);\n    }\n    * { box-sizing: border-box; }\n    body { margin: 0; background: var(--bg); color: var(--fg); min-height: 100vh; }\n    .mono { font-family: ui-monospace, \"SF Mono\", Menlo, Consolas, monospace; font-variant-numeric: tabular-nums; }\n    .app { display: grid; grid-template-columns: 208px minmax(0, 1fr); min-height: 100vh; }\n    @media (max-width: 840px) { .app { grid-template-columns: 1fr; } .sidebar { border-right: 0; border-bottom: 1px solid var(--border); } }\n\n    .sidebar { background: var(--bg-elev); border-right: 1px solid var(--border); padding: 15px 11px; display: flex; flex-direction: column; gap: 12px; }\n    .brand { padding: 4px 8px; }\n    .brand-tag { font-size: 10px; letter-spacing: 0.15em; color: var(--cyan); font-weight: 700; }\n    .brand h1 { margin: 3px 0 2px; font-size: 15.5px; font-weight: 700; }\n    .brand span { font-size: 11.5px; color: var(--fg-muted); }\n\n    .budget-mini { background: var(--bg-card); border: 1px solid var(--border); border-radius: 10px; padding: 10px; display: flex; flex-direction: column; gap: 6px; }\n    .bar { height: 6px; border-radius: 99px; background: var(--border); overflow: hidden; }\n    .bar > i { display: block; height: 100%; border-radius: 99px; transition: width .25s ease; }\n\n    .nav { display: flex; flex-direction: column; gap: 4px; }\n    .nav button { text-align: left; border: 1px solid transparent; background: transparent; color: var(--fg-muted); padding: 9px 10px; border-radius: 8px; cursor: pointer; font: inherit; font-weight: 500; display: flex; justify-content: space-between; align-items: center; }\n    .nav button:hover { background: var(--bg-card); color: var(--fg); }\n    .nav button.active { background: var(--cyan-soft); color: var(--cyan); border-color: var(--border-strong); font-weight: 600; }\n    .sidebar-foot { margin-top: auto; display: flex; flex-direction: column; gap: 6px; }\n\n    .main { display: flex; flex-direction: column; min-width: 0; }\n    .topbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; padding: 10px 16px; border-bottom: 1px solid var(--border); background: var(--bg-elev); }\n    .range-pills { display: flex; gap: 4px; background: var(--bg-input); padding: 3px; border-radius: 9px; border: 1px solid var(--border); }\n    .range-pills button { border: 0; background: transparent; color: var(--fg-muted); padding: 4px 11px; border-radius: 6px; font-size: 12px; font-weight: 600; }\n    .range-pills button.active { background: var(--cyan); color: #05111e; }\n    html[data-theme=\"light\"] .range-pills button.active { color: #fff; }\n\n    .content { padding: 14px 16px; display: flex; flex-direction: column; gap: 12px; min-width: 0; }\n    .status-bar { font-size: 12px; color: var(--fg-muted); padding: 7px 12px; border-radius: 8px; background: var(--bg-card); border: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; gap: 8px; }\n    .status-bar[data-kind=\"error\"] { color: var(--rose); border-color: rgba(251, 113, 133, 0.45); }\n    .status-bar[data-kind=\"ok\"] { color: var(--emerald); border-color: rgba(52, 211, 153, 0.45); }\n\n    .kpi-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; }\n    @media (max-width: 1080px) { .kpi-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }\n    @media (max-width: 620px) { .kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n    .kpi-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 11px; padding: 12px; box-shadow: var(--shadow); display: flex; flex-direction: column; gap: 4px; position: relative; overflow: hidden; }\n    .kpi-card::before { content: \"\"; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, var(--c1, var(--cyan)), transparent); }\n    .kpi-label { font-size: 11.5px; color: var(--fg-muted); }\n    .kpi-val { font-size: 20px; font-weight: 800; letter-spacing: -0.02em; }\n    .kpi-sub { font-size: 11.5px; color: var(--fg-muted); }\n\n    .dash-2 { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr); gap: 12px; align-items: stretch; }\n    .split-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; align-items: start; }\n    @media (max-width: 880px) { .dash-2, .split-2 { grid-template-columns: 1fr; } }\n\n    .card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 13px; box-shadow: var(--shadow); display: flex; flex-direction: column; gap: 10px; min-width: 0; }\n    .card h3 { margin: 0; font-size: 13.5px; font-weight: 700; }\n    .svg-box { background: var(--bg-input); border: 1px solid var(--border); border-radius: 9px; overflow: hidden; }\n    svg { display: block; width: 100%; height: auto; }\n\n    button, input, select, textarea { font: inherit; color: var(--fg); background: var(--bg-input); border: 1px solid var(--border); border-radius: 7px; padding: 6px 10px; }\n    button { cursor: pointer; background: var(--bg-card); }\n    button.primary { background: var(--cyan); border-color: var(--cyan); color: #05111e; font-weight: 600; }\n    html[data-theme=\"light\"] button.primary { color: #fff; }\n    button.danger { color: var(--rose); border-color: rgba(251, 113, 133, 0.35); }\n    .row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }\n    .between { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: space-between; }\n\n    .sess-card { border: 1px solid var(--border); border-radius: 10px; padding: 11px; background: var(--bg-input); display: flex; flex-direction: column; gap: 6px; }\n    .badge { display: inline-flex; align-items: center; font-size: 11px; padding: 2px 8px; border-radius: 99px; border: 1px solid var(--border); font-weight: 600; }\n    .b-cyan { color: var(--cyan); border-color: var(--border-strong); background: var(--cyan-soft); }\n    .b-emerald { color: var(--emerald); border-color: rgba(52, 211, 153, 0.45); background: var(--emerald-soft); }\n    .b-amber { color: var(--amber); border-color: rgba(245, 158, 11, 0.45); background: var(--amber-soft); }\n    .b-rose { color: var(--rose); border-color: rgba(251, 113, 133, 0.45); background: var(--rose-soft); }\n\n    table { width: 100%; border-collapse: collapse; font-size: 12.5px; }\n    th, td { text-align: left; padding: 8px; border-bottom: 1px solid var(--border); }\n    th { font-size: 11px; color: var(--fg-muted); text-transform: uppercase; letter-spacing: 0.04em; }\n    label.field { display: flex; flex-direction: column; gap: 4px; font-size: 11.5px; color: var(--fg-muted); font-weight: 600; }\n    textarea { width: 100%; min-height: 82px; resize: vertical; }\n    pre.ai-box { margin: 0; white-space: pre-wrap; word-break: break-word; padding: 10px; border-radius: 8px; border: 1px dashed var(--cyan); background: var(--bg-input); max-height: 280px; overflow: auto; font-size: 12.5px; line-height: 1.65; }\n    [hidden] { display: none !important; }\n  </style>\n</head>\n<body>\n  <div class=\"app\">\n    <aside class=\"sidebar\">\n      <div class=\"brand\">\n        <div class=\"brand-tag\">PERSONAL TELEMETRY</div>\n        <h1>个人会话与用量大屏</h1>\n        <span>近期会话 · Token · 费用 · 效率</span>\n      </div>\n\n      <div class=\"budget-mini\">\n        <div class=\"between\" style=\"font-size:11.5px\"><span>月度费用预算</span><strong id=\"sb-cost-pct\" class=\"mono\">0%</strong></div>\n        <div class=\"bar\"><i id=\"sb-cost-bar\" style=\"width:0%;background:var(--cyan)\"></i></div>\n        <div class=\"between\" style=\"font-size:11.5px\"><span>月度 Token 预算</span><strong id=\"sb-tok-pct\" class=\"mono\">0%</strong></div>\n        <div class=\"bar\"><i id=\"sb-tok-bar\" style=\"width:0%;background:var(--emerald)\"></i></div>\n      </div>\n\n      <nav class=\"nav\">\n        <button class=\"active\" data-view=\"dashboard\" type=\"button\"><span>📡 全景统计大屏</span><span id=\"nav-days\" class=\"mono\">0d</span></button>\n        <button data-view=\"sessions\" type=\"button\"><span>🗂️ 近期会话整理</span><span id=\"nav-sess\" class=\"mono\">0</span></button>\n        <button data-view=\"models\" type=\"button\"><span>💎 模型性价比与预算</span><span id=\"nav-mod\" class=\"mono\">0</span></button>\n        <button data-view=\"sync\" type=\"button\"><span>🤖 AI 自动汇总复盘</span><span>✨</span></button>\n      </nav>\n\n      <div class=\"sidebar-foot\">\n        <button id=\"btn-demo\" class=\"primary\" type=\"button\">✨ 加载 30 天演示大屏</button>\n        <button id=\"btn-theme\" type=\"button\">☀️ 切换深浅外观</button>\n      </div>\n    </aside>\n\n    <div class=\"main\">\n      <header class=\"topbar\">\n        <div class=\"row\">\n          <strong style=\"font-size:14.5px\">个人 AI 使用情况驾驶舱</strong>\n          <div class=\"range-pills\">\n            <button data-range=\"7d\" type=\"button\">近 7 天</button>\n            <button class=\"active\" data-range=\"30d\" type=\"button\">近 30 天</button>\n            <button data-range=\"all\" type=\"button\">全部历史</button>\n          </div>\n        </div>\n        <div class=\"row\">\n          <button id=\"btn-quick-sync\" class=\"primary\" type=\"button\">🤖 一键整理近期会话</button>\n          <button id=\"btn-refresh\" type=\"button\">刷新</button>\n        </div>\n      </header>\n\n      <div class=\"content\">\n        <div id=\"status\" class=\"status-bar\"><span id=\"status-text\">正在加载个人使用统计…</span><span id=\"rev-tag\" class=\"mono\">rev #0</span></div>\n\n        <!-- KPI 5 Cards -->\n        <section class=\"kpi-grid\">\n          <div class=\"kpi-card\" style=\"--c1:var(--cyan)\">\n            <span class=\"kpi-label\">区间会话数</span>\n            <strong id=\"k-sessions\" class=\"kpi-val mono\">0</strong>\n            <span id=\"k-streak\" class=\"kpi-sub\">活跃 0 天 · 连续 0 天</span>\n          </div>\n          <div class=\"kpi-card\" style=\"--c1:var(--emerald)\">\n            <span class=\"kpi-label\">总 Token 消耗</span>\n            <strong id=\"k-tokens\" class=\"kpi-val mono\">0</strong>\n            <span id=\"k-cache\" class=\"kpi-sub\">缓存命中率 0%</span>\n          </div>\n          <div class=\"kpi-card\" style=\"--c1:var(--amber)\">\n            <span class=\"kpi-label\">区间估算费用</span>\n            <strong id=\"k-cost\" class=\"kpi-val mono\">$0.00</strong>\n            <span id=\"k-budget-sub\" class=\"kpi-sub\">月度预算占用 0%</span>\n          </div>\n          <div class=\"kpi-card\" style=\"--c1:var(--violet)\">\n            <span class=\"kpi-label\">深度协作时长</span>\n            <strong id=\"k-mins\" class=\"kpi-val mono\">0h</strong>\n            <span id=\"k-turns\" class=\"kpi-sub\">共 0 轮对话</span>\n          </div>\n          <div class=\"kpi-card\" style=\"--c1:var(--rose)\">\n            <span class=\"kpi-label\">平均价值评分</span>\n            <strong id=\"k-rating\" class=\"kpi-val mono\">0.0 ★</strong>\n            <span id=\"k-peak\" class=\"kpi-sub\">高峰时段 --:00</span>\n          </div>\n        </section>\n\n        <!-- VIEW 1: 全景统计大屏 -->\n        <section id=\"view-dashboard\" style=\"display:flex;flex-direction:column;gap:12px\">\n          <div class=\"dash-2\">\n            <div class=\"card\">\n              <div class=\"between\">\n                <h3>每日 Token 消耗（含缓存节省）与费用趋势</h3>\n                <span id=\"daily-hover\" class=\"mono\" style=\"font-size:11.5px;color:var(--cyan)\">悬停柱条查看当日详情</span>\n              </div>\n              <div class=\"svg-box\"><svg id=\"daily-svg\" viewBox=\"0 0 660 248\"></svg></div>\n            </div>\n\n            <div class=\"card\">\n              <div class=\"between\">\n                <h3>24 小时活跃与专注高峰分布</h3>\n                <span style=\"font-size:11.5px;color:var(--fg-muted)\">按会话开启小时统计</span>\n              </div>\n              <div class=\"svg-box\"><svg id=\"hour-svg\" viewBox=\"0 0 420 248\"></svg></div>\n            </div>\n          </div>\n\n          <div class=\"split-2\">\n            <div class=\"card\">\n              <h3>模型用量占比环形图</h3>\n              <div class=\"svg-box\"><svg id=\"model-svg\" viewBox=\"0 0 460 215\"></svg></div>\n            </div>\n            <div class=\"card\">\n              <h3>场景分类 Token 分布与平均价值分</h3>\n              <div class=\"svg-box\"><svg id=\"cat-svg\" viewBox=\"0 0 460 215\"></svg></div>\n            </div>\n          </div>\n        </section>\n\n        <!-- VIEW 2: 近期会话整理 -->\n        <section id=\"view-sessions\" class=\"dash-2\" hidden>\n          <div class=\"card\">\n            <div class=\"between\">\n              <h3>近期会话归档库 (<span id=\"sess-shown\">0</span>)</h3>\n              <div class=\"row\">\n                <select id=\"f-cat-filter\" style=\"width:105px\">\n                  <option value=\"\">全部分类</option>\n                  <option value=\"coding\">编程开发</option>\n                  <option value=\"writing\">文档写作</option>\n                  <option value=\"research\">深度研究</option>\n                  <option value=\"planning\">规划决策</option>\n                  <option value=\"ops\">运维排障</option>\n                  <option value=\"chat\">日常问答</option>\n                </select>\n                <input id=\"f-search\" type=\"search\" placeholder=\"搜索标题、模型或标签…\" style=\"width:170px\">\n              </div>\n            </div>\n            <div id=\"sess-list\" style=\"display:flex;flex-direction:column;gap:8px;max-height:540px;overflow:auto\"></div>\n          </div>\n\n          <div class=\"card\">\n            <div class=\"between\">\n              <h3 id=\"form-caption\">录入 / 编辑会话用量</h3>\n              <div class=\"row\">\n                <button id=\"btn-from-sel\" type=\"button\" hidden>读入选中回复</button>\n                <button id=\"btn-new-sess\" type=\"button\">+ 新记录</button>\n              </div>\n            </div>\n            <label class=\"field\">会话标题 <input id=\"s-title\" maxlength=\"100\" placeholder=\"例如：优化桌面插件通信协议\"></label>\n            <div class=\"row\">\n              <label class=\"field\" style=\"flex:1\">日期 <input id=\"s-date\" type=\"date\"></label>\n              <label class=\"field\" style=\"width:74px\">小时 <input id=\"s-hour\" type=\"number\" min=\"0\" max=\"23\" value=\"20\"></label>\n              <label class=\"field\" style=\"width:105px\">场景\n                <select id=\"s-cat\">\n                  <option value=\"coding\">编程开发</option>\n                  <option value=\"writing\">文档写作</option>\n                  <option value=\"research\">深度研究</option>\n                  <option value=\"planning\">规划决策</option>\n                  <option value=\"ops\">运维排障</option>\n                  <option value=\"chat\">日常问答</option>\n                </select>\n              </label>\n            </div>\n            <div class=\"row\">\n              <label class=\"field\" style=\"flex:1.2\">模型 <input id=\"s-model\" maxlength=\"48\" value=\"Gemini 2.5 Pro\" placeholder=\"如 Gemini 2.5 Pro\"></label>\n              <label class=\"field\" style=\"width:92px\">费用($) <input id=\"s-cost\" type=\"number\" step=\"0.01\" min=\"0\" placeholder=\"自动估算\"></label>\n              <label class=\"field\" style=\"width:76px\">价值分 <input id=\"s-rating\" type=\"number\" min=\"1\" max=\"5\" value=\"5\"></label>\n            </div>\n            <div class=\"row\">\n              <label class=\"field\" style=\"flex:1\">输入 Token <input id=\"s-in\" type=\"number\" min=\"0\" value=\"80000\"></label>\n              <label class=\"field\" style=\"flex:1\">输出 Token <input id=\"s-out\" type=\"number\" min=\"0\" value=\"20000\"></label>\n              <label class=\"field\" style=\"flex:1\">缓存命中 <input id=\"s-cache\" type=\"number\" min=\"0\" value=\"40000\"></label>\n            </div>\n            <div class=\"row\">\n              <label class=\"field\" style=\"flex:1\">对话轮次 <input id=\"s-turns\" type=\"number\" min=\"1\" value=\"12\"></label>\n              <label class=\"field\" style=\"flex:1\">耗时(分钟) <input id=\"s-mins\" type=\"number\" min=\"1\" value=\"25\"></label>\n              <label class=\"field\" style=\"flex:1.3\">标签 <input id=\"s-tags\" maxlength=\"80\" placeholder=\"rust,ui\"></label>\n            </div>\n            <label class=\"field\">核心产出摘要 <textarea id=\"s-summary\" maxlength=\"260\" placeholder=\"记录本次会话解决的问题、产出或结论…\"></textarea></label>\n            <button id=\"btn-save-sess\" class=\"primary\" type=\"button\">保存会话记录</button>\n          </div>\n        </section>\n\n        <!-- VIEW 3: 模型性价比与预算 -->\n        <section id=\"view-models\" style=\"display:flex;flex-direction:column;gap:12px\" hidden>\n          <div class=\"card\">\n            <h3>各模型效率与 ROI 性价比明细</h3>\n            <div style=\"overflow-x:auto\">\n              <table>\n                <thead><tr><th>模型名称</th><th>会话数</th><th>总 Token</th><th>缓存命中</th><th>估算费用</th><th>单次均价</th><th>均价 / 1M Tok</th><th>平均价值分</th></tr></thead>\n                <tbody id=\"model-tbody\"></tbody>\n              </table>\n            </div>\n          </div>\n\n          <div class=\"card\">\n            <div class=\"between\">\n              <h3>月度个人预算与告警阈值</h3>\n              <span id=\"alert-badge\" class=\"badge b-emerald\">预算健康</span>\n            </div>\n            <div class=\"row\">\n              <label class=\"field\" style=\"width:180px\">月度费用预算 (USD) <input id=\"cfg-cost\" type=\"number\" min=\"1\" step=\"1\"></label>\n              <label class=\"field\" style=\"width:180px\">月度 Token 预算 (百万 M) <input id=\"cfg-tok\" type=\"number\" min=\"0.1\" step=\"0.5\"></label>\n              <button id=\"btn-save-cfg\" class=\"primary\" type=\"button\" style=\"align-self:flex-end\">保存预算设置</button>\n            </div>\n            <p id=\"budget-tip\" style=\"margin:0;font-size:12.5px;color:var(--fg-muted)\"></p>\n          </div>\n        </section>\n\n        <!-- VIEW 4: AI 自动汇总与复盘 -->\n        <section id=\"view-sync\" class=\"split-2\" hidden>\n          <div class=\"card\">\n            <h3>🤖 请当前会话 / 助手整理近期会话并导入</h3>\n            <p style=\"margin:0;font-size:12px;color:var(--fg-muted)\">\n              出于 Velai 沙箱隔离机制，插件不直接读取宿主底层数据库。点击下方按钮将向当前会话/个人助手发送结构化采集指令，核对回复后可一键解析并批量并入统计大屏（或在日常聊天中直接让助手调用 <code>usage.session.record</code> 工具自动归档）。\n            </p>\n            <div class=\"row\">\n              <button id=\"btn-ai-collect\" class=\"primary\" type=\"button\">1. 派发近期会话整理指令</button>\n              <button id=\"btn-ai-review\" type=\"button\">生成个人 AI 效率周报</button>\n              <button id=\"btn-ai-check\" type=\"button\" hidden>2. 核对助手回复</button>\n            </div>\n            <p id=\"ai-status\" style=\"margin:0;font-size:12px;color:var(--fg-muted)\"></p>\n            <pre id=\"ai-preview\" class=\"ai-box\" hidden></pre>\n            <div id=\"ai-actions\" class=\"row\" hidden>\n              <button id=\"btn-ai-ingest\" class=\"primary\" type=\"button\" hidden>一键解析 JSON 并导入大屏</button>\n              <button id=\"btn-ai-save-rev\" class=\"primary\" type=\"button\" hidden>保存为最新个人复盘</button>\n              <button id=\"btn-ai-insert\" type=\"button\" hidden>插入输入框</button>\n            </div>\n          </div>\n\n          <div class=\"card\">\n            <h3>最新个人使用复盘与效率诊断</h3>\n            <pre id=\"saved-review\" class=\"ai-box\" style=\"min-height:220px;border-style:solid;border-color:var(--border)\"></pre>\n          </div>\n        </section>\n      </div>\n    </div>\n  </div>\n  <script>\n    (() => {\n      const plugin = globalThis.nmasPlugin;\n      const $ = id => document.getElementById(id);\n      const CAT_NAME = { coding: '编程开发', writing: '文档写作', research: '深度研究', planning: '规划决策', ops: '运维排障', chat: '日常问答' };\n      const PALETTE = ['#38bdf8', '#34d399', '#f59e0b', '#a78bfa', '#fb7185', '#60a5fa'];\n\n      let state = null, currentRange = '30d', editingId = null, busy = false, workId = null, aiTaskKind = 'collect', latestAiText = '', canReadSel = false, canInsert = false;\n\n      const setStatus = (t, kind = '') => {\n        $('status-text').textContent = t;\n        $('status').dataset.kind = kind;\n        $('rev-tag').textContent = `rev #${state?.revision ?? 0}`;\n      };\n      const fmtTok = n => n >= 1_000_000 ? `${(n / 1_000_000).toFixed(2)}M` : n >= 1000 ? `${(n / 1000).toFixed(1)}K` : String(n);\n      const today = () => new Date().toISOString().slice(0, 10);\n      const uuid = () => {\n        const b = crypto.getRandomValues(new Uint8Array(16));\n        b[6] = (b[6] & 0x0f) | 0x40; b[8] = (b[8] & 0x3f) | 0x80;\n        const h = Array.from(b, x => x.toString(16).padStart(2, '0')).join('');\n        return `${h.slice(0,8)}-${h.slice(8,12)}-${h.slice(12,16)}-${h.slice(16,20)}-${h.slice(20)}`;\n      };\n      const svgEl = (tag, attrs = {}, text = '') => {\n        const el = document.createElementNS('http://www.w3.org/2000/svg', tag);\n        for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, String(v));\n        if (text) el.textContent = text;\n        return el;\n      };\n\n      function switchView(v) {\n        document.querySelectorAll('.nav button').forEach(b => b.classList.toggle('active', b.dataset.view === v));\n        ['dashboard', 'sessions', 'models', 'sync'].forEach(n => { $(`view-${n}`).hidden = n !== v; });\n      }\n\n      function renderKpis() {\n        const { kpis, budget } = state;\n        $('k-sessions').textContent = String(kpis.session_count);\n        $('k-streak').textContent = `活跃 ${kpis.active_days} 天 · 连续 ${kpis.streak_days} 天`;\n        $('k-tokens').textContent = fmtTok(kpis.total_tokens);\n        $('k-cache').textContent = `缓存命中率 ${kpis.cache_hit_pct}% (省 ${fmtTok(kpis.cached_tokens)})`;\n        $('k-cost').textContent = `$${kpis.total_cost_usd.toFixed(2)}`;\n        $('k-budget-sub').textContent = `近30天预算占用 ${budget.cost_used_pct}% / $${budget.monthly_cost_usd}`;\n        $('k-mins').textContent = `${(kpis.total_minutes / 60).toFixed(1)}h`;\n        $('k-turns').textContent = `共 ${kpis.total_turns} 轮深度交互`;\n        $('k-rating').textContent = `${kpis.avg_rating.toFixed(1)} ★`;\n        $('k-peak').textContent = kpis.session_count ? `黄金高效时段 ${String(kpis.peak_hour).padStart(2, '0')}:00` : '暂无高峰时段';\n\n        $('nav-days').textContent = `${kpis.active_days}d`;\n        $('nav-sess').textContent = String(state.sessions.length);\n        $('nav-mod').textContent = String(state.models.length);\n\n        const cPct = Math.min(100, budget.cost_used_pct);\n        const tPct = Math.min(100, budget.token_used_pct);\n        $('sb-cost-pct').textContent = `${budget.cost_used_pct}%`;\n        $('sb-cost-bar').style.width = `${cPct}%`;\n        $('sb-cost-bar').style.background = budget.cost_used_pct >= 90 ? 'var(--rose)' : budget.cost_used_pct >= 70 ? 'var(--amber)' : 'var(--cyan)';\n        $('sb-tok-pct').textContent = `${budget.token_used_pct}%`;\n        $('sb-tok-bar').style.width = `${tPct}%`;\n        $('sb-tok-bar').style.background = budget.token_used_pct >= 90 ? 'var(--rose)' : budget.token_used_pct >= 70 ? 'var(--amber)' : 'var(--emerald)';\n\n        $('cfg-cost').value = String(budget.monthly_cost_usd);\n        $('cfg-tok').value = String(budget.monthly_tokens_m);\n        const badge = $('alert-badge');\n        badge.className = `badge ${budget.alert_level === 'critical' ? 'b-rose' : budget.alert_level === 'warn' ? 'b-amber' : 'b-emerald'}`;\n        badge.textContent = budget.alert_level === 'critical' ? '⚠️ 即将超支' : budget.alert_level === 'warn' ? '⚡ 接近警戒线' : '✅ 预算健康';\n        const remainUsd = Math.max(0, budget.monthly_cost_usd - (budget.monthly_cost_usd * budget.cost_used_pct / 100));\n        $('budget-tip').textContent = `近 30 天费用预算剩余约 $${remainUsd.toFixed(2)}，Token 配额已消耗 ${budget.token_used_pct}%（目标上限 ${budget.monthly_tokens_m}M）。`;\n        $('saved-review').textContent = state.latest_review || '暂无已保存的复盘报告。可在左侧点击「生成个人 AI 效率周报」或加载演示数据。';\n      }\n\n      function renderDailyChart() {\n        const svg = $('daily-svg'); svg.replaceChildren();\n        const daily = state.daily;\n        const W = 660, H = 248, padL = 50, padR = 46, padT = 22, padB = 34;\n        const innerW = W - padL - padR, innerH = H - padT - padB;\n        if (!daily.length) {\n          svg.appendChild(svgEl('text', { x: W / 2, y: H / 2, 'text-anchor': 'middle', fill: '#7c8da8', 'font-size': 13 }, '暂无用量数据，点击左侧「✨ 加载 30 天演示大屏」或录入会话'));\n          return;\n        }\n        const maxTok = Math.max(1000, ...daily.map(d => d.tokens));\n        const maxCost = Math.max(0.1, ...daily.map(d => d.cost_usd));\n        for (let i = 0; i <= 4; i++) {\n          const y = padT + (i / 4) * innerH;\n          const tv = maxTok * (1 - i / 4);\n          const cv = maxCost * (1 - i / 4);\n          svg.appendChild(svgEl('line', { x1: padL, y1: y, x2: W - padR, y2: y, stroke: 'rgba(148,163,184,0.13)' }));\n          svg.appendChild(svgEl('text', { x: padL - 6, y: y + 4, 'text-anchor': 'end', fill: '#7c8da8', 'font-size': 10 }, fmtTok(Math.round(tv))));\n          svg.appendChild(svgEl('text', { x: W - padR + 6, y: y + 4, fill: '#f59e0b', 'font-size': 10 }, `$${cv.toFixed(2)}`));\n        }\n\n        const step = innerW / daily.length;\n        const barW = Math.min(28, Math.max(8, step * 0.56));\n        const linePts = [];\n\n        daily.forEach((d, idx) => {\n          const cx = padL + (idx + 0.5) * step;\n          const totalH = (d.tokens / maxTok) * innerH;\n          const cacheH = (Math.min(d.cached, d.tokens) / maxTok) * innerH;\n          const yTop = padT + innerH - totalH;\n          svg.appendChild(svgEl('rect', { x: cx - barW / 2, y: yTop, width: barW, height: Math.max(2, totalH), rx: 3, fill: '#38bdf8', opacity: 0.78 }));\n          if (cacheH > 1) {\n            svg.appendChild(svgEl('rect', { x: cx - barW / 2, y: padT + innerH - cacheH, width: barW, height: cacheH, rx: 2, fill: '#34d399', opacity: 0.9 }));\n          }\n          const cy = padT + innerH - (d.cost_usd / maxCost) * innerH;\n          linePts.push({ x: cx, y: cy, d });\n          if (daily.length <= 10 || idx % Math.ceil(daily.length / 8) === 0 || idx === daily.length - 1) {\n            svg.appendChild(svgEl('text', { x: cx, y: H - 10, 'text-anchor': 'middle', fill: '#7c8da8', 'font-size': 10 }, d.date.slice(5)));\n          }\n          const hit = svgEl('rect', { x: cx - step / 2, y: padT, width: step, height: innerH, fill: 'transparent', style: 'cursor:crosshair' });\n          hit.addEventListener('mouseenter', () => {\n            $('daily-hover').textContent = `${d.date} · ${d.sessions} 会话 · ${fmtTok(d.tokens)} Tok (缓存 ${fmtTok(d.cached)}) · $${d.cost_usd.toFixed(2)} · ${d.minutes}m`;\n          });\n          svg.appendChild(hit);\n        });\n\n        const pathD = linePts.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(' ');\n        svg.appendChild(svgEl('path', { d: pathD, fill: 'none', stroke: '#f59e0b', 'stroke-width': 2.2, 'pointer-events': 'none' }));\n        for (const p of linePts) {\n          svg.appendChild(svgEl('circle', { cx: p.x, cy: p.y, r: 3.3, fill: '#060a12', stroke: '#f59e0b', 'stroke-width': 2, 'pointer-events': 'none' }));\n        }\n        svg.appendChild(svgEl('text', { x: padL, y: 13, fill: '#38bdf8', 'font-size': 10.5 }, '■ 总 Token'));\n        svg.appendChild(svgEl('text', { x: padL + 72, y: 13, fill: '#34d399', 'font-size': 10.5 }, '■ 缓存命中'));\n        svg.appendChild(svgEl('text', { x: padL + 148, y: 13, fill: '#f59e0b', 'font-size': 10.5 }, '● 费用 ($USD)'));\n      }\n\n      function renderHourChart() {\n        const svg = $('hour-svg'); svg.replaceChildren();\n        const hours = state.hours || new Array(24).fill(0);\n        const W = 420, H = 248, padL = 26, padR = 14, padT = 20, padB = 32;\n        const maxV = Math.max(1, ...hours);\n        const innerW = W - padL - padR, innerH = H - padT - padB;\n        const step = innerW / 24;\n        const peak = state.kpis.peak_hour;\n        hours.forEach((cnt, h) => {\n          const bh = (cnt / maxV) * innerH;\n          const x = padL + h * step + 2;\n          const isPeak = cnt > 0 && h === peak;\n          svg.appendChild(svgEl('rect', {\n            x, y: padT + innerH - bh, width: Math.max(6, step - 4), height: Math.max(2, bh), rx: 3,\n            fill: isPeak ? '#f59e0b' : cnt > 0 ? '#a78bfa' : 'rgba(148,163,184,0.14)',\n            opacity: isPeak ? 0.95 : 0.78,\n          }));\n          if (h % 4 === 0 || h === 23) {\n            svg.appendChild(svgEl('text', { x: x + (step - 4) / 2, y: H - 10, 'text-anchor': 'middle', fill: '#7c8da8', 'font-size': 10 }, `${h}h`));\n          }\n        });\n        svg.appendChild(svgEl('text', { x: padL, y: 13, fill: '#a78bfa', 'font-size': 10.5 }, '■ 活跃时段'));\n        svg.appendChild(svgEl('text', { x: padL + 78, y: 13, fill: '#f59e0b', 'font-size': 10.5 }, `■ 峰值 ${String(peak).padStart(2, '0')}:00`));\n      }\n\n      function renderModelDonut() {\n        const svg = $('model-svg'); svg.replaceChildren();\n        const list = state.models;\n        if (!list.length) {\n          svg.appendChild(svgEl('text', { x: 230, y: 108, 'text-anchor': 'middle', fill: '#7c8da8', 'font-size': 12.5 }, '暂无模型用量'));\n          return;\n        }\n        const total = list.reduce((a, b) => a + b.tokens, 0) || 1;\n        const cx = 104, cy = 108, r = 68;\n        let angle = -Math.PI / 2;\n        list.slice(0, 6).forEach((m, idx) => {\n          const frac = m.tokens / total;\n          const next = angle + frac * Math.PI * 2;\n          const col = PALETTE[idx % PALETTE.length];\n          if (frac > 0.999) {\n            svg.appendChild(svgEl('circle', { cx, cy, r, fill: 'none', stroke: col, 'stroke-width': 24 }));\n          } else {\n            const x1 = cx + Math.cos(angle) * r, y1 = cy + Math.sin(angle) * r;\n            const x2 = cx + Math.cos(next) * r, y2 = cy + Math.sin(next) * r;\n            svg.appendChild(svgEl('path', { d: `M ${x1} ${y1} A ${r} ${r} 0 ${frac > 0.5 ? 1 : 0} 1 ${x2} ${y2}`, fill: 'none', stroke: col, 'stroke-width': 24 }));\n          }\n          const ly = 34 + idx * 30;\n          svg.appendChild(svgEl('rect', { x: 204, y: ly - 9, width: 10, height: 10, rx: 2, fill: col }));\n          svg.appendChild(svgEl('text', { x: 222, y: ly, fill: '#cbd5e1', 'font-size': 11.5 }, `${m.model.slice(0, 18)}  ${m.share_pct}% ($${m.cost_usd.toFixed(2)})`));\n          angle = next;\n        });\n        svg.appendChild(svgEl('text', { x: cx, y: cy - 3, 'text-anchor': 'middle', fill: '#7c8da8', 'font-size': 10.5 }, '总用量'));\n        svg.appendChild(svgEl('text', { x: cx, y: cy + 15, 'text-anchor': 'middle', fill: '#eaf1fc', 'font-size': 13, 'font-weight': 700 }, fmtTok(total)));\n      }\n\n      function renderCatBars() {\n        const svg = $('cat-svg'); svg.replaceChildren();\n        const cats = state.categories;\n        if (!cats.length) {\n          svg.appendChild(svgEl('text', { x: 230, y: 108, 'text-anchor': 'middle', fill: '#7c8da8', 'font-size': 12.5 }, '暂无场景分类数据'));\n          return;\n        }\n        const maxTok = Math.max(1, ...cats.map(c => c.tokens));\n        cats.forEach((c, idx) => {\n          const y = 24 + idx * 31;\n          const bw = Math.max(6, (c.tokens / maxTok) * 240);\n          const col = PALETTE[idx % PALETTE.length];\n          svg.appendChild(svgEl('text', { x: 14, y: y + 12, fill: '#cbd5e1', 'font-size': 12 }, CAT_NAME[c.category] || c.category));\n          svg.appendChild(svgEl('rect', { x: 86, y, width: 240, height: 16, rx: 4, fill: 'rgba(148,163,184,0.1)' }));\n          svg.appendChild(svgEl('rect', { x: 86, y, width: bw, height: 16, rx: 4, fill: col, opacity: 0.85 }));\n          svg.appendChild(svgEl('text', { x: 334, y: y + 12, fill: '#94a3b8', 'font-size': 11 }, `${fmtTok(c.tokens)} · ${c.sessions}次 · ${c.avg_rating}★`));\n        });\n      }\n\n      function renderSessions() {\n        const cat = $('f-cat-filter').value;\n        const q = $('f-search').value.trim().toLowerCase();\n        const shown = state.sessions.filter(s => (!cat || s.category === cat) && (!q || `${s.title} ${s.model} ${s.summary} ${s.tags}`.toLowerCase().includes(q)));\n        $('sess-shown').textContent = String(shown.length);\n        const box = $('sess-list'); box.replaceChildren();\n        if (!shown.length) {\n          const p = document.createElement('p'); p.style.color = 'var(--fg-muted)'; p.textContent = '当前筛选下没有会话记录。'; box.appendChild(p); return;\n        }\n        for (const s of shown) {\n          const card = document.createElement('article'); card.className = 'sess-card';\n          const top = document.createElement('div'); top.className = 'between';\n          const title = document.createElement('strong'); title.textContent = s.title;\n          const badges = document.createElement('div'); badges.className = 'row';\n          const b1 = document.createElement('span'); b1.className = 'badge b-cyan'; b1.textContent = s.model;\n          const b2 = document.createElement('span'); b2.className = 'badge b-emerald'; b2.textContent = CAT_NAME[s.category] || s.category;\n          const b3 = document.createElement('span'); b3.className = 'badge b-amber'; b3.textContent = `${'★'.repeat(s.rating)}`;\n          badges.append(b1, b2, b3);\n          top.append(title, badges);\n\n          const meta = document.createElement('div'); meta.className = 'mono'; meta.style.cssText = 'font-size:11.5px;color:var(--fg-muted)';\n          meta.textContent = `${s.date} ${String(s.hour).padStart(2, '0')}:00 · 入 ${fmtTok(s.input_tokens)} / 出 ${fmtTok(s.output_tokens)} / 缓存 ${fmtTok(s.cached_tokens)} · $${s.cost_usd.toFixed(3)} · ${s.turns}轮 / ${s.minutes}分钟`;\n\n          const sum = document.createElement('div'); sum.style.fontSize = '12.5px'; sum.textContent = s.summary || '（无摘要）';\n          const foot = document.createElement('div'); foot.className = 'between';\n          const tag = document.createElement('span'); tag.style.cssText = 'font-size:11.5px;color:var(--fg-muted)'; tag.textContent = s.tags ? `# ${s.tags}` : '';\n          const acts = document.createElement('div'); acts.className = 'row';\n          const edit = document.createElement('button'); edit.type = 'button'; edit.textContent = '编辑';\n          edit.addEventListener('click', () => fillForm(s));\n          const del = document.createElement('button'); del.type = 'button'; del.className = 'danger'; del.textContent = '删除';\n          del.addEventListener('click', () => deleteSession(s.id));\n          acts.append(edit, del);\n          foot.append(tag, acts);\n          card.append(top, meta, sum, foot);\n          box.appendChild(card);\n        }\n      }\n\n      function renderModelTable() {\n        const tb = $('model-tbody'); tb.replaceChildren();\n        for (const m of state.models) {\n          const perSess = m.sessions ? m.cost_usd / m.sessions : 0;\n          const perM = m.tokens ? (m.cost_usd / m.tokens) * 1_000_000 : 0;\n          const tr = document.createElement('tr');\n          for (const [val, cls] of [\n            [m.model, ''], [String(m.sessions), 'mono'], [fmtTok(m.tokens), 'mono'], [`${m.cache_pct}%`, 'mono'],\n            [`$${m.cost_usd.toFixed(2)}`, 'mono'], [`$${perSess.toFixed(3)}`, 'mono'], [`$${perM.toFixed(2)}`, 'mono'], [`${m.avg_rating} ★`, 'mono'],\n          ]) {\n            const td = document.createElement('td'); if (cls) td.className = cls; td.textContent = val; tr.appendChild(td);\n          }\n          tb.appendChild(tr);\n        }\n      }\n\n      function fillForm(s) {\n        editingId = s?.id ?? null;\n        $('form-caption').textContent = s ? `编辑会话 · ${s.date}` : '录入新会话用量';\n        $('s-title').value = s?.title ?? '';\n        $('s-date').value = s?.date ?? today();\n        $('s-hour').value = String(s?.hour ?? new Date().getHours());\n        $('s-cat').value = s?.category ?? 'coding';\n        $('s-model').value = s?.model ?? 'Gemini 2.5 Pro';\n        $('s-cost').value = s ? String(s.cost_usd) : '';\n        $('s-rating').value = String(s?.rating ?? 5);\n        $('s-in').value = String(s?.input_tokens ?? 80000);\n        $('s-out').value = String(s?.output_tokens ?? 20000);\n        $('s-cache').value = String(s?.cached_tokens ?? 40000);\n        $('s-turns').value = String(s?.turns ?? 12);\n        $('s-mins').value = String(s?.minutes ?? 25);\n        $('s-tags').value = s?.tags ?? '';\n        $('s-summary').value = s?.summary ?? '';\n      }\n\n      async function load() {\n        if (typeof plugin?.action !== 'function') { setStatus('请在 Velai Desktop 中打开个人会话与用量统计大屏。', 'error'); return; }\n        try {\n          state = await plugin.action('usage.dashboard', { range: currentRange });\n          renderKpis();\n          renderDailyChart();\n          renderHourChart();\n          renderModelDonut();\n          renderCatBars();\n          renderSessions();\n          renderModelTable();\n          setStatus(`统计大屏已同步 · 时间窗 ${currentRange} · 共 ${state.kpis.session_count} 条会话`);\n        } catch (e) { setStatus(`读取失败：${e?.message}`, 'error'); }\n      }\n\n      async function deleteSession(id) {\n        if (busy) return; busy = true;\n        try {\n          const r = await plugin.action('usage.session.delete', { expected_revision: state.revision, id });\n          if (r.status === 'deleted') { await load(); setStatus('会话记录已删除。', 'ok'); }\n          else setStatus(`删除未完成：${r.status}`, 'error');\n        } catch (e) { setStatus(`删除失败：${e?.message}`, 'error'); }\n        finally { busy = false; }\n      }\n\n      function extractJsonArray(text) {\n        const fenced = text.match(/```(?:json)?\\s*([\\s\\S]*?)```/i);\n        const raw = fenced ? fenced[1].trim() : text.trim();\n        const start = raw.indexOf('['), end = raw.lastIndexOf(']');\n        if (start === -1 || end === -1 || end <= start) return null;\n        try {\n          const parsed = JSON.parse(raw.slice(start, end + 1));\n          return Array.isArray(parsed) ? parsed : null;\n        } catch { return null; }\n      }\n\n      async function dispatchAi(kind) {\n        aiTaskKind = kind;\n        let prompt;\n        if (kind === 'collect') {\n          prompt = '请整理我近期最有代表性的 3 到 8 个会话及大致使用情况，仅输出一个合法的 JSON 数组（可用 ```json 包裹），每项包含字段：date(YYYY-MM-DD), hour(0-23), title, category(coding/writing/research/planning/ops/chat), model, input_tokens, output_tokens, cached_tokens, turns, minutes, rating(1-5), summary, tags。';\n        } else {\n          const k = state.kpis;\n          const topModels = state.models.slice(0, 4).map(m => `${m.model}:${m.share_pct}%($${m.cost_usd})`).join(', ');\n          const topCats = state.categories.slice(0, 4).map(c => `${CAT_NAME[c.category]}:${c.sessions}次/${c.avg_rating}★`).join(', ');\n          prompt = `请基于我近期个人 AI 使用统计数据，输出一份精炼、有洞察的中文个人复盘报告（包含：1. 效率亮点；2. 模型成本与缓存优化建议；3. 下周工作流改进建议）：\\n区间=${state.range}，会话数=${k.session_count}，总Token=${k.total_tokens}，缓存命中=${k.cache_hit_pct}%，费用=$${k.total_cost_usd}，预算占用=${state.budget.cost_used_pct}%，高峰时段=${k.peak_hour}:00。\\n模型分布：${topModels}\\n场景分布：${topCats}`;\n        }\n        workId = uuid();\n        latestAiText = '';\n        switchView('sync');\n        $('btn-ai-check').hidden = false;\n        $('ai-preview').hidden = true;\n        $('ai-actions').hidden = true;\n        $('ai-status').textContent = kind === 'collect' ? '已向当前会话派发整理指令，请等待回复…' : '正在请当前会话生成个人效率复盘…';\n        try {\n          await plugin.action('session.turn.request', { prompt: prompt.slice(0, 2000), work_id: workId });\n          $('ai-status').textContent = '已派发给当前会话，待回复完成后点击「2. 核对助手回复」。';\n        } catch (e) {\n          $('ai-status').textContent = e?.message === 'cancelled' ? '请先在宿主中选择目标会话再发送。' : `派发未确认（${e?.message || 'unknown'}）`;\n        }\n      }\n\n      document.querySelectorAll('.nav button').forEach(b => b.addEventListener('click', () => switchView(b.dataset.view)));\n      document.querySelectorAll('.range-pills button').forEach(b => b.addEventListener('click', () => {\n        currentRange = b.dataset.range;\n        document.querySelectorAll('.range-pills button').forEach(x => x.classList.toggle('active', x === b));\n        void load();\n      }));\n      $('btn-theme').addEventListener('click', () => {\n        document.documentElement.dataset.theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';\n      });\n      $('btn-refresh').addEventListener('click', load);\n      $('f-cat-filter').addEventListener('change', renderSessions);\n      $('f-search').addEventListener('input', renderSessions);\n      $('btn-new-sess').addEventListener('click', () => { fillForm(null); $('s-title').focus(); });\n      $('btn-quick-sync').addEventListener('click', () => dispatchAi('collect'));\n      $('btn-ai-collect').addEventListener('click', () => dispatchAi('collect'));\n      $('btn-ai-review').addEventListener('click', () => dispatchAi('review'));\n\n      $('btn-demo').addEventListener('click', async () => {\n        if (busy) return; busy = true;\n        setStatus('正在装配 30 天全景个人用量演示数据…');\n        try {\n          const r = await plugin.action('usage.seed_demo', { expected_revision: state?.revision ?? 0 });\n          if (r.status === 'seeded') { await load(); setStatus('已加载 18 条跨模型/跨场景会话与 30 天用量大屏！', 'ok'); }\n          else setStatus(`冲突：${r.status}`, 'error');\n        } catch (e) { setStatus(`加载失败：${e?.message}`, 'error'); }\n        finally { busy = false; }\n      });\n\n      $('btn-save-sess').addEventListener('click', async () => {\n        if (busy) return;\n        const title = $('s-title').value.trim(), model = $('s-model').value.trim();\n        if (!title || !model) { setStatus('请填写会话标题与模型名称。', 'error'); return; }\n        busy = true;\n        try {\n          const inTok = Math.max(0, Number($('s-in').value) || 0);\n          const outTok = Math.max(0, Number($('s-out').value) || 0);\n          const cachedTok = Math.min(inTok, Math.max(0, Number($('s-cache').value) || 0));\n          const costVal = $('s-cost').value.trim();\n          const r = await plugin.action('usage.session.save', {\n            expected_revision: state.revision,\n            id: editingId || `s-${Date.now().toString(36)}`,\n            date: $('s-date').value || today(),\n            hour: Math.min(23, Math.max(0, Number($('s-hour').value) || 14)),\n            title, category: $('s-cat').value, model,\n            input_tokens: inTok, output_tokens: outTok, cached_tokens: cachedTok,\n            cost_usd: costVal === '' ? Math.round(((inTok * 1.5 + outTok * 6) / 1_000_000) * 1000) / 1000 : Math.max(0, Number(costVal)),\n            turns: Math.max(1, Number($('s-turns').value) || 6),\n            minutes: Math.max(1, Number($('s-mins').value) || 10),\n            rating: Math.min(5, Math.max(1, Number($('s-rating').value) || 4)),\n            summary: $('s-summary').value.trim(),\n            tags: $('s-tags').value.trim(),\n          });\n          if (r.status === 'saved') { fillForm(null); await load(); setStatus('会话用量记录已保存。', 'ok'); }\n          else setStatus(`保存未完成：${r.status}`, 'error');\n        } catch (e) { setStatus(`保存失败：${e?.message}`, 'error'); }\n        finally { busy = false; }\n      });\n\n      $('btn-save-cfg').addEventListener('click', async () => {\n        if (busy) return; busy = true;\n        try {\n          const r = await plugin.action('usage.config.save', {\n            expected_revision: state.revision,\n            monthly_cost_usd: Math.max(1, Number($('cfg-cost').value) || 45),\n            monthly_tokens_m: Math.max(0.1, Number($('cfg-tok').value) || 12),\n          });\n          if (r.status === 'saved') { await load(); setStatus('预算阈值已保存。', 'ok'); }\n          else setStatus(`保存未完成：${r.status}`, 'error');\n        } catch (e) { setStatus(`保存失败：${e?.message}`, 'error'); }\n        finally { busy = false; }\n      });\n\n      $('btn-ai-check').addEventListener('click', async () => {\n        if (!workId) return;\n        $('ai-status').textContent = '正在核对会话结果…';\n        try {\n          const r = await plugin.action('session.turn.result', { work_id: workId });\n          if (r.state === 'completed' && !r.truncated && typeof r.text === 'string' && r.text.trim()) {\n            latestAiText = r.text.trim();\n            $('ai-preview').textContent = latestAiText;\n            $('ai-preview').hidden = false;\n            $('ai-actions').hidden = false;\n            const arr = extractJsonArray(latestAiText);\n            $('btn-ai-ingest').hidden = !arr;\n            $('btn-ai-save-rev').hidden = aiTaskKind !== 'review';\n            $('btn-ai-insert').hidden = !canInsert;\n            $('ai-status').textContent = arr ? `已识别 ${arr.length} 条结构化会话记录，可点击一键导入大屏！` : '已收到完整回复：';\n          } else {\n            $('ai-status').textContent = `当前状态：${r.state}`;\n          }\n        } catch (e) { $('ai-status').textContent = `核对失败：${e?.message}`; }\n      });\n\n      $('btn-ai-ingest').addEventListener('click', async () => {\n        const items = extractJsonArray(latestAiText);\n        if (!items || !items.length || busy) return;\n        busy = true;\n        try {\n          const r = await plugin.action('usage.session.batch_ingest', { expected_revision: state.revision, items });\n          if (r.status === 'saved') { await load(); switchView('dashboard'); setStatus(`已成功导入 ${r.ingested} 条会话并刷新统计大屏！`, 'ok'); }\n          else setStatus(`导入未完成：${r.status}`, 'error');\n        } catch (e) { setStatus(`导入失败：${e?.message}`, 'error'); }\n        finally { busy = false; }\n      });\n\n      $('btn-ai-save-rev').addEventListener('click', async () => {\n        if (!latestAiText || busy) return; busy = true;\n        try {\n          const r = await plugin.action('usage.config.save', {\n            expected_revision: state.revision,\n            monthly_cost_usd: state.budget.monthly_cost_usd,\n            monthly_tokens_m: state.budget.monthly_tokens_m,\n            latest_review: latestAiText.slice(0, 1600),\n          });\n          if (r.status === 'saved') { await load(); setStatus('个人复盘报告已归档。', 'ok'); }\n        } catch (e) { setStatus(`保存失败：${e?.message}`, 'error'); }\n        finally { busy = false; }\n      });\n\n      $('btn-ai-insert').addEventListener('click', async () => {\n        if (!latestAiText) return;\n        try {\n          const r = await plugin.action('host.draft.insert', { text: latestAiText });\n          setStatus(r?.inserted ? '已插入当前会话输入框。' : '插入未确认。', r?.inserted ? 'ok' : 'error');\n        } catch (e) { setStatus(`插入失败：${e?.message}`, 'error'); }\n      });\n\n      $('btn-from-sel').addEventListener('click', async () => {\n        try {\n          const r = await plugin.action('host.selection.read', {});\n          if (typeof r?.text === 'string' && r.text.trim()) {\n            $('s-summary').value = r.text.trim().slice(0, 260);\n            if (!$('s-title').value.trim()) $('s-title').value = r.text.trim().split('\\n')[0].slice(0, 50);\n            setStatus('已读入当前选中回复至摘要栏。', 'ok');\n          }\n        } catch { setStatus('无法读取选中回复，请先在聊天中点选消息。', 'error'); }\n      });\n\n      fillForm(null);\n      if (typeof plugin?.action === 'function') {\n        plugin.action('host.capabilities', {}).then(c => {\n          const acts = Array.isArray(c?.actions) ? c.actions : [];\n          canReadSel = acts.includes('host.selection.read');\n          canInsert = acts.includes('host.draft.insert');\n          $('btn-from-sel').hidden = !canReadSel;\n        }).catch(() => {});\n      }\n      void load();\n    })();\n  </script>\n</body>\n</html>\n","path":"ui/index.html"}],"format":"nmas-plugin","manifest":{"actions":[{"id":"usage.dashboard","input_schema":{"additionalProperties":false,"properties":{"range":{"enum":["7d","30d","all"],"type":"string"}},"required":[],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"budget":{"additionalProperties":false,"properties":{"alert_level":{"enum":["ok","warn","critical"],"type":"string"},"cost_used_pct":{"minimum":0,"type":"number"},"monthly_cost_usd":{"maximum":100000,"minimum":1,"type":"number"},"monthly_tokens_m":{"maximum":10000,"minimum":0.1,"type":"number"},"token_used_pct":{"minimum":0,"type":"number"}},"required":["monthly_cost_usd","monthly_tokens_m","cost_used_pct","token_used_pct","alert_level"],"type":"object"},"categories":{"items":{"additionalProperties":false,"properties":{"avg_rating":{"maximum":5,"minimum":0,"type":"number"},"category":{"enum":["coding","writing","research","planning","ops","chat"],"type":"string"},"cost_usd":{"minimum":0,"type":"number"},"sessions":{"minimum":0,"type":"integer"},"share_pct":{"maximum":100,"minimum":0,"type":"number"},"tokens":{"minimum":0,"type":"integer"}},"required":["category","sessions","tokens","cost_usd","avg_rating","share_pct"],"type":"object"},"type":"array"},"daily":{"items":{"additionalPropert