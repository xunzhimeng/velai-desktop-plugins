{"files":[{"content":"const MAX_RECORD_BYTES = 240 * 1024;\nconst NOTE_PREFIX = 'note:';\nconst WINDOW_KEYS = ['5m', '1h', 'today', '7d', '30d'];\n\nconst DEFAULT_BUDGET = {\n  schema_version: 1,\n  monthly_tokens_m: 15,\n  warn_pct: 70,\n  critical_pct: 90,\n  alert_note: '',\n};\n\nconst r2 = n => Math.round(n * 100) / 100;\nconst r4 = n => Math.round(n * 10000) / 10000;\n\nfunction jsonBytes(v) {\n  let b = 0;\n  for (const ch of JSON.stringify(v)) {\n    const cp = ch.codePointAt(0);\n    b += cp <= 0x7f ? 1 : cp <= 0x7ff ? 2 : cp <= 0xffff ? 3 : 4;\n  }\n  return b;\n}\n\nfunction nullableInt(v) {\n  if (v === null || v === undefined) return null;\n  return typeof v === 'number' && Number.isSafeInteger(v) && v >= 0 ? v : null;\n}\n\nfunction nullableNum(v, max = Infinity) {\n  if (v === null || v === undefined) return null;\n  if (typeof v !== 'number' || !Number.isFinite(v) || v < 0) return null;\n  const clamped = v > max ? max : v;\n  return r4(clamped);\n}\n\nfunction nullableStr(v, maxLen) {\n  if (v === null || v === undefined) return null;\n  if (typeof v !== 'string') return null;\n  return v.slice(0, maxLen);\n}\n\nfunction normalizeWindow(raw) {\n  if (!raw || typeof raw !== 'object') {\n    return {\n      input_tokens: null,\n      output_tokens: null,\n      total_tokens: null,\n      cached_input_tokens: null,\n      cache_rate: null,\n      tokens_per_second: null,\n    };\n  }\n  return {\n    input_tokens: nullableInt(raw.input_tokens),\n    output_tokens: nullableInt(raw.output_tokens),\n    total_tokens: nullableInt(raw.total_tokens),\n    cached_input_tokens: nullableInt(raw.cached_input_tokens),\n    cache_rate: nullableNum(raw.cache_rate, 100),\n    tokens_per_second: nullableNum(raw.tokens_per_second),\n  };\n}\n\nfunction normalizeUsage(raw) {\n  const src = raw && typeof raw === 'object' ? raw : {};\n  const rawWindows = src.windows && typeof src.windows === 'object' ? src.windows : {};\n  const windows = {};\n  for (const k of WINDOW_KEYS) {\n    windows[k] = normalizeWindow(rawWindows[k]);\n  }\n\n  const by_day = Array.isArray(src.by_day)\n    ? src.by_day\n        .filter(d => d && typeof d === 'object' && typeof d.date === 'string' && d.date.length > 0)\n        .map(d => ({\n          date: d.date.slice(0, 32),\n          input_tokens: nullableInt(d.input_tokens),\n          output_tokens: nullableInt(d.output_tokens),\n          total_tokens: nullableInt(d.total_tokens),\n        }))\n    : [];\n\n  const rawModels = Array.isArray(src.by_model)\n    ? src.by_model\n        .filter(m => m && typeof m === 'object' && typeof m.model === 'string' && m.model.trim().length > 0)\n        .map(m => ({\n          model: m.model.trim().slice(0, 128),\n          input_tokens: nullableInt(m.input_tokens),\n          output_tokens: nullableInt(m.output_tokens),\n          total_tokens: nullableInt(m.total_tokens),\n        }))\n    : [];\n\n  let knownModelSum = 0;\n  for (const m of rawModels) {\n    if (m.total_tokens !== null) knownModelSum += m.total_tokens;\n  }\n\n  const by_model = rawModels\n    .map(m => ({\n      ...m,\n      share_pct: m.total_tokens !== null && knownModelSum > 0 ? r2((m.total_tokens / knownModelSum) * 100) : null,\n    }))\n    .sort((a, b) => {\n      if (a.total_tokens === null && b.total_tokens === null) return a.model.localeCompare(b.model);\n      if (a.total_tokens === null) return 1;\n      if (b.total_tokens === null) return -1;\n      return b.total_tokens - a.total_tokens;\n    });\n\n  return {\n    as_of: typeof src.as_of === 'string' && src.as_of ? src.as_of.slice(0, 64) : new Date().toISOString(),\n    timezone: typeof src.timezone === 'string' && src.timezone ? src.timezone.slice(0, 64) : 'UTC',\n    models_truncated: Boolean(src.models_truncated),\n    windows,\n    by_day,\n    by_model,\n  };\n}\n\nfunction normalizeSession(raw) {\n  if (!raw || typeof raw !== 'object' || typeof raw.id !== 'string' || !raw.id) return null;\n  return {\n    id: raw.id.slice(0, 128),\n    title: nullableStr(raw.title, 200),\n    status: nullableStr(raw.status, 64),\n    created_at: nullableStr(raw.created_at, 64),\n    is_archived: Boolean(raw.is_archived),\n  };\n}\n\nfunction normalizeSessionsPage(raw) {\n  const src = raw && typeof raw === 'object' ? raw : {};\n  const items = Array.isArray(src.items) ? src.items.map(normalizeSession).filter(Boolean) : [];\n  return {\n    items,\n    next_offset: nullableInt(src.next_offset),\n  };\n}\n\nfunction normalizeProject(raw) {\n  if (!raw || typeof raw !== 'object' || typeof raw.id !== 'string' || !raw.id) return null;\n  return {\n    id: raw.id.slice(0, 128),\n    name: nullableStr(raw.name, 200),\n    status: nullableStr(raw.status, 64),\n  };\n}\n\nfunction normalizeProjectsPage(raw) {\n  const src = raw && typeof raw === 'object' ? raw : {};\n  const items = Array.isArray(src.items) ? src.items.map(normalizeProject).filter(Boolean) : [];\n  return {\n    items,\n    next_offset: nullableInt(src.next_offset),\n  };\n}\n\nfunction normalizeBudgetConfig(raw) {\n  const src = raw && typeof raw === 'object' ? raw : {};\n  const monthly_tokens_m =\n    typeof src.monthly_tokens_m === 'number' && Number.isFinite(src.monthly_tokens_m) && src.monthly_tokens_m >= 0.1\n      ? r2(Math.min(10000, src.monthly_tokens_m))\n      : DEFAULT_BUDGET.monthly_tokens_m;\n  const warn_pct =\n    Number.isInteger(src.warn_pct) && src.warn_pct >= 1 && src.warn_pct <= 99\n      ? src.warn_pct\n      : DEFAULT_BUDGET.warn_pct;\n  const rawCritical =\n    Number.isInteger(src.critical_pct) && src.critical_pct >= 2 && src.critical_pct <= 100\n      ? src.critical_pct\n      : DEFAULT_BUDGET.critical_pct;\n  const critical_pct = rawCritical > warn_pct ? rawCritical : Math.min(100, warn_pct + 1);\n  const alert_note = typeof src.alert_note === 'string' ? src.alert_note.trim().slice(0, 400) : '';\n  return {\n    schema_version: 1,\n    monthly_tokens_m,\n    warn_pct,\n    critical_pct,\n    alert_note,\n  };\n}\n\nfunction computeBudgetStatus(config, usage30dWindow) {\n  const used_tokens_30d = usage30dWindow ? usage30dWindow.total_tokens : null;\n  if (used_tokens_30d === null) {\n    return {\n      monthly_tokens_m: config.monthly_tokens_m,\n      warn_pct: config.warn_pct,\n      critical_pct: config.critical_pct,\n      used_tokens_30d: null,\n      token_used_pct: null,\n      alert_level: 'unknown',\n      alert_note: config.alert_note,\n    };\n  }\n  const quotaTokens = Math.max(1, config.monthly_tokens_m * 1_000_000);\n  const token_used_pct = r2((used_tokens_30d / quotaTokens) * 100);\n  const alert_level =\n    token_used_pct >= config.critical_pct\n      ? 'critical'\n      : token_used_pct >= config.warn_pct\n        ? 'warn'\n        : 'ok';\n  return {\n    monthly_tokens_m: config.monthly_tokens_m,\n    warn_pct: config.warn_pct,\n    critical_pct: config.critical_pct,\n    used_tokens_30d,\n    token_used_pct,\n    alert_level,\n    alert_note: config.alert_note,\n  };\n}\n\nasync function readKey(collection, key, fallback) {\n  const res = await globalThis.nmas.data.read({ collection, key });\n  return { revision: res.revision, value: res.value === null ? fallback : res.value };\n}\n\nasync function writeKey(collection, key, expectedRevision, value) {\n  if (jsonBytes(value) > MAX_RECORD_BYTES) return { status: 'limit', revision: expectedRevision };\n  try {\n    const res = await globalThis.nmas.data.write({\n      collection,\n      key,\n      expected_revision: expectedRevision,\n      value,\n    });\n    return { status: 'saved', revision: res.revision };\n  } catch (e) {\n    if (e?.code === 'conflict' && e.outcome_unknown === false) {\n      return { status: 'conflict', revision: expectedRevision };\n    }\n    throw e;\n  }\n}\n\nasync function listNotesPage({ prefix = NOTE_PREFIX, limit = 20, cursor } = {}) {\n  const safePrefix = typeof prefix === 'string' && prefix.startsWith(NOTE_PREFIX)\n    ? prefix.slice(0, 64)\n    : `${NOTE_PREFIX}${typeof prefix === 'string' ? prefix.slice(0, 48) : ''}`;\n  const req = { collection: 'notes', prefix: safePrefix, limit };\n  if (typeof cursor === 'string' && cursor.length > 0) req.cursor = cursor;\n  const listed = await globalThis.nmas.data.list(req);\n  let latestRevision = listed.revision;\n  const items = [];\n  for (const key of listed.keys || []) {\n    const row = await globalThis.nmas.data.read({ collection: 'notes', key });\n    if (row.revision > latestRevision) latestRevision = row.revision;\n    if (row.value && typeof row.value === 'object') {\n      const v = row.value;\n      items.push({\n        key,\n        id: typeof v.id === 'string' && v.id ? v.id.slice(0, 64) : key.slice(NOTE_PREFIX.length),\n        title: typeof v.title === 'string' && v.title ? v.title.slice(0, 100) : '未命名复盘',\n        range_days: v.range_days === 7 ? 7 : 30,\n        tags: typeof v.tags === 'string' ? v.tags.slice(0, 120) : '',\n        body: typeof v.body === 'string' ? v.body.slice(0, 4000) : '',\n        updated_at: typeof v.updated_at === 'string' ? v.updated_at.slice(0, 64) : '',\n      });\n    }\n  }\n  items.sort((a, b) => (b.updated_at || '').localeCompare(a.updated_at || ''));\n  return {\n    revision: latestRevision,\n    items,\n    next_cursor: typeof listed.next_cursor === 'string' ? listed.next_cursor : null,\n  };\n}\n\nexport default async function (request) {\n  const { kind, contribution, input } = request ?? {};\n  const args = input && typeof input === 'object' ? input : {};\n\n  if (kind === 'action') {\n    if (contribution === 'usage.dashboard') {\n      const days = args.days === 7 ? 7 : 30;\n      const rawUsage = await globalThis.nmas.host.usageSummary({ days });\n      const usage = normalizeUsage(rawUsage);\n\n      const sessReq = { offset: 0, limit: 20 };\n      if (typeof args.include_archived === 'boolean') {\n        sessReq.is_archived = args.include_archived;\n      }\n      const rawSessions = await globalThis.nmas.host.listSessions(sessReq);\n      const sessions = normalizeSessionsPage(rawSessions);\n\n      const rawProjects = await globalThis.nmas.host.listProjects({ offset: 0, limit: 20 });\n      const projects = normalizeProjectsPage(rawProjects);\n\n      const budgetRes = await readKey('goals', 'budget', DEFAULT_BUDGET);\n      const budgetConfig = normalizeBudgetConfig(budgetRes.value);\n      const budget = computeBudgetStatus(budgetConfig, usage.windows['30d']);\n\n      const notesPage = await listNotesPage({ prefix: NOTE_PREFIX, limit: 20 });\n      const revision = Math.max(budgetRes.revision, notesPage.revision);\n\n      return {\n        revision,\n        days,\n        as_of: usage.as_of,\n        timezone: usage.timezone,\n        models_truncated: usage.models_truncated,\n        windows: usage.windows,\n        by_day: usage.by_day,\n        by_model: usage.by_model,\n        budget,\n        sessions,\n        projects,\n        notes: {\n          items: notesPage.items,\n          next_cursor: notesPage.next_cursor,\n        },\n      };\n    }\n\n    if (contribution === 'usage.host.sessions') {\n      const req = {\n        offset: Number.isInteger(args.offset) ? args.offset : 0,\n        limit: Number.isInteger(args.limit) ? args.limit : 20,\n      };\n      if (typeof args.is_archived === 'boolean') req.is_archived = args.is_archived;\n      const rawSessions = await globalThis.nmas.host.listSessions(req);\n      return normalizeSessionsPage(rawSessions);\n    }\n\n    if (contribution === 'usage.host.session_detail') {\n      try {\n        // 严禁传 includeMessages: true，仅读取会话元数据\n        const raw = await globalThis.nmas.host.getSession({ sessionId: args.session_id });\n        const session = normalizeSession(raw);\n        return { found: Boolean(session), session };\n      } catch (e) {\n        if (e?.code === 'not_found') return { found: false, session: null };\n        throw e;\n      }\n    }\n\n    if (contribution === 'usage.host.projects') {\n      const req = {\n        offset: Number.isInteger(args.offset) ? args.offset : 0,\n        limit: Number.isInteger(args.limit) ? args.limit : 20,\n      };\n      const rawProjects = await globalThis.nmas.host.listProjects(req);\n      return normalizeProjectsPage(rawProjects);\n    }\n\n    if (contribution === 'usage.budget.save') {\n      const cur = await readKey('goals', 'budget', DEFAULT_BUDGET);\n      if (cur.revision !== args.expected_revision) {\n        return { status: 'conflict', revision: cur.revision };\n      }\n      if (args.warn_pct >= args.critical_pct) {\n        return { status: 'invalid_input', revision: cur.revision };\n      }\n      const next = normalizeBudgetConfig({\n        monthly_tokens_m: args.monthly_tokens_m,\n        warn_pct: args.warn_pct,\n        critical_pct: args.critical_pct,\n        alert_note: args.alert_note !== undefined ? args.alert_note : cur.value?.alert_note,\n      });\n      return writeKey('goals', 'budget', args.expected_revision, next);\n    }\n\n    if (contribution === 'usage.note.save') {\n      const title = typeof args.title === 'string' ? args.title.trim().slice(0, 100) : '';\n      const body = typeof args.body === 'string' ? args.body.trim().slice(0, 4000) : '';\n      const rawId = typeof args.id === 'string' && /^[a-zA-Z0-9._-]+$/.test(args.id)\n        ? args.id.slice(0, 64)\n        : `rev-${Date.now().toString(36)}`;\n      const key = `${NOTE_PREFIX}${rawId}`;\n      const existing = await readKey('notes', key, null);\n      if (!title || !body) {\n        return { status: 'invalid_input', revision: existing.revision, key, id: rawId };\n      }\n      if (existing.revision !== args.expected_revision) {\n        return { status: 'conflict', revision: existing.revision, key, id: rawId };\n      }\n      const record = {\n        schema_version: 1,\n        id: rawId,\n        title,\n        range_days: args.range_days === 7 ? 7 : 30,\n        tags: typeof args.tags === 'string' ? args.tags.trim().slice(0, 120) : '',\n        body,\n        updated_at: new Date().toISOString(),\n      };\n      const w = await writeKey('notes', key, args.expected_revision, record);\n      return { status: w.status, revision: w.revision, key, id: rawId };\n    }\n\n    if (contribution === 'usage.note.list') {\n      const limit = Number.isInteger(args.limit) ? args.limit : 20;\n      const prefix = typeof args.prefix === 'string' ? args.prefix : NOTE_PREFIX;\n      return listNotesPage({ prefix, limit, cursor: args.cursor });\n    }\n\n    if (contribution === 'usage.note.delete') {\n      const key = typeof args.key === 'string' ? args.key : '';\n      if (!key.startsWith(NOTE_PREFIX) || key.length <= NOTE_PREFIX.length) {\n        const cur = await readKey('goals', 'budget', DEFAULT_BUDGET);\n        return { status: 'invalid_input', revision: cur.revision };\n      }\n      const existing = await readKey('notes', key, null);\n      if (existing.revision !== args.expected_revision) {\n        return { status: 'conflict', revision: existing.revision };\n      }\n      if (existing.value === null) {\n        return { status: 'not_found', revision: existing.revision };\n      }\n      try {\n        const del = await globalThis.nmas.data.delete({\n          collection: 'notes',\n          key,\n          expected_revision: args.expected_revision,\n        });\n        return { status: 'deleted', revision: del.revision };\n      } catch (e) {\n        if (e?.code === 'conflict' && e.outcome_unknown === false) {\n          return { status: 'conflict', revision: existing.revision };\n        }\n        throw e;\n      }\n    }\n  }\n\n  if (kind === 'tool') {\n    if (contribution === 'usage.get_host_summary') {\n      const days = args.days === 7 ? 7 : 30;\n      const rawUsage = await globalThis.nmas.host.usageSummary({ days });\n      const usage = normalizeUsage(rawUsage);\n      const budgetRes = await readKey('goals', 'budget', DEFAULT_BUDGET);\n      const budgetConfig = normalizeBudgetConfig(budgetRes.value);\n      const budget = computeBudgetStatus(budgetConfig, usage.windows['30d']);\n      const targetWin = days === 7 ? usage.windows['7d'] : usage.windows['30d'];\n      const hasTokens = targetWin.total_tokens !== null;\n\n      return {\n        success: true,\n        status: hasTokens ? 'ready' : 'missing_metrics',\n        days,\n        as_of: usage.as_of,\n        timezone: usage.timezone,\n        window_total_tokens: targetWin.total_tokens,\n        window_input_tokens: targetWin.input_tokens,\n        window_output_tokens: targetWin.output_tokens,\n        window_cached_tokens: targetWin.cached_input_tokens,\n        cache_rate: targetWin.cache_rate,\n        tokens_per_second: targetWin.tokens_per_second,\n        budget_monthly_tokens_m: budget.monthly_tokens_m,\n        token_used_pct: budget.token_used_pct,\n        budget_alert_level: budget.alert_level,\n        top_model: usage.by_model.length ? usage.by_model[0].model : null,\n        models_truncated: usage.models_truncated,\n        by_model_count: usage.by_model.length,\n      };\n    }\n\n    if (contribution === 'usage.list_host_sessions') {\n      const sessReq = {\n        offset: Number.isInteger(args.offset) ? args.offset : 0,\n        limit: Number.isInteger(args.limit) ? args.limit : 20,\n      };\n      if (typeof args.is_archived === 'boolean') sessReq.is_archived = args.is_archived;\n      const sessions = normalizeSessionsPage(await globalThis.nmas.host.listSessions(sessReq));\n\n      let projects = { items: [], next_offset: null };\n      if (args.include_projects !== false) {\n        projects = normalizeProjectsPage(await globalThis.nmas.host.listProjects({ offset: 0, limit: 20 }));\n      }\n      return {\n        success: true,\n        status: sessions.items.length || projects.items.length ? 'ready' : 'empty',\n        sessions: sessions.items,\n        next_offset: sessions.next_offset,\n        projects: projects.items,\n        projects_next_offset: projects.next_offset,\n      };\n    }\n\n    if (contribution === 'usage.update_budget_alert') {\n      const cur = await readKey('goals', 'budget', DEFAULT_BUDGET);\n      const prev = normalizeBudgetConfig(cur.value);\n      const warn_pct = Number.isInteger(args.warn_pct) ? args.warn_pct : prev.warn_pct;\n      const critical_pct = Number.isInteger(args.critical_pct) ? args.critical_pct : prev.critical_pct;\n      if (warn_pct >= critical_pct) {\n        return {\n          success: false,\n          status: 'invalid_input',\n          revision: cur.revision,\n          monthly_tokens_m: prev.monthly_tokens_m,\n          warn_pct: prev.warn_pct,\n          critical_pct: prev.critical_pct,\n          alert_note: prev.alert_note,\n        };\n      }\n      const next = normalizeBudgetConfig({\n        monthly_tokens_m: args.monthly_tokens_m,\n        warn_pct,\n        critical_pct,\n        alert_note: args.alert_note !== undefined ? args.alert_note : prev.alert_note,\n      });\n      const w = await writeKey('goals', 'budget', cur.revision, next);\n      return {\n        success: w.status === 'saved',\n        status: w.status,\n        revision: w.revision,\n        monthly_tokens_m: next.monthly_tokens_m,\n        warn_pct: next.warn_pct,\n        critical_pct: next.critical_pct,\n        alert_note: next.alert_note,\n      };\n    }\n  }\n\n  throw new Error(`不支持的调用: ${kind}/${contribution}`);\n}\n","path":"backend/index.js"},{"content":"<!doctype html>\n<html lang=\"zh-CN\" data-theme=\"dark\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>个人会话与用量统计大屏 V2</title>\n  <style>\n    :root {\n      --bg: #060a12;\n      --bg-elev: #0b111d;\n      --bg-card: #101827;\n      --bg-input: #080d17;\n      --fg: #eaf1fc;\n      --fg-muted: #7c8da8;\n      --border: rgba(148, 163, 184, 0.16);\n      --border-strong: rgba(56, 189, 248, 0.36);\n      --cyan: #38bdf8;\n      --cyan-soft: rgba(56, 189, 248, 0.14);\n      --emerald: #34d399;\n      --emerald-soft: rgba(52, 211, 153, 0.14);\n      --amber: #f59e0b;\n      --amber-soft: rgba(245, 158, 11, 0.14);\n      --violet: #a78bfa;\n      --violet-soft: rgba(167, 139, 250, 0.14);\n      --rose: #fb7185;\n      --rose-soft: rgba(251, 113, 133, 0.14);\n      --shadow: 0 12px 30px rgba(0, 0, 0, 0.34);\n      font: 13px/1.55 -apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"PingFang SC\", system-ui, sans-serif;\n    }\n    html[data-theme=\"light\"] {\n      --bg: #f1f5f9;\n      --bg-elev: #ffffff;\n      --bg-card: #ffffff;\n      --bg-input: #f8fafc;\n      --fg: #0f172a;\n      --fg-muted: #64748b;\n      --border: rgba(15, 23, 42, 0.11);\n      --border-strong: rgba(2, 132, 199, 0.38);\n      --cyan: #0284c7;\n      --cyan-soft: rgba(2, 132, 199, 0.1);\n      --emerald: #059669;\n      --emerald-soft: rgba(5, 150, 105, 0.1);\n      --amber: #d97706;\n      --amber-soft: rgba(217, 119, 6, 0.1);\n      --violet: #7c3aed;\n      --violet-soft: rgba(124, 58, 237, 0.1);\n      --rose: #e11d48;\n      --rose-soft: rgba(225, 29, 72, 0.1);\n      --shadow: 0 8px 22px rgba(15, 23, 42, 0.06);\n    }\n    * { box-sizing: border-box; }\n    body { margin: 0; background: var(--bg); color: var(--fg); min-height: 100vh; }\n    .mono { font-family: ui-monospace, \"SF Mono\", Menlo, Consolas, monospace; font-variant-numeric: tabular-nums; }\n    .app { display: grid; grid-template-columns: 218px minmax(0, 1fr); min-height: 100vh; }\n    @media (max-width: 860px) { .app { grid-template-columns: 1fr; } .sidebar { border-right: 0; border-bottom: 1px solid var(--border); } }\n\n    .sidebar { background: var(--bg-elev); border-right: 1px solid var(--border); padding: 15px 12px; display: flex; flex-direction: column; gap: 12px; }\n    .brand { padding: 4px 8px; }\n    .brand-tag { font-size: 10px; letter-spacing: 0.14em; color: var(--cyan); font-weight: 700; }\n    .brand h1 { margin: 3px 0 2px; font-size: 15.5px; font-weight: 700; }\n    .brand span { font-size: 11.5px; color: var(--fg-muted); }\n\n    .budget-mini { background: var(--bg-card); border: 1px solid var(--border); border-radius: 10px; padding: 10px; display: flex; flex-direction: column; gap: 6px; }\n    .bar { height: 6px; border-radius: 99px; background: var(--border); overflow: hidden; }\n    .bar > i { display: block; height: 100%; border-radius: 99px; transition: width .25s ease; }\n\n    .nav { display: flex; flex-direction: column; gap: 4px; }\n    .nav button { text-align: left; border: 1px solid transparent; background: transparent; color: var(--fg-muted); padding: 9px 10px; border-radius: 8px; cursor: pointer; font: inherit; font-weight: 500; display: flex; justify-content: space-between; align-items: center; }\n    .nav button:hover { background: var(--bg-card); color: var(--fg); }\n    .nav button.active { background: var(--cyan-soft); color: var(--cyan); border-color: var(--border-strong); font-weight: 600; }\n    .sidebar-foot { margin-top: auto; display: flex; flex-direction: column; gap: 6px; }\n\n    .main { display: flex; flex-direction: column; min-width: 0; }\n    .topbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; padding: 10px 16px; border-bottom: 1px solid var(--border); background: var(--bg-elev); }\n    .range-pills { display: flex; gap: 4px; background: var(--bg-input); padding: 3px; border-radius: 9px; border: 1px solid var(--border); }\n    .range-pills button { border: 0; background: transparent; color: var(--fg-muted); padding: 4px 12px; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer; }\n    .range-pills button.active { background: var(--cyan); color: #05111e; }\n    html[data-theme=\"light\"] .range-pills button.active { color: #fff; }\n\n    .content { padding: 14px 16px; display: flex; flex-direction: column; gap: 12px; min-width: 0; }\n    .status-bar { font-size: 12px; color: var(--fg-muted); padding: 7px 12px; border-radius: 8px; background: var(--bg-card); border: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; }\n    .status-bar[data-kind=\"error\"] { color: var(--rose); border-color: rgba(251, 113, 133, 0.45); }\n    .status-bar[data-kind=\"ok\"] { color: var(--emerald); border-color: rgba(52, 211, 153, 0.45); }\n\n    .kpi-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; }\n    @media (max-width: 1100px) { .kpi-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }\n    @media (max-width: 640px) { .kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n    .kpi-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 11px; padding: 12px; box-shadow: var(--shadow); display: flex; flex-direction: column; gap: 4px; position: relative; overflow: hidden; }\n    .kpi-card::before { content: \"\"; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, var(--c1, var(--cyan)), transparent); }\n    .kpi-label { font-size: 11.5px; color: var(--fg-muted); display: flex; justify-content: space-between; align-items: center; }\n    .kpi-val { font-size: 19px; font-weight: 800; letter-spacing: -0.02em; }\n    .kpi-sub { font-size: 11.5px; color: var(--fg-muted); }\n\n    .dash-2 { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr); gap: 12px; align-items: stretch; }\n    .split-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; align-items: start; }\n    @media (max-width: 900px) { .dash-2, .split-2 { grid-template-columns: 1fr; } }\n\n    .card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 13px; box-shadow: var(--shadow); display: flex; flex-direction: column; gap: 10px; min-width: 0; }\n    .card h3 { margin: 0; font-size: 13.5px; font-weight: 700; }\n    .svg-box { background: var(--bg-input); border: 1px solid var(--border); border-radius: 9px; overflow: hidden; }\n    svg { display: block; width: 100%; height: auto; }\n\n    button, input, select, textarea { font: inherit; color: var(--fg); background: var(--bg-input); border: 1px solid var(--border); border-radius: 7px; padding: 6px 10px; }\n    button { cursor: pointer; background: var(--bg-card); }\n    button:disabled { opacity: 0.45; cursor: not-allowed; }\n    button.primary { background: var(--cyan); border-color: var(--cyan); color: #05111e; font-weight: 600; }\n    html[data-theme=\"light\"] button.primary { color: #fff; }\n    button.danger { color: var(--rose); border-color: rgba(251, 113, 133, 0.35); }\n    .row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }\n    .between { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: space-between; }\n\n    .item-card { border: 1px solid var(--border); border-radius: 10px; padding: 11px; background: var(--bg-input); display: flex; flex-direction: column; gap: 6px; }\n    .item-card.clickable { cursor: pointer; transition: border-color .15s ease; }\n    .item-card.clickable:hover { border-color: var(--border-strong); }\n    .badge { display: inline-flex; align-items: center; font-size: 11px; padding: 2px 8px; border-radius: 99px; border: 1px solid var(--border); font-weight: 600; }\n    .b-cyan { color: var(--cyan); border-color: var(--border-strong); background: var(--cyan-soft); }\n    .b-emerald { color: var(--emerald); border-color: rgba(52, 211, 153, 0.45); background: var(--emerald-soft); }\n    .b-amber { color: var(--amber); border-color: rgba(245, 158, 11, 0.45); background: var(--amber-soft); }\n    .b-violet { color: var(--violet); border-color: rgba(167, 139, 250, 0.45); background: var(--violet-soft); }\n    .b-rose { color: var(--rose); border-color: rgba(251, 113, 133, 0.45); background: var(--rose-soft); }\n\n    table { width: 100%; border-collapse: collapse; font-size: 12.5px; }\n    th, td { text-align: left; padding: 8px; border-bottom: 1px solid var(--border); }\n    th { font-size: 11px; color: var(--fg-muted); text-transform: uppercase; letter-spacing: 0.04em; }\n    label.field { display: flex; flex-direction: column; gap: 4px; font-size: 11.5px; color: var(--fg-muted); font-weight: 600; }\n    textarea { width: 100%; min-height: 92px; resize: vertical; }\n    .detail-box { border: 1px solid var(--border); border-radius: 10px; padding: 12px; background: var(--bg-input); display: flex; flex-direction: column; gap: 8px; }\n    .kv { display: flex; justify-content: space-between; gap: 10px; font-size: 12.5px; border-bottom: 1px dashed var(--border); padding-bottom: 5px; }\n    .kv:last-child { border-bottom: 0; padding-bottom: 0; }\n    [hidden] { display: none !important; }\n  </style>\n</head>\n<body>\n  <div class=\"app\">\n    <aside class=\"sidebar\">\n      <div class=\"brand\">\n        <div class=\"brand-tag\">HOST TELEMETRY V2</div>\n        <h1>个人会话与用量大屏</h1>\n        <span>宿主实时遥测 · 会话 · 项目 · 预算</span>\n      </div>\n\n      <div class=\"budget-mini\">\n        <div class=\"between\" style=\"font-size:11.5px\">\n          <span>30 天 Token 预算</span>\n          <strong id=\"sb-tok-pct\" class=\"mono\">缺测</strong>\n        </div>\n        <div class=\"bar\"><i id=\"sb-tok-bar\" style=\"width:0%;background:var(--cyan)\"></i></div>\n        <div class=\"between\" style=\"font-size:11px;color:var(--fg-muted)\">\n          <span id=\"sb-used-text\" class=\"mono\">—</span>\n          <span id=\"sb-quota-text\" class=\"mono\">目标 15M</span>\n        </div>\n      </div>\n\n      <nav class=\"nav\">\n        <button class=\"active\" data-view=\"telemetry\" type=\"button\"><span>📡 宿主实时遥测</span><span id=\"nav-days\" class=\"mono\">30d</span></button>\n        <button data-view=\"sessions\" type=\"button\"><span>🗂️ 宿主会话列表</span><span id=\"nav-sess\" class=\"mono\">0</span></button>\n        <button data-view=\"projects\" type=\"button\"><span>📁 宿主项目列表</span><span id=\"nav-proj\" class=\"mono\">0</span></button>\n        <button data-view=\"budget\" type=\"button\"><span>🛡️ 预算与复盘笔记</span><span id=\"nav-notes\" class=\"mono\">0</span></button>\n      </nav>\n\n      <div class=\"sidebar-foot\">\n        <div style=\"font-size:11px;color:var(--fg-muted);padding:0 4px\">\n          <div>口径：<span id=\"sb-tz\" class=\"mono\">—</span></div>\n          <div>采样：<span id=\"sb-asof\" class=\"mono\">—</span></div>\n        </div>\n        <button id=\"btn-theme\" type=\"button\">☀️ 切换深浅外观</button>\n      </div>\n    </aside>\n\n    <div class=\"main\">\n      <header class=\"topbar\">\n        <div class=\"row\">\n          <strong style=\"font-size:14.5px\">Velai Desktop 宿主用量驾驶舱</strong>\n          <div class=\"range-pills\">\n            <button data-days=\"7\" type=\"button\">近 7 天</button>\n            <button class=\"active\" data-days=\"30\" type=\"button\">近 30 天</button>\n          </div>\n          <span id=\"top-alert-badge\" class=\"badge b-cyan\">等待遥测</span>\n        </div>\n        <div class=\"row\">\n          <button id=\"btn-refresh\" class=\"primary\" type=\"button\">↻ 同步宿主遥测</button>\n        </div>\n      </header>\n\n      <div class=\"content\">\n        <div id=\"status\" class=\"status-bar\">\n          <span id=\"status-text\">正在从宿主读取实时用量遥测…</span>\n          <span id=\"rev-tag\" class=\"mono\">rev #0</span>\n        </div>\n\n        <!-- 5 Host Telemetry Windows -->\n        <section class=\"kpi-grid\" id=\"windows-grid\">\n          <div class=\"kpi-card\" style=\"--c1:var(--cyan)\">\n            <span class=\"kpi-label\"><span>近 5 分钟 (5m)</span><span class=\"mono\" id=\"w-5m-tps\">—</span></span>\n            <strong id=\"w-5m-tok\" class=\"kpi-val mono\">—</strong>\n            <span id=\"w-5m-sub\" class=\"kpi-sub\">输入 — / 输出 —</span>\n          </div>\n          <div class=\"kpi-card\" style=\"--c1:var(--emerald)\">\n            <span class=\"kpi-label\"><span>近 1 小时 (1h)</span><span class=\"mono\" id=\"w-1h-tps\">—</span></span>\n            <strong id=\"w-1h-tok\" class=\"kpi-val mono\">—</strong>\n            <span id=\"w-1h-sub\" class=\"kpi-sub\">缓存命中率 —</span>\n          </div>\n          <div class=\"kpi-card\" style=\"--c1:var(--amber)\">\n            <span class=\"kpi-label\"><span>今日累计 (today)</span><span class=\"mono\" id=\"w-today-cache\">—</span></span>\n            <strong id=\"w-today-tok\" class=\"kpi-val mono\">—</strong>\n            <span id=\"w-today-sub\" class=\"kpi-sub\">输入 — / 输出 —</span>\n          </div>\n          <div class=\"kpi-card\" style=\"--c1:var(--violet)\">\n            <span class=\"kpi-label\"><span>近 7 天 (7d)</span><span class=\"mono\" id=\"w-7d-cache\">—</span></span>\n            <strong id=\"w-7d-tok\" class=\"kpi-val mono\">—</strong>\n            <span id=\"w-7d-sub\" class=\"kpi-sub\">输入 — / 输出 —</span>\n          </div>\n          <div class=\"kpi-card\" style=\"--c1:var(--rose)\">\n            <span class=\"kpi-label\"><span>近 30 天 (30d)</span><span class=\"mono\" id=\"w-30d-cache\">—</span></span>\n            <strong id=\"w-30d-tok\" class=\"kpi-val mono\">—</strong>\n            <span id=\"w-30d-sub\" class=\"kpi-sub\">预算占用 —</span>\n          </div>\n        </section>\n\n        <!-- VIEW 1: 宿主实时遥测 -->\n        <section id=\"view-telemetry\" style=\"display:flex;flex-direction:column;gap:12px\">\n          <div class=\"dash-2\">\n            <div class=\"card\">\n              <div class=\"between\">\n                <h3>每日 Token 消耗趋势（空缺按缺测标示）</h3>\n                <span id=\"daily-hover\" class=\"mono\" style=\"font-size:11.5px;color:var(--cyan)\">悬停柱条查看当日输入/输出明细</span>\n              </div>\n              <div class=\"svg-box\"><svg id=\"daily-svg\" viewBox=\"0 0 660 252\"></svg></div>\n            </div>\n\n            <div class=\"card\">\n              <div class=\"between\">\n                <h3>模型消耗占比</h3>\n                <span id=\"models-trunc-badge\" class=\"badge b-amber\" hidden>宿主已截断长尾模型</span>\n              </div>\n              <div class=\"svg-box\"><svg id=\"model-svg\" viewBox=\"0 0 430 252\"></svg></div>\n            </div>\n          </div>\n\n          <div class=\"card\">\n            <div class=\"between\">\n              <h3>模型 Token 消耗排行榜</h3>\n              <span style=\"font-size:11.5px;color:var(--fg-muted)\">数据来源：<code>nmas.host.usageSummary</code>（只读）</span>\n            </div>\n            <div style=\"overflow-x:auto\">\n              <table>\n                <thead>\n                  <tr><th>模型标识</th><th>总 Token</th><th>输入 Token</th><th>输出 Token</th><th>已知占比</th></tr>\n                </thead>\n                <tbody id=\"model-tbody\"></tbody>\n              </table>\n            </div>\n          </div>\n        </section>\n\n        <!-- VIEW 2: 宿主会话列表 -->\n        <section id=\"view-sessions\" class=\"dash-2\" hidden>\n          <div class=\"card\">\n            <div class=\"between\">\n              <h3>宿主真实会话元数据 (<span id=\"sess-count\">0</span>)</h3>\n              <div class=\"row\">\n                <select id=\"sess-archived-filter\">\n                  <option value=\"all\">全部状态</option>\n                  <option value=\"false\">仅活跃会话</option>\n                  <option value=\"true\">仅已归档</option>\n                </select>\n                <button id=\"btn-sess-prev\" type=\"button\" disabled>上一页</button>\n                <button id=\"btn-sess-next\" type=\"button\" disabled>下一页</button>\n              </div>\n            </div>\n            <div id=\"sess-list\" style=\"display:flex;flex-direction:column;gap:8px;max-height:520px;overflow:auto\"></div>\n          </div>\n\n          <div class=\"card\">\n            <div class=\"between\">\n              <h3>会话元数据详情</h3>\n              <span class=\"badge b-emerald\">零正文隐私保护</span>\n            </div>\n            <p style=\"margin:0;font-size:12px;color:var(--fg-muted)\">\n              通过 <code>nmas.host.getSession({ sessionId })</code> 仅读取标题、状态、创建时间与归档标记，严禁拉取聊天正文。\n            </p>\n            <div id=\"sess-detail\" class=\"detail-box\">\n              <div style=\"color:var(--fg-muted);font-size:12.5px\">点击左侧任意宿主会话查看详情。</div>\n            </div>\n          </div>\n        </section>\n\n        <!-- VIEW 3: 宿主项目列表 -->\n        <section id=\"view-projects\" style=\"display:flex;flex-direction:column;gap:12px\" hidden>\n          <div class=\"card\">\n            <div class=\"between\">\n              <h3>宿主工作区项目 (<span id=\"proj-count\">0</span>)</h3>\n              <div class=\"row\">\n                <button id=\"btn-proj-prev\" type=\"button\" disabled>上一页</button>\n                <button id=\"btn-proj-next\" type=\"button\" disabled>下一页</button>\n              </div>\n            </div>\n            <div style=\"overflow-x:auto\">\n              <table>\n                <thead>\n                  <tr><th>项目 ID</th><th>项目名称</th><th>运行状态</th></tr>\n                </thead>\n                <tbody id=\"proj-tbody\"></tbody>\n              </table>\n            </div>\n          </div>\n        </section>\n\n        <!-- VIEW 4: 预算与复盘笔记 -->\n        <section id=\"view-budget\" class=\"split-2\" hidden>\n          <div class=\"card\">\n            <div class=\"between\">\n              <h3>月度 Token 预算与告警阈值</h3>\n              <span id=\"alert-badge\" class=\"badge b-cyan\">等待计算</span>\n            </div>\n            <div class=\"row\">\n              <label class=\"field\" style=\"flex:1\">30 天 Token 预算 (百万 M)\n                <input id=\"cfg-tok\" type=\"number\" min=\"0.1\" max=\"10000\" step=\"0.5\" value=\"15\">\n              </label>\n              <label class=\"field\" style=\"width:110px\">预警线 (%)\n                <input id=\"cfg-warn\" type=\"number\" min=\"1\" max=\"99\" value=\"70\">\n              </label>\n              <label class=\"field\" style=\"width:110px\">严重线 (%)\n                <input id=\"cfg-crit\" type=\"number\" min=\"2\" max=\"100\" value=\"90\">\n              </label>\n            </div>\n            <label class=\"field\">告警策略备注\n              <input id=\"cfg-note\" maxlength=\"400\" placeholder=\"例如：高频任务优先切换轻量模型以控费\">\n            </label>\n            <div class=\"between\">\n              <span id=\"budget-tip\" style=\"font-size:12px;color:var(--fg-muted)\"></span>\n              <button id=\"btn-save-budget\" class=\"primary\" type=\"button\">保存预算规则</button>\n            </div>\n          </div>\n\n          <div class=\"card\">\n            <div class=\"between\">\n              <h3>新增 / 编辑手动复盘笔记</h3>\n              <button id=\"btn-note-reset\" type=\"button\">+ 新建笔记</button>\n            </div>\n            <div class=\"row\">\n              <label class=\"field\" style=\"flex:1.4\">笔记标题\n                <input id=\"note-title\" maxlength=\"100\" placeholder=\"例如：本周缓存命中率复盘\">\n              </label>\n              <label class=\"field\" style=\"width:96px\">统计窗口\n                <select id=\"note-range\">\n                  <option value=\"7\">近 7 天</option>\n                  <option value=\"30\" selected>近 30 天</option>\n                </select>\n              </label>\n            </div>\n            <label class=\"field\">标签\n              <input id=\"note-tags\" maxlength=\"120\" placeholder=\"cache,budget,weekly\">\n            </label>\n            <label class=\"field\">复盘正文\n              <textarea id=\"note-body\" maxlength=\"4000\" placeholder=\"记录本周高消耗模型观察、预算调整结论与下周优化行动…\"></textarea>\n            </label>\n            <div class=\"between\">\n              <span id=\"note-edit-hint\" style=\"font-size:11.5px;color:var(--fg-muted)\">通过 V2 data.list / data.delete 独立键管理</span>\n              <button id=\"btn-save-note\" class=\"primary\" type=\"button\">保存复盘笔记</button>\n            </div>\n          </div>\n\n          <div class=\"card\" style=\"grid-column:1 / -1\">\n            <div class=\"between\">\n              <h3>历史手动复盘笔记 (<span id=\"notes-count\">0</span>)</h3>\n              <button id=\"btn-notes-more\" type=\"button\" hidden>加载更多笔记</button>\n            </div>\n            <div id=\"notes-list\" style=\"display:flex;flex-direction:column;gap:8px\"></div>\n          </div>\n        </section>\n      </div>\n    </div>\n  </div>\n\n  <script>\n    (() => {\n      const plugin = globalThis.nmasPlugin;\n      const $ = id => document.getElementById(id);\n      const PALETTE = ['#38bdf8', '#34d399', '#f59e0b', '#a78bfa', '#fb7185', '#60a5fa'];\n\n      let state = null;\n      let currentDays = 30;\n      let busy = false;\n      let sessOffset = 0;\n      let sessNextOffset = null;\n      let projOffset = 0;\n      let projNextOffset = null;\n      let editingNoteId = null;\n      let loadedNotes = [];\n      let notesNextCursor = null;\n\n      const setStatus = (t, kind = '') => {\n        $('status-text').textContent = t;\n        $('status').dataset.kind = kind;\n        $('rev-tag').textContent = `rev #${state?.revision ?? 0}`;\n      };\n\n      const fmtTok = v => {\n        if (v === null || v === undefined) return '缺测';\n        if (v >= 1_000_000) return `${(v / 1_000_000).toFixed(2)}M`;\n        if (v >= 1000) return `${(v / 1000).toFixed(1)}K`;\n        return String(v);\n      };\n\n      const fmtRate = v => {\n        if (v === null || v === undefined) return '缺测';\n        const pct = v <= 1 ? v * 100 : v;\n        return `${pct.toFixed(1)}%`;\n      };\n\n      const fmtTps = v => (v === null || v === undefined ? '— tok/s' : `${v.toFixed(1)} tok/s`);\n\n      const svgEl = (tag, attrs = {}, text = '') => {\n        const el = document.createElementNS('http://www.w3.org/2000/svg', tag);\n        for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, String(v));\n        if (text) el.textContent = text;\n        return el;\n      };\n\n      function switchView(v) {\n        document.querySelectorAll('.nav button').forEach(b => b.classList.toggle('active', b.dataset.view === v));\n        ['telemetry', 'sessions', 'projects', 'budget'].forEach(n => { $(`view-${n}`).hidden = n !== v; });\n      }\n\n      function alertBadgeMeta(level) {\n        if (level === 'critical') return ['b-rose', '⚠️ 严重超支告警'];\n        if (level === 'warn') return ['b-amber', '⚡ 接近预算预警线'];\n        if (level === 'ok') return ['b-emerald', '✅ 预算健康'];\n        return ['b-cyan', 'ℹ️ 30d 用量缺测'];\n      }\n\n      function renderSummary() {\n        const { windows, budget, as_of, timezone, days } = state;\n        const w5 = windows['5m'], w1 = windows['1h'], wt = windows.today, w7 = windows['7d'], w30 = windows['30d'];\n\n        $('w-5m-tok').textContent = fmtTok(w5.total_tokens);\n        $('w-5m-tps').textContent = fmtTps(w5.tokens_per_second);\n        $('w-5m-sub').textContent = `输入 ${fmtTok(w5.input_tokens)} / 输出 ${fmtTok(w5.output_tokens)}`;\n\n        $('w-1h-tok').textContent = fmtTok(w1.total_tokens);\n        $('w-1h-tps').textContent = fmtTps(w1.tokens_per_second);\n        $('w-1h-sub').textContent = `缓存命中率 ${fmtRate(w1.cache_rate)} (省 ${fmtTok(w1.cached_input_tokens)})`;\n\n        $('w-today-tok').textContent = fmtTok(wt.total_tokens);\n        $('w-today-cache').textContent = `缓存 ${fmtRate(wt.cache_rate)}`;\n        $('w-today-sub').textContent = `输入 ${fmtTok(wt.input_tokens)} / 输出 ${fmtTok(wt.output_tokens)}`;\n\n        $('w-7d-tok').textContent = fmtTok(w7.total_tokens);\n        $('w-7d-cache').textContent = `缓存 ${fmtRate(w7.cache_rate)}`;\n        $('w-7d-sub').textContent = `输入 ${fmtTok(w7.input_tokens)} / 输出 ${fmtTok(w7.output_tokens)}`;\n\n        $('w-30d-tok').textContent = fmtTok(w30.total_tokens);\n        $('w-30d-cache').textContent = `缓存 ${fmtRate(w30.cache_rate)}`;\n        $('w-30d-sub').textContent = budget.token_used_pct === null\n          ? '30d 预算占用：缺测'\n          : `预算占用 ${budget.token_used_pct}% / ${budget.monthly_tokens_m}M`;\n\n        $('sb-tz').textContent = timezone;\n        $('sb-asof').textContent = as_of.replace('T', ' ').slice(0, 19);\n        $('nav-days').textContent = `${days}d`;\n        $('nav-sess').textContent = String(state.sessions.items.length);\n        $('nav-proj').textContent = String(state.projects.items.length);\n        $('nav-notes').textContent = String(loadedNotes.length);\n\n        const pctText = budget.token_used_pct === null ? '缺测' : `${budget.token_used_pct}%`;\n        const barW = budget.token_used_pct === null ? 0 : Math.min(100, budget.token_used_pct);\n        $('sb-tok-pct').textContent = pctText;\n        $('sb-tok-bar').style.width = `${barW}%`;\n        $('sb-tok-bar').style.background =\n          budget.alert_level === 'critical' ? 'var(--rose)' : budget.alert_level === 'warn' ? 'var(--amber)' : 'var(--emerald)';\n        $('sb-used-text').textContent = `已用 ${fmtTok(budget.used_tokens_30d)}`;\n        $('sb-quota-text').textContent = `目标 ${budget.monthly_tokens_m}M`;\n\n        const [cls, label] = alertBadgeMeta(budget.alert_level);\n        $('top-alert-badge').className = `badge ${cls}`;\n        $('top-alert-badge').textContent = label;\n        $('alert-badge').className = `badge ${cls}`;\n        $('alert-badge').textContent = label;\n\n        $('cfg-tok').value = String(budget.monthly_tokens_m);\n        $('cfg-warn').value = String(budget.warn_pct);\n        $('cfg-crit').value = String(budget.critical_pct);\n        $('cfg-note').value = budget.alert_note || '';\n        $('budget-tip').textContent = budget.token_used_pct === null\n          ? '当前宿主 30 天用量字段为 null（缺测），待有遥测采样后自动计算告警等级。'\n          : `30 天已消耗 ${fmtTok(budget.used_tokens_30d)}（占配额 ${budget.token_used_pct}%），预警 ${budget.warn_pct}% / 严重 ${budget.critical_pct}%。`;\n        $('models-trunc-badge').hidden = !state.models_truncated;\n      }\n\n      function renderDailyChart() {\n        const svg = $('daily-svg');\n        svg.replaceChildren();\n        const daily = state.by_day || [];\n        const W = 660, H = 252, padL = 54, padR = 16, padT = 24, padB = 34;\n        const innerW = W - padL - padR, innerH = H - padT - padB;\n        if (!daily.length) {\n          svg.appendChild(svgEl('text', { x: W / 2, y: H / 2, 'text-anchor': 'middle', fill: '#7c8da8', 'font-size': 13 }, '宿主暂无每日用量采样记录'));\n          return;\n        }\n        const knownTotals = daily.map(d => d.total_tokens).filter(v => v !== null);\n        const maxTok = Math.max(1000, ...knownTotals);\n        for (let i = 0; i <= 4; i++) {\n          const y = padT + (i / 4) * innerH;\n          const tv = maxTok * (1 - i / 4);\n          svg.appendChild(svgEl('line', { x1: padL, y1: y, x2: W - padR, y2: y, stroke: 'rgba(148,163,184,0.13)' }));\n          svg.appendChild(svgEl('text', { x: padL - 6, y: y + 4, 'text-anchor': 'end', fill: '#7c8da8', 'font-size': 10 }, fmtTok(Math.round(tv))));\n        }\n\n        const step = innerW / daily.length;\n        const barW = Math.min(28, Math.max(7, step * 0.58));\n        daily.forEach((d, idx) => {\n          const cx = padL + (idx + 0.5) * step;\n          if (d.total_tokens === null) {\n            svg.appendChild(svgEl('rect', {\n              x: cx - barW / 2, y: padT + innerH - 18, width: barW, height: 18, rx: 3,\n              fill: 'none', stroke: '#64748b', 'stroke-dasharray': '3 2', opacity: 0.75,\n            }));\n          } else {\n            const totalH = (d.total_tokens / maxTok) * innerH;\n            const outTok = d.output_tokens ?? 0;\n            const outH = d.total_tokens > 0 ? Math.min(totalH, (outTok / maxTok) * innerH) : 0;\n            const yTop = padT + innerH - totalH;\n            svg.appendChild(svgEl('rect', {\n              x: cx - barW / 2, y: yTop, width: barW, height: Math.max(2, totalH), rx: 3,\n              fill: '#38bdf8', opacity: 0.8,\n            }));\n            if (outH > 1) {\n              svg.appendChild(svgEl('rect', {\n                x: cx - barW / 2, y: padT + innerH - outH, width: barW, height: outH, rx: 2,\n                fill: '#a78bfa', opacity: 0.92,\n              }));\n            }\n          }\n          if (daily.length <= 10 || idx % Math.ceil(daily.length / 8) === 0 || idx === daily.length - 1) {\n            svg.appendChild(svgEl('text', { x: cx, y: H - 10, 'text-anchor': 'middle', fill: '#7c8da8', 'font-size': 10 }, d.date.slice(5)));\n          }\n          const hit = svgEl('rect', { x: cx - step / 2, y: padT, width: step, height: innerH, fill: 'transparent', style: 'cursor:crosshair' });\n          hit.addEventListener('mouseenter', () => {\n            $('daily-hover').textContent = `${d.date} · 总计 ${fmtTok(d.total_tokens)} · 输入 ${fmtTok(d.input_tokens)} · 输出 ${fmtTok(d.output_tokens)}`;\n          });\n          svg.appendChild(hit);\n        });\n        svg.appendChild(svgEl('text', { x: padL, y: 14, fill: '#38bdf8', 'font-size': 10.5 }, '■ 总 Token'));\n        svg.appendChild(svgEl('text', { x: padL + 72, y: 14, fill: '#a78bfa', 'font-size': 10.5 }, '■ 输出 Token'));\n        svg.appendChild(svgEl('text', { x: padL + 150, y: 14, fill: '#64748b', 'font-size': 10.5 }, '□ 虚线=缺测(null)'));\n      }\n\n      function renderModels() {\n        const svg = $('model-svg');\n        svg.replaceChildren();\n        const list = state.by_model || [];\n        const tb = $('model-tbody');\n        tb.replaceChildren();\n        if (!list.length) {\n          svg.appendChild(svgEl('text', { x: 215, y: 126, 'text-anchor': 'middle', fill: '#7c8da8', 'font-size': 12.5 }, '暂无模型遥测分布'));\n          const tr = document.createElement('tr');\n          const td = document.createElement('td');\n          td.colSpan = 5; td.style.color = 'var(--fg-muted)'; td.textContent = '当前窗口内暂无模型用量数据。';\n          tr.appendChild(td); tb.appendChild(tr);\n          return;\n        }\n        const known = list.filter(m => m.total_tokens !== null && m.total_tokens > 0);\n        const total = known.reduce((a, b) => a + b.total_tokens, 0);\n        if (total > 0) {\n          const cx = 96, cy = 126, r = 64;\n          let angle = -Math.PI / 2;\n          known.slice(0, 6).forEach((m, idx) => {\n            const frac = m.total_tokens / total;\n            const next = angle + frac * Math.PI * 2;\n            const col = PALETTE[idx % PALETTE.length];\n            if (frac > 0.999) {\n              svg.appendChild(svgEl('circle', { cx, cy, r, fill: 'none', stroke: col, 'stroke-width': 22 }));\n            } else {\n              const x1 = cx + Math.cos(angle) * r, y1 = cy + Math.sin(angle) * r;\n              const x2 = cx + Math.cos(next) * r, y2 = cy + Math.sin(next) * r;\n              svg.appendChild(svgEl('path', {\n                d: `M ${x1} ${y1} A ${r} ${r} 0 ${frac > 0.5 ? 1 : 0} 1 ${x2} ${y2}`,\n                fill: 'none', stroke: col, 'stroke-width': 22,\n              }));\n            }\n            const ly = 42 + idx * 32;\n            svg.appendChild(svgEl('rect', { x: 186, y: ly - 9, width: 10, height: 10, rx: 2, fill: col }));\n            svg.appendChild(svgEl('text', { x: 204, y: ly, fill: '#cbd5e1', 'font-size': 11.5 }, `${m.model.slice(0, 20)} (${m.share_pct ?? '—'}%)`));\n            angle = next;\n          });\n          svg.appendChild(svgEl('text', { x: cx, y: cy - 3, 'text-anchor': 'middle', fill: '#7c8da8', 'font-size': 10.5 }, '已知总计'));\n          svg.appendChild(svgEl('text', { x: cx, y: cy + 15, 'text-anchor': 'middle', fill: '#eaf1fc', 'font-size': 13, 'font-weight': 700 }, fmtTok(total)));\n        } else {\n          svg.appendChild(svgEl('text', { x: 215, y: 126, 'text-anchor': 'middle', fill: '#7c8da8', 'font-size': 12.5 }, '模型 Token 字段均为缺测 (null)'));\n        }\n\n        for (const m of list) {\n          const tr = document.createElement('tr');\n          for (const [val, cls] of [\n            [m.model, 'mono'],\n            [fmtTok(m.total_tokens), 'mono'],\n            [fmtTok(m.input_tokens), 'mono'],\n            [fmtTok(m.output_tokens), 'mono'],\n            [m.share_pct === null ? '缺测' : `${m.share_pct}%`, 'mono'],\n          ]) {\n            const td = document.createElement('td');\n            if (cls) td.className = cls;\n            td.textContent = val;\n            tr.appendChild(td);\n          }\n          tb.appendChild(tr);\n        }\n      }\n\n      function renderSessions(page) {\n        const items = page.items || [];\n        sessNextOffset = page.next_offset;\n        $('sess-count').textContent = String(items.length);\n        $('nav-sess').textContent = String(items.length);\n        $('btn-sess-prev').disabled = sessOffset <= 0;\n        $('btn-sess-next').disabled = sessNextOffset === null;\n        const box = $('sess-list');\n        box.replaceChildren();\n        if (!items.length) {\n          const p = document.createElement('p');\n          p.style.color = 'var(--fg-muted)';\n          p.textContent = '当前筛选条件下没有可见的宿主会话。';\n          box.appendChild(p);\n          return;\n        }\n        for (const s of items) {\n          const card = document.createElement('article');\n          card.className = 'item-card clickable';\n          const top = document.createElement('div');\n          top.className = 'between';\n          const title = document.createElement('strong');\n          title.textContent = s.title || '（无标题会话）';\n          const badges = document.createElement('div');\n          badges.className = 'row';\n          const b1 = document.createElement('span');\n          b1.className = `badge ${s.is_archived ? 'b-amber' : 'b-emerald'}`;\n          b1.textContent = s.is_archived ? '已归档' : '活跃';\n          const b2 = document.createElement('span');\n          b2.className = 'badge b-cyan';\n          b2.textContent = s.status || 'unknown';\n          badges.append(b1, b2);\n          top.append(title, badges);\n\n          const meta = document.createElement('div');\n          meta.className = 'mono';\n          meta.style.cssText = 'font-size:11.5px;color:var(--fg-muted)';\n          meta.textContent = `ID: ${s.id} · 创建于 ${s.created_at || '缺测'}`;\n\n          card.append(top, meta);\n          card.addEventListener('click', () => inspectSession(s.id));\n          box.appendChild(card);\n        }\n      }\n\n      async function inspectSession(sessionId) {\n        const box = $('sess-detail');\n        box.textContent = '正在读取会话元数据…';\n        try {\n          const res = await plugin.action('usage.host.session_detail', { session_id: sessionId });\n          box.replaceChildren();\n          if (!res.found || !res.session) {\n            box.textContent = '未找到可见的会话元数据（可能已被删除或无访问权限）。';\n            return;\n          }\n          const s = res.session;\n          for (const [k, v] of [\n            ['会话 ID', s.id],\n            ['标题', s.title ?? '（缺测 / 无标题）'],\n            ['状态', s.status ?? '缺测'],\n            ['创建时间', s.created_at ?? '缺测'],\n            ['是否已归档', s.is_archived ? '是 (archived)' : '否 (active)'],\n          ]) {\n            const row = document.createElement('div');\n            row.className = 'kv';\n            const lk = document.createElement('span'); lk.style.color = 'var(--fg-muted)'; lk.textContent = k;\n            const lv = document.createElement('strong'); lv.className = 'mono'; lv.textContent = String(v);\n            row.append(lk, lv);\n            box.appendChild(row);\n          }\n        } catch (e) {\n          box.textContent = `读取详情失败：${e?.message || e}`;\n        }\n      }\n\n      function renderProjects(page) {\n        const items = page.items || [];\n        projNextOffset = page.next_offset;\n        $('proj-count').textContent = String(items.length);\n        $('nav-proj').textContent = String(items.length);\n        $('btn-proj-prev').disabled = projOffset <= 0;\n        $('btn-proj-next').disabled = projNextOffset === null;\n        const tb = $('proj-tbody');\n        tb.replaceChildren();\n        if (!items.length) {\n          const tr = document.createElement('tr');\n          const td = document.createElement('td');\n          td.colSpan = 3; td.style.color = 'var(--fg-muted)'; td.textContent = '宿主暂无可见项目。';\n          tr.appendChild(td); tb.appendChild(tr);\n          return;\n        }\n        for (const p of items) {\n          const tr = document.createElement('tr');\n          const td1 = document.createElement('td'); td1.className = 'mono'; td1.textContent = p.id;\n          const td2 = document.createElement('td'); td2.textContent = p.name || '（未命名项目）';\n          const td3 = document.createElement('td');\n          const b = document.createElement('span'); b.className = 'badge b-violet'; b.textContent = p.status || 'unknown';\n          td3.appendChild(b);\n          tr.append(td1, td2, td3);\n          tb.appendChild(tr);\n        }\n      }\n\n      function renderNotes() {\n        $('notes-count').textContent = String(loadedNotes.length);\n        $('nav-notes').textContent = String(loadedNotes.length);\n        $('btn-notes-more').hidden = !notesNextCursor;\n        const box = $('notes-list');\n        box.replaceChildren();\n        if (!loadedNotes.length) {\n          const p = document.createElement('p');\n          p.style.color = 'var(--fg-muted)';\n          p.textContent = '暂无手动复盘笔记，可在上方新建保存。';\n          box.appendChild(p);\n          return;\n        }\n        for (const n of loadedNotes) {\n          const card = document.createElement('article');\n          card.className = 'item-card';\n          const top = document.createElement('div');\n          top.className = 'between';\n          const title = document.createElement('strong');\n          title.textContent = n.title;\n          const right = document.createElement('div');\n          right.className = 'row';\n          const b = document.createElement('span');\n          b.className = 'badge b-cyan';\n          b.textContent = `近 ${n.range_days} 天`;\n          const editBtn = document.createElement('button');\n          editBtn.type = 'button'; editBtn.textContent = '编辑';\n          editBtn.addEventListener('click', () => {\n            editingNoteId = n.id;\n            $('note-title').value = n.title;\n            $('note-range').value = String(n.range_days);\n            $('note-tags').value = n.tags || '';\n            $('note-body').value = n.body;\n            $('note-edit-hint').textContent = `正在编辑键：${n.key}`;\n          });\n          const delBtn = document.createElement('button');\n          delBtn.type = 'button'; delBtn.className = 'danger'; delBtn.textContent = '删除';\n          delBtn.addEventListener('click', () => deleteNote(n.key));\n          right.append(b, editBtn, delBtn);\n          top.append(title, right);\n\n          const body = document.createElement('div');\n          body.style.cssText = 'white-space:pre-wrap;font-size:12.5px';\n          body.textContent = n.body;\n\n          const foot = document.createElement('div');\n          foot.className = 'between mono';\n          foot.style.cssText = 'font-size:11px;color:var(--fg-muted)';\n          foot.textContent = `${n.key}${n.tags ? ` · #${n.tags}` : ''} · 更新于 ${(n.updated_at || '').replace('T', ' ').slice(0, 19)}`;\n          card.append(top, body, foot);\n          box.appendChild(card);\n        }\n      }\n\n      async function loadDashboard() {\n        if (typeof plugin?.action !== 'function') {\n          setStatus('请在 Velai Desktop 中打开个人会话与用量统计大屏。', 'error');\n          return;\n        }\n        try {\n          state = await plugin.action('usage.dashboard', { days: currentDays });\n          loadedNotes = state.notes.items || [];\n          notesNextCursor = state.notes.next_cursor;\n          sessOffset = 0;\n          projOffset = 0;\n          renderSummary();\n          renderDailyChart();\n          renderModels();\n          renderSessions(state.sessions);\n          renderProjects(state.projects);\n          renderNotes();\n          setStatus(`已同步宿主实时遥测（近 ${currentDays} 天）· ${state.by_model.length} 个模型 · ${state.sessions.items.length} 条会话`, 'ok');\n        } catch (e) {\n          setStatus(`读取宿主遥测失败：${e?.message || e}`, 'error');\n        }\n      }\n\n      async function loadSessionsPage(offset) {\n        try {\n          const rawFilter = $('sess-archived-filter').value;\n          const payload = { offset, limit: 20 };\n          if (rawFilter === 'true') payload.is_archived = true;\n          else if (rawFilter === 'false') payload.is_archived = false;\n          const page = await plugin.action('usage.host.sessions', payload);\n          sessOffset = offset;\n          renderSessions(page);\n        } catch (e) {\n          setStatus(`分页读取会话失败：${e?.message || e}`, 'error');\n        }\n      }\n\n      async function loadProjectsPage(offset) {\n        try {\n          const page = await plugin.action('usage.host.projects', { offset, limit: 20 });\n          projOffset = offset;\n          renderProjects(page);\n        } catch (e) {\n          setStatus(`分页读取项目失败：${e?.message || e}`, 'error');\n        }\n      }\n\n      async function deleteNote(key) {\n        if (busy || !state) return;\n        busy = true;\n        try {\n          const res = await plugin.action('usage.note.delete', { expected_revision: state.revision, key });\n          if (res.status === 'deleted') {\n            await loadDashboard();\n            setStatus(`已删除复盘笔记 ${key}`, 'ok');\n          } else {\n            setStatus(`删除未完成：${res.status}`, 'error');\n          }\n        } catch (e) {\n          setStatus(`删除失败：${e?.message || e}`, 'error');\n        } finally {\n          busy = false;\n        }\n      }\n\n      document.querySelectorAll('.nav button').forEach(b => b.addEventListener('click', () => switchView(b.dataset.view)));\n      document.querySelectorAll('.range-pills button').forEach(b => b.addEventListener('click', () => {\n        currentDays = Number(b.dataset.days) === 7 ? 7 : 30;\n        document.querySelectorAll('.range-pills button').forEach(x => x.classList.toggle('active', x === b));\n        void loadDashboard();\n      }));\n\n      $('btn-theme').addEventListener('click', () => {\n        document.documentElement.dataset.theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';\n      });\n      $('btn-refresh').addEventListener('click', () => void loadDashboard());\n\n      $('sess-archived-filter').addEventListener('change', () => void loadSessionsPage(0));\n      $('btn-sess-prev').addEventListener('click', () => void loadSessionsPage(Math.max(0, sessOffset - 20)));\n      $('btn-sess-next').addEventListener('click', () => { if (sessNextOffset !== null) void loadSessionsPage(sessNextOffset); });\n\n      $('btn-proj-prev').addEventListener('click', () => void loadProjectsPage(Math.max(0, projOffset - 20)));\n      $('btn-proj-next').addEventListener('click', () => { if (projNextOffset !== null) void loadProjectsPage(projNextOffset); });\n\n      $('btn-save-budget').addEventListener('click', async () => {\n        if (busy || !state) return;\n        busy = true;\n        try {\n          const res = await plugin.action('usage.budget.save', {\n            expected_revision: state.revision,\n            monthly_tokens_m: Number($('cfg-tok').value),\n            warn_pct: Math.round(Number($('cfg-warn').value)),\n            critical_pct: Math.round(Number($('cfg-crit').value)),\n            alert_note: $('cfg-note').value,\n          });\n          if (res.status === 'saved') {\n            await loadDashboard();\n            setStatus('月度 Token 预算规则已保存。', 'ok');\n          } else {\n            setStatus(`保存预算失败：${res.status}（请确认预警线 < 严重线）`, 'error');\n          }\n        } catch (e) {\n          setStatus(`保存预算异常：${e?.message || e}`, 'error');\n        } finally {\n          busy = false;\n        }\n      });\n\n      $('btn-note-reset').addEventListener('click', () => {\n        editingNoteId = null;\n        $('note-title').value = '';\n        $('note-tags').value = '';\n        $('note-body').value = '';\n        $('note-edit-hint').textContent = '新建模式：将生成独立复盘键';\n      });\n\n      $('btn-save-note').addEventListener('click', async () => {\n        if (busy || !state) return;\n        const title = $('note-title').value.trim();\n        const body = $('note-body').value.trim();\n        if (!title || !body) { setStatus('请填写笔记标题和复盘正文。', 'error'); return; }\n        busy = true;\n        try {\n          const payload = {\n            expected_revision: state.revision,\n            title,\n            range_days: Number($('note-range').value) === 7 ? 7 : 30,\n            tags: $('note-tags').value.trim(),\n            body,\n          };\n          if (editingNoteId) payload.id = editingNoteId;\n          const res = await plugin.action('usage.note.save', payload);\n          if (res.status === 'saved') {\n            editingNoteId = null;\n            $('note-title').value = '';\n            $('note-tags').value = '';\n            $('note-body').value = '';\n            await loadDashboard();\n            setStatus(`复盘笔记已保存 (${res.key})`, 'ok');\n          } else {\n            setStatus(`保存笔记未完成：${res.status}`, 'error');\n          }\n        } catch (e) {\n          setStatus(`保存笔记失败：${e?.message || e}`, 'error');\n        } finally {\n          busy = false;\n        }\n      });\n\n      $('btn-notes-more').addEventListener('click', async () => {\n        if (!notesNextCursor) return;\n        try {\n          const more = await plugin.action('usage.note.list', { limit: 20, cursor: notesNextCursor });\n          loadedNotes = [...loadedNotes, ...(more.items || [])];\n          notesNextCursor = more.next_cursor;\n          renderNotes();\n        } catch (e) {\n          setStatus(`加载更多笔记失败：${e?.message || e}`, 'error');\n        }\n      });\n\n      void loadDashboard();\n    })();\n  </script>\n</body>\n</html>\n","path":"ui/index.html"}],"format":"nmas-plugin","manifest":{"actions":[{"id":"usage.dashboard","input_schema":{"additionalProperties":false,"properties":{"days":{"enum":[7,30],"type":"integer"},"include_archived":{"type":"boolean"}},"required":[],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"as_o