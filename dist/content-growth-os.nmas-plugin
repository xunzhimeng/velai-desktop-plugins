{"files":[{"content":"const COL_CALENDAR = 'calendar';\nconst COL_DRAFTS = 'drafts';\nconst COL_METRICS = 'metrics';\n\nconst KEY_BOARD = 'board';\nconst KEY_DRAFTS_INDEX = 'index';\nconst KEY_METRICS = 'series';\n\nconst MAX_RECORD_BYTES = 13 * 1024;\nconst MAX_CALENDAR_ITEMS = 48;\nconst MAX_DRAFTS = 36;\nconst MAX_PERIODS = 16;\n\nconst STAGES = ['idea', 'drafting', 'scheduled', 'published'];\nconst CHANNELS = ['wechat', 'xiaohongshu', 'zhihu', 'x', 'youtube', 'bilibili'];\nconst MODES = ['xiaohongshu', 'x_thread', 'zhihu', 'short_video'];\nconst DOC_FORMAT = 'velai.content-growth-os';\n\nconst VALUE_KEYWORDS_ZH = [\n  '实战', '避坑', '拆解', '复盘', '指南', '提效', '翻倍', '降本', '变现', '增长',\n  '源码', '架构', '踩坑', '秘诀', '误区', '对比', '评测', '手把手', '终极', '清单',\n  '方法论', '模板', '从0到1', '从零到一', '落地', '心法', '实测', '深度', '全链路', '工作流',\n];\nconst VALUE_KEYWORDS_EN = [\n  'how to', 'guide', 'playbook', 'teardown', 'mistakes', 'faster', 'framework',\n  'benchmark', 'checklist', 'template', 'lessons', 'deep dive', 'architecture',\n  'workflow', 'from scratch', 'case study', 'breakdown', 'blueprint',\n];\nconst TENSION_KEYWORDS_ZH = [\n  '为什么', '真相', '别再', '其实', '原来', '竟然', '颠覆', '逆袭', '血泪',\n  '被低估', '没人告诉', '90%', '80%', '真正', '致命', '如何', '彻底', '终结', 'VS', 'vs',\n];\nconst TENSION_KEYWORDS_EN = [\n  'why', 'stop', 'truth', 'myth', 'never', 'actually', 'wrong', 'secret',\n  'hidden', 'vs', 'versus', 'nobody', 'killed', 'beat',\n];\n\nfunction jsonBytes(v) {\n  let bytes = 0;\n  const s = JSON.stringify(v);\n  for (let i = 0; i < s.length; i++) {\n    const cp = s.codePointAt(i);\n    if (cp > 0xffff) i += 1;\n    bytes += cp <= 0x7f ? 1 : cp <= 0x7ff ? 2 : cp <= 0xffff ? 3 : 4;\n  }\n  return bytes;\n}\n\nfunction todayStr() {\n  return new Date().toISOString().slice(0, 10);\n}\n\nfunction validId(id) {\n  return typeof id === 'string' && id.length >= 1 && id.length <= 48 && /^[a-zA-Z0-9._-]+$/.test(id);\n}\n\nfunction validDate(d) {\n  return typeof d === 'string' && /^\\d{4}-\\d{2}-\\d{2}$/.test(d);\n}\n\nfunction uniqueChannels(list) {\n  const out = [];\n  if (!Array.isArray(list)) return out;\n  for (const ch of list) {\n    if (CHANNELS.includes(ch) && !out.includes(ch)) out.push(ch);\n  }\n  return out;\n}\n\nfunction countWords(text) {\n  const clean = (text || '').trim();\n  if (!clean) return 0;\n  const cjk = (clean.match(/[\\u4e00-\\u9fff\\u3400-\\u4dbf]/g) || []).length;\n  const latin = (clean.replace(/[\\u4e00-\\u9fff\\u3400-\\u4dbf]/g, ' ').match(/[A-Za-z0-9_'-]+/g) || []).length;\n  return cjk + latin;\n}\n\nfunction diagnoseHeadline(titleRaw, bodyRaw) {\n  const title = (titleRaw || '').trim();\n  const body = (bodyRaw || '').trim();\n  const lowerTitle = title.toLowerCase();\n\n  const chars = Array.from(title);\n  const charLen = chars.length;\n  const cjkCount = (title.match(/[\\u4e00-\\u9fff\\u3400-\\u4dbf]/g) || []).length;\n  const isZh = charLen === 0 ? true : cjkCount / charLen >= 0.3;\n\n  const highlights = [];\n  const suggestions = [];\n\n  // 1. 长度黄金区间 (0-20)\n  let lengthScore = 0;\n  if (charLen === 0) {\n    suggestions.push('请先输入标题，建议控制在中文 14-28 字或英文 40-72 字符。');\n  } else if (isZh) {\n    if (charLen >= 14 && charLen <= 28) {\n      lengthScore = 20;\n      highlights.push(`黄金字数 (${charLen}字)`);\n    } else if ((charLen >= 10 && charLen < 14) || (charLen > 28 && charLen <= 36)) {\n      lengthScore = 14;\n      suggestions.push(charLen < 14 ? `标题偏短(${charLen}字)，可补充具体结果或受众场景至 14-28 字。` : `标题偏长(${charLen}字)，信息流易被截断，建议精简至 28 字内。`);\n    } else {\n      lengthScore = 7;\n      suggestions.push(charLen < 10 ? '标题过短，缺乏信息锚点，建议扩写核心痛点与收益。' : '标题过长，移动端首屏展示不完整，建议提炼核心钩子。');\n    }\n  } else {\n    if (charLen >= 40 && charLen <= 72) {\n      lengthScore = 20;\n      highlights.push(`Optimal EN Length (${charLen} chars)`);\n    } else if ((charLen >= 26 && charLen < 40) || (charLen > 72 && charLen <= 90)) {\n      lengthScore = 14;\n      suggestions.push('英文标题建议微调至 40-72 字符以获得最佳点击率。');\n    } else {\n      lengthScore = 7;\n      suggestions.push('英文标题长度偏离最佳展示区间 (40-72 chars)。');\n    }\n  }\n\n  // 2. 数字与量化锚点 (0-20)\n  let numbersScore = 4;\n  const hasArabic = /\\d+/.test(title);\n  const hasQuantUnit = /(\\d+\\s*(%|％|倍|x|X|天|周|月|年|分钟|秒|个|条|步|招|款|大|w|W|k|K|万|亿))/.test(title);\n  const hasZhNum = /[一二三四五六七八九十百千万]/.test(title);\n  if (hasQuantUnit) {\n    numbersScore = 20;\n    highlights.push('强量化锚点');\n  } else if (hasArabic) {\n    numbersScore = 16;\n    highlights.push('包含数字锚点');\n  } else if (hasZhNum) {\n    numbersScore = 12;\n    highlights.push('含序列/数量词');\n  } else {\n    suggestions.push('加入具体数字或量化结果（如“3 个架构误区”“提效 5 倍”“60 秒拆解”）可显著提升点击欲。');\n  }\n\n  // 3. 痛点 / 收益 / 承诺词 (0-20)\n  const hitZhVal = VALUE_KEYWORDS_ZH.filter(w => title.includes(w));\n  const hitEnVal = VALUE_KEYWORDS_EN.filter(w => lowerTitle.includes(w));\n  const valHits = hitZhVal.length + hitEnVal.length;\n  let valueScore = 4;\n  if (valHits >= 2) {\n    valueScore = 20;\n    highlights.push(`强价值承诺 (${hitZhVal.concat(hitEnVal).slice(0, 2).join('/')})`);\n  } else if (valHits === 1) {\n    valueScore = 15;\n    highlights.push(`价值词: ${hitZhVal[0] || hitEnVal[0]}`);\n  } else {\n    suggestions.push('缺少明确的读者收益或方法词（如“实战”“避坑”“拆解”“指南”“复盘”）。');\n  }\n\n  // 4. 情绪张力与悬念结构 (0-20)\n  const hitZhTen = TENSION_KEYWORDS_ZH.filter(w => title.includes(w));\n  const hitEnTen = TENSION_KEYWORDS_EN.filter(w => lowerTitle.includes(w));\n  const hasPunct = /[？?！!：:｜|—【】「」]/.test(title);\n  let tensionScore = 4;\n  const tenHits = hitZhTen.length + hitEnTen.length;\n  if (tenHits >= 1 && hasPunct) {\n    tensionScore = 20;\n    highlights.push('高情绪张力与节奏分隔');\n  } else if (tenHits >= 1) {\n    tensionScore = 15;\n    highlights.push('包含悬念/反常识钩子');\n  } else if (hasPunct) {\n    tensionScore = 12;\n    highlights.push('主副标题结构清晰');\n  } else {\n    suggestions.push('可用“主标题：副标题”或反问/对比结构（如“为什么…？”、“别再…”）增强停驻率。');\n  }\n\n  // 5. 正文可读性与结构分段 (0-20)\n  const wordCount = countWords(body);\n  const readMinutes = wordCount === 0 ? 0 : Math.max(0.5, Math.round((wordCount / 360) * 10) / 10);\n  const paragraphs = body ? body.split(/\\n\\s*\\n/).map(p => p.trim()).filter(Boolean) : [];\n  const paragraphCount = paragraphs.length;\n  let readabilityScore = 10;\n\n  if (!body) {\n    readabilityScore = charLen >= 10 ? 11 : 6;\n    suggestions.push('补充正文大纲或首段钩子后，可进一步诊断全文分段节奏与可读性。');\n  } else {\n    let rScore = 6;\n    const hasHeadings = /(^|\\n)\\s*(#{1,3}\\s|[一二三四五六七八九十]、|\\d+[.、）)])/m.test(body);\n    const hasBullets = /(^|\\n)\\s*([-*•>]\\s)/m.test(body);\n    const avgParaLen = paragraphCount > 0 ? body.length / paragraphCount : body.length;\n\n    if (hasHeadings) {\n      rScore += 5;\n      highlights.push('小标题层级清晰');\n    } else {\n      suggestions.push('建议在正文中加入 2-4 个二级小标题（## 或 1. 2. 3.），提升移动端扫读体验。');\n    }\n    if (hasBullets) {\n      rScore += 4;\n    } else {\n      suggestions.push('核心要点可用无序列表或引用块突出，降低阅读阻力。');\n    }\n    if (paragraphCount >= 3 && avgParaLen <= 220) {\n      rScore += 5;\n      highlights.push('段落节奏清爽');\n    } else if (avgParaLen > 280) {\n      rScore += 1;\n      suggestions.push('单段文字偏长，建议每段控制在 3-5 行（约 120-180 字）并适当留白。');\n    } else {\n      rScore += 3;\n    }\n    readabilityScore = Math.min(20, rScore);\n  }\n\n  const score = Math.max(0, Math.min(100, lengthScore + numbersScore + valueScore + tensionScore + readabilityScore));\n  const grade = score >= 85 ? 'S' : score >= 72 ? 'A' : score >= 55 ? 'B' : 'C';\n\n  return {\n    score,\n    grade,\n    word_count: wordCount,\n    read_minutes: readMinutes,\n    paragraph_count: paragraphCount,\n    dimensions: {\n      length: lengthScore,\n      numbers: numbersScore,\n      value_hook: valueScore,\n      tension: tensionScore,\n      readability: readabilityScore,\n    },\n    highlights: highlights.slice(0, 6),\n    suggestions: suggestions.slice(0, 5),\n  };\n}\n\nasync function readCalendar() {\n  const receipt = await globalThis.nmas.data.read({ collection: COL_CALENDAR, key: KEY_BOARD });\n  const doc = receipt.value === null ? { schema_version: 1, items: [] } : receipt.value;\n  if (!doc || doc.schema_version !== 1 || !Array.isArray(doc.items)) {\n    throw new Error('排期看板数据格式损坏');\n  }\n  return { revision: receipt.revision, items: doc.items };\n}\n\nasync function readDraftsIndex() {\n  const receipt = await globalThis.nmas.data.read({ collection: COL_DRAFTS, key: KEY_DRAFTS_INDEX });\n  const doc = receipt.value === null ? { schema_version: 1, items: [] } : receipt.value;\n  if (!doc || doc.schema_version !== 1 || !Array.isArray(doc.items)) {\n    throw new Error('文稿索引数据格式损坏');\n  }\n  return { revision: receipt.revision, items: doc.items };\n}\n\nasync function readDraftDoc(id) {\n  const receipt = await globalThis.nmas.data.read({ collection: COL_DRAFTS, key: `doc:${id}` });\n  if (receipt.value === null) return { revision: receipt.revision, draft: null };\n  const doc = receipt.value;\n  if (!doc || doc.schema_version !== 1 || typeof doc.title !== 'string') {\n    throw new Error(`文稿 ${id} 数据格式损坏`);\n  }\n  return {\n    revision: receipt.revision,\n    draft: {\n      id: doc.id,\n      title: doc.title,\n      primary_channel: doc.primary_channel,\n      updated_at: doc.updated_at,\n      body: doc.body || '',\n      variants: Array.isArray(doc.variants) ? doc.variants : [],\n    },\n  };\n}\n\nasync function readMetrics() {\n  const receipt = await globalThis.nmas.data.read({ collection: COL_METRICS, key: KEY_METRICS });\n  const doc = receipt.value === null ? { schema_version: 1, periods: [] } : receipt.value;\n  if (!doc || doc.schema_version !== 1 || !Array.isArray(doc.periods)) {\n    throw new Error('增长指标数据格式损坏');\n  }\n  return { revision: receipt.revision, periods: doc.periods };\n}\n\nasync function writeRecord(collection, key, expectedRevision, value) {\n  if (jsonBytes(value) > MAX_RECORD_BYTES) {\n    return { status: 'limit', revision: expectedRevision };\n  }\n  try {\n    const receipt = await globalThis.nmas.data.write({\n      collection,\n      key,\n      expected_revision: expectedRevision,\n      value,\n    });\n    return { status: 'saved', revision: receipt.revision };\n  } catch (err) {\n    if (err?.code === 'conflict' && err.outcome_unknown === false) {\n      return { status: 'conflict', revision: expectedRevision };\n    }\n    throw err;\n  }\n}\n\nfunction computeChannelTotals(periods) {\n  const sums = {};\n  for (const ch of CHANNELS) sums[ch] = 0;\n  let grandTotal = 0;\n  for (const p of periods) {\n    const byCh = p.by_channel || {};\n    for (const ch of CHANNELS) {\n      const v = Number.isInteger(byCh[ch]) && byCh[ch] > 0 ? byCh[ch] : 0;\n      sums[ch] += v;\n      grandTotal += v;\n    }\n  }\n  return CHANNELS.map(channel => ({\n    channel,\n    views: sums[channel],\n    share_pct: grandTotal > 0 ? Math.round((sums[channel] / grandTotal) * 1000) / 10 : 0,\n  })).sort((a, b) => b.views - a.views);\n}\n\nfunction computeKpis(calendarItems, draftsIndex, periods) {\n  const publishedFromCalendar = calendarItems.filter(i => i.stage === 'published').length;\n  const publishedFromMetrics = periods.reduce((acc, p) => acc + (p.published_count || 0), 0);\n  const totalPublished = Math.max(publishedFromCalendar, publishedFromMetrics);\n  const totalViews = periods.reduce((acc, p) => acc + (p.views || 0), 0);\n  const totalEng = periods.reduce((acc, p) => acc + (p.engagements || 0), 0);\n  const avgEngagementRate = totalViews > 0 ? Math.round((totalEng / totalViews) * 1000) / 10 : 0;\n  const weeklyScheduled = calendarItems.filter(i => i.stage === 'scheduled').length;\n  return {\n    total_published: totalPublished,\n    total_views: totalViews,\n    avg_engagement_rate: avgEngagementRate,\n    weekly_scheduled: weeklyScheduled,\n    total_drafts: draftsIndex.length,\n  };\n}\n\nfunction buildDemoData() {\n  const calendar = [\n    {\n      id: 'cnt-001',\n      title: '为什么 90% 的 AI Agent 插件都死在沙箱安全？6 条桌面端实战避坑指南',\n      stage: 'published',\n      channels: ['wechat', 'zhihu', 'x'],\n      publish_date: '2026-11-12',\n      hook: '拆解 QuickJS + Seatbelt 零信任沙箱架构，用 6 个真实攻防案例讲清权限最小化。',\n      viral_score: 94,\n      draft_id: 'drf-001',\n      tags: ['AI架构', '沙箱安全', '深度长文'],\n    },\n    {\n      id: 'cnt-002',\n      title: '1 人日更 6 大平台：我的全自动 AI 内容工厂工作流拆解（附 4 套 Prompt）',\n      stage: 'scheduled',\n      channels: ['xiaohongshu', 'wechat', 'bilibili'],\n      publish_date: '2026-11-23',\n      hook: '从主稿诊断到小红书/X 串推一稿多改，展示单人开发者如何用 40 分钟完成全渠道分发。',\n      viral_score: 91,\n      draft_id: 'drf-002',\n      tags: ['效率工作流', '一稿多改', 'IP增长'],\n    },\n    {\n      id: 'cnt-003',\n      title: '别再把 Context 塞爆了！Context Cache 降本 68% 的 5 个工程细节实测',\n      stage: 'scheduled',\n      channels: ['zhihu', 'x', 'youtube'],\n      publish_date: '2026-11-25',\n      hook: '真实生产账单对比：固定前缀哈希、工具 Schema 稳态排序与分段摘要实测数据。',\n      viral_score: 89,\n      draft_id: 'drf-003',\n      tags: ['LLM成本', '工程实测', '性能'],\n    },\n    {\n      id: 'cnt-004',\n      title: 'Local-First 桌面端 AI 应用为什么正在回归？Rust + WebView 架构复盘',\n      stage: 'drafting',\n      channels: ['wechat', 'bilibili', 'youtube'],\n      publish_date: '2026-11-28',\n      hook: '对比 Electron 与原生 Rust 宿主在冷启动、内存占用与离线隐私上的 4 组基准数据。',\n      viral_score: 86,\n      draft_id: '',\n      tags: ['Rust', '桌面端', '架构对比'],\n    },\n    {\n      id: 'cnt-005',\n      title: '从 0 到 1 万技术粉丝：开发者做个人 IP 最容易踩的 5 个内容误区',\n      stage: 'idea',\n      channels: ['xiaohongshu', 'zhihu'],\n      publish_date: '2026-12-02',\n      hook: '为什么干货越硬阅读越低？讲清“技术深度”与“认知情绪钩子”的黄金平衡点。',\n      viral_score: 84,\n      draft_id: '',\n      tags: ['开发者IP', '选题方法论'],\n    },\n    {\n      id: 'cnt-006',\n      title: '60 秒看懂多智能体协作 vs 单体长思考：什么场景该拆 Subagent？',\n      stage: 'published',\n      channels: ['bilibili', 'youtube', 'xiaohongshu'],\n      publish_date: '2026-11-16',\n      hook: '用厨房主厨与配菜师的直观比喻，讲清上下文隔离与并行探索的边界。',\n      viral_score: 88,\n      draft_id: '',\n      tags: ['短视频', 'Multi-Agent', '科普'],\n    },\n  ];\n\n  const drafts = [\n    {\n      id: 'drf-001',\n      title: '为什么 90% 的 AI Agent 插件都死在沙箱安全？6 条桌面端实战避坑指南',\n      primary_channel: 'wechat',\n      updated_at: '2026-11-18',\n      body:\n        '过去半年，我们在构建桌面端原生插件运行时过程中，审计了超过 40 个社区扩展原型，发现一个残酷的规律：功能做得越炫，越容易在安全准入阶段直接被拦下。\\n\\n' +\n        '## 1. 为什么传统插件模式在 AI 时代失效？\\n\\n' +\n        '传统 IDE 插件默认完全信任本地进程，可以直接读写任意磁盘目录、执行 Shell 命令甚至读取环境变量里的 API Key。但在 Agent 可以自主触发工具调用的背景下，一次 Prompt 注入就可能演变为数据外泄。\\n\\n' +\n        '## 2. 桌面端零信任沙箱的 6 条硬核设计\\n\\n' +\n        '- 权限声明最小化：仅授予 data.read / data.write 或受限静态 HTTPS GET，杜绝通配符外联。\\n' +\n        '- 乐观锁 CAS 并发控制：所有持久化写入必须携带 expected_revision，彻底消除多窗口静默覆盖。\\n' +\n        '- 严格 JSON Schema 校验：在宿主侧对工具入参与出参做强类型拦截，防止模型幻觉污染状态。\\n' +\n        '- 作用域物理隔离：project 级数据按项目隔离，绝不跨库泄漏到全局助手会话。\\n' +\n        '- 单包 SHA-256 绑定：归档与后端源码做摘要绑定，分发链路不可篡改。\\n' +\n        '- 无外链纯净 UI：前端页面零第三方 CDN 依赖，离线同样秒开且无 XSS 供应链风险。\\n\\n' +\n        '## 3. 结语：安全不是体验的敌人\\n\\n' +\n        '当你把权限边界设计得足够清晰，用户才会真正放心地把日常工作流交给桌面端 AI 插件长期运行。',\n      variants: [\n        {\n          mode: 'xiaohongshu',\n          updated_at: '2026-11-18',\n          content:\n            '🚨做 AI 插件千万别裸奔！90% 开发者踩过的 6 个安全大坑整理好了👇\\n\\n' +\n            '最近审计了 40+ 个 AI 插件原型，发现最致命的不是模型笨，而是安全边界没画清！一旦遇到 Prompt 注入，本地文件直接裸奔😱\\n\\n' +\n            '✅ 6 条桌面端沙箱保命法则：\\n' +\n            '1️⃣ 权限最小化：拒绝万能网络与任意文件读写\\n' +\n            '2️⃣ 写入带 CAS 乐观锁：多窗口操作绝不互相覆盖\\n' +\n            '3️⃣ 强校验 JSON Schema：拦住 AI 幻觉脏数据\\n' +\n            '4️⃣ 项目级物理隔离：A 项目机密绝不串到 B 项目\\n' +\n            '5️⃣ SHA-256 单包防篡改：离线也能验明正身\\n' +\n            '6️⃣ UI 零外链零 CDN：秒开还防供应链投毒\\n\\n' +\n            '💬 你们在用 AI 插件时，最担心哪一类权限？评论区聊聊！\\n' +\n            '#AI开发者 #独立开发 #架构设计 #软件安全 #生产力工具',\n        },\n        {\n          mode: 'x_thread',\n          updated_at: '2026-11-18',\n          content:\n            '1/ Why do 90% of AI Agent plugins fail security review? After auditing 40+ prototypes on desktop, here are the 6 sandbox patterns that actually work in production. 🧵👇\\n\\n' +\n            '2/ Classic plugins assume full local trust. In the Agent era, prompt injection turns overly broad file/shell permissions into instant exfiltration.\\n\\n' +\n            '3/ Rule #1: Capability-based least privilege. Separate read/write storage, forbid wildcard HTTP, and bind every action to explicit permissions.\\n\\n' +\n            '4/ Rule #2: Enforce CAS optimistic locking (expected_revision) on every write so concurrent views & tools never silently clobber user data.\\n\\n' +\n            '5/ Rule #3: Strict host-side JSON Schema validation on both tool inputs AND outputs. Never trust raw LLM payloads.\\n\\n' +\n            '6/ Rule #4: Hard project-scope isolation + zero external CDN assets in plugin UIs. Fast offline, zero supply-chain surprises.\\n\\n' +\n            '7/ Safe defaults unlock user trust. Bookmark this checklist if you are shipping desktop AI extensions!',\n        },\n      ],\n    },\n    {\n      id: 'drf-002',\n      title: '1 人日更 6 大平台：我的全自动 AI 内容工厂工作流拆解（附 4 套 Prompt）',\n      primary_channel: 'xiaohongshu',\n      updated_at: '2026-11-20',\n      body:\n        '很多技术博主不是写不出好内容，而是写完一篇公众号长文后，再也没有精力去改写小红书图文、X 串推、知乎回答和短视频口播。\\n\\n' +\n        '## 1. 核心原则：一次深度思考，六次平台原生表达\\n\\n' +\n        '切忌把同一段文字原封不动复制到各个平台。不同平台的阅读心智完全不同：公众号看逻辑纵深，小红书看情绪钩子与清单感，X 看节奏与金句密度，短视频看前 3 秒完播留存。\\n\\n' +\n        '## 2. 我的 40 分钟全渠道生产流水线\\n\\n' +\n        '- 第 1 步（15 分钟）：在主稿编辑器写清核心论点、3 组真实数据与 1 个反常识结论。\\n' +\n        '- 第 2 步（5 分钟）：用实时标题诊断仪把标题打磨到 85 分以上，补齐量化锚点。\\n' +\n        '- 第 3 步（10 分钟）：通过 AI 一稿多改矩阵，按平台语感生成 4 套衍生版本并人工微调。\\n' +\n        '- 第 4 步（10 分钟）：进入排期看板定档发布，每周一复盘互动率反哺下一轮选题。\\n\\n' +\n        '## 3. 30 天实测结果\\n\\n' +\n        '坚持这套工作流 6 周后，总曝光提升了 3.2 倍，单篇平均制作耗时从 4.5 小时压缩到 40 分钟，互动率稳定在 6.5% 以上。',\n      variants: [\n        {\n          mode: 'short_video',\n          updated_at: '2026-11-20',\n          content:\n            '【0-3秒 黄金钩子｜语速快、直视镜头】\\n' +\n            '别再傻傻地一篇文章复制粘贴发 6 个平台了！播放量低根本不是内容差，是平台语感全错了。\\n\\n' +\n            '【4-25秒 痛点与方法｜切工作台录屏】\\n' +\n            '作为全职写代码的开发者，我每周只花 40 分钟就能稳定更新 6 大平台，秘密就是「1 篇主稿 + 4 套原生改写」。先用标题诊断仪把点击率打到 85 分以上，补齐数字锚点和反常识钩子。\\n\\n' +\n            '【26-48秒 流程拆解｜字幕弹出关键词】\\n' +\n            '接着一键拆给 AI：小红书要清单加情绪，X 串推要短句加干货，知乎要深度框架，短视频要前 3 秒留人！6 周实测下来，我的全网阅读直接涨了 3.2 倍。\\n\\n' +\n            '【49-60秒 结尾 CTA｜微笑手势】\\n' +\n            '这套 4 合 1 的提示词工作流我都整理好了，点个收藏，评论区扣「工作流」我把完整框架分享给你！',\n        },\n      ],\n    },\n    {\n      id: 'drf-003',\n      title: '别再把 Context 塞爆了！Context Cache 降本 68% 的 5 个工程细节实测',\n      primary_channel: 'zhihu',\n      updated_at: '2026-11-21',\n      body:\n        '在高频 Agent 场景下，90% 的 Token 账单其实花在重复发送系统提示词、工具定义与历史对话前缀上。\\n\\n' +\n        '## 1. 为什么你的 Prompt Cache 命中率总是不稳定？\\n\\n' +\n        '只要前缀中混入一个动态时间戳、随机 UUID 或排序漂移的工具定义列表，整段缓存就会瞬间失效。\\n\\n' +\n        '## 2. 实测最有效的 5 个降本工程细节\\n\\n' +\n        '- 严格固定 System Prompt 与 Tools JSON 键序，将动态时间移至最新一条 User 消息尾部。\\n' +\n        '- 采用分段锚点策略，将长文档知识库置顶于稳定前缀区。\\n' +\n        '- 在子代理探索任务中隔离高频工具输出，避免把 50KB 日志直接灌回主会话上下文。\\n' +\n        '- 对超过 12 轮的历史对话做结构化摘要压缩，保留关键决策而非冗余过程。\\n' +\n        '- 在网关层记录每次请求的 cache_read_tokens 比例，跌破 65% 自动告警。',\n      variants: [],\n    },\n  ];\n\n  const periods = [\n    {\n      period: 'W42',\n      label: '10/14',\n      views: 18400,\n      engagements: 990,\n      engagement_rate: 5.4,\n      published_count: 3,\n      by_channel: { wechat: 4800, xiaohongshu: 5200, zhihu: 3100, x: 2400, youtube: 1300, bilibili: 1600 },\n    },\n    {\n      period: 'W43',\n      label: '10/21',\n      views: 24600,\n      engagements: 1450,\n      engagement_rate: 5.9,\n      published_count: 4,\n      by_channel: { wechat: 6200, xiaohongshu: 7100, zhihu: 4100, x: 3200, youtube: 1800, bilibili: 2200 },\n    },\n    {\n      period: 'W44',\n      label: '10/28',\n      views: 31200,\n      engagements: 1965,\n      engagement_rate: 6.3,\n      published_count: 4,\n      by_channel: { wechat: 7900, xiaohongshu: 8900, zhihu: 5200, x: 4300, youtube: 2100, bilibili: 2800 },\n    },\n    {\n      period: 'W45',\n      label: '11/04',\n      views: 28900,\n      engagements: 1994,\n      engagement_rate: 6.9,\n      published_count: 3,\n      by_channel: { wechat: 7400, xiaohongshu: 8200, zhihu: 4800, x: 4000, youtube: 1900, bilibili: 2600 },\n    },\n    {\n      period: 'W46',\n      label: '11/11',\n      views: 42800,\n      engagements: 3124,\n      engagement_rate: 7.3,\n      published_count: 5,\n      by_channel: { wechat: 10800, xiaohongshu: 12400, zhihu: 6900, x: 5800, youtube: 3100, bilibili: 3800 },\n    },\n    {\n      period: 'W47',\n      label: '11/18',\n      views: 51600,\n      engagements: 4025,\n      engagement_rate: 7.8,\n      published_count: 5,\n      by_channel: { wechat: 12900, xiaohongshu: 15100, zhihu: 8400, x: 6900, youtube: 3700, bilibili: 4600 },\n    },\n  ];\n\n  return { calendar, drafts, periods };\n}\n\nfunction makeDraftIndexEntry(draft, diag) {\n  return {\n    id: draft.id,\n    title: draft.title,\n    primary_channel: draft.primary_channel,\n    updated_at: draft.updated_at,\n    word_count: diag.word_count,\n    read_minutes: diag.read_minutes,\n    headline_score: diag.score,\n    variants_count: Array.isArray(draft.variants) ? draft.variants.length : 0,\n  };\n}\n\nfunction nextId(prefix, existingIds) {\n  let maxN = 0;\n  const re = new RegExp(`^${prefix}-(\\\\d+)$`);\n  for (const id of existingIds) {\n    const m = re.exec(id);\n    if (m) maxN = Math.max(maxN, Number(m[1]));\n  }\n  return `${prefix}-${String(maxN + 1).padStart(3, '0')}`;\n}\n\nexport default async function (request) {\n  const { kind, contribution, input } = request ?? {};\n\n  if (kind === 'action') {\n    if (contribution === 'growth.dashboard') {\n      const cal = await readCalendar();\n      const idx = await readDraftsIndex();\n      const met = await readMetrics();\n      const channelTotals = computeChannelTotals(met.periods);\n      const kpis = computeKpis(cal.items, idx.items, met.periods);\n      return {\n        revision: met.revision,\n        kpis,\n        calendar: cal.items,\n        drafts: idx.items,\n        periods: met.periods,\n        channel_totals: channelTotals,\n      };\n    }\n\n    if (contribution === 'draft.diagnose') {\n      return diagnoseHeadline(input.title, input.body);\n    }\n\n    if (contribution === 'calendar.save') {\n      const title = (input.title || '').trim();\n      const channels = uniqueChannels(input.channels);\n      if (!title || !STAGES.includes(input.stage) || channels.length === 0 || !validDate(input.publish_date)) {\n        return { status: 'invalid_input', revision: input.expected_revision };\n      }\n      const cal = await readCalendar();\n      if (cal.revision !== input.expected_revision) {\n        return { status: 'conflict', revision: cal.revision };\n      }\n      const finalId = input.id === 'NEW' ? nextId('cnt', cal.items.map(i => i.id)) : input.id;\n      if (!validId(finalId)) return { status: 'invalid_input', revision: cal.revision };\n\n      const diag = diagnoseHeadline(title, input.hook || '');\n      const viralScore = Number.isInteger(input.viral_score) ? Math.max(0, Math.min(100, input.viral_score)) : diag.score;\n      const tags = Array.isArray(input.tags)\n        ? input.tags.map(t => String(t).trim().slice(0, 24)).filter(Boolean).slice(0, 5)\n        : [];\n\n      const record = {\n        id: finalId,\n        title,\n        stage: input.stage,\n        channels,\n        publish_date: input.publish_date,\n        hook: (input.hook || '').trim().slice(0, 240),\n        viral_score: viralScore,\n        draft_id: (input.draft_id || '').trim().slice(0, 48),\n        tags,\n      };\n\n      const exists = cal.items.some(i => i.id === finalId);\n      const next = exists ? cal.items.map(i => (i.id === finalId ? record : i)) : [record, ...cal.items];\n      if (next.length > MAX_CALENDAR_ITEMS) return { status: 'limit', revision: cal.revision };\n      const res = await writeRecord(COL_CALENDAR, KEY_BOARD, input.expected_revision, { schema_version: 1, items: next });\n      return res.status === 'saved'\n        ? { status: 'saved', revision: res.revision, id: finalId, viral_score: viralScore }\n        : res;\n    }\n\n    if (contribution === 'calendar.move') {\n      if (!STAGES.includes(input.stage) || !validId(input.id)) {\n        return { status: 'invalid_input', revision: input.expected_revision };\n      }\n      const cal = await readCalendar();\n      if (cal.revision !== input.expected_revision) return { status: 'conflict', revision: cal.revision };\n      if (!cal.items.some(i => i.id === input.id)) return { status: 'not_found', revision: cal.revision };\n      const next = cal.items.map(i => (i.id === input.id ? { ...i, stage: input.stage } : i));\n      const res = await writeRecord(COL_CALENDAR, KEY_BOARD, input.expected_revision, { schema_version: 1, items: next });\n      return res.status === 'saved' ? { status: 'saved', revision: res.revision } : { status: 'conflict', revision: res.revision };\n    }\n\n    if (contribution === 'calendar.delete') {\n      const cal = await readCalendar();\n      if (cal.revision !== input.expected_revision) return { status: 'conflict', revision: cal.revision };\n      if (!cal.items.some(i => i.id === input.id)) return { status: 'not_found', revision: cal.revision };\n      const next = cal.items.filter(i => i.id !== input.id);\n      const res = await writeRecord(COL_CALENDAR, KEY_BOARD, input.expected_revision, { schema_version: 1, items: next });\n      return res.status === 'saved' ? { status: 'deleted', revision: res.revision } : { status: 'conflict', revision: res.revision };\n    }\n\n    if (contribution === 'draft.read') {\n      if (!validId(input.id)) return { found: false, revision: 0 };\n      const { revision, draft } = await readDraftDoc(input.id);\n      if (!draft) return { found: false, revision };\n      return {\n        found: true,\n        revision,\n        draft,\n        diagnosis: diagnoseHeadline(draft.title, draft.body),\n      };\n    }\n\n    if (contribution === 'draft.save') {\n      const title = (input.title || '').trim();\n      const body = (input.body || '').trim();\n      if (!title || !CHANNELS.includes(input.primary_channel)) {\n        return { status: 'invalid_input', revision: input.expected_revision };\n      }\n      const idx = await readDraftsIndex();\n      if (idx.revision !== input.expected_revision) return { status: 'conflict', revision: idx.revision };\n\n      const finalId = input.id === 'NEW' ? nextId('drf', idx.items.map(d => d.id)) : input.id;\n      if (!validId(finalId)) return { status: 'invalid_input', revision: idx.revision };\n\n      const existingDoc = idx.items.some(d => d.id === finalId) ? (await readDraftDoc(finalId)).draft : null;\n      const draftObj = {\n        schema_version: 1,\n        id: finalId,\n        title,\n        primary_channel: input.primary_channel,\n        updated_at: todayStr(),\n        body,\n        variants: existingDoc ? existingDoc.variants : [],\n      };\n      const diag = diagnoseHeadline(title, body);\n      const entry = makeDraftIndexEntry(draftObj, diag);\n      const nextIdx = existingDoc\n        ? idx.items.map(d => (d.id === finalId ? entry : d))\n        : [entry, ...idx.items];\n\n      if (nextIdx.length > MAX_DRAFTS) return { status: 'limit', revision: idx.revision };\n\n      const w1 = await writeRecord(COL_DRAFTS, `doc:${finalId}`, input.expected_revision, draftObj);\n      if (w1.status !== 'saved') return w1;\n      const w2 = await writeRecord(COL_DRAFTS, KEY_DRAFTS_INDEX, w1.revision, { schema_version: 1, items: nextIdx });\n      if (w2.status !== 'saved') return w2;\n\n      return {\n        status: 'saved',\n        revision: w2.revision,\n        id: finalId,\n        headline_score: diag.score,\n        word_count: diag.word_count,\n      };\n    }\n\n    if (contribution === 'draft.delete') {\n      const idx = await readDraftsIndex();\n      if (idx.revision !== input.expected_revision) return { status: 'conflict', revision: idx.revision };\n      if (!idx.items.some(d => d.id === input.id)) return { status: 'not_found', revision: idx.revision };\n      const nextIdx = idx.items.filter(d => d.id !== input.id);\n      const w1 = await writeRecord(COL_DRAFTS, KEY_DRAFTS_INDEX, input.expected_revision, { schema_version: 1, items: nextIdx });\n      if (w1.status !== 'saved') return { status: 'conflict', revision: w1.revision };\n      const w2 = await writeRecord(COL_DRAFTS, `doc:${input.id}`, w1.revision, null);\n      return w2.status === 'saved' ? { status: 'deleted', revision: w2.revision } : { status: 'conflict', revision: w2.revision };\n    }\n\n    if (contribution === 'draft.variant.save') {\n      const content = (input.content || '').trim();\n      if (!validId(input.draft_id) || !MODES.includes(input.mode) || !content) {\n        return { status: 'invalid_input', revision: input.expected_revision };\n      }\n      const idx = await readDraftsIndex();\n      if (idx.revision !== input.expected_revision) return { status: 'conflict', revision: idx.revision };\n      const { draft } = await readDraftDoc(input.draft_id);\n      if (!draft) return { status: 'not_found', revision: idx.revision };\n\n      const updatedAt = todayStr();\n      const filtered = draft.variants.filter(v => v.mode !== input.mode);\n      const nextVariants = [...filtered, { mode: input.mode, content, updated_at: updatedAt }];\n      const nextDoc = { schema_version: 1, ...draft, updated_at: updatedAt, variants: nextVariants };\n\n      const w1 = await writeRecord(COL_DRAFTS, `doc:${draft.id}`, input.expected_revision, nextDoc);\n      if (w1.status !== 'saved') return w1;\n\n      const nextIdx = idx.items.map(d =>\n        d.id === draft.id ? { ...d, updated_at: updatedAt, variants_count: nextVariants.length } : d,\n      );\n      const w2 = await writeRecord(COL_DRAFTS, KEY_DRAFTS_INDEX, w1.revision, { schema_version: 1, items: nextIdx });\n      if (w2.status !== 'saved') return w2;\n\n      return { status: 'saved', revision: w2.revision, variants_count: nextVariants.length };\n    }\n\n    if (contribution === 'metrics.record') {\n      const period = (input.period || '').trim();\n      const label = (input.label || '').trim();\n      if (!period || !label) return { status: 'invalid_input', revision: input.expected_revision };\n      const met = await readMetrics();\n      if (met.revision !== input.expected_revision) return { status: 'conflict', revision: met.revision };\n\n      const byCh = {};\n      let views = 0;\n      for (const ch of CHANNELS) {\n        const val = Number.isInteger(input.by_channel[ch]) && input.by_channel[ch] >= 0 ? input.by_channel[ch] : 0;\n        byCh[ch] = val;\n        views += val;\n      }\n      const engagements = Math.max(0, input.engagements);\n      const rate = views > 0 ? Math.min(100, Math.round((engagements / views) * 1000) / 10) : 0;\n      const entry = {\n        period,\n        label,\n        views,\n        engagements,\n        engagement_rate: rate,\n        published_count: Math.max(0, input.published_count),\n        by_channel: byCh,\n      };\n      const exists = met.periods.some(p => p.period === period);\n      const next = exists ? met.periods.map(p => (p.period === period ? entry : p)) : [...met.periods, entry];\n      if (next.length > MAX_PERIODS) return { status: 'limit', revision: met.revision };\n\n      const res = await writeRecord(COL_METRICS, KEY_METRICS, input.expected_revision, { schema_version: 1, periods: next });\n      return res;\n    }\n\n    if (contribution === 'demo.seed') {\n      const cal = await readCalendar();\n      if (cal.revision !== input.expected_revision) return { status: 'conflict', revision: cal.revision };\n      const demo = buildDemoData();\n\n      let rev = input.expected_revision;\n      const wCal = await writeRecord(COL_CALENDAR, KEY_BOARD, rev, { schema_version: 1, items: demo.calendar });\n      if (wCal.status !== 'saved') return { status: wCal.status === 'limit' ? 'limit' : 'conflict', revision: wCal.revision };\n      rev = wCal.revision;\n\n      const idxEntries = [];\n      for (const d of demo.drafts) {\n        const diag = diagnoseHeadline(d.title, d.body);\n        idxEntries.push(makeDraftIndexEntry(d, diag));\n        const wDoc = await writeRecord(COL_DRAFTS, `doc:${d.id}`, rev, { schema_version: 1, ...d });\n        if (wDoc.status !== 'saved') return { status: wDoc.status === 'limit' ? 'limit' : 'conflict', revision: wDoc.revision };\n        rev = wDoc.revision;\n      }\n\n      const wIdx = await writeRecord(COL_DRAFTS, KEY_DRAFTS_INDEX, rev, { schema_version: 1, items: idxEntries });\n      if (wIdx.status !== 'saved') return { status: wIdx.status === 'limit' ? 'limit' : 'conflict', revision: wIdx.revision };\n      rev = wIdx.revision;\n\n      const wMet = await writeRecord(COL_METRICS, KEY_METRICS, rev, { schema_version: 1, periods: demo.periods });\n      if (wMet.status !== 'saved') return { status: wMet.status === 'limit' ? 'limit' : 'conflict', revision: wMet.revision };\n      rev = wMet.revision;\n\n      return {\n        status: 'seeded',\n        revision: rev,\n        calendar_count: demo.calendar.length,\n        drafts_count: demo.drafts.length,\n        periods_count: demo.periods.length,\n      };\n    }\n\n    if (contribution === 'document.list') {\n      const idx = await readDraftsIndex();\n      const items = [\n        { id: 'CALENDAR', label: '全渠道排期看板与复盘指标包' },\n        ...idx.items.map(d => ({ id: d.id, label: `主稿 ${d.id} · ${d.title}` })),\n      ];\n      return { items };\n    }\n\n    if (contribution === 'document.export') {\n      const serializeDoc = payload => {\n        const pretty = JSON.stringify(payload, null, 2);\n        return jsonBytes(pretty) <= 11800 ? pretty : JSON.stringify(payload);\n      };\n      if (input.id === 'CALENDAR') {\n        const cal = await readCalendar();\n        const met = await readMetrics();\n        const text = serializeDoc({ format: DOC_FORMAT, version: 1, kind: 'calendar_metrics', calendar: cal.items, periods: met.periods });\n        if (jsonBytes(text) > 12000) return { error: 'too_large' };\n        return { filename: 'content-growth-calendar.json', text };\n      }\n      const { draft } = await readDraftDoc(input.id);\n      if (!draft) return { error: 'not_found' };\n      const text = serializeDoc({ format: DOC_FORMAT, version: 1, kind: 'draft', draft });\n      if (jsonBytes(text) > 12000) return { error: 'too_large' };\n      return { filename: `${draft.id.toLowerCase()}.json`, text };\n    }\n\n    if (contribution === 'document.import') {\n      let parsed;\n      try { parsed = JSON.parse(input.text); } catch { return { imported: false, reason: 'invalid_json' }; }\n      if (parsed?.format !== DOC_FORMAT || parsed?.version !== 1) {\n        return { imported: false, reason: 'invalid_document' };\n      }\n      if (parsed.kind === 'draft' && parsed.draft && typeof parsed.draft.title === 'string' && parsed.draft.title.trim()) {\n        const idx = await readDraftsIndex();\n        const newId = nextId('drf', idx.items.map(d => d.id));\n        const src = parsed.draft;\n        const primaryChannel = CHANNELS.includes(src.primary_channel) ? src.primary_channel : 'wechat';\n        const body = typeof src.body === 'string' ? src.body.slice(0, 6000) : '';\n        const variants = Array.isArray(src.variants)\n          ? src.variants\n              .filter(v => v && MODES.includes(v.mode) && typeof v.content === 'string')\n              .slice(0, 4)\n              .map(v => ({ mode: v.mode, content: v.content.slice(0, 2600), updated_at: todayStr() }))\n          : [];\n        const doc = {\n          schema_version: 1,\n          id: newId,\n          title: src.title.trim().slice(0, 120),\n          primary_channel: primaryChannel,\n          updated_at: todayStr(),\n          body,\n          variants,\n        };\n        const diag = diagnoseHeadline(doc.title, doc.body);\n        const w1 = await writeRecord(COL_DRAFTS, `doc:${newId}`, idx.revision, doc);\n        if (w1.status !== 'saved') return { imported: false, reason: w1.status };\n        const nextIdx = [makeDraftIndexEntry(doc, diag), ...idx.items];\n        if (nextIdx.length > MAX_DRAFTS) return { imported: false, reason: 'limit' };\n        const w2 = await writeRecord(COL_DRAFTS, KEY_DRAFTS_INDEX, w1.revision, { schema_version: 1, items: nextIdx });\n        return w2.status === 'saved' ? { imported: true, id: newId } : { imported: false, reason: w2.status };\n      }\n      if (parsed.kind === 'calendar_metrics' && Array.isArray(parsed.calendar)) {\n        const cal = await readCalendar();\n        const existingIds = new Set(cal.items.map(i => i.id));\n        const merged = [...cal.items];\n        for (const item of parsed.calendar) {\n          if (!item || typeof item.title !== 'string' || !item.title.trim()) continue;\n          const id = validId(item.id) && !existingIds.has(item.id) ? item.id : nextId('cnt', merged.map(x => x.id));\n          existingIds.add(id);\n          const channels = uniqueChannels(item.channels);\n          merged.push({\n            id,\n            title: item.title.trim().slice(0, 120),\n            stage: STAGES.includes(item.stage) ? item.stage : 'idea',\n            channels: channels.length ? channels : ['wechat'],\n            publish_date: validDate(item.publish_date) ? item.publish_date : todayStr(),\n            hook: typeof item.hook === 'string' ? item.hook.trim().slice(0, 240) : '',\n            viral_score: Number.isInteger(item.viral_score) ? Math.max(0, Math.min(100, item.viral_score)) : 75,\n            draft_id: typeof item.draft_id === 'string' ? item.draft_id.slice(0, 48) : '',\n            tags: Array.isArray(item.tags) ? item.tags.map(t => String(t).slice(0, 24)).slice(0, 5) : [],\n          });\n        }\n        if (merged.length > MAX_CALENDAR_ITEMS) return { imported: false, reason: 'limit' };\n        const w1 = await writeRecord(COL_CALENDAR, KEY_BOARD, cal.revision, { schema_version: 1, items: merged });\n        if (w1.status !== 'saved') return { imported: false, reason: w1.status };\n        if (Array.isArray(parsed.periods) && parsed.periods.length > 0) {\n          const validPeriods = parsed.periods.slice(0, MAX_PERIODS).filter(p => p && typeof p.period === 'string' && typeof p.label === 'string');\n          if (validPeriods.length > 0) {\n            const w2 = await writeRecord(COL_METRICS, KEY_METRICS, w1.revision, { schema_version: 1, periods: validPeriods });\n            if (w2.status !== 'saved') return { imported: false, reason: w2.status };\n          }\n        }\n        return { imported: true, id: 'CALENDAR' };\n      }\n      return { imported: false, reason: 'invalid_document' };\n    }\n  }\n\n  if (kind === 'tool') {\n    if (contribution === 'content.pipeline') {\n      const cal = await readCalendar();\n      const idx = await readDraftsIndex();\n      const met = await readMetrics();\n      const kw = (input.keyword || '').trim().toLowerCase();\n      const filtered = cal.items.filter(item => {\n        if (input.stage && item.stage !== input.stage) return false;\n        if (input.channel && !item.channels.includes(input.channel)) return false;\n        if (kw && !`${item.title} ${item.hook} ${(item.tags || []).join(' ')}`.toLowerCase().includes(kw)) return false;\n        return true;\n      });\n      const kpis = computeKpis(cal.items, idx.items, met.periods);\n      const channelTotals = computeChannelTotals(met.periods);\n      return {\n        success: true,\n        status: 'ready',\n        summary: {\n          total_published: kpis.total_published,\n          total_views: kpis.total_views,\n          avg_engagement_rate: kpis.avg_engagement_rate,\n          weekly_scheduled: kpis.weekly_scheduled,\n          total_items: cal.items.length,\n        },\n        items: filtered.slice(0, 20).map(({ id, title, stage, channels, publish_date, viral_score, draft_id }) => ({\n          id,\n          title,\n          stage,\n          channels,\n          publish_date,\n          viral_score,\n          draft_id,\n        })),\n        channel_totals: channelTotals,\n      };\n    }\n\n    if (contribution === 'content.draft.save') {\n      const title = (input.title || '').trim();\n      const body = (input.body || '').trim();\n      if (!title || !body || !CHANNELS.includes(input.primary_channel)) {\n        return { success: false, status: 'invalid_input' };\n      }\n      const idx = await readDraftsIndex();\n      const cal = await readCalendar();\n      const finalId = input.id && validId(input.id) ? input.id : nextId('drf', idx.items.map(d => d.id));\n      const existingDoc = idx.items.some(d => d.id === finalId) ? (await readDraftDoc(finalId)).draft : null;\n\n      const draftObj = {\n        schema_version: 1,\n        id: finalId,\n        title,\n        primary_channel: input.primary_channel,\n        updated_at: todayStr(),\n        body,\n        variants: existingDoc ? existingDoc.variants : [],\n      };\n      const diag = diagnoseHeadline(title, body);\n      const entry = makeDraftIndexEntry(draftObj, diag);\n      const nextIdx = existingDoc ? idx.items.map(d => (d.id === finalId ? entry : d)) : [entry, ...idx.items];\n      if (nextIdx.length > MAX_DRAFTS) return { success: false, status: 'limit' };\n\n      const w1 = await writeRecord(COL_DRAFTS, `doc:${finalId}`, cal.revision, draftObj);\n      if (w1.status !== 'saved') return { success: false, status: w1.status };\n      const w2 = await writeRecord(COL_DRAFTS, KEY_DRAFTS_INDEX, w1.revision, { schema_version: 1, items: nextIdx });\n      if (w2.status !== 'saved') return { success: false, status: w2.status };\n\n      // 同步排期看板\n      const stage = STAGES.includes(input.stage) ? input.stage : 'drafting';\n      const pubDate = validDate(input.publish_date) ? input.publish_date : todayStr();\n      const hook = (input.hook || body.slice(0, 100)).trim().slice(0, 240);\n      const existingCard = cal.items.find(c => c.draft_id === finalId);\n      let nextCal;\n      if (existingCard) {\n        nextCal = cal.items.map(c =>\n          c.id === existingCard.id\n            ? {\n                ...c,\n                title,\n                stage: input.stage ? stage : c.stage,\n                publish_date: input.publish_date ? pubDate : c.publish_date,\n                hook: input.hook ? hook : c.hook,\n                viral_score: diag.score,\n              }\n            : c,\n        );\n      } else {\n        const cardId = nextId('cnt', cal.items.map(c => c.id));\n        nextCal = [\n          {\n            id: cardId,\n            title,\n            stage,\n            channels: [input.primary_channel],\n            publish_date: pubDate,\n            hook,\n            viral_score: diag.score,\n            draft_id: finalId,\n            tags: ['AI协同'],\n          },\n          ...cal.items,\n        ];\n      }\n      if (nextCal.length <= MAX_CALENDAR_ITEMS) {\n        const w3 = await writeRecord(COL_CALENDAR, KEY_BOARD, w2.revision, { schema_version: 1, items: nextCal });\n        if (w3.status === 'saved') {\n          return {\n            success: true,\n            status: 'saved',\n            id: finalId,\n            headline_score: diag.score,\n            word_count: diag.word_count,\n            revision: w3.revision,\n          };\n        }\n      }\n      return {\n        success: true,\n        status: 'saved',\n        id: finalId,\n        headline_score: diag.score,\n        word_count: diag.word_count,\n        revision: w2.revision,\n      };\n    }\n  }\n\n  throw new Error(`不支持的调用: ${kind}/${contribution}`);\n}\n","path":"backend/index.js"},{"content":"<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n <meta charset=\"utf-8\">\n <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n <title>全渠道内容工厂与增长运营台</title>\n <style>\n:root{color-scheme:light dark;--bg:#f4f6fb;--elev:#ffffff;--sub:#eef1f8;--hov:#e6ebf7;--fg:#0f172a;--fg2:#475569;--muted:#64748b;--bd:#dde3f0;--bd2:#c7d1e6;--ac:#4f46e5;--ac-s:rgba(79,70,229,0.12);--ac-2:#0ea5e9;--ok:#10b981;--ok-soft:rgba(16,185,129,0.14);--warn:#f59e0b;--warn-soft:rgba(245,158,11,0.15);--danger:#ef4444;--danger-soft:rgba(239,68,68,0.13);--shadow:0 1px 2px rgba(15,23,42,0.05),0 6px 20px rgba(15,23,42,0.04);--ch-wechat:#07c160;--ch-xhs:#ff2442;--ch-zhihu:#0066ff;--ch-x:#1e293b;--ch-yt:#ef4444;--ch-bili:#fb7299;font:13.5px/1.55 -apple-system,BlinkMacSystemFont,\"Segoe UI\",\"PingFang SC\",\"Hiragino Sans GB\",sans-serif}:root[data-theme=\"dark\"]{color-scheme:dark;--bg:#0b0f19;--elev:#111827;--sub:#182235;--hov:#212f47;--fg:#f1f5f9;--fg2:#cbd5e1;--muted:#8b9bb4;--bd:#233049;--bd2:#334566;--ac:#6366f1;--ac-s:rgba(99,102,241,0.2);--ac-2:#38bdf8;--ok:#34d399;--ok-soft:rgba(52,211,153,0.16);--warn:#fbbf24;--warn-soft:rgba(251,191,36,0.16);--danger:#f87171;--danger-soft:rgba(248,113,113,0.16);--shadow:0 2px 6px rgba(0,0,0,0.35),0 10px 28px rgba(0,0,0,0.28);--ch-x:#e2e8f0}*{box-sizing:border-box}html,body{height:100%;margin:0;background:var(--bg);color:var(--fg)}button,input,select,textarea{font:inherit;color:inherit}[hidden]{display:none !important}.app-shell{display:grid;grid-template-columns:224px minmax(0,1fr);min-height:100vh}@media (max-width:820px){.app-shell{grid-template-columns:1fr}.sidebar{position:static !important;height:auto !important;border-right:none !important;border-bottom:1px solid var(--bd)}}.sidebar{position:sticky;top:0;height:100vh;background:var(--elev);border-right:1px solid var(--bd);padding:16px 12px;display:flex;flex-direction:column;gap:14px;overflow-y:auto}.brand{display:flex;align-items:center;gap:10px;padding:4px 6px}.brand-logo{width:34px;height:34px;border-radius:10px;background:linear-gradient(135deg,var(--ac),#06b6d4);display:grid;place-items:center;color:#fff;font-weight:800;flex-shrink:0;box-shadow:0 4px 12px rgba(79,70,229,0.3)}.brand-title{font-size:14px;font-weight:700;letter-spacing:-0.01em;line-height:1.25}.brand-sub{font-size:11px;color:var(--muted)}.nav-list{display:flex;flex-direction:column;gap:4px}.nav-btn{display:flex;align-items:center;gap:10px;width:100%;padding:9px 11px;border-radius:9px;border:1px solid transparent;background:transparent;color:var(--fg2);cursor:pointer;text-align:left;font-weight:500;transition:background 0.14s ease,color 0.14s ease,border-color 0.14s ease}.nav-btn:hover{background:var(--sub);color:var(--fg)}.nav-btn.active{background:var(--ac-s);color:var(--ac);border-color:color-mix(in srgb,var(--ac) 28%,transparent);font-weight:600}.nav-badge{margin-left:auto;font-size:11px;padding:1px 7px;border-radius:99px;background:var(--sub);color:var(--muted);font-weight:600}.nav-btn.active .nav-badge{background:var(--ac);color:#fff}.sidebar-section{margin-top:auto;padding-top:12px;border-top:1px solid var(--bd);display:flex;flex-direction:column;gap:7px}.sidebar-meta{font-size:11.5px;color:var(--muted);padding:8px 10px;border-radius:8px;background:var(--sub);display:flex;justify-content:space-between;align-items:center}.main-area{display:flex;flex-direction:column;min-width:0;padding:16px 20px 26px;gap:16px}.topbar{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px}.topbar h1{margin:0;font-size:18px;font-weight:700;letter-spacing:-0.02em}.status-pill{font-size:12px;color:var(--muted);padding:4px 10px;border-radius:99px;background:var(--elev);border:1px solid var(--bd);max-width:420px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.status-pill[data-tone=\"ok\"]{color:var(--ok);border-color:color-mix(in srgb,var(--ok) 40%,transparent)}.status-pill[data-tone=\"error\"]{color:var(--danger);border-color:color-mix(in srgb,var(--danger) 40%,transparent)}.kpi-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}@media (max-width:960px){.kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}.kpi-card{background:var(--elev);border:1px solid var(--bd);border-radius:12px;padding:13px 15px;box-shadow:var(--shadow);display:flex;flex-direction:column;gap:4px;position:relative;overflow:hidden}.kpi-card::after{content:\"\";position:absolute;inset:0 0 auto 0;height:2.5px;background:var(--kpi-accent,var(--ac));opacity:0.85}.kpi-label{font-size:12px;color:var(--muted);display:flex;justify-content:space-between;align-items:center}.kpi-value{font-size:24px;font-weight:800;letter-spacing:-0.03em;line-height:1.2}.kpi-sub{font-size:11.5px;color:var(--muted)}.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:6px 12px;border-radius:8px;border:1px solid var(--bd);background:var(--elev);color:var(--fg);cursor:pointer;font-weight:500;font-size:13px;transition:background 0.14s,border-color 0.14s,transform 0.08s;white-space:nowrap}.btn:hover:not(:disabled){background:var(--sub);border-color:var(--bd2)}.btn:active:not(:disabled){transform:translateY(1px)}.btn:disabled{opacity:0.5;cursor:not-allowed}.btn-primary{background:var(--ac);border-color:var(--ac);color:#fff}.btn-primary:hover:not(:disabled){background:color-mix(in srgb,var(--ac) 88%,#000);border-color:var(--ac)}.btn-ok{background:var(--ok);border-color:var(--ok);color:#fff}.btn-ok:hover:not(:disabled){background:color-mix(in srgb,var(--ok) 88%,#000)}.btn-danger{color:var(--danger);border-color:color-mix(in srgb,var(--danger) 35%,var(--bd))}.btn-danger:hover:not(:disabled){background:var(--danger-soft)}.btn-sm{padding:4px 9px;font-size:12px;border-radius:7px}.btn-full{width:100%;justify-content:flex-start}.input,.select,.textarea{width:100%;padding:7px 10px;border-radius:8px;border:1px solid var(--bd);background:var(--bg);color:var(--fg);outline:none;transition:border-color 0.14s,box-shadow 0.14s}.input:focus,.select:focus,.textarea:focus{border-color:var(--ac);box-shadow:0 0 0 3px var(--ac-s)}.textarea{resize:vertical;min-height:110px;line-height:1.65}.field{display:flex;flex-direction:column;gap:5px}.field-label{font-size:12px;font-weight:600;color:var(--fg2);display:flex;justify-content:space-between}.card{background:var(--elev);border:1px solid var(--bd);border-radius:13px;padding:15px 16px;box-shadow:var(--shadow);display:flex;flex-direction:column;gap:12px;min-width:0}.card-head{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px}.card-title{margin:0;font-size:14.5px;font-weight:700;display:flex;align-items:center;gap:7px}.card-sub{font-size:12px;color:var(--muted)}.dash-charts{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(0,1fr);gap:14px}@media (max-width:1060px){.dash-charts{grid-template-columns:1fr}}.svg-box{width:100%;position:relative}.svg-box svg{width:100%;height:auto;display:block;overflow:visible}.chart-tooltip{position:absolute;pointer-events:none;background:var(--elev);border:1px solid var(--bd2);border-radius:9px;padding:8px 10px;font-size:12px;box-shadow:0 10px 25px rgba(0,0,0,0.22);z-index:10;min-width:150px}.tag{display:inline-flex;align-items:center;gap:4px;font-size:11px;font-weight:600;padding:2px 7px;border-radius:6px;background:var(--sub);color:var(--fg2);border:1px solid var(--bd)}.ch-pill{display:inline-flex;align-items:center;gap:4px;font-size:11px;font-weight:600;padding:2px 7px;border-radius:99px;background:color-mix(in srgb,var(--c) 14%,transparent);color:var(--c)}.ch-dot{width:6px;height:6px;border-radius:99px;background:currentColor}.score-pill{font-size:11.5px;font-weight:700;padding:2px 8px;border-radius:99px}.score-s{background:var(--ok-soft);color:var(--ok)}.score-a{background:var(--ac-s);color:var(--ac)}.score-b{background:var(--warn-soft);color:var(--warn)}.score-c{background:var(--danger-soft);color:var(--danger)}.toolbar{display:flex;flex-wrap:wrap;align-items:center;gap:8px;justify-content:space-between}.row{display:flex;flex-wrap:wrap;align-items:center;gap:8px}.kanban-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;align-items:start}@media (max-width:1120px){.kanban-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media (max-width:640px){.kanban-grid{grid-template-columns:1fr}}.kanban-col{background:var(--sub);border:1px solid var(--bd);border-radius:12px;padding:10px;display:flex;flex-direction:column;gap:9px;min-height:280px}.kanban-col-head{display:flex;align-items:center;justify-content:space-between;padding:2px 4px;font-weight:700;font-size:13px}.stage-dot{width:8px;height:8px;border-radius:99px;display:inline-block;margin-right:6px}.k-card{background:var(--elev);border:1px solid var(--bd);border-radius:10px;padding:11px;display:flex;flex-direction:column;gap:7px;box-shadow:0 1px 3px rgba(15,23,42,0.04);transition:border-color 0.14s,transform 0.12s}.k-card:hover{border-color:var(--ac);transform:translateY(-1px)}.k-title{font-weight:600;font-size:13px;line-height:1.4}.k-hook{font-size:12px;color:var(--muted);line-height:1.45;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.k-foot{display:flex;align-items:center;justify-content:space-between;gap:6px;padding-top:6px;border-top:1px dashed var(--bd)}.editor-grid{display:grid;grid-template-columns:220px minmax(0,1fr) 280px;gap:13px;align-items:start}@media (max-width:1140px){.editor-grid{grid-template-columns:200px minmax(0,1fr)}}@media (max-width:780px){.editor-grid{grid-template-columns:1fr}}.draft-list{display:flex;flex-direction:column;gap:6px;max-height:540px;overflow-y:auto}.draft-item{width:100%;text-align:left;padding:9px 10px;border-radius:9px;border:1px solid var(--bd);background:var(--bg);cursor:pointer;display:flex;flex-direction:column;gap:4px}.draft-item:hover{border-color:var(--bd2);background:var(--sub)}.draft-item.active{border-color:var(--ac);background:var(--ac-s)}.draft-item-title{font-weight:600;font-size:12.5px;line-height:1.35;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.draft-item-meta{font-size:11px;color:var(--muted);display:flex;justify-content:space-between}.diag-gauge-wrap{display:flex;align-items:center;gap:14px}.dim-bar-list{display:flex;flex-direction:column;gap:8px}.dim-row{display:flex;flex-direction:column;gap:3px;font-size:12px}.dim-head{display:flex;justify-content:space-between;color:var(--fg2)}.bar-track{height:6px;border-radius:99px;background:var(--sub);overflow:hidden}.bar-fill{height:100%;border-radius:99px;background:linear-gradient(90deg,var(--ac),var(--ac-2));transition:width 0.25s ease}.sugg-list{margin:0;padding-left:16px;display:flex;flex-direction:column;gap:5px;font-size:12px;color:var(--fg2)}.mode-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}@media (max-width:980px){.mode-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}.mode-card{text-align:left;padding:12px;border-radius:11px;border:1.5px solid var(--bd);background:var(--bg);cursor:pointer;display:flex;flex-direction:column;gap:5px;transition:border-color 0.14s,background 0.14s}.mode-card:hover{border-color:var(--bd2)}.mode-card.active{border-color:var(--ac);background:var(--ac-s)}.mode-card-title{font-weight:700;font-size:13px;display:flex;align-items:center;justify-content:space-between}.mode-card-desc{font-size:11.5px;color:var(--muted);line-height:1.4}.ai-preview-box{padding:12px;border-radius:10px;border:1px solid var(--bd);background:var(--bg);white-space:pre-wrap;word-break:break-word;max-height:300px;overflow-y:auto;font-size:13px;line-height:1.65}.tab-bar{display:flex;flex-wrap:wrap;gap:6px;border-bottom:1px solid var(--bd);padding-bottom:8px}.tab-pill{padding:5px 11px;border-radius:8px;border:1px solid var(--bd);background:var(--bg);cursor:pointer;font-size:12px;font-weight:600}.tab-pill.active{background:var(--ac);color:#fff;border-color:var(--ac)}.modal-backdrop{position:fixed;inset:0;background:rgba(2,6,23,0.58);display:grid;place-items:center;padding:16px;z-index:50}.modal{width:min(560px,100%);max-height:90vh;overflow-y:auto;background:var(--elev);border:1px solid var(--bd2);border-radius:14px;padding:18px;box-shadow:0 24px 60px rgba(0,0,0,0.35);display:flex;flex-direction:column;gap:12px}.check-group{display:flex;flex-wrap:wrap;gap:7px}.check-chip{display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:99px;border:1px solid var(--bd);background:var(--bg);cursor:pointer;font-size:12px;user-select:none}.check-chip input{margin:0}.empty-state{padding:28px 16px;text-align:center;color:var(--muted);border:1px dashed var(--bd2);border-radius:11px;display:flex;flex-direction:column;align-items:center;gap:10px}.mini-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}@media (max-width:860px){.mini-grid{grid-template-columns:1fr}}.upcoming-item{padding:11px 12px;border-radius:10px;border:1px solid var(--bd);background:var(--bg);display:flex;flex-direction:column;gap:6px;cursor:pointer}.upcoming-item:hover{border-color:var(--ac)}\n.col{display:flex;flex-direction:column;gap:13px}.jb{justify-content:space-between}.f1{flex:1}.mf{flex:1;min-width:105px}</style></head><body><div class=\"app-shell\"><aside class=\"sidebar\"><div class=\"brand\"><div class=\"brand-logo\" aria-hidden=\"true\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" ><path d=\"M12 20V10\"/><path d=\"M18 20V4\"/><path d=\"M6 20v-4\"/></svg></div><div><div class=\"brand-title\">Content Growth OS</div><div class=\"brand-sub\">全渠道内容工厂与增长台</div></div></div><nav class=\"nav-list\" aria-label=\"主导航\"><button class=\"nav-btn active\" data-view=\"dashboard\" type=\"button\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"9\" rx=\"1.5\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"5\" rx=\"1.5\"/><rect x=\"14\" y=\"12\" width=\"7\" height=\"9\" rx=\"1.5\"/><rect x=\"3\" y=\"16\" width=\"7\" height=\"5\" rx=\"1.5\"/></svg>\n增长驾驶舱\n<span class=\"nav-badge\" id=\"nb-periods\">0期</span></button><button class=\"nav-btn\" data-view=\"pipeline\" type=\"button\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"/><line x1=\"9\" y1=\"4\" x2=\"9\" y2=\"20\"/><line x1=\"15\" y1=\"4\" x2=\"15\" y2=\"20\"/></svg>\n选题与排期看板\n<span class=\"nav-badge\" id=\"nb-calendar\">0</span></button><button class=\"nav-btn\" data-view=\"editor\" type=\"button\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 20h9\"/><path d=\"M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z\"/></svg>\n文稿与标题诊断\n<span class=\"nav-badge\" id=\"nb-drafts\">0</span></button><button class=\"nav-btn\" data-view=\"repurpose\" type=\"button\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"/></svg>\nAI 一稿多改矩阵\n<span class=\"nav-badge\" id=\"nb-variants\">AI</span></button></nav><div class=\"sidebar-section\"><div class=\"sidebar-meta\"><span>账号级持久化</span><strong id=\"rev-label\">Rev #0</strong></div><button id=\"btn-seed\" class=\"btn btn-primary btn-full btn-sm\" type=\"button\">✦ 装载 AI IP 演示数据</button><button id=\"btn-io\" class=\"btn btn-full btn-sm\" type=\"button\">⇅ 导入 / 导出 JSON</button><button id=\"btn-theme\" class=\"btn btn-full btn-sm\" type=\"button\">◐ 切换浅色 / 深色</button></div></aside><main class=\"main-area\"><header class=\"topbar\"><div><h1 id=\"view-title\">增长驾驶舱</h1></div><div class=\"row\"><span id=\"status\" class=\"status-pill\" role=\"status\">正在连接内容中台…</span><button id=\"btn-refresh\" class=\"btn btn-sm\" type=\"button\">刷新</button></div></header><section class=\"kpi-grid\" aria-label=\"核心增长指标\"><div class=\"kpi-card\" style=\"--kpi-accent:#4f46e5\"><div class=\"kpi-label\"><span>总发布量</span><span>Published</span></div><div class=\"kpi-value\" id=\"kpi-published\">0</div><div class=\"kpi-sub\" id=\"kpi-drafts-sub\">主稿库 0 篇</div></div><div class=\"kpi-card\" style=\"--kpi-accent:#0ea5e9\"><div class=\"kpi-label\"><span>累计阅读 / 曝光</span><span>Views</span></div><div class=\"kpi-value\" id=\"kpi-views\">0</div><div class=\"kpi-sub\" id=\"kpi-top-ch\">Top 渠道待统计</div></div><div class=\"kpi-card\" style=\"--kpi-accent:#10b981\"><div class=\"kpi-label\"><span>平均互动率</span><span>Engagement</span></div><div class=\"kpi-value\" id=\"kpi-eng\">0.0%</div><div class=\"kpi-sub\">点赞 + 评论 + 收藏 / 曝光</div></div><div class=\"kpi-card\" style=\"--kpi-accent:#f59e0b\"><div class=\"kpi-label\"><span>本周待发排期</span><span>Scheduled</span></div><div class=\"kpi-value\" id=\"kpi-scheduled\">0</div><div class=\"kpi-sub\" id=\"kpi-idea-sub\">灵感/撰写中 0 篇</div></div></section><section id=\"view-dashboard\" class=\"view-pane\" class=\"col\"><div id=\"dash-empty\" class=\"empty-state\" hidden><div style=\"font-weight:700;font-size:15px;color:var(--fg)\">内容增长中台尚未录入数据</div><div style=\"max-width:440px;font-size:12.5px\">一键装载内置「AI 开发者 IP 内容矩阵」演示数据（含 6 篇全渠道排期、3 篇核心主稿及衍生稿、6 期双轴复盘趋势），立即体验完整工作流。</div><button id=\"btn-seed-hero\" class=\"btn btn-primary\" type=\"button\">✦ 一键装载演示数据</button></div><div class=\"dash-charts\"><article class=\"card\"><div class=\"card-head\"><div><h2 class=\"card-title\">多平台阅读与互动双轴趋势</h2><div class=\"card-sub\">柱状/面积展示单期全网曝光（左轴），折线追踪平均互动率（右轴）</div></div><div class=\"row\" style=\"font-size:11.5px;color:var(--muted)\"><span><span class=\"stage-dot\" style=\"background:#4f46e5\"></span>阅读/曝光</span><span><span class=\"stage-dot\" style=\"background:#10b981\"></span>互动率 %</span></div></div><div class=\"svg-box\" id=\"trend-chart-wrap\"><div id=\"trend-svg\"></div><div id=\"trend-tip\" class=\"chart-tooltip\" hidden></div></div></article><article class=\"card\"><div class=\"card-head\"><div><h2 class=\"card-title\">六大渠道流量占比</h2><div class=\"card-sub\">公众号 / 小红书 / 知乎 / X / YouTube / B站</div></div><button id=\"btn-toggle-metric-form\" class=\"btn btn-sm\" type=\"button\">+ 录入复盘</button></div><div class=\"svg-box\" id=\"channel-svg\"></div></article></div><article id=\"metric-form-card\" class=\"card\" hidden><div class=\"card-head\"><h2 class=\"card-title\">录入 / 更新周期复盘指标</h2><button id=\"btn-close-metric-form\" class=\"btn btn-sm\" type=\"button\">收起</button></div><div class=\"row\"><label class=\"field\" style=\"width:110px\"><span class=\"field-label\">期号</span><input id=\"m-period\" class=\"input\" placeholder=\"W48\" maxlength=\"16\"></label><label class=\"field\" style=\"width:110px\"><span class=\"field-label\">日期标签</span><input id=\"m-label\" class=\"input\" placeholder=\"11/25\" maxlength=\"24\"></label><label class=\"field\" style=\"width:110px\"><span class=\"field-label\">本期发布数</span><input id=\"m-pub\" class=\"input\" type=\"number\" min=\"0\" value=\"4\"></label><label class=\"field\" style=\"width:130px\"><span class=\"field-label\">总互动数</span><input id=\"m-eng\" class=\"input\" type=\"number\" min=\"0\" value=\"4200\"></label></div><div class=\"row\"><label class=\"field mf\"><span class=\"field-label\">公众号</span><input id=\"m-ch-wechat\" class=\"input\" type=\"number\" min=\"0\" value=\"12000\"></label><label class=\"field mf\"><span class=\"field-label\">小红书</span><input id=\"m-ch-xiaohongshu\" class=\"input\" type=\"number\" min=\"0\" value=\"14500\"></label><label class=\"field mf\"><span class=\"field-label\">知乎</span><input id=\"m-ch-zhihu\" class=\"input\" type=\"number\" min=\"0\" value=\"8100\"></label><label class=\"field mf\"><span class=\"field-label\">X</span><input id=\"m-ch-x\" class=\"input\" type=\"number\" min=\"0\" value=\"6800\"></label><label class=\"field mf\"><span class=\"field-label\">YouTube</span><input id=\"m-ch-youtube\" class=\"input\" type=\"number\" min=\"0\" value=\"3900\"></label><label class=\"field mf\"><span class=\"field-label\">B站</span><input id=\"m-ch-bilibili\" class=\"input\" type=\"number\" min=\"0\" value=\"4900\"></label></div><div class=\"row\" style=\"justify-content:flex-end\"><button id=\"btn-save-metric\" class=\"btn btn-primary btn-sm\" type=\"button\">保存周期数据</button></div></article><article class=\"card\"><div class=\"card-head\"><h2 class=\"card-title\">高潜力待排期 / 撰写中焦点内容</h2><button id=\"btn-go-pipeline\" class=\"btn btn-sm\" type=\"button\">查看全部排期 →</button></div><div id=\"dash-upcoming\" class=\"mini-grid\"></div></article></section><section id=\"view-pipeline\" class=\"view-pane\" hidden class=\"col\"><div class=\"card\" style=\"padding:12px 14px;\"><div class=\"toolbar\"><div class=\"row\"><input id=\"pipe-search\" class=\"input\" style=\"width:220px\" placeholder=\"搜索选题标题、钩子或标签…\"><select id=\"pipe-channel\" class=\"select\" style=\"width:140px\"><option value=\"\">全部渠道</option><option value=\"wechat\">公众号</option><option value=\"xiaohongshu\">小红书</option><option value=\"zhihu\">知乎</option><option value=\"x\">X (Twitter)</option><option value=\"youtube\">YouTube</option><option value=\"bilibili\">B站</option></select></div><button id=\"btn-new-card\" class=\"btn btn-primary\" type=\"button\">+ 新建选题卡片</button></div></div><div class=\"kanban-grid\" id=\"kanban-board\"></div></section><section id=\"view-editor\" class=\"view-pane\" hidden><div class=\"editor-grid\"><article class=\"card\" style=\"padding:12px\"><div class=\"card-head\"><h2 class=\"card-title\">主稿库</h2><button id=\"btn-new-draft\" class=\"btn btn-primary btn-sm\" type=\"button\">+ 新建</button></div><div id=\"draft-list\" class=\"draft-list\"></div></article><article class=\"card\"><div class=\"card-head\"><div><h2 class=\"card-title\" id=\"editor-heading\">撰写主稿</h2><div class=\"card-sub\" id=\"editor-stats\">0 字 · 预计阅读 0 分钟 · 0 段</div></div><div class=\"row\"><button id=\"btn-editor-repurpose\" class=\"btn btn-sm\" type=\"button\">⚡ 去一稿多改</button><button id=\"btn-editor-insert\" class=\"btn btn-sm\" type=\"button\" hidden>回填输入框</button><button id=\"btn-save-draft\" class=\"btn btn-primary btn-sm\" type=\"button\">保存主稿</button><button id=\"btn-del-draft\" class=\"btn btn-danger btn-sm\" type=\"button\" hidden>删除</button></div></div><div class=\"row\"><label class=\"field\" style=\"flex:1;min-width:220px\"><span class=\"field-label\"><span>主标题（实时诊断）</span><span id=\"title-len-hint\">0 字</span></span><input id=\"ed-title\" class=\"input\" maxlength=\"120\" placeholder=\"输入有数字锚点与收益钩子的爆款标题…\"></label><label class=\"field\" style=\"width:140px\"><span class=\"field-label\">首发主渠道</span><select id=\"ed-channel\" class=\"select\"><option value=\"wechat\">公众号</option><option value=\"xiaohongshu\">小红书</option><option value=\"zhihu\">知乎</option><option value=\"x\">X (Twitter)</option><option value=\"youtube\">YouTube</option><option value=\"bilibili\">B站</option></select></label></div><label class=\"field\"><span class=\"field-label\"><span>正文内容（支持 Markdown 层级分段）</span><span id=\"ed-variants-badge\" class=\"tag\">已存 0 份衍生稿</span></span><textarea id=\"ed-body\" class=\"textarea\" style=\"min-height:360px\" maxlength=\"6000\" placeholder=\"写下你的核心观点、实战数据、## 二级小标题与清单要点…\"></textarea></label></article><article class=\"card\"><div class=\"card-head\"><h2 class=\"card-title\">实时标题诊断仪</h2><span id=\"diag-grade\" class=\"score-pill score-a\">A 级</span></div><div class=\"diag-gauge-wrap\"><div id=\"diag-gauge\" style=\"width:86px;height:86px;flex-shrink:0\"></div><div style=\"display:flex;flex-direction:column;gap:5px;min-width:0\"><div style=\"font-size:12px;color:var(--muted)\">综合爆款潜力分</div><div id=\"diag-highlights\" class=\"row\" style=\"gap:4px\"></div></div></div><div class=\"dim-bar-list\" id=\"diag-dims\"></div><div><div class=\"field-label\" style=\"margin-bottom:6px\">优化建议</div><ul class=\"sugg-list\" id=\"diag-suggs\"></ul></div></article></div></section><section id=\"view-repurpose\" class=\"view-pane\" hidden class=\"col\"><article class=\"card\"><div class=\"card-head\"><div><h2 class=\"card-title\">AI 一稿多改矩阵（深度联动当前 Velai 会话）</h2><div class=\"card-sub\">选择主稿与目标平台改写模式，通过 session.turn.request 派发给当前会话，核对后一键采纳为衍生稿或回填输入框</div></div><select id=\"rep-draft-select\" class=\"select\" style=\"width:280px\"></select></div><div class=\"mode-grid\" id=\"mode-grid\"><button class=\"mode-card active\" data-mode=\"xiaohongshu\" type=\"button\"><div class=\"mode-card-title\"><span>小红书种草图文</span><span class=\"ch-pill\" style=\"--c:var(--ch-xhs)\">图文</span></div><div class=\"mode-card-desc\">强情绪首行钩子 + Emoji 清单分段 + 评论区互动提问 + 5 个精准标签</div></button><button class=\"mode-card\" data-mode=\"x_thread\" type=\"button\"><div class=\"mode-card-title\"><span>X 爆款 Thread 串推</span><span class=\"ch-pill\" style=\"--c:var(--ch-x)\">串推</span></div><div class=\"mode-card-desc\">1/N 强反差开篇 + 6~8 条节奏短推 + 金句提炼 + 结尾转赞 CTA</div></button><button class=\"mode-card\" data-mode=\"zhihu\" type=\"button\"><div class=\"mode-card-title\"><span>知乎高赞深度回答</span><span class=\"ch-pill\" style=\"--c:var(--ch-zhihu)\">长答</span></div><div class=\"mode-card-desc\">反常识破题 + 体系化分点论据 + 工程案例数据 + 冷静专业收束</div></button><button class=\"mode-card\" data-mode=\"short_video\" type=\"button\"><div class=\"mode-card-title\"><span>短视频 60 秒口播</span><span class=\"ch-pill\" style=\"--c:var(--ch-bili)\">口播</span></div><div class=\"mode-card-desc\">0-3 秒黄金完播钩子 + 分镜与字幕节奏标注 + 自然口语化停顿 + 结尾关注引导</div></button></div><div class=\"row\"><input id=\"rep-extra\" class=\"input\" style=\"flex:1;min-width:240px\" maxlength=\"160\" placeholder=\"可选补充要求（如：语气更犀利、面向独立开发者、控制在 500 字内…）\"><button id=\"btn-dispatch-ai\" class=\"btn btn-primary\" type=\"button\">⚡ 派发给当前会话改写</button><button id=\"btn-check-ai\" class=\"btn\" type=\"button\" hidden>核对改写结果</button></div><div id=\"ai-work-panel\" style=\"display:flex;flex-direction:column;gap:8px;padding-top:8px;border-top:1px dashed var(--bd)\" hidden><div class=\"row jb\"><span id=\"ai-work-state\" style=\"font-size:12.5px;color:var(--fg2);font-weight:500\"></span><div class=\"row\"><button id=\"btn-adopt-variant\" class=\"btn btn-ok btn-sm\" type=\"button\" hidden>✓ 采纳为该渠道衍生稿</button><button id=\"btn-insert-ai\" class=\"btn btn-sm\" type=\"button\" hidden>回填会话输入框</button></div></div><div id=\"ai-work-preview\" class=\"ai-preview-box\" hidden></div></div></article><article class=\"card\"><div class=\"card-head\"><div><h2 class=\"card-title\">已保存的多渠道衍生稿库</h2><div class=\"card-sub\" id=\"rep-draft-meta\">选择主稿以管理其各渠道改写版本</div></div><div class=\"row\"><button id=\"btn-variant-insert\" class=\"btn btn-sm\" type=\"button\" hidden>回填输入框</button><button id=\"btn-variant-copy\" class=\"btn btn-sm\" type=\"button\">复制文本</button><button id=\"btn-variant-manual-save\" class=\"btn btn-primary btn-sm\" type=\"button\">保存当前修改</button></div></div><div class=\"tab-bar\" id=\"variant-tabs\"></div><textarea id=\"variant-editor\" class=\"textarea\" style=\"min-height:220px\" maxlength=\"2600\" placeholder=\"该渠道暂无衍生稿：可点击上方「派发给当前会话改写」生成，或直接在此手写并保存…\"></textarea></article></section></main></div><div id=\"card-modal\" class=\"modal-backdrop\" hidden><div class=\"modal\" role=\"dialog\" aria-modal=\"true\" aria-label=\"编辑选题排期卡片\"><div class=\"card-head\"><h2 class=\"card-title\" id=\"cm-heading\">新建选题卡片</h2><button id=\"cm-close\" class=\"btn btn-sm\" type=\"button\">✕</button></div><label class=\"field\"><span class=\"field-label\">选题标题</span><input id=\"cm-title\" class=\"input\" maxlength=\"120\" placeholder=\"例如：为什么 90% 的 AI Agent 插件都死在沙箱安全？\"></label><div class=\"row\"><label class=\"field f1\"><span class=\"field-label\">当前阶段</span><select id=\"cm-stage\" class=\"select\"><option value=\"idea\">灵感池 (idea)</option><option value=\"drafting\">撰写中 (drafting)</option><option value=\"scheduled\">待排期 (scheduled)</option><option value=\"published\">已发布 (published)</option></select></label><label class=\"field f1\"><span class=\"field-label\">目标发布日期</span><input id=\"cm-date\" class=\"input\" type=\"date\"></label><label class=\"field\" style=\"width:110px\"><span class=\"field-label\">潜力分 (0-100)</span><input id=\"cm-score\" class=\"input\" type=\"number\" min=\"0\" max=\"100\" placeholder=\"自动\"></label></div><div class=\"field\"><span class=\"field-label\">分发目标渠道（至少选 1 个）</span><div class=\"check-group\" id=\"cm-channels\"></div></div><label class=\"field\"><span class=\"field-label\">核心钩子 / 卖点摘要</span><textarea id=\"cm-hook\" class=\"textarea\" style=\"min-height:70px\" maxlength=\"240\" placeholder=\"一句话说明这篇内容为什么值得读者点击与收藏…\"></textarea></label><div class=\"row\"><label class=\"field f1\"><span class=\"field-label\">关联主稿</span><select id=\"cm-draft\" class=\"select\"></select></label><label class=\"field f1\"><span class=\"field-label\">标签（逗号分隔）</span><input id=\"cm-tags\" class=\"input\" placeholder=\"AI架构, 实战, 复盘\"></label></div><div class=\"row\" style=\"justify-content:space-between;padding-top:6px\"><button id=\"cm-delete\" class=\"btn btn-danger btn-sm\" type=\"button\" hidden>删除此选题</button><div class=\"row\" style=\"margin-left:auto\"><button id=\"cm-cancel\" class=\"btn btn-sm\" type=\"button\">取消</button><button id=\"cm-save\" class=\"btn btn-primary btn-sm\" type=\"button\">保存选题</button></div></div></div></div><div id=\"io-modal\" class=\"modal-backdrop\" hidden><div class=\"modal\" role=\"dialog\" aria-modal=\"true\" aria-label=\"数据导入与导出\"><div class=\"card-head\"><h2 class=\"card-title\">文档导入 / 导出 (JSON)</h2><button id=\"io-close\" class=\"btn btn-sm\" type=\"button\">✕</button></div><div class=\"row\"><select id=\"io-select\" class=\"select\" style=\"flex:1\"></select><button id=\"io-export\" class=\"btn btn-sm\" type=\"button\">导出 JSON</button><button id=\"io-copy\" class=\"btn btn-sm\" type=\"button\">复制</button></div><textarea id=\"io-text\" class=\"textarea\" style=\"min-height:200px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px\" placeholder=\"点击「导出 JSON」查看内容，或粘贴有效 JSON 后点击「导入」…\"></textarea><div class=\"row jb\"><span id=\"io-msg\" style=\"font-size:12px;color:var(--muted)\">支持单篇主稿及全渠道排期包</span><button id=\"io-import\" class=\"btn btn-primary btn-sm\" type=\"button\">导入 JSON</button></div></div></div><script>\n(() => { const plugin = globalThis.nmasPlugin; const $ = id => document.getElementById(id); const qa = (q, r = document) => r.querySelectorAll(q); const CHANNEL_META = {\nwechat: { label: '公众号', color: '#07c160' }, xiaohongshu: { label: '小红书', color: '#ff2442' }, zhihu: { label: '知乎', color: '#0066ff' },\nx: { label: 'X', color: '#64748b' }, youtube: { label: 'YouTube', color: '#ef4444' }, bilibili: { label: 'B站', color: '#fb7299' }, }; const STAGE_META = { idea: { label: '灵感池', color: '#8b5cf6' }, drafting: { label: '撰写中', color: '#3b82f6' },\nscheduled: { label: '待排期', color: '#f59e0b' }, published: { label: '已发布', color: '#10b981' }, }; const STAGE_ORDER = ['idea', 'drafting', 'scheduled', 'published']; const MODE_META = { xiaohongshu: { label: '小红书种草图文',\nprompt: '改写为小红书爆款种草图文：1) 吸睛 Emoji 首行钩子；2) 短句分段 + 编号干货清单；3) 真实口语感；4) 结尾抛互动提问 + 5 个热门标签。', }, x_thread: { label: 'X 爆款 Thread 串推',\nprompt: '改写为 X (Twitter) 爆款 Thread 串推（6-8 条，以 1/ 2/ 编号）：1) 首推制造强烈好奇与反差；2) 每条聚焦 1 个洞察且短促有力；3) 结尾含总结与收藏转发 CTA。', }, zhihu: { label: '知乎高赞深度回答',\nprompt: '改写为知乎高赞专业回答：1) 反常识或直击痛点的开头；2) 用清晰一二三框架与数据案例展开；3) 保持克制硬核的专业基调，结尾给出可落地的行动建议。', }, short_video: { label: '短视频 60 秒口播',\nprompt: '改写为 60 秒短视频口播脚本（标注【0-3秒黄金钩子】【4-25秒痛点拆解】【26-48秒核心方法】【49-60秒结尾CTA】），口语化短句、标注镜头/字幕提示。', }, }; const state = { view: 'dashboard', revision: 0,\ncanInsert: false, busy: false, kpis: { total_published: 0, total_views: 0, avg_engagement_rate: 0, weekly_scheduled: 0, total_drafts: 0 },\ncalendar: [], drafts: [], periods: [], channelTotals: [], activeDraftId: null, activeDraft: null, repDraftId: null, repDraft: null,\nrepMode: 'xiaohongshu', variantTab: 'xiaohongshu', pendingWorkId: null, latestAiText: '', editingCardId: null, diagTimer: null, }; const today = () => new Date().toISOString().slice(0, 10);\nconst fmtNum = n => n >= 10000 ? `${(n / 10000).toFixed(1)}w` : n.toLocaleString();\nconst errMsg = e => e?.message || '未知错误'; const esc = s => String(s ?? '').replace(/[&<>\"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]));\nfunction uuid() { const b = crypto.getRandomValues(new Uint8Array(16)); b[6] = (b[6] & 0x0f) | 0x40; b[8] = (b[8] & 0x3f) | 0x80; const h = Array.from(b, x => x.toString(16).padStart(2, '0')).join('');\nreturn `${h.slice(0, 8)}-${h.slice(8, 12)}-${h.slice(12, 16)}-${h.slice(16, 20)}-${h.slice(20)}`;\n} function setStatus(text, tone = 'info') { const el = $('status'); el.textContent = text; el.dataset.tone = tone; } function scoreClass(s) { return s >= 85 ? 'score-s' : s >= 72 ? 'score-a' : s >= 55 ? 'score-b' : 'score-c'; }\nfunction switchView(view) { state.view = view; const titles = { dashboard: '增长驾驶舱', pipeline: '选题与排期看板', editor: '多平台文稿编辑器与实时标题诊断',\nrepurpose: 'AI 一稿多改矩阵', }; $('view-title').textContent = titles[view] || '增长驾驶舱'; qa('.nav-btn').forEach(btn => btn.classList.toggle('active', btn.dataset.view === view));\nqa('.view-pane').forEach(sec => { sec.hidden = sec.id !== `view-${view}`; });\nif (view === 'repurpose') void syncRepurposeDraft(); if (view === 'editor' && !state.activeDraft && state.drafts.length > 0) void loadDraft(state.drafts[0].id); }\nfunction renderTrendSvg() { const host = $('trend-svg'); const tip = $('trend-tip'); const periods = state.periods; if (!periods.length) { host.innerHTML = '<div class=\"empty-state\" style=\"padding:36px 12px\">暂无周期复盘数据，点击「装载演示数据」或右上角「+ 录入复盘」</div>'; return; }\nconst W = 620, H = 250; const pad = { top: 20, right: 48, bottom: 34, left: 52 }; const plotW = W - pad.left - pad.right; const plotH = H - pad.top - pad.bottom; const maxViews = Math.max(1000, ...periods.map(p => p.views)) * 1.15;\nconst maxRate = Math.max(8, ...periods.map(p => p.engagement_rate)) * 1.18; const stepX = periods.length > 1 ? plotW / periods.length : plotW;\nconst barW = Math.min(34, Math.max(16, stepX * 0.44)); const pts = periods.map((p, i) => { const cx = pad.left + stepX * i + stepX / 2;\nconst vy = pad.top + plotH - (p.views / maxViews) * plotH; const ry = pad.top + plotH - (p.engagement_rate / maxRate) * plotH; return { p, i, cx, vy, ry }; }); let grid = ''; for (let g = 0; g <= 4; g++) { const y = pad.top + (plotH * g) / 4;\nconst vLabel = fmtNum(Math.round(maxViews * (1 - g / 4)));\nconst rLabel = `${(maxRate * (1 - g / 4)).toFixed(1)}%`;\ngrid += `<line x1=\"${pad.left}\" y1=\"${y}\" x2=\"${W - pad.right}\" y2=\"${y}\" stroke=\"var(--bd)\" stroke-dasharray=\"${g === 4 ? '' : '3 4'}\" stroke-width=\"1\"/>`;\ngrid += `<text x=\"${pad.left - 8}\" y=\"${y + 4}\" text-anchor=\"end\" font-size=\"10.5\" fill=\"var(--muted)\">${vLabel}</text>`;\ngrid += `<text x=\"${W - pad.right + 8}\" y=\"${y + 4}\" text-anchor=\"start\" font-size=\"10.5\" fill=\"#10b981\">${rLabel}</text>`;\n} const areaPath = pts.length > 1\n? `M ${pts[0].cx} ${pad.top + plotH} ` +\npts.map(pt => `L ${pt.cx} ${pt.vy}`).join(' ') +\n` L ${pts[pts.length - 1].cx} ${pad.top + plotH} Z`\n: '';\nconst ratePath = pts.map((pt, idx) => `${idx === 0 ? 'M' : 'L'} ${pt.cx} ${pt.ry}`).join(' ');\nconst bars = pts.map(pt => { const bh = Math.max(2, pad.top + plotH - pt.vy);\nreturn `<rect x=\"${pt.cx - barW / 2}\" y=\"${pt.vy}\" width=\"${barW}\" height=\"${bh}\" rx=\"5\" fill=\"url(#barGrad)\" opacity=\"0.88\"/>`;\n}).join('');\nconst nodes = pts.map(pt => `\n<g class=\"trend-pt\" data-idx=\"${pt.i}\" style=\"cursor:pointer\"><rect x=\"${pt.cx - stepX / 2}\" y=\"${pad.top}\" width=\"${stepX}\" height=\"${plotH}\" fill=\"transparent\"/><circle cx=\"${pt.cx}\" cy=\"${pt.ry}\" r=\"4.5\" fill=\"var(--elev)\" stroke=\"#10b981\" stroke-width=\"2.5\"/><text x=\"${pt.cx}\" y=\"${H - 12}\" text-anchor=\"middle\" font-size=\"11\" fill=\"var(--muted)\">${esc(pt.p.period)} · ${esc(pt.p.label)}</text></g>\n`).join('');\nhost.innerHTML = `\n<svg viewBox=\"0 0 ${W} ${H}\" role=\"img\" aria-label=\"多平台阅读与互动双轴趋势图\"><defs><linearGradient id=\"barGrad\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0%\" stop-color=\"#6366f1\"/><stop offset=\"100%\" stop-color=\"#0ea5e9\" stop-opacity=\"0.55\"/></linearGradient><linearGradient id=\"areaGrad\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0%\" stop-color=\"#6366f1\" stop-opacity=\"0.22\"/><stop offset=\"100%\" stop-color=\"#6366f1\" stop-opacity=\"0.01\"/></linearGradient></defs>\n${grid}\n${areaPath ? `<path d=\"${areaPath}\" fill=\"url(#areaGrad)\"/>` : ''}\n${bars} <path d=\"${ratePath}\" fill=\"none\" stroke=\"#10b981\" stroke-width=\"2.5\" />\n${nodes} </svg>\n`;\nhost.querySelectorAll('.trend-pt').forEach(g => { g.addEventListener('mouseenter', () => { const p = periods[Number(g.dataset.idx)]; if (!p) return; const topChs = Object.entries(p.by_channel || {})\n.sort((a, b) => b[1] - a[1])\n.slice(0, 3)\n.map(([ch, v]) => `<div>${CHANNEL_META[ch]?.label || ch}: <strong>${fmtNum(v)}</strong></div>`)\n.join('');\ntip.innerHTML = `\n<div style=\"font-weight:700;margin-bottom:4px\">${esc(p.period)} (${esc(p.label)})</div><div>总阅读/曝光：<strong>${p.views.toLocaleString()}</strong></div><div>互动总量：<strong>${p.engagements.toLocaleString()}</strong> (${p.engagement_rate}%)</div><div>发布篇数：<strong>${p.published_count} 篇</strong></div><div style=\"margin-top:4px;padding-top:4px;border-top:1px solid var(--bd);color:var(--muted);font-size:11px\">${topChs}</div>\n`;\ntip.hidden = false; }); g.addEventListener('mousemove', ev => { const rect = $('trend-chart-wrap').getBoundingClientRect(); const left = Math.min(rect.width - 175, Math.max(8, ev.clientX - rect.left + 12)); const top = Math.max(8, ev.clientY - rect.top - 12);\ntip.style.left = `${left}px`;\ntip.style.top = `${top}px`;\n}); g.addEventListener('mouseleave', () => { tip.hidden = true; }); }); } function renderChannelSvg() { const host = $('channel-svg'); const rows = state.channelTotals; if (!rows.length || rows.every(r => r.views === 0)) {\nhost.innerHTML = '<div class=\"empty-state\" style=\"padding:36px 12px\">暂无渠道流量分布</div>'; return; } const W = 380, rowH = 38, padTop = 6; const H = rows.length * rowH + 10; const maxViews = Math.max(1, ...rows.map(r => r.views));\nconst barX = 76, barMaxW = 195; const items = rows.map((r, i) => { const y = padTop + i * rowH; const meta = CHANNEL_META[r.channel] || { label: r.channel, color: '#6366f1' }; const bw = Math.max(4, (r.views / maxViews) * barMaxW);\nreturn `\n<g><circle cx=\"10\" cy=\"${y + 15}\" r=\"4.5\" fill=\"${meta.color}\"/><text x=\"21\" y=\"${y + 19}\" font-size=\"12\" font-weight=\"600\" fill=\"var(--fg)\">${esc(meta.label)}</text><rect x=\"${barX}\" y=\"${y + 8}\" width=\"${barMaxW}\" height=\"14\" rx=\"7\" fill=\"var(--sub)\"/><rect x=\"${barX}\" y=\"${y + 8}\" width=\"${bw}\" height=\"14\" rx=\"7\" fill=\"${meta.color}\" opacity=\"0.9\"/><text x=\"${barX + barMaxW + 8}\" y=\"${y + 19}\" font-size=\"11.5\" font-weight=\"700\" fill=\"var(--fg)\">${r.share_pct}%</text><text x=\"${W - 4}\" y=\"${y + 19}\" text-anchor=\"end\" font-size=\"11\" fill=\"var(--muted)\">${fmtNum(r.views)}</text></g>\n`;\n}).join('');\nhost.innerHTML = `<svg viewBox=\"0 0 ${W} ${H}\" role=\"img\" aria-label=\"各渠道流量占比横向条形图\">${items}</svg>`;\n} function renderDiagGauge(diag) { const score = diag.score; const color = score >= 85 ? '#10b981' : score >= 72 ? '#6366f1' : score >= 55 ? '#f59e0b' : '#ef4444'; const r = 34, c = 2 * Math.PI * r; const offset = c * (1 - score / 100);\n$('diag-gauge').innerHTML = `\n<svg viewBox=\"0 0 86 86\" role=\"img\" aria-label=\"标题评分 ${score}\"><circle cx=\"43\" cy=\"43\" r=\"${r}\" fill=\"none\" stroke=\"var(--sub)\" stroke-width=\"8\"/><circle cx=\"43\" cy=\"43\" r=\"${r}\" fill=\"none\" stroke=\"${color}\" stroke-width=\"8\" stroke-linecap=\"round\"\nstroke-dasharray=\"${c.toFixed(1)}\" stroke-dashoffset=\"${offset.toFixed(1)}\" transform=\"rotate(-90 43 43)\"/><text x=\"43\" y=\"47\" text-anchor=\"middle\" font-size=\"22\" font-weight=\"800\" fill=\"var(--fg)\">${score}</text><text x=\"43\" y=\"61\" text-anchor=\"middle\" font-size=\"9.5\" fill=\"var(--muted)\">/ 100</text></svg>\n`;\nconst gradeEl = $('diag-grade');\ngradeEl.textContent = `${diag.grade} 级`;\ngradeEl.className = `score-pill ${scoreClass(score)}`;\n$('diag-highlights').innerHTML = (diag.highlights || []).length\n? diag.highlights.map(h => `<span class=\"tag\">${esc(h)}</span>`).join('')\n: '<span class=\"card-sub\">待检测亮点</span>'; const dimDefs = [\n['length', '长度黄金区间'], ['numbers', '数字量化锚点'], ['value_hook', '痛点与收益词'], ['tension', '情绪张力结构'], ['readability', '正文分段可读'], ];\n$('diag-dims').innerHTML = dimDefs.map(([k, label]) => { const val = diag.dimensions?.[k] ?? 0; const pct = Math.round((val / 20) * 100);\nreturn `\n<div class=\"dim-row\"><div class=\"dim-head\"><span>${label}</span><strong>${val} / 20</strong></div><div class=\"bar-track\"><div class=\"bar-fill\" style=\"width:${pct}%\"></div></div></div>\n`;\n}).join(''); $('diag-suggs').innerHTML = (diag.suggestions || []).length\n? diag.suggestions.map(s => `<li>${esc(s)}</li>`).join('')\n: '<li style=\"color:var(--ok)\">标题与结构表现优秀，可直接进入一稿多改分发！</li>';\n$('editor-stats').textContent = `${diag.word_count} 字 · 预计阅读 ${diag.read_minutes} 分钟 · ${diag.paragraph_count} 段`;\n} function renderHeaderAndKpis() {\n$('rev-label').textContent = `Rev #${state.revision}`;\n$('nb-periods').textContent = `${state.periods.length}期`;\n$('nb-calendar').textContent = String(state.calendar.length); $('nb-drafts').textContent = String(state.drafts.length); const totalVariants = state.drafts.reduce((s, d) => s + (d.variants_count || 0), 0);\n$('nb-variants').textContent = totalVariants ? `${totalVariants}稿` : 'AI';\n$('kpi-published').textContent = String(state.kpis.total_published);\n$('kpi-drafts-sub').textContent = `主稿库 ${state.kpis.total_drafts} 篇`;\n$('kpi-views').textContent = fmtNum(state.kpis.total_views); const top = state.channelTotals[0]; $('kpi-top-ch').textContent = top && top.views > 0\n? `Top 渠道：${CHANNEL_META[top.channel]?.label || top.channel} (${top.share_pct}%)`\n: '暂无渠道流量数据';\n$('kpi-eng').textContent = `${state.kpis.avg_engagement_rate.toFixed(1)}%`;\n$('kpi-scheduled').textContent = String(state.kpis.weekly_scheduled); const wip = state.calendar.filter(c => c.stage === 'idea' || c.stage === 'drafting').length;\n$('kpi-idea-sub').textContent = `灵感/撰写中 ${wip} 篇`;\nconst isEmpty = state.calendar.length === 0 && state.drafts.length === 0 && state.periods.length === 0; $('dash-empty').hidden = !isEmpty; } function renderUpcoming() { const box = $('dash-upcoming'); const list = state.calendar\n.filter(c => c.stage !== 'published')\n.sort((a, b) => b.viral_score - a.viral_score)\n.slice(0, 3); if (!list.length) { box.innerHTML = '<div class=\"card-sub\">暂无待发排期内容，前往「选题与排期看板」新建选题。</div>'; return; }\nbox.innerHTML = list.map(c => `\n<div class=\"upcoming-item\" data-card-id=\"${esc(c.id)}\" data-draft-id=\"${esc(c.draft_id)}\"><div class=\"row jb\"><span class=\"tag\">${STAGE_META[c.stage]?.label || c.stage} · ${esc(c.publish_date)}</span><span class=\"score-pill ${scoreClass(c.viral_score)}\">潜力 ${c.viral_score}</span></div><div class=\"k-title\">${esc(c.title)}</div><div class=\"k-hook\">${esc(c.hook || '暂无钩子说明')}</div><div class=\"row\" style=\"gap:4px\">\n${c.channels.map(ch => `<span class=\"ch-pill\" style=\"--c:${CHANNEL_META[ch]?.color || '#6366f1'}\"><span class=\"ch-dot\"></span>${CHANNEL_META[ch]?.label || ch}</span>`).join('')}\n</div></div>\n`).join('');\nbox.querySelectorAll('.upcoming-item').forEach(el => { el.addEventListener('click', () => { if (el.dataset.draftId) { switchView('editor'); void loadDraft(el.dataset.draftId); } else { switchView('pipeline'); openCardModal(el.dataset.cardId); } }); }); }\nfunction renderKanban() { const board = $('kanban-board'); const kw = $('pipe-search').value.trim().toLowerCase();\nconst chFilter = $('pipe-channel').value; const filtered = state.calendar.filter(c => { if (chFilter && !c.channels.includes(chFilter)) return false;\nif (kw && !`${c.title} ${c.hook} ${(c.tags || []).join(' ')}`.toLowerCase().includes(kw)) return false;\nreturn true; }); board.innerHTML = STAGE_ORDER.map(stage => { const meta = STAGE_META[stage]; const items = filtered.filter(c => c.stage === stage); const idx = STAGE_ORDER.indexOf(stage); const prevStage = idx > 0 ? STAGE_ORDER[idx - 1] : null;\nconst nextStage = idx < STAGE_ORDER.length - 1 ? STAGE_ORDER[idx + 1] : null;\nreturn `\n<div class=\"kanban-col\"><div class=\"kanban-col-head\"><span><span class=\"stage-dot\" style=\"background:${meta.color}\"></span>${meta.label}</span><span class=\"tag\">${items.length}</span></div>\n${items.length ? items.map(c => `\n<div class=\"k-card\"><div class=\"row jb\"><span style=\"font-size:11px;color:var(--muted)\">${esc(c.publish_date)}</span><span class=\"score-pill ${scoreClass(c.viral_score)}\">${c.viral_score}分</span></div><div class=\"k-title\">${esc(c.title)}</div>\n${c.hook ? `<div class=\"k-hook\">${esc(c.hook)}</div>` : ''}\n<div class=\"row\" style=\"gap:4px\">\n${c.channels.map(ch => `<span class=\"ch-pill\" style=\"--c:${CHANNEL_META[ch]?.color || '#6366f1'}\">${CHANNEL_META[ch]?.label || ch}</span>`).join('')}\n</div><div class=\"k-foot\"><div class=\"row\" style=\"gap:4px\">\n${prevStage ? `<button class=\"btn btn-sm\" data-move=\"${esc(c.id)}\" data-to=\"${prevStage}\" title=\"退回${STAGE_META[prevStage].label}\" type=\"button\">←</button>` : ''}\n${nextStage ? `<button class=\"btn btn-sm\" data-move=\"${esc(c.id)}\" data-to=\"${nextStage}\" title=\"推进至${STAGE_META[nextStage].label}\" type=\"button\">→</button>` : ''}\n</div><div class=\"row\" style=\"gap:4px\">\n${c.draft_id ? `<button class=\"btn btn-sm\" data-open-draft=\"${esc(c.draft_id)}\" type=\"button\">主稿</button>` : ''}\n<button class=\"btn btn-sm\" data-edit-card=\"${esc(c.id)}\" type=\"button\">编辑</button></div></div></div>\n`).join('') : '<div class=\"card-sub\" style=\"text-align:center;padding:24px 6px\">该阶段暂无选题</div>'}\n</div>\n`;\n}).join(''); board.querySelectorAll('[data-move]').forEach(btn => { btn.addEventListener('click', () => void moveCard(btn.dataset.move, btn.dataset.to)); }); board.querySelectorAll('[data-edit-card]').forEach(btn => {\nbtn.addEventListener('click', () => openCardModal(btn.dataset.editCard)); }); board.querySelectorAll('[data-open-draft]').forEach(btn => { btn.addEventListener('click', () => { switchView('editor'); void loadDraft(btn.dataset.openDraft); }); }); }\nfunction renderDraftList() { const list = $('draft-list'); if (!state.drafts.length) { list.innerHTML = '<div class=\"card-sub\" style=\"padding:14px 4px\">暂无主稿，点击右上角「+ 新建」开始写作。</div>'; } else {\nlist.innerHTML = state.drafts.map(d => `\n<button class=\"draft-item ${d.id === state.activeDraftId ? 'active' : ''}\" data-draft-id=\"${esc(d.id)}\" type=\"button\"><div class=\"draft-item-title\">${esc(d.title)}</div><div class=\"draft-item-meta\"><span>${CHANNEL_META[d.primary_channel]?.label || d.primary_channel} · ${d.word_count}字</span><strong style=\"color:${d.headline_score >= 85 ? 'var(--ok)' : 'var(--ac)'}\">${d.headline_score}分</strong></div></button>\n`).join('');\nlist.querySelectorAll('[data-draft-id]').forEach(btn => { btn.addEventListener('click', () => void loadDraft(btn.dataset.draftId)); }); } const sel = $('rep-draft-select'); const prev = state.repDraftId; sel.innerHTML = state.drafts.length\n? state.drafts.map(d => `<option value=\"${esc(d.id)}\">${esc(d.id)} · ${esc(d.title.slice(0, 34))}</option>`).join('')\n: '<option value=\"\">暂无主稿（请先在编辑器创建）</option>'; if (prev && state.drafts.some(d => d.id === prev)) sel.value = prev; else if (state.drafts[0]) sel.value = state.drafts[0].id; state.repDraftId = sel.value || null; }\nfunction populateEditorForm(draft, diag) { state.activeDraftId = draft?.id ?? null; state.activeDraft = draft ?? null;\n$('editor-heading').textContent = draft ? `编辑主稿 · ${draft.id}` : '新建主稿';\n$('ed-title').value = draft?.title ?? ''; $('ed-channel').value = draft?.primary_channel ?? 'wechat'; $('ed-body').value = draft?.body ?? ''; $('btn-del-draft').hidden = !draft; $('btn-editor-insert').hidden = !state.canInsert;\n$('title-len-hint').textContent = `${Array.from($('ed-title').value.trim()).length} 字`;\n$('ed-variants-badge').textContent = `已存 ${draft?.variants?.length ?? 0} 份衍生稿`;\nrenderDraftList(); if (diag) renderDiagGauge(diag); else void runLiveDiagnose(); } function renderVariantTabs() { const draft = state.repDraft; const tabs = $('variant-tabs');\nconst variantsByMode = new Map((draft?.variants || []).map(v => [v.mode, v])); tabs.innerHTML = Object.entries(MODE_META).map(([mode, meta]) => { const has = variantsByMode.has(mode);\nreturn `<button class=\"tab-pill ${state.variantTab === mode ? 'active' : ''}\" data-vtab=\"${mode}\" type=\"button\">${meta.label}${has ? ' ●' : ''}</button>`;\n}).join(''); tabs.querySelectorAll('[data-vtab]').forEach(btn => { btn.addEventListener('click', () => { state.variantTab = btn.dataset.vtab;\nrenderVariantTabs(); }); }); const cur = variantsByMode.get(state.variantTab); $('variant-editor').value = cur?.content ?? ''; $('rep-draft-meta').textContent = draft\n? `主稿「${draft.title.slice(0, 36)}」· 已存 ${draft.variants.length}/4 份衍生稿`\n: '请先选择或创建一篇主稿'; $('btn-variant-insert').hidden = !state.canInsert; } async function refreshAll(keepDraftId) { if (typeof plugin?.action !== 'function') { setStatus('请在 Velai Desktop 插件容器中打开此页面。', 'error'); return; }\ntry { const caps = await plugin.action('host.capabilities', {}).catch(() => ({ actions: [] })); state.canInsert = Array.isArray(caps?.actions) && caps.actions.includes('host.draft.insert'); const res = await plugin.action('growth.dashboard', {});\nstate.revision = res.revision; state.kpis = res.kpis; state.calendar = res.calendar; state.drafts = res.drafts; state.periods = res.periods;\nstate.channelTotals = res.channel_totals; renderHeaderAndKpis(); renderTrendSvg(); renderChannelSvg(); renderUpcoming(); renderKanban(); renderDraftList(); const targetId = keepDraftId || state.activeDraftId || state.drafts[0]?.id;\nif (targetId && state.drafts.some(d => d.id === targetId)) { await loadDraft(targetId); } else { populateEditorForm(null, null); } if (state.view === 'repurpose') await syncRepurposeDraft();\nsetStatus(`同步完成 · ${state.calendar.length} 条排期 / ${state.drafts.length} 篇主稿`, 'ok');\n} catch (err) {\nsetStatus(`加载失败：${errMsg(err)}`, 'error');\n} } async function loadDraft(id) { try { const res = await plugin.action('draft.read', { id }); if (res.found) populateEditorForm(res.draft, res.diagnosis); } catch (err) {\nsetStatus(`读取主稿失败：${errMsg(err)}`, 'error');\n} } async function syncRepurposeDraft() { const id = $('rep-draft-select').value; state.repDraftId = id || null; if (!id) { state.repDraft = null; renderVariantTabs(); return; }\ntry { const res = await plugin.action('draft.read', { id }); state.repDraft = res.found ? res.draft : null; renderVariantTabs(); } catch (err) {\nsetStatus(`读取主稿失败：${errMsg(err)}`, 'error');\n} } async function runLiveDiagnose() { const title = $('ed-title').value; const body = $('ed-body').value;\n$('title-len-hint').textContent = `${Array.from(title.trim()).length} 字`;\nif (typeof plugin?.action !== 'function') return; try { const diag = await plugin.action('draft.diagnose', { title, body }); renderDiagGauge(diag); } catch { } }\nfunction scheduleDiagnose() { clearTimeout(state.diagTimer); state.diagTimer = setTimeout(() => void runLiveDiagnose(), 180); } async function moveCard(id, stage) { if (state.busy) return; state.busy = true; try {\nconst res = await plugin.action('calendar.move', { expected_revision: state.revision, id, stage }); if (res.status === 'saved') { await refreshAll();\nsetStatus(`已流转至「${STAGE_META[stage].label}」`, 'ok');\n} else {\nsetStatus(`流转未完成：${res.status}，请刷新重试`, 'error');\n} } catch (err) {\nsetStatus(`流转失败：${errMsg(err)}`, 'error');\n} finally { state.busy = false; } } function openCardModal(cardId) { state.editingCardId = cardId || null; const card = cardId ? state.calendar.find(c => c.id === cardId) : null;\n$('cm-heading').textContent = card ? `编辑选题 · ${card.id}` : '新建选题卡片';\n$('cm-title').value = card?.title ?? ''; $('cm-stage').value = card?.stage ?? 'idea'; $('cm-date').value = card?.publish_date ?? today();\n$('cm-score').value = card ? String(card.viral_score) : ''; $('cm-hook').value = card?.hook ?? ''; $('cm-tags').value = (card?.tags || []).join(', '); $('cm-delete').hidden = !card; const chSet = new Set(card?.channels || ['wechat']);\n$('cm-channels').innerHTML = Object.entries(CHANNEL_META).map(([k, m]) => `\n<label class=\"check-chip\"><input type=\"checkbox\" value=\"${k}\" ${chSet.has(k) ? 'checked' : ''}><span>${m.label}</span></label>\n`).join('');\n$('cm-draft').innerHTML = '<option value=\"\">不关联主稿</option>' +\nstate.drafts.map(d => `<option value=\"${esc(d.id)}\" ${card?.draft_id === d.id ? 'selected' : ''}>${esc(d.id)} · ${esc(d.title.slice(0, 26))}</option>`).join('');\n$('card-modal').hidden = false; $('cm-title').focus(); } function closeCardModal() { $('card-modal').hidden = true; } const on = (id, fn, ev = 'click') => $(id).addEventListener(ev, fn); async function runBusy(label, fn) { if (state.busy) return false;\nstate.busy = true; try { return await fn(); }\ncatch (err) { setStatus(`${label}失败：${errMsg(err)}`, 'error'); return false; }\nfinally { state.busy = false; } } async function insertToChat(text, okMsg) { if (!text) return; try { const r = await plugin.action('host.draft.insert', { text }); setStatus(r?.inserted ? okMsg : '未能确认回填结果', r?.inserted ? 'ok' : 'error');\n} catch (err) { setStatus(`回填失败：${errMsg(err)}`, 'error'); }\n} const mqDark = window.matchMedia('(prefers-color-scheme: dark)'); if (!document.documentElement.dataset.theme) document.documentElement.dataset.theme = mqDark.matches ? 'dark' : 'light';\nqa('.nav-btn').forEach(btn => btn.addEventListener('click', () => switchView(btn.dataset.view))); on('btn-refresh', () => void refreshAll()); on('btn-go-pipeline', () => switchView('pipeline'));\non('btn-theme', () => { document.documentElement.dataset.theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'; });\nconst doSeed = () => runBusy('装载', async () => { const res = await plugin.action('demo.seed', { expected_revision: state.revision }); if (res.status === 'seeded') { await refreshAll('drf-001');\nsetStatus(`已装载演示矩阵：${res.calendar_count} 篇排期 / ${res.drafts_count} 篇主稿 / ${res.periods_count} 期指标`, 'ok');\n} else setStatus(`装载未完成：${res.status}`, 'error');\n}); on('btn-seed', doSeed); on('btn-seed-hero', doSeed); on('btn-toggle-metric-form', () => { $('metric-form-card').hidden = !$('metric-form-card').hidden; });\non('btn-close-metric-form', () => { $('metric-form-card').hidden = true; }); on('btn-save-metric', () => { const period = $('m-period').value.trim(), label = $('m-label').value.trim(); if (!period || !label) return setStatus('请填写期号与日期标签。', 'error');\nvoid runBusy('保存指标', async () => { const by_channel = {};\nfor (const ch of Object.keys(CHANNEL_META)) by_channel[ch] = Math.max(0, parseInt($(`m-ch-${ch}`).value || '0', 10) || 0);\nconst res = await plugin.action('metrics.record', { expected_revision: state.revision, period, label,\npublished_count: Math.max(0, parseInt($('m-pub').value || '0', 10) || 0),\nengagements: Math.max(0, parseInt($('m-eng').value || '0', 10) || 0), by_channel, });\nif (res.status === 'saved') { $('metric-form-card').hidden = true; await refreshAll(); setStatus(`已保存 ${period} 复盘指标`, 'ok'); }\nelse setStatus(`保存指标失败：${res.status}`, 'error');\n}); }); on('pipe-search', renderKanban, 'input'); on('pipe-channel', renderKanban, 'change'); on('btn-new-card', () => openCardModal(null));\non('cm-close', closeCardModal); on('cm-cancel', closeCardModal); on('cm-save', () => { const title = $('cm-title').value.trim(); const channels = Array.from($('cm-channels').querySelectorAll('input:checked')).map(i => i.value);\nif (!title || !channels.length) return setStatus('请填写选题标题并至少选择 1 个目标渠道。', 'error'); void runBusy('保存选题', async () => { const scoreRaw = $('cm-score').value.trim(); const payload = { expected_revision: state.revision, id: state.editingCardId || 'NEW', title,\nstage: $('cm-stage').value, channels, publish_date: $('cm-date').value || today(), hook: $('cm-hook').value.trim(), draft_id: $('cm-draft').value,\ntags: $('cm-tags').value.split(/[,，]/).map(s => s.trim()).filter(Boolean).slice(0, 5), }; if (scoreRaw !== '') payload.viral_score = Math.max(0, Math.min(100, parseInt(scoreRaw, 10) || 0)); const res = await plugin.action('calendar.save', payload);\nif (res.status === 'saved') { closeCardModal(); await refreshAll(); setStatus(`选题 ${res.id} 已保存（潜力分 ${res.viral_score}）`, 'ok'); }\nelse setStatus(`保存选题失败：${res.status}`, 'error');\n}); }); on('cm-delete', () => state.editingCardId && runBusy('删除', async () => { const res = await plugin.action('calendar.delete', { expected_revision: state.revision, id: state.editingCardId });\nif (res.status === 'deleted') { closeCardModal(); await refreshAll(); setStatus('选题卡片已删除', 'ok'); }\nelse setStatus(`删除失败：${res.status}`, 'error');\n})); on('ed-title', scheduleDiagnose, 'input'); on('ed-body', scheduleDiagnose, 'input'); on('btn-new-draft', () => { populateEditorForm(null, null); $('ed-title').focus(); }); on('btn-save-draft', () => {\nconst title = $('ed-title').value.trim(); if (!title) return setStatus('请输入主稿标题。', 'error'); void runBusy('保存主稿', async () => { const res = await plugin.action('draft.save', { expected_revision: state.revision, id: state.activeDraftId || 'NEW',\ntitle, primary_channel: $('ed-channel').value, body: $('ed-body').value, });\nif (res.status === 'saved') { await refreshAll(res.id); setStatus(`主稿 ${res.id} 已保存（标题诊断 ${res.headline_score} 分）`, 'ok'); }\nelse setStatus(`保存主稿失败：${res.status}`, 'error');\n}); }); on('btn-del-draft', () => state.activeDraftId && runBusy('删除', async () => { const res = await plugin.action('draft.delete', { expected_revision: state.revision, id: state.activeDraftId });\nif (res.status === 'deleted') { state.activeDraftId = null; await refreshAll(); setStatus('主稿已删除', 'ok'); }\nelse setStatus(`删除失败：${res.status}`, 'error');\n})); on('btn-editor-repurpose', () => { if (state.activeDraftId) state.repDraftId = state.activeDraftId; switchView('repurpose'); });\non('btn-editor-insert', () => insertToChat(`# ${$('ed-title').value.trim()}\\n\\n${$('ed-body').value.trim()}`.trim(), '主稿已回填当前会话输入框'));\non('rep-draft-select', () => void syncRepurposeDraft(), 'change'); $('mode-grid').querySelectorAll('.mode-card').forEach(card => card.addEventListener('click', () => { state.repMode = card.dataset.mode; state.variantTab = state.repMode;\n$('mode-grid').querySelectorAll('.mode-card').forEach(c => c.classList.toggle('active', c.dataset.mode === state.repMode)); renderVariantTabs(); })); on('btn-dispatch-ai', async () => { if (!state.repDraft) return setStatus('请先选择一篇源主稿再发起一稿多改。', 'error');\nconst meta = MODE_META[state.repMode], extra = $('rep-extra').value.trim();\nconst prompt = `请将下方内容主稿${meta.prompt}${extra ? `\\n附加要求：${extra}` : ''}\\n仅输出可直接发布的成品文案。\\n\\n主标题：${state.repDraft.title}\\n\\n主稿正文：\\n${(state.repDraft.body || '').slice(0, 1450)}`;\nstate.pendingWorkId = uuid(); state.latestAiText = ''; $('ai-work-panel').hidden = false; $('ai-work-preview').hidden = true; $('btn-adopt-variant').hidden = true; $('btn-insert-ai').hidden = true; $('btn-check-ai').hidden = false;\n$('ai-work-state').textContent = `正在派发「${meta.label}」改写请求给当前 Velai 会话…`;\ntry { await plugin.action('session.turn.request', { prompt: Array.from(prompt).slice(0, 2000).join(''), work_id: state.pendingWorkId });\n$('ai-work-state').textContent = `已派发至当前会话（${meta.label}），等待 AI 生成完毕后点击「核对改写结果」。`;\n} catch (err) {\n$('ai-work-state').textContent = err?.message === 'cancelled' ? '已取消派发：请先在 Velai 宿主中选择一个活动会话。' : `派发未确认（${err?.message || 'unknown'}），请到原会话核对。`;\n} }); on('btn-check-ai', async () => { if (!state.pendingWorkId) return; $('ai-work-state').textContent = '正在核对当前会话的改写结果…'; try { const r = await plugin.action('session.turn.result', { work_id: state.pendingWorkId });\nif (r.state === 'completed' && !r.truncated && typeof r.text === 'string' && r.text.trim()) { state.latestAiText = r.text.trim(); $('ai-work-state').textContent = '已获取完整改写成品，确认无误后可采纳为渠道衍生稿或直接回填输入框。'; $('ai-work-preview').textContent = state.latestAiText;\n$('ai-work-preview').hidden = false; $('btn-adopt-variant').hidden = false; $('btn-insert-ai').hidden = !state.canInsert;\n} else $('ai-work-state').textContent = `当前任务状态：${r.state}${r.truncated ? '（内容过长被截断，请回会话查看）' : ''}`;\n} catch (err) { $('ai-work-state').textContent = `核对失败：${err?.message || '请回到原会话查看'}`; }\n}); const saveVariantContent = (mode, content) => (!state.repDraftId || !content.trim()) ? Promise.resolve(false) : runBusy('保存衍生稿', async () => {\nconst res = await plugin.action('draft.variant.save', { expected_revision: state.revision, draft_id: state.repDraftId, mode, content: content.trim().slice(0, 2600) });\nif (res.status === 'saved') { state.variantTab = mode; await refreshAll(state.repDraftId); await syncRepurposeDraft();\nsetStatus(`已保存「${MODE_META[mode].label}」衍生稿`, 'ok'); return true;\n}\nsetStatus(`保存衍生稿未完成：${res.status}`, 'error'); return false;\n}); on('btn-adopt-variant', async () => { if (await saveVariantContent(state.repMode, state.latestAiText)) { state.pendingWorkId = null; state.latestAiText = ''; $('ai-work-panel').hidden = true; $('btn-check-ai').hidden = true; }\n}); on('btn-insert-ai', () => insertToChat(state.latestAiText, '已回填 AI 改写稿到会话输入框')); on('btn-variant-manual-save', () => void saveVariantContent(state.variantTab, $('variant-editor').value));\non('btn-variant-insert', () => insertToChat($('variant-editor').value.trim(), '衍生稿已回填会话输入框')); on('btn-variant-copy', async () => {\nif (!$('variant-editor').value) return; try { await navigator.clipboard.writeText($('variant-editor').value); setStatus('已复制衍生稿文本', 'ok'); } catch { setStatus('沙箱限制直接复制，请手动全选复制。'); }\n}); on('btn-io', async () => { $('io-modal').hidden = false; $('io-text').value = ''; $('io-msg').textContent = '正在加载可导出清单…'; try { const res = await plugin.action('document.list', {});\n$('io-select').innerHTML = (res.items || []).map(it => `<option value=\"${esc(it.id)}\">${esc(it.label)}</option>`).join('');\n$('io-msg').textContent = `共 ${(res.items || []).length} 项可导出文档`;\n} catch (err) { $('io-msg').textContent = `读取清单失败：${errMsg(err)}`; }\n}); on('io-close', () => { $('io-modal').hidden = true; }); on('io-export', async () => { const id = $('io-select').value; if (!id) return; try { const res = await plugin.action('document.export', { id });\nif (res.text) { $('io-text').value = res.text; $('io-msg').textContent = `已导出 ${res.filename}`; }\nelse $('io-msg').textContent = `导出失败：${res.error || 'unknown'}`;\n} catch (err) { $('io-msg').textContent = `导出异常：${errMsg(err)}`; }\n}); on('io-copy', async () => { if (!$('io-text').value) return; try { await navigator.clipboard.writeText($('io-text').value); $('io-msg').textContent = '已复制 JSON 到剪贴板'; } catch { $('io-msg').textContent = '请手动全选复制文本框内容'; }\n}); on('io-import', async () => { const text = $('io-text').value.trim(); if (!text) { $('io-msg').textContent = '请先粘贴 JSON 文本。'; return; } try { const res = await plugin.action('document.import', { text }); if (res.imported) { $('io-modal').hidden = true;\nawait refreshAll(res.id && res.id !== 'CALENDAR' ? res.id : undefined);\nsetStatus(`JSON 导入成功 (${res.id || 'ok'})`, 'ok');\n} else $('io-msg').textContent = `导入被拒绝：${res.reason || 'invalid'}`;\n} catch (err) { $('io-msg').textContent = `导入异常：${errMsg(err)}`; }\n}); void refreshAll(); })();\n</script>\n</body>\n</html>\n","path":"ui/index.html"}],"format":"nmas-plugin","manifest":{"actions":[{"id":"growth.dashboard","input_schema":{"additionalProperties":false,"properties":{},"required":[],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"calendar":{"items":{"additionalProperties":false,"properties":{"channels":{"items":{"enum":["wechat","xiaohongshu","zhihu","x","youtube","bilibili"],"type":"string"},"type":"array"},"draft_id":{"maxLength":48,"type":"string"},"hook":{"maxLength":240,"type"