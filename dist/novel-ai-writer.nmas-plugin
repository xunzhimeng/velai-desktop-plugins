{"files":[{"content":"const MAX_PROMPT_BYTES = 8192;\nconst UUIDV4_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/;\n\nconst TONE_LABELS = {\n  literary: '克制细腻的文学叙事，注重潜台词与心理暗流',\n  suspense: '强悬疑高张力节奏，细节埋设伏笔并层层反转',\n  fast_paced: '明快利落的网文推进感，冲突直给、章末留钩子',\n  poetic: '冷峻诗意的意象白描，光影与感官质感突出',\n  dramatic: '强戏剧冲突与人物对峙，台词锋利有画面感',\n};\n\nfunction utf8Bytes(str) {\n  let b = 0;\n  for (const ch of str) {\n    const cp = ch.codePointAt(0);\n    b += cp <= 0x7f ? 1 : cp <= 0x7ff ? 2 : cp <= 0xffff ? 3 : 4;\n  }\n  return b;\n}\n\nfunction cleanText(raw, maxChars) {\n  if (typeof raw !== 'string') return '';\n  return raw.replace(/\\0/g, '').trim().slice(0, maxChars);\n}\n\nfunction trimToUtf8Limit(str, limitBytes) {\n  if (utf8Bytes(str) <= limitBytes) return str;\n  let out = '';\n  let used = 0;\n  for (const ch of str) {\n    const cp = ch.codePointAt(0);\n    const need = cp <= 0x7f ? 1 : cp <= 0x7ff ? 2 : cp <= 0xffff ? 3 : 4;\n    if (used + need > limitBytes) break;\n    out += ch;\n    used += need;\n  }\n  return out;\n}\n\nfunction assertUuidV4(requestId) {\n  if (typeof requestId !== 'string' || !UUIDV4_RE.test(requestId)) {\n    const err = new Error('request_id 必须为小写 UUIDv4');\n    err.code = 'invalid_input';\n    throw err;\n  }\n}\n\nfunction buildStreamPrompt(input) {\n  const bookTitle = cleanText(input.book_title, 100);\n  const chapterTitle = cleanText(input.chapter_title, 120);\n  const genre = cleanText(input.genre, 48) || '长篇小说';\n  const pov = cleanText(input.pov, 64) || '第三人称限知视角';\n  const toneDesc = TONE_LABELS[input.tone] || TONE_LABELS.suspense;\n  const targetWords = Number.isInteger(input.target_words) ? input.target_words : 800;\n  const instruction = cleanText(input.instruction, 1200) || '承接上文情绪与冲突，自然推进下一幕情节，并在末尾留下悬念钩子。';\n  const context = cleanText(input.context, 3600);\n\n  if (!bookTitle || !chapterTitle || !context) {\n    const err = new Error('书名、章节名与前文上下文不能为空');\n    err.code = 'invalid_input';\n    throw err;\n  }\n\n  const header = [\n    '你是一位资深中文长篇小说主笔，请严格承接给定上下文进行流畅续写，只输出可直接入稿的 Markdown 小说正文，不要输出任何前言、解释或字数统计。',\n    `作品：《${bookTitle}》（题材：${genre}）`,\n    `当前章节：${chapterTitle}`,\n    `叙事视角：${pov}`,\n    `文风要求：${toneDesc}`,\n    `目标篇幅：约 ${targetWords} 中文字`,\n    `续写指令：${instruction}`,\n    '--- 前文上下文 ---',\n  ].join('\\n');\n\n  const footer = '\\n--- 请直接开始续写下文 ---';\n  const overhead = utf8Bytes(header) + utf8Bytes(footer) + 1;\n  const safeContext = trimToUtf8Limit(context, Math.max(256, MAX_PROMPT_BYTES - overhead));\n  const prompt = `${header}\\n${safeContext}${footer}`;\n  return { prompt, promptBytes: utf8Bytes(prompt) };\n}\n\nfunction buildOutlinePrompt(input) {\n  const bookTitle = cleanText(input.book_title, 100);\n  const chapterNo = Number.isInteger(input.chapter_no) ? input.chapter_no : 1;\n  const sceneCount = Number.isInteger(input.scene_count) ? input.scene_count : 4;\n  const premise = cleanText(input.premise, 3000);\n  const characters = cleanText(input.characters, 1200) || '按核心冲突自动安排主要人物出场';\n  const foreshadowing = cleanText(input.foreshadowing, 1000) || '至少埋设一条可回收的细节伏笔';\n\n  if (!bookTitle || !premise) {\n    const err = new Error('书名与章节核心构想不能为空');\n    err.code = 'invalid_input';\n    throw err;\n  }\n\n  const header = [\n    '你是一位专业小说结构策划，请严格返回一个合法的 JSON 对象（不要包含 Markdown 代码块或多余说明）。',\n    'JSON 字段结构必须包含：',\n    '{',\n    '  \"chapter_title\": \"建议章节标题\",',\n    '  \"core_conflict\": \"本章核心矛盾一句话\",',\n    '  \"pacing_curve\": \"开场-升级-转折-章末钩子的节奏概括\",',\n    '  \"scenes\": [',\n    '    { \"index\": 1, \"location\": \"地点\", \"characters\": [\"角色A\"], \"beat\": \"场景核心事件与冲突\", \"subtext\": \"潜台词或情绪转折\", \"target_words\": 400 }',\n    '  ],',\n    '  \"foreshadowing_hooks\": [\"伏笔1\", \"伏笔2\"],',\n    '  \"ending_hook\": \"章末悬念钩子\"',\n    '}',\n    `作品：《${bookTitle}》 第 ${chapterNo} 章`,\n    `规划场景数：${sceneCount} 场`,\n    `出场人物：${characters}`,\n    `伏笔要求：${foreshadowing}`,\n    '--- 本章核心构想 ---',\n  ].join('\\n');\n\n  const overhead = utf8Bytes(header) + 1;\n  const safePremise = trimToUtf8Limit(premise, Math.max(256, MAX_PROMPT_BYTES - overhead));\n  return `${header}\\n${safePremise}`;\n}\n\nexport default async function (request) {\n  const { kind, contribution, input } = request ?? {};\n  const args = input && typeof input === 'object' ? input : {};\n\n  if (kind === 'action') {\n    if (contribution === 'writer.stream_chapter') {\n      assertUuidV4(args.request_id);\n      const { prompt, promptBytes } = buildStreamPrompt(args);\n      const res = await globalThis.nmas.ai.stream_start({\n        request_id: args.request_id,\n        prompt,\n      });\n      return {\n        request_id: res.request_id,\n        status: res.status,\n        prompt_bytes: promptBytes,\n      };\n    }\n\n    if (contribution === 'writer.outline_json') {\n      assertUuidV4(args.request_id);\n      const prompt = buildOutlinePrompt(args);\n      const res = await globalThis.nmas.ai.complete({\n        request_id: args.request_id,\n        prompt,\n        format: 'json',\n      });\n      const outline =\n        res.json !== null && typeof res.json === 'object' && !Array.isArray(res.json)\n          ? res.json\n          : res.json !== null\n            ? { items: res.json }\n            : null;\n      return {\n        request_id: args.request_id,\n        model: res.model,\n        outline,\n        input_tokens: res.input_tokens,\n        output_tokens: res.output_tokens,\n        cost_microcredits: res.cost_microcredits,\n      };\n    }\n\n    if (contribution === 'writer.cancel') {\n      assertUuidV4(args.request_id);\n      const res = await globalThis.nmas.ai.cancel({\n        request_id: args.request_id,\n      });\n      return {\n        request_id: res.request_id,\n        status: res.status,\n      };\n    }\n  }\n\n  throw new Error(`不支持的调用: ${kind}/${contribution}`);\n}\n","path":"backend/index.js"},{"content":"<!doctype html>\n<html lang=\"zh-CN\" data-theme=\"dark\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>小说 AI 流式写作助手</title>\n  <style>\n    :root {\n      --bg: #08090f;\n      --bg-elev: #0f111c;\n      --bg-card: #151828;\n      --bg-input: #0b0d16;\n      --fg: #f2f4fb;\n      --fg-muted: #8b93ad;\n      --border: rgba(165, 180, 252, 0.16);\n      --border-strong: rgba(129, 140, 248, 0.45);\n      --accent: #818cf8;\n      --accent-soft: rgba(129, 140, 248, 0.14);\n      --gold: #f59e0b;\n      --gold-soft: rgba(245, 158, 11, 0.14);\n      --emerald: #34d399;\n      --emerald-soft: rgba(52, 211, 153, 0.14);\n      --rose: #fb7185;\n      --rose-soft: rgba(251, 113, 133, 0.14);\n      --shadow: 0 14px 36px rgba(0, 0, 0, 0.42);\n      font: 13.5px/1.6 -apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"PingFang SC\", system-ui, sans-serif;\n    }\n    html[data-theme=\"light\"] {\n      --bg: #f6f7fb;\n      --bg-elev: #ffffff;\n      --bg-card: #ffffff;\n      --bg-input: #f8fafc;\n      --fg: #111827;\n      --fg-muted: #64748b;\n      --border: rgba(15, 23, 42, 0.12);\n      --border-strong: rgba(79, 70, 229, 0.42);\n      --accent: #4f46e5;\n      --accent-soft: rgba(79, 70, 229, 0.1);\n      --gold: #d97706;\n      --gold-soft: rgba(217, 119, 6, 0.1);\n      --emerald: #059669;\n      --emerald-soft: rgba(5, 150, 105, 0.1);\n      --rose: #e11d48;\n      --rose-soft: rgba(225, 29, 72, 0.1);\n      --shadow: 0 8px 24px rgba(15, 23, 42, 0.06);\n    }\n    * { box-sizing: border-box; }\n    body { margin: 0; background: var(--bg); color: var(--fg); min-height: 100vh; }\n    .mono { font-family: ui-monospace, \"SF Mono\", Menlo, Consolas, monospace; font-variant-numeric: tabular-nums; }\n    .shell { max-width: 1280px; margin: 0 auto; padding: 16px; display: flex; flex-direction: column; gap: 14px; }\n\n    .topbar { background: var(--bg-elev); border: 1px solid var(--border); border-radius: 14px; padding: 14px 18px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; box-shadow: var(--shadow); }\n    .brand-tag { font-size: 10.5px; letter-spacing: 0.14em; color: var(--accent); font-weight: 700; text-transform: uppercase; }\n    .topbar h1 { margin: 2px 0 0; font-size: 17px; font-weight: 700; }\n    .subline { font-size: 12px; color: var(--fg-muted); }\n\n    .tabs { display: flex; gap: 6px; background: var(--bg-input); padding: 4px; border-radius: 10px; border: 1px solid var(--border); }\n    .tabs button { border: 0; background: transparent; color: var(--fg-muted); padding: 6px 14px; border-radius: 7px; font-weight: 600; cursor: pointer; }\n    .tabs button.active { background: var(--accent); color: #ffffff; }\n\n    .status-strip { padding: 8px 14px; border-radius: 10px; background: var(--bg-card); border: 1px solid var(--border); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px; font-size: 12px; color: var(--fg-muted); }\n    .status-strip[data-kind=\"streaming\"] { border-color: var(--border-strong); color: var(--accent); }\n    .status-strip[data-kind=\"ok\"] { border-color: rgba(52, 211, 153, 0.45); color: var(--emerald); }\n    .status-strip[data-kind=\"error\"] { border-color: rgba(251, 113, 133, 0.45); color: var(--rose); }\n\n    .workspace { display: grid; grid-template-columns: minmax(320px, 430px) minmax(0, 1fr); gap: 14px; align-items: start; }\n    @media (max-width: 920px) { .workspace { grid-template-columns: 1fr; } }\n\n    .card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 14px; padding: 15px; box-shadow: var(--shadow); display: flex; flex-direction: column; gap: 11px; min-width: 0; }\n    .card h2 { margin: 0; font-size: 14px; font-weight: 700; }\n    .row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }\n    .between { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: space-between; }\n\n    label.field { display: flex; flex-direction: column; gap: 4px; font-size: 11.5px; color: var(--fg-muted); font-weight: 600; }\n    input, select, textarea, button { font: inherit; color: var(--fg); background: var(--bg-input); border: 1px solid var(--border); border-radius: 8px; padding: 7px 10px; }\n    textarea { width: 100%; resize: vertical; line-height: 1.65; }\n    button { cursor: pointer; background: var(--bg-elev); font-weight: 500; }\n    button:disabled { opacity: 0.45; cursor: not-allowed; }\n    button.primary { background: var(--accent); border-color: var(--accent); color: #fff; font-weight: 600; }\n    button.danger { color: var(--rose); border-color: rgba(251, 113, 133, 0.45); background: var(--rose-soft); font-weight: 600; }\n    button.chip { font-size: 11.5px; padding: 4px 9px; border-radius: 99px; color: var(--fg-muted); }\n    button.chip:hover { color: var(--fg); border-color: var(--border-strong); }\n\n    .badge { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; padding: 2px 9px; border-radius: 99px; border: 1px solid var(--border); font-weight: 600; }\n    .b-accent { color: var(--accent); border-color: var(--border-strong); background: var(--accent-soft); }\n    .b-emerald { color: var(--emerald); border-color: rgba(52, 211, 153, 0.45); background: var(--emerald-soft); }\n    .b-gold { color: var(--gold); border-color: rgba(245, 158, 11, 0.45); background: var(--gold-soft); }\n    .b-rose { color: var(--rose); border-color: rgba(251, 113, 133, 0.45); background: var(--rose-soft); }\n\n    .prose-canvas {\n      min-height: 430px;\n      max-height: 620px;\n      overflow: auto;\n      padding: 18px 20px;\n      border-radius: 11px;\n      border: 1px solid var(--border);\n      background: var(--bg-input);\n      white-space: pre-wrap;\n      word-break: break-word;\n      font: 15px/1.85 \"Songti SC\", \"Noto Serif SC\", \"PingFang SC\", Georgia, serif;\n      letter-spacing: 0.015em;\n    }\n    .prose-canvas.streaming::after {\n      content: \"▍\";\n      display: inline-block;\n      margin-left: 2px;\n      color: var(--accent);\n      animation: blink 1s steps(1) infinite;\n    }\n    @keyframes blink { 50% { opacity: 0; } }\n\n    .scene-card { border: 1px solid var(--border); border-radius: 10px; padding: 11px 13px; background: var(--bg-input); display: flex; flex-direction: column; gap: 5px; }\n    pre.json-view { margin: 0; padding: 12px; border-radius: 10px; border: 1px solid var(--border); background: var(--bg-input); max-height: 280px; overflow: auto; font-size: 12px; line-height: 1.55; }\n    [hidden] { display: none !important; }\n  </style>\n</head>\n<body>\n  <div class=\"shell\">\n    <header class=\"topbar\">\n      <div>\n        <div class=\"brand-tag\">SLICE 5B · ISOLATED AI + SSE COMPANION</div>\n        <h1>小说 AI 流式写作助手</h1>\n        <div class=\"subline\">配合《AI 长篇小说开发系统》使用 · 严格隔离沙箱（仅 <code>ai.complete</code> + 实时 SSE 推送）</div>\n      </div>\n      <div class=\"row\">\n        <div class=\"tabs\">\n          <button class=\"active\" data-tab=\"stream\" type=\"button\">✍️ 流式续写章节</button>\n          <button data-tab=\"outline\" type=\"button\">🧩 结构化细纲 JSON</button>\n        </div>\n        <button id=\"btn-theme\" type=\"button\">☀️ 外观</button>\n      </div>\n    </header>\n\n    <div id=\"status-strip\" class=\"status-strip\">\n      <span id=\"status-text\">正在挂载宿主 AI SSE 事件通道…</span>\n      <div class=\"row mono\" style=\"font-size:11.5px\">\n        <span id=\"sse-pill\" class=\"badge b-accent\">SSE 未连接</span>\n        <span id=\"meta-req\">req: —</span>\n        <span id=\"meta-cost\">cost: —</span>\n      </div>\n    </div>\n\n    <!-- TAB 1: 流式续写章节 -->\n    <section id=\"tab-stream\" class=\"workspace\">\n      <div class=\"card\">\n        <div class=\"between\">\n          <h2>续写参数与前文上下文</h2>\n          <button id=\"btn-preset-novel\" class=\"chip\" type=\"button\">✨ 载入《星渊回响》示例</button>\n        </div>\n        <div class=\"row\">\n          <label class=\"field\" style=\"flex:1\">作品名\n            <input id=\"w-book\" maxlength=\"100\" value=\"星渊回响\" placeholder=\"输入作品标题\">\n          </label>\n          <label class=\"field\" style=\"width:110px\">题材\n            <input id=\"w-genre\" maxlength=\"48\" value=\"硬核科幻悬疑\">\n          </label>\n        </div>\n        <label class=\"field\">当前章节标题\n          <input id=\"w-chapter\" maxlength=\"120\" value=\"第 14 章 · 静默轨道上的第七声回响\">\n        </label>\n        <div class=\"row\">\n          <label class=\"field\" style=\"flex:1\">叙事视角\n            <input id=\"w-pov\" maxlength=\"64\" value=\"第三人称限知（林深视角）\">\n          </label>\n          <label class=\"field\" style=\"width:120px\">文风基调\n            <select id=\"w-tone\">\n              <option value=\"suspense\" selected>强悬疑高张力</option>\n              <option value=\"literary\">细腻文学感</option>\n              <option value=\"fast_paced\">明快爽文节奏</option>\n              <option value=\"poetic\">冷峻诗意白描</option>\n              <option value=\"dramatic\">强戏剧冲突</option>\n            </select>\n          </label>\n          <label class=\"field\" style=\"width:92px\">目标字数\n            <input id=\"w-words\" type=\"number\" min=\"100\" max=\"3000\" step=\"100\" value=\"900\">\n          </label>\n        </div>\n        <label class=\"field\">前文上下文（限 3600 字）\n          <textarea id=\"w-context\" rows=\"6\" maxlength=\"3600\" placeholder=\"粘贴当前章节末尾段落，AI 将严格承接语境流式续写…\"></textarea>\n        </label>\n        <label class=\"field\">本段剧情指令\n          <textarea id=\"w-inst\" rows=\"3\" maxlength=\"1200\" placeholder=\"例如：沈清秋突然截断通讯，揭示信号并非来自站外，而是舱内黑匣子三年前的录音…\"></textarea>\n        </label>\n        <div class=\"row\">\n          <button id=\"btn-stream-start\" class=\"primary\" style=\"flex:1\" type=\"button\">⚡ 开始流式续写</button>\n          <button id=\"btn-stream-stop\" class=\"danger\" type=\"button\" disabled>■ 停止生成</button>\n        </div>\n      </div>\n\n      <div class=\"card\">\n        <div class=\"between\">\n          <div class=\"row\">\n            <h2>流式成稿画布</h2>\n            <span id=\"stream-metrics\" class=\"badge b-gold mono\">0 字 · 0 chunks · seq 0</span>\n          </div>\n          <div class=\"row\">\n            <button id=\"btn-append-ctx\" type=\"button\" disabled>↶ 追加为下段前文</button>\n            <button id=\"btn-copy-md\" type=\"button\" disabled>📋 复制 Markdown</button>\n            <button id=\"btn-clear-out\" type=\"button\">清空</button>\n          </div>\n        </div>\n        <div id=\"stream-canvas\" class=\"prose-canvas\">在左侧填写章节上下文后点击「开始流式续写」，实时接收宿主 <code>ai.delta</code> / <code>ai.done</code> SSE 流。</div>\n      </div>\n    </section>\n\n    <!-- TAB 2: 结构化细纲 JSON -->\n    <section id=\"tab-outline\" class=\"workspace\" hidden>\n      <div class=\"card\">\n        <div class=\"between\">\n          <h2>章节细纲规划参数</h2>\n          <button id=\"btn-preset-outline\" class=\"chip\" type=\"button\">✨ 载入细纲示例</button>\n        </div>\n        <div class=\"row\">\n          <label class=\"field\" style=\"flex:1\">作品名\n            <input id=\"o-book\" maxlength=\"100\" value=\"星渊回响\">\n          </label>\n          <label class=\"field\" style=\"width:92px\">章节序号\n            <input id=\"o-no\" type=\"number\" min=\"1\" max=\"5000\" value=\"15\">\n          </label>\n          <label class=\"field\" style=\"width:86px\">场景数\n            <input id=\"o-scenes\" type=\"number\" min=\"2\" max=\"8\" value=\"4\">\n          </label>\n        </div>\n        <label class=\"field\">本章核心剧情构想\n          <textarea id=\"o-premise\" rows=\"5\" maxlength=\"3000\" placeholder=\"描述本章核心目标、矛盾转折与希望达到的情感高潮…\"></textarea>\n        </label>\n        <label class=\"field\">核心出场人物\n          <input id=\"o-chars\" maxlength=\"1200\" value=\"林深（航电工程师）、沈清秋（任务指挥官）、陆沉舟（失联观测员）\">\n        </label>\n        <label class=\"field\">需埋设或回收的伏笔\n          <input id=\"o-hooks\" maxlength=\"1000\" value=\"回收第 3 章的腕表停摆时间 03:17；埋下气闸舱备用日志缺失伏笔\">\n        </label>\n        <button id=\"btn-outline-run\" class=\"primary\" type=\"button\">🧩 生成结构化 JSON 细纲</button>\n      </div>\n\n      <div class=\"card\">\n        <div class=\"between\">\n          <div class=\"row\">\n            <h2>结构化细纲视图</h2>\n            <span id=\"outline-receipt\" class=\"badge b-emerald mono\">待生成</span>\n          </div>\n          <div class=\"row\">\n            <button id=\"btn-copy-outline-md\" type=\"button\" disabled>📋 复制 Markdown 细纲</button>\n            <button id=\"btn-copy-outline-json\" type=\"button\" disabled>复制 JSON</button>\n          </div>\n        </div>\n        <div id=\"outline-cards\" style=\"display:flex;flex-direction:column;gap:8px\">\n          <div style=\"color:var(--fg-muted);font-size:12.5px\">点击左侧生成按钮，将通过 <code>nmas.ai.complete({ format: \"json\" })</code> 返回结构化章节细纲。</div>\n        </div>\n        <pre id=\"outline-raw\" class=\"json-view mono\" hidden></pre>\n      </div>\n    </section>\n  </div>\n\n  <script>\n    (() => {\n      const plugin = window.nmasPlugin;\n      const $ = id => document.getElementById(id);\n\n      let activeRequestId = null;\n      let streaming = false;\n      let streamText = '';\n      let chunkCount = 0;\n      let lastSeq = 0;\n      let lastOutline = null;\n\n      function uuidv4Lower() {\n        const b = crypto.getRandomValues(new Uint8Array(16));\n        b[6] = (b[6] & 0x0f) | 0x40;\n        b[8] = (b[8] & 0x3f) | 0x80;\n        const h = Array.from(b, x => x.toString(16).padStart(2, '0')).join('');\n        return `${h.slice(0, 8)}-${h.slice(8, 12)}-${h.slice(12, 16)}-${h.slice(16, 20)}-${h.slice(20)}`;\n      }\n\n      function setStatus(text, kind = '') {\n        $('status-text').textContent = text;\n        $('status-strip').dataset.kind = kind;\n      }\n\n      function updateStreamMetrics() {\n        $('stream-metrics').textContent = `${streamText.length} 字 · ${chunkCount} chunks · seq ${lastSeq}`;\n        $('btn-copy-md').disabled = !streamText.length;\n        $('btn-append-ctx').disabled = streaming || !streamText.length;\n        $('btn-stream-start').disabled = streaming;\n        $('btn-stream-stop').disabled = !streaming || !activeRequestId;\n        $('stream-canvas').classList.toggle('streaming', streaming);\n      }\n\n      function handleAiEvent(evt) {\n        if (!evt || typeof evt !== 'object') return;\n        if (!activeRequestId || evt.request_id !== activeRequestId) return;\n        if (typeof evt.seq === 'number' && evt.seq <= lastSeq) return;\n        if (typeof evt.seq === 'number') lastSeq = evt.seq;\n\n        if (evt.type === 'ai.delta') {\n          if (typeof evt.text === 'string' && evt.text.length > 0) {\n            if (chunkCount === 0) streamText = '';\n            streamText += evt.text;\n            chunkCount += 1;\n            const canvas = $('stream-canvas');\n            canvas.textContent = streamText;\n            canvas.scrollTop = canvas.scrollHeight;\n            setStatus(`流式接收中（seq #${lastSeq}）…`, 'streaming');\n            updateStreamMetrics();\n          }\n          return;\n        }\n\n        if (evt.type === 'ai.done') {\n          streaming = false;\n          const cost = Number.isInteger(evt.cost_microcredits) ? evt.cost_microcredits : 0;\n          $('meta-cost').textContent = `cost: ${cost} µcr`;\n          setStatus(`流式续写完成 · 共 ${streamText.length} 字 · 消耗 ${cost} microcredits`, 'ok');\n          updateStreamMetrics();\n          return;\n        }\n\n        if (evt.type === 'ai.error') {\n          streaming = false;\n          const code = evt.code || 'unknown_error';\n          setStatus(`AI 流式任务中止：error_code=${code}`, 'error');\n          updateStreamMetrics();\n        }\n      }\n\n      async function subscribeAiEvents() {\n        if (typeof plugin?.onAiEvent !== 'function') {\n          $('sse-pill').className = 'badge b-rose';\n          $('sse-pill').textContent = '未检测到宿主 onAiEvent';\n          setStatus('请在 Velai Desktop V2 工作区中打开本伴生插件以启用真实 SSE 流。', 'error');\n          return;\n        }\n        try {\n          await plugin.onAiEvent(handleAiEvent);\n          $('sse-pill').className = 'badge b-emerald';\n          $('sse-pill').textContent = 'SSE 已订阅';\n          setStatus('宿主 AI SSE 通道就绪，可直接开始流式续写或细纲规划。', 'ok');\n        } catch (e) {\n          $('sse-pill').className = 'badge b-rose';\n          $('sse-pill').textContent = 'SSE 订阅失败';\n          setStatus(`订阅 onAiEvent 失败：${e?.message || e}`, 'error');\n        }\n      }\n\n      async function copyText(text, label) {\n        try {\n          await navigator.clipboard.writeText(text);\n          setStatus(`已复制${label}到剪贴板。`, 'ok');\n        } catch (e) {\n          setStatus(`剪贴板复制失败：${e?.message || e}`, 'error');\n        }\n      }\n\n      function outlineToMarkdown(outline) {\n        if (!outline || typeof outline !== 'object') return '';\n        const lines = [];\n        lines.push(`# ${outline.chapter_title || '章节细纲'}`);\n        if (outline.core_conflict) lines.push(`\\n**核心矛盾**：${outline.core_conflict}`);\n        if (outline.pacing_curve) lines.push(`**节奏曲线**：${outline.pacing_curve}`);\n        if (Array.isArray(outline.scenes) && outline.scenes.length) {\n          lines.push('\\n## 分场细纲');\n          outline.scenes.forEach((s, i) => {\n            lines.push(`\\n### 第 ${s.index ?? i + 1} 场 · ${s.location || '未指定地点'}`);\n            if (Array.isArray(s.characters) && s.characters.length) lines.push(`- **人物**：${s.characters.join('、')}`);\n            if (s.beat) lines.push(`- **情节推进**：${s.beat}`);\n            if (s.subtext) lines.push(`- **潜台词/转折**：${s.subtext}`);\n            if (s.target_words) lines.push(`- **建议字数**：${s.target_words} 字`);\n          });\n        }\n        if (Array.isArray(outline.foreshadowing_hooks) && outline.foreshadowing_hooks.length) {\n          lines.push('\\n## 伏笔与钩子');\n          for (const h of outline.foreshadowing_hooks) lines.push(`- ${h}`);\n        }\n        if (outline.ending_hook) lines.push(`\\n> **章末悬念**：${outline.ending_hook}`);\n        return lines.join('\\n');\n      }\n\n      function renderOutline(outline) {\n        const box = $('outline-cards');\n        box.replaceChildren();\n        if (!outline || typeof outline !== 'object') {\n          box.textContent = '模型未返回可解析的 JSON 对象。';\n          return;\n        }\n        const head = document.createElement('div');\n        head.className = 'scene-card';\n        const t = document.createElement('strong');\n        t.style.fontSize = '15px';\n        t.textContent = outline.chapter_title || '结构化章节细纲';\n        head.appendChild(t);\n        if (outline.core_conflict) {\n          const p = document.createElement('div');\n          p.textContent = `核心矛盾：${outline.core_conflict}`;\n          head.appendChild(p);\n        }\n        if (outline.pacing_curve) {\n          const p = document.createElement('div');\n          p.style.color = 'var(--fg-muted)';\n          p.textContent = `节奏曲线：${outline.pacing_curve}`;\n          head.appendChild(p);\n        }\n        box.appendChild(head);\n\n        if (Array.isArray(outline.scenes)) {\n          outline.scenes.forEach((s, idx) => {\n            const c = document.createElement('article');\n            c.className = 'scene-card';\n            const top = document.createElement('div');\n            top.className = 'between';\n            const st = document.createElement('strong');\n            st.textContent = `场次 ${s.index ?? idx + 1} · ${s.location || '场景'}`;\n            const b = document.createElement('span');\n            b.className = 'badge b-accent mono';\n            b.textContent = s.target_words ? `约 ${s.target_words} 字` : 'scene';\n            top.append(st, b);\n            const beat = document.createElement('div');\n            beat.textContent = s.beat || '';\n            c.append(top, beat);\n            if (s.subtext) {\n              const sub = document.createElement('div');\n              sub.style.cssText = 'font-size:12px;color:var(--fg-muted)';\n              sub.textContent = `潜台词：${s.subtext}`;\n              c.appendChild(sub);\n            }\n            box.appendChild(c);\n          });\n        }\n        if (outline.ending_hook) {\n          const hook = document.createElement('div');\n          hook.className = 'scene-card';\n          hook.style.borderColor = 'var(--border-strong)';\n          hook.textContent = `章末钩子：${outline.ending_hook}`;\n          box.appendChild(hook);\n        }\n        $('outline-raw').hidden = false;\n        $('outline-raw').textContent = JSON.stringify(outline, null, 2);\n      }\n\n      document.querySelectorAll('.tabs button').forEach(btn => {\n        btn.addEventListener('click', () => {\n          const tab = btn.dataset.tab;\n          document.querySelectorAll('.tabs button').forEach(b => b.classList.toggle('active', b === btn));\n          $('tab-stream').hidden = tab !== 'stream';\n          $('tab-outline').hidden = tab !== 'outline';\n        });\n      });\n\n      $('btn-theme').addEventListener('click', () => {\n        document.documentElement.dataset.theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';\n      });\n\n      $('btn-preset-novel').addEventListener('click', () => {\n        $('w-book').value = '星渊回响';\n        $('w-genre').value = '硬核科幻悬疑';\n        $('w-chapter').value = '第 14 章 · 静默轨道上的第七声回响';\n        $('w-pov').value = '第三人称限知（林深视角）';\n        $('w-tone').value = 'suspense';\n        $('w-words').value = '900';\n        $('w-context').value = '冷却阀合拢的瞬间，环形走廊的应急灯全部转成暗红。林深按住耳麦，频谱仪上那段间隔精确到 1.7 秒的脉冲仍在跳动——和三年前失联的「启明七号」求救信标完全重合。就在他准备把波形转发给主控台时，舷窗外掠过一束没有来源的银白色反光。';\n        $('w-inst').value = '沈清秋突然推开气密门冲进观测舱，警告林深绝对不能向地面回传这段频谱，并亮出一枚本该留在三年前残骸里的机械腕表。';\n      });\n\n      $('btn-preset-outline').addEventListener('click', () => {\n        $('o-book').value = '星渊回响';\n        $('o-no').value = '15';\n        $('o-scenes').value = '4';\n        $('o-premise').value = '林深与沈清秋围绕三年前「启明七号」黑匣子录音展开对峙，二人决定在空间站例行静默窗的 12 分钟内潜入主控底层核对原始遥测日志，却发现站内 AI 早已篡改了气闸舱记录。';\n        $('o-chars').value = '林深、沈清秋、站控 AI「明镜」';\n        $('o-hooks').value = '腕表停在 03:17 的真相；明镜为何隐瞒第七声回响';\n      });\n\n      $('btn-stream-start').addEventListener('click', async () => {\n        if (streaming || typeof plugin?.action !== 'function') return;\n        const book_title = $('w-book').value.trim();\n        const chapter_title = $('w-chapter').value.trim();\n        const context = $('w-context').value.trim();\n        if (!book_title || !chapter_title || !context) {\n          setStatus('请完整填写作品名、章节标题与前文上下文。', 'error');\n          return;\n        }\n        const requestId = uuidv4Lower();\n        activeRequestId = requestId;\n        streaming = true;\n        streamText = '';\n        chunkCount = 0;\n        lastSeq = 0;\n        $('meta-req').textContent = `req: ${requestId.slice(0, 8)}…`;\n        $('meta-cost').textContent = 'cost: 流式计费中…';\n        $('stream-canvas').textContent = '';\n        updateStreamMetrics();\n        setStatus('已发起受管 AI 流式续写，等待首字 SSE 推送…', 'streaming');\n\n        try {\n          const payload = {\n            request_id: requestId,\n            book_title,\n            chapter_title,\n            genre: $('w-genre').value.trim(),\n            pov: $('w-pov').value.trim(),\n            tone: $('w-tone').value,\n            context,\n            instruction: $('w-inst').value.trim(),\n            target_words: Math.min(3000, Math.max(100, Math.round(Number($('w-words').value) || 900))),\n          };\n          const res = await plugin.action('writer.stream_chapter', payload);\n          setStatus(`流式任务已启动 (${res.status}) · Prompt ${res.prompt_bytes} B · 等待 ai.delta…`, 'streaming');\n        } catch (e) {\n          streaming = false;\n          updateStreamMetrics();\n          setStatus(`启动流式续写失败：${e?.message || e}`, 'error');\n        }\n      });\n\n      $('btn-stream-stop').addEventListener('click', async () => {\n        if (!activeRequestId || typeof plugin?.action !== 'function') return;\n        $('btn-stream-stop').disabled = true;\n        try {\n          const res = await plugin.action('writer.cancel', { request_id: activeRequestId });\n          streaming = false;\n          updateStreamMetrics();\n          setStatus(`已发送停止指令 (${res.status})。`, 'ok');\n        } catch (e) {\n          setStatus(`停止生成失败：${e?.message || e}`, 'error');\n          updateStreamMetrics();\n        }\n      });\n\n      $('btn-copy-md').addEventListener('click', () => {\n        const md = `## ${$('w-chapter').value.trim() || '续写正文'}\\n\\n${streamText}`;\n        void copyText(md, ' Markdown 正文');\n      });\n\n      $('btn-append-ctx').addEventListener('click', () => {\n        if (!streamText) return;\n        const merged = `${$('w-context').value.trim()}\\n\\n${streamText}`.trim();\n        $('w-context').value = merged.length > 3600 ? merged.slice(-3600) : merged;\n        setStatus('已将本段续写追加至前文上下文末尾，可继续下一幕续写。', 'ok');\n      });\n\n      $('btn-clear-out').addEventListener('click', () => {\n        if (streaming) return;\n        streamText = '';\n        chunkCount = 0;\n        lastSeq = 0;\n        $('stream-canvas').textContent = '画布已清空。';\n        updateStreamMetrics();\n      });\n\n      $('btn-outline-run').addEventListener('click', async () => {\n        if (typeof plugin?.action !== 'function') return;\n        const book_title = $('o-book').value.trim();\n        const premise = $('o-premise').value.trim();\n        if (!book_title || !premise) {\n          setStatus('请填写作品名与本章核心剧情构想。', 'error');\n          return;\n        }\n        const requestId = uuidv4Lower();\n        $('btn-outline-run').disabled = true;\n        $('meta-req').textContent = `req: ${requestId.slice(0, 8)}…`;\n        setStatus('正在调用受管 AI 生成结构化 JSON 细纲…', 'streaming');\n        try {\n          const res = await plugin.action('writer.outline_json', {\n            request_id: requestId,\n            book_title,\n            chapter_no: Math.max(1, Math.round(Number($('o-no').value) || 1)),\n            scene_count: Math.min(8, Math.max(2, Math.round(Number($('o-scenes').value) || 4))),\n            premise,\n            characters: $('o-chars').value.trim(),\n            foreshadowing: $('o-hooks').value.trim(),\n          });\n          lastOutline = res.outline;\n          renderOutline(res.outline);\n          $('outline-receipt').textContent = `${res.model} · in ${res.input_tokens} / out ${res.output_tokens} · ${res.cost_microcredits} µcr`;\n          $('meta-cost').textContent = `cost: ${res.cost_microcredits} µcr`;\n          $('btn-copy-outline-md').disabled = !lastOutline;\n          $('btn-copy-outline-json').disabled = !lastOutline;\n          setStatus(`结构化 JSON 细纲生成完成（消耗 ${res.cost_microcredits} microcredits）。`, 'ok');\n        } catch (e) {\n          setStatus(`细纲生成失败：${e?.message || e}`, 'error');\n        } finally {\n          $('btn-outline-run').disabled = false;\n        }\n      });\n\n      $('btn-copy-outline-md').addEventListener('click', () => {\n        if (lastOutline) void copyText(outlineToMarkdown(lastOutline), ' Markdown 细纲');\n      });\n      $('btn-copy-outline-json').addEventListener('click', () => {\n        if (lastOutline) void copyText(JSON.stringify(lastOutline, null, 2), ' JSON 细纲');\n      });\n\n      void subscribeAiEvents();\n    })();\n  </script>\n</body>\n</html>\n","path":"ui/index.html"}],"format":"nmas-plugin","manifest":{"actions":[{"id":"writer.stream_chapter","input_schema":{"additionalProperties":false,"properties":{"book_title":{"maxLength":100,"minLength":1,"type":"string"},"chapter_title":{"maxLength":120,"minLength":1,"type":"string"},"context":{"maxLength":3600,"minLength":1,"type":"string"},"genre":{"maxLength":48,"type":"string"},"instruction":{"maxLength":1200,"type":"string"},"pov":{"maxLength":64,"type":"string"},"request_id":{"maxLength":36,"minLength":36,"type":"string"},"target_words":{"maximum":3000,"minimum":100,"type":"integer"},"tone":{"enum":["literary","suspense","fast_paced","poetic","dramatic"],"type":"string"}},"required":["request_id","book_title","chapter_title","context"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"prompt_bytes":{"maximum":8192,"minimum":1,"type":"integer"},"request_id":{"maxLength":36,"minLength":36,"type":"string"},"status":{"enum":["started"],"type":"string"}},"required":["request_id","status","prompt_bytes"],"type":"object"},"permissions":["ai.complete"],"title":"流式续写小说章节正文"},{"id":"writer.outline_json","input_schema":{"additionalProperties":false,"properties":{"book_title":{"maxLength":100,"minLength":1,"type":"string"},"chapter_no":{"maximum":5000,"minimum":1,"type":"integer"},"characters":{"maxLength":1200,"type":"string"},"foreshadowing":{"maxLength":1000,"type":"string"},"premise":{"maxLength":3000,"minLength":1,"type":"string"},"request_id":{"maxLength":36,"minLength":36,"type":"string"},"scene_count":{"maximum":8,"minimum":2,"type":"integer"}},"required":["request_id","book_title","premise"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"cost_microcredits":{"minimum":0,"type":"integer"},"input_tokens":{"minimum":0,"type":"integer"},"model":{"maxLength":128,"minLength":1,"type":"string"},"outline":{"additionalProperties":true,"type":["object","null"]},"output_tokens":{"minimum":0,"type":"integer"},"request_id":{"maxLength":36,"minLength":36,"type":"string"}},"required":["request_id","model","outline","input_tokens","output_tokens","cost_microcredits"],"type":"object"},"permissions":["ai.complete"],"title":"生成结构化 JSON 章节细纲"},{"id":"writer.cancel","input_schema":{"additionalProperties":false,"properties":{"request_id":{"maxLength":36,"minLength":36,"type":"string"}},"required":["request_id"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"request_id":{"maxLength":36,"minLength":36,"type":"string"},"status":{"enum":["cancel_requested"],"type":"string"}},"required":["request_id","status"],"type":"object"},"permissions":["ai.complete"],"title":"取消进行中的流式写作请求"}],"ai":{"max_call_microcredits":50000,"max_day_microcredits":500000,"max_output_tokens":1024,"model":"gpt/gpt-6.2-astra"},"backend":"backend/index.js","data":[],"files":[{"path":"backend/index.js","sha256":"d16880ac02d7a6563918bc4174002e08b77c92b6e54ef609db1fba7b1763e273"},{"path":"ui/index.html","sha256":"c82339630e2508d497ee75b1b666c7b0a64821f35d860dda2bb5d36c5034cd8e"}],"host_api":2,"http":[],"manifest_version":2,"name":"小说 AI 流式写作助手","page":"ui/index.html","permissions":["ai.complete"],"plugin_id":"novel-ai-writer","tasks":[],"tools":[],"ui":{"icon":"edit","surfaces":["workspace"]},"version":"2.0.0"},"version":1}