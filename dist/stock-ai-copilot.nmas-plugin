{"files":[{"content":"const MAX_PROMPT_BYTES = 8192;\nconst UUIDV4_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/;\n\nconst HORIZON_LABELS = {\n  short: '短期（1-3 个月，侧重财报催化与交易预期差）',\n  medium: '中期（3-12 个月，侧重业绩兑现与估值切换）',\n  long: '长期（1-3 年以上，侧重护城河、资本回报率与复利空间）',\n};\n\nconst FOCUS_LABELS = {\n  comprehensive: '全维度投资备忘录（核心结论、业务拆解、估值锚定、反方证伪与风险清单）',\n  earnings: '财报深度点评（超预期项、指引拆解、利润率弹性与关键 KPI 追踪）',\n  valuation: '估值与安全边际（DCF/相对估值区间、隐含增长假设与敏感性情景）',\n  moat: '护城河与竞争格局（供给壁垒、定价权、替代威胁与份额变化）',\n  risk: '反方压力测试（核心做空逻辑、尾部风险与仓位风控触发线）',\n};\n\nfunction utf8Bytes(str) {\n  let b = 0;\n  for (const ch of str) {\n    const cp = ch.codePointAt(0);\n    b += cp <= 0x7f ? 1 : cp <= 0x7ff ? 2 : cp <= 0xffff ? 3 : 4;\n  }\n  return b;\n}\n\nfunction cleanText(raw, maxChars) {\n  if (typeof raw !== 'string') return '';\n  return raw.replace(/\\0/g, '').trim().slice(0, maxChars);\n}\n\nfunction trimToUtf8Limit(str, limitBytes) {\n  if (utf8Bytes(str) <= limitBytes) return str;\n  let out = '';\n  let used = 0;\n  for (const ch of str) {\n    const cp = ch.codePointAt(0);\n    const need = cp <= 0x7f ? 1 : cp <= 0x7ff ? 2 : cp <= 0xffff ? 3 : 4;\n    if (used + need > limitBytes) break;\n    out += ch;\n    used += need;\n  }\n  return out;\n}\n\nfunction assertUuidV4(requestId) {\n  if (typeof requestId !== 'string' || !UUIDV4_RE.test(requestId)) {\n    const err = new Error('request_id 必须为小写 UUIDv4');\n    err.code = 'invalid_input';\n    throw err;\n  }\n}\n\nfunction buildMemoPrompt(input) {\n  const ticker = cleanText(input.ticker, 24).toUpperCase();\n  const company = cleanText(input.company_name, 80);\n  const market = input.market || 'US';\n  const horizonDesc = HORIZON_LABELS[input.horizon] || HORIZON_LABELS.medium;\n  const focusDesc = FOCUS_LABELS[input.focus] || FOCUS_LABELS.comprehensive;\n  const snapshot = cleanText(input.financial_snapshot, 1800) || '未提供额外财务快照，请基于给定投研线索进行分析，不要编造未经提供的精确财务数字。';\n  const thesis = cleanText(input.thesis_context, 3200);\n\n  if (!ticker || !company || !thesis) {\n    const err = new Error('股票代码、公司名称与核心投研上下文不能为空');\n    err.code = 'invalid_input';\n    throw err;\n  }\n\n  const header = [\n    '你是一位机构级买方股票研究员，请基于用户提供的财务快照与投研线索，输出一份结构严谨、观点鲜明的中文 Markdown 投研备忘录（严格基于输入事实推导，缺失数据请明确标注「待补充」，文末附简短合规风险提示：仅供研究参考，不构成投资建议）。',\n    `标的：${ticker} · ${company}（市场：${market}）`,\n    `研究周期：${horizonDesc}`,\n    `分析侧重：${focusDesc}`,\n    '--- 财务与估值快照 ---',\n    snapshot,\n    '--- 投研线索与核心假设 ---',\n  ].join('\\n');\n\n  const footer = '\\n--- 请按 Markdown 二级标题直接输出投研备忘录 ---';\n  const overhead = utf8Bytes(header) + utf8Bytes(footer) + 1;\n  const safeThesis = trimToUtf8Limit(thesis, Math.max(256, MAX_PROMPT_BYTES - overhead));\n  const prompt = `${header}\\n${safeThesis}${footer}`;\n  return { prompt, promptBytes: utf8Bytes(prompt) };\n}\n\nfunction buildRatingPrompt(input) {\n  const ticker = cleanText(input.ticker, 24).toUpperCase();\n  const company = cleanText(input.company_name, 80);\n  const market = input.market || 'US';\n  const priceLine =\n    typeof input.current_price === 'number' && Number.isFinite(input.current_price)\n      ? `当前参考价：${input.current_price}`\n      : '当前参考价：未提供';\n  const snapshot = cleanText(input.financial_snapshot, 1800) || '未提供财务快照';\n  const thesis = cleanText(input.thesis_context, 3200);\n\n  if (!ticker || !company || !thesis) {\n    const err = new Error('股票代码、公司名称与投研上下文不能为空');\n    err.code = 'invalid_input';\n    throw err;\n  }\n\n  const header = [\n    '你是一位机构买方投资委员会评审员，请严格返回一个合法 JSON 对象（不要使用 Markdown 代码块或任何额外解释）。',\n    'JSON 字段必须包含：',\n    '{',\n    '  \"ticker\": \"代码\",',\n    '  \"stance\": \"bullish | neutral | bearish\",',\n    '  \"conviction_score\": 1到100的整数,',\n    '  \"summary\": \"一句话核心评级结论\",',\n    '  \"valuation_view\": \"低估 | 合理 | 偏高 | 待验证\",',\n    '  \"bull_case\": [\"多头核心论据1\", \"多头核心论据2\"],',\n    '  \"bear_case\": [\"空头核心风险1\", \"空头核心风险2\"],',\n    '  \"catalysts\": [\"未来关键催化事件1\", \"催化事件2\"],',\n    '  \"invalidation_triggers\": [\"逻辑证伪触发条件1\"],',\n    '  \"disclaimer\": \"仅供研究参考，不构成投资建议\"',\n    '}',\n    `标的：${ticker} · ${company}（市场：${market}）`,\n    priceLine,\n    '--- 财务与估值快照 ---',\n    snapshot,\n    '--- 投研线索 ---',\n  ].join('\\n');\n\n  const overhead = utf8Bytes(header) + 1;\n  const safeThesis = trimToUtf8Limit(thesis, Math.max(256, MAX_PROMPT_BYTES - overhead));\n  return `${header}\\n${safeThesis}`;\n}\n\nexport default async function (request) {\n  const { kind, contribution, input } = request ?? {};\n  const args = input && typeof input === 'object' ? input : {};\n\n  if (kind === 'action') {\n    if (contribution === 'copilot.stream_memo') {\n      assertUuidV4(args.request_id);\n      const { prompt, promptBytes } = buildMemoPrompt(args);\n      const res = await globalThis.nmas.ai.stream_start({\n        request_id: args.request_id,\n        prompt,\n      });\n      return {\n        request_id: res.request_id,\n        status: res.status,\n        prompt_bytes: promptBytes,\n      };\n    }\n\n    if (contribution === 'copilot.rating_json') {\n      assertUuidV4(args.request_id);\n      const prompt = buildRatingPrompt(args);\n      const res = await globalThis.nmas.ai.complete({\n        request_id: args.request_id,\n        prompt,\n        format: 'json',\n      });\n      const rating =\n        res.json !== null && typeof res.json === 'object' && !Array.isArray(res.json)\n          ? res.json\n          : res.json !== null\n            ? { items: res.json }\n            : null;\n      return {\n        request_id: args.request_id,\n        model: res.model,\n        rating,\n        input_tokens: res.input_tokens,\n        output_tokens: res.output_tokens,\n        cost_microcredits: res.cost_microcredits,\n      };\n    }\n\n    if (contribution === 'copilot.cancel') {\n      assertUuidV4(args.request_id);\n      const res = await globalThis.nmas.ai.cancel({\n        request_id: args.request_id,\n      });\n      return {\n        request_id: res.request_id,\n        status: res.status,\n      };\n    }\n  }\n\n  throw new Error(`不支持的调用: ${kind}/${contribution}`);\n}\n","path":"backend/index.js"},{"content":"<!doctype html>\n<html lang=\"zh-CN\" data-theme=\"dark\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>股票 AI 流式投研副驾驶</title>\n  <style>\n    :root {\n      --bg: #050911;\n      --bg-elev: #0a1220;\n      --bg-card: #0f192b;\n      --bg-input: #070d18;\n      --fg: #eaf2ff;\n      --fg-muted: #8295b2;\n      --border: rgba(148, 163, 184, 0.16);\n      --border-strong: rgba(56, 189, 248, 0.44);\n      --cyan: #38bdf8;\n      --cyan-soft: rgba(56, 189, 248, 0.14);\n      --emerald: #34d399;\n      --emerald-soft: rgba(52, 211, 153, 0.14);\n      --amber: #f59e0b;\n      --amber-soft: rgba(245, 158, 11, 0.14);\n      --rose: #fb7185;\n      --rose-soft: rgba(251, 113, 133, 0.14);\n      --shadow: 0 14px 36px rgba(0, 0, 0, 0.42);\n      font: 13px/1.6 -apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"PingFang SC\", system-ui, sans-serif;\n    }\n    html[data-theme=\"light\"] {\n      --bg: #f1f5f9;\n      --bg-elev: #ffffff;\n      --bg-card: #ffffff;\n      --bg-input: #f8fafc;\n      --fg: #0f172a;\n      --fg-muted: #64748b;\n      --border: rgba(15, 23, 42, 0.12);\n      --border-strong: rgba(2, 132, 199, 0.4);\n      --cyan: #0284c7;\n      --cyan-soft: rgba(2, 132, 199, 0.1);\n      --emerald: #059669;\n      --emerald-soft: rgba(5, 150, 105, 0.1);\n      --amber: #d97706;\n      --amber-soft: rgba(217, 119, 6, 0.1);\n      --rose: #e11d48;\n      --rose-soft: rgba(225, 29, 72, 0.1);\n      --shadow: 0 8px 24px rgba(15, 23, 42, 0.06);\n    }\n    * { box-sizing: border-box; }\n    body { margin: 0; background: var(--bg); color: var(--fg); min-height: 100vh; }\n    .mono { font-family: ui-monospace, \"SF Mono\", Menlo, Consolas, monospace; font-variant-numeric: tabular-nums; }\n    .shell { max-width: 1320px; margin: 0 auto; padding: 16px; display: flex; flex-direction: column; gap: 14px; }\n\n    .topbar { background: var(--bg-elev); border: 1px solid var(--border); border-radius: 14px; padding: 14px 18px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; box-shadow: var(--shadow); }\n    .brand-tag { font-size: 10.5px; letter-spacing: 0.15em; color: var(--cyan); font-weight: 700; text-transform: uppercase; }\n    .topbar h1 { margin: 2px 0 0; font-size: 17px; font-weight: 700; }\n    .subline { font-size: 12px; color: var(--fg-muted); }\n\n    .tabs { display: flex; gap: 6px; background: var(--bg-input); padding: 4px; border-radius: 10px; border: 1px solid var(--border); }\n    .tabs button { border: 0; background: transparent; color: var(--fg-muted); padding: 6px 14px; border-radius: 7px; font-weight: 600; cursor: pointer; }\n    .tabs button.active { background: var(--cyan); color: #04101d; }\n    html[data-theme=\"light\"] .tabs button.active { color: #fff; }\n\n    .status-strip { padding: 8px 14px; border-radius: 10px; background: var(--bg-card); border: 1px solid var(--border); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px; font-size: 12px; color: var(--fg-muted); }\n    .status-strip[data-kind=\"streaming\"] { border-color: var(--border-strong); color: var(--cyan); }\n    .status-strip[data-kind=\"ok\"] { border-color: rgba(52, 211, 153, 0.45); color: var(--emerald); }\n    .status-strip[data-kind=\"error\"] { border-color: rgba(251, 113, 133, 0.45); color: var(--rose); }\n\n    .workspace { display: grid; grid-template-columns: minmax(330px, 440px) minmax(0, 1fr); gap: 14px; align-items: start; }\n    @media (max-width: 920px) { .workspace { grid-template-columns: 1fr; } }\n\n    .card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 14px; padding: 15px; box-shadow: var(--shadow); display: flex; flex-direction: column; gap: 11px; min-width: 0; }\n    .card h2 { margin: 0; font-size: 14px; font-weight: 700; }\n    .row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }\n    .between { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: space-between; }\n\n    label.field { display: flex; flex-direction: column; gap: 4px; font-size: 11.5px; color: var(--fg-muted); font-weight: 600; }\n    input, select, textarea, button { font: inherit; color: var(--fg); background: var(--bg-input); border: 1px solid var(--border); border-radius: 8px; padding: 7px 10px; }\n    textarea { width: 100%; resize: vertical; line-height: 1.6; }\n    button { cursor: pointer; background: var(--bg-elev); font-weight: 500; }\n    button:disabled { opacity: 0.45; cursor: not-allowed; }\n    button.primary { background: var(--cyan); border-color: var(--cyan); color: #04101d; font-weight: 700; }\n    html[data-theme=\"light\"] button.primary { color: #fff; }\n    button.danger { color: var(--rose); border-color: rgba(251, 113, 133, 0.45); background: var(--rose-soft); font-weight: 600; }\n    button.chip { font-size: 11.5px; padding: 4px 9px; border-radius: 99px; color: var(--fg-muted); }\n    button.chip:hover { color: var(--fg); border-color: var(--border-strong); }\n\n    .badge { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; padding: 2px 9px; border-radius: 99px; border: 1px solid var(--border); font-weight: 600; }\n    .b-cyan { color: var(--cyan); border-color: var(--border-strong); background: var(--cyan-soft); }\n    .b-emerald { color: var(--emerald); border-color: rgba(52, 211, 153, 0.45); background: var(--emerald-soft); }\n    .b-amber { color: var(--amber); border-color: rgba(245, 158, 11, 0.45); background: var(--amber-soft); }\n    .b-rose { color: var(--rose); border-color: rgba(251, 113, 133, 0.45); background: var(--rose-soft); }\n\n    .memo-canvas {\n      min-height: 440px;\n      max-height: 640px;\n      overflow: auto;\n      padding: 16px 18px;\n      border-radius: 11px;\n      border: 1px solid var(--border);\n      background: var(--bg-input);\n      white-space: pre-wrap;\n      word-break: break-word;\n      font-size: 13.5px;\n      line-height: 1.75;\n    }\n    .memo-canvas.streaming::after {\n      content: \"▍\";\n      display: inline-block;\n      margin-left: 2px;\n      color: var(--cyan);\n      animation: blink 1s steps(1) infinite;\n    }\n    @keyframes blink { 50% { opacity: 0; } }\n\n    .rating-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }\n    @media (max-width: 700px) { .rating-grid { grid-template-columns: 1fr; } }\n    .panel { border: 1px solid var(--border); border-radius: 10px; padding: 12px; background: var(--bg-input); display: flex; flex-direction: column; gap: 6px; }\n    .panel ul { margin: 0; padding-left: 18px; display: flex; flex-direction: column; gap: 4px; }\n    pre.json-view { margin: 0; padding: 12px; border-radius: 10px; border: 1px solid var(--border); background: var(--bg-input); max-height: 260px; overflow: auto; font-size: 12px; line-height: 1.55; }\n    [hidden] { display: none !important; }\n  \n    /* === V2 Host Theme & Compact Surface Start === */\n    :root[data-theme=\"dark\"], html[data-theme=\"dark\"] { color-scheme: dark; --bg: #050911; --bg-elev: #0a1220; --bg-card: #0f192b; --fg: #eaf2ff; --fg-muted: #8295b2; --border: rgba(148, 163, 184, 0.16); --cyan: #38bdf8; --v2-host-accent: #38bdf8; }\n    :root[data-theme=\"light\"], html[data-theme=\"light\"] { color-scheme: light; --bg: #f1f5f9; --bg-elev: #ffffff; --bg-card: #ffffff; --fg: #0f172a; --fg-muted: #64748b; --border: rgba(15, 23, 42, 0.12); --cyan: #0284c7; --v2-host-accent: #0284c7; }\n    :root[data-theme=\"dark\"]:not([data-theme-override=\"1\"]), html[data-theme=\"dark\"]:not([data-theme-override=\"1\"]) { --bg: var(--host-bg, #050911); --bg-elev: var(--host-surface, #0a1220); --bg-card: var(--host-surface, #0f192b); --fg: var(--host-fg, #eaf2ff); --fg-muted: var(--host-muted, #8295b2); --border: var(--host-border, rgba(148, 163, 184, 0.16)); --v2-host-accent: var(--host-primary, #38bdf8); }\n    :root[data-theme=\"light\"]:not([data-theme-override=\"1\"]), html[data-theme=\"light\"]:not([data-theme-override=\"1\"]) { --bg: var(--host-bg, #f1f5f9); --bg-elev: var(--host-surface, #ffffff); --bg-card: var(--host-surface, #ffffff); --fg: var(--host-fg, #0f172a); --fg-muted: var(--host-muted, #64748b); --border: var(--host-border, rgba(15, 23, 42, 0.12)); --v2-host-accent: var(--host-primary, #0284c7); }\n    :is(button, input, select, textarea, .v2-surface-tab):focus-visible { outline: 2px solid var(--v2-host-accent, var(--cyan)); outline-offset: 1px; }\n    html[data-surface=\"chat\"], html[data-surface=\"assistant\"],\n    html[data-surface=\"chat\"] body, html[data-surface=\"assistant\"] body { overflow-x: hidden; }\n    html[data-surface=\"chat\"] .sidebar, html[data-surface=\"assistant\"] .sidebar { display: none !important; }\n    html[data-surface=\"chat\"] .shell, html[data-surface=\"assistant\"] .shell { max-width: 100%; }\n    html[data-surface=\"chat\"] .workspace, html[data-surface=\"assistant\"] .workspace, html[data-surface=\"chat\"] .rating-grid, html[data-surface=\"assistant\"] .rating-grid { grid-template-columns: 1fr !important; }\n    \n    html[data-surface=\"chat\"] :is(section, article, main, .card, .panel, .view),\n    html[data-surface=\"assistant\"] :is(section, article, main, .card, .panel, .view) { min-width: 0; }\n    html[data-surface=\"chat\"] :is(svg, canvas, pre),\n    html[data-surface=\"assistant\"] :is(svg, canvas, pre) { max-width: 100%; }\n    html[data-surface=\"chat\"] .shell, html[data-surface=\"assistant\"] .shell { padding: 10px; gap: 10px; }\n    html[data-surface=\"chat\"] .topbar, html[data-surface=\"assistant\"] .topbar { padding: 10px 12px; gap: 8px; border-radius: 10px; }\n    html[data-surface=\"chat\"] .tabs, html[data-surface=\"assistant\"] .tabs { width: 100%; overflow-x: auto; }\n    /* === V2 Host Theme & Compact Surface End === */\n  </style>\n</head>\n<body>\n  <div class=\"shell\">\n    <header class=\"topbar\">\n      <div>\n        <div class=\"brand-tag\">SLICE 5B · ISOLATED EQUITY AI + SSE COPILOT</div>\n        <h1>股票 AI 流式投研副驾驶</h1>\n        <div class=\"subline\">配合《股票 AI 投研与量化终端》使用 · 严格隔离沙箱（仅 <code>ai.complete</code> + 实时 SSE 推送）</div>\n      </div>\n      <div class=\"row\">\n        <div class=\"tabs\">\n          <button class=\"active\" data-tab=\"memo\" type=\"button\">📑 流式投研备忘录</button>\n          <button data-tab=\"rating\" type=\"button\">⚖️ 多空评级 JSON</button>\n        </div>\n        <button id=\"btn-theme\" type=\"button\">☀️ 外观</button>\n      </div>\n    </header>\n\n    <div id=\"status-strip\" class=\"status-strip\">\n      <span id=\"status-text\">正在挂载宿主 AI SSE 事件通道…</span>\n      <div class=\"row mono\" style=\"font-size:11.5px\">\n        <span id=\"sse-pill\" class=\"badge b-cyan\">SSE 未连接</span>\n        <span id=\"meta-req\">req: —</span>\n        <span id=\"meta-cost\">cost: —</span>\n      </div>\n    </div>\n\n    <!-- TAB 1: 流式投研备忘录 -->\n    <section id=\"tab-memo\" class=\"workspace\">\n      <div class=\"card\">\n        <div class=\"between\">\n          <h2>标的信息与投研输入</h2>\n          <div class=\"row\">\n            <button id=\"btn-preset-nvda\" class=\"chip\" type=\"button\">NVDA 示例</button>\n            <button id=\"btn-preset-hk\" class=\"chip\" type=\"button\">0700.HK 示例</button>\n          </div>\n        </div>\n        <div class=\"row\">\n          <label class=\"field\" style=\"width:116px\">股票代码\n            <input id=\"m-ticker\" class=\"mono\" maxlength=\"24\" value=\"NVDA\" placeholder=\"NVDA / 0700.HK\">\n          </label>\n          <label class=\"field\" style=\"flex:1\">公司名称\n            <input id=\"m-company\" maxlength=\"80\" value=\"NVIDIA Corporation\">\n          </label>\n          <label class=\"field\" style=\"width:94px\">市场\n            <select id=\"m-market\">\n              <option value=\"US\" selected>美股 US</option>\n              <option value=\"HK\">港股 HK</option>\n              <option value=\"CN\">A股 CN</option>\n              <option value=\"GLOBAL\">全球</option>\n            </select>\n          </label>\n        </div>\n        <div class=\"row\">\n          <label class=\"field\" style=\"flex:1\">研究周期\n            <select id=\"m-horizon\">\n              <option value=\"short\">短期（1-3 个月）</option>\n              <option value=\"medium\" selected>中期（3-12 个月）</option>\n              <option value=\"long\">长期（1-3 年+）</option>\n            </select>\n          </label>\n          <label class=\"field\" style=\"flex:1.2\">分析侧重\n            <select id=\"m-focus\">\n              <option value=\"comprehensive\" selected>全维度投研备忘录</option>\n              <option value=\"earnings\">财报深度点评</option>\n              <option value=\"valuation\">估值与安全边际</option>\n              <option value=\"moat\">护城河与竞争格局</option>\n              <option value=\"risk\">反方压力测试</option>\n            </select>\n          </label>\n        </div>\n        <label class=\"field\">财务与估值快照（可选）\n          <textarea id=\"m-fin\" rows=\"3\" maxlength=\"1800\" placeholder=\"粘贴 PE/PS、营收 YoY、毛利率、自由现金流、指引区间等核心指标…\"></textarea>\n        </label>\n        <label class=\"field\">核心投研线索与待验证假设\n          <textarea id=\"m-thesis\" rows=\"6\" maxlength=\"3200\" placeholder=\"粘贴财报要点、电话会纪要或你的核心多空假设，副驾驶将流式生成机构级研报…\"></textarea>\n        </label>\n        <div class=\"row\">\n          <button id=\"btn-memo-start\" class=\"primary\" style=\"flex:1\" type=\"button\">⚡ 开始流式生成研报</button>\n          <button id=\"btn-memo-stop\" class=\"danger\" type=\"button\" disabled>■ 停止生成</button>\n        </div>\n      </div>\n\n      <div class=\"card\">\n        <div class=\"between\">\n          <div class=\"row\">\n            <h2>流式投研备忘录</h2>\n            <span id=\"stream-metrics\" class=\"badge b-amber mono\">0 字 · 0 chunks · seq 0</span>\n          </div>\n          <div class=\"row\">\n            <button id=\"btn-copy-memo\" type=\"button\" disabled>📋 复制 Markdown 研报</button>\n            <button id=\"btn-clear-memo\" type=\"button\">清空</button>\n          </div>\n        </div>\n        <div id=\"memo-canvas\" class=\"memo-canvas\">填写标的与投研线索后点击「开始流式生成研报」，实时接收宿主 <code>ai.delta</code> / <code>ai.done</code> SSE 流。</div>\n      </div>\n    </section>\n\n    <!-- TAB 2: 多空评级 JSON -->\n    <section id=\"tab-rating\" class=\"workspace\" hidden>\n      <div class=\"card\">\n        <div class=\"between\">\n          <h2>多空评级委员会输入</h2>\n          <button id=\"btn-sync-from-memo\" class=\"chip\" type=\"button\">↙ 同步左侧标的输入</button>\n        </div>\n        <div class=\"row\">\n          <label class=\"field\" style=\"width:110px\">代码\n            <input id=\"r-ticker\" class=\"mono\" maxlength=\"24\" value=\"NVDA\">\n          </label>\n          <label class=\"field\" style=\"flex:1\">公司名称\n            <input id=\"r-company\" maxlength=\"80\" value=\"NVIDIA Corporation\">\n          </label>\n          <label class=\"field\" style=\"width:98px\">参考现价\n            <input id=\"r-price\" type=\"number\" min=\"0\" step=\"0.01\" placeholder=\"可选\">\n          </label>\n        </div>\n        <label class=\"field\">财务与估值快照\n          <textarea id=\"r-fin\" rows=\"3\" maxlength=\"1800\"></textarea>\n        </label>\n        <label class=\"field\">核心多空争议点与基本面线索\n          <textarea id=\"r-thesis\" rows=\"6\" maxlength=\"3200\"></textarea>\n        </label>\n        <button id=\"btn-rating-run\" class=\"primary\" type=\"button\">⚖️ 生成结构化 JSON 多空评级</button>\n      </div>\n\n      <div class=\"card\">\n        <div class=\"between\">\n          <div class=\"row\">\n            <h2>多空评级矩阵</h2>\n            <span id=\"rating-receipt\" class=\"badge b-emerald mono\">待生成</span>\n          </div>\n          <div class=\"row\">\n            <button id=\"btn-copy-rating-md\" type=\"button\" disabled>📋 复制 Markdown</button>\n            <button id=\"btn-copy-rating-json\" type=\"button\" disabled>复制 JSON</button>\n          </div>\n        </div>\n        <div id=\"rating-view\" style=\"display:flex;flex-direction:column;gap:10px\">\n          <div style=\"color:var(--fg-muted);font-size:12.5px\">点击左侧生成按钮，将通过 <code>nmas.ai.complete({ format: \"json\" })</code> 输出结构化多空评级。</div>\n        </div>\n        <pre id=\"rating-raw\" class=\"json-view mono\" hidden></pre>\n      </div>\n    </section>\n  </div>\n\n  <script>\n    (() => {\n      const plugin = window.nmasPlugin;\n      const $ = id => document.getElementById(id);\n\n      let activeRequestId = null;\n      let streaming = false;\n      let streamText = '';\n      let chunkCount = 0;\n      let lastSeq = 0;\n      let lastRating = null;\n\n      function uuidv4Lower() {\n        const b = crypto.getRandomValues(new Uint8Array(16));\n        b[6] = (b[6] & 0x0f) | 0x40;\n        b[8] = (b[8] & 0x3f) | 0x80;\n        const h = Array.from(b, x => x.toString(16).padStart(2, '0')).join('');\n        return `${h.slice(0, 8)}-${h.slice(8, 12)}-${h.slice(12, 16)}-${h.slice(16, 20)}-${h.slice(20)}`;\n      }\n\n      function setStatus(text, kind = '') {\n        $('status-text').textContent = text;\n        $('status-strip').dataset.kind = kind;\n      }\n\n      function updateStreamMetrics() {\n        $('stream-metrics').textContent = `${streamText.length} 字 · ${chunkCount} chunks · seq ${lastSeq}`;\n        $('btn-copy-memo').disabled = !streamText.length;\n        $('btn-memo-start').disabled = streaming;\n        $('btn-memo-stop').disabled = !streaming || !activeRequestId;\n        $('memo-canvas').classList.toggle('streaming', streaming);\n      }\n\n      function handleAiEvent(evt) {\n        if (!evt || typeof evt !== 'object') return;\n        if (!activeRequestId || evt.request_id !== activeRequestId) return;\n        if (typeof evt.seq === 'number' && evt.seq <= lastSeq) return;\n        if (typeof evt.seq === 'number') lastSeq = evt.seq;\n\n        if (evt.type === 'ai.delta') {\n          if (typeof evt.text === 'string' && evt.text.length > 0) {\n            if (chunkCount === 0) streamText = '';\n            streamText += evt.text;\n            chunkCount += 1;\n            const canvas = $('memo-canvas');\n            canvas.textContent = streamText;\n            canvas.scrollTop = canvas.scrollHeight;\n            setStatus(`流式接收研报中（seq #${lastSeq}）…`, 'streaming');\n            updateStreamMetrics();\n          }\n          return;\n        }\n\n        if (evt.type === 'ai.done') {\n          streaming = false;\n          const cost = Number.isInteger(evt.cost_microcredits) ? evt.cost_microcredits : 0;\n          $('meta-cost').textContent = `cost: ${cost} µcr`;\n          setStatus(`投研备忘录流式生成完成 · 共 ${streamText.length} 字 · 消耗 ${cost} microcredits`, 'ok');\n          updateStreamMetrics();\n          return;\n        }\n\n        if (evt.type === 'ai.error') {\n          streaming = false;\n          const code = evt.code || 'unknown_error';\n          setStatus(`AI 流式投研中止：error_code=${code}`, 'error');\n          updateStreamMetrics();\n        }\n      }\n\n      async function subscribeAiEvents() {\n        if (typeof plugin?.onAiEvent !== 'function') {\n          $('sse-pill').className = 'badge b-rose';\n          $('sse-pill').textContent = '未检测到宿主 onAiEvent';\n          setStatus('请在 Velai Desktop V2 工作区中打开本伴生插件以启用真实 SSE 流。', 'error');\n          return;\n        }\n        try {\n          await plugin.onAiEvent(handleAiEvent);\n          $('sse-pill').className = 'badge b-emerald';\n          $('sse-pill').textContent = 'SSE 已订阅';\n          setStatus('宿主 AI SSE 通道就绪，可直接发起流式投研或结构化多空评级。', 'ok');\n        } catch (e) {\n          $('sse-pill').className = 'badge b-rose';\n          $('sse-pill').textContent = 'SSE 订阅失败';\n          setStatus(`订阅 onAiEvent 失败：${e?.message || e}`, 'error');\n        }\n      }\n\n      async function copyText(text, label) {\n        try {\n          await navigator.clipboard.writeText(text);\n          setStatus(`已复制${label}到剪贴板。`, 'ok');\n        } catch (e) {\n          setStatus(`剪贴板复制失败：${e?.message || e}`, 'error');\n        }\n      }\n\n      function ratingToMarkdown(r) {\n        if (!r || typeof r !== 'object') return '';\n        const lines = [\n          `# ${r.ticker || '标的'} 多空评级报告`,\n          `- **立场**：${r.stance || '—'}（信心分：${r.conviction_score ?? '—'}/100）`,\n          `- **估值判断**：${r.valuation_view || '—'}`,\n          `- **核心结论**：${r.summary || '—'}`,\n        ];\n        if (Array.isArray(r.bull_case) && r.bull_case.length) {\n          lines.push('\\n## 多头核心论据');\n          for (const x of r.bull_case) lines.push(`- ${x}`);\n        }\n        if (Array.isArray(r.bear_case) && r.bear_case.length) {\n          lines.push('\\n## 空头与主要风险');\n          for (const x of r.bear_case) lines.push(`- ${x}`);\n        }\n        if (Array.isArray(r.catalysts) && r.catalysts.length) {\n          lines.push('\\n## 关键催化');\n          for (const x of r.catalysts) lines.push(`- ${x}`);\n        }\n        if (Array.isArray(r.invalidation_triggers) && r.invalidation_triggers.length) {\n          lines.push('\\n## 逻辑证伪触发线');\n          for (const x of r.invalidation_triggers) lines.push(`- ${x}`);\n        }\n        lines.push(`\\n> ${r.disclaimer || '仅供研究参考，不构成投资建议'}`);\n        return lines.join('\\n');\n      }\n\n      function renderRating(r) {\n        const box = $('rating-view');\n        box.replaceChildren();\n        if (!r || typeof r !== 'object') {\n          box.textContent = '模型未返回可解析的 JSON 对象。';\n          return;\n        }\n        const stance = String(r.stance || 'neutral').toLowerCase();\n        const badgeCls = stance === 'bullish' ? 'b-emerald' : stance === 'bearish' ? 'b-rose' : 'b-amber';\n        const stanceZh = stance === 'bullish' ? '看多 Bullish' : stance === 'bearish' ? '看空 Bearish' : '中性 Neutral';\n\n        const summary = document.createElement('div');\n        summary.className = 'panel';\n        const top = document.createElement('div');\n        top.className = 'between';\n        const left = document.createElement('strong');\n        left.style.fontSize = '15px';\n        left.textContent = `${r.ticker || $('r-ticker').value.trim()} · ${r.valuation_view || '估值待评'}`;\n        const right = document.createElement('div');\n        right.className = 'row';\n        const b1 = document.createElement('span'); b1.className = `badge ${badgeCls}`; b1.textContent = stanceZh;\n        const b2 = document.createElement('span'); b2.className = 'badge b-cyan mono'; b2.textContent = `信心 ${r.conviction_score ?? '—'}/100`;\n        right.append(b1, b2);\n        top.append(left, right);\n        const desc = document.createElement('div');\n        desc.textContent = r.summary || '';\n        summary.append(top, desc);\n        box.appendChild(summary);\n\n        const grid = document.createElement('div');\n        grid.className = 'rating-grid';\n        const makeListPanel = (title, items, color) => {\n          const p = document.createElement('div');\n          p.className = 'panel';\n          const h = document.createElement('strong');\n          h.style.color = color;\n          h.textContent = title;\n          p.appendChild(h);\n          const ul = document.createElement('ul');\n          for (const item of Array.isArray(items) ? items : []) {\n            const li = document.createElement('li');\n            li.textContent = String(item);\n            ul.appendChild(li);\n          }\n          p.appendChild(ul);\n          return p;\n        };\n        grid.append(\n          makeListPanel('📈 多头论据 (Bull Case)', r.bull_case, 'var(--emerald)'),\n          makeListPanel('📉 空头风险 (Bear Case)', r.bear_case, 'var(--rose)'),\n          makeListPanel('🚀 关键催化 (Catalysts)', r.catalysts, 'var(--cyan)'),\n          makeListPanel('⚠️ 证伪触发线 (Invalidation)', r.invalidation_triggers, 'var(--amber)'),\n        );\n        box.appendChild(grid);\n        $('rating-raw').hidden = false;\n        $('rating-raw').textContent = JSON.stringify(r, null, 2);\n      }\n\n      document.querySelectorAll('.tabs button').forEach(btn => {\n        btn.addEventListener('click', () => {\n          const tab = btn.dataset.tab;\n          document.querySelectorAll('.tabs button').forEach(b => b.classList.toggle('active', b === btn));\n          $('tab-memo').hidden = tab !== 'memo';\n          $('tab-rating').hidden = tab !== 'rating';\n        });\n      });\n\n      $('btn-theme').addEventListener('click', () => {\n        document.documentElement.dataset.theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';\n      });\n\n      $('btn-preset-nvda').addEventListener('click', () => {\n        $('m-ticker').value = 'NVDA';\n        $('m-company').value = 'NVIDIA Corporation';\n        $('m-market').value = 'US';\n        $('m-horizon').value = 'medium';\n        $('m-focus').value = 'comprehensive';\n        $('m-fin').value = 'Forward PE ~32x，数据中心营收 YoY +78%，毛利率 73.5%，自由现金流利润率 >45%，下一代机架平台产能持续爬坡。';\n        $('m-thesis').value = '核心关注三点：1）云厂商 AI CapEx 2026-2027 可见度与推理需求接棒训练的斜率；2）机架级整机交付良率对短期毛利率的扰动；3）自研 ASIC 在内部推理负载中份额提升是否侵蚀 CUDA 软件护城河。';\n      });\n\n      $('btn-preset-hk').addEventListener('click', () => {\n        $('m-ticker').value = '0700.HK';\n        $('m-company').value = '腾讯控股';\n        $('m-market').value = 'HK';\n        $('m-horizon').value = 'long';\n        $('m-focus').value = 'valuation';\n        $('m-fin').value = 'Non-IFRS PE ~16x，毛利率连续 8 季提升至 53%，年度回购注销规模超千亿港元，视频号广告与高毛利长青游戏驱动经营杠杆。';\n        $('m-thesis').value = '评估微信生态内 AI 搜索/Agent 商业化增量，以及高强度回购叠加自由现金流增长带来的股东回报率安全边际；需压力测试宏观消费疲软对金融科技与广告增速的拖累。';\n      });\n\n      $('btn-sync-from-memo').addEventListener('click', () => {\n        $('r-ticker').value = $('m-ticker').value;\n        $('r-company').value = $('m-company').value;\n        $('r-fin').value = $('m-fin').value;\n        $('r-thesis').value = $('m-thesis').value;\n        setStatus('已将备忘录页标的与投研线索同步至评级面板。', 'ok');\n      });\n\n      $('btn-memo-start').addEventListener('click', async () => {\n        if (streaming || typeof plugin?.action !== 'function') return;\n        const ticker = $('m-ticker').value.trim();\n        const company_name = $('m-company').value.trim();\n        const thesis_context = $('m-thesis').value.trim();\n        if (!ticker || !company_name || !thesis_context) {\n          setStatus('请完整填写股票代码、公司名称与核心投研线索。', 'error');\n          return;\n        }\n        const requestId = uuidv4Lower();\n        activeRequestId = requestId;\n        streaming = true;\n        streamText = '';\n        chunkCount = 0;\n        lastSeq = 0;\n        $('meta-req').textContent = `req: ${requestId.slice(0, 8)}…`;\n        $('meta-cost').textContent = 'cost: 流式计费中…';\n        $('memo-canvas').textContent = '';\n        updateStreamMetrics();\n        setStatus('已发起受管 AI 流式投研，等待首字 SSE 推送…', 'streaming');\n\n        try {\n          const res = await plugin.action('copilot.stream_memo', {\n            request_id: requestId,\n            ticker,\n            company_name,\n            market: $('m-market').value,\n            horizon: $('m-horizon').value,\n            focus: $('m-focus').value,\n            financial_snapshot: $('m-fin').value.trim(),\n            thesis_context,\n          });\n          setStatus(`流式投研已启动 (${res.status}) · Prompt ${res.prompt_bytes} B · 等待 ai.delta…`, 'streaming');\n        } catch (e) {\n          streaming = false;\n          updateStreamMetrics();\n          setStatus(`启动流式投研失败：${e?.message || e}`, 'error');\n        }\n      });\n\n      $('btn-memo-stop').addEventListener('click', async () => {\n        if (!activeRequestId || typeof plugin?.action !== 'function') return;\n        $('btn-memo-stop').disabled = true;\n        try {\n          const res = await plugin.action('copilot.cancel', { request_id: activeRequestId });\n          streaming = false;\n          updateStreamMetrics();\n          setStatus(`已发送停止指令 (${res.status})。`, 'ok');\n        } catch (e) {\n          setStatus(`停止生成失败：${e?.message || e}`, 'error');\n          updateStreamMetrics();\n        }\n      });\n\n      $('btn-copy-memo').addEventListener('click', () => {\n        const md = `# ${$('m-ticker').value.trim().toUpperCase()} ${$('m-company').value.trim()} 投研备忘录\\n\\n${streamText}`;\n        void copyText(md, ' Markdown 研报');\n      });\n\n      $('btn-clear-memo').addEventListener('click', () => {\n        if (streaming) return;\n        streamText = '';\n        chunkCount = 0;\n        lastSeq = 0;\n        $('memo-canvas').textContent = '画布已清空。';\n        updateStreamMetrics();\n      });\n\n      $('btn-rating-run').addEventListener('click', async () => {\n        if (typeof plugin?.action !== 'function') return;\n        const ticker = $('r-ticker').value.trim();\n        const company_name = $('r-company').value.trim();\n        const thesis_context = $('r-thesis').value.trim();\n        if (!ticker || !company_name || !thesis_context) {\n          setStatus('请填写代码、公司名称与多空争议线索。', 'error');\n          return;\n        }\n        const requestId = uuidv4Lower();\n        $('btn-rating-run').disabled = true;\n        $('meta-req').textContent = `req: ${requestId.slice(0, 8)}…`;\n        setStatus('正在调用受管 AI 生成结构化 JSON 多空评级…', 'streaming');\n        try {\n          const rawPrice = $('r-price').value.trim();\n          const current_price = rawPrice !== '' && Number.isFinite(Number(rawPrice)) ? Number(rawPrice) : null;\n          const res = await plugin.action('copilot.rating_json', {\n            request_id: requestId,\n            ticker,\n            company_name,\n            market: $('m-market').value,\n            current_price,\n            financial_snapshot: $('r-fin').value.trim(),\n            thesis_context,\n          });\n          lastRating = res.rating;\n          renderRating(res.rating);\n          $('rating-receipt').textContent = `${res.model} · in ${res.input_tokens} / out ${res.output_tokens} · ${res.cost_microcredits} µcr`;\n          $('meta-cost').textContent = `cost: ${res.cost_microcredits} µcr`;\n          $('btn-copy-rating-md').disabled = !lastRating;\n          $('btn-copy-rating-json').disabled = !lastRating;\n          setStatus(`多空评级 JSON 生成完成（消耗 ${res.cost_microcredits} microcredits）。`, 'ok');\n        } catch (e) {\n          setStatus(`多空评级生成失败：${e?.message || e}`, 'error');\n        } finally {\n          $('btn-rating-run').disabled = false;\n        }\n      });\n\n      $('btn-copy-rating-md').addEventListener('click', () => {\n        if (lastRating) void copyText(ratingToMarkdown(lastRating), ' Markdown 多空评级');\n      });\n      $('btn-copy-rating-json').addEventListener('click', () => {\n        if (lastRating) void copyText(JSON.stringify(lastRating, null, 2), ' JSON 多空评级');\n      });\n\n      void subscribeAiEvents();\n    })();\n  \n/* === V2 Host Theme & Compact Surface JS Start === */\n(() => {\n  const root = document.documentElement;\n  const BTN_MODE = \"emoji\";\n  const HAS_SIDEBAR = false;\n  const MAIN_SEL = \".shell\";\n  const INIT_MQ = false;\n  const VALID_THEMES = new Set(['light', 'dark']);\n  const VALID_SURFACES = new Set(['workspace', 'chat', 'assistant']);\n\n  const normalizeTheme = val => (val === 'light' || val === 'dark' ? val : null);\n\n  if (INIT_MQ && !normalizeTheme(root.getAttribute('data-theme'))) {\n    try {\n      const dark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;\n      root.setAttribute('data-theme', dark ? 'dark' : 'light');\n    } catch {}\n  }\n\n  let hostTheme = normalizeTheme(root.getAttribute('data-theme'));\n\n  function syncThemeButton(theme) {\n    const btn = document.getElementById('btn-theme');\n    if (!btn || !VALID_THEMES.has(theme)) return;\n    btn.setAttribute('aria-pressed', String(theme === 'dark'));\n    btn.dataset.activeTheme = theme;\n    btn.title = theme === 'dark' ? '当前深色主题，点击切换浅色' : '当前浅色主题，点击切换深色';\n    if (BTN_MODE === 'short') {\n      btn.textContent = theme === 'light' ? '☾ 深色' : '☀ 浅色';\n    } else if (BTN_MODE === 'emoji') {\n      const txt = (btn.textContent || '').trim();\n      const rest = txt.replace(/^(?:☀️|☀|🌙|☾|◐)\\s*/, '');\n      btn.textContent = (theme === 'light' ? '🌙 ' : '☀️ ') + (rest || '外观');\n    } else {\n      btn.textContent = theme === 'dark' ? '☀ 切换浅色' : '☾ 切换深色';\n    }\n  }\n\n  function applyHostTheme(raw) {\n    const data = raw && typeof raw === 'object'\n      ? (raw.theme || raw.surface || raw.tokens ? raw : (raw.payload && typeof raw.payload === 'object' ? raw.payload : raw))\n      : null;\n    if (!data || typeof data !== 'object') return;\n    const nextTheme = normalizeTheme(data.theme);\n    if (nextTheme) {\n      hostTheme = nextTheme;\n      root.removeAttribute('data-theme-override');\n      root.setAttribute('data-theme', nextTheme);\n      syncThemeButton(nextTheme);\n    }\n    if (typeof data.surface === 'string' && VALID_SURFACES.has(data.surface)) {\n      root.setAttribute('data-surface', data.surface);\n    }\n    if (data.tokens && typeof data.tokens === 'object') {\n      for (const [k, v] of Object.entries(data.tokens)) {\n        if (typeof v === 'string' && k) {\n          try { root.style.setProperty(k.startsWith('--') ? k : '--' + k, v); } catch {}\n        }\n      }\n    }\n  }\n\n  const initialTheme = normalizeTheme(root.getAttribute('data-theme'));\n  if (initialTheme) syncThemeButton(initialTheme);\n\n  const themeBtn = document.getElementById('btn-theme');\n  if (themeBtn) {\n    themeBtn.addEventListener('click', () => {\n      const cur = normalizeTheme(root.getAttribute('data-theme'));\n      if (!cur) return;\n      if (hostTheme && cur !== hostTheme) root.setAttribute('data-theme-override', '1');\n      else root.removeAttribute('data-theme-override');\n      syncThemeButton(cur);\n    });\n  }\n\n  try {\n    window.addEventListener('host.theme.changed', ev => {\n      try { applyHostTheme(ev && typeof ev === 'object' && 'detail' in ev ? ev.detail : ev); } catch {}\n    });\n  } catch {}\n  try {\n    const sub = globalThis.nmasPlugin?.subscribe?.('host.theme.changed', payload => {\n      try { applyHostTheme(payload); } catch {}\n    });\n    if (sub && typeof sub.catch === 'function') sub.catch(() => {});\n  } catch {}\n\n  if (HAS_SIDEBAR) {\n    const sidebar = document.querySelector('.sidebar');\n    const hostMain = document.querySelector(MAIN_SEL) || document.querySelector('.main, .main-area, .main-col, .workspace');\n    const srcBtns = sidebar ? Array.from(sidebar.querySelectorAll('button[data-view]')) : [];\n    if (sidebar && hostMain && srcBtns.length > 0 && !hostMain.querySelector('.v2-surface-nav')) {\n      const nav = document.createElement('nav');\n      nav.className = 'v2-surface-nav';\n      nav.setAttribute('aria-label', '视图切换');\n      const pairs = srcBtns.map(src => {\n        const clone = src.cloneNode(true);\n        clone.querySelectorAll('svg, .nav-badge, .pill, .mono').forEach(el => el.remove());\n        const navLeft = clone.querySelector('.nav-left');\n        let label = '';\n        if (navLeft) {\n          label = Array.from(navLeft.children).map(el => (el.textContent || '').trim()).filter(Boolean).join(' ');\n        } else {\n          label = (clone.textContent || '').replace(/\\s+/g, ' ').trim();\n        }\n        const tab = document.createElement('button');\n        tab.type = 'button';\n        tab.className = 'v2-surface-tab';\n        tab.dataset.surfaceView = src.dataset.view || '';\n        tab.textContent = label || src.dataset.view || '视图';\n        tab.addEventListener('click', () => { try { src.click(); } catch {} });\n        nav.appendChild(tab);\n        return [src, tab];\n      });\n      const syncNav = () => {\n        for (const [src, tab] of pairs) {\n          const active = src.classList.contains('active');\n          tab.classList.toggle('active', active);\n          if (active) tab.setAttribute('aria-current', 'page');\n          else tab.removeAttribute('aria-current');\n        }\n      };\n      syncNav();\n      hostMain.prepend(nav);\n      try {\n        const obs = new MutationObserver(syncNav);\n        obs.observe(sidebar, { subtree: true, attributes: true, attributeFilter: ['class'] });\n      } catch {}\n    }\n  }\n})();\n/* === V2 Host Theme & Compact Surface JS End === */\n</script>\n</body>\n</html>\n","path":"ui/index.html"}],"format":"nmas-plugin","manifest":{"actions":[{"id":"copilot.stream_memo","input_schema":{"additionalProperties":false,"properties":{"company_name":{"maxLength":80,"minLength":1,"type":"string"},"financial_snapshot":{"maxLength":1800,"type":"string"},"focus":{"enum":["comprehensive","earnings","valuation","moat","risk"],"type":"string"},"horizon":{"enum":["short","medium","long"],"type":"string"},"market":{"enum":["US","HK","CN","GLOBAL"],"type":"string"},"request_id":{"maxLength":36,"minLength":36,"type":"string"},"thesis_context":{"maxLength":3200,"minLength":1,"type":"string"},"ticker":{"maxLength":24,"minLength":1,"type":"string"}},"required":["request_id","ticker","company_name","thesis_context"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"prompt_bytes":{"maximum":8192,"minimum":1,"type":"integer"},"request_id":{"maxLength":36,"minLength":36,"type":"string"},"status":{"enum":["started"],"type":"string"}},"required":["request_id","status","prompt_bytes"],"type":"object"},"permissions":["ai.complete"],"title":"流式生成股票深度投研备忘录"},{"id":"copilot.rating_json","input_schema":{"additionalProperties":false,"properties":{"company_name":{"maxLength":80,"minLength":1,"type":"string"},"current_price":{"minimum":0,"type":["number","null"]},"financial_snapshot":{"maxLength":1800,"type":"string"},"market":{"enum":["US","HK","CN","GLOBAL"],"type":"string"},"request_id":{"maxLength":36,"minLength":36,"type":"string"},"thesis_context":{"maxLength":3200,"minLength":1,"type":"string"},"ticker":{"maxLength":24,"minLength":1,"type":"string"}},"required":["request_id","ticker","company_name","thesis_context"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"cost_microcredits":{"minimum":0,"type":"integer"},"input_tokens":{"minimum":0,"type":"integer"},"model":{"maxLength":128,"minLength":1,"type":"string"},"output_tokens":{"minimum":0,"type":"integer"},"rating":{"additionalProperties":true,"type":["object","null"]},"request_id":{"maxLength":36,"minLength":36,"type":"string"}},"required":["request_id","model","rating","input_tokens","output_tokens","cost_microcredits"],"type":"object"},"permissions":["ai.complete"],"title":"生成结构化 JSON 多空评级矩阵"},{"id":"copilot.cancel","input_schema":{"additionalProperties":false,"properties":{"request_id":{"maxLength":36,"minLength":36,"type":"string"}},"required":["request_id"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"request_id":{"maxLength":36,"minLength":36,"type":"string"},"status":{"enum":["cancel_requested"],"type":"string"}},"required":["request_id","status"],"type":"object"},"permissions":["ai.complete"],"title":"取消进行中的流式投研请求"}],"ai":{"max_call_microcredits":50000,"max_day_microcredits":500000,"max_output_tokens":1024,"model":"gpt/gpt-6.2-astra"},"backend":"backend/index.js","data":[],"files":[{"path":"backend/index.js","sha256":"06a28735dd9a7665bd07ae81e91ce7b3b8018bb4c3838900bf9850160a40e873"},{"path":"ui/index.html","sha256":"402343d5b39bd5d97c7c1e40e2fe507c956b86db2c7758dad9f9e00fe999fbc1"}],"host_api":2,"http":[],"manifest_version":2,"name":"股票 AI 流式投研副驾驶","page":"ui/index.html","permissions":["ai.complete"],"plugin_id":"stock-ai-copilot","tasks":[],"tools":[],"ui":{"icon":"table","surfaces":["workspace"]},"version":"2.0.0"},"version":1}