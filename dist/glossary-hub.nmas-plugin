{"files":[{"content":"const COLLECTION = 'glossary';\nconst KEY = 'terms';\nconst MAX_BYTES = 12 * 1024;\nconst MAX_TERMS = 100;\nconst DOC_FORMAT = 'velai.glossary-hub';\n\nfunction jsonBytes(v) {\n  let b = 0;\n  for (const ch of JSON.stringify(v)) {\n    const cp = ch.codePointAt(0);\n    b += cp <= 0x7f ? 1 : cp <= 0x7ff ? 2 : cp <= 0xffff ? 3 : 4;\n  }\n  return b;\n}\n\nfunction sortTerms(list) {\n  return list.slice().sort((a, b) => a.term.localeCompare(b.term, 'zh-CN'));\n}\n\nasync function readGlossary() {\n  const receipt = await globalThis.nmas.data.read({ collection: COLLECTION, key: KEY });\n  const doc = receipt.value === null ? { schema_version: 1, terms: [] } : receipt.value;\n  if (!doc || doc.schema_version !== 1 || !Array.isArray(doc.terms)) {\n    throw new Error('术语表格式无效');\n  }\n  return { revision: receipt.revision, terms: sortTerms(doc.terms) };\n}\n\nasync function writeGlossary(expectedRevision, terms) {\n  const value = { schema_version: 1, terms: sortTerms(terms) };\n  if (terms.length > MAX_TERMS || jsonBytes(value) > MAX_BYTES) {\n    return { status: 'limit', revision: expectedRevision };\n  }\n  try {\n    const receipt = await globalThis.nmas.data.write({\n      collection: COLLECTION,\n      key: KEY,\n      expected_revision: expectedRevision,\n      value,\n    });\n    return { status: 'saved', revision: receipt.revision };\n  } catch (err) {\n    if (err?.code === 'conflict' && err.outcome_unknown === false) {\n      return { status: 'conflict', revision: expectedRevision };\n    }\n    throw err;\n  }\n}\n\nexport default async function (request) {\n  const { kind, contribution, input } = request ?? {};\n\n  if (kind === 'action') {\n    if (contribution === 'glossary.list') return readGlossary();\n\n    if (contribution === 'glossary.save') {\n      const term = input.term.trim();\n      const def = input.definition.trim();\n      if (!term || !def) return { status: 'invalid_input', revision: input.expected_revision };\n      const data = await readGlossary();\n      if (data.revision !== input.expected_revision) return { status: 'conflict', revision: data.revision };\n      const record = { term, alias: input.alias.trim(), domain: input.domain.trim(), definition: def };\n      const idx = data.terms.findIndex(t => t.term.toLowerCase() === term.toLowerCase());\n      const next = idx >= 0 ? data.terms.map((t, i) => (i === idx ? record : t)) : [...data.terms, record];\n      return writeGlossary(input.expected_revision, next);\n    }\n\n    if (contribution === 'glossary.delete') {\n      const data = await readGlossary();\n      if (data.revision !== input.expected_revision) return { status: 'conflict', revision: data.revision };\n      const key = input.term.trim().toLowerCase();\n      if (!data.terms.some(t => t.term.toLowerCase() === key)) return { status: 'not_found', revision: data.revision };\n      const res = await writeGlossary(input.expected_revision, data.terms.filter(t => t.term.toLowerCase() !== key));\n      return res.status === 'saved' ? { status: 'deleted', revision: res.revision } : { status: 'conflict', revision: res.revision };\n    }\n\n    if (contribution === 'document.list') {\n      const data = await readGlossary();\n      return { items: data.terms.length ? [{ id: 'all', label: `项目全部术语 (${data.terms.length} 条)` }] : [] };\n    }\n\n    if (contribution === 'document.export') {\n      const data = await readGlossary();\n      if (input.id !== 'all') return { error: 'not_found' };\n      const text = JSON.stringify({ format: DOC_FORMAT, version: 1, terms: data.terms }, null, 2);\n      return { filename: 'project-glossary.json', text };\n    }\n\n    if (contribution === 'document.import') {\n      let parsed;\n      try { parsed = JSON.parse(input.text); } catch { return { imported: false, reason: 'invalid_json' }; }\n      if (parsed?.format !== DOC_FORMAT || parsed?.version !== 1 || !Array.isArray(parsed.terms)) {\n        return { imported: false, reason: 'invalid_document' };\n      }\n      const data = await readGlossary();\n      const map = new Map(data.terms.map(t => [t.term.toLowerCase(), t]));\n      for (const raw of parsed.terms) {\n        if (typeof raw?.term !== 'string' || !raw.term.trim() || typeof raw?.definition !== 'string' || !raw.definition.trim()) continue;\n        const term = raw.term.trim().slice(0, 64);\n        map.set(term.toLowerCase(), {\n          term,\n          alias: typeof raw.alias === 'string' ? raw.alias.trim().slice(0, 80) : '',\n          domain: typeof raw.domain === 'string' ? raw.domain.trim().slice(0, 40) : '',\n          definition: raw.definition.trim().slice(0, 400),\n        });\n      }\n      const res = await writeGlossary(data.revision, Array.from(map.values()));\n      return res.status === 'saved' ? { imported: true } : { imported: false, reason: res.status };\n    }\n  }\n\n  if (kind === 'tool') {\n    if (contribution === 'glossary.lookup') {\n      const data = await readGlossary();\n      const q = (input.query || '').trim().toLowerCase();\n      const domain = (input.domain || '').trim().toLowerCase();\n      const matched = data.terms.filter(t => {\n        if (domain && t.domain.toLowerCase() !== domain) return false;\n        if (q && !`${t.term} ${t.alias} ${t.definition}`.toLowerCase().includes(q)) return false;\n        return true;\n      });\n      return { success: true, status: 'ready', terms: matched.slice(0, 20) };\n    }\n\n    if (contribution === 'glossary.upsert') {\n      const term = input.term.trim();\n      const def = input.definition.trim();\n      if (!term || !def) return { success: false, status: 'invalid_input' };\n      const data = await readGlossary();\n      const record = { term, alias: (input.alias || '').trim(), domain: (input.domain || '').trim(), definition: def };\n      const idx = data.terms.findIndex(t => t.term.toLowerCase() === term.toLowerCase());\n      const next = idx >= 0 ? data.terms.map((t, i) => (i === idx ? record : t)) : [...data.terms, record];\n      const saved = await writeGlossary(data.revision, next);\n      return { success: saved.status === 'saved', status: saved.status };\n    }\n  }\n\n  throw new Error(`不支持的调用: ${kind}/${contribution}`);\n}\n","path":"backend/index.js"},{"content":"<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>项目术语表</title>\n  <style>\n    :root {\n      color-scheme: light dark;\n      --bg: Canvas; --fg: CanvasText; --muted: color-mix(in srgb, CanvasText 60%, transparent);\n      --border: color-mix(in srgb, CanvasText 18%, transparent);\n      --card: color-mix(in srgb, CanvasText 4%, Canvas);\n      --accent: #2563eb; --danger: #dc2626;\n      font: 14px/1.55 system-ui, -apple-system, sans-serif;\n    }\n    * { box-sizing: border-box; }\n    body { margin: 0; background: var(--bg); color: var(--fg); }\n    main { max-width: 900px; margin: 0 auto; padding: clamp(12px, 2.5vw, 20px); display: flex; flex-direction: column; gap: 12px; }\n    header, .row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: space-between; }\n    h1 { font-size: 18px; margin: 0; }\n    .form { border: 1px solid var(--border); border-radius: 10px; padding: 12px; background: var(--card); display: flex; flex-direction: column; gap: 8px; }\n    input, textarea, button { font: inherit; color: inherit; border: 1px solid var(--border); border-radius: 7px; padding: 6px 10px; background: var(--bg); }\n    textarea { width: 100%; min-height: 64px; resize: vertical; }\n    button { cursor: pointer; }\n    button.primary { background: var(--accent); border-color: var(--accent); color: #fff; }\n    button.danger { color: var(--danger); }\n    table { width: 100%; border-collapse: collapse; border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }\n    th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--border); vertical-align: top; }\n    th { background: var(--card); font-size: 12px; color: var(--muted); }\n    .tag { display: inline-block; font-size: 11px; padding: 1px 7px; border-radius: 99px; border: 1px solid var(--border); color: var(--muted); }\n    .status { font-size: 13px; color: var(--muted); margin: 0; }\n    .status[data-error=\"true\"] { color: var(--danger); }\n  </style>\n</head>\n<body>\n  <main>\n    <header>\n      <h1>项目术语表</h1>\n      <div class=\"row\">\n        <input id=\"search\" type=\"search\" placeholder=\"筛选术语、缩写或定义…\" autocomplete=\"off\">\n        <button id=\"btn-refresh\" type=\"button\">刷新</button>\n      </div>\n    </header>\n\n    <section class=\"form\">\n      <div class=\"row\">\n        <input id=\"f-term\" placeholder=\"术语 / 缩写（如：CAS）\" maxlength=\"64\" style=\"flex:1;min-width:140px\" autocomplete=\"off\">\n        <input id=\"f-alias\" placeholder=\"别名 / 英文全称\" maxlength=\"80\" style=\"flex:1;min-width:140px\" autocomplete=\"off\">\n        <input id=\"f-domain\" placeholder=\"领域（如：存储 / 业务）\" maxlength=\"40\" style=\"width:140px\" autocomplete=\"off\">\n        <button id=\"btn-save\" class=\"primary\" type=\"button\">保存术语</button>\n      </div>\n      <textarea id=\"f-def\" maxlength=\"400\" placeholder=\"准确、简洁的定义，帮助团队和 AI 保持同一口径…\"></textarea>\n    </section>\n\n    <p id=\"status\" class=\"status\" role=\"status\">正在读取当前项目术语表…</p>\n    <div style=\"overflow-x:auto\">\n      <table>\n        <thead><tr><th>术语</th><th>领域</th><th>定义</th><th style=\"width:120px\">操作</th></tr></thead>\n        <tbody id=\"tbody\"></tbody>\n      </table>\n    </div>\n  </main>\n  <script>\n    (() => {\n      const plugin = globalThis.nmasPlugin;\n      const $ = id => document.getElementById(id);\n      let revision = 0, terms = [], busy = false;\n      const setStatus = (t, e = false) => { $('status').textContent = t; $('status').dataset.error = String(e); };\n\n      function render() {\n        const q = $('search').value.trim().toLowerCase();\n        const shown = terms.filter(t => !q || `${t.term} ${t.alias} ${t.domain} ${t.definition}`.toLowerCase().includes(q));\n        const tbody = $('tbody');\n        tbody.replaceChildren();\n        if (!shown.length) {\n          const tr = document.createElement('tr');\n          const td = document.createElement('td');\n          td.colSpan = 4;\n          td.className = 'status';\n          td.textContent = terms.length ? '未找到匹配术语' : '当前项目尚未登记术语';\n          tr.appendChild(td);\n          tbody.appendChild(tr);\n          return;\n        }\n        for (const t of shown) {\n          const tr = document.createElement('tr');\n          const tdTerm = document.createElement('td');\n          const strong = document.createElement('strong');\n          strong.textContent = t.term;\n          tdTerm.appendChild(strong);\n          if (t.alias) {\n            const sub = document.createElement('div');\n            sub.className = 'status';\n            sub.textContent = t.alias;\n            tdTerm.appendChild(sub);\n          }\n          const tdDom = document.createElement('td');\n          if (t.domain) {\n            const sp = document.createElement('span');\n            sp.className = 'tag';\n            sp.textContent = t.domain;\n            tdDom.appendChild(sp);\n          }\n          const tdDef = document.createElement('td');\n          tdDef.textContent = t.definition;\n          const tdAct = document.createElement('td');\n          const edit = document.createElement('button');\n          edit.type = 'button';\n          edit.textContent = '编辑';\n          edit.style.marginRight = '4px';\n          edit.addEventListener('click', () => {\n            $('f-term').value = t.term;\n            $('f-alias').value = t.alias;\n            $('f-domain').value = t.domain;\n            $('f-def').value = t.definition;\n            $('f-def').focus();\n          });\n          const del = document.createElement('button');\n          del.type = 'button';\n          del.className = 'danger';\n          del.textContent = '删';\n          del.addEventListener('click', () => remove(t.term));\n          tdAct.append(edit, del);\n          tr.append(tdTerm, tdDom, tdDef, tdAct);\n          tbody.appendChild(tr);\n        }\n      }\n\n      async function load() {\n        if (typeof plugin?.action !== 'function') { setStatus('请在 Velai Desktop 项目会话中打开此插件。', true); return; }\n        try {\n          const res = await plugin.action('glossary.list', {});\n          revision = res.revision;\n          terms = res.terms;\n          render();\n          setStatus(`共 ${terms.length} 条项目术语（修订 #${revision}）`);\n        } catch (e) { setStatus(`读取失败：${e?.message || '请确认已选择项目主会话'}`, true); }\n      }\n\n      async function remove(term) {\n        if (busy) return;\n        busy = true;\n        try {\n          const res = await plugin.action('glossary.delete', { expected_revision: revision, term });\n          if (res.status === 'deleted') await load();\n          else setStatus(`删除未完成：${res.status}`, true);\n        } catch (e) { setStatus(`删除失败：${e?.message || '未知错误'}`, true); }\n        finally { busy = false; }\n      }\n\n      $('btn-save').addEventListener('click', async () => {\n        if (busy) return;\n        const term = $('f-term').value.trim();\n        const definition = $('f-def').value.trim();\n        if (!term || !definition) { setStatus('请填写术语名和定义。', true); return; }\n        busy = true;\n        try {\n          const res = await plugin.action('glossary.save', {\n            expected_revision: revision,\n            term,\n            alias: $('f-alias').value,\n            domain: $('f-domain').value,\n            definition,\n          });\n          if (res.status === 'saved') {\n            $('f-term').value = '';\n            $('f-alias').value = '';\n            $('f-domain').value = '';\n            $('f-def').value = '';\n            await load();\n            setStatus(`已保存术语「${term}」。`);\n          } else setStatus(`保存未完成：${res.status}`, true);\n        } catch (e) { setStatus(`保存失败：${e?.message || '未知错误'}`, true); }\n        finally { busy = false; }\n      });\n\n      $('search').addEventListener('input', render);\n      $('btn-refresh').addEventListener('click', load);\n      void load();\n    })();\n  </script>\n</body>\n</html>\n","path":"ui/index.html"}],"format":"nmas-plugin","manifest":{"actions":[{"id":"glossary.list","input_schema":{"additionalProperties":false,"properties":{},"required":[],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"revision":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"terms":{"items":{"additionalProperties":false,"properties":{"alias":{"maxLength":80,"type":"string"},"definition":{"maxLength":400,"minLength":1,"type":"string"},"domain":{"maxLength":40,"type":"string"},"term":{"maxLength":64,"minLength":1,"type":"string"}},"required":["term","alias","domain","definition"],"type":"object"},"type":"array"}},"required":["revision","terms"],"type":"object"},"permissions":["data.read"],"title":"读取项目术语列表"},{"id":"glossary.save","input_schema":{"additionalProperties":false,"properties":{"alias":{"maxLength":80,"type":"string"},"definition":{"maxLength":400,"minLength":1,"type":"string"},"domain":{"maxLength":40,"type":"string"},"expected_revision":{"maximum":9007199254740990,"minimum":0,"type":"integer"},"term":{"maxLength":64,"minLength":1,"type":"string"}},"required":["expected_revision","term","alias","domain","definition"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"revision":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"status":{"enum":["saved","conflict","limit","invalid_input"],"type":"string"}},"required":["status","revision"],"type":"object"},"permissions":["data.read","data.write"],"title":"保存术语定义"},{"id":"glossary.delete","input_schema":{"additionalProperties":false,"properties":{"expected_revision":{"maximum":9007199254740990,"minimum":0,"type":"integer"},"term":{"maxLength":64,"minLength":1,"type":"string"}},"required":["expected_revision","term"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"revision":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"status":{"enum":["deleted","not_found","conflict"],"type":"string"}},"required":["status","revision"],"type":"object"},"permissions":["data.read","data.write"],"title":"删除术语"},{"id":"document.list","input_schema":{"additionalProperties":false,"properties":{},"required":[],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"items":{"items":{"additionalProperties":false,"properties":{"id":{"maxLength":32,"minLength":1,"type":"string"},"label":{"maxLength":80,"minLength":1,"type":"string"}},"required":["id","label"],"type":"object"},"type":"array"}},"required":[],"type":"object"},"permissions":["data.read"],"title":"列出可导出的术语表"},{"id":"document.export","input_schema":{"additionalProperties":false,"properties":{"id":{"maxLength":32,"minLength":1,"type":"string"}},"required":["id"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"error":{"maxLength":64,"type":"string"},"filename":{"maxLength":64,"type":"string"},"text":{"maxLength":12288,"type":"string"}},"required":[],"type":"object"},"permissions":["data.read"],"title":"导出术语表 JSON"},{"id":"document.import","input_schema":{"additionalProperties":false,"properties":{"text":{"maxLength":12288,"minLength":2,"type":"string"}},"required":["text"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"imported":{"type":"boolean"},"reason":{"maxLength":64,"type":"string"}},"required":["imported"],"type":"object"},"permissions":["data.read","data.write"],"title":"导入术语表 JSON"}],"backend":"backend/index.js","data":[{"collection":"glossary","schema_version":1,"scope":"project"}],"files":[{"path":"backend/index.js","sha256":"0c7bf548890cd0e79e8ba2994077a9dea7ddfd9a1e32139baa59456c76b5fd55"},{"path":"ui/index.html","sha256":"3531547504ff40e795fb652db97219139e7209f45ae09094c2580febbdee8ea0"}],"host_api":1,"http":[],"manifest_version":1,"name":"项目术语表","page":"ui/index.html","permissions":["data.read","data.write"],"plugin_id":"glossary-hub","tasks":[],"tools":[{"description":"按术语、英文缩写或领域查询当前项目的标准名词解释，避免业务语义歧义。","id":"glossary.lookup","input_schema":{"additionalProperties":false,"properties":{"domain":{"maxLength":40,"type":"string"},"query":{"maxLength":64,"type":"string"}},"required":[],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"status":{"enum":["ready","storage_error"],"type":"string"},"success":{"type":"boolean"},"terms":{"items":{"additionalProperties":false,"properties":{"alias":{"maxLength":80,"type":"string"},"definition":{"maxLength":400,"minLength":1,"type":"string"},"domain":{"maxLength":40,"type":"string"},"term":{"maxLength":64,"minLength":1,"type":"string"}},"required":["term","alias","domain","definition"],"type":"object"},"type":"array"}},"required":["success","status","terms"],"type":"object"},"permissions":["data.read"],"title":"查询项目术语定义"},{"description":"向当前项目术语表新增或更新一条专业名词及其解释。","id":"glossary.upsert","input_schema":{"additionalProperties":false,"properties":{"alias":{"maxLength":80,"type":"string"},"definition":{"maxLength":400,"minLength":1,"type":"string"},"domain":{"maxLength":40,"type":"string"},"term":{"maxLength":64,"minLength":1,"type":"string"}},"required":["term","definition"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"status":{"enum":["saved","conflict","limit","invalid_input"],"type":"string"},"success":{"type":"boolean"}},"required":["success","status"],"type":"object"},"permissions":["data.read","data.write"],"title":"登记项目术语"}],"ui":{"icon":"text","surfaces":["workspace","chat"]},"version":"1.0.0"},"version":1}