{"files":[{"content":"const COLLECTION = 'okr';\nconst KEY = 'board';\nconst MAX_BYTES = 12 * 1024;\nconst MAX_OBJECTIVES = 20;\nconst MAX_KRS = 8;\nconst DOC_FORMAT = 'velai.okr-tracker';\n\nfunction jsonBytes(v) {\n  let b = 0;\n  for (const ch of JSON.stringify(v)) {\n    const cp = ch.codePointAt(0);\n    b += cp <= 0x7f ? 1 : cp <= 0x7ff ? 2 : cp <= 0xffff ? 3 : 4;\n  }\n  return b;\n}\n\nfunction clampPct(n) {\n  return Math.max(0, Math.min(100, Math.round(n)));\n}\n\nfunction enrichObjective(o) {\n  const krs = (o.krs || []).map(kr => ({\n    ...kr,\n    pct: clampPct((kr.current / kr.target) * 100),\n  }));\n  const progress_pct = krs.length ? clampPct(krs.reduce((s, k) => s + k.pct, 0) / krs.length) : 0;\n  return { id: o.id, cycle: o.cycle, title: o.title, progress_pct, krs };\n}\n\nfunction calcOverall(objectives) {\n  if (!objectives.length) return 0;\n  return clampPct(objectives.reduce((s, o) => s + o.progress_pct, 0) / objectives.length);\n}\n\nasync function readOkr() {\n  const receipt = await globalThis.nmas.data.read({ collection: COLLECTION, key: KEY });\n  const doc = receipt.value === null ? { schema_version: 1, objectives: [] } : receipt.value;\n  if (!doc || doc.schema_version !== 1 || !Array.isArray(doc.objectives)) {\n    throw new Error('OKR 数据结构无效');\n  }\n  const objectives = doc.objectives.map(enrichObjective);\n  return { revision: receipt.revision, overall_pct: calcOverall(objectives), objectives };\n}\n\nasync function writeOkr(expectedRevision, objectives) {\n  const clean = objectives.map(o => ({\n    id: o.id,\n    cycle: o.cycle,\n    title: o.title,\n    krs: o.krs.map(({ id, title, current, target, unit }) => ({ id, title, current, target, unit })),\n  }));\n  const value = { schema_version: 1, objectives: clean };\n  if (clean.length > MAX_OBJECTIVES || jsonBytes(value) > MAX_BYTES) {\n    return { status: 'limit', revision: expectedRevision };\n  }\n  try {\n    const receipt = await globalThis.nmas.data.write({\n      collection: COLLECTION,\n      key: KEY,\n      expected_revision: expectedRevision,\n      value,\n    });\n    return { status: 'saved', revision: receipt.revision };\n  } catch (err) {\n    if (err?.code === 'conflict' && err.outcome_unknown === false) {\n      return { status: 'conflict', revision: expectedRevision };\n    }\n    throw err;\n  }\n}\n\nexport default async function (request) {\n  const { kind, contribution, input } = request ?? {};\n\n  if (kind === 'action') {\n    if (contribution === 'okr.read') return readOkr();\n\n    if (contribution === 'okr.save') {\n      const { expected_revision, id, cycle, title, krs } = input;\n      if (!title.trim() || !cycle.trim() || krs.length > MAX_KRS || !/^[a-zA-Z0-9._-]+$/.test(id)) {\n        return { status: 'invalid_input', revision: expected_revision };\n      }\n      const data = await readOkr();\n      if (data.revision !== expected_revision) return { status: 'conflict', revision: data.revision };\n      const record = {\n        id,\n        cycle: cycle.trim(),\n        title: title.trim(),\n        krs: krs.map(k => ({\n          id: k.id,\n          title: k.title.trim(),\n          current: Number(k.current),\n          target: Number(k.target),\n          unit: k.unit.trim(),\n        })),\n      };\n      const exists = data.objectives.some(o => o.id === id);\n      const next = exists ? data.objectives.map(o => (o.id === id ? record : o)) : [...data.objectives, record];\n      return writeOkr(expected_revision, next);\n    }\n\n    if (contribution === 'okr.delete') {\n      const data = await readOkr();\n      if (data.revision !== input.expected_revision) return { status: 'conflict', revision: data.revision };\n      if (!data.objectives.some(o => o.id === input.id)) return { status: 'not_found', revision: data.revision };\n      const res = await writeOkr(input.expected_revision, data.objectives.filter(o => o.id !== input.id));\n      return res.status === 'saved' ? { status: 'deleted', revision: res.revision } : { status: 'conflict', revision: res.revision };\n    }\n\n    if (contribution === 'document.list') {\n      const data = await readOkr();\n      return { items: data.objectives.length ? [{ id: 'all', label: `全部 OKR (${data.objectives.length} 项)` }] : [] };\n    }\n\n    if (contribution === 'document.export') {\n      const data = await readOkr();\n      if (input.id !== 'all') return { error: 'not_found' };\n      const text = JSON.stringify({ format: DOC_FORMAT, version: 1, objectives: data.objectives }, null, 2);\n      return { filename: 'okr-tracker.json', text };\n    }\n\n    if (contribution === 'document.import') {\n      let parsed;\n      try { parsed = JSON.parse(input.text); } catch { return { imported: false, reason: 'invalid_json' }; }\n      if (parsed?.format !== DOC_FORMAT || parsed?.version !== 1 || !Array.isArray(parsed.objectives)) {\n        return { imported: false, reason: 'invalid_document' };\n      }\n      const data = await readOkr();\n      const next = [...data.objectives];\n      for (let i = 0; i < parsed.objectives.length; i++) {\n        const o = parsed.objectives[i];\n        if (typeof o?.title !== 'string' || !o.title.trim() || typeof o?.cycle !== 'string' || !o.cycle.trim()) continue;\n        const krs = Array.isArray(o.krs)\n          ? o.krs\n              .filter(k => typeof k?.title === 'string' && k.title.trim() && Number(k.target) > 0)\n              .slice(0, MAX_KRS)\n              .map((k, ki) => ({\n                id: `kr-${ki + 1}`,\n                title: k.title.trim().slice(0, 100),\n                current: Math.max(0, Number(k.current) || 0),\n                target: Number(k.target),\n                unit: typeof k.unit === 'string' ? k.unit.trim().slice(0, 16) : '',\n              }))\n          : [];\n        next.push({\n          id: `obj-${Date.now().toString(36)}-${i}`,\n          cycle: o.cycle.trim().slice(0, 24),\n          title: o.title.trim().slice(0, 120),\n          krs,\n        });\n      }\n      const res = await writeOkr(data.revision, next);\n      return res.status === 'saved' ? { imported: true } : { imported: false, reason: res.status };\n    }\n  }\n\n  if (kind === 'tool' && contribution === 'okr.summary') {\n    const data = await readOkr();\n    const cycle = (input.cycle || '').trim();\n    const filtered = data.objectives.filter(o => !cycle || o.cycle === cycle);\n    return {\n      success: true,\n      status: 'ready',\n      overall_pct: calcOverall(filtered),\n      objectives: filtered.map(o => ({\n        id: o.id,\n        cycle: o.cycle,\n        title: o.title,\n        progress_pct: o.progress_pct,\n        kr_count: o.krs.length,\n      })),\n    };\n  }\n\n  throw new Error(`不支持的调用: ${kind}/${contribution}`);\n}\n","path":"backend/index.js"},{"content":"<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>目标进度追踪器 (OKR)</title>\n  <style>\n    :root {\n      color-scheme: light dark;\n      --bg: Canvas; --fg: CanvasText; --muted: color-mix(in srgb, CanvasText 60%, transparent);\n      --border: color-mix(in srgb, CanvasText 18%, transparent);\n      --card: color-mix(in srgb, CanvasText 4%, Canvas);\n      --accent: #2563eb; --ok: #16a34a; --danger: #dc2626;\n      font: 14px/1.55 system-ui, -apple-system, sans-serif;\n    }\n    * { box-sizing: border-box; }\n    body { margin: 0; background: var(--bg); color: var(--fg); }\n    main { max-width: 920px; margin: 0 auto; padding: clamp(12px, 2.5vw, 20px); display: flex; flex-direction: column; gap: 12px; }\n    header, .row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: space-between; }\n    h1 { font-size: 18px; margin: 0; }\n    .banner { border: 1px solid var(--border); border-radius: 10px; padding: 12px; background: var(--card); display: flex; align-items: center; justify-content: space-between; gap: 12px; }\n    .big { font-size: 26px; font-weight: 700; color: var(--accent); }\n    .bar { height: 8px; border-radius: 99px; background: var(--border); overflow: hidden; flex: 1; min-width: 120px; }\n    .bar > div { height: 100%; background: var(--accent); }\n    .card { border: 1px solid var(--border); border-radius: 10px; padding: 12px; background: var(--card); display: flex; flex-direction: column; gap: 10px; }\n    .kr { display: grid; grid-template-columns: minmax(0, 1fr) 90px 90px 64px auto; gap: 6px; align-items: center; }\n    @media (max-width: 640px) { .kr { grid-template-columns: 1fr 1fr; } }\n    input, button { font: inherit; color: inherit; border: 1px solid var(--border); border-radius: 7px; padding: 6px 10px; background: var(--bg); }\n    button { cursor: pointer; }\n    button.primary { background: var(--accent); border-color: var(--accent); color: #fff; }\n    button.danger { color: var(--danger); }\n    .status { font-size: 13px; color: var(--muted); margin: 0; }\n    .status[data-error=\"true\"] { color: var(--danger); }\n  </style>\n</head>\n<body>\n  <main>\n    <header>\n      <h1>目标进度追踪器 (OKR)</h1>\n      <button id=\"btn-refresh\" type=\"button\">刷新</button>\n    </header>\n\n    <section class=\"banner\">\n      <div>\n        <div class=\"status\">整体达成率</div>\n        <div id=\"overall\" class=\"big\">0%</div>\n      </div>\n      <div class=\"bar\"><div id=\"overall-bar\" style=\"width:0%\"></div></div>\n    </section>\n\n    <section class=\"card\">\n      <strong>新增目标 (Objective)</strong>\n      <div class=\"row\">\n        <input id=\"n-cycle\" value=\"2026-Q4\" placeholder=\"周期（如 2026-Q4）\" maxlength=\"24\" style=\"width:130px\">\n        <input id=\"n-title\" placeholder=\"目标描述（如：构建完善的 Velai 插件生态）\" maxlength=\"120\" style=\"flex:1;min-width:180px\">\n        <input id=\"n-kr\" placeholder=\"首个关键结果 KR1\" maxlength=\"100\" style=\"flex:1;min-width:160px\">\n        <input id=\"n-target\" type=\"number\" min=\"1\" value=\"10\" style=\"width:86px\" title=\"目标值\">\n        <input id=\"n-unit\" value=\"个\" maxlength=\"16\" style=\"width:68px\" title=\"单位\">\n        <button id=\"btn-add\" class=\"primary\" type=\"button\">创建目标</button>\n      </div>\n    </section>\n\n    <p id=\"status\" class=\"status\" role=\"status\">正在加载 OKR…</p>\n    <section id=\"list\" style=\"display:flex;flex-direction:column;gap:10px\"></section>\n  </main>\n  <script>\n    (() => {\n      const plugin = globalThis.nmasPlugin;\n      const $ = id => document.getElementById(id);\n      let revision = 0, objectives = [], busy = false;\n      const setStatus = (t, e = false) => { $('status').textContent = t; $('status').dataset.error = String(e); };\n\n      function render(overall) {\n        $('overall').textContent = `${overall}%`;\n        $('overall-bar').style.width = `${overall}%`;\n        const box = $('list');\n        box.replaceChildren();\n        if (!objectives.length) {\n          const p = document.createElement('p');\n          p.className = 'status';\n          p.textContent = '暂无目标，请在上方创建第一个 OKR';\n          box.appendChild(p);\n          return;\n        }\n        for (const obj of objectives) {\n          const card = document.createElement('article');\n          card.className = 'card';\n          const head = document.createElement('div');\n          head.className = 'row';\n          const left = document.createElement('div');\n          left.innerHTML = '';\n          const title = document.createElement('strong');\n          title.textContent = `[${obj.cycle}] ${obj.title}`;\n          const pct = document.createElement('span');\n          pct.className = 'status';\n          pct.style.marginLeft = '8px';\n          pct.textContent = `达成 ${obj.progress_pct}%`;\n          left.append(title, pct);\n          const del = document.createElement('button');\n          del.type = 'button';\n          del.className = 'danger';\n          del.textContent = '删除';\n          del.addEventListener('click', () => removeObjective(obj.id));\n          head.append(left, del);\n\n          const bar = document.createElement('div');\n          bar.className = 'bar';\n          const fill = document.createElement('div');\n          fill.style.width = `${obj.progress_pct}%`;\n          bar.appendChild(fill);\n          card.append(head, bar);\n\n          for (const kr of obj.krs) {\n            const row = document.createElement('div');\n            row.className = 'kr';\n            const name = document.createElement('span');\n            name.textContent = `${kr.title} (${kr.pct}%)`;\n            const cur = document.createElement('input');\n            cur.type = 'number';\n            cur.min = '0';\n            cur.step = 'any';\n            cur.value = String(kr.current);\n            const tgt = document.createElement('span');\n            tgt.className = 'status';\n            tgt.textContent = `/ ${kr.target} ${kr.unit}`;\n            const saveBtn = document.createElement('button');\n            saveBtn.type = 'button';\n            saveBtn.textContent = '更新';\n            saveBtn.addEventListener('click', () => {\n              const nextVal = Number(cur.value);\n              if (!Number.isFinite(nextVal) || nextVal < 0) return;\n              const nextKrs = obj.krs.map(k => ({\n                id: k.id,\n                title: k.title,\n                current: k.id === kr.id ? nextVal : k.current,\n                target: k.target,\n                unit: k.unit,\n              }));\n              void saveObjective({ id: obj.id, cycle: obj.cycle, title: obj.title, krs: nextKrs });\n            });\n            row.append(name, cur, tgt, saveBtn);\n            card.appendChild(row);\n          }\n\n          const addKrRow = document.createElement('div');\n          addKrRow.className = 'row';\n          const krTitle = document.createElement('input');\n          krTitle.placeholder = '追加一条关键结果…';\n          krTitle.style.flex = '1';\n          const krTarget = document.createElement('input');\n          krTarget.type = 'number';\n          krTarget.min = '1';\n          krTarget.value = '100';\n          krTarget.style.width = '84px';\n          const krUnit = document.createElement('input');\n          krUnit.value = '%';\n          krUnit.style.width = '60px';\n          const addKrBtn = document.createElement('button');\n          addKrBtn.type = 'button';\n          addKrBtn.textContent = '+ 添加 KR';\n          addKrBtn.addEventListener('click', () => {\n            if (!krTitle.value.trim()) return;\n            const target = Number(krTarget.value);\n            if (!Number.isFinite(target) || target <= 0) return;\n            const nextKrs = [\n              ...obj.krs.map(({ id, title, current, target, unit }) => ({ id, title, current, target, unit })),\n              { id: `kr-${Date.now().toString(36)}`, title: krTitle.value.trim(), current: 0, target, unit: krUnit.value.trim() },\n            ];\n            void saveObjective({ id: obj.id, cycle: obj.cycle, title: obj.title, krs: nextKrs });\n          });\n          addKrRow.append(krTitle, krTarget, krUnit, addKrBtn);\n          card.appendChild(addKrRow);\n\n          box.appendChild(card);\n        }\n      }\n\n      async function load() {\n        if (typeof plugin?.action !== 'function') { setStatus('请在 Velai Desktop 中打开此插件。', true); return; }\n        try {\n          const res = await plugin.action('okr.read', {});\n          revision = res.revision;\n          objectives = res.objectives;\n          render(res.overall_pct);\n          setStatus(`已加载 ${objectives.length} 个目标（修订 #${revision}）`);\n        } catch (e) { setStatus(`读取失败：${e?.message || '未知错误'}`, true); }\n      }\n\n      async function saveObjective(payload) {\n        if (busy) return;\n        busy = true;\n        try {\n          const res = await plugin.action('okr.save', { expected_revision: revision, ...payload });\n          if (res.status === 'saved') await load();\n          else setStatus(`保存未完成：${res.status}`, true);\n        } catch (e) { setStatus(`保存失败：${e?.message || '未知错误'}`, true); }\n        finally { busy = false; }\n      }\n\n      async function removeObjective(id) {\n        if (busy) return;\n        busy = true;\n        try {\n          const res = await plugin.action('okr.delete', { expected_revision: revision, id });\n          if (res.status === 'deleted') await load();\n          else setStatus(`删除未完成：${res.status}`, true);\n        } catch (e) { setStatus(`删除失败：${e?.message || '未知错误'}`, true); }\n        finally { busy = false; }\n      }\n\n      $('btn-add').addEventListener('click', () => {\n        const title = $('n-title').value.trim();\n        const cycle = $('n-cycle').value.trim();\n        const krText = $('n-kr').value.trim();\n        const target = Number($('n-target').value);\n        if (!title || !cycle || !krText || !Number.isFinite(target) || target <= 0) {\n          setStatus('请完整填写周期、目标、首个 KR 和有效目标值。', true);\n          return;\n        }\n        $('n-title').value = '';\n        $('n-kr').value = '';\n        void saveObjective({\n          id: `obj-${Date.now().toString(36)}`,\n          cycle,\n          title,\n          krs: [{ id: 'kr-1', title: krText, current: 0, target, unit: $('n-unit').value.trim() }],\n        });\n      });\n\n      $('btn-refresh').addEventListener('click', load);\n      void load();\n    })();\n  </script>\n</body>\n</html>\n","path":"ui/index.html"}],"format":"nmas-plugin","manifest":{"actions":[{"id":"okr.read","input_schema":{"additionalProperties":false,"properties":{},"required":[],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"objectives":{"items":{"additionalProperties":false,"properties":{"cycle":{"maxLength":24,"minLength":1,"type":"string"},"id":{"maxLength":48,"minLength":1,"type":"string"},"krs":{"items":{"additionalProperties":false,"properties":{"current":{"maximum":1000000000,"minimum":0,"type":"number"},"id":{"maxLength":48,"minLength":1,"type":"string"},"pct":{"maximum":100,"minimum":0,"type":"integer"},"target":{"maximum":1000000000,"minimum":0.0001,"type":"number"},"title":{"maxLength":100,"minLength":1,"type":"string"},"unit":{"maxLength":16,"type":"string"}},"required":["id","title","current","target","unit","pct"],"type":"object"},"type":"array"},"progress_pct":{"maximum":100,"minimum":0,"type":"integer"},"title":{"maxLength":120,"minLength":1,"type":"string"}},"required":["id","cycle","title","progress_pct","krs"],"type":"object"},"type":"array"},"overall_pct":{"maximum":100,"minimum":0,"type":"integer"},"revision":{"maximum":9007199254740991,"minimum":0,"type":"integer"}},"required":["revision","overall_pct","objectives"],"type":"object"},"permissions":["data.read"],"title":"读取全部 OKR"},{"id":"okr.save","input_schema":{"additionalProperties":false,"properties":{"cycle":{"maxLength":24,"minLength":1,"type":"string"},"expected_revision":{"maximum":9007199254740990,"minimum":0,"type":"integer"},"id":{"maxLength":48,"minLength":1,"type":"string"},"krs":{"items":{"additionalProperties":false,"properties":{"current":{"maximum":1000000000,"minimum":0,"type":"number"},"id":{"maxLength":48,"minLength":1,"type":"string"},"target":{"maximum":1000000000,"minimum":0.0001,"type":"number"},"title":{"maxLength":100,"minLength":1,"type":"string"},"unit":{"maxLength":16,"type":"string"}},"required":["id","title","current","target","unit"],"type":"object"},"type":"array"},"title":{"maxLength":120,"minLength":1,"type":"string"}},"required":["expected_revision","id","cycle","title","krs"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"revision":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"status":{"enum":["saved","conflict","limit","invalid_input"],"type":"string"}},"required":["status","revision"],"type":"object"},"permissions":["data.read","data.write"],"title":"保存或更新目标"},{"id":"okr.delete","input_schema":{"additionalProperties":false,"properties":{"expected_revision":{"maximum":9007199254740990,"minimum":0,"type":"integer"},"id":{"maxLength":48,"minLength":1,"type":"string"}},"required":["expected_revision","id"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"revision":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"status":{"enum":["deleted","not_found","conflict"],"type":"string"}},"required":["status","revision"],"type":"object"},"permissions":["data.read","data.write"],"title":"删除目标"},{"id":"document.list","input_schema":{"additionalProperties":false,"properties":{},"required":[],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"items":{"items":{"additionalProperties":false,"properties":{"id":{"maxLength":32,"minLength":1,"type":"string"},"label":{"maxLength":80,"minLength":1,"type":"string"}},"required":["id","label"],"type":"object"},"type":"array"}},"required":[],"type":"object"},"permissions":["data.read"],"title":"列出可导出的 OKR 周期"},{"id":"document.export","input_schema":{"additionalProperties":false,"properties":{"id":{"maxLength":32,"minLength":1,"type":"string"}},"required":["id"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"error":{"maxLength":64,"type":"string"},"filename":{"maxLength":64,"type":"string"},"text":{"maxLength":12288,"type":"string"}},"required":[],"type":"object"},"permissions":["data.read"],"title":"导出 OKR JSON"},{"id":"document.import","input_schema":{"additionalProperties":false,"properties":{"text":{"maxLength":12288,"minLength":2,"type":"string"}},"required":["text"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"imported":{"type":"boolean"},"reason":{"maxLength":64,"type":"string"}},"required":["imported"],"type":"object"},"permissions":["data.read","data.write"],"title":"导入 OKR JSON"}],"backend":"backend/index.js","data":[{"collection":"okr","schema_version":1,"scope":"account"}],"files":[{"path":"backend/index.js","sha256":"0e1f9935c2613883827ae8636bbec9bc54504a8f389beb9e256a4f365f9d561d"},{"path":"ui/index.html","sha256":"e773bd06f8785e88a7a6b17b35ac8463ba1ae9ac4aa86904ddb88901978321a9"}],"host_api":1,"http":[],"manifest_version":1,"name":"目标进度追踪器 (OKR)","page":"ui/index.html","permissions":["data.read","data.write"],"plugin_id":"okr-tracker","tasks":[],"tools":[{"description":"汇总当前账号各周期的目标 (O) 与关键结果 (KR) 达成率，便于撰写周报或评估风险。","id":"okr.summary","input_schema":{"additionalProperties":false,"properties":{"cycle":{"maxLength":24,"type":"string"}},"required":[],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"objectives":{"items":{"additionalProperties":false,"properties":{"cycle":{"maxLength":24,"minLength":1,"type":"string"},"id":{"maxLength":48,"minLength":1,"type":"string"},"kr_count":{"maximum":16,"minimum":0,"type":"integer"},"progress_pct":{"maximum":100,"minimum":0,"type":"integer"},"title":{"maxLength":120,"minLength":1,"type":"string"}},"required":["id","cycle","title","progress_pct","kr_count"],"type":"object"},"type":"array"},"overall_pct":{"maximum":100,"minimum":0,"type":"integer"},"status":{"enum":["ready","storage_error"],"type":"string"},"success":{"type":"boolean"}},"required":["success","status","overall_pct","objectives"],"type":"object"},"permissions":["data.read"],"title":"获取 OKR 进展摘要"}],"ui":{"icon":"table","surfaces":["workspace","chat"]},"version":"1.0.0"},"version":1}