{"files":[{"content":"const COL_ACCOUNTS = 'accounts';\nconst COL_DEALS = 'deals';\nconst COL_ACTIVITIES = 'activities';\nconst KEY_LIST = 'list';\nconst DOC_FORMAT = 'velai-crm-sales-os';\n\nconst MAX_RECORD_BYTES = 240 * 1024;\nconst MAX_ACCOUNTS = 120;\nconst MAX_DEALS = 240;\nconst MAX_ACTIVITIES = 360;\n\nconst STAGES = ['lead', 'qualified', 'proposal', 'negotiation', 'won', 'lost'];\nconst SIZES = ['startup', 'smb', 'midmarket', 'enterprise'];\nconst ACT_TYPES = ['call', 'meeting', 'demo', 'quote', 'email', 'ai_note'];\nconst STAGE_PROB = {\n  lead: 15,\n  qualified: 35,\n  proposal: 60,\n  negotiation: 80,\n  won: 100,\n  lost: 0,\n};\n\nfunction jsonBytes(v) {\n  let b = 0;\n  for (const ch of JSON.stringify(v)) {\n    const cp = ch.codePointAt(0);\n    b += cp <= 0x7f ? 1 : cp <= 0x7ff ? 2 : cp <= 0xffff ? 3 : 4;\n  }\n  return b;\n}\n\nfunction todayStr() {\n  return new Date().toISOString().slice(0, 10);\n}\n\nfunction addDays(offset) {\n  const d = new Date(Date.now() + offset * 86400000);\n  return d.toISOString().slice(0, 10);\n}\n\nfunction isDate(s) {\n  return typeof s === 'string' && /^\\d{4}-\\d{2}-\\d{2}$/.test(s);\n}\n\nfunction validId(s) {\n  return typeof s === 'string' && s.length >= 1 && s.length <= 48 && /^[a-zA-Z0-9._-]+$/.test(s);\n}\n\nfunction round2(n) {\n  return Math.round(n * 100) / 100;\n}\n\nfunction makeId(prefix) {\n  const rand = Math.floor(Math.random() * 0xffffff).toString(36).padStart(4, '0');\n  return `${prefix}-${Date.now().toString(36)}-${rand}`.slice(0, 48);\n}\n\nasync function readCollection(collection) {\n  const receipt = await globalThis.nmas.data.read({ collection, key: KEY_LIST });\n  const doc = receipt.value === null ? { schema_version: 1, items: [] } : receipt.value;\n  if (!doc || doc.schema_version !== 1 || !Array.isArray(doc.items)) {\n    throw new Error(`集合 ${collection} 数据格式无效`);\n  }\n  return { revision: receipt.revision, items: doc.items };\n}\n\nasync function readAll() {\n  const acc = await readCollection(COL_ACCOUNTS);\n  const deal = await readCollection(COL_DEALS);\n  const act = await readCollection(COL_ACTIVITIES);\n  return {\n    revision: Math.max(acc.revision, deal.revision, act.revision),\n    accounts: acc.items,\n    deals: deal.items,\n    activities: act.items,\n  };\n}\n\nasync function writeCollection(collection, expectedRevision, items, maxCount) {\n  if (items.length === 0) {\n    try {\n      const receipt = await globalThis.nmas.data.delete({\n        collection,\n        key: KEY_LIST,\n        expected_revision: expectedRevision,\n      });\n      return { status: 'saved', revision: receipt.revision };\n    } catch (err) {\n      if (err?.code === 'conflict' && err.outcome_unknown === false) {\n        return { status: 'conflict', revision: expectedRevision };\n      }\n      throw err;\n    }\n  }\n  const value = { schema_version: 1, items };\n  if (items.length > maxCount || jsonBytes(value) > MAX_RECORD_BYTES) {\n    return { status: 'limit', revision: expectedRevision };\n  }\n  try {\n    const receipt = await globalThis.nmas.data.write({\n      collection,\n      key: KEY_LIST,\n      expected_revision: expectedRevision,\n      value,\n    });\n    return { status: 'saved', revision: receipt.revision };\n  } catch (err) {\n    if (err?.code === 'conflict' && err.outcome_unknown === false) {\n      return { status: 'conflict', revision: expectedRevision };\n    }\n    throw err;\n  }\n}\n\nasync function readPluginSettings() {\n  const raw = await globalThis.nmas.settings.get();\n  const default_currency = typeof raw?.default_currency === 'string' && /^[A-Z]{3,8}$/.test(raw.default_currency.trim().toUpperCase())\n    ? raw.default_currency.trim().toUpperCase()\n    : 'CNY';\n  const days = Number.isInteger(raw?.follow_up_days) ? raw.follow_up_days : 3;\n  const follow_up_days = Math.max(1, Math.min(30, days));\n  return { default_currency, follow_up_days };\n}\n\nfunction computeMetrics(accounts, deals, activities, followUpDays = 3) {\n  const today = todayStr();\n  const soonLimit = addDays(followUpDays);\n  const funnelMap = {};\n  for (const s of STAGES) funnelMap[s] = { stage: s, count: 0, amount: 0, weighted: 0 };\n\n  let activePipeline = 0;\n  let weightedForecast = 0;\n  let wonAmount = 0;\n  let lostAmount = 0;\n  let activeCount = 0;\n  let wonCount = 0;\n  let closedCount = 0;\n\n  for (const d of deals) {\n    const amt = Number(d.amount) || 0;\n    const prob = Number(d.probability) || 0;\n    const w = round2((amt * prob) / 100);\n    const bucket = funnelMap[d.stage];\n    if (bucket) {\n      bucket.count += 1;\n      bucket.amount = round2(bucket.amount + amt);\n      bucket.weighted = round2(bucket.weighted + w);\n    }\n    if (d.stage === 'won') {\n      wonAmount = round2(wonAmount + amt);\n      wonCount += 1;\n      closedCount += 1;\n    } else if (d.stage === 'lost') {\n      lostAmount = round2(lostAmount + amt);\n      closedCount += 1;\n    } else {\n      activePipeline = round2(activePipeline + amt);\n      weightedForecast = round2(weightedForecast + w);\n      activeCount += 1;\n    }\n  }\n\n  const avgHealth = accounts.length\n    ? round2(accounts.reduce((s, a) => s + (Number(a.health) || 0), 0) / accounts.length)\n    : 0;\n  const winRate = closedCount > 0 ? round2((wonCount / closedCount) * 100) : 0;\n\n  let overdueCount = 0;\n  let dueSoonCount = 0;\n  for (const a of activities) {\n    if (a.done || !a.next_due) continue;\n    if (a.next_due < today) overdueCount += 1;\n    else if (a.next_due <= soonLimit) dueSoonCount += 1;\n  }\n\n  return {\n    active_pipeline: activePipeline,\n    weighted_forecast: weightedForecast,\n    won_amount: wonAmount,\n    lost_amount: lostAmount,\n    active_deal_count: activeCount,\n    win_rate: winRate,\n    avg_health: avgHealth,\n    overdue_count: overdueCount,\n    due_soon_count: dueSoonCount,\n    funnel: STAGES.map(s => funnelMap[s]),\n  };\n}\n\nfunction buildDemoDataset() {\n  const d0 = todayStr();\n  const accounts = [\n    {\n      id: 'acc-nebula',\n      name: '星云智造科技',\n      industry: '智能制造',\n      size: 'enterprise',\n      health: 88,\n      contact_name: '陈志远',\n      contact_role: 'CTO',\n      annual_potential: 1800000,\n      tags: ['灯塔客户', '私有部署', '高增潜'],\n      risk_note: '法务正在审阅数据合规附件，预计本月底前完成签章。',\n      updated_at: d0,\n    },\n    {\n      id: 'acc-aurora',\n      name: '极光跨境物流',\n      industry: '供应链物流',\n      size: 'midmarket',\n      health: 74,\n      contact_name: '林婉清',\n      contact_role: '运营副总裁',\n      annual_potential: 960000,\n      tags: ['多仓协同', '竞品替换'],\n      risk_note: '竞品给出首年 8 折报价，需突出 AI 异常预警 ROI 差异化。',\n      updated_at: d0,\n    },\n    {\n      id: 'acc-finpulse',\n      name: '脉动金融数据',\n      industry: '金融科技',\n      size: 'enterprise',\n      health: 92,\n      contact_name: '周明轩',\n      contact_role: '首席数据官',\n      annual_potential: 2400000,\n      tags: ['战略续约', '增购席位'],\n      risk_note: '一期上线满意度高，可推动 Q2 扩展风控团队 120 席位。',\n      updated_at: d0,\n    },\n    {\n      id: 'acc-medcore',\n      name: '康核生命健康',\n      industry: '生物医药',\n      size: 'midmarket',\n      health: 58,\n      contact_name: '苏嘉宁',\n      contact_role: 'IT 总监',\n      annual_potential: 720000,\n      tags: ['合规敏感', '需高层切入'],\n      risk_note: '采购预算冻结风险，关键决策人尚未参与 POC 验收。',\n      updated_at: d0,\n    },\n    {\n      id: 'acc-cloudretail',\n      name: '云杉新零售',\n      industry: '消费零售',\n      size: 'smb',\n      health: 81,\n      contact_name: '陆思成',\n      contact_role: '增长负责人',\n      annual_potential: 450000,\n      tags: ['PLG 转化', '快签'],\n      risk_note: '试用团队活跃度高，关注按季付款与微信生态打通能力。',\n      updated_at: d0,\n    },\n  ];\n\n  const deals = [\n    {\n      id: 'deal-nebula-ai',\n      account_id: 'acc-nebula',\n      title: '星云智造 AI 质检中台年度订阅',\n      stage: 'negotiation',\n      amount: 680000,\n      probability: 85,\n      close_date: addDays(14),\n      owner: '张锐',\n      next_step: '与法务对齐 SLA 违约条款并提交终版合同',\n      loss_reason: '',\n      updated_at: d0,\n    },\n    {\n      id: 'deal-aurora-ops',\n      account_id: 'acc-aurora',\n      title: '极光全球运力调度自动化项目',\n      stage: 'proposal',\n      amount: 420000,\n      probability: 60,\n      close_date: addDays(28),\n      owner: '李佳',\n      next_step: '交付 3 年 TCO 测算模型与竞品对比白皮书',\n      loss_reason: '',\n      updated_at: d0,\n    },\n    {\n      id: 'deal-finpulse-exp',\n      account_id: 'acc-finpulse',\n      title: '脉动金融风控团队 120 席位增购',\n      stage: 'won',\n      amount: 540000,\n      probability: 100,\n      close_date: addDays(-4),\n      owner: '张锐',\n      next_step: '交接客户成功经理启动培训上线',\n      loss_reason: '',\n      updated_at: d0,\n    },\n    {\n      id: 'deal-medcore-poc',\n      account_id: 'acc-medcore',\n      title: '康核临床文档智能检索平台',\n      stage: 'qualified',\n      amount: 360000,\n      probability: 35,\n      close_date: addDays(45),\n      owner: '王晨',\n      next_step: '约见研发 VP 确认脱敏数据集与 POC 验收指标',\n      loss_reason: '',\n      updated_at: d0,\n    },\n    {\n      id: 'deal-retail-std',\n      account_id: 'acc-cloudretail',\n      title: '云杉全渠道会员 AI 营销套件',\n      stage: 'negotiation',\n      amount: 210000,\n      probability: 80,\n      close_date: addDays(9),\n      owner: '李佳',\n      next_step: '确认季度付款审批单与上线排期',\n      loss_reason: '',\n      updated_at: d0,\n    },\n    {\n      id: 'deal-nebula-edge',\n      account_id: 'acc-nebula',\n      title: '星云二期工厂边缘节点扩展包',\n      stage: 'lead',\n      amount: 320000,\n      probability: 20,\n      close_date: addDays(70),\n      owner: '张锐',\n      next_step: '一期上线后开展产线调研挖掘二期预算',\n      loss_reason: '',\n      updated_at: d0,\n    },\n    {\n      id: 'deal-medcore-legacy',\n      account_id: 'acc-medcore',\n      title: '康核旧版报表迁移服务',\n      stage: 'lost',\n      amount: 150000,\n      probability: 0,\n      close_date: addDays(-12),\n      owner: '王晨',\n      next_step: '',\n      loss_reason: '客户决定由内部团队自行维护旧系统，预算转投 AI 检索项目。',\n      updated_at: d0,\n    },\n  ];\n\n  const activities = [\n    {\n      id: 'act-01',\n      account_id: 'acc-nebula',\n      deal_id: 'deal-nebula-ai',\n      type: 'quote',\n      date: addDays(-3),\n      summary: '发出 68 万年度阶梯报价单，CTO 认可技术方案，要求法务核查数据不出境条款。',\n      next_action: '跟进法务终审意见并预约高层签字',\n      next_due: addDays(-1),\n      done: false,\n    },\n    {\n      id: 'act-02',\n      account_id: 'acc-aurora',\n      deal_id: 'deal-aurora-ops',\n      type: 'demo',\n      date: addDays(-5),\n      summary: '完成多仓异常预测实景演示，运营团队对预警准确率反馈积极，关注与现有 ERP 集成周期。',\n      next_action: '发送 ERP 对接排期表与 ROI 测算',\n      next_due: addDays(1),\n      done: false,\n    },\n    {\n      id: 'act-03',\n      account_id: 'acc-medcore',\n      deal_id: 'deal-medcore-poc',\n      type: 'call',\n      date: addDays(-6),\n      summary: '与 IT 总监沟通 POC 进展，得知 Q2 预算需经研发 VP 联签，存在延期风险。',\n      next_action: '起草致研发 VP 的业务价值简报并约访',\n      next_due: addDays(-2),\n      done: false,\n    },\n    {\n      id: 'act-04',\n      account_id: 'acc-cloudretail',\n      deal_id: 'deal-retail-std',\n      type: 'meeting',\n      date: addDays(-2),\n      summary: '与增长负责人核对企业微信接入流程，对方希望将年付拆为两期付款以加速内部审批。',\n      next_action: '内部申请分期付款特批并回传合同',\n      next_due: addDays(2),\n      done: false,\n    },\n    {\n      id: 'act-05',\n      account_id: 'acc-finpulse',\n      deal_id: 'deal-finpulse-exp',\n      type: 'meeting',\n      date: addDays(-4),\n      summary: '120 席位增购合同正式盖章赢单，CDO 提出希望分享最佳实践给集团其他子公司。',\n      next_action: '安排客户成功启动会并准备案例访谈',\n      next_due: addDays(5),\n      done: false,\n    },\n    {\n      id: 'act-06',\n      account_id: 'acc-nebula',\n      deal_id: 'deal-nebula-edge',\n      type: 'email',\n      date: addDays(-8),\n      summary: '分享边缘推理低延迟白皮书，CTO 表达对华东二厂试点的初步兴趣。',\n      next_action: '约技术架构师评估产线网关现状',\n      next_due: addDays(10),\n      done: false,\n    },\n    {\n      id: 'act-07',\n      account_id: 'acc-aurora',\n      deal_id: 'deal-aurora-ops',\n      type: 'call',\n      date: addDays(-10),\n      summary: '摸底竞品动态：对方以低价切入但缺少自定义工作流与中文大模型语义检索。',\n      next_action: '整理 5 点竞品差异化攻防清单',\n      next_due: addDays(-3),\n      done: true,\n    },\n    {\n      id: 'act-08',\n      account_id: 'acc-finpulse',\n      deal_id: 'deal-finpulse-exp',\n      type: 'demo',\n      date: addDays(-14),\n      summary: '面向风控审核团队做专项演示，平均单据核验耗时缩短 46%。',\n      next_action: '输出 POC 量化验收报告',\n      next_due: addDays(-9),\n      done: true,\n    },\n    {\n      id: 'act-09',\n      account_id: 'acc-cloudretail',\n      deal_id: 'deal-retail-std',\n      type: 'email',\n      date: addDays(-7),\n      summary: '发送 14 天试用数据分析报告：自动生成营销文案点击率提升 22%。',\n      next_action: '确认正式版席位清单',\n      next_due: addDays(-3),\n      done: true,\n    },\n    {\n      id: 'act-10',\n      account_id: 'acc-medcore',\n      deal_id: 'deal-medcore-legacy',\n      type: 'ai_note',\n      date: addDays(-12),\n      summary: '旧版报表项目丢单复盘：前期未绑定高层痛点，后续聚焦 AI 临床检索高价值场景。',\n      next_action: '沉淀医药行业合规答疑库',\n      next_due: addDays(-5),\n      done: true,\n    },\n  ];\n\n  return { accounts, deals, activities };\n}\n\nfunction sanitizeAccount(raw) {\n  if (!raw || typeof raw !== 'object') return null;\n  const id = String(raw.id || '').trim();\n  const name = String(raw.name || '').trim();\n  const industry = String(raw.industry || '').trim();\n  const size = String(raw.size || '').trim();\n  const health = Number(raw.health);\n  const contactName = String(raw.contact_name || '').trim();\n  const contactRole = String(raw.contact_role || '').trim();\n  const annualPotential = Number(raw.annual_potential);\n  const tags = Array.isArray(raw.tags)\n    ? raw.tags.map(t => String(t).trim()).filter(Boolean).slice(0, 5).map(t => t.slice(0, 24))\n    : [];\n  const riskNote = String(raw.risk_note || '').trim().slice(0, 240);\n  const updatedAt = isDate(raw.updated_at) ? raw.updated_at : todayStr();\n\n  if (\n    !validId(id) ||\n    !name ||\n    name.length > 64 ||\n    !industry ||\n    industry.length > 32 ||\n    !SIZES.includes(size) ||\n    !Number.isInteger(health) ||\n    health < 0 ||\n    health > 100 ||\n    !contactName ||\n    contactName.length > 40 ||\n    !Number.isFinite(annualPotential) ||\n    annualPotential < 0 ||\n    annualPotential > 999999999\n  ) {\n    return null;\n  }\n  return {\n    id,\n    name,\n    industry,\n    size,\n    health,\n    contact_name: contactName,\n    contact_role: contactRole.slice(0, 40),\n    annual_potential: round2(annualPotential),\n    tags,\n    risk_note: riskNote,\n    updated_at: updatedAt,\n  };\n}\n\nfunction sanitizeDeal(raw) {\n  if (!raw || typeof raw !== 'object') return null;\n  const id = String(raw.id || '').trim();\n  const accountId = String(raw.account_id || '').trim();\n  const title = String(raw.title || '').trim();\n  const stage = String(raw.stage || '').trim();\n  const amount = Number(raw.amount);\n  const probability = Number(raw.probability);\n  const closeDate = String(raw.close_date || '').trim();\n  const owner = String(raw.owner || '').trim().slice(0, 32);\n  const nextStep = String(raw.next_step || '').trim().slice(0, 160);\n  const lossReason = String(raw.loss_reason || '').trim().slice(0, 160);\n  const updatedAt = isDate(raw.updated_at) ? raw.updated_at : todayStr();\n\n  if (\n    !validId(id) ||\n    !validId(accountId) ||\n    !title ||\n    title.length > 80 ||\n    !STAGES.includes(stage) ||\n    !Number.isFinite(amount) ||\n    amount < 0 ||\n    amount > 999999999 ||\n    !Number.isInteger(probability) ||\n    probability < 0 ||\n    probability > 100 ||\n    !isDate(closeDate)\n  ) {\n    return null;\n  }\n  return {\n    id,\n    account_id: accountId,\n    title,\n    stage,\n    amount: round2(amount),\n    probability,\n    close_date: closeDate,\n    owner,\n    next_step: nextStep,\n    loss_reason: lossReason,\n    updated_at: updatedAt,\n  };\n}\n\nfunction sanitizeActivity(raw) {\n  if (!raw || typeof raw !== 'object') return null;\n  const id = String(raw.id || '').trim();\n  const accountId = String(raw.account_id || '').trim();\n  const dealId = String(raw.deal_id || '').trim();\n  const type = String(raw.type || '').trim();\n  const date = String(raw.date || '').trim();\n  const summary = String(raw.summary || '').trim().slice(0, 400);\n  const nextAction = String(raw.next_action || '').trim().slice(0, 160);\n  const nextDue = String(raw.next_due || '').trim();\n  const done = Boolean(raw.done);\n\n  if (\n    !validId(id) ||\n    !validId(accountId) ||\n    (dealId && !validId(dealId)) ||\n    !ACT_TYPES.includes(type) ||\n    !isDate(date) ||\n    !summary ||\n    (nextDue && !isDate(nextDue))\n  ) {\n    return null;\n  }\n  return {\n    id,\n    account_id: accountId,\n    deal_id: dealId,\n    type,\n    date,\n    summary,\n    next_action: nextAction,\n    next_due: nextDue,\n    done,\n  };\n}\n\nfunction findAccountByNameOrId(accounts, query) {\n  const q = String(query || '').trim().toLowerCase();\n  if (!q) return null;\n  return (\n    accounts.find(a => a.id.toLowerCase() === q) ||\n    accounts.find(a => a.name.toLowerCase() === q) ||\n    accounts.find(a => a.name.toLowerCase().includes(q)) ||\n    null\n  );\n}\n\nexport default async function (request) {\n  const { kind, contribution, input } = request ?? {};\n\n  if (kind === 'action') {\n    if (contribution === 'crm.snapshot') {\n      const state = await readAll();\n      const settings = await readPluginSettings();\n      const metrics = computeMetrics(state.accounts, state.deals, state.activities, settings.follow_up_days);\n      return {\n        revision: state.revision,\n        accounts: state.accounts,\n        deals: state.deals,\n        activities: state.activities,\n        metrics,\n        settings,\n      };\n    }\n\n    if (contribution === 'crm.account.save') {\n      const record = sanitizeAccount({ ...input, updated_at: todayStr() });\n      if (!record) return { status: 'invalid_input', revision: input.expected_revision };\n      const cur = await readCollection(COL_ACCOUNTS);\n      if (cur.revision !== input.expected_revision) return { status: 'conflict', revision: cur.revision };\n      const exists = cur.items.some(a => a.id === record.id);\n      const next = exists ? cur.items.map(a => (a.id === record.id ? record : a)) : [record, ...cur.items];\n      return writeCollection(COL_ACCOUNTS, input.expected_revision, next, MAX_ACCOUNTS);\n    }\n\n    if (contribution === 'crm.account.delete') {\n      const state = await readAll();\n      if (state.revision !== input.expected_revision) return { status: 'conflict', revision: state.revision };\n      if (!state.accounts.some(a => a.id === input.id)) return { status: 'not_found', revision: state.revision };\n\n      const nextAcc = state.accounts.filter(a => a.id !== input.id);\n      const nextDeals = state.deals.filter(d => d.account_id !== input.id);\n      const nextActs = state.activities.filter(a => a.account_id !== input.id);\n\n      let rev = input.expected_revision;\n      const r1 = await writeCollection(COL_ACCOUNTS, rev, nextAcc, MAX_ACCOUNTS);\n      if (r1.status !== 'saved') return { status: 'conflict', revision: r1.revision };\n      rev = r1.revision;\n\n      if (nextDeals.length !== state.deals.length) {\n        const r2 = await writeCollection(COL_DEALS, rev, nextDeals, MAX_DEALS);\n        if (r2.status !== 'saved') return { status: 'conflict', revision: r2.revision };\n        rev = r2.revision;\n      }\n      if (nextActs.length !== state.activities.length) {\n        const r3 = await writeCollection(COL_ACTIVITIES, rev, nextActs, MAX_ACTIVITIES);\n        if (r3.status !== 'saved') return { status: 'conflict', revision: r3.revision };\n        rev = r3.revision;\n      }\n      return { status: 'deleted', revision: rev };\n    }\n\n    if (contribution === 'crm.deal.save') {\n      const record = sanitizeDeal({ ...input, updated_at: todayStr() });\n      if (!record) return { status: 'invalid_input', revision: input.expected_revision };\n      const acc = await readCollection(COL_ACCOUNTS);\n      const deals = await readCollection(COL_DEALS);\n      const rev = Math.max(acc.revision, deals.revision);\n      if (rev !== input.expected_revision) return { status: 'conflict', revision: rev };\n      if (!acc.items.some(a => a.id === record.account_id)) {\n        return { status: 'account_not_found', revision: rev };\n      }\n      const exists = deals.items.some(d => d.id === record.id);\n      const next = exists ? deals.items.map(d => (d.id === record.id ? record : d)) : [record, ...deals.items];\n      return writeCollection(COL_DEALS, input.expected_revision, next, MAX_DEALS);\n    }\n\n    if (contribution === 'crm.deal.stage') {\n      const deals = await readCollection(COL_DEALS);\n      if (deals.revision !== input.expected_revision) return { status: 'conflict', revision: deals.revision };\n      const target = deals.items.find(d => d.id === input.id);\n      if (!target) return { status: 'not_found', revision: deals.revision };\n      const prob = typeof input.probability === 'number' ? input.probability : STAGE_PROB[input.stage];\n      const updated = {\n        ...target,\n        stage: input.stage,\n        probability: prob,\n        loss_reason: typeof input.loss_reason === 'string' ? input.loss_reason.trim().slice(0, 160) : target.loss_reason,\n        updated_at: todayStr(),\n      };\n      const next = deals.items.map(d => (d.id === input.id ? updated : d));\n      const res = await writeCollection(COL_DEALS, input.expected_revision, next, MAX_DEALS);\n      if (res.status !== 'saved') return { status: 'conflict', revision: res.revision };\n      return { status: 'saved', revision: res.revision, stage: updated.stage, probability: updated.probability };\n    }\n\n    if (contribution === 'crm.deal.delete') {\n      const deals = await readCollection(COL_DEALS);\n      if (deals.revision !== input.expected_revision) return { status: 'conflict', revision: deals.revision };\n      if (!deals.items.some(d => d.id === input.id)) return { status: 'not_found', revision: deals.revision };\n      const res = await writeCollection(COL_DEALS, input.expected_revision, deals.items.filter(d => d.id !== input.id), MAX_DEALS);\n      return res.status === 'saved' ? { status: 'deleted', revision: res.revision } : { status: 'conflict', revision: res.revision };\n    }\n\n    if (contribution === 'crm.activity.save') {\n      const record = sanitizeActivity(input);\n      if (!record) return { status: 'invalid_input', revision: input.expected_revision };\n      const acc = await readCollection(COL_ACCOUNTS);\n      const acts = await readCollection(COL_ACTIVITIES);\n      const rev = Math.max(acc.revision, acts.revision);\n      if (rev !== input.expected_revision) return { status: 'conflict', revision: rev };\n      if (!acc.items.some(a => a.id === record.account_id)) {\n        return { status: 'account_not_found', revision: rev };\n      }\n      const exists = acts.items.some(a => a.id === record.id);\n      const next = exists ? acts.items.map(a => (a.id === record.id ? record : a)) : [record, ...acts.items];\n      return writeCollection(COL_ACTIVITIES, input.expected_revision, next, MAX_ACTIVITIES);\n    }\n\n    if (contribution === 'crm.activity.delete') {\n      const acts = await readCollection(COL_ACTIVITIES);\n      if (acts.revision !== input.expected_revision) return { status: 'conflict', revision: acts.revision };\n      if (!acts.items.some(a => a.id === input.id)) return { status: 'not_found', revision: acts.revision };\n      const res = await writeCollection(COL_ACTIVITIES, input.expected_revision, acts.items.filter(a => a.id !== input.id), MAX_ACTIVITIES);\n      return res.status === 'saved' ? { status: 'deleted', revision: res.revision } : { status: 'conflict', revision: res.revision };\n    }\n\n    if (contribution === 'crm.demo.seed') {\n      const cur = await readCollection(COL_ACCOUNTS);\n      if (cur.revision !== input.expected_revision) return { status: 'conflict', revision: cur.revision };\n      const demo = buildDemoDataset();\n      let rev = input.expected_revision;\n      const r1 = await writeCollection(COL_ACCOUNTS, rev, demo.accounts, MAX_ACCOUNTS);\n      if (r1.status !== 'saved') return { status: 'conflict', revision: r1.revision };\n      rev = r1.revision;\n      const r2 = await writeCollection(COL_DEALS, rev, demo.deals, MAX_DEALS);\n      if (r2.status !== 'saved') return { status: 'conflict', revision: r2.revision };\n      rev = r2.revision;\n      const r3 = await writeCollection(COL_ACTIVITIES, rev, demo.activities, MAX_ACTIVITIES);\n      if (r3.status !== 'saved') return { status: 'conflict', revision: r3.revision };\n      return {\n        status: 'seeded',\n        revision: r3.revision,\n        counts: {\n          accounts: demo.accounts.length,\n          deals: demo.deals.length,\n          activities: demo.activities.length,\n        },\n      };\n    }\n\n    if (contribution === 'document.list') {\n      const listed = await globalThis.nmas.data.list({ collection: COL_ACCOUNTS, limit: 20 });\n      const state = listed.keys.length ? await readAll() : { accounts: [], deals: [], activities: [] };\n      const items = [\n        {\n          id: 'all',\n          label: `完整 CRM 快照（${state.accounts.length} 客户 / ${state.deals.length} 商机 / ${state.activities.length} 互动）`,\n        },\n        ...state.accounts.map(a => ({ id: a.id, label: `客户 360° 档案：${a.name} (${a.industry})` })),\n      ];\n      return { items };\n    }\n\n    if (contribution === 'document.export') {\n      const state = await readAll();\n      if (input.id === 'all') {\n        const payload = {\n          format: DOC_FORMAT,\n          version: 1,\n          scope: 'full',\n          accounts: state.accounts,\n          deals: state.deals,\n          activities: state.activities,\n        };\n        const text = JSON.stringify(payload);\n        if (jsonBytes(text) > MAX_RECORD_BYTES) return { error: 'payload_too_large' };\n        return { filename: `crm-sales-os-${todayStr()}.json`, text };\n      }\n      const acc = state.accounts.find(a => a.id === input.id);\n      if (!acc) return { error: 'not_found' };\n      const payload = {\n        format: DOC_FORMAT,\n        version: 1,\n        scope: 'account',\n        accounts: [acc],\n        deals: state.deals.filter(d => d.account_id === acc.id),\n        activities: state.activities.filter(a => a.account_id === acc.id),\n      };\n      const text = JSON.stringify(payload);\n      if (jsonBytes(text) > MAX_RECORD_BYTES) return { error: 'payload_too_large' };\n      return { filename: `crm-${acc.id}.json`, text };\n    }\n\n    if (contribution === 'document.import') {\n      let parsed;\n      try {\n        parsed = JSON.parse(input.text);\n      } catch {\n        return { imported: false, reason: 'invalid_json' };\n      }\n      if (\n        !parsed ||\n        parsed.format !== DOC_FORMAT ||\n        parsed.version !== 1 ||\n        !Array.isArray(parsed.accounts) ||\n        !Array.isArray(parsed.deals) ||\n        !Array.isArray(parsed.activities)\n      ) {\n        return { imported: false, reason: 'invalid_document' };\n      }\n      const cleanAcc = parsed.accounts.map(sanitizeAccount).filter(Boolean);\n      const cleanDeals = parsed.deals.map(sanitizeDeal).filter(Boolean);\n      const cleanActs = parsed.activities.map(sanitizeActivity).filter(Boolean);\n      if (!cleanAcc.length) return { imported: false, reason: 'empty_accounts' };\n\n      const state = await readAll();\n      let nextAcc;\n      let nextDeals;\n      let nextActs;\n      if (parsed.scope === 'full') {\n        nextAcc = cleanAcc;\n        nextDeals = cleanDeals;\n        nextActs = cleanActs;\n      } else {\n        const mergeById = (base, incoming) => {\n          const map = new Map(base.map(x => [x.id, x]));\n          for (const item of incoming) map.set(item.id, item);\n          return Array.from(map.values());\n        };\n        nextAcc = mergeById(state.accounts, cleanAcc);\n        nextDeals = mergeById(state.deals, cleanDeals);\n        nextActs = mergeById(state.activities, cleanActs);\n      }\n\n      let rev = state.revision;\n      const r1 = await writeCollection(COL_ACCOUNTS, rev, nextAcc, MAX_ACCOUNTS);\n      if (r1.status !== 'saved') return { imported: false, reason: r1.status };\n      rev = r1.revision;\n      const r2 = await writeCollection(COL_DEALS, rev, nextDeals, MAX_DEALS);\n      if (r2.status !== 'saved') return { imported: false, reason: r2.status };\n      rev = r2.revision;\n      const r3 = await writeCollection(COL_ACTIVITIES, rev, nextActs, MAX_ACTIVITIES);\n      if (r3.status !== 'saved') return { imported: false, reason: r3.status };\n      return { imported: true };\n    }\n  }\n\n  if (kind === 'tool') {\n    if (contribution === 'crm.pipeline') {\n      const state = await readAll();\n      const metrics = computeMetrics(state.accounts, state.deals, state.activities);\n      const accNameMap = new Map(state.accounts.map(a => [a.id, a.name]));\n      const filteredDeals = input.stage ? state.deals.filter(d => d.stage === input.stage) : state.deals;\n      const topDeals = [...filteredDeals]\n        .sort((a, b) => b.amount - a.amount)\n        .slice(0, 8)\n        .map(d => ({\n          id: d.id,\n          title: d.title,\n          account_name: accNameMap.get(d.account_id) || d.account_id,\n          stage: d.stage,\n          amount: d.amount,\n          probability: d.probability,\n          close_date: d.close_date,\n        }));\n      return {\n        success: true,\n        status: state.deals.length ? 'ready' : 'empty',\n        summary: {\n          active_pipeline: metrics.active_pipeline,\n          weighted_forecast: metrics.weighted_forecast,\n          won_amount: metrics.won_amount,\n          win_rate: metrics.win_rate,\n          overdue_count: metrics.overdue_count,\n          due_soon_count: metrics.due_soon_count,\n        },\n        stages: metrics.funnel,\n        top_deals: topDeals,\n      };\n    }\n\n    if (contribution === 'crm.account.get') {\n      const state = await readAll();\n      const acc = findAccountByNameOrId(state.accounts, input.name);\n      if (!acc) return { success: false, status: 'not_found' };\n      const accDeals = state.deals.filter(d => d.account_id === acc.id);\n      const totalDealAmount = round2(accDeals.reduce((s, d) => s + (Number(d.amount) || 0), 0));\n      const recentActs = state.activities\n        .filter(a => a.account_id === acc.id)\n        .sort((a, b) => b.date.localeCompare(a.date))\n        .slice(0, 6)\n        .map(({ id, type, date, summary, next_action, next_due, done }) => ({\n          id,\n          type,\n          date,\n          summary,\n          next_action,\n          next_due,\n          done,\n        }));\n      return {\n        success: true,\n        status: 'found',\n        account: {\n          id: acc.id,\n          name: acc.name,\n          industry: acc.industry,\n          size: acc.size,\n          health: acc.health,\n          contact_name: acc.contact_name,\n          contact_role: acc.contact_role,\n          annual_potential: acc.annual_potential,\n          risk_note: acc.risk_note,\n          total_deal_amount: totalDealAmount,\n        },\n        deals: accDeals.map(({ id, title, stage, amount, probability, close_date }) => ({\n          id,\n          title,\n          stage,\n          amount,\n          probability,\n          close_date,\n        })),\n        recent_activities: recentActs,\n      };\n    }\n\n    if (contribution === 'crm.activity.log') {\n      const state = await readAll();\n      const acc = findAccountByNameOrId(state.accounts, input.account_name);\n      if (!acc) return { success: false, status: 'account_not_found' };\n      const date = input.date || todayStr();\n      const nextDue = input.next_due || '';\n      const dealId = input.deal_id || '';\n      const record = sanitizeActivity({\n        id: makeId('act'),\n        account_id: acc.id,\n        deal_id: dealId,\n        type: input.type,\n        date,\n        summary: input.summary,\n        next_action: input.next_action || '',\n        next_due: nextDue,\n        done: false,\n      });\n      if (!record) return { success: false, status: 'invalid_input' };\n      const res = await writeCollection(COL_ACTIVITIES, state.revision, [record, ...state.activities], MAX_ACTIVITIES);\n      if (res.status !== 'saved') {\n        return { success: false, status: res.status === 'limit' ? 'limit' : 'conflict' };\n      }\n      return {\n        success: true,\n        status: 'logged',\n        activity_id: record.id,\n        account_name: acc.name,\n      };\n    }\n  }\n\n  throw new Error(`不支持的调用: ${kind}/${contribution}`);\n}\n","path":"backend/index.js"},{"content":"<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>AI 智能客户与商机管理系统 · CRM Sales OS</title>\n<style>\n:root{color-scheme:light dark;--bg:#f4f6fb;--surface:#fff;--surface-2:#f8fafc;--surface-hover:#f1f5f9;--fg:#0f172a;--fg-2:#334155;--muted:#64748b;--border:#e2e8f0;--border-strong:#cbd5e1;--accent:#4f46e5;--accent-2:#6366f1;--accent-soft:rgba(79,70,229,.1);--ok:#059669;--ok-soft:rgba(5,150,105,.12);--warn:#d97706;--warn-soft:rgba(217,119,6,.13);--danger:#dc2626;--danger-soft:rgba(220,38,38,.12);--sky:#0284c7;--violet:#7c3aed;--shadow-sm:0 1px 2px rgba(15,23,42,.05);--shadow-md:0 6px 20px rgba(15,23,42,.07);--r:12px;--rs:8px;font:13.5px/1.5 -apple-system,BlinkMacSystemFont,\"SF Pro Text\",\"PingFang SC\",\"Segoe UI\",sans-serif}\n:root[data-theme=\"dark\"]{--bg:#0b1120;--surface:#111827;--surface-2:#162033;--surface-hover:#1e293b;--fg:#f1f5f9;--fg-2:#cbd5e1;--muted:#94a3b8;--border:#1f2b40;--border-strong:#334155;--accent:#6366f1;--accent-2:#818cf8;--accent-soft:rgba(99,102,241,.18);--ok:#10b981;--ok-soft:rgba(16,185,129,.16);--warn:#f59e0b;--warn-soft:rgba(245,158,11,.16);--danger:#f87171;--danger-soft:rgba(248,113,113,.16);--sky:#38bdf8;--violet:#a78bfa;--shadow-sm:0 1px 2px rgba(0,0,0,.25);--shadow-md:0 10px 28px rgba(0,0,0,.35)}\n*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--fg);min-height:100vh}.num{font-variant-numeric:tabular-nums}[hidden]{display:none!important}\n.shell{display:grid;grid-template-columns:220px minmax(0,1fr);min-height:100vh}\n.sidebar{background:var(--surface);border-right:1px solid var(--border);padding:16px 12px;display:flex;flex-direction:column;gap:14px;position:sticky;top:0;height:100vh;overflow-y:auto}\n.brand{display:flex;align-items:center;gap:10px;padding:4px 6px 10px;border-bottom:1px solid var(--border)}\n.brand-icon{width:34px;height:34px;border-radius:10px;background:linear-gradient(135deg,var(--accent),var(--violet));display:grid;place-items:center;color:#fff;flex-shrink:0;box-shadow:0 4px 12px rgba(79,70,229,.3)}\n.brand-title{font-weight:750;font-size:14px;letter-spacing:-.01em;line-height:1.25}.brand-sub{font-size:11px;color:var(--muted)}\n.nav{display:flex;flex-direction:column;gap:4px}\n.nav-btn{display:flex;align-items:center;gap:9px;width:100%;padding:9px 10px;border-radius:9px;border:1px solid transparent;background:transparent;color:var(--fg-2);font:inherit;font-weight:500;cursor:pointer;text-align:left;transition:all .15s}\n.nav-btn:hover{background:var(--surface-hover);color:var(--fg)}.nav-btn.active{background:var(--accent-soft);color:var(--accent);border-color:rgba(99,102,241,.25);font-weight:650}\n.nav-badge{margin-left:auto;font-size:11px;font-weight:650;padding:1px 7px;border-radius:999px;background:var(--surface-2);color:var(--muted)}.nav-badge.alert{background:var(--danger-soft);color:var(--danger)}\n.side-footer{margin-top:auto;display:flex;flex-direction:column;gap:6px;padding-top:12px;border-top:1px solid var(--border)}\n.side-tool{width:100%;padding:7px 10px;border-radius:8px;border:1px solid var(--border);background:var(--surface-2);color:var(--fg-2);font:inherit;font-size:12.5px;font-weight:500;cursor:pointer}\n.side-tool:hover{border-color:var(--accent);color:var(--accent);background:var(--accent-soft)}\n.main{padding:16px 20px 28px;display:flex;flex-direction:column;gap:14px;min-width:0}\n.topbar{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px}\n.page-title{font-size:18px;font-weight:750;margin:0;letter-spacing:-.015em}\n.status-pill{font-size:12px;color:var(--muted);background:var(--surface);border:1px solid var(--border);padding:4px 10px;border-radius:999px;display:inline-flex;align-items:center;gap:6px}\n.status-pill[data-error=\"true\"]{color:var(--danger);border-color:var(--danger);background:var(--danger-soft)}\n.dot{width:7px;height:7px;border-radius:50%;background:var(--ok);display:inline-block}.status-pill[data-error=\"true\"] .dot{background:var(--danger)}\n.kpi-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}\n.kpi-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:13px 15px;box-shadow:var(--shadow-sm);display:flex;flex-direction:column;gap:4px;position:relative;overflow:hidden}\n.kpi-card::before{content:\"\";position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--accent)}.kpi-card.ok::before{background:var(--ok)}.kpi-card.sky::before{background:var(--sky)}.kpi-card.warn::before{background:var(--warn)}\n.kpi-label{font-size:12px;color:var(--muted);font-weight:500;display:flex;justify-content:space-between;align-items:center}\n.kpi-val{font-size:21px;font-weight:780;letter-spacing:-.02em}.kpi-sub{font-size:11.5px;color:var(--muted)}\n.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:14px 16px;box-shadow:var(--shadow-sm)}\n.card-head{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px;margin-bottom:12px}\n.card-title{font-size:14px;font-weight:700;margin:0;display:flex;align-items:center;gap:7px}.row{display:flex;flex-wrap:wrap;gap:8px;align-items:center}.between{justify-content:space-between}.col{display:flex;flex-direction:column;gap:8px}.sub{font-size:12px;color:var(--muted)}.empty{padding:22px 10px;text-align:center;color:var(--muted);font-size:12.5px}\ninput,select,textarea,button{font:inherit;color:var(--fg);border:1px solid var(--border-strong);border-radius:var(--rs);padding:6px 10px;background:var(--surface);transition:border-color .15s,box-shadow .15s}\ninput:focus,select:focus,textarea:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)}\ntextarea{resize:vertical;min-height:76px;width:100%}\nbutton{cursor:pointer;font-weight:550;display:inline-flex;align-items:center;justify-content:center;gap:5px}\nbutton:hover:not(:disabled){border-color:var(--accent)}button.primary{background:var(--accent);border-color:var(--accent);color:#fff}button.primary:hover:not(:disabled){background:var(--accent-2);border-color:var(--accent-2)}\nbutton.ok{background:var(--ok);border-color:var(--ok);color:#fff}button.ghost{background:transparent;border-color:var(--border);color:var(--fg-2)}button.ghost:hover:not(:disabled){background:var(--surface-hover);color:var(--fg)}\nbutton.danger{color:var(--danger);border-color:rgba(220,38,38,.35);background:var(--danger-soft)}button.sm{padding:4px 8px;font-size:12px;border-radius:6px}button:disabled{opacity:.5;cursor:not-allowed}\n.tag{display:inline-flex;align-items:center;gap:4px;font-size:11.5px;font-weight:650;padding:2px 8px;border-radius:999px;background:var(--surface-2);color:var(--fg-2);border:1px solid var(--border)}\n.tag.accent{background:var(--accent-soft);color:var(--accent);border-color:transparent}.tag.ok{background:var(--ok-soft);color:var(--ok);border-color:transparent}.tag.warn{background:var(--warn-soft);color:var(--warn);border-color:transparent}.tag.danger{background:var(--danger-soft);color:var(--danger);border-color:transparent}\n.charts-grid{display:grid;grid-template-columns:1.15fr 1fr;gap:12px}.svg-wrap{width:100%;overflow:hidden}.svg-wrap svg{width:100%;height:auto;display:block}\n.kanban{display:grid;grid-template-columns:repeat(5,minmax(200px,1fr));gap:10px;overflow-x:auto;padding-bottom:6px}\n.lane{background:var(--surface-2);border:1px solid var(--border);border-radius:var(--r);padding:10px;display:flex;flex-direction:column;gap:8px;min-height:260px}\n.lane-head{display:flex;align-items:center;justify-content:space-between;padding-bottom:6px;border-bottom:2px solid var(--border)}\n.lane-head[data-stage=\"lead\"]{border-bottom-color:#64748b}.lane-head[data-stage=\"qualified\"]{border-bottom-color:#0284c7}.lane-head[data-stage=\"proposal\"]{border-bottom-color:#7c3aed}.lane-head[data-stage=\"negotiation\"]{border-bottom-color:#d97706}.lane-head[data-stage=\"won\"]{border-bottom-color:#059669}\n.lane-title{font-size:12.5px;font-weight:700;display:flex;align-items:center;gap:6px}.lane-sum{font-size:11.5px;color:var(--muted);font-weight:650}\n.deal-card{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:10px 11px;display:flex;flex-direction:column;gap:7px;box-shadow:var(--shadow-sm);transition:transform .14s,border-color .14s}\n.deal-card:hover{transform:translateY(-1px);border-color:var(--accent)}\n.deal-acc{font-size:11.5px;color:var(--accent);font-weight:650;display:flex;justify-content:space-between}.deal-title{font-size:13px;font-weight:700;line-height:1.35}\n.deal-amt{font-size:15px;font-weight:780;display:flex;align-items:baseline;justify-content:space-between}\n.prob-bar{height:5px;border-radius:999px;background:var(--border);overflow:hidden}.prob-fill{height:100%;border-radius:999px;background:linear-gradient(90deg,var(--accent),var(--ok))}\n.deal-meta{font-size:11.5px;color:var(--muted);display:flex;justify-content:space-between;gap:6px}\n.deal-step{font-size:11.5px;color:var(--fg-2);background:var(--surface-2);padding:5px 7px;border-radius:6px;line-height:1.4}.deal-actions{display:flex;gap:5px;flex-wrap:wrap;padding-top:2px}\n.split-360{display:grid;grid-template-columns:minmax(250px,310px) minmax(0,1fr);gap:14px}\n.acc-list{display:flex;flex-direction:column;gap:7px;max-height:620px;overflow-y:auto}\n.acc-item{text-align:left;width:100%;padding:10px 12px;border-radius:10px;border:1px solid var(--border);background:var(--surface-2);color:var(--fg);cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:8px}\n.acc-item:hover{border-color:var(--accent)}.acc-item.active{background:var(--accent-soft);border-color:var(--accent)}\n.acc-hero{display:flex;flex-wrap:wrap;gap:16px;align-items:center;padding-bottom:14px;border-bottom:1px solid var(--border)}\n.info-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:12px 0}\n.info-box{background:var(--surface-2);border:1px solid var(--border);border-radius:9px;padding:9px 11px}.info-k{font-size:11.5px;color:var(--muted)}.info-v{font-size:14px;font-weight:750;margin-top:2px}\n.timeline{display:flex;flex-direction:column;gap:9px}\n.act-row{background:var(--surface-2);border:1px solid var(--border);border-left:4px solid var(--accent);border-radius:10px;padding:11px 13px;display:flex;flex-direction:column;gap:6px}\n.act-row.overdue{border-left-color:var(--danger);background:color-mix(in srgb,var(--danger-soft) 45%,var(--surface))}.act-row.soon{border-left-color:var(--warn);background:color-mix(in srgb,var(--warn-soft) 40%,var(--surface))}.act-row.done{border-left-color:var(--ok);opacity:.82}\n.scenario-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}\n.scenario-card{text-align:left;padding:11px 12px;border-radius:10px;border:1.5px solid var(--border);background:var(--surface-2);cursor:pointer;display:flex;flex-direction:column;gap:4px}\n.scenario-card:hover{border-color:var(--accent)}.scenario-card.active{border-color:var(--accent);background:var(--accent-soft)}\n.scenario-title{font-weight:700;font-size:13px}.scenario-desc{font-size:11.5px;color:var(--muted);line-height:1.4}\n.ai-output{white-space:pre-wrap;word-break:break-word;background:var(--surface-2);border:1px solid var(--border);border-radius:10px;padding:14px;font:13.5px/1.65 inherit;max-height:360px;overflow-y:auto;margin:0}\n.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.field{display:flex;flex-direction:column;gap:4px;font-size:12.5px;font-weight:600;color:var(--fg-2)}.field.full{grid-column:1/-1}\n.modal-backdrop{position:fixed;inset:0;background:rgba(15,23,42,.55);display:grid;place-items:center;padding:16px;z-index:50}\n.modal{width:min(620px,100%);max-height:90vh;overflow-y:auto;background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:18px 20px;box-shadow:var(--shadow-md);display:flex;flex-direction:column;gap:12px}\n@media(max-width:960px){.shell{grid-template-columns:1fr}.sidebar{position:static;height:auto;border-right:none;border-bottom:1px solid var(--border);padding:10px 12px;gap:10px}.nav{flex-direction:row;overflow-x:auto}.nav-btn{width:auto;white-space:nowrap}.side-footer{flex-direction:row;margin-top:0;padding-top:8px}.kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.charts-grid,.split-360{grid-template-columns:1fr}.scenario-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}\n@media(max-width:560px){.kpi-grid,.form-grid,.info-grid,.scenario-grid{grid-template-columns:1fr}}\n\n    /* === V2 Host Theme & Compact Surface Start === */\n    :root[data-theme=\"dark\"], html[data-theme=\"dark\"] { color-scheme: dark; --bg: #0b1120; --surface: #111827; --fg: #f1f5f9; --muted: #94a3b8; --border: #1f2b40; --accent: #6366f1; --v2-host-accent: #6366f1; }\n    :root[data-theme=\"light\"], html[data-theme=\"light\"] { color-scheme: light; --bg: #f4f6fb; --surface: #ffffff; --fg: #0f172a; --muted: #64748b; --border: #e2e8f0; --accent: #4f46e5; --v2-host-accent: #4f46e5; }\n    :root[data-theme=\"dark\"]:not([data-theme-override=\"1\"]), html[data-theme=\"dark\"]:not([data-theme-override=\"1\"]) { --bg: var(--host-bg, #0b1120); --surface: var(--host-surface, #111827); --fg: var(--host-fg, #f1f5f9); --muted: var(--host-muted, #94a3b8); --border: var(--host-border, #1f2b40); --v2-host-accent: var(--host-primary, #6366f1); }\n    :root[data-theme=\"light\"]:not([data-theme-override=\"1\"]), html[data-theme=\"light\"]:not([data-theme-override=\"1\"]) { --bg: var(--host-bg, #f4f6fb); --surface: var(--host-surface, #ffffff); --fg: var(--host-fg, #0f172a); --muted: var(--host-muted, #64748b); --border: var(--host-border, #e2e8f0); --v2-host-accent: var(--host-primary, #4f46e5); }\n    :is(button, input, select, textarea, .v2-surface-tab):focus-visible { outline: 2px solid var(--v2-host-accent, var(--accent)); outline-offset: 1px; }\n    html[data-surface=\"chat\"], html[data-surface=\"assistant\"],\n    html[data-surface=\"chat\"] body, html[data-surface=\"assistant\"] body { overflow-x: hidden; }\n    html[data-surface=\"chat\"] .sidebar, html[data-surface=\"assistant\"] .sidebar { display: none !important; }\n    html[data-surface=\"chat\"] .shell, html[data-surface=\"assistant\"] .shell { grid-template-columns: 1fr !important; }\n    html[data-surface=\"chat\"] .charts-grid, html[data-surface=\"assistant\"] .charts-grid, html[data-surface=\"chat\"] .split-360, html[data-surface=\"assistant\"] .split-360, html[data-surface=\"chat\"] .kanban, html[data-surface=\"assistant\"] .kanban, html[data-surface=\"chat\"] .info-grid, html[data-surface=\"assistant\"] .info-grid, html[data-surface=\"chat\"] .form-grid, html[data-surface=\"assistant\"] .form-grid { grid-template-columns: 1fr !important; }\n    html[data-surface=\"chat\"] .kpi-grid, html[data-surface=\"assistant\"] .kpi-grid, html[data-surface=\"chat\"] .scenario-grid, html[data-surface=\"assistant\"] .scenario-grid { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; gap: 8px; }\n    html[data-surface=\"chat\"] :is(section, article, main, .card, .panel, .view),\n    html[data-surface=\"assistant\"] :is(section, article, main, .card, .panel, .view) { min-width: 0; }\n    html[data-surface=\"chat\"] :is(svg, canvas, pre),\n    html[data-surface=\"assistant\"] :is(svg, canvas, pre) { max-width: 100%; }\n    html[data-surface=\"chat\"] .main, html[data-surface=\"assistant\"] .main { padding: 10px 10px 18px; gap: 10px; }\n    html[data-surface=\"chat\"] .topbar, html[data-surface=\"assistant\"] .topbar { gap: 8px; }\n    .v2-surface-nav { display: none; }\n    html[data-surface=\"chat\"] .v2-surface-nav, html[data-surface=\"assistant\"] .v2-surface-nav {\n      display: flex; align-items: center; gap: 6px; padding: 7px 10px; margin: -10px -10px 2px -10px;\n      overflow-x: auto; scrollbar-width: none; flex-shrink: 0;\n      background: var(--surface); border-bottom: 1px solid var(--border);\n      position: sticky; top: 0; z-index: 30;\n    }\n    html[data-surface=\"chat\"] .v2-surface-nav::-webkit-scrollbar, html[data-surface=\"assistant\"] .v2-surface-nav::-webkit-scrollbar { display: none; }\n    .v2-surface-tab {\n      appearance: none; border: 1px solid var(--border); background: transparent;\n      color: var(--muted); border-radius: 999px; padding: 4px 10px; font-size: 12px;\n      line-height: 1.35; font-weight: 500; white-space: nowrap; flex-shrink: 0; cursor: pointer;\n      transition: background 0.14s ease, border-color 0.14s ease, color 0.14s ease;\n    }\n    .v2-surface-tab:hover { color: var(--fg); border-color: var(--v2-host-accent, var(--accent)); }\n    .v2-surface-tab.active {\n      color: var(--v2-host-accent, var(--accent));\n      border-color: var(--v2-host-accent, var(--accent));\n      background: color-mix(in srgb, var(--v2-host-accent, var(--accent)) 14%, transparent);\n      font-weight: 600;\n    }\n    /* === V2 Host Theme & Compact Surface End === */\n  </style>\n</head>\n<body>\n<div class=\"shell\">\n<aside class=\"sidebar\">\n<div class=\"brand\">\n<div class=\"brand-icon\" aria-hidden=\"true\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 3v18h18\"/><path d=\"m7 14 4-4 3 3 6-7\"/></svg></div>\n<div><div class=\"brand-title\">CRM Sales OS</div><div class=\"brand-sub\">AI 智能客户与商机管理</div></div>\n</div>\n<nav class=\"nav\">\n<button type=\"button\" class=\"nav-btn active\" data-view=\"pipeline\"><span>商机漏斗看板</span><span class=\"nav-badge num\" id=\"badge-deals\">0</span></button>\n<button type=\"button\" class=\"nav-btn\" data-view=\"accounts\"><span>客户 360° 档案</span><span class=\"nav-badge num\" id=\"badge-accounts\">0</span></button>\n<button type=\"button\" class=\"nav-btn\" data-view=\"activities\"><span>互动时间轴与提醒</span><span class=\"nav-badge num\" id=\"badge-alerts\">0</span></button>\n<button type=\"button\" class=\"nav-btn\" data-view=\"advisor\"><span>AI 销售军师</span><span class=\"nav-badge\">AI</span></button>\n</nav>\n<div class=\"side-footer\">\n<button type=\"button\" class=\"side-tool\" id=\"btn-seed\">加载 B2B SaaS 演示数据</button>\n<button type=\"button\" class=\"side-tool\" id=\"btn-io\">JSON 导入 / 导出</button>\n<button type=\"button\" class=\"side-tool\" id=\"btn-theme\">切换亮/暗主题</button>\n</div>\n</aside>\n<main class=\"main\">\n<header class=\"topbar\">\n<h1 class=\"page-title\" id=\"view-heading\">商机漏斗看板</h1>\n<div class=\"row\">\n<span class=\"status-pill\" id=\"status-pill\" role=\"status\"><span class=\"dot\"></span><span id=\"status-text\">正在初始化…</span></span>\n<button type=\"button\" class=\"ghost sm\" id=\"btn-refresh\">刷新</button>\n</div>\n</header>\n<section class=\"kpi-grid\">\n<div class=\"kpi-card\"><div class=\"kpi-label\"><span>在途商机总额</span><span class=\"tag accent num\" id=\"kpi-active-cnt\">0 笔</span></div><div class=\"kpi-val num\" id=\"kpi-pipeline\">¥0</div><div class=\"kpi-sub\">覆盖线索至商务报价阶段</div></div>\n<div class=\"kpi-card sky\"><div class=\"kpi-label\"><span>加权预测营收</span><span class=\"tag num\" id=\"kpi-avg-prob\">综合赢率 0%</span></div><div class=\"kpi-val num\" id=\"kpi-weighted\">¥0</div><div class=\"kpi-sub\">按各阶段赢率实时加权</div></div>\n<div class=\"kpi-card ok\"><div class=\"kpi-label\"><span>已赢单营收</span><span class=\"tag ok num\" id=\"kpi-winrate\">赢率 0%</span></div><div class=\"kpi-val num\" id=\"kpi-won\">¥0</div><div class=\"kpi-sub\" id=\"kpi-lost-sub\">丢单归档 ¥0</div></div>\n<div class=\"kpi-card warn\"><div class=\"kpi-label\"><span>客户健康度 / 跟进告警</span><span class=\"tag danger num\" id=\"kpi-overdue\">0 逾期</span></div><div class=\"kpi-val num\" id=\"kpi-health\">0 分</div><div class=\"kpi-sub\" id=\"kpi-soon-sub\">3 日内到期 0 项</div></div>\n</section>\n<section id=\"view-pipeline\" class=\"view\">\n<div class=\"charts-grid\" style=\"margin-bottom:12px\">\n<div class=\"card\"><div class=\"card-head\"><h2 class=\"card-title\">销售转化漏斗（5 阶段）</h2><span class=\"tag\">实时转化率与阶段金额</span></div><div class=\"svg-wrap\" id=\"svg-funnel\"></div></div>\n<div class=\"card\"><div class=\"card-head\"><h2 class=\"card-title\">阶段原始金额 vs 加权营收预测</h2><div class=\"row\" style=\"font-size:11.5px;color:var(--muted)\"><span><strong style=\"color:var(--accent)\">■</strong> 原始金额</span><span><strong style=\"color:var(--ok)\">■</strong> 加权预测</span></div></div><div class=\"svg-wrap\" id=\"svg-forecast\"></div></div>\n</div>\n<div class=\"card\">\n<div class=\"card-head\">\n<h2 class=\"card-title\">5 阶段商机看板</h2>\n<div class=\"row\">\n<input id=\"deal-search\" placeholder=\"搜索商机或客户名称…\" style=\"width:190px\">\n<button type=\"button\" class=\"ghost sm\" id=\"btn-toggle-lost\">显示丢单归档</button>\n<button type=\"button\" class=\"primary sm\" id=\"btn-new-deal\">+ 新建商机</button>\n</div>\n</div>\n<div class=\"kanban\" id=\"kanban-board\"></div>\n<div id=\"lost-archive\" hidden style=\"margin-top:14px;padding-top:12px;border-top:1px dashed var(--border)\">\n<div class=\"row\" style=\"margin-bottom:8px\"><strong style=\"font-size:13px;color:var(--muted)\">丢单归档（复盘库）</strong><span class=\"tag num\" id=\"lost-count\">0</span></div>\n<div id=\"lost-list\" style=\"display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:10px\"></div>\n</div>\n</div>\n</section>\n<section id=\"view-accounts\" class=\"view\" hidden>\n<div class=\"split-360\">\n<div class=\"card\" style=\"display:flex;flex-direction:column;gap:10px\">\n<div class=\"row\"><input id=\"acc-search\" placeholder=\"搜索企业客户/行业…\" style=\"flex:1;min-width:120px\"><button type=\"button\" class=\"primary sm\" id=\"btn-new-acc\">+ 客户</button></div>\n<div class=\"acc-list\" id=\"acc-list\"></div>\n</div>\n<div class=\"card\">\n<div id=\"acc-empty\" style=\"padding:36px 12px;text-align:center;color:var(--muted)\">请选择左侧企业客户查看 360° 全景档案，或点击左下角「加载 B2B SaaS 演示数据」。</div>\n<div id=\"acc-detail\" hidden>\n<div class=\"acc-hero\">\n<div id=\"acc-health-svg\" style=\"width:74px;height:74px;flex-shrink:0\"></div>\n<div style=\"flex:1;min-width:180px\">\n<div class=\"row\" style=\"gap:8px\"><h2 id=\"acc-name\" style=\"margin:0;font-size:18px\"></h2><span class=\"tag accent\" id=\"acc-industry\"></span><span class=\"tag\" id=\"acc-size\"></span></div>\n<div id=\"acc-contact\" style=\"font-size:13px;color:var(--fg-2);margin-top:4px\"></div>\n<div id=\"acc-tags\" class=\"row\" style=\"margin-top:6px\"></div>\n</div>\n<div class=\"row\">\n<button type=\"button\" class=\"primary sm\" id=\"btn-acc-ai\">AI 军师分析</button>\n<button type=\"button\" class=\"ghost sm\" id=\"btn-acc-edit\">编辑</button>\n<button type=\"button\" class=\"danger sm\" id=\"btn-acc-del\">删除</button>\n</div>\n</div>\n<div class=\"info-grid\">\n<div class=\"info-box\"><div class=\"info-k\">年潜在价值 (ARR 潜额)</div><div class=\"info-v num\" id=\"acc-potential\">¥0</div></div>\n<div class=\"info-box\"><div class=\"info-k\">关联商机总额</div><div class=\"info-v num\" id=\"acc-deals-sum\">¥0</div></div>\n<div class=\"info-box\"><div class=\"info-k\">关联商机 / 互动记录</div><div class=\"info-v num\" id=\"acc-counts\">0 / 0</div></div>\n</div>\n<div class=\"info-box\" style=\"margin-bottom:12px\"><div class=\"info-k\">风险提示与策略备注</div><div id=\"acc-risk\" style=\"margin-top:4px;font-size:13px;color:var(--fg-2)\"></div></div>\n<div class=\"card-head\" style=\"margin-top:6px\"><h3 class=\"card-title\">关联商机明细</h3><button type=\"button\" class=\"ghost sm\" id=\"btn-acc-add-deal\">+ 为该客户建商机</button></div>\n<div id=\"acc-deals-list\" style=\"display:flex;flex-direction:column;gap:8px;margin-bottom:14px\"></div>\n<div class=\"card-head\"><h3 class=\"card-title\">历史互动时间轴</h3><button type=\"button\" class=\"ghost sm\" id=\"btn-acc-add-act\">+ 记录跟进</button></div>\n<div id=\"acc-acts-list\" class=\"timeline\"></div>\n</div>\n</div>\n</div>\n</section>\n<section id=\"view-activities\" class=\"view\" hidden>\n<div class=\"card\" style=\"margin-bottom:12px\">\n<div class=\"card-head\"><h2 class=\"card-title\">快速记录互动跟进</h2><span class=\"tag\">自动计算逾期与 3 日内到期提醒</span></div>\n<div class=\"form-grid\">\n<label class=\"field\">关联客户<select id=\"act-f-acc\"></select></label>\n<label class=\"field\">关联商机（可选）<select id=\"act-f-deal\"></select></label>\n<label class=\"field\">互动方式<select id=\"act-f-type\"></select></label>\n<label class=\"field\">互动日期<input id=\"act-f-date\" type=\"date\"></label>\n<label class=\"field full\">互动内容摘要<textarea id=\"act-f-summary\" maxlength=\"400\" placeholder=\"记录核心沟通要点、客户异议或决策链信息…\"></textarea></label>\n<label class=\"field\">下一步行动<input id=\"act-f-next\" maxlength=\"160\" placeholder=\"例如：发送修订报价并约法务终审\"></label>\n<label class=\"field\">下次跟进截止日<input id=\"act-f-due\" type=\"date\"></label>\n</div>\n<div class=\"row\" style=\"margin-top:10px;justify-content:flex-end\"><button type=\"button\" class=\"primary\" id=\"btn-act-submit\">记录此互动跟进</button></div>\n</div>\n<div class=\"card\">\n<div class=\"card-head\">\n<h2 class=\"card-title\">互动时间轴与到期提醒</h2>\n<div class=\"row\">\n<select id=\"act-filter-status\"><option value=\"all\">全部状态</option><option value=\"urgent\">仅看逾期与 3 日内到期</option><option value=\"open\">仅看待跟进</option><option value=\"done\">仅看已完成</option></select>\n<select id=\"act-filter-type\"></select>\n</div>\n</div>\n<div id=\"act-timeline\" class=\"timeline\"></div>\n</div>\n</section>\n<section id=\"view-advisor\" class=\"view\" hidden>\n<div class=\"card\" style=\"display:flex;flex-direction:column;gap:14px\">\n<div class=\"card-head\" style=\"margin-bottom:0\"><h2 class=\"card-title\">销售军师模板与提示词工作台</h2><span class=\"tag accent\">本地结构化模板 · 可协同工作台聊天 / AI 伴生插件</span></div>\n<div class=\"form-grid\">\n<label class=\"field\">选择目标企业客户<select id=\"ai-acc\"></select></label>\n<label class=\"field\">选择聚焦商机（可选）<select id=\"ai-deal\"></select></label>\n</div>\n<div class=\"info-box\" id=\"ai-context-preview\" style=\"font-size:12.5px;line-height:1.6;color:var(--fg-2);white-space:pre-line\"></div>\n<div>\n<div style=\"font-size:12.5px;font-weight:700;margin-bottom:7px;color:var(--fg-2)\">选择 AI 销售辅助场景</div>\n<div class=\"scenario-grid\" id=\"ai-scenarios\">\n<button type=\"button\" class=\"scenario-card active\" data-sc=\"email\"><span class=\"scenario-title\">起草高转化跟进邮件</span><span class=\"scenario-desc\">紧扣联系人职位与痛点，输出可直接发送的商务邮件与 CTA</span></button>\n<button type=\"button\" class=\"scenario-card\" data-sc=\"objection\"><span class=\"scenario-title\">生成异议应对脚本</span><span class=\"scenario-desc\">拆解价格/竞品/法务审批阻力，输出 LAER 应对话术</span></button>\n<button type=\"button\" class=\"scenario-card\" data-sc=\"strategy\"><span class=\"scenario-title\">输出赢单推进策略</span><span class=\"scenario-desc\">按 MEDDPICC 诊断缺口，制定未来 14 天 3 步必做动作</span></button>\n<button type=\"button\" class=\"scenario-card\" data-sc=\"review\"><span class=\"scenario-title\">复盘成败原因</span><span class=\"scenario-desc\">提炼赢单打法或丢单根因，沉淀行业最佳实践</span></button>\n</div>\n</div>\n<label class=\"field\">补充背景或特别要求（可选）<input id=\"ai-extra\" maxlength=\"200\" placeholder=\"例如：重点回应竞品 8 折低价策略，语气专业克制\"></label>\n<div class=\"row\">\n<button type=\"button\" class=\"primary\" id=\"btn-ai-draft\">生成本地结构化销售方案</button>\n<button type=\"button\" class=\"ghost\" id=\"btn-ai-prompt\">复制 AI 军师提示词</button>\n<span id=\"ai-state\" style=\"font-size:12.5px;color:var(--muted)\"></span>\n</div>\n<div id=\"ai-result-box\" hidden style=\"display:flex;flex-direction:column;gap:10px;padding-top:10px;border-top:1px dashed var(--border)\">\n<pre class=\"ai-output\" id=\"ai-output\"></pre>\n<div class=\"row\">\n<button type=\"button\" class=\"primary sm\" id=\"btn-ai-insert\">一键插入会话输入框</button>\n<button type=\"button\" class=\"ok sm\" id=\"btn-ai-save-act\">存入该客户互动记录</button>\n<button type=\"button\" class=\"ghost sm\" id=\"btn-ai-copy\">复制结果</button>\n</div>\n</div>\n</div>\n</section>\n</main>\n</div>\n<div class=\"modal-backdrop\" id=\"modal-acc\" hidden><div class=\"modal\">\n<div class=\"card-head\" style=\"margin-bottom:0\"><h2 class=\"card-title\" id=\"m-acc-title\">新建企业客户</h2><button type=\"button\" class=\"ghost sm\" data-close=\"modal-acc\">关闭</button></div>\n<div class=\"form-grid\">\n<label class=\"field\">企业名称 *<input id=\"m-acc-name\" maxlength=\"64\"></label>\n<label class=\"field\">所属行业 *<input id=\"m-acc-ind\" maxlength=\"32\"></label>\n<label class=\"field\">企业规模<select id=\"m-acc-size\"><option value=\"startup\">初创 (Startup)</option><option value=\"smb\">成长型 (SMB)</option><option value=\"midmarket\">中大型 (Mid-Market)</option><option value=\"enterprise\">大型集团 (Enterprise)</option></select></label>\n<label class=\"field\">健康度评分 (0-100)<input id=\"m-acc-health\" type=\"number\" min=\"0\" max=\"100\" value=\"80\"></label>\n<label class=\"field\">关键联系人 *<input id=\"m-acc-contact\" maxlength=\"40\"></label>\n<label class=\"field\">联系人职位<input id=\"m-acc-role\" maxlength=\"40\"></label>\n<label class=\"field\">年潜在价值 (¥)<input id=\"m-acc-pot\" type=\"number\" min=\"0\" max=\"999999999\" value=\"500000\"></label>\n<label class=\"field\">标签（逗号分隔）<input id=\"m-acc-tags\" placeholder=\"灯塔客户, 私有部署\"></label>\n<label class=\"field full\">风险提示与备注<textarea id=\"m-acc-risk\" maxlength=\"240\"></textarea></label>\n</div>\n<div class=\"row\" style=\"justify-content:flex-end\"><button type=\"button\" class=\"ghost\" data-close=\"modal-acc\">取消</button><button type=\"button\" class=\"primary\" id=\"btn-m-acc-save\">保存客户档案</button></div>\n</div></div>\n<div class=\"modal-backdrop\" id=\"modal-deal\" hidden><div class=\"modal\">\n<div class=\"card-head\" style=\"margin-bottom:0\"><h2 class=\"card-title\" id=\"m-deal-title\">新建商机</h2><button type=\"button\" class=\"ghost sm\" data-close=\"modal-deal\">关闭</button></div>\n<div class=\"form-grid\">\n<label class=\"field full\">商机名称 *<input id=\"m-deal-name\" maxlength=\"80\"></label>\n<label class=\"field\">关联客户 *<select id=\"m-deal-acc\"></select></label>\n<label class=\"field\">所处阶段<select id=\"m-deal-stage\"><option value=\"lead\">线索 (15%)</option><option value=\"qualified\">需求确认 (35%)</option><option value=\"proposal\">方案评审 (60%)</option><option value=\"negotiation\">商务报价 (80%)</option><option value=\"won\">赢单 (100%)</option><option value=\"lost\">丢单归档 (0%)</option></select></label>\n<label class=\"field\">商机金额 (¥)<input id=\"m-deal-amt\" type=\"number\" min=\"0\" max=\"999999999\" value=\"300000\"></label>\n<label class=\"field\">预计赢率 (%)<input id=\"m-deal-prob\" type=\"number\" min=\"0\" max=\"100\" value=\"35\"></label>\n<label class=\"field\">预计成交日<input id=\"m-deal-date\" type=\"date\"></label>\n<label class=\"field\">负责人<input id=\"m-deal-owner\" maxlength=\"32\" value=\"销售负责人\"></label>\n<label class=\"field full\">下一步关键动作<input id=\"m-deal-step\" maxlength=\"160\"></label>\n<label class=\"field full\">丢单/复盘备注<input id=\"m-deal-loss\" maxlength=\"160\"></label>\n</div>\n<div class=\"row\" style=\"justify-content:space-between\"><button type=\"button\" class=\"danger\" id=\"btn-m-deal-del\" hidden>删除商机</button><div class=\"row\"><button type=\"button\" class=\"ghost\" data-close=\"modal-deal\">取消</button><button type=\"button\" class=\"primary\" id=\"btn-m-deal-save\">保存商机</button></div></div>\n</div></div>\n<div class=\"modal-backdrop\" id=\"modal-io\" hidden><div class=\"modal\">\n<div class=\"card-head\" style=\"margin-bottom:0\"><h2 class=\"card-title\">数据导入与导出（document.*）</h2><button type=\"button\" class=\"ghost sm\" data-close=\"modal-io\">关闭</button></div>\n<div class=\"row\"><select id=\"io-select\" style=\"flex:1\"></select><button type=\"button\" class=\"primary sm\" id=\"btn-io-export\">导出 JSON</button></div>\n<label class=\"field\">JSON 数据内容<textarea id=\"io-text\" style=\"min-height:170px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px\"></textarea></label>\n<div class=\"row\" style=\"justify-content:space-between\"><span id=\"io-msg\" style=\"font-size:12px;color:var(--muted)\"></span><div class=\"row\"><button type=\"button\" class=\"ghost sm\" id=\"btn-io-copy\">复制 JSON</button><button type=\"button\" class=\"ok sm\" id=\"btn-io-import\">校验并导入</button></div></div>\n</div></div>\n<script>\n(() => {\nconst plugin = globalThis.nmasPlugin;\nconst $ = id => document.getElementById(id);\nconst on = (id, ev, fn) => $(id).addEventListener(ev, fn);\nconst STAGE_META = [\n{ id: 'lead', label: '线索', prob: 15, color: '#64748b', next: 'qualified' },\n{ id: 'qualified', label: '需求确认', prob: 35, color: '#0284c7', next: 'proposal' },\n{ id: 'proposal', label: '方案评审', prob: 60, color: '#7c3aed', next: 'negotiation' },\n{ id: 'negotiation', label: '商务报价', prob: 80, color: '#d97706', next: 'won' },\n{ id: 'won', label: '赢单', prob: 100, color: '#059669', next: null },\n];\nconst STAGE_LABEL = { lead: '线索', qualified: '需求确认', proposal: '方案评审', negotiation: '商务报价', won: '赢单', lost: '丢单' };\nconst SIZE_LABEL = { startup: '初创', smb: '成长型', midmarket: '中大型', enterprise: '大型集团' };\nconst ACT_LABEL = { call: '电话', meeting: '会议', demo: '演示', quote: '报价', email: '邮件', ai_note: 'AI 策略' };\nconst VIEW_TITLE = { pipeline: '商机漏斗看板', accounts: '客户 360° 档案', activities: '互动时间轴与跟进提醒', advisor: 'AI 销售军师工作台' };\nlet state = { revision: 0, accounts: [], deals: [], activities: [], metrics: null };\nlet selectedAccId = null, editingAccId = null, editingDealId = null;\nlet showLost = false, activeScenario = 'email', canInsert = false, pendingWorkId = null, latestAiText = '', busy = false;\nconst today = () => new Date().toISOString().slice(0, 10);\nconst fmtMoney = n => { const v = Number(n) || 0; return Math.abs(v) >= 10000 ? `¥${(v / 10000).toFixed(v % 10000 === 0 ? 0 : 1)}万` : `¥${Math.round(v).toLocaleString('zh-CN')}`; };\nconst fmtFull = n => `¥${Math.round(Number(n) || 0).toLocaleString('zh-CN')}`;\nconst esc = s => String(s ?? '').replace(/[&<>\"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]));\nconst setStatus = (msg, err = false) => { $('status-text').textContent = msg; $('status-pill').dataset.error = String(err); };\nconst runBusy = async fn => { if (busy) return; busy = true; try { await fn(); } catch (e) { setStatus(`操作失败：${e?.message || '未知错误'}`, true); } finally { busy = false; } };\nconst uuid = () => { const b = crypto.getRandomValues(new Uint8Array(16)); b[6] = (b[6] & 15) | 64; b[8] = (b[8] & 63) | 128; const h = Array.from(b, x => x.toString(16).padStart(2, '0')).join(''); return `${h.slice(0,8)}-${h.slice(8,12)}-${h.slice(12,16)}-${h.slice(16,20)}-${h.slice(20)}`; };\nconst daysDiff = ds => ds ? Math.round((new Date(ds + 'T00:00:00Z') - new Date(today() + 'T00:00:00Z')) / 86400000) : null;\nfunction switchView(view) {\n$('view-heading').textContent = VIEW_TITLE[view] || view;\ndocument.querySelectorAll('.nav-btn').forEach(b => b.classList.toggle('active', b.dataset.view === view));\ndocument.querySelectorAll('.view').forEach(el => { el.hidden = el.id !== `view-${view}`; });\nif (view === 'advisor') renderAdvisorContext();\n}\nasync function loadSnapshot() {\nif (typeof plugin?.action !== 'function') { setStatus('请在 Velai Desktop 中打开此插件', true); return; }\ntry {\nconst caps = await plugin.action('host.capabilities', {}).catch(() => ({ actions: [] }));\ncanInsert = Array.isArray(caps?.actions) && caps.actions.includes('host.draft.insert');\nstate = await plugin.action('crm.snapshot', {});\nif (!selectedAccId || !state.accounts.some(a => a.id === selectedAccId)) selectedAccId = state.accounts[0]?.id ?? null;\nrenderAll();\nconst cur = state.settings?.default_currency || 'CNY';\nconst days = state.settings?.follow_up_days ?? 3;\nsetStatus(`已同步 · ${state.accounts.length} 客户 · ${state.deals.length} 商机 · ${cur} (${days}日预警) · Rev #${state.revision}`);\n} catch (e) { setStatus(`加载失败：${e?.message || '未知错误'}`, true); }\n}\nfunction renderAll() {\nrenderKpis(); renderFunnelSvg(); renderForecastSvg(); renderKanban();\nrenderAccounts(); renderActFormOpts(); renderTimeline(); renderAdvisorOpts(); renderAdvisorContext();\n}\nfunction renderKpis() {\nconst m = state.metrics || { active_pipeline: 0, weighted_forecast: 0, won_amount: 0, lost_amount: 0, active_deal_count: 0, win_rate: 0, avg_health: 0, overdue_count: 0, due_soon_count: 0 };\n$('kpi-pipeline').textContent = fmtMoney(m.active_pipeline);\n$('kpi-active-cnt').textContent = `${m.active_deal_count} 笔`;\n$('kpi-weighted').textContent = fmtMoney(m.weighted_forecast);\n$('kpi-avg-prob').textContent = `综合赢率 ${m.active_pipeline > 0 ? Math.round((m.weighted_forecast / m.active_pipeline) * 100) : 0}%`;\n$('kpi-won').textContent = fmtMoney(m.won_amount);\n$('kpi-winrate').textContent = `赢率 ${m.win_rate}%`;\n$('kpi-lost-sub').textContent = `丢单归档 ${fmtMoney(m.lost_amount)}`;\n$('kpi-health').textContent = `${m.avg_health} 分`;\n$('kpi-overdue').textContent = `${m.overdue_count} 逾期`;\n$('kpi-soon-sub').textContent = `3 日内即将到期 ${m.due_soon_count} 项`;\n$('badge-deals').textContent = String(state.deals.length);\n$('badge-accounts').textContent = String(state.accounts.length);\n$('badge-alerts').textContent = String(m.overdue_count + m.due_soon_count);\n$('badge-alerts').classList.toggle('alert', m.overdue_count > 0);\n}\nfunction renderFunnelSvg() {\nconst funnel = state.metrics?.funnel || [];\nconst stages = STAGE_META.map(meta => ({ ...meta, ...(funnel.find(x => x.stage === meta.id) || { count: 0, amount: 0, weighted: 0 }) }));\nconst maxAmt = Math.max(...stages.map(s => s.amount), 1);\nconst W = 460, rowH = 38, padY = 12, H = padY * 2 + stages.length * rowH, cx = 195, maxW = 240, minW = 74;\nlet body = `<defs>${stages.map((s, i) => `<linearGradient id=\"fg${i}\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\"><stop offset=\"0%\" stop-color=\"${s.color}\" stop-opacity=\".95\"/><stop offset=\"100%\" stop-color=\"${s.color}\" stop-opacity=\".72\"/></linearGradient>`).join('')}</defs>`;\nstages.forEach((s, i) => {\nconst y = padY + i * rowH, ratio = s.amount > 0 ? Math.max(0.25, s.amount / maxAmt) : 0.18;\nconst topW = minW + (maxW - minW) * (1 - i * 0.15) * (0.45 + 0.55 * ratio), botW = Math.max(minW * 0.85, topW - 18);\nconst prev = i > 0 ? stages[i - 1].amount : s.amount;\nconst conv = i === 0 ? '100%' : (prev > 0 ? `${Math.min(999, Math.round((s.amount / prev) * 100))}%` : '—');\nbody += `<text x=\"8\" y=\"${y+21}\" fill=\"var(--fg-2)\" font-size=\"12\" font-weight=\"600\">${esc(s.label)}</text>`\n+ `<polygon points=\"${(cx-topW/2).toFixed(1)},${y+3} ${(cx+topW/2).toFixed(1)},${y+3} ${(cx+botW/2).toFixed(1)},${y+rowH-5} ${(cx-botW/2).toFixed(1)},${y+rowH-5}\" fill=\"url(#fg${i})\"/>`\n+ `<text x=\"${cx}\" y=\"${y+21}\" text-anchor=\"middle\" fill=\"#fff\" font-size=\"11.5\" font-weight=\"700\">${s.count} 笔 · ${esc(fmtMoney(s.amount))}</text>`\n+ `<text x=\"348\" y=\"${y+21}\" fill=\"var(--muted)\" font-size=\"11.5\" font-weight=\"600\">加权 ${esc(fmtMoney(s.weighted))}</text>`\n+ `<text x=\"454\" y=\"${y+21}\" text-anchor=\"end\" fill=\"${s.color}\" font-size=\"11\" font-weight=\"700\">${conv}</text>`;\n});\n$('svg-funnel').innerHTML = `<svg viewBox=\"0 0 ${W} ${H}\" role=\"img\" aria-label=\"销售转化漏斗图\">${body}</svg>`;\n}\nfunction renderForecastSvg() {\nconst funnel = state.metrics?.funnel || [];\nconst stages = STAGE_META.map(meta => ({ ...meta, ...(funnel.find(x => x.stage === meta.id) || { count: 0, amount: 0, weighted: 0 }) }));\nconst maxVal = Math.max(...stages.map(s => Math.max(s.amount, s.weighted)), 100000);\nconst W = 430, H = 214, padL = 52, padR = 14, padT = 18, padB = 34, cW = W - padL - padR, cH = H - padT - padB, step = cW / stages.length;\nlet svg = '';\nfor (let t = 0; t <= 4; t++) {\nconst y = padT + cH - (cH * t) / 4;\nsvg += `<line x1=\"${padL}\" y1=\"${y}\" x2=\"${W-padR}\" y2=\"${y}\" stroke=\"var(--border)\" stroke-dasharray=\"${t ? '3 3' : ''}\"/>`\n+ `<text x=\"${padL-6}\" y=\"${y+4}\" text-anchor=\"end\" fill=\"var(--muted)\" font-size=\"10.5\">${esc(fmtMoney((maxVal * t) / 4))}</text>`;\n}\nstages.forEach((s, i) => {\nconst bx = padL + i * step + step * 0.18, bw = Math.max(12, step * 0.27);\nconst hr = (s.amount / maxVal) * cH, hw = (s.weighted / maxVal) * cH;\nsvg += `<rect x=\"${bx.toFixed(1)}\" y=\"${(padT+cH-hr).toFixed(1)}\" width=\"${bw.toFixed(1)}\" height=\"${Math.max(2,hr).toFixed(1)}\" rx=\"4\" fill=\"var(--accent)\" opacity=\".88\"><title>${esc(s.label)} 原始：${esc(fmtFull(s.amount))}</title></rect>`\n+ `<rect x=\"${(bx+bw+4).toFixed(1)}\" y=\"${(padT+cH-hw).toFixed(1)}\" width=\"${bw.toFixed(1)}\" height=\"${Math.max(2,hw).toFixed(1)}\" rx=\"4\" fill=\"var(--ok)\" opacity=\".92\"><title>${esc(s.label)} 加权：${esc(fmtFull(s.weighted))}</title></rect>`\n+ `<text x=\"${(bx+bw+2).toFixed(1)}\" y=\"${H-12}\" text-anchor=\"middle\" fill=\"var(--fg-2)\" font-size=\"11.5\" font-weight=\"600\">${esc(s.label)}</text>`;\n});\n$('svg-forecast').innerHTML = `<svg viewBox=\"0 0 ${W} ${H}\" role=\"img\" aria-label=\"阶段金额与加权营收对比图\">${svg}</svg>`;\n}\nfunction mkBtn(text, cls, fn) { const b = document.createElement('button'); b.type = 'button'; b.className = cls; b.textContent = text; b.addEventListener('click', fn); return b; }\nfunction renderKanban() {\nconst kw = $('deal-search').value.trim().toLowerCase();\nconst accMap = new Map(state.accounts.map(a => [a.id, a]));\nconst hit = d => !kw || `${d.title} ${accMap.get(d.account_id)?.name || ''} ${d.owner}`.toLowerCase().includes(kw);\nconst board = $('kanban-board'); board.replaceChildren();\nfor (const meta of STAGE_META) {\nconst deals = state.deals.filter(d => d.stage === meta.id && hit(d));\nconst sum = deals.reduce((s, d) => s + (Number(d.amount) || 0), 0);\nconst lane = document.createElement('div'); lane.className = 'lane';\nlane.innerHTML = `<div class=\"lane-head\" data-stage=\"${meta.id}\"><span class=\"lane-title\">${esc(meta.label)} <span class=\"tag num\">${deals.length}</span></span><span class=\"lane-sum num\">${esc(fmtMoney(sum))}</span></div>`;\nif (!deals.length) lane.insertAdjacentHTML('beforeend', `<div style=\"font-size:12px;color:var(--muted);padding:18px 6px;text-align:center\">暂无该阶段商机</div>`);\nfor (const d of deals) {\nconst card = document.createElement('article'); card.className = 'deal-card';\ncard.innerHTML = `<div class=\"deal-acc\"><span>${esc(accMap.get(d.account_id)?.name || d.account_id)}</span><span class=\"num\">${d.probability}%</span></div>`\n+ `<div class=\"deal-title\">${esc(d.title)}</div>`\n+ `<div class=\"deal-amt num\"><span>${esc(fmtFull(d.amount))}</span><span style=\"font-size:11px;font-weight:500;color:var(--muted)\">加权 ${esc(fmtMoney((d.amount * d.probability) / 100))}</span></div>`\n+ `<div class=\"prob-bar\"><div class=\"prob-fill\" style=\"width:${d.probability}%\"></div></div>`\n+ `<div class=\"deal-meta\"><span>预计成交 ${esc(d.close_date)}</span><span>${esc(d.owner || '未指派')}</span></div>`\n+ (d.next_step ? `<div class=\"deal-step\">下一步：${esc(d.next_step)}</div>` : '');\nconst acts = document.createElement('div'); acts.className = 'deal-actions';\nif (meta.next) acts.appendChild(mkBtn(`推进 → ${STAGE_LABEL[meta.next]}`, 'primary sm', () => advanceStage(d, meta.next)));\nacts.append(mkBtn('AI 军师', 'ghost sm', () => openAdvisorFor(d.account_id, d.id)), mkBtn('编辑', 'ghost sm', () => openDealModal(d)));\nif (meta.id !== 'won') acts.appendChild(mkBtn('丢单', 'ghost sm', () => advanceStage(d, 'lost')));\ncard.appendChild(acts); lane.appendChild(card);\n}\nboard.appendChild(lane);\n}\nconst lost = state.deals.filter(d => d.stage === 'lost' && hit(d));\n$('lost-count').textContent = String(lost.length);\n$('lost-archive').hidden = !showLost;\nconst lostBox = $('lost-list'); lostBox.replaceChildren();\nfor (const d of lost) {\nconst c = document.createElement('div'); c.className = 'deal-card';\nc.innerHTML = `<div class=\"deal-acc\"><span>${esc(accMap.get(d.account_id)?.name || d.account_id)}</span><span class=\"tag danger\">丢单</span></div><div class=\"deal-title\">${esc(d.title)}</div><div class=\"deal-meta\"><span class=\"num\">${esc(fmtFull(d.amount))}</span><span>${esc(d.close_date)}</span></div><div class=\"deal-step\">${esc(d.loss_reason || '未填写丢单原因')}</div>`;\nconst row = document.createElement('div'); row.className = 'deal-actions';\nrow.append(mkBtn('AI 复盘', 'ghost sm', () => { activeScenario = 'review'; openAdvisorFor(d.account_id, d.id); }), mkBtn('编辑/重启', 'ghost sm', () => openDealModal(d)));\nc.appendChild(row); lostBox.appendChild(c);\n}\n}\nconst advanceStage = (deal, nextStage) => runBusy(async () => {\nconst res = await plugin.action('crm.deal.stage', { expected_revision: state.revision, id: deal.id, stage: nextStage });\nif (res.status === 'saved') { await loadSnapshot(); setStatus(`「${deal.title}」已推进至「${STAGE_LABEL[nextStage]}」（赢率 ${res.probability}%）`); }\nelse setStatus(`推进未完成：${res.status}`, true);\n});\nfunction renderAccounts() {\nconst kw = $('acc-search').value.trim().toLowerCase();\nconst filtered = state.accounts.filter(a => !kw || `${a.name} ${a.industry} ${a.contact_name} ${a.tags.join(' ')}`.toLowerCase().includes(kw));\nconst list = $('acc-list'); list.replaceChildren();\nif (!filtered.length) list.innerHTML = `<div style=\"padding:20px;text-align:center;color:var(--muted);font-size:12.5px\">暂无匹配客户</div>`;\nfor (const a of filtered) {\nconst btn = document.createElement('button'); btn.type = 'button'; btn.className = `acc-item${a.id === selectedAccId ? ' active' : ''}`;\nconst cls = a.health >= 80 ? 'ok' : a.health >= 65 ? 'warn' : 'danger';\nbtn.innerHTML = `<div style=\"min-width:0\"><div style=\"font-weight:700;font-size:13.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis\">${esc(a.name)}</div><div style=\"font-size:11.5px;color:var(--muted)\">${esc(a.industry)} · ${esc(a.contact_name)} ${esc(a.contact_role)}</div></div><span class=\"tag ${cls} num\">${a.health}</span>`;\nbtn.addEventListener('click', () => { selectedAccId = a.id; renderAccounts(); });\nlist.appendChild(btn);\n}\nconst acc = state.accounts.find(a => a.id === selectedAccId);\n$('acc-empty').hidden = Boolean(acc); $('acc-detail').hidden = !acc;\nif (!acc) return;\nconst r = 30, circ = 2 * Math.PI * r, dash = (acc.health / 100) * circ;\nconst col = acc.health >= 80 ? 'var(--ok)' : acc.health >= 65 ? 'var(--warn)' : 'var(--danger)';\n$('acc-health-svg').innerHTML = `<svg viewBox=\"0 0 74 74\" width=\"74\" height=\"74\"><circle cx=\"37\" cy=\"37\" r=\"${r}\" fill=\"none\" stroke=\"var(--border)\" stroke-width=\"6.5\"/><circle cx=\"37\" cy=\"37\" r=\"${r}\" fill=\"none\" stroke=\"${col}\" stroke-width=\"6.5\" stroke-linecap=\"round\" stroke-dasharray=\"${dash.toFixed(1)} ${circ.toFixed(1)}\" transform=\"rotate(-90 37 37)\"/><text x=\"37\" y=\"36\" text-anchor=\"middle\" fill=\"var(--fg)\" font-size=\"16\" font-weight=\"800\">${acc.health}</text><text x=\"37\" y=\"50\" text-anchor=\"middle\" fill=\"var(--muted)\" font-size=\"9.5\">健康度</text></svg>`;\n$('acc-name').textContent = acc.name; $('acc-industry').textContent = acc.industry; $('acc-size').textContent = SIZE_LABEL[acc.size] || acc.size;\n$('acc-contact').textContent = `关键联系人：${acc.contact_name}${acc.contact_role ? `（${acc.contact_role}）` : ''} · 更新于 ${acc.updated_at}`;\n$('acc-tags').innerHTML = acc.tags.map(t => `<span class=\"tag\">#${esc(t)}</span>`).join('');\n$('acc-potential').textContent = fmtFull(acc.annual_potential);\n$('acc-risk').textContent = acc.risk_note || '暂无特别风险备注。';\nconst accDeals = state.deals.filter(d => d.account_id === acc.id);\nconst accActs = state.activities.filter(x => x.account_id === acc.id).sort((a, b) => b.date.localeCompare(a.date));\n$('acc-deals-sum').textContent = fmtFull(accDeals.reduce((s, d) => s + (Number(d.amount) || 0), 0));\n$('acc-counts').textContent = `${accDeals.length} 商机 / ${accActs.length} 互动`;\nconst dBox = $('acc-deals-list'); dBox.replaceChildren();\nif (!accDeals.length) dBox.innerHTML = `<div style=\"font-size:12.5px;color:var(--muted)\">暂无关联商机</div>`;\nfor (const d of accDeals) {\nconst tagCls = d.stage === 'won' ? 'ok' : d.stage === 'lost' ? 'danger' : 'accent';\ndBox.insertAdjacentHTML('beforeend', `<div class=\"info-box\" style=\"display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap\"><div><div style=\"font-weight:700\">${esc(d.title)}</div><div style=\"font-size:12px;color:var(--muted)\">预计成交 ${esc(d.close_date)} · ${esc(d.owner || '—')} · ${esc(d.next_step || '无下一步备注')}</div></div><div class=\"row\"><span class=\"tag ${tagCls}\">${esc(STAGE_LABEL[d.stage])} · ${d.probability}%</span><strong class=\"num\">${esc(fmtFull(d.amount))}</strong></div></div>`);\n}\nconst aBox = $('acc-acts-list'); aBox.replaceChildren();\nif (!accActs.length) aBox.innerHTML = `<div style=\"font-size:12.5px;color:var(--muted)\">暂无互动记录</div>`;\nfor (const act of accActs) aBox.appendChild(buildActRow(act, acc.name, false));\n}\nfunction buildActRow(act, accName, showAcc = true) {\nconst diff = act.done ? null : daysDiff(act.next_due);\nconst cls = act.done ? 'done' : (diff !== null && diff < 0 ? 'overdue' : (diff !== null && diff <= 3 ? 'soon' : ''));\nconst row = document.createElement('div'); row.className = `act-row ${cls}`;\nconst dueBadge = act.done ? `<span class=\"tag ok\">已完成</span>`\n: diff !== null && diff < 0 ? `<span class=\"tag danger\">已逾期 ${Math.abs(diff)} 天 (${esc(act.next_due)})</span>`\n: diff !== null && diff <= 3 ? `<span class=\"tag warn\">${diff === 0 ? '今日到期' : `${diff} 天后到期`} (${esc(act.next_due)})</span>`\n: act.next_due ? `<span class=\"tag\">下次跟进 ${esc(act.next_due)}</span>` : '';\nconst deal = state.deals.find(d => d.id === act.deal_id);\nrow.innerHTML = `<div class=\"row\" style=\"justify-content:space-between\"><div class=\"row\"><span class=\"tag accent\">${esc(ACT_LABEL[act.type] || act.type)}</span>${showAcc ? `<strong style=\"font-size:13px\">${esc(accName)}</strong>` : ''}${deal ? `<span style=\"font-size:12px;color:var(--muted)\">/ ${esc(deal.title)}</span>` : ''}<span style=\"font-size:12px;color:var(--muted)\" class=\"num\">${esc(act.date)}</span></div><div class=\"row\">${dueBadge}</div></div><div style=\"font-size:13px;line-height:1.5\">${esc(act.summary)}</div>${act.next_action ? `<div style=\"font-size:12px;color:var(--fg-2)\"><strong>下一步行动：</strong>${esc(act.next_action)}</div>` : ''}`;\nconst ctrl = document.createElement('div'); ctrl.className = 'row';\nctrl.append(\nmkBtn(act.done ? '重新打开' : '标记完成', act.done ? 'ghost sm' : 'ok sm', () => runBusy(async () => {\nconst res = await plugin.action('crm.activity.save', { expected_revision: state.revision, ...act, done: !act.done });\nif (res.status === 'saved') { await loadSnapshot(); setStatus(act.done ? '已重新打开跟进项' : '已标记跟进完成'); } else setStatus(`更新失败：${res.status}`, true);\n})),\nmkBtn('删除', 'ghost sm', () => runBusy(async () => {\nconst res = await plugin.action('crm.activity.delete', { expected_revision: state.revision, id: act.id });\nif (res.status === 'deleted') { await loadSnapshot(); setStatus('已删除互动记录'); } else setStatus(`删除失败：${res.status}`, true);\n}))\n);\nrow.appendChild(ctrl); return row;\n}\nfunction renderActFormOpts() {\nconst sel = $('act-f-acc'), prev = sel.value;\nsel.innerHTML = state.accounts.length ? state.accounts.map(a => `<option value=\"${esc(a.id)}\">${esc(a.name)}</option>`).join('') : `<option value=\"\">请先创建客户</option>`;\nif (prev && state.accounts.some(a => a.id === prev)) sel.value = prev;\nsyncActDeals(); if (!$('act-f-date').value) $('act-f-date').value = today();\n}\nfunction syncActDeals() {\nconst deals = state.deals.filter(d => d.account_id === $('act-f-acc').value);\n$('act-f-deal').innerHTML = `<option value=\"\">不关联特定商机</option>` + deals.map(d => `<option value=\"${esc(d.id)}\">${esc(d.title)} (${esc(STAGE_LABEL[d.stage])})</option>`).join('');\n}\nfunction renderTimeline() {\nconst sf = $('act-filter-status').value, tf = $('act-filter-type').value;\nconst accMap = new Map(state.accounts.map(a => [a.id, a.name]));\nconst list = [...state.activities].filter(a => {\nif (tf && a.type !== tf) return false;\nconst diff = a.done ? null : daysDiff(a.next_due);\nif (sf === 'done') return a.done;\nif (sf === 'open') return !a.done;\nif (sf === 'urgent') return !a.done && diff !== null && diff <= 3;\nreturn true;\n}).sort((a, b) => (a.done !== b.done ? (a.done ? 1 : -1) : (a.next_due || '9999-12-31').localeCompare(b.next_due || '9999-12-31') || b.date.localeCompare(a.date)));\nconst box = $('act-timeline'); box.replaceChildren();\nif (!list.length) { box.innerHTML = `<div style=\"padding:24px;text-align:center;color:var(--muted)\">当前筛选条件下暂无互动记录。</div>`; return; }\nfor (const act of list) box.appendChild(buildActRow(act, accMap.get(act.account_id) || act.account_id, true));\n}\nfunction renderAdvisorOpts() {\nconst sel = $('ai-acc'), prev = sel.value;\nsel.innerHTML = state.accounts.length ? state.accounts.map(a => `<option value=\"${esc(a.id)}\">${esc(a.name)} (${esc(a.industry)})</option>`).join('') : `<option value=\"\">请先创建或加载客户数据</option>`;\nif (prev && state.accounts.some(a => a.id === prev)) sel.value = prev;\nsyncAdvisorDeals();\n}\nfunction syncAdvisorDeals() {\nconst deals = state.deals.filter(d => d.account_id === $('ai-acc').value);\n$('ai-deal').innerHTML = `<option value=\"\">综合分析该客户全部商机</option>` + deals.map(d => `<option value=\"${esc(d.id)}\">${esc(d.title)} · ${esc(STAGE_LABEL[d.stage])} · ${esc(fmtMoney(d.amount))}</option>`).join('');\n}\nfunction openAdvisorFor(accId, dealId = '') {\nswitchView('advisor');\nif (accId) $('ai-acc').value = accId;\nsyncAdvisorDeals();\nif (dealId) $('ai-deal').value = dealId;\ndocument.querySelectorAll('.scenario-card').forEach(c => c.classList.toggle('active', c.dataset.sc === activeScenario));\nrenderAdvisorContext();\n}\nfunction buildAdvisorCtx() {\nconst acc = state.accounts.find(a => a.id === $('ai-acc').value);\nif (!acc) return null;\nconst deal = state.deals.find(d => d.id === $('ai-deal').value);\nconst recent = state.activities.filter(x => x.account_id === acc.id).sort((a, b) => b.date.localeCompare(a.date)).slice(0, 4);\nconst lines = [\n`客户：${acc.name}（行业：${acc.industry}，规模：${SIZE_LABEL[acc.size]}，健康度：${acc.health}/100）`,\n`关键联系人：${acc.contact_name} ${acc.contact_role}；年潜在价值：${fmtFull(acc.annual_potential)}`,\n`风险/策略备注：${acc.risk_note || '无'}`,\n];\nif (deal) {\nlines.push(`聚焦商机：${deal.title}｜阶段：${STAGE_LABEL[deal.stage]}（赢率 ${deal.probability}%）｜金额：${fmtFull(deal.amount)}｜预计成交：${deal.close_date}`);\nif (deal.next_step) lines.push(`当前下一步：${deal.next_step}`);\nif (deal.loss_reason) lines.push(`丢单/复盘备注：${deal.loss_reason}`);\n} else {\nconst ad = state.deals.filter(d => d.account_id === acc.id);\nif (ad.length) lines.push(`关联商机：${ad.map(d => `${d.title}(${STAGE_LABEL[d.stage]}/${fmtMoney(d.amount)})`).join('；')}`);\n}\nif (recent.length) {\nlines.push('近期互动记录：');\nrecent.forEach(r => lines.push(`- [${r.date} ${ACT_LABEL[r.type]}] ${r.summary}${r.next_action ? `（下一步：${r.next_action}）` : ''}`));\n}\nreturn { acc, deal, text: lines.join('\\n') };\n}\nfunction renderAdvisorContext() {\nconst ctx = buildAdvisorCtx();\n$('ai-context-preview').textContent = ctx ? ctx.text : '请先在左侧加载演示数据或创建客户档案。';\n$('btn-ai-insert').hidden = !canInsert;\n}\nfunction openAccModal(acc = null) {\neditingAccId = acc?.id || null;\n$('m-acc-title').textContent = acc ? `编辑客户：${acc.name}` : '新建企业客户';\n$('m-acc-name').value = acc?.name ?? ''; $('m-acc-ind').value = acc?.industry ?? '';\n$('m-acc-size').value = acc?.size ?? 'midmarket'; $('m-acc-health').value = acc?.health ?? 80;\n$('m-acc-contact').value = acc?.contact_name ?? ''; $('m-acc-role').value = acc?.contact_role ?? '';\n$('m-acc-pot').value = acc?.annual_potential ?? 500000; $('m-acc-tags').value = acc ? acc.tags.join(', ') : '';\n$('m-acc-risk').value = acc?.risk_note ?? ''; $('modal-acc').hidden = false;\n}\nfunction openDealModal(deal = null, defaultAccId = null) {\nif (!state.accounts.length) { setStatus('请先创建至少一家企业客户再新建商机', true); return; }\neditingDealId = deal?.id || null;\n$('m-deal-title').textContent = deal ? '编辑商机' : '新建商机';\n$('m-deal-acc').innerHTML = state.accounts.map(a => `<option value=\"${esc(a.id)}\">${esc(a.name)}</option>`).join('');\n$('m-deal-name').value = deal?.title ?? ''; $('m-deal-acc').value = deal?.account_id ?? defaultAccId ?? state.accounts[0].id;\n$('m-deal-stage').value = deal?.stage ?? 'qualified'; $('m-deal-amt').value = deal?.amount ?? 300000;\n$('m-deal-prob').value = deal?.probability ?? 35; $('m-deal-date').value = deal?.close_date ?? today();\n$('m-deal-owner').value = deal?.owner ?? '张锐'; $('m-deal-step').value = deal?.next_step ?? '';\n$('m-deal-loss').value = deal?.loss_reason ?? ''; $('btn-m-deal-del').hidden = !deal; $('modal-deal').hidden = false;\n}\ndocument.querySelectorAll('.nav-btn').forEach(b => b.addEventListener('click', () => switchView(b.dataset.view)));\ndocument.querySelectorAll('[data-close]').forEach(b => b.addEventListener('click', () => { $(b.dataset.close).hidden = true; }));\non('btn-refresh', 'click', () => void loadSnapshot());\nconst mqDark = matchMedia('(prefers-color-scheme: dark)');\nlet userTheme = Boolean(document.documentElement.getAttribute('data-theme'));\nif (!userTheme) document.documentElement.dataset.theme = mqDark.matches ? 'dark' : 'light';\nmqDark.addEventListener?.('change', e => { if (!userTheme) document.documentElement.dataset.theme = e.matches ? 'dark' : 'light'; });\non('btn-theme', 'click', () => { userTheme = true; document.documentElement.dataset.theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'; });\non('btn-seed', 'click', () => runBusy(async () => {\nconst res = await plugin.action('crm.demo.seed', { expected_revision: state.revision });\nif (res.status === 'seeded') { await loadSnapshot(); setStatus(`已加载 B2B SaaS 演示数据集（${res.counts.accounts} 客户 / ${res.counts.deals} 商机 / ${res.counts.activities} 互动）`); }\nelse setStatus(`加载演示数据冲突：${res.status}`, true);\n}));\non('deal-search', 'input', renderKanban); on('acc-search', 'input', renderAccounts);\non('btn-toggle-lost', 'click', () => { showLost = !showLost; $('btn-toggle-lost').textContent = showLost ? '隐藏丢单归档' : '显示丢单归档'; renderKanban(); });\non('btn-new-deal', 'click', () => openDealModal(null)); on('btn-new-acc', 'click', () => openAccModal(null));\non('btn-acc-edit', 'click', () => { const a = state.accounts.find(x => x.id === selectedAccId); if (a) openAccModal(a); });\non('btn-acc-ai', 'click', () => openAdvisorFor(selectedAccId));\non('btn-acc-add-deal', 'click', () => openDealModal(null, selectedAccId));\non('btn-acc-add-act', 'click', () => { switchView('activities'); if (selectedAccId) { $('act-f-acc').value = selectedAccId; syncActDeals(); } $('act-f-summary').focus(); });\non('btn-acc-del', 'click', () => { if (!selectedAccId) return; void runBusy(async () => {\nconst res = await plugin.action('crm.account.delete', { expected_revision: state.revision, id: selectedAccId });\nif (res.status === 'deleted') { selectedAccId = null; await loadSnapshot(); setStatus('已删除客户及其关联记录'); } else setStatus(`删除失败：${res.status}`, true);\n}); });\non('btn-m-acc-save', 'click', () => runBusy(async () => {\nconst name = $('m-acc-name').value.trim(), industry = $('m-acc-ind').value.trim(), contact = $('m-acc-contact').value.trim();\nif (!name || !industry || !contact) { setStatus('请填写企业名称、行业和关键联系人', true); return; }\nconst id = editingAccId || `acc-${Date.now().toString(36)}`;\nconst res = await plugin.action('crm.account.save', {\nexpected_revision: state.revision, id, name, industry, size: $('m-acc-size').value,\nhealth: Math.max(0, Math.min(100, Math.round(Number($('m-acc-health').value) || 0))),\ncontact_name: contact, contact_role: $('m-acc-role').value.trim(),\nannual_potential: Math.max(0, Number($('m-acc-pot').value) || 0),\ntags: $('m-acc-tags').value.split(/[,，]/).map(s => s.trim()).filter(Boolean).slice(0, 5),\nrisk_note: $('m-acc-risk').value.trim(),\n});\nif (res.status === 'saved') { selectedAccId = id; $('modal-acc').hidden = true; await loadSnapshot(); setStatus('企业客户档案已保存'); }\nelse setStatus(`保存未完成：${res.status}`, true);\n}));\non('m-deal-stage', 'change', () => { $('m-deal-prob').value = ({ lead: 15, qualified: 35, proposal: 60, negotiation: 80, won: 100, lost: 0 })[$('m-deal-stage').value] ?? 35; });\non('btn-m-deal-save', 'click', () => runBusy(async () => {\nconst title = $('m-deal-name').value.trim(); if (!title) { setStatus('请填写商机名称', true); return; }\nconst res = await plugin.action('crm.deal.save', {\nexpected_revision: state.revision, id: editingDealId || `deal-${Date.now().toString(36)}`,\naccount_id: $('m-deal-acc').value, title, stage: $('m-deal-stage').value,\namount: Math.max(0, Number($('m-deal-amt').value) || 0),\nprobability: Math.max(0, Math.min(100, Math.round(Number($('m-deal-prob').value) || 0))),\nclose_date: $('m-deal-date').value || today(), owner: $('m-deal-owner').value.trim(),\nnext_step: $('m-deal-step').value.trim(), loss_reason: $('m-deal-loss').value.trim(),\n});\nif (res.status === 'saved') { $('modal-deal').hidden = true; await loadSnapshot(); setStatus('商机已保存'); } else setStatus(`保存未完成：${res.status}`, true);\n}));\non('btn-m-deal-del', 'click', () => { if (!editingDealId) return; void runBusy(async () => {\nconst res = await plugin.action('crm.deal.delete', { expected_revision: state.revision, id: editingDealId });\nif (res.status === 'deleted') { $('modal-deal').hidden = true; await loadSnapshot(); setStatus('已删除商机'); } else setStatus(`删除失败：${res.status}`, true);\n}); });\non('act-f-acc', 'change', syncActDeals); on('act-filter-status', 'change', renderTimeline); on('act-filter-type', 'change', renderTimeline);\non('btn-act-submit', 'click', () => runBusy(async () => {\nconst accId = $('act-f-acc').value, summary = $('act-f-summary').value.trim();\nif (!accId || !summary) { setStatus('请选择客户并填写互动摘要', true); return; }\nconst res = await plugin.action('crm.activity.save', {\nexpected_revision: state.revision, id: `act-${Date.now().toString(36)}`, account_id: accId,\ndeal_id: $('act-f-deal').value || '', type: $('act-f-type').value, date: $('act-f-date').value || today(),\nsummary, next_action: $('act-f-next').value.trim(), next_due: $('act-f-due').value || '', done: false,\n});\nif (res.status === 'saved') { $('act-f-summary').value = ''; $('act-f-next').value = ''; await loadSnapshot(); setStatus('互动跟进已记录'); }\nelse setStatus(`记录未完成：${res.status}`, true);\n}));\non('ai-acc', 'change', () => { syncAdvisorDeals(); renderAdvisorContext(); });\non('ai-deal', 'change', renderAdvisorContext);\ndocument.querySelectorAll('.scenario-card').forEach(btn => btn.addEventListener('click', () => {\nactiveScenario = btn.dataset.sc;\ndocument.querySelectorAll('.scenario-card').forEach(c => c.classList.toggle('active', c === btn));\n}));\nfunction buildAdvisorPrompt(ctx) {\nconst scText = {\nemail: '请作为顶级 B2B 软件销售顾问，起草一封高转化跟进邮件，含吸引高管打开的主题行、切中痛点的正文与明确 CTA。',\nobjection: '请针对价格、竞品、法务合规或审批异议，生成 LAER 异议应对脚本与建议附带的证明材料。',\nstrategy: '请基于 MEDDPICC 诊断商机缺口，输出未来 14 天 3 个必做赢单推进动作与高层对齐话术。',\nreview: '请深度复盘上述客户/商机的赢单要素或丢单根因，提炼 3 条可复制的同行业打法。',\n}[activeScenario];\nconst extra = $('ai-extra').value.trim();\nreturn `${scText}\\n${extra ? `补充要求：${extra}\\n` : ''}\\n--- CRM 客户与商机上下文 ---\\n${ctx.text}`;\n}\non('btn-ai-draft', 'click', () => {\nconst ctx = buildAdvisorCtx(); if (!ctx) { setStatus('请先选择企业客户', true); return; }\nconst titleMap = { email: '高转化跟进邮件模板', objection: 'LAER 异议应对脚本', strategy: 'MEDDPICC 14 天赢单推进策略', review: '客户商机复盘报告' };\nconst extra = $('ai-extra').value.trim();\nlatestAiText = [\n`# ${titleMap[activeScenario] || '销售策略模板'}（本地结构化草稿）`,\nextra ? `> 特别要求：${extra}` : '',\n'',\n'## 客户与商机快照',\nctx.text,\n'',\n'## 建议推进步骤',\n'1. 对齐关键决策人与核心业务指标（ROI / 合规 / 交付周期）。',\n'2. 明确下一次沟通节点、责任人及可量化交付物。',\n'3. 可直接存入客户互动记录，或点击「复制 AI 军师提示词」/「一键插入会话输入框」在 Velai 工作台聊天或独立 AI 伴生插件中深化话术。',\n].filter(Boolean).join('\\n');\n$('ai-output').textContent = latestAiText;\n$('ai-result-box').hidden = false;\n$('btn-ai-insert').hidden = !canInsert;\n$('ai-state').textContent = '已生成本地结构化销售方案，可直接存入互动记录或发送到工作台聊天深化。';\n});\non('btn-ai-prompt', 'click', async () => {\nconst ctx = buildAdvisorCtx(); if (!ctx) { setStatus('请先选择企业客户', true); return; }\ntry { await navigator.clipboard.writeText(buildAdvisorPrompt(ctx)); $('ai-state').textContent = '已复制销售军师提示词，可粘贴至工作台聊天或 AI 伴生插件。'; }\ncatch { $('ai-state').textContent = '剪贴板不可用，请点击「生成本地结构化销售方案」后使用插入按钮。'; }\n});\non('btn-ai-insert', 'click', async () => {\nif (!latestAiText) return;\ntry { const r = await plugin.action('host.draft.insert', { text: latestAiText }); setStatus(r?.inserted ? '已一键插入 Velai 会话输入框' : '未能确认插入', !r?.inserted); }\ncatch (e) { setStatus(`插入失败：${e?.message || ''}`, true); }\n});\non('btn-ai-save-act', 'click', () => { if (!latestAiText || !$('ai-acc').value) return; void runBusy(async () => {\nconst res = await plugin.action('crm.activity.save', {\nexpected_revision: state.revision, id: `act-ai-${Date.now().toString(36)}`, account_id: $('ai-acc').value,\ndeal_id: $('ai-deal').value || '', type: 'ai_note', date: today(), summary: latestAiText.slice(0, 390),\nnext_action: '按 AI 军师建议推进下一步沟通', next_due: today(), done: false,\n});\nif (res.status === 'saved') { await loadSnapshot(); setStatus('已存入客户互动记录'); } else setStatus(`存入失败：${res.status}`, true);\n}); });\non('btn-ai-copy', 'click', async () => { if (!latestAiText) return; try { await navigator.clipboard.writeText(latestAiText); setStatus('已复制 AI 军师方案'); } catch { setStatus('请手动选中复制'); } });\non('btn-io', 'click', async () => {\n$('modal-io').hidden = false; $('io-msg').textContent = '';\ntry { const r = await plugin.action('document.list', {}); $('io-select').innerHTML = (r.items || []).map(it => `<option value=\"${esc(it.id)}\">${esc(it.label)}</option>`).join(''); }\ncatch (e) { $('io-msg').textContent = `获取列表失败：${e?.message || ''}`; }\n});\non('btn-io-export', 'click', async () => {\nconst id = $('io-select').value; if (!id) return;\ntry { const r = await plugin.action('document.export', { id }); if (r.text) { $('io-text').value = r.text; $('io-msg').textContent = `已导出 ${r.filename}（${r.text.length} 字符）`; } else $('io-msg').textContent = `导出失败：${r.error || ''}`; }\ncatch (e) { $('io-msg').textContent = `导出失败：${e?.message || ''}`; }\n});\non('btn-io-import', 'click', async () => {\nconst text = $('io-text').value.trim(); if (!text) { $('io-msg').textContent = '请先粘贴 JSON'; return; }\ntry { const r = await plugin.action('document.import', { text }); if (r.imported) { await loadSnapshot(); $('io-msg').textContent = '导入成功，工作台数据已刷新。'; } else $('io-msg').textContent = `导入失败：${r.reason || ''}`; }\ncatch (e) { $('io-msg').textContent = `导入失败：${e?.message || ''}`; }\n});\non('btn-io-copy', 'click', async () => { try { await navigator.clipboard.writeText($('io-text').value); $('io-msg').textContent = '已复制 JSON'; } catch { $('io-msg').textContent = '请手动全选复制'; } });\nconst actTypeOpts = Object.entries(ACT_LABEL).map(([k, v]) => `<option value=\"${k}\">${v}</option>`).join('');\n$('act-f-type').innerHTML = actTypeOpts;\n$('act-filter-type').innerHTML = `<option value=\"\">全部互动类型</option>${actTypeOpts}`;\nvoid loadSnapshot();\n})();\n\n/* === V2 Host Theme & Compact Surface JS Start === */\n(() => {\n  const root = document.documentElement;\n  const BTN_MODE = \"label\";\n  const HAS_SIDEBAR = true;\n  const MAIN_SEL = \".main\";\n  const INIT_MQ = false;\n  const VALID_THEMES = new Set(['light', 'dark']);\n  const VALID_SURFACES = new Set(['workspace', 'chat', 'assistant']);\n\n  const normalizeTheme = val => (val === 'light' || val === 'dark' ? val : null);\n\n  if (INIT_MQ && !normalizeTheme(root.getAttribute('data-theme'))) {\n    try {\n      const dark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;\n      root.setAttribute('data-theme', dark ? 'dark' : 'light');\n    } catch {}\n  }\n\n  let hostTheme = normalizeTheme(root.getAttribute('data-theme'));\n\n  function syncThemeButton(theme) {\n    const btn = document.getElementById('btn-theme');\n    if (!btn || !VALID_THEMES.has(theme)) return;\n    btn.setAttribute('aria-pressed', String(theme === 'dark'));\n    btn.dataset.activeTheme = theme;\n    btn.title = theme === 'dark' ? '当前深色主题，点击切换浅色' : '当前浅色主题，点击切换深色';\n    if (BTN_MODE === 'short') {\n      btn.textContent = theme === 'light' ? '☾ 深色' : '☀ 浅色';\n    } else if (BTN_MODE === 'emoji') {\n      const txt = (btn.textContent || '').trim();\n      const rest = txt.replace(/^(?:☀️|☀|🌙|☾|◐)\\s*/, '');\n      btn.textContent = (theme === 'light' ? '🌙 ' : '☀️ ') + (rest || '外观');\n    } else {\n      btn.textContent = theme === 'dark' ? '☀ 切换浅色' : '☾ 切换深色';\n    }\n  }\n\n  function applyHostTheme(raw) {\n    const data = raw && typeof raw === 'object'\n      ? (raw.theme || raw.surface || raw.tokens ? raw : (raw.payload && typeof raw.payload === 'object' ? raw.payload : raw))\n      : null;\n    if (!data || typeof data !== 'object') return;\n    const nextTheme = normalizeTheme(data.theme);\n    if (nextTheme) {\n      hostTheme = nextTheme;\n      root.removeAttribute('data-theme-override');\n      root.setAttribute('data-theme', nextTheme);\n      syncThemeButton(nextTheme);\n    }\n    if (typeof data.surface === 'string' && VALID_SURFACES.has(data.surface)) {\n      root.setAttribute('data-surface', data.surface);\n    }\n    if (data.tokens && typeof data.tokens === 'object') {\n      for (const [k, v] of Object.entries(data.tokens)) {\n        if (typeof v === 'string' && k) {\n          try { root.style.setProperty(k.startsWith('--') ? k : '--' + k, v); } catch {}\n        }\n      }\n    }\n  }\n\n  const initialTheme = normalizeTheme(root.getAttribute('data-theme'));\n  if (initialTheme) syncThemeButton(initialTheme);\n\n  const themeBtn = document.getElementById('btn-theme');\n  if (themeBtn) {\n    themeBtn.addEventListener('click', () => {\n      const cur = normalizeTheme(root.getAttribute('data-theme'));\n      if (!cur) return;\n      if (hostTheme && cur !== hostTheme) root.setAttribute('data-theme-override', '1');\n      else root.removeAttribute('data-theme-override');\n      syncThemeButton(cur);\n    });\n  }\n\n  try {\n    window.addEventListener('host.theme.changed', ev => {\n      try { applyHostTheme(ev && typeof ev === 'object' && 'detail' in ev ? ev.detail : ev); } catch {}\n    });\n  } catch {}\n  try {\n    const sub = globalThis.nmasPlugin?.subscribe?.('host.theme.changed', payload => {\n      try { applyHostTheme(payload); } catch {}\n    });\n    if (sub && typeof sub.catch === 'function') sub.catch(() => {});\n  } catch {}\n\n  if (HAS_SIDEBAR) {\n    const sidebar = document.querySelector('.sidebar');\n    const hostMain = document.querySelector(MAIN_SEL) || document.querySelector('.main, .main-area, .main-col, .workspace');\n    const srcBtns = sidebar ? Array.from(sidebar.querySelectorAll('button[data-view]')) : [];\n    if (sidebar && hostMain && srcBtns.length > 0 && !hostMain.querySelector('.v2-surface-nav')) {\n      const nav = document.createElement('nav');\n      nav.className = 'v2-surface-nav';\n      nav.setAttribute('aria-label', '视图切换');\n      const pairs = srcBtns.map(src => {\n        const clone = src.cloneNode(true);\n        clone.querySelectorAll('svg, .nav-badge, .pill, .mono').forEach(el => el.remove());\n        const navLeft = clone.querySelector('.nav-left');\n        let label = '';\n        if (navLeft) {\n          label = Array.from(navLeft.children).map(el => (el.textContent || '').trim()).filter(Boolean).join(' ');\n        } else {\n          label = (clone.textContent || '').replace(/\\s+/g, ' ').trim();\n        }\n        const tab = document.createElement('button');\n        tab.type = 'button';\n        tab.className = 'v2-surface-tab';\n        tab.dataset.surfaceView = src.dataset.view || '';\n        tab.textContent = label || src.dataset.view || '视图';\n        tab.addEventListener('click', () => { try { src.click(); } catch {} });\n        nav.appendChild(tab);\n        return [src, tab];\n      });\n      const syncNav = () => {\n        for (const [src, tab] of pairs) {\n          const active = src.classList.contains('active');\n          tab.classList.toggle('active', active);\n          if (active) tab.setAttribute('aria-current', 'page');\n          else tab.removeAttribute('aria-current');\n        }\n      };\n      syncNav();\n      hostMain.prepend(nav);\n      try {\n        const obs = new MutationObserver(syncNav);\n        obs.observe(sidebar, { subtree: true, attributes: true, attributeFilter: ['class'] });\n      } catch {}\n    }\n  }\n})();\n/* === V2 Host Theme & Compact Surface JS End === */\n</script>\n</body>\n</html>\n","path":"ui/index.html"}],"format":"nmas-plugin","manifest":{"actions":[{"id":"crm.snapshot","input_schema":{"additionalProperties":false,"properties":{},"required":[],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"accounts":{"items":{"additionalProperties":false,"properties":{"annual_potential":{"maximum":999999999,"minimum":0,"type":"number"},"contact_name":{"maxLength":40,"minLength":1,"type":"string"},"contact_role":{"maxLength":40,"type":"string"},"health":{"maximum":100,"minimum":0,"type":"integer"},"id":{"maxLength":48,"minLength":1,"type":"string"},"industry":{"maxLength":32,"minLength":1,"type":"string"},"name":{"maxLength":64,"minLength":1,"type":"string"},"risk_note":{"maxLength":240,"type":"st