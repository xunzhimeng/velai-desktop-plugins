{"files":[{"content":"const COLLECTION = 'prompts';\nconst KEY = 'vault';\nconst MAX_BYTES = 12 * 1024;\nconst MAX_TEMPLATES = 48;\nconst CATEGORIES = ['general', 'coding', 'writing', 'analysis', 'translation'];\nconst DOC_FORMAT = 'velai.prompt-vault';\n\nfunction jsonBytes(value) {\n  let bytes = 0;\n  for (const ch of JSON.stringify(value)) {\n    const cp = ch.codePointAt(0);\n    bytes += cp <= 0x7f ? 1 : cp <= 0x7ff ? 2 : cp <= 0xffff ? 3 : 4;\n  }\n  return bytes;\n}\n\nfunction extractVariables(content) {\n  const seen = new Set();\n  const list = [];\n  const re = /\\{\\{\\s*([a-zA-Z0-9_\\-\\u4e00-\\u9fff]{1,40})\\s*\\}\\}/g;\n  let match;\n  while ((match = re.exec(content)) !== null) {\n    const name = match[1];\n    if (!seen.has(name) && list.length < 24) {\n      seen.add(name);\n      list.push(name);\n    }\n  }\n  return list;\n}\n\nfunction renderTemplate(content, values) {\n  const map = new Map();\n  for (const item of values || []) {\n    if (item && typeof item.name === 'string' && typeof item.value === 'string') {\n      map.set(item.name, item.value);\n    }\n  }\n  const missing = [];\n  const seenMissing = new Set();\n  const rendered = content.replace(/\\{\\{\\s*([a-zA-Z0-9_\\-\\u4e00-\\u9fff]{1,40})\\s*\\}\\}/g, (full, name) => {\n    if (map.has(name) && map.get(name) !== '') return map.get(name);\n    if (!seenMissing.has(name)) {\n      seenMissing.add(name);\n      missing.push(name);\n    }\n    return full;\n  });\n  return { rendered, missing };\n}\n\nfunction validId(id) {\n  return typeof id === 'string' && id.length >= 1 && id.length <= 64 && /^[a-zA-Z0-9._-]+$/.test(id);\n}\n\nasync function readVault() {\n  const receipt = await globalThis.nmas.data.read({ collection: COLLECTION, key: KEY });\n  const doc = receipt.value === null ? { schema_version: 1, templates: [] } : receipt.value;\n  if (!doc || doc.schema_version !== 1 || !Array.isArray(doc.templates)) {\n    throw new Error('提示词库数据结构无效');\n  }\n  return { revision: receipt.revision, templates: doc.templates };\n}\n\nasync function writeVault(expectedRevision, templates) {\n  const value = { schema_version: 1, templates };\n  if (templates.length > MAX_TEMPLATES || jsonBytes(value) > MAX_BYTES) {\n    return { status: 'limit', revision: expectedRevision };\n  }\n  try {\n    const receipt = await globalThis.nmas.data.write({\n      collection: COLLECTION,\n      key: KEY,\n      expected_revision: expectedRevision,\n      value,\n    });\n    return { status: 'saved', revision: receipt.revision };\n  } catch (err) {\n    if (err?.code === 'conflict' && err.outcome_unknown === false) {\n      return { status: 'conflict', revision: expectedRevision };\n    }\n    throw err;\n  }\n}\n\nexport default async function (request) {\n  const { kind, contribution, input } = request ?? {};\n\n  if (kind === 'action') {\n    if (contribution === 'vault.list') {\n      return readVault();\n    }\n\n    if (contribution === 'vault.save') {\n      const { expected_revision, id, title, category, content } = input;\n      const cleanTitle = title.trim();\n      const cleanContent = content.trim();\n      if (!validId(id) || !cleanTitle || !cleanContent || !CATEGORIES.includes(category)) {\n        return { status: 'invalid_input', revision: expected_revision };\n      }\n      const current = await readVault();\n      if (current.revision !== expected_revision) {\n        return { status: 'conflict', revision: current.revision };\n      }\n      const variables = extractVariables(cleanContent);\n      const record = {\n        id,\n        title: cleanTitle,\n        category,\n        content: cleanContent,\n        variables,\n        updated_at: new Date().toISOString().slice(0, 19) + 'Z',\n      };\n      const exists = current.templates.some(t => t.id === id);\n      const next = exists\n        ? current.templates.map(t => (t.id === id ? record : t))\n        : [...current.templates, record];\n      const saved = await writeVault(expected_revision, next);\n      return saved.status === 'saved' ? { status: 'saved', revision: saved.revision, variables } : saved;\n    }\n\n    if (contribution === 'vault.delete') {\n      const { expected_revision, id } = input;\n      const current = await readVault();\n      if (current.revision !== expected_revision) {\n        return { status: 'conflict', revision: current.revision };\n      }\n      if (!current.templates.some(t => t.id === id)) {\n        return { status: 'not_found', revision: current.revision };\n      }\n      const next = current.templates.filter(t => t.id !== id);\n      const saved = await writeVault(expected_revision, next);\n      return saved.status === 'saved'\n        ? { status: 'deleted', revision: saved.revision }\n        : { status: 'conflict', revision: saved.revision };\n    }\n\n    if (contribution === 'vault.render') {\n      const current = await readVault();\n      const tpl = current.templates.find(t => t.id === input.id);\n      if (!tpl) return { status: 'not_found' };\n      const { rendered, missing } = renderTemplate(tpl.content, input.values);\n      return { status: 'ready', rendered, missing };\n    }\n\n    if (contribution === 'document.list') {\n      const current = await readVault();\n      return { items: current.templates.map(t => ({ id: t.id, label: `[${t.category}] ${t.title}` })) };\n    }\n\n    if (contribution === 'document.export') {\n      const current = await readVault();\n      const tpl = current.templates.find(t => t.id === input.id);\n      if (!tpl) return { error: 'not_found' };\n      const text = JSON.stringify(\n        { format: DOC_FORMAT, version: 1, template: { title: tpl.title, category: tpl.category, content: tpl.content } },\n        null,\n        2,\n      );\n      return { filename: `prompt-${tpl.id}.json`, text };\n    }\n\n    if (contribution === 'document.import') {\n      let parsed;\n      try {\n        parsed = JSON.parse(input.text);\n      } catch {\n        return { imported: false, reason: 'invalid_json' };\n      }\n      const tpl = parsed?.template;\n      if (\n        parsed?.format !== DOC_FORMAT ||\n        parsed?.version !== 1 ||\n        typeof tpl?.title !== 'string' ||\n        !tpl.title.trim() ||\n        !CATEGORIES.includes(tpl.category) ||\n        typeof tpl?.content !== 'string' ||\n        !tpl.content.trim()\n      ) {\n        return { imported: false, reason: 'invalid_document' };\n      }\n      const current = await readVault();\n      const newId = `imp-${Date.now().toString(36)}`;\n      const record = {\n        id: newId,\n        title: tpl.title.trim().slice(0, 80),\n        category: tpl.category,\n        content: tpl.content.trim().slice(0, 2048),\n        variables: extractVariables(tpl.content.trim()),\n        updated_at: new Date().toISOString().slice(0, 19) + 'Z',\n      };\n      const saved = await writeVault(current.revision, [...current.templates, record]);\n      return saved.status === 'saved' ? { imported: true } : { imported: false, reason: saved.status };\n    }\n  }\n\n  if (kind === 'tool') {\n    if (contribution === 'prompt.list') {\n      const current = await readVault();\n      const kw = (input.keyword || '').trim().toLowerCase();\n      const filtered = current.templates.filter(t => {\n        if (input.category && t.category !== input.category) return false;\n        if (kw && !t.title.toLowerCase().includes(kw) && !t.content.toLowerCase().includes(kw)) return false;\n        return true;\n      });\n      return {\n        success: true,\n        status: 'ready',\n        templates: filtered.map(({ id, title, category, variables }) => ({ id, title, category, variables })),\n      };\n    }\n\n    if (contribution === 'prompt.render') {\n      const current = await readVault();\n      const tpl = current.templates.find(t => t.id === input.id);\n      if (!tpl) return { success: false, status: 'not_found' };\n      const { rendered, missing } = renderTemplate(tpl.content, input.values || []);\n      return { success: true, status: 'ready', title: tpl.title, rendered, missing };\n    }\n  }\n\n  throw new Error(`不支持的调用: ${kind}/${contribution}`);\n}\n","path":"backend/index.js"},{"content":"<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>提示词模板库</title>\n  <style>\n    :root {\n      color-scheme: light dark;\n      --bg: Canvas; --fg: CanvasText; --muted: color-mix(in srgb, CanvasText 60%, transparent);\n      --border: color-mix(in srgb, CanvasText 18%, transparent);\n      --card: color-mix(in srgb, CanvasText 4%, Canvas);\n      --accent: #2563eb; --danger: #dc2626; --ok: #16a34a;\n      font: 14px/1.55 system-ui, -apple-system, sans-serif;\n    }\n    * { box-sizing: border-box; }\n    body { margin: 0; background: var(--bg); color: var(--fg); }\n    main { max-width: 960px; margin: 0 auto; padding: clamp(12px, 2.5vw, 20px); display: flex; flex-direction: column; gap: 12px; }\n    header { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; }\n    h1 { font-size: 18px; margin: 0; }\n    h2 { font-size: 14px; margin: 0 0 8px; }\n    .toolbar { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }\n    .grid { display: grid; grid-template-columns: minmax(220px, 280px) minmax(0, 1fr); gap: 14px; }\n    @media (max-width: 680px) { .grid { grid-template-columns: 1fr; } }\n    .panel { border: 1px solid var(--border); border-radius: 10px; padding: 12px; background: var(--card); display: flex; flex-direction: column; gap: 10px; }\n    .list { display: flex; flex-direction: column; gap: 6px; max-height: 420px; overflow: auto; }\n    .item { text-align: left; width: 100%; border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; background: var(--bg); color: var(--fg); cursor: pointer; }\n    .item.active { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }\n    .item-title { font-weight: 600; display: block; }\n    .item-meta { font-size: 12px; color: var(--muted); }\n    label { display: flex; flex-direction: column; gap: 4px; font-weight: 600; font-size: 13px; }\n    input, select, textarea, button { font: inherit; color: inherit; border: 1px solid var(--border); border-radius: 7px; padding: 6px 10px; background: var(--bg); }\n    textarea { min-height: 120px; resize: vertical; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; }\n    button { cursor: pointer; }\n    button.primary { background: var(--accent); border-color: var(--accent); color: #fff; }\n    button.danger { color: var(--danger); border-color: color-mix(in srgb, var(--danger) 40%, transparent); }\n    button:disabled { opacity: 0.5; cursor: not-allowed; }\n    .vars { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 8px; }\n    .preview { white-space: pre-wrap; word-break: break-word; padding: 10px; border-radius: 8px; border: 1px dashed var(--border); background: var(--bg); min-height: 54px; margin: 0; font-size: 13px; }\n    .status { font-size: 13px; margin: 0; color: var(--muted); }\n    .status[data-kind=\"error\"] { color: var(--danger); }\n    .status[data-kind=\"ok\"] { color: var(--ok); }\n    [hidden] { display: none !important; }\n  </style>\n</head>\n<body>\n  <main>\n    <header>\n      <h1>提示词模板库</h1>\n      <div class=\"toolbar\">\n        <select id=\"filter-cat\" aria-label=\"按分类筛选\">\n          <option value=\"\">全部分类</option>\n          <option value=\"general\">通用</option>\n          <option value=\"coding\">编程开发</option>\n          <option value=\"writing\">写作润色</option>\n          <option value=\"analysis\">分析总结</option>\n          <option value=\"translation\">翻译校对</option>\n        </select>\n        <input id=\"search\" type=\"search\" placeholder=\"搜索模板…\" autocomplete=\"off\">\n        <button id=\"btn-new\" class=\"primary\" type=\"button\">+ 新建模板</button>\n      </div>\n    </header>\n\n    <p id=\"status\" class=\"status\" role=\"status\">正在加载模板库…</p>\n\n    <div class=\"grid\">\n      <section class=\"panel\">\n        <h2>模板列表 (<span id=\"count\">0</span>)</h2>\n        <div id=\"list\" class=\"list\"></div>\n      </section>\n\n      <section class=\"panel\">\n        <div class=\"toolbar\" style=\"justify-content:space-between\">\n          <h2 id=\"editor-heading\" style=\"margin:0\">编辑模板</h2>\n          <div class=\"toolbar\">\n            <button id=\"btn-save\" class=\"primary\" type=\"button\">保存</button>\n            <button id=\"btn-delete\" class=\"danger\" type=\"button\" hidden>删除</button>\n          </div>\n        </div>\n        <div class=\"toolbar\">\n          <label style=\"flex:1;min-width:160px\">模板名称\n            <input id=\"f-title\" placeholder=\"例如：代码审查清单\" maxlength=\"80\" autocomplete=\"off\">\n          </label>\n          <label style=\"width:140px\">分类\n            <select id=\"f-cat\">\n              <option value=\"general\">通用</option>\n              <option value=\"coding\">编程开发</option>\n              <option value=\"writing\">写作润色</option>\n              <option value=\"analysis\">分析总结</option>\n              <option value=\"translation\">翻译校对</option>\n            </select>\n          </label>\n        </div>\n        <label>模板正文（使用 <code>{{变量名}}</code> 定义变量）\n          <textarea id=\"f-content\" placeholder=\"请从安全性、边界条件和可维护性审查以下 {{语言}} 代码：&#10;{{代码}}\"></textarea>\n        </label>\n\n        <div id=\"render-box\" hidden>\n          <h2>快速填充与使用</h2>\n          <div id=\"var-inputs\" class=\"vars\"></div>\n          <pre id=\"preview\" class=\"preview\"></pre>\n          <div class=\"toolbar\" style=\"margin-top:8px\">\n            <button id=\"btn-insert\" class=\"primary\" type=\"button\" hidden>插入到会话输入框</button>\n            <button id=\"btn-copy\" type=\"button\">复制渲染结果</button>\n          </div>\n        </div>\n      </section>\n    </div>\n  </main>\n  <script>\n    (() => {\n      const plugin = globalThis.nmasPlugin;\n      const $ = id => document.getElementById(id);\n      const CAT_LABELS = { general: '通用', coding: '编程开发', writing: '写作润色', analysis: '分析总结', translation: '翻译校对' };\n      let revision = 0, templates = [], activeId = null, canInsert = false, busy = false;\n      const varValues = new Map();\n\n      const setStatus = (msg, kind = '') => { $('status').textContent = msg; $('status').dataset.kind = kind; };\n      const extractVars = text => {\n        const out = [], seen = new Set();\n        text.replace(/\\{\\{\\s*([a-zA-Z0-9_\\-\\u4e00-\\u9fff]{1,40})\\s*\\}\\}/g, (_, n) => {\n          if (!seen.has(n)) { seen.add(n); out.push(n); }\n        });\n        return out;\n      };\n      const renderPreview = () => {\n        const content = $('f-content').value;\n        const vars = extractVars(content);\n        const box = $('render-box');\n        box.hidden = !content.trim();\n        const rendered = content.replace(/\\{\\{\\s*([a-zA-Z0-9_\\-\\u4e00-\\u9fff]{1,40})\\s*\\}\\}/g, (m, n) => varValues.get(n) || m);\n        $('preview').textContent = rendered;\n        $('btn-insert').hidden = !canInsert;\n      };\n      const rebuildVarInputs = () => {\n        const vars = extractVars($('f-content').value);\n        const container = $('var-inputs');\n        container.replaceChildren();\n        for (const name of vars) {\n          const label = document.createElement('label');\n          label.textContent = name;\n          const input = document.createElement('input');\n          input.value = varValues.get(name) || '';\n          input.placeholder = `填入 ${name}`;\n          input.addEventListener('input', () => { varValues.set(name, input.value); renderPreview(); });\n          label.appendChild(input);\n          container.appendChild(label);\n        }\n        renderPreview();\n      };\n      const renderList = () => {\n        const cat = $('filter-cat').value;\n        const kw = $('search').value.trim().toLowerCase();\n        const shown = templates.filter(t => (!cat || t.category === cat) && (!kw || t.title.toLowerCase().includes(kw) || t.content.toLowerCase().includes(kw)));\n        $('count').textContent = String(shown.length);\n        const list = $('list');\n        list.replaceChildren();\n        if (!shown.length) {\n          const p = document.createElement('p');\n          p.className = 'status';\n          p.textContent = templates.length ? '没有匹配的模板' : '暂无模板，点击「新建模板」创建第一条';\n          list.appendChild(p);\n          return;\n        }\n        for (const t of shown) {\n          const btn = document.createElement('button');\n          btn.type = 'button';\n          btn.className = `item${t.id === activeId ? ' active' : ''}`;\n          const title = document.createElement('span');\n          title.className = 'item-title';\n          title.textContent = t.title;\n          const meta = document.createElement('span');\n          meta.className = 'item-meta';\n          meta.textContent = `${CAT_LABELS[t.category] || t.category}${t.variables.length ? ` · ${t.variables.length} 个变量` : ''}`;\n          btn.append(title, meta);\n          btn.addEventListener('click', () => selectTemplate(t.id));\n          list.appendChild(btn);\n        }\n      };\n      const selectTemplate = id => {\n        activeId = id;\n        varValues.clear();\n        const tpl = templates.find(t => t.id === id);\n        $('f-title').value = tpl?.title ?? '';\n        $('f-cat').value = tpl?.category ?? 'general';\n        $('f-content').value = tpl?.content ?? '';\n        $('btn-delete').hidden = !tpl;\n        $('editor-heading').textContent = tpl ? '编辑模板' : '新建模板';\n        renderList();\n        rebuildVarInputs();\n      };\n      async function load() {\n        if (typeof plugin?.action !== 'function') { setStatus('请在 Velai Desktop 中打开此插件。', 'error'); return; }\n        try {\n          const caps = await plugin.action('host.capabilities', {}).catch(() => ({ actions: [] }));\n          canInsert = Array.isArray(caps?.actions) && caps.actions.includes('host.draft.insert');\n          const res = await plugin.action('vault.list', {});\n          revision = res.revision;\n          templates = res.templates;\n          selectTemplate(templates[0]?.id ?? null);\n          setStatus(`已加载 ${templates.length} 条模板（修订 #${revision}）`);\n        } catch (err) {\n          setStatus(`加载失败：${err?.message || '未知错误'}`, 'error');\n        }\n      }\n      $('filter-cat').addEventListener('change', renderList);\n      $('search').addEventListener('input', renderList);\n      $('f-content').addEventListener('input', rebuildVarInputs);\n      $('btn-new').addEventListener('click', () => { selectTemplate(null); $('f-title').focus(); });\n      $('btn-save').addEventListener('click', async () => {\n        if (busy) return;\n        const title = $('f-title').value.trim();\n        const content = $('f-content').value.trim();\n        if (!title || !content) { setStatus('请填写模板名称和正文。', 'error'); return; }\n        busy = true;\n        try {\n          const id = activeId || `tpl-${Date.now().toString(36)}`;\n          const res = await plugin.action('vault.save', {\n            expected_revision: revision,\n            id,\n            title,\n            category: $('f-cat').value,\n            content,\n          });\n          if (res.status === 'saved') {\n            await load();\n            selectTemplate(id);\n            setStatus('模板已保存。', 'ok');\n          } else if (res.status === 'conflict') {\n            setStatus('数据已被其他窗口修改，请刷新后重试。', 'error');\n          } else if (res.status === 'limit') {\n            setStatus('超出容量上限（最多 48 条 / 12 KiB）。', 'error');\n          } else {\n            setStatus(`保存未完成：${res.status}`, 'error');\n          }\n        } catch (err) {\n          setStatus(`保存失败：${err?.message || '未知错误'}`, 'error');\n        } finally { busy = false; }\n      });\n      $('btn-delete').addEventListener('click', async () => {\n        if (busy || !activeId) return;\n        busy = true;\n        try {\n          const res = await plugin.action('vault.delete', { expected_revision: revision, id: activeId });\n          if (res.status === 'deleted') {\n            await load();\n            setStatus('模板已删除。', 'ok');\n          } else {\n            setStatus(`删除未完成：${res.status}`, 'error');\n          }\n        } catch (err) {\n          setStatus(`删除失败：${err?.message || '未知错误'}`, 'error');\n        } finally { busy = false; }\n      });\n      $('btn-insert').addEventListener('click', async () => {\n        const text = $('preview').textContent.trim();\n        if (!text) return;\n        try {\n          const r = await plugin.action('host.draft.insert', { text });\n          if (r?.inserted) setStatus('已插入当前会话输入框。', 'ok');\n          else setStatus('未能确认插入结果，请检查输入框。', 'error');\n        } catch (err) {\n          setStatus(`插入失败：${err?.message || '未知错误'}`, 'error');\n        }\n      });\n      $('btn-copy').addEventListener('click', async () => {\n        const text = $('preview').textContent;\n        if (!text) return;\n        try {\n          await navigator.clipboard.writeText(text);\n          setStatus('已复制渲染结果。', 'ok');\n        } catch {\n          setStatus('当前沙箱不允许直接写入剪贴板，请手动选中复制。');\n        }\n      });\n      void load();\n    })();\n  </script>\n</body>\n</html>\n","path":"ui/index.html"}],"format":"nmas-plugin","manifest":{"actions":[{"id":"vault.list","input_schema":{"additionalProperties":false,"properties":{},"required":[],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"revision":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"templates":{"items":{"additionalProperties":false,"properties":{"category":{"enum":["general","coding","writing","analysis","translation"],"type":"string"},"content":{"maxLength":2048,"minLength":1,"type":"string"},"id":{"maxLength":64,"minLength":1,"type":"string"},"title":{"maxLength":80,"minLength":1,"type":"string"},"updated_at":{"maxLength":32,"minLength":10,"type":"string"},"variables":{"items":{"maxLength":40,"minLength":1,"type":"string"},"type":"array"}},"required":["id","title","category","content","variables","updated_at"],"type":"object"},"type":"array"}},"required":["revision","templates"],"type":"object"},"permissions":["data.read"],"title":"读取模板列表"},{"id":"vault.save","input_schema":{"additionalProperties":false,"properties":{"category":{"enum":["general","coding","writing","analysis","translation"],"type":"string"},"content":{"maxLength":2048,"minLength":1,"type":"string"},"expected_revision":{"maximum":9007199254740990,"minimum":0,"type":"integer"},"id":{"maxLength":64,"minLength":1,"type":"string"},"title":{"maxLength":80,"minLength":1,"type":"string"}},"required":["expected_revision","id","title","category","content"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"revision":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"status":{"enum":["saved","conflict","limit","invalid_input"],"type":"string"},"variables":{"items":{"maxLength":40,"minLength":1,"type":"string"},"type":"array"}},"required":["status","revision"],"type":"object"},"permissions":["data.read","data.write"],"title":"保存或更新模板"},{"id":"vault.delete","input_schema":{"additionalProperties":false,"properties":{"expected_revision":{"maximum":9007199254740990,"minimum":0,"type":"integer"},"id":{"maxLength":64,"minLength":1,"type":"string"}},"required":["expected_revision","id"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"revision":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"status":{"enum":["deleted","not_found","conflict"],"type":"string"}},"required":["status","revision"],"type":"object"},"permissions":["data.read","data.write"],"title":"删除模板"},{"id":"vault.render","input_schema":{"additionalProperties":false,"properties":{"id":{"maxLength":64,"minLength":1,"type":"string"},"values