{"files":[{"content":"const COLLECTION = 'decisions';\nconst KEY = 'adr-log';\nconst MAX_BYTES = 12 * 1024;\nconst MAX_RECORDS = 40;\nconst STATUSES = ['proposed', 'accepted', 'superseded', 'deprecated'];\nconst DOC_FORMAT = 'velai.decision-log';\n\nfunction jsonBytes(v) {\n  let bytes = 0;\n  for (const ch of JSON.stringify(v)) {\n    const cp = ch.codePointAt(0);\n    bytes += cp <= 0x7f ? 1 : cp <= 0x7ff ? 2 : cp <= 0xffff ? 3 : 4;\n  }\n  return bytes;\n}\n\nfunction nextAdrId(records) {\n  let maxNum = 0;\n  for (const r of records) {\n    const m = /^ADR-(\\d+)$/.exec(r.id);\n    if (m) maxNum = Math.max(maxNum, Number(m[1]));\n  }\n  return `ADR-${String(maxNum + 1).padStart(3, '0')}`;\n}\n\nasync function readLog() {\n  const receipt = await globalThis.nmas.data.read({ collection: COLLECTION, key: KEY });\n  const doc = receipt.value === null ? { schema_version: 1, records: [] } : receipt.value;\n  if (!doc || doc.schema_version !== 1 || !Array.isArray(doc.records)) {\n    throw new Error('决策日志格式无效');\n  }\n  return { revision: receipt.revision, records: doc.records };\n}\n\nasync function writeLog(expectedRevision, records) {\n  const value = { schema_version: 1, records };\n  if (records.length > MAX_RECORDS || jsonBytes(value) > MAX_BYTES) {\n    return { status: 'limit', revision: expectedRevision };\n  }\n  try {\n    const receipt = await globalThis.nmas.data.write({\n      collection: COLLECTION,\n      key: KEY,\n      expected_revision: expectedRevision,\n      value,\n    });\n    return { status: 'saved', revision: receipt.revision };\n  } catch (err) {\n    if (err?.code === 'conflict' && err.outcome_unknown === false) {\n      return { status: 'conflict', revision: expectedRevision };\n    }\n    throw err;\n  }\n}\n\nexport default async function (request) {\n  const { kind, contribution, input } = request ?? {};\n\n  if (kind === 'action') {\n    if (contribution === 'adr.list') return readLog();\n\n    if (contribution === 'adr.save') {\n      const { expected_revision, id, title, status, context, decision, consequences } = input;\n      if (!title.trim() || !decision.trim() || !STATUSES.includes(status)) {\n        return { status: 'invalid_input', revision: expected_revision };\n      }\n      const log = await readLog();\n      if (log.revision !== expected_revision) return { status: 'conflict', revision: log.revision };\n      const finalId = id === 'NEW' ? nextAdrId(log.records) : id;\n      const existing = log.records.find(r => r.id === finalId);\n      const record = {\n        id: finalId,\n        title: title.trim(),\n        status,\n        context: context.trim(),\n        decision: decision.trim(),\n        consequences: consequences.trim(),\n        date: existing?.date || new Date().toISOString().slice(0, 10),\n      };\n      const next = existing\n        ? log.records.map(r => (r.id === finalId ? record : r))\n        : [...log.records, record];\n      const saved = await writeLog(expected_revision, next);\n      return saved.status === 'saved' ? { status: 'saved', revision: saved.revision, id: finalId } : saved;\n    }\n\n    if (contribution === 'adr.delete') {\n      const log = await readLog();\n      if (log.revision !== input.expected_revision) return { status: 'conflict', revision: log.revision };\n      if (!log.records.some(r => r.id === input.id)) return { status: 'not_found', revision: log.revision };\n      const res = await writeLog(input.expected_revision, log.records.filter(r => r.id !== input.id));\n      return res.status === 'saved' ? { status: 'deleted', revision: res.revision } : { status: 'conflict', revision: res.revision };\n    }\n\n    if (contribution === 'document.list') {\n      const log = await readLog();\n      return { items: log.records.map(r => ({ id: r.id, label: `${r.id} ${r.title}` })) };\n    }\n\n    if (contribution === 'document.export') {\n      const log = await readLog();\n      const rec = log.records.find(r => r.id === input.id);\n      if (!rec) return { error: 'not_found' };\n      const text = JSON.stringify({ format: DOC_FORMAT, version: 1, record: rec }, null, 2);\n      return { filename: `${rec.id.toLowerCase()}.json`, text };\n    }\n\n    if (contribution === 'document.import') {\n      let parsed;\n      try { parsed = JSON.parse(input.text); } catch { return { imported: false, reason: 'invalid_json' }; }\n      const r = parsed?.record;\n      if (parsed?.format !== DOC_FORMAT || parsed?.version !== 1 || typeof r?.title !== 'string' || !r.title.trim() || typeof r?.decision !== 'string' || !r.decision.trim()) {\n        return { imported: false, reason: 'invalid_document' };\n      }\n      const log = await readLog();\n      const id = nextAdrId(log.records);\n      const record = {\n        id,\n        title: r.title.trim().slice(0, 100),\n        status: STATUSES.includes(r.status) ? r.status : 'proposed',\n        context: typeof r.context === 'string' ? r.context.trim().slice(0, 600) : '',\n        decision: r.decision.trim().slice(0, 600),\n        consequences: typeof r.consequences === 'string' ? r.consequences.trim().slice(0, 600) : '',\n        date: new Date().toISOString().slice(0, 10),\n      };\n      const res = await writeLog(log.revision, [...log.records, record]);\n      return res.status === 'saved' ? { imported: true } : { imported: false, reason: res.status };\n    }\n  }\n\n  if (kind === 'tool') {\n    if (contribution === 'decision.list') {\n      const log = await readLog();\n      const kw = (input.keyword || '').trim().toLowerCase();\n      const records = log.records\n        .filter(r => (!input.status || r.status === input.status) && (!kw || `${r.id} ${r.title} ${r.context} ${r.decision}`.toLowerCase().includes(kw)))\n        .map(({ id, title, status, decision, date }) => ({ id, title, status, decision, date }));\n      return { success: true, status: 'ready', records };\n    }\n\n    if (contribution === 'decision.record') {\n      if (!input.title.trim() || !input.decision.trim()) return { success: false, status: 'invalid_input' };\n      const log = await readLog();\n      const id = nextAdrId(log.records);\n      const record = {\n        id,\n        title: input.title.trim(),\n        status: STATUSES.includes(input.status) ? input.status : 'proposed',\n        context: (input.context || '').trim(),\n        decision: input.decision.trim(),\n        consequences: (input.consequences || '').trim(),\n        date: new Date().toISOString().slice(0, 10),\n      };\n      const saved = await writeLog(log.revision, [...log.records, record]);\n      return saved.status === 'saved' ? { success: true, status: 'saved', id } : { success: false, status: saved.status };\n    }\n  }\n\n  throw new Error(`不支持的调用: ${kind}/${contribution}`);\n}\n","path":"backend/index.js"},{"content":"<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>项目决策记录 (ADR)</title>\n  <style>\n    :root {\n      color-scheme: light dark;\n      --bg: Canvas; --fg: CanvasText; --muted: color-mix(in srgb, CanvasText 60%, transparent);\n      --border: color-mix(in srgb, CanvasText 18%, transparent);\n      --card: color-mix(in srgb, CanvasText 4%, Canvas);\n      --accent: #2563eb; --ok: #16a34a; --warn: #d97706; --danger: #dc2626;\n      font: 14px/1.55 system-ui, -apple-system, sans-serif;\n    }\n    * { box-sizing: border-box; }\n    body { margin: 0; background: var(--bg); color: var(--fg); }\n    main { max-width: 960px; margin: 0 auto; padding: clamp(12px, 2.5vw, 20px); display: flex; flex-direction: column; gap: 12px; }\n    header, .bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; }\n    h1 { font-size: 18px; margin: 0; }\n    h2 { font-size: 14px; margin: 0; }\n    .grid { display: grid; grid-template-columns: minmax(220px, 280px) minmax(0, 1fr); gap: 14px; }\n    @media (max-width: 680px) { .grid { grid-template-columns: 1fr; } }\n    .panel { border: 1px solid var(--border); border-radius: 10px; padding: 12px; background: var(--card); display: flex; flex-direction: column; gap: 10px; }\n    .list { display: flex; flex-direction: column; gap: 6px; max-height: 440px; overflow: auto; }\n    .card { text-align: left; width: 100%; border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; background: var(--bg); color: var(--fg); cursor: pointer; }\n    .card.active { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }\n    .pill { display: inline-block; font-size: 11px; padding: 1px 7px; border-radius: 99px; border: 1px solid var(--border); margin-left: 6px; }\n    .s-accepted { color: var(--ok); }\n    .s-proposed { color: var(--accent); }\n    .s-superseded { color: var(--warn); }\n    .s-deprecated { color: var(--danger); }\n    label { display: flex; flex-direction: column; gap: 4px; font-size: 13px; font-weight: 600; }\n    input, select, textarea, button { font: inherit; color: inherit; border: 1px solid var(--border); border-radius: 7px; padding: 6px 10px; background: var(--bg); }\n    textarea { min-height: 76px; resize: vertical; }\n    button { cursor: pointer; }\n    button.primary { background: var(--accent); border-color: var(--accent); color: #fff; }\n    button.danger { color: var(--danger); }\n    .status { font-size: 13px; color: var(--muted); margin: 0; }\n    .status[data-error=\"true\"] { color: var(--danger); }\n    [hidden] { display: none !important; }\n  </style>\n</head>\n<body>\n  <main>\n    <header>\n      <h1>项目架构决策记录 (ADR)</h1>\n      <div class=\"bar\">\n        <button id=\"btn-new\" class=\"primary\" type=\"button\">+ 记录新决策</button>\n        <button id=\"btn-refresh\" type=\"button\">刷新</button>\n      </div>\n    </header>\n    <p id=\"status\" class=\"status\" role=\"status\">正在加载项目 ADR…</p>\n    <div class=\"grid\">\n      <section class=\"panel\">\n        <h2>决策目录 (<span id=\"count\">0</span>)</h2>\n        <div id=\"list\" class=\"list\"></div>\n      </section>\n      <section class=\"panel\">\n        <div class=\"bar\">\n          <h2 id=\"form-title\">新建决策</h2>\n          <div class=\"bar\">\n            <button id=\"btn-save\" class=\"primary\" type=\"button\">保存决策</button>\n            <button id=\"btn-del\" class=\"danger\" type=\"button\" hidden>删除</button>\n          </div>\n        </div>\n        <div class=\"bar\">\n          <label style=\"flex:1;min-width:160px\">决策标题 <input id=\"f-title\" maxlength=\"100\" placeholder=\"例如：插件本地数据采用 CAS 乐观锁\"></label>\n          <label style=\"width:130px\">状态\n            <select id=\"f-status\">\n              <option value=\"proposed\">提议中</option>\n              <option value=\"accepted\">已采纳</option>\n              <option value=\"superseded\">已替代</option>\n              <option value=\"deprecated\">已废弃</option>\n            </select>\n          </label>\n        </div>\n        <label>背景与约束 <textarea id=\"f-context\" maxlength=\"600\" placeholder=\"为什么需要做这个决策？面临什么约束？\"></textarea></label>\n        <label>决策结论 <textarea id=\"f-decision\" maxlength=\"600\" placeholder=\"最终选定的方案与边界\"></textarea></label>\n        <label>影响与权衡 <textarea id=\"f-consequences\" maxlength=\"600\" placeholder=\"带来的收益、代价与后续动作\"></textarea></label>\n      </section>\n    </div>\n  </main>\n  <script>\n    (() => {\n      const plugin = globalThis.nmasPlugin;\n      const $ = id => document.getElementById(id);\n      const LABELS = { proposed: '提议中', accepted: '已采纳', superseded: '已替代', deprecated: '已废弃' };\n      let revision = 0, records = [], activeId = 'NEW', busy = false;\n      const setStatus = (t, e = false) => { $('status').textContent = t; $('status').dataset.error = String(e); };\n\n      function select(id) {\n        activeId = id;\n        const rec = records.find(r => r.id === id);\n        $('form-title').textContent = rec ? `${rec.id} · ${rec.date}` : '新建决策（自动编号）';\n        $('f-title').value = rec?.title ?? '';\n        $('f-status').value = rec?.status ?? 'proposed';\n        $('f-context').value = rec?.context ?? '';\n        $('f-decision').value = rec?.decision ?? '';\n        $('f-consequences').value = rec?.consequences ?? '';\n        $('btn-del').hidden = !rec;\n        renderList();\n      }\n      function renderList() {\n        $('count').textContent = String(records.length);\n        const list = $('list');\n        list.replaceChildren();\n        if (!records.length) {\n          const p = document.createElement('p');\n          p.className = 'status';\n          p.textContent = '当前项目尚无决策记录';\n          list.appendChild(p);\n          return;\n        }\n        for (const r of records) {\n          const btn = document.createElement('button');\n          btn.type = 'button';\n          btn.className = `card${r.id === activeId ? ' active' : ''}`;\n          const top = document.createElement('div');\n          const strong = document.createElement('strong');\n          strong.textContent = r.id;\n          const pill = document.createElement('span');\n          pill.className = `pill s-${r.status}`;\n          pill.textContent = LABELS[r.status];\n          top.append(strong, pill);\n          const sub = document.createElement('div');\n          sub.textContent = r.title;\n          btn.append(top, sub);\n          btn.addEventListener('click', () => select(r.id));\n          list.appendChild(btn);\n        }\n      }\n      async function load(preferId) {\n        if (typeof plugin?.action !== 'function') { setStatus('请在 Velai Desktop 项目会话中打开此插件。', true); return; }\n        try {\n          const res = await plugin.action('adr.list', {});\n          revision = res.revision;\n          records = res.records;\n          select(preferId && records.some(r => r.id === preferId) ? preferId : (records[0]?.id ?? 'NEW'));\n          setStatus(`已加载 ${records.length} 条 ADR（修订 #${revision}）`);\n        } catch (err) {\n          setStatus(`加载失败：${err?.message || '请确认已选择项目主会话'}`, true);\n        }\n      }\n      $('btn-new').addEventListener('click', () => { select('NEW'); $('f-title').focus(); });\n      $('btn-refresh').addEventListener('click', () => load(activeId));\n      $('btn-save').addEventListener('click', async () => {\n        if (busy) return;\n        const title = $('f-title').value.trim();\n        const decision = $('f-decision').value.trim();\n        if (!title || !decision) { setStatus('请至少填写决策标题和决策结论。', true); return; }\n        busy = true;\n        try {\n          const res = await plugin.action('adr.save', {\n            expected_revision: revision,\n            id: activeId,\n            title,\n            status: $('f-status').value,\n            context: $('f-context').value,\n            decision,\n            consequences: $('f-consequences').value,\n          });\n          if (res.status === 'saved') {\n            await load(res.id);\n            setStatus(`已保存 ${res.id}。`);\n          } else setStatus(`保存未完成：${res.status}`, true);\n        } catch (err) { setStatus(`保存失败：${err?.message || '未知错误'}`, true); }\n        finally { busy = false; }\n      });\n      $('btn-del').addEventListener('click', async () => {\n        if (busy || activeId === 'NEW') return;\n        busy = true;\n        try {\n          const res = await plugin.action('adr.delete', { expected_revision: revision, id: activeId });\n          if (res.status === 'deleted') { await load(); setStatus('决策已删除。'); }\n          else setStatus(`删除未完成：${res.status}`, true);\n        } catch (err) { setStatus(`删除失败：${err?.message || '未知错误'}`, true); }\n        finally { busy = false; }\n      });\n      void load();\n    })();\n  </script>\n</body>\n</html>\n","path":"ui/index.html"}],"format":"nmas-plugin","manifest":{"actions":[{"id":"adr.list","input_schema":{"additionalProperties":false,"properties":{},"required":[],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"records":{"items":{"additionalProperties":false,"properties":{"consequences":{"maxLength":600,"type":"string"},"context":{"maxLength":600,"type":"string"},"date":{"maxLength":10,"minLength":10,"type":"string"},"decision":{"maxLength":600,"minLength":1,"type":"string"},"id":{"maxLength":24,"minLength":1,"type":"string"},"status":{"enum":["proposed","accepted","superseded","deprecated"],"type":"string"},"title":{"maxLength":100,"minLength":1,"type":"string"}},"required":["id","title","status","context","decision","consequences","date"],"type":"object"},"type":"array"},"revision":{"maximum":9007199254740991,"minimum":0,"type":"integer"}},"required":["revision","records"],"type":"object"},"permissions":["data.read"],"title":"读取项目决策记录"},{"id":"adr.save","input_schema":{"additionalProperties":false,"properties":{"consequences":{"maxLength":600,"type":"string"},"context":{"maxLength":600,"type":"string"},"decision":{"maxLength":600,"minLength":1,"type":"string"},"expected_revision":{"maximum":9007199254740990,"minimum":0,"type":"integer"},"id":{"maxLength":24,"minLength":1,"type":"string"},"status":{"enum":["proposed","accepted","superseded","deprecated"],"type":"string"},"title":{"maxLength":100,"minLength":1,"type":"string"}},"required":["expected_revision","id","title","status","context","decision","consequences"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"id":{"maxLength":24,"type":"string"},"revision":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"status":{"enum":["saved","conflict","limit","invalid_input"],"type":"string"}},"required":["status","revision"],"type":"object"},"permissions":["data.read","data.write"],"title":"保存决策记录"},{"id":"adr.delete","input_schema":{"additionalProperties":false,"properties":{"expected_revision":{"maximum":9007199254740990,"minimum":0,"type":"integer"},"id":{"maxLength":24,"minLength":1,"type":"string"}},"required":["expected_revision","id"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"revision":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"status":{"enum":["deleted","not_found","conflict"],"type":"string"}},"required":["status","revision"],"type":"object"},"permissions":["data.read","data.write"],"title":"删除决策记录"},{"id":"document.list","input_schema":{"additionalProperties":false,"properties":{},"required":[],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"items":{"items":{"additionalProperties":false,"properties":{"id":{"maxLength":24,"minLength":1,"type":"string"},"label":{"maxLength":140,"minLength":1,"type":"string"}},"required":["id","label"],"type":"object"},"type":"array"}},"required":[],"type":"object"},"permissions":["data.read"],"title":"列出可导出的 ADR"},{"id":"document.export","input_schema":{"additionalProperties":false,"properties":{"id":{"maxLength":24,"minLength":1,"type":"string"}},"required":["id"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"error":{"maxLength":64,"type":"string"},"filename":{"maxLength":64,"type":"string"},"text":{"maxLength":8192,"type":"string"}},"required":[],"type":"object"},"permissions":["data.read"],"title":"导出单条 ADR"},{"id":"document.import","input_schema":{"additionalProperties":false,"properties":{"text":{"maxLength":8192,"minLength":2,"type":"string"}},"required":["text"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"imported":{"type":"boolean"},"reason":{"maxLength":64,"type":"string"}},"required":["imported"],"type":"object"},"permissions":["data.read","data.write"],"title":"导入 ADR JSON"}],"backend":"backend/index.js","data":[{"collection":"decisions","schema_version":1,"scope":"project"}],"files":[{"path":"backend/index.js","sha256":"6728817645893a345afc670487b8b67870fdebf100c5a3b2d049ac2502ba99bb"},{"path":"ui/index.html","sha256":"50345ae30b878e26c109cb6a384e62b2eaf9d8d78a7b663b28844cbb7916b266"}],"host_api":1,"http":[],"manifest_version":1,"name":"项目决策记录 (ADR)","page":"ui/index.html","permissions":["data.read","data.write"],"plugin_id":"decision-log","tasks":[],"tools":[{"description":"检索当前项目已记录的架构与产品决策 (ADR)，支持按状态或关键词过滤。","id":"decision.list","input_schema":{"additionalProperties":false,"properties":{"keyword":{"maxLength":64,"type":"string"},"status":{"enum":["proposed","accepted","superseded","deprecated"],"type":"string"}},"required":[],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"records":{"items":{"additionalProperties":false,"properties":{"date":{"maxLength":10,"minLength":10,"type":"string"},"decision":{"maxLength":600,"minLength":1,"type":"string"},"id":{"maxLength":24,"minLength":1,"type":"string"},"status":{"enum":["proposed","accepted","superseded","deprecated"],"type":"string"},"title":{"maxLength":100,"minLength":1,"type":"string"}},"required":["id","title","status","decision","date"],"type":"object"},"type":"array"},"status":{"enum":["ready","storage_error"],"type":"string"},"success":{"type":"boolean"}},"required":["success","status","records"],"type":"object"},"permissions":["data.read"],"title":"查询项目架构决策"},{"description":"向当前项目 ADR 台账新增一条决策记录，自动分配 ADR-NNN 编号。","id":"decision.record","input_schema":{"additionalProperties":false,"properties":{"consequences":{"maxLength":600,"type":"string"},"context":{"maxLength":600,"type":"string"},"decision":{"maxLength":600,"minLength":1,"type":"string"},"status":{"enum":["proposed","accepted","superseded","deprecated"],"type":"string"},"title":{"maxLength":100,"minLength":1,"type":"string"}},"required":["title","decision"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"id":{"maxLength":24,"type":"string"},"status":{"enum":["saved","conflict","limit","invalid_input"],"type":"string"},"success":{"type":"boolean"}},"required":["success","status"],"type":"object"},"permissions":["data.read","data.write"],"title":"新增项目架构决策"}],"ui":{"icon":"edit","surfaces":["workspace","chat"]},"version":"1.0.0"},"version":1}