{"files":[{"content":"function tidyText(text) {\n  return text\n    .replace(/\\r\\n?/g, '\\n')\n    .replace(/[ \\t]+$/gm, '')\n    .replace(/^\\n+|\\n+$/g, '')\n    .replace(/\\n{3,}/g, '\\n\\n');\n}\n\nfunction stripMarkdown(text) {\n  return tidyText(\n    text\n      .replace(/```[a-zA-Z0-9_-]*\\n?/g, '')\n      .replace(/`([^`]+)`/g, '$1')\n      .replace(/!\\[([^\\]]*)\\]\\([^)]+\\)/g, '$1')\n      .replace(/\\[([^\\]]+)\\]\\([^)]+\\)/g, '$1')\n      .replace(/^#{1,6}\\s+/gm, '')\n      .replace(/\\*\\*([^*]+)\\*\\*/g, '$1')\n      .replace(/__([^_]+)__/g, '$1')\n      .replace(/\\*([^*\\n]+)\\*/g, '$1')\n      .replace(/^>\\s?/gm, ''),\n  );\n}\n\nfunction toBullets(text) {\n  const lines = tidyText(text)\n    .split('\\n')\n    .map(l => l.trim())\n    .filter(Boolean)\n    .map(l => l.replace(/^[-*•\\d.]+\\s*/, ''))\n    .map(l => `- ${l}`);\n  return lines.join('\\n');\n}\n\nfunction quoteReply(text) {\n  return tidyText(text)\n    .split('\\n')\n    .map(l => (l.trim() ? `> ${l}` : '>'))\n    .join('\\n');\n}\n\nfunction countWords(text) {\n  const m = text.match(/[A-Za-z0-9]+(?:['’-][A-Za-z0-9]+)*|[\\u3400-\\u4dbf\\u4e00-\\u9fff]/g);\n  return m ? m.length : 0;\n}\n\nexport default async function (request) {\n  const { kind, contribution, input } = request ?? {};\n  if (kind !== 'action' || contribution !== 'text.transform') {\n    throw new Error('不支持的动作');\n  }\n  const { mode, text } = input;\n  let result;\n  if (mode === 'tidy') result = tidyText(text);\n  else if (mode === 'strip_markdown') result = stripMarkdown(text);\n  else if (mode === 'to_bullets') result = toBullets(text);\n  else if (mode === 'quote_reply') result = quoteReply(text);\n  else throw new Error('未知模式');\n\n  const lines = result ? result.split('\\n').length : 0;\n  return {\n    result,\n    chars: Array.from(result).length,\n    words: countWords(result),\n    lines,\n  };\n}\n","path":"backend/index.js"},{"content":"<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>回复改写与格式助手</title>\n  <style>\n    :root {\n      color-scheme: light dark;\n      --bg: Canvas; --fg: CanvasText; --muted: color-mix(in srgb, CanvasText 60%, transparent);\n      --border: color-mix(in srgb, CanvasText 18%, transparent);\n      --card: color-mix(in srgb, CanvasText 4%, Canvas);\n      --accent: #2563eb; --danger: #dc2626;\n      font: 14px/1.55 system-ui, -apple-system, sans-serif;\n    }\n    * { box-sizing: border-box; }\n    body { margin: 0; background: var(--bg); color: var(--fg); }\n    main { max-width: 860px; margin: 0 auto; padding: clamp(12px, 2.5vw, 20px); display: flex; flex-direction: column; gap: 10px; }\n    header, .row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: space-between; }\n    h1 { font-size: 18px; margin: 0; }\n    .panel { border: 1px solid var(--border); border-radius: 10px; padding: 12px; background: var(--card); display: flex; flex-direction: column; gap: 8px; }\n    textarea, select, button { font: inherit; color: inherit; border: 1px solid var(--border); border-radius: 7px; padding: 6px 10px; background: var(--bg); }\n    textarea { width: 100%; min-height: 140px; resize: vertical; }\n    button { cursor: pointer; }\n    button.primary { background: var(--accent); border-color: var(--accent); color: #fff; }\n    button:disabled { opacity: 0.55; cursor: not-allowed; }\n    .status { font-size: 13px; color: var(--muted); margin: 0; }\n    .status[data-error=\"true\"] { color: var(--danger); }\n    [hidden] { display: none !important; }\n  </style>\n</head>\n<body>\n  <main>\n    <header>\n      <h1>回复改写与格式助手</h1>\n      <div class=\"row\">\n        <button id=\"btn-read\" type=\"button\" hidden>读入选中回复</button>\n        <button id=\"btn-insert\" class=\"primary\" type=\"button\" hidden>填回会话输入框</button>\n      </div>\n    </header>\n\n    <section class=\"panel\">\n      <div class=\"row\">\n        <strong>编辑区</strong>\n        <span id=\"stats\" class=\"status\">0 字 · 0 行</span>\n      </div>\n      <textarea id=\"editor\" placeholder=\"输入文本，或在聊天中点选回复后点击「读入选中回复」…\"></textarea>\n      <div class=\"row\" style=\"justify-content:flex-start\">\n        <button data-mode=\"tidy\" type=\"button\">整理空行空格</button>\n        <button data-mode=\"strip_markdown\" type=\"button\">去除 Markdown</button>\n        <button data-mode=\"to_bullets\" type=\"button\">转为要点列表</button>\n        <button data-mode=\"quote_reply\" type=\"button\">转为引用块</button>\n      </div>\n    </section>\n\n    <section class=\"panel\">\n      <div class=\"row\">\n        <strong>交给当前会话改写</strong>\n        <div class=\"row\">\n          <select id=\"tone\">\n            <option value=\"concise\">精简压缩（保留关键信息）</option>\n            <option value=\"professional\">专业正式（适合对外沟通）</option>\n            <option value=\"english\">地道英文（专业技术风格）</option>\n            <option value=\"bullets\">结构化结论 + 行动要点</option>\n          </select>\n          <button id=\"btn-rewrite\" class=\"primary\" type=\"button\">发送改写</button>\n          <button id=\"btn-check\" type=\"button\" hidden>核对改写结果</button>\n        </div>\n      </div>\n      <p id=\"status\" class=\"status\" role=\"status\">就绪</p>\n    </section>\n  </main>\n  <script>\n    (() => {\n      const plugin = globalThis.nmasPlugin;\n      const $ = id => document.getElementById(id);\n      const TONES = {\n        concise: '请将以下文字改写得更加精炼清晰，删除冗余表述，保留核心信息。只返回改写后的正文：',\n        professional: '请将以下文字润色为专业、礼貌、条理清晰的正式职场表达。只返回改写后的正文：',\n        english: 'Please translate and polish the following text into natural, clear, professional English. Return only the revised text:',\n        bullets: '请将以下内容整理为“核心结论 + 分条要点”的结构化文本。只返回整理后的正文：',\n      };\n      let workId = null;\n      const setStatus = (t, err = false) => { $('status').textContent = t; $('status').dataset.error = String(err); };\n\n      function uuid() {\n        const b = crypto.getRandomValues(new Uint8Array(16));\n        b[6] = (b[6] & 0x0f) | 0x40;\n        b[8] = (b[8] & 0x3f) | 0x80;\n        const h = Array.from(b, x => x.toString(16).padStart(2, '0')).join('');\n        return `${h.slice(0, 8)}-${h.slice(8, 12)}-${h.slice(12, 16)}-${h.slice(16, 20)}-${h.slice(20)}`;\n      }\n\n      function updateStats() {\n        const val = $('editor').value;\n        const chars = Array.from(val).length;\n        const lines = val ? val.split('\\n').length : 0;\n        $('stats').textContent = `${chars} 字 · ${lines} 行`;\n      }\n\n      async function initHost() {\n        if (typeof plugin?.action !== 'function') { setStatus('请在 Velai Desktop 中打开此插件。', true); return; }\n        try {\n          const caps = await plugin.action('host.capabilities', {});\n          const acts = Array.isArray(caps?.actions) ? caps.actions : [];\n          $('btn-read').hidden = !acts.includes('host.selection.read');\n          $('btn-insert').hidden = !acts.includes('host.draft.insert');\n        } catch {\n          setStatus('当前环境仅支持本地编辑。');\n        }\n      }\n\n      document.querySelectorAll('button[data-mode]').forEach(btn => {\n        btn.addEventListener('click', async () => {\n          const text = $('editor').value;\n          if (!text.trim()) { setStatus('请先输入文本。', true); return; }\n          try {\n            const res = await plugin.action('text.transform', { mode: btn.dataset.mode, text });\n            $('editor').value = res.result;\n            updateStats();\n            setStatus(`已完成变换（${res.words} 词 / ${res.lines} 行）`);\n          } catch (e) { setStatus(`变换失败：${e?.message || '未知错误'}`, true); }\n        });\n      });\n\n      $('btn-read').addEventListener('click', async () => {\n        try {\n          const res = await plugin.action('host.selection.read', {});\n          if (typeof res?.text === 'string' && res.text.trim()) {\n            $('editor').value = res.text;\n            updateStats();\n            setStatus('已读入当前选中的回复。');\n          } else setStatus('请先在会话中点选一条回复。', true);\n        } catch { setStatus('无法读取选中回复。', true); }\n      });\n\n      $('btn-insert').addEventListener('click', async () => {\n        const text = $('editor').value.trim();\n        if (!text) { setStatus('编辑区为空。', true); return; }\n        try {\n          const res = await plugin.action('host.draft.insert', { text });\n          setStatus(res?.inserted ? '已填回会话输入框。' : '插入结果未确认。', !res?.inserted);\n        } catch (e) { setStatus(`插入失败：${e?.message || '未知错误'}`, true); }\n      });\n\n      $('btn-rewrite').addEventListener('click', async () => {\n        const text = $('editor').value.trim();\n        if (!text) { setStatus('请先输入需要改写的文本。', true); return; }\n        const prompt = `${TONES[$('tone').value]}\\n\\n${text}`;\n        if (Array.from(prompt).length > 2048) { setStatus('文本过长，请控制在 1900 字以内。', true); return; }\n        workId = uuid();\n        $('btn-check').hidden = false;\n        setStatus('正在提交给当前会话改写…');\n        try {\n          await plugin.action('session.turn.request', { prompt, work_id: workId });\n          setStatus('已派发，请在会话回复完成后点击「核对改写结果」。');\n        } catch (e) {\n          setStatus(e?.message === 'cancelled' ? '未选择目标会话，已取消发送。' : '发送结果未确认，请到原会话查看。', true);\n        }\n      });\n\n      $('btn-check').addEventListener('click', async () => {\n        if (!workId) return;\n        try {\n          const res = await plugin.action('session.turn.result', { work_id: workId });\n          if (res.state === 'completed' && !res.truncated && typeof res.text === 'string' && res.text.trim()) {\n            $('editor').value = res.text.trim();\n            updateStats();\n            workId = null;\n            $('btn-check').hidden = true;\n            setStatus('已取得改写结果并更新至编辑区。');\n          } else {\n            setStatus(`当前状态：${res.state}`);\n          }\n        } catch (e) { setStatus(`核对失败：${e?.message || '请回到原会话查看'}`, true); }\n      });\n\n      $('editor').addEventListener('input', updateStats);\n      void initHost();\n    })();\n  </script>\n</body>\n</html>\n","path":"ui/index.html"}],"format":"nmas-plugin","manifest":{"actions":[{"id":"text.transform","input_schema":{"additionalProperties":false,"properties":{"mode":{"enum":["tidy","strip_markdown","to_bullets","quote_reply"],"type":"string"},"text":{"maxLength":6000,"minLength":1,"type":"string"}},"required":["mode","text"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"chars":{"maximum":100000,"minimum":0,"type":"integer"},"lines":{"maximum":10000,"minimum":0,"type":"integer"},"result":{"maxLength":8000,"type":"string"},"words":{"maximum":100000,"minimum":0,"type":"integer"}},"required":["result","chars","words","lines"],"type":"object"},"permissions":[],"title":"本地清洗与格式化文本"},{"id":"session.turn.request","input_schema":{"additionalProperties":false,"properties":{"prompt":{"maxLength":2048,"minLength":1,"type":"string"},"work_id":{"maxLength":36,"minLength":36,"type":"string"}},"required":["prompt","work_id"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"state":{"enum":["dispatching"],"type":"string"},"task_id":{"maxLength":36,"minLength":36,"type":"string"}},"required":["task_id","state"],"type":"object"},"permissions":["tasks.start"],"title":"交给当前会话改写"},{"id":"session.turn.result","input_schema":{"additionalProperties":false,"properties":{"work_id":{"maxLength":36,"minLength":36,"type":"string"}},"required":["work_id"],"type":"object"},"output_schema":{"additionalProperties":true,"properties":{"state":{"enum":["dispatching","running","waiting","completed","cancelled","failed","unknown","unavailable"],"type":"string"},"truncated":{"type":"boolean"},"work_id":{"maxLength":36,"minLength":36,"type":"string"}},"required":["work_id","state","truncated"],"type":"object"},"permissions":["tasks.read"],"title":"核对改写结果"}],"backend":"backend/index.js","data":[],"files":[{"path":"backend/index.js","sha256":"ef99b19369dc6a3ece626ccea3efb40ad15332c1e26757ac94e9a7d69fb0e77a"},{"path":"ui/index.html","sha256":"c940c907441c328b6b32b5eaab31e7fdb2be5c493cd93510d0e3dba7eb5c2cc7"}],"host_api":1,"http":[],"manifest_version":1,"name":"回复改写与格式助手","page":"ui/index.html","permissions":["tasks.start","tasks.read","tasks.cancel"],"plugin_id":"reply-polisher","tasks":[],"tools":[],"ui":{"icon":"edit","surfaces":["workspace","chat","assistant"]},"version":"1.0.0"},"version":1}