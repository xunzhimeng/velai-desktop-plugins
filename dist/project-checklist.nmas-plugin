{"files":[{"content":"const COLLECTION = 'checklist';\nconst KEY = 'board';\nconst MAX_BYTES = 12 * 1024;\nconst MAX_ITEMS = 80;\nconst PRIORITIES = ['high', 'medium', 'low'];\nconst STATES = ['todo', 'doing', 'done'];\nconst DOC_FORMAT = 'velai.project-checklist';\n\nfunction jsonBytes(value) {\n  let bytes = 0;\n  for (const ch of JSON.stringify(value)) {\n    const cp = ch.codePointAt(0);\n    bytes += cp <= 0x7f ? 1 : cp <= 0x7ff ? 2 : cp <= 0xffff ? 3 : 4;\n  }\n  return bytes;\n}\n\nfunction summarize(items) {\n  const todo = items.filter(i => i.state === 'todo').length;\n  const doing = items.filter(i => i.state === 'doing').length;\n  const done = items.filter(i => i.state === 'done').length;\n  const total = items.length;\n  return { total, todo, doing, done, completion_pct: total === 0 ? 0 : Math.round((done * 100) / total) };\n}\n\nasync function readBoard() {\n  const receipt = await globalThis.nmas.data.read({ collection: COLLECTION, key: KEY });\n  const doc = receipt.value === null ? { schema_version: 1, items: [] } : receipt.value;\n  if (!doc || doc.schema_version !== 1 || !Array.isArray(doc.items)) {\n    throw new Error('项目清单数据格式无效');\n  }\n  return { revision: receipt.revision, items: doc.items };\n}\n\nasync function writeBoard(expectedRevision, items) {\n  const value = { schema_version: 1, items };\n  if (items.length > MAX_ITEMS || jsonBytes(value) > MAX_BYTES) {\n    return { status: 'limit', revision: expectedRevision };\n  }\n  try {\n    const receipt = await globalThis.nmas.data.write({\n      collection: COLLECTION,\n      key: KEY,\n      expected_revision: expectedRevision,\n      value,\n    });\n    return { status: 'saved', revision: receipt.revision };\n  } catch (err) {\n    if (err?.code === 'conflict' && err.outcome_unknown === false) {\n      return { status: 'conflict', revision: expectedRevision };\n    }\n    throw err;\n  }\n}\n\nexport default async function (request) {\n  const { kind, contribution, input } = request ?? {};\n\n  if (kind === 'action') {\n    if (contribution === 'tasks.list') {\n      const board = await readBoard();\n      return { revision: board.revision, items: board.items, summary: summarize(board.items) };\n    }\n\n    if (contribution === 'tasks.upsert') {\n      const { expected_revision, id, title, milestone, priority, state, note } = input;\n      const cleanTitle = title.trim();\n      if (!cleanTitle || !/^[a-zA-Z0-9._-]+$/.test(id) || !PRIORITIES.includes(priority) || !STATES.includes(state)) {\n        return { status: 'invalid_input', revision: expected_revision };\n      }\n      const board = await readBoard();\n      if (board.revision !== expected_revision) return { status: 'conflict', revision: board.revision };\n      const record = { id, title: cleanTitle, milestone: milestone.trim(), priority, state, note: note.trim() };\n      const exists = board.items.some(item => item.id === id);\n      const next = exists ? board.items.map(item => (item.id === id ? record : item)) : [...board.items, record];\n      return writeBoard(expected_revision, next);\n    }\n\n    if (contribution === 'tasks.remove') {\n      const { expected_revision, id } = input;\n      const board = await readBoard();\n      if (board.revision !== expected_revision) return { status: 'conflict', revision: board.revision };\n      if (!board.items.some(item => item.id === id)) return { status: 'not_found', revision: board.revision };\n      const next = board.items.filter(item => item.id !== id);\n      const res = await writeBoard(expected_revision, next);\n      return res.status === 'saved' ? { status: 'deleted', revision: res.revision } : { status: 'conflict', revision: res.revision };\n    }\n\n    if (contribution === 'document.list') {\n      const board = await readBoard();\n      return { items: board.items.length ? [{ id: 'all', label: `全部项目任务 (${board.items.length} 项)` }] : [] };\n    }\n\n    if (contribution === 'document.export') {\n      const board = await readBoard();\n      if (input.id !== 'all') return { error: 'not_found' };\n      const text = JSON.stringify({ format: DOC_FORMAT, version: 1, items: board.items }, null, 2);\n      return { filename: 'project-checklist.json', text };\n    }\n\n    if (contribution === 'document.import') {\n      let parsed;\n      try { parsed = JSON.parse(input.text); } catch { return { imported: false, reason: 'invalid_json' }; }\n      if (parsed?.format !== DOC_FORMAT || parsed?.version !== 1 || !Array.isArray(parsed.items)) {\n        return { imported: false, reason: 'invalid_document' };\n      }\n      const board = await readBoard();\n      const next = [...board.items];\n      for (let i = 0; i < parsed.items.length; i++) {\n        const raw = parsed.items[i];\n        if (typeof raw?.title !== 'string' || !raw.title.trim()) continue;\n        next.push({\n          id: `imp-${Date.now().toString(36)}-${i}`,\n          title: raw.title.trim().slice(0, 120),\n          milestone: typeof raw.milestone === 'string' ? raw.milestone.trim().slice(0, 48) : '',\n          priority: PRIORITIES.includes(raw.priority) ? raw.priority : 'medium',\n          state: STATES.includes(raw.state) ? raw.state : 'todo',\n          note: typeof raw.note === 'string' ? raw.note.trim().slice(0, 300) : '',\n        });\n      }\n      const res = await writeBoard(board.revision, next);\n      return res.status === 'saved' ? { imported: true } : { imported: false, reason: res.status };\n    }\n  }\n\n  if (kind === 'tool') {\n    if (contribution === 'checklist.list') {\n      const board = await readBoard();\n      const ms = (input.milestone || '').trim().toLowerCase();\n      const items = board.items\n        .filter(item => (!input.state || item.state === input.state) && (!ms || item.milestone.toLowerCase().includes(ms)))\n        .map(({ id, title, milestone, priority, state }) => ({ id, title, milestone, priority, state }));\n      return { success: true, status: 'ready', completion_pct: summarize(board.items).completion_pct, items };\n    }\n\n    if (contribution === 'checklist.add') {\n      const cleanTitle = (input.title || '').trim();\n      if (!cleanTitle) return { success: false, status: 'invalid_input' };\n      const board = await readBoard();\n      const id = `t-${Date.now().toString(36)}-${board.items.length + 1}`;\n      const record = {\n        id,\n        title: cleanTitle,\n        milestone: (input.milestone || '').trim(),\n        priority: PRIORITIES.includes(input.priority) ? input.priority : 'medium',\n        state: 'todo',\n        note: (input.note || '').trim(),\n      };\n      const saved = await writeBoard(board.revision, [...board.items, record]);\n      return saved.status === 'saved'\n        ? { success: true, status: 'saved', id }\n        : { success: false, status: saved.status };\n    }\n  }\n\n  throw new Error(`不支持的调用: ${kind}/${contribution}`);\n}\n","path":"backend/index.js"},{"content":"<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>项目任务清单</title>\n  <style>\n    :root {\n      color-scheme: light dark;\n      --bg: Canvas; --fg: CanvasText; --muted: color-mix(in srgb, CanvasText 60%, transparent);\n      --border: color-mix(in srgb, CanvasText 18%, transparent);\n      --card: color-mix(in srgb, CanvasText 4%, Canvas);\n      --accent: #2563eb; --high: #dc2626; --med: #d97706; --low: #16a34a;\n      font: 14px/1.5 system-ui, -apple-system, sans-serif;\n    }\n    * { box-sizing: border-box; }\n    body { margin: 0; background: var(--bg); color: var(--fg); }\n    main { max-width: 920px; margin: 0 auto; padding: clamp(12px, 2.5vw, 20px); display: flex; flex-direction: column; gap: 12px; }\n    header { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; }\n    h1 { font-size: 18px; margin: 0; }\n    .metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }\n    @media (max-width: 560px) { .metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n    .metric { border: 1px solid var(--border); border-radius: 9px; padding: 8px 10px; background: var(--card); }\n    .metric strong { font-size: 18px; display: block; }\n    .metric span { font-size: 12px; color: var(--muted); }\n    .bar { height: 8px; border-radius: 99px; background: var(--border); overflow: hidden; }\n    .bar > div { height: 100%; background: var(--accent); transition: width .2s ease; }\n    .form { display: grid; grid-template-columns: 2fr 1fr 110px auto; gap: 8px; align-items: end; border: 1px solid var(--border); border-radius: 10px; padding: 10px; background: var(--card); }\n    @media (max-width: 680px) { .form { grid-template-columns: 1fr; } }\n    label { display: flex; flex-direction: column; gap: 4px; font-size: 12px; font-weight: 600; }\n    input, select, button { font: inherit; color: inherit; border: 1px solid var(--border); border-radius: 7px; padding: 6px 10px; background: var(--bg); }\n    button { cursor: pointer; }\n    button.primary { background: var(--accent); border-color: var(--accent); color: #fff; }\n    .filters { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }\n    .chip { padding: 4px 10px; border-radius: 99px; font-size: 12px; }\n    .chip.active { background: var(--accent); color: #fff; border-color: var(--accent); }\n    .list { display: flex; flex-direction: column; gap: 8px; }\n    .row { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 10px; align-items: center; border: 1px solid var(--border); border-radius: 9px; padding: 10px; background: var(--card); }\n    .row.done .title { text-decoration: line-through; color: var(--muted); }\n    .badge { display: inline-block; font-size: 11px; padding: 1px 7px; border-radius: 99px; border: 1px solid var(--border); margin-right: 6px; }\n    .p-high { color: var(--high); border-color: color-mix(in srgb, var(--high) 50%, transparent); }\n    .p-medium { color: var(--med); border-color: color-mix(in srgb, var(--med) 50%, transparent); }\n    .p-low { color: var(--low); border-color: color-mix(in srgb, var(--low) 50%, transparent); }\n    .meta { font-size: 12px; color: var(--muted); margin-top: 2px; }\n    .status { font-size: 13px; color: var(--muted); margin: 0; }\n    .status[data-error=\"true\"] { color: var(--high); }\n  </style>\n</head>\n<body>\n  <main>\n    <header>\n      <h1>项目任务清单</h1>\n      <button id=\"btn-refresh\" type=\"button\">刷新</button>\n    </header>\n\n    <section class=\"metrics\">\n      <div class=\"metric\"><strong id=\"m-total\">0</strong><span>总任务</span></div>\n      <div class=\"metric\"><strong id=\"m-todo\">0</strong><span>待开始</span></div>\n      <div class=\"metric\"><strong id=\"m-doing\">0</strong><span>进行中</span></div>\n      <div class=\"metric\"><strong id=\"m-pct\">0%</strong><span>完成率</span></div>\n    </section>\n    <div class=\"bar\"><div id=\"progress\" style=\"width:0%\"></div></div>\n\n    <form id=\"add-form\" class=\"form\">\n      <label>任务标题 <input id=\"f-title\" placeholder=\"例如：完成插件接口回归测试\" maxlength=\"120\" required autocomplete=\"off\"></label>\n      <label>里程碑 <input id=\"f-milestone\" placeholder=\"例如：v1.0\" maxlength=\"48\" autocomplete=\"off\"></label>\n      <label>优先级\n        <select id=\"f-priority\">\n          <option value=\"high\">高</option>\n          <option value=\"medium\" selected>中</option>\n          <option value=\"low\">低</option>\n        </select>\n      </label>\n      <button class=\"primary\" type=\"submit\">添加任务</button>\n    </form>\n\n    <div class=\"filters\">\n      <button class=\"chip active\" data-filter=\"all\" type=\"button\">全部</button>\n      <button class=\"chip\" data-filter=\"todo\" type=\"button\">待开始</button>\n      <button class=\"chip\" data-filter=\"doing\" type=\"button\">进行中</button>\n      <button class=\"chip\" data-filter=\"done\" type=\"button\">已完成</button>\n    </div>\n\n    <p id=\"status\" class=\"status\" role=\"status\">正在读取当前项目任务…</p>\n    <section id=\"list\" class=\"list\"></section>\n  </main>\n  <script>\n    (() => {\n      const plugin = globalThis.nmasPlugin;\n      const $ = id => document.getElementById(id);\n      const P_LABEL = { high: '高优先级', medium: '中优先级', low: '低优先级' };\n      const NEXT_STATE = { todo: 'doing', doing: 'done', done: 'todo' };\n      const STATE_LABEL = { todo: '待开始', doing: '进行中', done: '已完成' };\n      let revision = 0, items = [], filter = 'all', busy = false;\n\n      const setStatus = (text, err = false) => { $('status').textContent = text; $('status').dataset.error = String(err); };\n\n      function render(summary) {\n        if (summary) {\n          $('m-total').textContent = String(summary.total);\n          $('m-todo').textContent = String(summary.todo);\n          $('m-doing').textContent = String(summary.doing);\n          $('m-pct').textContent = `${summary.completion_pct}%`;\n          $('progress').style.width = `${summary.completion_pct}%`;\n        }\n        const list = $('list');\n        list.replaceChildren();\n        const shown = items.filter(i => filter === 'all' || i.state === filter);\n        if (!shown.length) {\n          const p = document.createElement('p');\n          p.className = 'status';\n          p.textContent = items.length ? '当前筛选下没有任务' : '当前项目暂无任务，上方输入即可添加';\n          list.appendChild(p);\n          return;\n        }\n        for (const item of shown) {\n          const row = document.createElement('div');\n          row.className = `row${item.state === 'done' ? ' done' : ''}`;\n          const stateBtn = document.createElement('button');\n          stateBtn.type = 'button';\n          stateBtn.textContent = STATE_LABEL[item.state];\n          stateBtn.title = '点击切换状态';\n          stateBtn.addEventListener('click', () => updateItem({ ...item, state: NEXT_STATE[item.state] }));\n\n          const body = document.createElement('div');\n          const title = document.createElement('div');\n          title.className = 'title';\n          title.textContent = item.title;\n          const meta = document.createElement('div');\n          meta.className = 'meta';\n          const badge = document.createElement('span');\n          badge.className = `badge p-${item.priority}`;\n          badge.textContent = P_LABEL[item.priority];\n          meta.appendChild(badge);\n          if (item.milestone) meta.append(`里程碑：${item.milestone}`);\n          if (item.note) meta.append(` · ${item.note}`);\n          body.append(title, meta);\n\n          const delBtn = document.createElement('button');\n          delBtn.type = 'button';\n          delBtn.textContent = '删除';\n          delBtn.addEventListener('click', () => removeItem(item.id));\n\n          row.append(stateBtn, body, delBtn);\n          list.appendChild(row);\n        }\n      }\n\n      async function load() {\n        if (typeof plugin?.action !== 'function') { setStatus('请在 Velai Desktop 项目会话中打开此插件。', true); return; }\n        try {\n          const data = await plugin.action('tasks.list', {});\n          revision = data.revision;\n          items = data.items;\n          render(data.summary);\n          setStatus(`项目清单已同步（修订 #${revision}）`);\n        } catch (err) {\n          setStatus(`读取失败：${err?.message || '请确认已选择项目主会话'}`, true);\n        }\n      }\n\n      async function updateItem(item) {\n        if (busy) return;\n        busy = true;\n        try {\n          const res = await plugin.action('tasks.upsert', { expected_revision: revision, ...item });\n          if (res.status === 'saved') await load();\n          else setStatus(`操作未完成：${res.status}`, true);\n        } catch (err) {\n          setStatus(`更新失败：${err?.message || '未知错误'}`, true);\n        } finally { busy = false; }\n      }\n\n      async function removeItem(id) {\n        if (busy) return;\n        busy = true;\n        try {\n          const res = await plugin.action('tasks.remove', { expected_revision: revision, id });\n          if (res.status === 'deleted') await load();\n          else setStatus(`删除未完成：${res.status}`, true);\n        } catch (err) {\n          setStatus(`删除失败：${err?.message || '未知错误'}`, true);\n        } finally { busy = false; }\n      }\n\n      $('add-form').addEventListener('submit', async e => {\n        e.preventDefault();\n        const title = $('f-title').value.trim();\n        if (!title) return;\n        await updateItem({\n          id: `t-${Date.now().toString(36)}`,\n          title,\n          milestone: $('f-milestone').value.trim(),\n          priority: $('f-priority').value,\n          state: 'todo',\n          note: '',\n        });\n        $('f-title').value = '';\n        $('f-title').focus();\n      });\n\n      $('btn-refresh').addEventListener('click', load);\n      document.querySelectorAll('.chip').forEach(btn => {\n        btn.addEventListener('click', () => {\n          filter = btn.dataset.filter;\n          document.querySelectorAll('.chip').forEach(b => b.classList.toggle('active', b === btn));\n          render();\n        });\n      });\n\n      void load();\n    })();\n  </script>\n</body>\n</html>\n","path":"ui/index.html"}],"format":"nmas-plugin","manifest":{"actions":[{"id":"tasks.list","input_schema":{"additionalProperties":false,"properties":{},"required":[],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"items":{"items":{"additionalProperties":false,"properties":{"id":{"maxLength":48,"minLength":1,"type":"string"},"milestone":{"maxLength":48,"type":"string"},"note":{"maxLength":300,"type":"string"},"priority":{"enum":["high","medium","low"],"type":"string"},"state":{"enum":["todo","doing","done"],"type":"string"},"title":{"maxLength":120,"minLength":1,"type":"string"}},"required":["id","title","milestone","priority","state","note"],"type":"object"},"type":"array"},"revision":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"summary":{"additionalProperties":false,"properties":{"completion_pct":{"maximum":100,"minimum":0,"type":"integer"},"doing":{"maximum":128,"minimum":0,"type":"integer"},"done":{"maximum":128,"minimum":0,"type":"integer"},"todo":{"maximum":128,"minimum":0,"type":"integer"},"total":{"maximum":128,"minimum":0,"type":"integer"}},"required":["total","todo","doing","done","completion_pct"],"type":"object"}},"required":["revision","items","summary"],"type":"object"},"permissions":["data.read"],"title":"读取项目任务清单"},{"id":"tasks.upsert","input_schema":{"additionalProperties":false,"properties":{"expected_revision":{"maximum":9007199254740990,"minimum":0,"type":"integer"},"id":{"maxLength":48,"minLength":1,"type":"string"},"milestone":{"maxLength":48,"type":"string"},"note":{"maxLength":300,"type":"string"},"priority":{"enum":["high","medium","low"],"type":"string"},"state":{"enum":["todo","doing","done"],"type":"string"},"title":{"maxLength":120,"minLength":1,"type":"string"}},"required":["expected_revision","id","title","milestone","priority","state","note"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"revision":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"status":{"enum":["saved","conflict","limit","invalid_input"],"type":"string"}},"required":["status","revision"],"type":"object"},"permissions":["data.read","data.write"],"title":"新增或更新任务"},{"id":"tasks.remove","input_schema":{"additionalProperties":false,"properties":{"expected_revision":{"maximum":9007199254740990,"minimum":0,"type":"integer"},"id":{"maxLength":48,"minLength":1,"type":"string"}},"required":["expected_revision","id"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"revision":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"status":{"enum":["deleted","not_found","conflict"],"type":"string"}},"required":["status","revision"],"type":"object"},"permissions":["data.read","data.write"],"title":"删除任务"},{"id":"document.list","input_schema":{"additionalProperties":false,"properties":{},"required":[],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"items":{"items":{"additionalProperties":false,"properties":{"id":{"maxLength":32,"minLength":1,"type":"string"},"label":{"maxLength":80,"minLength":1,"type":"string"}},"required":["id","label"],"type":"object"},"type":"array"}},"required":[],"type":"object"},"permissions":["data.read"],"title":"列出可导出的清单"},{"id":"document.export","input_schema":{"additionalProperties":false,"properties":{"id":{"maxLength":32,"minLength":1,"type":"string"}},"required":["id"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"error":{"maxLength":64,"type":"string"},"filename":{"maxLength":64,"type":"string"},"text":{"maxLength":12288,"type":"string"}},"required":[],"type":"object"},"permissions":["data.read"],"title":"导出清单 JSON"},{"id":"document.import","input_schema":{"additionalProperties":false,"properties":{"text":{"maxLength":12288,"minLength":2,"type":"string"}},"required":["text"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"imported":{"type":"boolean"},"reason":{"maxLength":64,"type":"string"}},"required":["imported"],"type":"object"},"permissions":["data.read","data.write"],"title":"导入清单任务"}],"backend":"backend/index.js","data":[{"collection":"checklist","schema_version":1,"scope":"project"}],"files":[{"path":"backend/index.js","sha256":"7bb72aef8e48ea9135cda651d0f14fb16a14ce1a6a7e2645f68e68c80dabafcb"},{"path":"ui/index.html","sha256":"478d448c8660cd0832ffc375bf142c1895b38f0f2f5086f6d95a980ded9bac4c"}],"host_api":1,"http":[],"manifest_version":1,"name":"项目任务清单","page":"ui/index.html","permissions":["data.read","data.write"],"plugin_id":"project-checklist","tasks":[],"tools":[{"description":"按状态或里程碑读取当前项目已登记的待办事项与完成率。","id":"checklist.list","input_schema":{"additionalProperties":false,"properties":{"milestone":{"maxLength":48,"type":"string"},"state":{"enum":["todo","doing","done"],"type":"string"}},"required":[],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"completion_pct":{"maximum":100,"minimum":0,"type":"integer"},"items":{"items":{"additionalProperties":false,"properties":{"id":{"maxLength":48,"minLength":1,"type":"string"},"milestone":{"maxLength":48,"type":"string"},"priority":{"enum":["high","medium","low"],"type":"string"},"state":{"enum":["todo","doing","done"],"type":"string"},"title":{"maxLength":120,"minLength":1,"type":"string"}},"required":["id","title","milestone","priority","state"],"type":"object"},"type":"array"},"status":{"enum":["ready","storage_error"],"type":"string"},"success":{"type":"boolean"}},"required":["success","status","items"],"type":"object"},"permissions":["data.read"],"title":"查询当前项目任务清单"},{"description":"向当前项目的任务清单追加一条新的待办事项，支持指定里程碑、优先级和备注。","id":"checklist.add","input_schema":{"additionalProperties":false,"properties":{"milestone":{"maxLength":48,"type":"string"},"note":{"maxLength":300,"type":"string"},"priority":{"enum":["high","medium","low"],"type":"string"},"title":{"maxLength":120,"minLength":1,"type":"string"}},"required":["title"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"id":{"maxLength":48,"type":"string"},"status":{"enum":["saved","conflict","limit","invalid_input"],"type":"string"},"success":{"type":"boolean"}},"required":["success","status"],"type":"object"},"permissions":["data.read","data.write"],"title":"登记项目待办任务"}],"ui":{"icon":"table","surfaces":["workspace","chat"]},"version":"1.0.0"},"version":1}