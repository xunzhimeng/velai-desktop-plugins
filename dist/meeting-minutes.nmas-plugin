{"files":[{"content":"const COLLECTION = 'minutes';\nconst KEY = 'notebook';\nconst MAX_BYTES = 12 * 1024;\nconst MAX_MEETINGS = 32;\n\nfunction jsonBytes(v) {\n  let b = 0;\n  for (const ch of JSON.stringify(v)) {\n    const cp = ch.codePointAt(0);\n    b += cp <= 0x7f ? 1 : cp <= 0x7ff ? 2 : cp <= 0xffff ? 3 : 4;\n  }\n  return b;\n}\n\nasync function readNotebook() {\n  const receipt = await globalThis.nmas.data.read({ collection: COLLECTION, key: KEY });\n  const doc = receipt.value === null ? { schema_version: 1, meetings: [] } : receipt.value;\n  if (!doc || doc.schema_version !== 1 || !Array.isArray(doc.meetings)) {\n    throw new Error('会议纪要数据格式无效');\n  }\n  return { revision: receipt.revision, meetings: doc.meetings };\n}\n\nasync function writeNotebook(expectedRevision, meetings) {\n  const value = { schema_version: 1, meetings };\n  if (meetings.length > MAX_MEETINGS || jsonBytes(value) > MAX_BYTES) {\n    return { status: 'limit', revision: expectedRevision };\n  }\n  try {\n    const receipt = await globalThis.nmas.data.write({\n      collection: COLLECTION,\n      key: KEY,\n      expected_revision: expectedRevision,\n      value,\n    });\n    return { status: 'saved', revision: receipt.revision };\n  } catch (err) {\n    if (err?.code === 'conflict' && err.outcome_unknown === false) {\n      return { status: 'conflict', revision: expectedRevision };\n    }\n    throw err;\n  }\n}\n\nexport default async function (request) {\n  const { kind, contribution, input } = request ?? {};\n\n  if (kind === 'action') {\n    if (contribution === 'minutes.read') return readNotebook();\n\n    if (contribution === 'minutes.save') {\n      const { expected_revision, id, title, date, attendees, raw_notes, summary } = input;\n      if (!title.trim() || !/^\\d{4}-\\d{2}-\\d{2}$/.test(date) || !/^[a-zA-Z0-9._-]+$/.test(id)) {\n        return { status: 'invalid_input', revision: expected_revision };\n      }\n      const book = await readNotebook();\n      if (book.revision !== expected_revision) return { status: 'conflict', revision: book.revision };\n      const record = {\n        id,\n        title: title.trim(),\n        date,\n        attendees: attendees.trim(),\n        raw_notes: raw_notes.trim(),\n        summary: summary.trim(),\n      };\n      const exists = book.meetings.some(m => m.id === id);\n      const next = exists ? book.meetings.map(m => (m.id === id ? record : m)) : [record, ...book.meetings];\n      return writeNotebook(expected_revision, next);\n    }\n\n    if (contribution === 'minutes.delete') {\n      const book = await readNotebook();\n      if (book.revision !== input.expected_revision) return { status: 'conflict', revision: book.revision };\n      if (!book.meetings.some(m => m.id === input.id)) return { status: 'not_found', revision: book.revision };\n      const res = await writeNotebook(input.expected_revision, book.meetings.filter(m => m.id !== input.id));\n      return res.status === 'saved' ? { status: 'deleted', revision: res.revision } : { status: 'conflict', revision: res.revision };\n    }\n  }\n\n  if (kind === 'tool' && contribution === 'minutes.list') {\n    const book = await readNotebook();\n    const kw = (input.keyword || '').trim().toLowerCase();\n    const matched = book.meetings\n      .filter(m => !kw || `${m.title} ${m.date} ${m.attendees} ${m.summary} ${m.raw_notes}`.toLowerCase().includes(kw))\n      .map(({ id, title, date, attendees, summary }) => ({ id, title, date, attendees, summary }));\n    return { success: true, status: 'ready', meetings: matched.slice(0, 10) };\n  }\n\n  throw new Error(`不支持的调用: ${kind}/${contribution}`);\n}\n","path":"backend/index.js"},{"content":"<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>会议纪要工作台</title>\n  <style>\n    :root {\n      color-scheme: light dark;\n      --bg: Canvas; --fg: CanvasText; --muted: color-mix(in srgb, CanvasText 60%, transparent);\n      --border: color-mix(in srgb, CanvasText 18%, transparent);\n      --card: color-mix(in srgb, CanvasText 4%, Canvas);\n      --accent: #2563eb; --ok: #16a34a; --danger: #dc2626;\n      font: 14px/1.55 system-ui, -apple-system, sans-serif;\n    }\n    * { box-sizing: border-box; }\n    body { margin: 0; background: var(--bg); color: var(--fg); }\n    main { max-width: 960px; margin: 0 auto; padding: clamp(12px, 2.5vw, 20px); display: flex; flex-direction: column; gap: 12px; }\n    header, .row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: space-between; }\n    h1 { font-size: 18px; margin: 0; }\n    h2 { font-size: 14px; margin: 0; }\n    .grid { display: grid; grid-template-columns: minmax(200px, 250px) minmax(0, 1fr); gap: 14px; }\n    @media (max-width: 680px) { .grid { grid-template-columns: 1fr; } }\n    .panel { border: 1px solid var(--border); border-radius: 10px; padding: 12px; background: var(--card); display: flex; flex-direction: column; gap: 10px; }\n    .list { display: flex; flex-direction: column; gap: 6px; max-height: 440px; overflow: auto; }\n    .item { text-align: left; width: 100%; border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; background: var(--bg); color: var(--fg); cursor: pointer; }\n    .item.active { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }\n    label { display: flex; flex-direction: column; gap: 4px; font-size: 13px; font-weight: 600; }\n    input, textarea, button { font: inherit; color: inherit; border: 1px solid var(--border); border-radius: 7px; padding: 6px 10px; background: var(--bg); }\n    textarea { min-height: 110px; resize: vertical; }\n    button { cursor: pointer; }\n    button.primary { background: var(--accent); border-color: var(--accent); color: #fff; }\n    button.danger { color: var(--danger); }\n    button:disabled { opacity: 0.55; cursor: not-allowed; }\n    .ai-box { border-top: 1px dashed var(--border); padding-top: 10px; display: flex; flex-direction: column; gap: 8px; }\n    pre { margin: 0; white-space: pre-wrap; word-break: break-word; padding: 8px 10px; border: 1px solid var(--border); border-radius: 8px; background: var(--bg); font: inherit; }\n    .status { font-size: 13px; color: var(--muted); margin: 0; }\n    .status[data-error=\"true\"] { color: var(--danger); }\n    [hidden] { display: none !important; }\n  </style>\n</head>\n<body>\n  <main>\n    <header>\n      <h1>会议纪要工作台</h1>\n      <button id=\"btn-new\" class=\"primary\" type=\"button\">+ 新建会议</button>\n    </header>\n    <p id=\"status\" class=\"status\" role=\"status\">正在加载会议记录…</p>\n    <div class=\"grid\">\n      <section class=\"panel\">\n        <h2>会议列表 (<span id=\"count\">0</span>)</h2>\n        <div id=\"list\" class=\"list\"></div>\n      </section>\n      <section class=\"panel\">\n        <div class=\"row\">\n          <h2 id=\"heading\">会议详情</h2>\n          <div class=\"row\">\n            <button id=\"btn-save\" class=\"primary\" type=\"button\">保存</button>\n            <button id=\"btn-del\" class=\"danger\" type=\"button\" hidden>删除</button>\n          </div>\n        </div>\n        <div class=\"row\">\n          <label style=\"flex:1;min-width:160px\">会议主题 <input id=\"f-title\" maxlength=\"100\" placeholder=\"例如：桌面端插件生态评审会\"></label>\n          <label style=\"width:140px\">日期 <input id=\"f-date\" type=\"date\"></label>\n        </div>\n        <label>参会人 <input id=\"f-attendees\" maxlength=\"160\" placeholder=\"例如：张三、李四、王五\"></label>\n        <label>原始速记 <textarea id=\"f-raw\" maxlength=\"3072\" placeholder=\"记录会议要点、讨论分歧、临时决定…\"></textarea></label>\n        <div class=\"row\">\n          <button id=\"btn-extract\" class=\"primary\" type=\"button\">交给当前会话提炼纪要与行动项</button>\n          <button id=\"btn-check\" type=\"button\" hidden>核对提炼结果</button>\n        </div>\n        <div id=\"ai-box\" class=\"ai-box\" hidden>\n          <p id=\"ai-state\" class=\"status\"></p>\n          <pre id=\"ai-preview\" hidden></pre>\n          <div class=\"row\">\n            <button id=\"btn-adopt\" class=\"primary\" type=\"button\" hidden>采纳并写入下方纪要</button>\n          </div>\n        </div>\n        <label>结构化纪要与行动项 <textarea id=\"f-summary\" maxlength=\"3072\" placeholder=\"可手动编写，或点击上方按钮由当前会话提炼后采纳\"></textarea></label>\n      </section>\n    </div>\n  </main>\n  <script>\n    (() => {\n      const plugin = globalThis.nmasPlugin;\n      const $ = id => document.getElementById(id);\n      let revision = 0, meetings = [], activeId = null, busy = false, pendingWorkId = null, latestSuggestion = '';\n      const today = () => new Date().toISOString().slice(0, 10);\n      const setStatus = (t, err = false) => { $('status').textContent = t; $('status').dataset.error = String(err); };\n\n      function uuid() {\n        const b = crypto.getRandomValues(new Uint8Array(16));\n        b[6] = (b[6] & 0x0f) | 0x40;\n        b[8] = (b[8] & 0x3f) | 0x80;\n        const h = Array.from(b, x => x.toString(16).padStart(2, '0')).join('');\n        return `${h.slice(0, 8)}-${h.slice(8, 12)}-${h.slice(12, 16)}-${h.slice(16, 20)}-${h.slice(20)}`;\n      }\n\n      function select(id) {\n        activeId = id;\n        const m = meetings.find(x => x.id === id);\n        $('heading').textContent = m ? m.title : '新建会议';\n        $('f-title').value = m?.title ?? '';\n        $('f-date').value = m?.date ?? today();\n        $('f-attendees').value = m?.attendees ?? '';\n        $('f-raw').value = m?.raw_notes ?? '';\n        $('f-summary').value = m?.summary ?? '';\n        $('btn-del').hidden = !m;\n        renderList();\n      }\n\n      function renderList() {\n        $('count').textContent = String(meetings.length);\n        const box = $('list');\n        box.replaceChildren();\n        if (!meetings.length) {\n          const p = document.createElement('p');\n          p.className = 'status';\n          p.textContent = '暂无会议记录';\n          box.appendChild(p);\n          return;\n        }\n        for (const m of meetings) {\n          const btn = document.createElement('button');\n          btn.type = 'button';\n          btn.className = `item${m.id === activeId ? ' active' : ''}`;\n          const t = document.createElement('strong');\n          t.textContent = m.title;\n          const d = document.createElement('div');\n          d.className = 'status';\n          d.textContent = `${m.date}${m.summary ? ' · 已整理' : ' · 草稿'}`;\n          btn.append(t, d);\n          btn.addEventListener('click', () => select(m.id));\n          box.appendChild(btn);\n        }\n      }\n\n      async function load(preferId) {\n        if (typeof plugin?.action !== 'function') { setStatus('请在 Velai Desktop 中打开此插件。', true); return; }\n        try {\n          const res = await plugin.action('minutes.read', {});\n          revision = res.revision;\n          meetings = res.meetings;\n          select(preferId && meetings.some(m => m.id === preferId) ? preferId : (meetings[0]?.id ?? null));\n          setStatus(`已加载 ${meetings.length} 场会议（修订 #${revision}）`);\n        } catch (e) { setStatus(`读取失败：${e?.message || '未知错误'}`, true); }\n      }\n\n      async function saveCurrent() {\n        if (busy) return false;\n        const title = $('f-title').value.trim();\n        const date = $('f-date').value || today();\n        if (!title) { setStatus('请填写会议主题。', true); return false; }\n        busy = true;\n        try {\n          const id = activeId || `mt-${Date.now().toString(36)}`;\n          const res = await plugin.action('minutes.save', {\n            expected_revision: revision,\n            id,\n            title,\n            date,\n            attendees: $('f-attendees').value,\n            raw_notes: $('f-raw').value,\n            summary: $('f-summary').value,\n          });\n          if (res.status === 'saved') {\n            await load(id);\n            setStatus('会议记录已保存。');\n            return true;\n          }\n          setStatus(`保存未完成：${res.status}`, true);\n          return false;\n        } catch (e) {\n          setStatus(`保存失败：${e?.message || '未知错误'}`, true);\n          return false;\n        } finally { busy = false; }\n      }\n\n      $('btn-new').addEventListener('click', () => { select(null); $('f-title').focus(); });\n      $('btn-save').addEventListener('click', () => void saveCurrent());\n      $('btn-del').addEventListener('click', async () => {\n        if (busy || !activeId) return;\n        busy = true;\n        try {\n          const res = await plugin.action('minutes.delete', { expected_revision: revision, id: activeId });\n          if (res.status === 'deleted') { await load(); setStatus('已删除会议记录。'); }\n          else setStatus(`删除未完成：${res.status}`, true);\n        } catch (e) { setStatus(`删除失败：${e?.message || '未知错误'}`, true); }\n        finally { busy = false; }\n      });\n\n      $('btn-extract').addEventListener('click', async () => {\n        const raw = $('f-raw').value.trim();\n        if (!raw) { setStatus('请先填写原始速记再交给会话提炼。', true); return; }\n        const prompt = `请把下面的会议速记整理为结构化纪要，包含：1. 核心结论；2. 行动项（负责人/事项/截止时间）；3. 待跟进风险。仅输出整理后的纯文本内容。\\n\\n会议主题：${$('f-title').value.trim() || '未命名会议'}\\n参会人：${$('f-attendees').value.trim() || '未填写'}\\n\\n原始速记：\\n${raw}`;\n        if (Array.from(prompt).length > 2048) { setStatus('速记过长，请精简至 1800 字以内。', true); return; }\n        pendingWorkId = uuid();\n        latestSuggestion = '';\n        $('ai-box').hidden = false;\n        $('ai-preview').hidden = true;\n        $('btn-adopt').hidden = true;\n        $('btn-check').hidden = false;\n        $('ai-state').textContent = '正在向当前会话派发提炼请求…';\n        try {\n          await plugin.action('session.turn.request', { prompt, work_id: pendingWorkId });\n          $('ai-state').textContent = '已派发给当前会话，请等待回复完成后点击「核对提炼结果」。';\n        } catch (e) {\n          $('ai-state').textContent = e?.message === 'cancelled'\n            ? '已取消派发，请先在宿主中选择一个会话。'\n            : `派发未确认（${e?.message || 'unknown'}），请到原会话核对。`;\n        }\n      });\n\n      $('btn-check').addEventListener('click', async () => {\n        if (!pendingWorkId) return;\n        $('ai-state').textContent = '正在核对会话结果…';\n        try {\n          const r = await plugin.action('session.turn.result', { work_id: pendingWorkId });\n          if (r.state === 'completed' && !r.truncated && typeof r.text === 'string' && r.text.trim()) {\n            latestSuggestion = r.text.trim();\n            $('ai-state').textContent = '已取得完整提炼结果，确认无误后点击采纳。';\n            $('ai-preview').textContent = latestSuggestion;\n            $('ai-preview').hidden = false;\n            $('btn-adopt').hidden = false;\n          } else {\n            $('ai-state').textContent = `当前状态：${r.state}${r.truncated ? '（内容被截断，请回原会话查看）' : ''}`;\n          }\n        } catch (e) {\n          $('ai-state').textContent = `核对失败：${e?.message || '请回到原会话查看'}`;\n        }\n      });\n\n      $('btn-adopt').addEventListener('click', async () => {\n        if (!latestSuggestion) return;\n        $('f-summary').value = latestSuggestion.slice(0, 3072);\n        const ok = await saveCurrent();\n        if (ok) {\n          pendingWorkId = null;\n          latestSuggestion = '';\n          $('ai-box').hidden = true;\n          $('btn-check').hidden = true;\n        }\n      });\n\n      void load();\n    })();\n  </script>\n</body>\n</html>\n","path":"ui/index.html"}],"format":"nmas-plugin","manifest":{"actions":[{"id":"minutes.read","input_schema":{"additionalProperties":false,"properties":{},"required":[],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"meetings":{"items":{"additionalProperties":false,"properties":{"attendees":{"maxLength":160,"type":"string"},"date":{"maxLength":10,"minLength":10,"type":"string"},"id":{"maxLength":48,"minLength":1,"type":"string"},"raw_notes":{"maxLength":3072,"type":"string"},"summary":{"maxLength":3072,"type":"string"},"title":{"maxLength":100,"minLength":1,"type":"string"}},"required":["id","title","date","attendees","raw_notes","summary"],"type":"object"},"type":"array"},"revision":{"maximum":9007199254740991,"minimum":0,"type":"integer"}},"required":["revision","meetings"],"type":"object"},"permissions":["data.read"],"title":"读取会议纪要列表"},{"id":"minutes.save","input_schema":{"additionalProperties":false,"properties":{"attendees":{"maxLength":160,"type":"string"},"date":{"maxLength":10,"minLength":10,"type":"string"},"expected_revision":{"maximum":9007199254740990,"minimum":0,"type":"integer"},"id":{"maxLength":48,"minLength":1,"type":"string"},"raw_notes":{"maxLength":3072,"type":"string"},"summary":{"maxLength":3072,"type":"string"},"title":{"maxLength":100,"minLength":1,"type":"string"}},"required":["expected_revision","id","title","date","attendees","raw_notes","summary"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"revision":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"status":{"enum":["saved","conflict","limit","invalid_input"],"type":"string"}},"required":["status","revision"],"type":"object"},"permissions":["data.read","data.write"],"title":"保存会议记录"},{"id":"minutes.delete","input_schema":{"additionalProperties":false,"properties":{"expected_revision":{"maximum":9007199254740990,"minimum":0,"type":"integer"},"id":{"maxLength":48,"minLength":1,"type":"string"}},"required":["expected_revision","id"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"revision":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"status":{"enum":["deleted","not_found","conflict"],"type":"string"}},"required":["status","revision"],"type":"object"},"permissions":["data.read","data.write"],"title":"删除会议记录"},{"id":"session.turn.request","input_schema":{"additionalProperties":false,"properties":{"prompt":{"maxLength":2048,"minLength":1,"type":"string"},"work_id":{"maxLength":36,"minLength":36,"type":"string"}},"required":["prompt","work_id"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"state":{"enum":["dispatching"],"type":"string"},"task_id":{"maxLength":36,"minLength":36,"type":"string"}},"required":["task_id","state"],"type":"object"},"permissions":["tasks.start"],"title":"交给当前会话提炼纪要"},{"id":"session.turn.result","input_schema":{"additionalProperties":false,"properties":{"work_id":{"maxLength":36,"minLength":36,"type":"string"}},"required":["work_id"],"type":"object"},"output_schema":{"additionalProperties":true,"properties":{"state":{"enum":["dispatching","running","waiting","completed","cancelled","failed","unknown","unavailable"],"type":"string"},"truncated":{"type":"boolean"},"work_id":{"maxLength":36,"minLength":36,"type":"string"}},"required":["work_id","state","truncated"],"type":"object"},"permissions":["tasks.read"],"title":"核对纪要提炼结果"}],"backend":"backend/index.js","data":[{"collection":"minutes","schema_version":1,"scope":"account"}],"files":[{"path":"backend/index.js","sha256":"5ce9d3ae6b062c19e1486cab65b2d98e3897dc18ff916414392ebbf3b7a08f51"},{"path":"ui/index.html","sha256":"e3463b7f4cce4364df2306999f2d9ac19eb187ad6a364b9b796d49b1528f9362"}],"host_api":1,"http":[],"manifest_version":1,"name":"会议纪要工作台","page":"ui/index.html","permissions":["data.read","data.write","tasks.start","tasks.read","tasks.cancel"],"plugin_id":"meeting-minutes","tasks":[],"tools":[{"description":"按关键词检索已保存的会议主题、日期、参会人与结构化纪要摘要。","id":"minutes.list","input_schema":{"additionalProperties":false,"properties":{"keyword":{"maxLength":64,"type":"string"}},"required":[],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"meetings":{"items":{"additionalProperties":false,"properties":{"attendees":{"maxLength":160,"type":"string"},"date":{"maxLength":10,"minLength":10,"type":"string"},"id":{"maxLength":48,"minLength":1,"type":"string"},"summary":{"maxLength":3072,"type":"string"},"title":{"maxLength":100,"minLength":1,"type":"string"}},"required":["id","title","date","attendees","summary"],"type":"object"},"type":"array"},"status":{"enum":["ready","storage_error"],"type":"string"},"success":{"type":"boolean"}},"required":["success","status","meetings"],"type":"object"},"permissions":["data.read"],"title":"查询历史会议纪要"}],"ui":{"icon":"chat","surfaces":["workspace","chat","assistant"]},"version":"1.0.0"},"version":1}