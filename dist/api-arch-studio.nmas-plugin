{"files":[{"content":"const COL_SERVICES = 'services';\nconst COL_ENDPOINTS = 'endpoints';\nconst COL_SCHEMAS = 'schemas';\nconst KEY_INDEX = 'index';\nconst DOC_FORMAT = 'velai-api-arch-studio';\n\nconst MAX_RECORD_BYTES = 240 * 1024;\nconst MAX_CODE_BYTES = 220 * 1024;\nconst MAX_SERVICES = 48;\nconst MAX_EDGES = 96;\nconst MAX_ENDPOINTS = 64;\nconst MAX_SCHEMAS = 48;\n\nconst ID_RE = /^[a-zA-Z0-9._-]+$/;\nconst SVC_KINDS = ['gateway', 'service', 'db', 'queue', 'external'];\nconst PROTOCOLS = ['HTTP', 'gRPC', 'Event', 'SQL', 'Cache'];\nconst METHODS = ['GET', 'POST', 'PUT', 'PATCH', 'DELETE'];\nconst AUTHS = ['none', 'bearer', 'api_key', 'mtls', 'oauth2'];\nconst STATUSES = ['draft', 'review', 'stable', 'deprecated'];\nconst SCHEMA_KINDS = ['dto', 'entity', 'event', 'error'];\nconst FIELD_TYPES = ['string', 'integer', 'number', 'boolean', 'object', 'array'];\nconst PARAM_INS = ['path', 'query', 'header'];\nconst PARAM_TYPES = ['string', 'integer', 'number', 'boolean'];\n\nfunction jsonBytes(v) {\n  let b = 0;\n  for (const ch of JSON.stringify(v)) {\n    const cp = ch.codePointAt(0);\n    b += cp <= 0x7f ? 1 : cp <= 0x7ff ? 2 : cp <= 0xffff ? 3 : 4;\n  }\n  return b;\n}\n\nfunction utf8Bytes(str) {\n  let b = 0;\n  for (const ch of str) {\n    const cp = ch.codePointAt(0);\n    b += cp <= 0x7f ? 1 : cp <= 0x7ff ? 2 : cp <= 0xffff ? 3 : 4;\n  }\n  return b;\n}\n\nfunction truncateUtf8(str, maxBytes) {\n  if (utf8Bytes(str) <= maxBytes) return { text: str, truncated: false };\n  let out = '';\n  let b = 0;\n  for (const ch of str) {\n    const cp = ch.codePointAt(0);\n    const cb = cp <= 0x7f ? 1 : cp <= 0x7ff ? 2 : cp <= 0xffff ? 3 : 4;\n    if (b + cb > maxBytes - 32) break;\n    out += ch;\n    b += cb;\n  }\n  return { text: out, truncated: true };\n}\n\nfunction round1(n) {\n  return Math.round(n * 10) / 10;\n}\n\n/**\n * Tarjan SCC + Cycle Path & Coupling Analyzer\n */\nfunction analyzeTopology(services, edges, endpoints) {\n  const svcIds = new Set(services.map(s => s.id));\n  const validEdges = edges.filter(e => svcIds.has(e.from) && svcIds.has(e.to));\n\n  const adj = new Map();\n  const fanIn = new Map();\n  const fanOut = new Map();\n  const epCount = new Map();\n  for (const s of services) {\n    adj.set(s.id, []);\n    fanIn.set(s.id, 0);\n    fanOut.set(s.id, 0);\n    epCount.set(s.id, 0);\n  }\n  for (const e of validEdges) {\n    adj.get(e.from).push(e);\n    fanOut.set(e.from, fanOut.get(e.from) + 1);\n    fanIn.set(e.to, fanIn.get(e.to) + 1);\n  }\n  for (const ep of endpoints) {\n    if (epCount.has(ep.service_id)) epCount.set(ep.service_id, epCount.get(ep.service_id) + 1);\n  }\n\n  // Tarjan's SCC algorithm\n  let idx = 0;\n  const indexMap = new Map();\n  const lowlink = new Map();\n  const onStack = new Set();\n  const stack = [];\n  const sccs = [];\n\n  function strongConnect(v) {\n    indexMap.set(v, idx);\n    lowlink.set(v, idx);\n    idx += 1;\n    stack.push(v);\n    onStack.add(v);\n\n    for (const e of adj.get(v) || []) {\n      const w = e.to;\n      if (!indexMap.has(w)) {\n        strongConnect(w);\n        lowlink.set(v, Math.min(lowlink.get(v), lowlink.get(w)));\n      } else if (onStack.has(w)) {\n        lowlink.set(v, Math.min(lowlink.get(v), indexMap.get(w)));\n      }\n    }\n\n    if (lowlink.get(v) === indexMap.get(v)) {\n      const comp = [];\n      while (stack.length > 0) {\n        const w = stack.pop();\n        onStack.delete(w);\n        comp.push(w);\n        if (w === v) break;\n      }\n      sccs.push(comp);\n    }\n  }\n\n  for (const s of services) {\n    if (!indexMap.has(s.id)) strongConnect(s.id);\n  }\n\n  const inCycleNodes = new Set();\n  const cycleEdgeIds = new Set();\n  const cycles = [];\n\n  for (const comp of sccs) {\n    const compSet = new Set(comp);\n    const hasSelfLoop = comp.length === 1 && (adj.get(comp[0]) || []).some(e => e.to === comp[0]);\n    if (comp.length > 1 || hasSelfLoop) {\n      for (const n of comp) inCycleNodes.add(n);\n      for (const e of validEdges) {\n        if (compSet.has(e.from) && compSet.has(e.to)) cycleEdgeIds.add(e.id);\n      }\n      // Extract a clean representative cycle path inside this SCC\n      if (hasSelfLoop) {\n        cycles.push([comp[0], comp[0]]);\n      } else {\n        const start = comp[comp.length - 1];\n        const path = [start];\n        const visited = new Set([start]);\n        let curr = start;\n        let closed = false;\n        for (let step = 0; step <= comp.length; step++) {\n          const outEdges = (adj.get(curr) || []).filter(e => compSet.has(e.to));\n          const closeEdge = outEdges.find(e => e.to === start);\n          if (closeEdge && path.length > 1) {\n            path.push(start);\n            closed = true;\n            break;\n          }\n          const nextEdge = outEdges.find(e => !visited.has(e.to));\n          if (!nextEdge) break;\n          curr = nextEdge.to;\n          visited.add(curr);\n          path.push(curr);\n        }\n        if (!closed) path.push(start);\n        cycles.push(path);\n      }\n    }\n  }\n\n  const warnings = [];\n  for (const cyc of cycles) {\n    warnings.push(`检测到循环依赖路径: ${cyc.join(' -> ')}`);\n  }\n  for (const s of services) {\n    const fo = fanOut.get(s.id) || 0;\n    const fi = fanIn.get(s.id) || 0;\n    if (fo >= 4) warnings.push(`高扇出耦合: ${s.name} (${s.id}) 依赖 ${fo} 个下游服务`);\n    if (fi >= 4 && s.kind !== 'db' && s.kind !== 'queue') {\n      warnings.push(`高扇入热点: ${s.name} (${s.id}) 被 ${fi} 个上游调用`);\n    }\n  }\n  const deprecatedCount = endpoints.filter(ep => ep.status === 'deprecated').length;\n  if (deprecatedCount > 0) {\n    warnings.push(`存在 ${deprecatedCount} 个已弃用 (deprecated) 接口待下线`);\n  }\n\n  const metrics = services.map(s => ({\n    service_id: s.id,\n    fan_in: fanIn.get(s.id) || 0,\n    fan_out: fanOut.get(s.id) || 0,\n    endpoint_count: epCount.get(s.id) || 0,\n    in_cycle: inCycleNodes.has(s.id),\n  }));\n\n  const stableCount = endpoints.filter(ep => ep.status === 'stable').length;\n  const stable_ratio = endpoints.length === 0 ? 0 : round1((stableCount / endpoints.length) * 100);\n\n  return {\n    metrics,\n    cycles,\n    cycle_edge_ids: Array.from(cycleEdgeIds),\n    warnings: warnings.slice(0, 12),\n    stable_ratio,\n  };\n}\n\n/**\n * OpenAPI 3.0.3 JSON & TypeScript Interface Compiler\n */\nfunction compileOpenApi(services, endpoints, schemas, serviceFilter) {\n  const svcMap = new Map(services.map(s => [s.id, s]));\n  const schemaMap = new Map(schemas.map(s => [s.id, s]));\n  const eps = serviceFilter ? endpoints.filter(e => e.service_id === serviceFilter) : endpoints;\n\n  const paths = {};\n  const usedSchemaIds = new Set();\n\n  function collectRefs(sid) {\n    if (!sid || !schemaMap.has(sid) || usedSchemaIds.has(sid)) return;\n    usedSchemaIds.add(sid);\n    const sc = schemaMap.get(sid);\n    for (const f of sc.fields) {\n      if (f.ref && schemaMap.has(f.ref)) collectRefs(f.ref);\n      if (f.item_type && schemaMap.has(f.item_type)) collectRefs(f.item_type);\n    }\n  }\n\n  for (const ep of eps) {\n    if (!paths[ep.path]) paths[ep.path] = {};\n    const svc = svcMap.get(ep.service_id);\n    const op = {\n      operationId: ep.id.replace(/[^a-zA-Z0-9_]/g, '_'),\n      summary: ep.summary,\n      tags: [svc ? svc.name : ep.service_id],\n    };\n    if (ep.status === 'deprecated') op.deprecated = true;\n    if (ep.auth && ep.auth !== 'none') op.security = [{ [ep.auth]: [] }];\n    if (ep.params.length > 0) {\n      op.parameters = ep.params.map(p => ({\n        name: p.name,\n        in: p.in,\n        required: p.in === 'path' ? true : p.required,\n        description: p.description || undefined,\n        schema: { type: p.type },\n      }));\n    }\n    if (ep.request_schema && schemaMap.has(ep.request_schema) && ep.method !== 'GET' && ep.method !== 'DELETE') {\n      collectRefs(ep.request_schema);\n      op.requestBody = {\n        required: true,\n        content: {\n          'application/json': { schema: { $ref: `#/components/schemas/${ep.request_schema}` } },\n        },\n      };\n    }\n    const responses = {\n      '200': ep.response_schema && schemaMap.has(ep.response_schema)\n        ? {\n            description: 'OK',\n            content: { 'application/json': { schema: { $ref: `#/components/schemas/${ep.response_schema}` } } },\n          }\n        : { description: 'OK' },\n    };\n    if (ep.response_schema && schemaMap.has(ep.response_schema)) collectRefs(ep.response_schema);\n    for (const err of ep.error_codes) {\n      responses[String(err.code)] = { description: err.message };\n    }\n    op.responses = responses;\n    paths[ep.path][ep.method.toLowerCase()] = op;\n  }\n\n  const targetSchemas = serviceFilter\n    ? schemas.filter(s => usedSchemaIds.has(s.id))\n    : schemas;\n\n  const compSchemas = {};\n  for (const sc of targetSchemas) {\n    const props = {};\n    const required = [];\n    for (const f of sc.fields) {\n      if (f.required) required.push(f.name);\n      if (f.ref && schemaMap.has(f.ref)) {\n        props[f.name] = { $ref: `#/components/schemas/${f.ref}` };\n      } else if (f.type === 'array') {\n        const itemSchema = f.item_type && schemaMap.has(f.item_type)\n          ? { $ref: `#/components/schemas/${f.item_type}` }\n          : { type: PARAM_TYPES.includes(f.item_type) ? f.item_type : 'string' };\n        props[f.name] = { type: 'array', items: itemSchema, description: f.description || undefined };\n      } else {\n        props[f.name] = { type: f.type, description: f.description || undefined };\n      }\n    }\n    compSchemas[sc.id] = {\n      type: 'object',\n      description: sc.description || undefined,\n      required: required.length > 0 ? required : undefined,\n      properties: props,\n    };\n  }\n\n  const spec = {\n    openapi: '3.0.3',\n    info: {\n      title: serviceFilter && svcMap.has(serviceFilter) ? `${svcMap.get(serviceFilter).name} API` : 'Project Architecture API',\n      version: '1.0.0',\n    },\n    paths,\n    components: {\n      securitySchemes: {\n        bearer: { type: 'http', scheme: 'bearer', bearerFormat: 'JWT' },\n        api_key: { type: 'apiKey', in: 'header', name: 'X-API-Key' },\n        mtls: { type: 'mutualTLS' },\n        oauth2: { type: 'oauth2', flows: { clientCredentials: { tokenUrl: '/oauth/token', scopes: {} } } },\n      },\n      schemas: compSchemas,\n    },\n  };\n\n  const { text, truncated } = truncateUtf8(JSON.stringify(spec, null, 2), MAX_CODE_BYTES);\n  return { code: text, endpoint_count: eps.length, schema_count: targetSchemas.length, truncated };\n}\n\nfunction tsTypeOf(f, schemaIds) {\n  if (f.ref && schemaIds.has(f.ref)) return f.ref;\n  if (f.type === 'integer' || f.type === 'number') return 'number';\n  if (f.type === 'boolean' || f.type === 'string') return f.type;\n  if (f.type === 'object') return 'Record<string, unknown>';\n  if (f.type === 'array') {\n    if (f.item_type && schemaIds.has(f.item_type)) return `${f.item_type}[]`;\n    if (f.item_type === 'integer' || f.item_type === 'number') return 'number[]';\n    if (f.item_type === 'boolean') return 'boolean[]';\n    return 'string[]';\n  }\n  return 'unknown';\n}\n\nfunction compileTypeScript(services, endpoints, schemas, serviceFilter) {\n  const schemaIds = new Set(schemas.map(s => s.id));\n  const eps = serviceFilter ? endpoints.filter(e => e.service_id === serviceFilter) : endpoints;\n  const lines = ['// Auto-generated by Velai API Arch Studio', ''];\n\n  for (const sc of schemas) {\n    if (sc.description) lines.push(`/** ${sc.name}: ${sc.description} */`);\n    lines.push(`export interface ${sc.id} {`);\n    for (const f of sc.fields) {\n      const comment = f.description ? ` // ${f.description}` : '';\n      lines.push(`  ${f.name}${f.required ? '' : '?'}: ${tsTypeOf(f, schemaIds)};${comment}`);\n    }\n    lines.push('}', '');\n  }\n\n  lines.push('export interface ApiContractMap {');\n  for (const ep of eps) {\n    const reqT = ep.request_schema && schemaIds.has(ep.request_schema) ? ep.request_schema : 'void';\n    const resT = ep.response_schema && schemaIds.has(ep.response_schema) ? ep.response_schema : 'void';\n    const paramsStr = ep.params.length\n      ? `{ ${ep.params.map(p => `${p.name}${p.required ? '' : '?'}: ${p.type === 'integer' || p.type === 'number' ? 'number' : p.type}`).join('; ')} }`\n      : 'never';\n    lines.push(`  /** [${ep.status}] ${ep.summary} (${ep.service_id}) */`);\n    lines.push(`  '${ep.method} ${ep.path}': { params: ${paramsStr}; request: ${reqT}; response: ${resT}; auth: '${ep.auth}' };`);\n  }\n  lines.push('}');\n\n  const { text, truncated } = truncateUtf8(lines.join('\\n'), MAX_CODE_BYTES);\n  return { code: text, endpoint_count: eps.length, schema_count: schemas.length, truncated };\n}\n\nfunction compileAdrMarkdown(services, edges, endpoints, analysis) {\n  const lines = [\n    '# 架构决策记录 (ADR) 与 API 拓扑快照',\n    `- 服务节点：${services.length} | 依赖边：${edges.length} | 接口契约：${endpoints.length} | 稳定接口占比：${analysis.stable_ratio}%`,\n    '',\n    '## 1. 服务分层拓扑',\n    ...(services.length\n      ? services.map(s => `- **${s.name}** (\\`${s.id}\\`, ${s.kind}, Tier ${s.tier}, Owner: ${s.owner || '-'}) — ${s.description || '无说明'}`)\n      : ['- （暂无服务节点）']),\n    '',\n    '## 2. 架构风险与循环依赖诊断',\n    ...(analysis.warnings.length\n      ? analysis.warnings.map(w => `- ⚠️ ${w}`)\n      : ['- ✅ 未检测到循环依赖或高耦合告警']),\n    '',\n    '## 3. API 契约目录',\n    '| Method | Path | Service | Auth | Status | Summary |',\n    '| --- | --- | --- | --- | --- | --- |',\n    ...endpoints.map(ep => `| ${ep.method} | \\`${ep.path}\\` | ${ep.service_id} | ${ep.auth} | ${ep.status} | ${ep.summary} |`),\n    '',\n  ];\n  return lines.join('\\n');\n}\n\nasync function readServicesDoc() {\n  const receipt = await globalThis.nmas.data.read({ collection: COL_SERVICES, key: KEY_INDEX });\n  const doc = receipt.value === null ? { schema_version: 1, services: [], edges: [] } : receipt.value;\n  if (!doc || doc.schema_version !== 1 || !Array.isArray(doc.services) || !Array.isArray(doc.edges)) {\n    throw new Error('服务拓扑数据格式无效');\n  }\n  return { revision: receipt.revision, services: doc.services, edges: doc.edges };\n}\n\nasync function readListDoc(collection, fieldName) {\n  const receipt = await globalThis.nmas.data.read({ collection, key: KEY_INDEX });\n  const doc = receipt.value === null ? { schema_version: 1, [fieldName]: [] } : receipt.value;\n  if (!doc || doc.schema_version !== 1 || !Array.isArray(doc[fieldName])) {\n    throw new Error(`集合 ${collection} 数据格式无效`);\n  }\n  return { revision: receipt.revision, items: doc[fieldName] };\n}\n\nasync function readAll() {\n  const s = await readServicesDoc();\n  const e = await readListDoc(COL_ENDPOINTS, 'endpoints');\n  const sc = await readListDoc(COL_SCHEMAS, 'schemas');\n  return {\n    revision: sc.revision,\n    services: s.services,\n    edges: s.edges,\n    endpoints: e.items,\n    schemas: sc.items,\n  };\n}\n\nasync function writeDoc(collection, expectedRevision, value) {\n  if (jsonBytes(value) > MAX_RECORD_BYTES) {\n    return { status: 'limit', revision: expectedRevision };\n  }\n  try {\n    const receipt = await globalThis.nmas.data.write({\n      collection,\n      key: KEY_INDEX,\n      expected_revision: expectedRevision,\n      value,\n    });\n    return { status: 'saved', revision: receipt.revision };\n  } catch (err) {\n    if (err?.code === 'conflict' && err.outcome_unknown === false) {\n      return { status: 'conflict', revision: expectedRevision };\n    }\n    throw err;\n  }\n}\n\nfunction sanitizeParams(params) {\n  if (!Array.isArray(params)) return [];\n  const out = [];\n  for (const p of params) {\n    if (!p || typeof p.name !== 'string' || !p.name.trim()) continue;\n    out.push({\n      name: p.name.trim().slice(0, 40),\n      in: PARAM_INS.includes(p.in) ? p.in : 'query',\n      type: PARAM_TYPES.includes(p.type) ? p.type : 'string',\n      required: Boolean(p.required),\n      description: typeof p.description === 'string' ? p.description.trim().slice(0, 100) : '',\n    });\n    if (out.length >= 10) break;\n  }\n  return out;\n}\n\nfunction sanitizeErrors(errs) {\n  if (!Array.isArray(errs)) return [];\n  const out = [];\n  for (const e of errs) {\n    if (!e || !Number.isInteger(e.code) || e.code < 400 || e.code > 599) continue;\n    const msg = typeof e.message === 'string' && e.message.trim() ? e.message.trim().slice(0, 80) : `HTTP ${e.code}`;\n    out.push({ code: e.code, message: msg });\n    if (out.length >= 8) break;\n  }\n  return out;\n}\n\nfunction sanitizeFields(fields) {\n  if (!Array.isArray(fields)) return [];\n  const out = [];\n  for (const f of fields) {\n    if (!f || typeof f.name !== 'string' || !f.name.trim()) continue;\n    out.push({\n      name: f.name.trim().slice(0, 40),\n      type: FIELD_TYPES.includes(f.type) ? f.type : 'string',\n      item_type: typeof f.item_type === 'string' ? f.item_type.trim().slice(0, 48) : '',\n      ref: typeof f.ref === 'string' ? f.ref.trim().slice(0, 48) : '',\n      required: Boolean(f.required),\n      description: typeof f.description === 'string' ? f.description.trim().slice(0, 100) : '',\n    });\n    if (out.length >= 16) break;\n  }\n  return out;\n}\n\nfunction buildDemoData() {\n  const services = [\n    { id: 'api-gateway', name: '统一 API 网关', kind: 'gateway', owner: 'Platform', description: '鉴权、限流、灰度路由与统一契约出口', tier: 0 },\n    { id: 'order-svc', name: '订单核心服务', kind: 'service', owner: 'Commerce', description: '订单状态机、幂等创建与取消编排', tier: 1 },\n    { id: 'risk-svc', name: '实时风控引擎', kind: 'service', owner: 'Trust', description: '反欺诈规则评分、设备指纹与黑名单拦截', tier: 1 },\n    { id: 'payment-svc', name: '支付清算服务', kind: 'service', owner: 'Fintech', description: '多渠道收单、预授权扣款与对账回调', tier: 2 },\n    { id: 'event-bus', name: '领域事件总线 Kafka', kind: 'queue', owner: 'Infra', description: '异步解耦订单、风控与履约领域事件', tier: 2 },\n    { id: 'order-db', name: '订单主库 PostgreSQL', kind: 'db', owner: 'DBA', description: '订单分库分表持久化与分布式事务表', tier: 3 },\n  ];\n\n  const edges = [\n    { id: 'e-gw-ord', from: 'api-gateway', to: 'order-svc', protocol: 'HTTP', label: '下单与查询路由' },\n    { id: 'e-gw-pay', from: 'api-gateway', to: 'payment-svc', protocol: 'HTTP', label: '支付状态查询' },\n    { id: 'e-ord-rsk', from: 'order-svc', to: 'risk-svc', protocol: 'gRPC', label: '同步下单风控评分' },\n    { id: 'e-rsk-ord', from: 'risk-svc', to: 'order-svc', protocol: 'gRPC', label: '回查近24h历史订单(环依赖)' },\n    { id: 'e-ord-pay', from: 'order-svc', to: 'payment-svc', protocol: 'gRPC', label: '发起支付扣款' },\n    { id: 'e-ord-db', from: 'order-svc', to: 'order-db', protocol: 'SQL', label: '订单主表读写' },\n    { id: 'e-ord-bus', from: 'order-svc', to: 'event-bus', protocol: 'Event', label: 'OrderCreated 事件' },\n    { id: 'e-pay-bus', from: 'payment-svc', to: 'event-bus', protocol: 'Event', label: 'PaymentSettled 事件' },\n  ];\n\n  const schemas = [\n    {\n      id: 'CreateOrderReq',\n      name: '创建订单请求',\n      kind: 'dto',\n      description: '客户端下单幂等提交载荷',\n      fields: [\n        { name: 'idempotencyKey', type: 'string', item_type: '', ref: '', required: true, description: '幂等令牌 UUID' },\n        { name: 'userId', type: 'string', item_type: '', ref: '', required: true, description: '下单用户 ID' },\n        { name: 'skuIds', type: 'array', item_type: 'string', ref: '', required: true, description: '商品 SKU 列表' },\n        { name: 'amountCents', type: 'integer', item_type: '', ref: '', required: true, description: '订单总金额(分)' },\n      ],\n    },\n    {\n      id: 'OrderDTO',\n      name: '订单领域实体',\n      kind: 'entity',\n      description: '对外返回的标准化订单视图',\n      fields: [\n        { name: 'orderId', type: 'string', item_type: '', ref: '', required: true, description: '全局订单号' },\n        { name: 'status', type: 'string', item_type: '', ref: '', required: true, description: 'PENDING/PAID/CANCELLED' },\n        { name: 'amountCents', type: 'integer', item_type: '', ref: '', required: true, description: '实付金额(分)' },\n        { name: 'riskDecision', type: 'object', item_type: '', ref: 'RiskDecisionDTO', required: false, description: '风控决策快照' },\n      ],\n    },\n    {\n      id: 'RiskEvalReq',\n      name: '风控评估请求',\n      kind: 'dto',\n      description: '交易风控打分输入上下文',\n      fields: [\n        { name: 'userId', type: 'string', item_type: '', ref: '', required: true, description: '用户 ID' },\n        { name: 'amountCents', type: 'integer', item_type: '', ref: '', required: true, description: '交易金额(分)' },\n        { name: 'deviceFingerprint', type: 'string', item_type: '', ref: '', required: true, description: '设备指纹哈希' },\n      ],\n    },\n    {\n      id: 'RiskDecisionDTO',\n      name: '风控决策结果',\n      kind: 'event',\n      description: '实时风控引擎返回的评分与处置动作',\n      fields: [\n        { name: 'action', type: 'string', item_type: '', ref: '', required: true, description: 'ALLOW/CHALLENGE/REJECT' },\n        { name: 'score', type: 'number', item_type: '', ref: '', required: true, description: '风险分 0~100' },\n        { name: 'hitRules', type: 'array', item_type: 'string', ref: '', required: false, description: '命中的规则编号' },\n      ],\n    },\n  ];\n\n  const endpoints = [\n    {\n      id: 'ep-order-create',\n      service_id: 'order-svc',\n      method: 'POST',\n      path: '/v1/orders',\n      summary: '幂等创建电商订单',\n      auth: 'bearer',\n      status: 'stable',\n      params: [{ name: 'X-Trace-Id', in: 'header', type: 'string', required: false, description: '全链路追踪 ID' }],\n      request_schema: 'CreateOrderReq',\n      response_schema: 'OrderDTO',\n      error_codes: [\n        { code: 409, message: '重复幂等键冲突' },\n        { code: 422, message: '风控策略拦截拒绝下单' },\n      ],\n    },\n    {\n      id: 'ep-order-get',\n      service_id: 'order-svc',\n      method: 'GET',\n      path: '/v1/orders/{orderId}',\n      summary: '按订单号查询订单详情',\n      auth: 'bearer',\n      status: 'stable',\n      params: [{ name: 'orderId', in: 'path', type: 'string', required: true, description: '订单 ID' }],\n      request_schema: '',\n      response_schema: 'OrderDTO',\n      error_codes: [{ code: 404, message: '订单不存在' }],\n    },\n    {\n      id: 'ep-order-cancel',\n      service_id: 'order-svc',\n      method: 'PATCH',\n      path: '/v1/orders/{orderId}/cancel',\n      summary: '取消未支付订单并释放库存',\n      auth: 'bearer',\n      status: 'review',\n      params: [{ name: 'orderId', in: 'path', type: 'string', required: true, description: '订单 ID' }],\n      request_schema: '',\n      response_schema: 'OrderDTO',\n      error_codes: [{ code: 409, message: '订单已进入清算阶段不可取消' }],\n    },\n    {\n      id: 'ep-risk-eval',\n      service_id: 'risk-svc',\n      method: 'POST',\n      path: '/v1/risk/evaluate',\n      summary: '执行交易实时风控评分',\n      auth: 'mtls',\n      status: 'stable',\n      params: [],\n      request_schema: 'RiskEvalReq',\n      response_schema: 'RiskDecisionDTO',\n      error_codes: [{ code: 503, message: '特征服务超时降级' }],\n    },\n    {\n      id: 'ep-pay-charge',\n      service_id: 'payment-svc',\n      method: 'POST',\n      path: '/v1/payments/charge',\n      summary: '发起订单收单扣款',\n      auth: 'mtls',\n      status: 'stable',\n      params: [],\n      request_schema: 'CreateOrderReq',\n      response_schema: 'OrderDTO',\n      error_codes: [{ code: 402, message: '余额不足或渠道拒付' }],\n    },\n    {\n      id: 'ep-pay-status',\n      service_id: 'payment-svc',\n      method: 'GET',\n      path: '/v1/payments/{txId}/status',\n      summary: '查询支付流水实时清算状态',\n      auth: 'api_key',\n      status: 'draft',\n      params: [{ name: 'txId', in: 'path', type: 'string', required: true, description: '支付流水号' }],\n      request_schema: '',\n      response_schema: 'OrderDTO',\n      error_codes: [{ code: 404, message: '流水记录未找到' }],\n    },\n    {\n      id: 'ep-legacy-del',\n      service_id: 'api-gateway',\n      method: 'DELETE',\n      path: '/v0/orders/{orderId}',\n      summary: '旧版订单物理删除接口（计划下线）',\n      auth: 'oauth2',\n      status: 'deprecated',\n      params: [{ name: 'orderId', in: 'path', type: 'string', required: true, description: '旧版订单 ID' }],\n      request_schema: '',\n      response_schema: '',\n      error_codes: [{ code: 410, message: '接口即将移除' }],\n    },\n  ];\n\n  return { services, edges, endpoints, schemas };\n}\n\nexport default async function (request) {\n  const { kind, contribution, input } = request ?? {};\n\n  if (kind === 'action') {\n    if (contribution === 'arch.state') {\n      const all = await readAll();\n      return {\n        revision: all.revision,\n        services: all.services,\n        edges: all.edges,\n        endpoints: all.endpoints,\n        schemas: all.schemas,\n        analysis: analyzeTopology(all.services, all.edges, all.endpoints),\n      };\n    }\n\n    if (contribution === 'arch.service.save') {\n      const { expected_revision, id, name, kind: svcKind, owner, description, tier } = input;\n      if (!ID_RE.test(id) || !name.trim() || !SVC_KINDS.includes(svcKind)) {\n        return { status: 'invalid_input', revision: expected_revision };\n      }\n      const doc = await readServicesDoc();\n      if (doc.revision !== expected_revision) return { status: 'conflict', revision: doc.revision };\n      const exists = doc.services.some(s => s.id === id);\n      if (!exists && doc.services.length >= MAX_SERVICES) return { status: 'limit', revision: doc.revision };\n      const rec = {\n        id,\n        name: name.trim().slice(0, 60),\n        kind: svcKind,\n        owner: (owner || '').trim().slice(0, 40),\n        description: (description || '').trim().slice(0, 180),\n        tier: Number.isInteger(tier) ? Math.max(0, Math.min(4, tier)) : 1,\n      };\n      const nextServices = exists ? doc.services.map(s => (s.id === id ? rec : s)) : [...doc.services, rec];\n      return writeDoc(COL_SERVICES, expected_revision, { schema_version: 1, services: nextServices, edges: doc.edges });\n    }\n\n    if (contribution === 'arch.service.delete') {\n      const { expected_revision, id } = input;\n      const all = await readAll();\n      if (all.revision !== expected_revision) return { status: 'conflict', revision: all.revision };\n      if (!all.services.some(s => s.id === id)) return { status: 'not_found', revision: all.revision };\n      const nextServices = all.services.filter(s => s.id !== id);\n      const nextEdges = all.edges.filter(e => e.from !== id && e.to !== id);\n      const nextEndpoints = all.endpoints.filter(ep => ep.service_id !== id);\n\n      const r1 = await writeDoc(COL_SERVICES, expected_revision, { schema_version: 1, services: nextServices, edges: nextEdges });\n      if (r1.status !== 'saved') return { status: 'conflict', revision: r1.revision };\n      if (nextEndpoints.length !== all.endpoints.length) {\n        const r2 = await writeDoc(COL_ENDPOINTS, r1.revision, { schema_version: 1, endpoints: nextEndpoints });\n        if (r2.status !== 'saved') return { status: 'conflict', revision: r2.revision };\n        return { status: 'deleted', revision: r2.revision };\n      }\n      return { status: 'deleted', revision: r1.revision };\n    }\n\n    if (contribution === 'arch.edge.save') {\n      const { expected_revision, id, from, to, protocol, label } = input;\n      if (!ID_RE.test(id) || !PROTOCOLS.includes(protocol)) {\n        return { status: 'invalid_input', revision: expected_revision };\n      }\n      const doc = await readServicesDoc();\n      if (doc.revision !== expected_revision) return { status: 'conflict', revision: doc.revision };\n      const ids = new Set(doc.services.map(s => s.id));\n      if (!ids.has(from) || !ids.has(to)) return { status: 'service_not_found', revision: doc.revision };\n      const exists = doc.edges.some(e => e.id === id);\n      if (!exists && doc.edges.length >= MAX_EDGES) return { status: 'limit', revision: doc.revision };\n      const rec = { id, from, to, protocol, label: (label || '').trim().slice(0, 60) };\n      const nextEdges = exists ? doc.edges.map(e => (e.id === id ? rec : e)) : [...doc.edges, rec];\n      return writeDoc(COL_SERVICES, expected_revision, { schema_version: 1, services: doc.services, edges: nextEdges });\n    }\n\n    if (contribution === 'arch.edge.delete') {\n      const { expected_revision, id } = input;\n      const doc = await readServicesDoc();\n      if (doc.revision !== expected_revision) return { status: 'conflict', revision: doc.revision };\n      if (!doc.edges.some(e => e.id === id)) return { status: 'not_found', revision: doc.revision };\n      const nextEdges = doc.edges.filter(e => e.id !== id);\n      const r = await writeDoc(COL_SERVICES, expected_revision, { schema_version: 1, services: doc.services, edges: nextEdges });\n      return r.status === 'saved' ? { status: 'deleted', revision: r.revision } : { status: 'conflict', revision: r.revision };\n    }\n\n    if (contribution === 'arch.endpoint.save') {\n      const {\n        expected_revision, id, service_id, method, path, summary, auth, status,\n        params, request_schema, response_schema, error_codes,\n      } = input;\n      if (!ID_RE.test(id) || !METHODS.includes(method) || !path.startsWith('/') || !summary.trim() || !AUTHS.includes(auth) || !STATUSES.includes(status)) {\n        return { status: 'invalid_input', revision: expected_revision };\n      }\n      const all = await readAll();\n      if (all.revision !== expected_revision) return { status: 'conflict', revision: all.revision };\n      if (!all.services.some(s => s.id === service_id)) return { status: 'service_not_found', revision: all.revision };\n      const exists = all.endpoints.some(ep => ep.id === id);\n      if (!exists && all.endpoints.length >= MAX_ENDPOINTS) return { status: 'limit', revision: all.revision };\n      const rec = {\n        id,\n        service_id,\n        method,\n        path: path.trim().slice(0, 120),\n        summary: summary.trim().slice(0, 100),\n        auth,\n        status,\n        params: sanitizeParams(params),\n        request_schema: (request_schema || '').trim().slice(0, 48),\n        response_schema: (response_schema || '').trim().slice(0, 48),\n        error_codes: sanitizeErrors(error_codes),\n      };\n      const next = exists ? all.endpoints.map(ep => (ep.id === id ? rec : ep)) : [rec, ...all.endpoints];\n      const r = await writeDoc(COL_ENDPOINTS, expected_revision, { schema_version: 1, endpoints: next });\n      return r.status === 'saved' ? { status: 'saved', revision: r.revision, endpoint_id: id } : { status: r.status, revision: r.revision };\n    }\n\n    if (contribution === 'arch.endpoint.delete') {\n      const { expected_revision, id } = input;\n      const doc = await readListDoc(COL_ENDPOINTS, 'endpoints');\n      if (doc.revision !== expected_revision) return { status: 'conflict', revision: doc.revision };\n      if (!doc.items.some(ep => ep.id === id)) return { status: 'not_found', revision: doc.revision };\n      const r = await writeDoc(COL_ENDPOINTS, expected_revision, { schema_version: 1, endpoints: doc.items.filter(ep => ep.id !== id) });\n      return r.status === 'saved' ? { status: 'deleted', revision: r.revision } : { status: 'conflict', revision: r.revision };\n    }\n\n    if (contribution === 'arch.schema.save') {\n      const { expected_revision, id, name, kind: scKind, description, fields } = input;\n      if (!ID_RE.test(id) || !name.trim() || !SCHEMA_KINDS.includes(scKind)) {\n        return { status: 'invalid_input', revision: expected_revision };\n      }\n      const doc = await readListDoc(COL_SCHEMAS, 'schemas');\n      if (doc.revision !== expected_revision) return { status: 'conflict', revision: doc.revision };\n      const exists = doc.items.some(sc => sc.id === id);\n      if (!exists && doc.items.length >= MAX_SCHEMAS) return { status: 'limit', revision: doc.revision };\n      const rec = {\n        id,\n        name: name.trim().slice(0, 60),\n        kind: scKind,\n        description: (description || '').trim().slice(0, 160),\n        fields: sanitizeFields(fields),\n      };\n      const next = exists ? doc.items.map(sc => (sc.id === id ? rec : sc)) : [...doc.items, rec];\n      return writeDoc(COL_SCHEMAS, expected_revision, { schema_version: 1, schemas: next });\n    }\n\n    if (contribution === 'arch.schema.delete') {\n      const { expected_revision, id } = input;\n      const all = await readAll();\n      if (all.revision !== expected_revision) return { status: 'conflict', revision: all.revision };\n      if (!all.schemas.some(sc => sc.id === id)) return { status: 'not_found', revision: all.revision };\n      const nextSchemas = all.schemas.filter(sc => sc.id !== id);\n      const r1 = await writeDoc(COL_SCHEMAS, expected_revision, { schema_version: 1, schemas: nextSchemas });\n      if (r1.status !== 'saved') return { status: 'conflict', revision: r1.revision };\n      let changedEp = false;\n      const nextEndpoints = all.endpoints.map(ep => {\n        if (ep.request_schema === id || ep.response_schema === id) {\n          changedEp = true;\n          return {\n            ...ep,\n            request_schema: ep.request_schema === id ? '' : ep.request_schema,\n            response_schema: ep.response_schema === id ? '' : ep.response_schema,\n          };\n        }\n        return ep;\n      });\n      if (changedEp) {\n        const r2 = await writeDoc(COL_ENDPOINTS, r1.revision, { schema_version: 1, endpoints: nextEndpoints });\n        if (r2.status !== 'saved') return { status: 'conflict', revision: r2.revision };\n        return { status: 'deleted', revision: r2.revision };\n      }\n      return { status: 'deleted', revision: r1.revision };\n    }\n\n    if (contribution === 'arch.codegen') {\n      const all = await readAll();\n      const filter = typeof input.service_id === 'string' && input.service_id.trim() ? input.service_id.trim() : '';\n      const out = input.target === 'openapi'\n        ? compileOpenApi(all.services, all.endpoints, all.schemas, filter)\n        : compileTypeScript(all.services, all.endpoints, all.schemas, filter);\n      return { target: input.target, ...out };\n    }\n\n    if (contribution === 'arch.demo.load') {\n      const all = await readAll();\n      if (all.revision !== input.expected_revision) {\n        return {\n          status: 'conflict',\n          revision: all.revision,\n          services_count: all.services.length,\n          endpoints_count: all.endpoints.length,\n          schemas_count: all.schemas.length,\n        };\n      }\n      const demo = buildDemoData();\n      const r1 = await writeDoc(COL_SERVICES, input.expected_revision, { schema_version: 1, services: demo.services, edges: demo.edges });\n      if (r1.status !== 'saved') return { status: 'conflict', revision: r1.revision, services_count: 0, endpoints_count: 0, schemas_count: 0 };\n      const r2 = await writeDoc(COL_ENDPOINTS, r1.revision, { schema_version: 1, endpoints: demo.endpoints });\n      if (r2.status !== 'saved') return { status: 'conflict', revision: r2.revision, services_count: 0, endpoints_count: 0, schemas_count: 0 };\n      const r3 = await writeDoc(COL_SCHEMAS, r2.revision, { schema_version: 1, schemas: demo.schemas });\n      if (r3.status !== 'saved') return { status: 'conflict', revision: r3.revision, services_count: 0, endpoints_count: 0, schemas_count: 0 };\n      return {\n        status: 'loaded',\n        revision: r3.revision,\n        services_count: demo.services.length,\n        endpoints_count: demo.endpoints.length,\n        schemas_count: demo.schemas.length,\n      };\n    }\n\n    if (contribution === 'document.list') {\n      const all = await readAll();\n      const items = [];\n      if (all.services.length > 0 || all.endpoints.length > 0 || all.schemas.length > 0) {\n        items.push({ id: 'all', label: `完整项目架构快照 (${all.services.length} 服务 · ${all.endpoints.length} 接口 · ${all.schemas.length} 模型)` });\n      }\n      for (const s of all.services) {\n        const cnt = all.endpoints.filter(ep => ep.service_id === s.id).length;\n        items.push({ id: `svc:${s.id}`, label: `服务契约: ${s.name} (${cnt} API)` });\n      }\n      return { items };\n    }\n\n    if (contribution === 'document.export') {\n      const all = await readAll();\n      let payload;\n      let filename = 'api-arch-snapshot.json';\n      if (input.id === 'all') {\n        payload = { format: DOC_FORMAT, version: 1, services: all.services, edges: all.edges, endpoints: all.endpoints, schemas: all.schemas };\n      } else {\n        const sid = input.id.startsWith('svc:') ? input.id.slice(4) : input.id;\n        const svc = all.services.find(s => s.id === sid);\n        if (!svc) return { error: 'not_found' };\n        const eps = all.endpoints.filter(ep => ep.service_id === sid);\n        const usedSc = new Set();\n        eps.forEach(ep => { if (ep.request_schema) usedSc.add(ep.request_schema); if (ep.response_schema) usedSc.add(ep.response_schema); });\n        payload = {\n          format: DOC_FORMAT,\n          version: 1,\n          services: [svc],\n          edges: all.edges.filter(e => e.from === sid || e.to === sid),\n          endpoints: eps,\n          schemas: all.schemas.filter(sc => usedSc.has(sc.id)),\n        };\n        filename = `arch-${svc.id}.json`;\n      }\n      const text = JSON.stringify(payload, null, 2);\n      if (utf8Bytes(text) > MAX_RECORD_BYTES) return { error: 'too_large' };\n      return { filename, text };\n    }\n\n    if (contribution === 'document.import') {\n      let parsed;\n      try {\n        parsed = JSON.parse(input.text);\n      } catch {\n        return { imported: false, reason: 'invalid_json' };\n      }\n      if (\n        parsed?.format !== DOC_FORMAT ||\n        parsed?.version !== 1 ||\n        !Array.isArray(parsed.services) ||\n        !Array.isArray(parsed.endpoints) ||\n        !Array.isArray(parsed.schemas)\n      ) {\n        return { imported: false, reason: 'invalid_document' };\n      }\n      const all = await readAll();\n      const svcMap = new Map(all.services.map(s => [s.id, s]));\n      for (const s of parsed.services) {\n        if (!s || typeof s.id !== 'string' || !ID_RE.test(s.id) || typeof s.name !== 'string' || !s.name.trim()) continue;\n        if (!svcMap.has(s.id) && svcMap.size >= MAX_SERVICES) continue;\n        svcMap.set(s.id, {\n          id: s.id.slice(0, 40),\n          name: s.name.trim().slice(0, 60),\n          kind: SVC_KINDS.includes(s.kind) ? s.kind : 'service',\n          owner: typeof s.owner === 'string' ? s.owner.trim().slice(0, 40) : '',\n          description: typeof s.description === 'string' ? s.description.trim().slice(0, 180) : '',\n          tier: Number.isInteger(s.tier) ? Math.max(0, Math.min(4, s.tier)) : 1,\n        });\n      }\n\n      const edgeMap = new Map(all.edges.map(e => [e.id, e]));\n      for (const e of Array.isArray(parsed.edges) ? parsed.edges : []) {\n        if (!e || typeof e.id !== 'string' || !ID_RE.test(e.id) || !svcMap.has(e.from) || !svcMap.has(e.to)) continue;\n        if (!edgeMap.has(e.id) && edgeMap.size >= MAX_EDGES) continue;\n        edgeMap.set(e.id, {\n          id: e.id.slice(0, 48),\n          from: e.from,\n          to: e.to,\n          protocol: PROTOCOLS.includes(e.protocol) ? e.protocol : 'HTTP',\n          label: typeof e.label === 'string' ? e.label.trim().slice(0, 60) : '',\n        });\n      }\n\n      const epMap = new Map(all.endpoints.map(ep => [ep.id, ep]));\n      for (const ep of parsed.endpoints) {\n        if (!ep || typeof ep.id !== 'string' || !ID_RE.test(ep.id) || !svcMap.has(ep.service_id) || !METHODS.includes(ep.method) || typeof ep.path !== 'string' || !ep.path.startsWith('/')) continue;\n        if (!epMap.has(ep.id) && epMap.size >= MAX_ENDPOINTS) continue;\n        epMap.set(ep.id, {\n          id: ep.id.slice(0, 48),\n          service_id: ep.service_id,\n          method: ep.method,\n          path: ep.path.trim().slice(0, 120),\n          summary: typeof ep.summary === 'string' && ep.summary.trim() ? ep.summary.trim().slice(0, 100) : ep.path,\n          auth: AUTHS.includes(ep.auth) ? ep.auth : 'none',\n          status: STATUSES.includes(ep.status) ? ep.status : 'draft',\n          params: sanitizeParams(ep.params),\n          request_schema: typeof ep.request_schema === 'string' ? ep.request_schema.trim().slice(0, 48) : '',\n          response_schema: typeof ep.response_schema === 'string' ? ep.response_schema.trim().slice(0, 48) : '',\n          error_codes: sanitizeErrors(ep.error_codes),\n        });\n      }\n\n      const scMap = new Map(all.schemas.map(sc => [sc.id, sc]));\n      for (const sc of parsed.schemas) {\n        if (!sc || typeof sc.id !== 'string' || !ID_RE.test(sc.id) || typeof sc.name !== 'string' || !sc.name.trim()) continue;\n        if (!scMap.has(sc.id) && scMap.size >= MAX_SCHEMAS) continue;\n        scMap.set(sc.id, {\n          id: sc.id.slice(0, 48),\n          name: sc.name.trim().slice(0, 60),\n          kind: SCHEMA_KINDS.includes(sc.kind) ? sc.kind : 'dto',\n          description: typeof sc.description === 'string' ? sc.description.trim().slice(0, 160) : '',\n          fields: sanitizeFields(sc.fields),\n        });\n      }\n\n      const nextSvcs = Array.from(svcMap.values());\n      const nextEdges = Array.from(edgeMap.values());\n      const nextEps = Array.from(epMap.values());\n      const nextScs = Array.from(scMap.values());\n\n      const r1 = await writeDoc(COL_SERVICES, all.revision, { schema_version: 1, services: nextSvcs, edges: nextEdges });\n      if (r1.status !== 'saved') return { imported: false, reason: r1.status };\n      const r2 = await writeDoc(COL_ENDPOINTS, r1.revision, { schema_version: 1, endpoints: nextEps });\n      if (r2.status !== 'saved') return { imported: false, reason: r2.status };\n      const r3 = await writeDoc(COL_SCHEMAS, r2.revision, { schema_version: 1, schemas: nextScs });\n      if (r3.status !== 'saved') return { imported: false, reason: r3.status };\n      return {\n        imported: true,\n        services_count: nextSvcs.length,\n        endpoints_count: nextEps.length,\n        schemas_count: nextScs.length,\n      };\n    }\n\n    if (contribution === 'fs_list') {\n      const relPath = typeof input.path === 'string' ? input.path.trim() : '';\n      const limit = input.limit ?? 50;\n      const cursor = input.cursor;\n      try {\n        const res = await globalThis.nmas.fs.listDir({ path: relPath, limit, cursor });\n        return {\n          status: 'ok',\n          path: relPath,\n          entries: res.entries || [],\n          next_cursor: res.next_cursor ?? null,\n        };\n      } catch (err) {\n        const code = err?.code === 'invalid_input' ? 'invalid_input' : 'permission_denied';\n        return { status: code, path: relPath, entries: [], next_cursor: null, error: String(err?.message || code).slice(0, 160) };\n      }\n    }\n\n    if (contribution === 'fs_import_doc') {\n      const relPath = (input.path || '').trim();\n      if (!relPath) {\n        return { status: 'invalid_input', path: '', content: '', size_bytes: 0, sha256: '', format: 'text', error: '缺少文件路径' };\n      }\n      try {\n        const res = await globalThis.nmas.fs.readText({ path: relPath });\n        const lower = relPath.toLowerCase();\n        let format = lower.endsWith('.md') ? 'markdown' : lower.endsWith('.ts') ? 'typescript' : 'text';\n        try {\n          const parsed = JSON.parse(res.content);\n          if (parsed?.format === DOC_FORMAT) format = 'snapshot_json';\n          else if (typeof parsed?.openapi === 'string') format = 'openapi_json';\n        } catch {\n          // non-JSON file\n        }\n        return {\n          status: 'ok',\n          path: relPath,\n          content: res.content,\n          size_bytes: res.size_bytes,\n          sha256: res.sha256,\n          format,\n        };\n      } catch (err) {\n        const code = err?.code === 'resource_limit' ? 'resource_limit' : err?.code === 'invalid_input' ? 'invalid_input' : 'permission_denied';\n        return { status: code, path: relPath, content: '', size_bytes: 0, sha256: '', format: 'text', error: String(err?.message || code).slice(0, 160) };\n      }\n    }\n\n    if (contribution === 'fs_export_doc') {\n      const relPath = (input.path || '').trim();\n      const target = input.target;\n      const filter = typeof input.service_id === 'string' && input.service_id.trim() ? input.service_id.trim() : '';\n      const hasCreate = input.create_only === true;\n      const hasSha = typeof input.expected_sha256 === 'string' && /^[0-9a-f]{64}$/.test(input.expected_sha256);\n      if (!relPath || hasCreate === hasSha) {\n        return {\n          status: 'invalid_input',\n          path: relPath,\n          size_bytes: 0,\n          sha256: '',\n          error: 'create_only 与 expected_sha256 必须二选一',\n        };\n      }\n      const all = await readAll();\n      let content = '';\n      if (target === 'openapi') {\n        content = compileOpenApi(all.services, all.endpoints, all.schemas, filter).code;\n      } else if (target === 'typescript') {\n        content = compileTypeScript(all.services, all.endpoints, all.schemas, filter).code;\n      } else if (target === 'adr') {\n        const analysis = analyzeTopology(all.services, all.edges, all.endpoints);\n        content = compileAdrMarkdown(all.services, all.edges, all.endpoints, analysis);\n      } else if (target === 'snapshot') {\n        content = JSON.stringify({\n          format: DOC_FORMAT,\n          version: 1,\n          services: all.services,\n          edges: all.edges,\n          endpoints: all.endpoints,\n          schemas: all.schemas,\n        }, null, 2);\n      } else {\n        return { status: 'invalid_input', path: relPath, size_bytes: 0, sha256: '', error: '不支持的导出目标' };\n      }\n      try {\n        const writeReq = hasCreate\n          ? { path: relPath, content, create_only: true }\n          : { path: relPath, content, expected_sha256: input.expected_sha256 };\n        const receipt = await globalThis.nmas.fs.writeText(writeReq);\n        return { status: 'written', path: relPath, size_bytes: receipt.size_bytes, sha256: receipt.sha256 };\n      } catch (err) {\n        const mapCode = {\n          conflict: 'conflict',\n          resource_limit: 'resource_limit',\n          invalid_input: 'invalid_input',\n          permission_denied: 'permission_denied',\n        };\n        const status = mapCode[err?.code] || 'permission_denied';\n        return { status, path: relPath, size_bytes: 0, sha256: '', error: String(err?.message || status).slice(0, 160) };\n      }\n    }\n  }\n\n  if (kind === 'tool') {\n    if (contribution === 'arch.topology') {\n      const all = await readAll();\n      const analysis = analyzeTopology(all.services, all.edges, all.endpoints);\n      const metricMap = new Map(analysis.metrics.map(m => [m.service_id, m]));\n      const svcFilter = typeof input?.service_id === 'string' && input.service_id.trim() ? input.service_id.trim() : '';\n      const eps = svcFilter ? all.endpoints.filter(ep => ep.service_id === svcFilter) : all.endpoints;\n\n      return {\n        success: true,\n        status: all.services.length > 0 ? 'ready' : 'empty',\n        service_count: all.services.length,\n        edge_count: all.edges.length,\n        endpoint_count: eps.length,\n        cycles: analysis.cycles,\n        warnings: analysis.warnings,\n        services: all.services.map(s => {\n          const m = metricMap.get(s.id) || { fan_in: 0, fan_out: 0, in_cycle: false, endpoint_count: 0 };\n          return {\n            id: s.id,\n            name: s.name,\n            kind: s.kind,\n            fan_in: m.fan_in,\n            fan_out: m.fan_out,\n            in_cycle: m.in_cycle,\n            endpoint_count: m.endpoint_count,\n          };\n        }),\n        endpoints: eps.slice(0, 20).map(({ id, service_id, method, path, summary, status, auth }) => ({\n          id,\n          service_id,\n          method,\n          path,\n          summary,\n          status,\n          auth,\n        })),\n      };\n    }\n\n    if (contribution === 'arch.endpoint.upsert') {\n      const {\n        id: rawId,\n        service_id,\n        method,\n        path,\n        summary,\n        auth = 'bearer',\n        status = 'draft',\n        request_schema = '',\n        response_schema = '',\n      } = input;\n      const all = await readAll();\n      if (!METHODS.includes(method) || !path.startsWith('/') || !summary.trim() || !AUTHS.includes(auth) || !STATUSES.includes(status)) {\n        return { success: false, status: 'invalid_input', revision: all.revision };\n      }\n      if (!all.services.some(s => s.id === service_id)) {\n        return { success: false, status: 'service_not_found', revision: all.revision };\n      }\n      const existing = rawId\n        ? all.endpoints.find(ep => ep.id === rawId)\n        : all.endpoints.find(ep => ep.service_id === service_id && ep.method === method && ep.path === path.trim());\n      const id = existing\n        ? existing.id\n        : rawId && ID_RE.test(rawId)\n          ? rawId.slice(0, 48)\n          : `ep-${Date.now().toString(36)}-${(all.endpoints.length + 1).toString(36)}`.slice(0, 48);\n      if (!existing && all.endpoints.length >= MAX_ENDPOINTS) {\n        return { success: false, status: 'limit', revision: all.revision };\n      }\n      const rec = {\n        id,\n        service_id,\n        method,\n        path: path.trim().slice(0, 120),\n        summary: summary.trim().slice(0, 100),\n        auth,\n        status,\n        params: existing ? existing.params : [],\n        request_schema: (request_schema || '').trim().slice(0, 48),\n        response_schema: (response_schema || '').trim().slice(0, 48),\n        error_codes: existing ? existing.error_codes : [],\n      };\n      const next = existing ? all.endpoints.map(ep => (ep.id === id ? rec : ep)) : [rec, ...all.endpoints];\n      const r = await writeDoc(COL_ENDPOINTS, all.revision, { schema_version: 1, endpoints: next });\n      if (r.status !== 'saved') {\n        return { success: false, status: r.status, revision: r.revision };\n      }\n      return {\n        success: true,\n        status: existing ? 'updated' : 'created',\n        endpoint_id: id,\n        revision: r.revision,\n      };\n    }\n  }\n\n  throw new Error(`不支持的调用: ${kind}/${contribution}`);\n}\n","path":"backend/index.js"},{"content":"<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>系统架构与 API 契约设计台</title>\n<style>\n:root{color-scheme:light dark;--bg:#f5f7fb;--surface:#ffffff;--s2:#eef1f8;--s3:#e3e8f4;--fg:#0f172a;--fg2:#334155;--muted:#64748b;--border:#dce2ee;--b2:#c2cce0;--accent:#2563eb;--accent-s:rgba(37,99,235,.11);--accent-fg:#fff;--ok:#059669;--ok-s:rgba(5,150,105,.12);--warn:#d97706;--warn-s:rgba(217,119,6,.13);--danger:#dc2626;--danger-s:rgba(220,38,38,.12);--purple:#7c3aed;--purple-s:rgba(124,58,237,.12);--sh1:0 1px 2px rgba(15,23,42,.05);--sh2:0 12px 30px rgba(15,23,42,.11);--r:12px;--mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font:13.5px/1.5 -apple-system,BlinkMacSystemFont,\"SF Pro Text\",\"Segoe UI\",system-ui,sans-serif}\n@media (prefers-color-scheme:dark){:root:not([data-theme=\"light\"]){--bg:#0b0f18;--surface:#121826;--s2:#1a2235;--s3:#232e47;--fg:#f1f5f9;--fg2:#cbd5e1;--muted:#94a3b8;--border:#243049;--b2:#344566;--accent:#60a5fa;--accent-s:rgba(96,165,250,.15);--accent-fg:#0b0f18;--ok:#34d399;--ok-s:rgba(52,211,153,.15);--warn:#fbbf24;--warn-s:rgba(251,191,36,.15);--danger:#f87171;--danger-s:rgba(248,113,113,.16);--purple:#a78bfa;--purple-s:rgba(167,139,250,.16);--sh1:0 1px 2px rgba(0,0,0,.35);--sh2:0 14px 36px rgba(0,0,0,.48)}}\n:root[data-theme=\"dark\"]{--bg:#0b0f18;--surface:#121826;--s2:#1a2235;--s3:#232e47;--fg:#f1f5f9;--fg2:#cbd5e1;--muted:#94a3b8;--border:#243049;--b2:#344566;--accent:#60a5fa;--accent-s:rgba(96,165,250,.15);--accent-fg:#0b0f18;--ok:#34d399;--ok-s:rgba(52,211,153,.15);--warn:#fbbf24;--warn-s:rgba(251,191,36,.15);--danger:#f87171;--danger-s:rgba(248,113,113,.16);--purple:#a78bfa;--purple-s:rgba(167,139,250,.16);--sh1:0 1px 2px rgba(0,0,0,.35);--sh2:0 14px 36px rgba(0,0,0,.48)}\n*{box-sizing:border-box}\nhtml,body{height:100%;margin:0;background:var(--bg);color:var(--fg);overflow:hidden}\nbutton,input,select,textarea{font:inherit;color:inherit}\n[hidden]{display:none!important}\n.app{display:grid;grid-template-columns:220px minmax(0,1fr);height:100vh}\n@media (max-width:780px){.app{grid-template-columns:1fr;grid-template-rows:auto minmax(0,1fr)}.sidebar{flex-direction:row!important;align-items:center;overflow-x:auto;border-right:none!important;border-bottom:1px solid var(--border);padding:8px 12px!important}.nav-list,.sidebar-foot{flex-direction:row!important;margin-top:0!important}.brand-sub{display:none}}\n.sidebar{background:var(--surface);border-right:1px solid var(--border);padding:15px 12px;display:flex;flex-direction:column;gap:14px;overflow-y:auto}\n.brand{display:flex;align-items:center;gap:10px;padding:2px 6px}\n.brand-ic{width:34px;height:34px;border-radius:10px;flex-shrink:0;background:linear-gradient(135deg,#2563eb,#7c3aed);display:grid;place-items:center;color:#fff;box-shadow:0 4px 12px rgba(37,99,235,.32)}\n.brand-t{font-weight:700;font-size:14px;line-height:1.2;letter-spacing:-.01em}\n.brand-sub{font-size:11px;color:var(--muted)}\n.nav-list{display:flex;flex-direction:column;gap:4px}\n.nav-btn{display:flex;align-items:center;gap:9px;width:100%;padding:9px 10px;border-radius:9px;border:1px solid transparent;background:transparent;cursor:pointer;text-align:left;font-weight:500;color:var(--fg2);transition:.14s}\n.nav-btn:hover{background:var(--s2);color:var(--fg)}\n.nav-btn.active{background:var(--accent-s);color:var(--accent);border-color:color-mix(in srgb,var(--accent) 28%,transparent);font-weight:600}\n.nav-badge{margin-left:auto;font-size:11px;font-weight:600;padding:1px 7px;border-radius:999px;background:var(--s2);color:var(--muted)}\n.nav-btn.active .nav-badge{background:var(--accent);color:var(--accent-fg)}\n.sidebar-foot{margin-top:auto;display:flex;flex-direction:column;gap:6px;padding-top:10px;border-top:1px solid var(--border)}\n.main-col{display:flex;flex-direction:column;min-width:0;height:100%;overflow:hidden}\n.topbar{background:var(--surface);border-bottom:1px solid var(--border);padding:10px 18px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}\n.kpi-strip{display:flex;align-items:center;gap:10px;flex-wrap:wrap;flex:1}\n.kpi-chip{display:flex;align-items:center;gap:8px;padding:6px 11px;border-radius:10px;background:var(--s2);border:1px solid var(--border);min-width:112px}\n.kpi-chip.click{cursor:pointer}\n.kpi-chip.alert{background:var(--danger-s);border-color:color-mix(in srgb,var(--danger) 45%,var(--border))}\n.kpi-val{font-size:15.5px;font-weight:700;line-height:1.1;font-variant-numeric:tabular-nums}\n.kpi-lbl{font-size:11px;color:var(--muted);line-height:1.2}\n.dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;display:inline-block}\n.status-bar{padding:5px 18px;font-size:12px;color:var(--muted);background:var(--bg);border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:8px}\n.status-bar[data-kind=\"error\"]{color:var(--danger);background:var(--danger-s)}\n.status-bar[data-kind=\"ok\"]{color:var(--ok)}\n.workspace{flex:1;overflow-y:auto;padding:15px 18px 24px}\n\n.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:6.5px 12px;border-radius:8px;border:1px solid var(--border);background:var(--surface);color:var(--fg);cursor:pointer;font-weight:500;transition:.12s;white-space:nowrap}\n.btn:hover:not(:disabled){background:var(--s2);border-color:var(--b2)}\n.btn:disabled{opacity:.5;cursor:not-allowed}\n.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-fg)}\n.btn.primary:hover:not(:disabled){filter:brightness(1.07)}\n.btn.ghost{background:transparent;border-color:transparent}\n.btn.ghost:hover:not(:disabled){background:var(--s2)}\n.btn.danger{color:var(--danger);border-color:color-mix(in srgb,var(--danger) 35%,var(--border))}\n.btn.danger:hover:not(:disabled){background:var(--danger-s)}\n.btn.sm{padding:4px 9px;font-size:12px;border-radius:7px}\ninput[type=\"text\"],input[type=\"search\"],input[type=\"number\"],select,textarea{width:100%;padding:6.5px 9px;border-radius:8px;border:1px solid var(--border);background:var(--surface);color:var(--fg);outline:none}\ninput:focus,select:focus,textarea:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-s)}\ntextarea{resize:vertical;min-height:72px}\n.panel{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:14px 16px;box-shadow:var(--sh1)}\n.phead{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:10px;flex-wrap:wrap}\n.ptitle{font-size:14px;font-weight:700;margin:0}\n.muted{color:var(--muted);font-size:12px}\n.mono{font-family:var(--mono)}\n.row{display:flex;align-items:center;gap:8px;flex-wrap:wrap}\n.pill{display:inline-flex;align-items:center;gap:5px;padding:2px 8px;border-radius:999px;font-size:11.5px;font-weight:600;background:var(--s2);color:var(--fg2);border:1px solid var(--border)}\n.pill.ok{background:var(--ok-s);color:var(--ok);border-color:transparent}\n.pill.warn{background:var(--warn-s);color:var(--warn);border-color:transparent}\n.pill.danger{background:var(--danger-s);color:var(--danger);border-color:transparent}\n.pill.purple{background:var(--purple-s);color:var(--purple);border-color:transparent}\n.pill.info{background:var(--accent-s);color:var(--accent);border-color:transparent}\n\n.m-badge{display:inline-block;min-width:54px;text-align:center;font-family:var(--mono);font-size:11px;font-weight:700;padding:2px 6px;border-radius:6px}\n.m-GET{background:var(--accent-s);color:var(--accent)}\n.m-POST{background:var(--ok-s);color:var(--ok)}\n.m-PUT{background:var(--warn-s);color:var(--warn)}\n.m-PATCH{background:var(--purple-s);color:var(--purple)}\n.m-DELETE{background:var(--danger-s);color:var(--danger)}\n\n.banner-warn{padding:10px 14px;border-radius:10px;border:1px solid color-mix(in srgb,var(--danger) 45%,var(--border));background:var(--danger-s);color:var(--danger);margin-bottom:12px;font-size:12.5px;display:flex;flex-direction:column;gap:4px}\n.topo-layout{display:grid;grid-template-columns:minmax(0,1fr) 316px;gap:14px;min-height:500px}\n@media (max-width:960px){.topo-layout{grid-template-columns:1fr}}\n.canvas-wrap{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);overflow:hidden;display:flex;flex-direction:column;min-height:490px}\n.canvas-bar{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:10px 14px;border-bottom:1px solid var(--border);flex-wrap:wrap}\n.topo-svg{width:100%;flex:1;min-height:445px;display:block;background:var(--bg)}\n.inspector{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:14px;display:flex;flex-direction:column;gap:11px;overflow-y:auto;max-height:560px}\n.mgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}\n.mbox{background:var(--s2);border:1px solid var(--border);border-radius:8px;padding:7px;text-align:center}\n.mbox b{display:block;font-size:15px;font-variant-numeric:tabular-nums}\n.mbox span{font-size:11px;color:var(--muted)}\n.edge-item{display:flex;align-items:center;justify-content:space-between;gap:6px;padding:6px 8px;border-radius:8px;background:var(--s2);border:1px solid var(--border);font-size:12px}\n.edge-item.cyc{border-color:var(--danger);background:var(--danger-s)}\n\n.split{display:grid;grid-template-columns:minmax(250px,340px) minmax(0,1fr);gap:14px;align-items:start}\n@media (max-width:860px){.split{grid-template-columns:1fr}}\n.item-list{display:flex;flex-direction:column;gap:6px;max-height:520px;overflow-y:auto}\n.list-row{width:100%;text-align:left;padding:9px 11px;border-radius:10px;border:1px solid var(--border);background:var(--surface);cursor:pointer;display:flex;flex-direction:column;gap:4px;transition:.12s}\n.list-row:hover{border-color:var(--b2);background:var(--s2)}\n.list-row.active{border-color:var(--accent);background:var(--accent-s)}\n.sub-table{display:flex;flex-direction:column;gap:6px}\n.sub-row{display:grid;gap:6px;align-items:center}\n.param-row{grid-template-columns:1.1fr .8fr .8fr auto 1.3fr auto}\n.err-row{grid-template-columns:88px 1fr auto}\n.field-row{grid-template-columns:1fr .85fr .9fr auto 1.2fr auto}\n@media (max-width:700px){.param-row,.field-row{grid-template-columns:1fr 1fr}}\n.code-box{margin:0;padding:14px;border-radius:10px;border:1px solid var(--border);background:var(--s2);font-family:var(--mono);font-size:12px;line-height:1.58;overflow:auto;max-height:490px;white-space:pre;tab-size:2}\n.seg{display:inline-flex;padding:3px;border-radius:9px;background:var(--s2);border:1px solid var(--border);gap:3px}\n.seg button{border:none;background:transparent;padding:5px 11px;border-radius:7px;cursor:pointer;font-weight:600;font-size:12.5px;color:var(--fg2)}\n.seg button.active{background:var(--surface);color:var(--accent);box-shadow:var(--sh1)}\n\n.modal-bg{position:fixed;inset:0;background:rgba(10,14,24,.56);display:grid;place-items:center;padding:16px;z-index:40}\n.modal{width:min(540px,100%);max-height:90vh;overflow-y:auto;background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:18px;box-shadow:var(--sh2);display:flex;flex-direction:column;gap:12px}\n.field{display:flex;flex-direction:column;gap:4px}\n.field>span{font-size:12px;font-weight:600;color:var(--fg2)}\n.empty{text-align:center;padding:34px 18px;border:1px dashed var(--b2);border-radius:var(--r);background:var(--surface);display:flex;flex-direction:column;align-items:center;gap:10px}\n\n    /* === V2 Host Theme & Compact Surface Start === */\n    :root[data-theme=\"dark\"], html[data-theme=\"dark\"] { color-scheme: dark; --bg: #0b0f18; --surface: #121826; --fg: #f1f5f9; --muted: #94a3b8; --border: #243049; --accent: #60a5fa; --v2-host-accent: #60a5fa; }\n    :root[data-theme=\"light\"], html[data-theme=\"light\"] { color-scheme: light; --bg: #f5f7fb; --surface: #ffffff; --fg: #0f172a; --muted: #64748b; --border: #dce2ee; --accent: #2563eb; --v2-host-accent: #2563eb; }\n    :root[data-theme=\"dark\"]:not([data-theme-override=\"1\"]), html[data-theme=\"dark\"]:not([data-theme-override=\"1\"]) { --bg: var(--host-bg, #0b0f18); --surface: var(--host-surface, #121826); --fg: var(--host-fg, #f1f5f9); --muted: var(--host-muted, #94a3b8); --border: var(--host-border, #243049); --v2-host-accent: var(--host-primary, #60a5fa); }\n    :root[data-theme=\"light\"]:not([data-theme-override=\"1\"]), html[data-theme=\"light\"]:not([data-theme-override=\"1\"]) { --bg: var(--host-bg, #f5f7fb); --surface: var(--host-surface, #ffffff); --fg: var(--host-fg, #0f172a); --muted: var(--host-muted, #64748b); --border: var(--host-border, #dce2ee); --v2-host-accent: var(--host-primary, #2563eb); }\n    :is(button, input, select, textarea, .v2-surface-tab):focus-visible { outline: 2px solid var(--v2-host-accent, var(--accent)); outline-offset: 1px; }\n    html[data-surface=\"chat\"], html[data-surface=\"assistant\"],\n    html[data-surface=\"chat\"] body, html[data-surface=\"assistant\"] body { overflow-x: hidden; }\n    html[data-surface=\"chat\"] .sidebar, html[data-surface=\"assistant\"] .sidebar { display: none !important; }\n    html[data-surface=\"chat\"] .app, html[data-surface=\"assistant\"] .app { grid-template-columns: 1fr !important; grid-template-rows: minmax(0, 1fr) !important; }\n    html[data-surface=\"chat\"] .topo-layout, html[data-surface=\"assistant\"] .topo-layout, html[data-surface=\"chat\"] .split, html[data-surface=\"assistant\"] .split, html[data-surface=\"chat\"] .param-row, html[data-surface=\"assistant\"] .param-row, html[data-surface=\"chat\"] .field-row, html[data-surface=\"assistant\"] .field-row { grid-template-columns: 1fr !important; }\n    \n    html[data-surface=\"chat\"] :is(section, article, main, .card, .panel, .view),\n    html[data-surface=\"assistant\"] :is(section, article, main, .card, .panel, .view) { min-width: 0; }\n    html[data-surface=\"chat\"] :is(svg, canvas, pre),\n    html[data-surface=\"assistant\"] :is(svg, canvas, pre) { max-width: 100%; }\n    html[data-surface=\"chat\"] .topbar, html[data-surface=\"assistant\"] .topbar { padding: 8px 10px; gap: 6px; }\n    html[data-surface=\"chat\"] .workspace, html[data-surface=\"assistant\"] .workspace { padding: 10px; gap: 10px; }\n    .v2-surface-nav { display: none; }\n    html[data-surface=\"chat\"] .v2-surface-nav, html[data-surface=\"assistant\"] .v2-surface-nav {\n      display: flex; align-items: center; gap: 6px; padding: 7px 10px; \n      overflow-x: auto; scrollbar-width: none; flex-shrink: 0;\n      background: var(--surface); border-bottom: 1px solid var(--border);\n      position: sticky; top: 0; z-index: 30;\n    }\n    html[data-surface=\"chat\"] .v2-surface-nav::-webkit-scrollbar, html[data-surface=\"assistant\"] .v2-surface-nav::-webkit-scrollbar { display: none; }\n    .v2-surface-tab {\n      appearance: none; border: 1px solid var(--border); background: transparent;\n      color: var(--muted); border-radius: 999px; padding: 4px 10px; font-size: 12px;\n      line-height: 1.35; font-weight: 500; white-space: nowrap; flex-shrink: 0; cursor: pointer;\n      transition: background 0.14s ease, border-color 0.14s ease, color 0.14s ease;\n    }\n    .v2-surface-tab:hover { color: var(--fg); border-color: var(--v2-host-accent, var(--accent)); }\n    .v2-surface-tab.active {\n      color: var(--v2-host-accent, var(--accent));\n      border-color: var(--v2-host-accent, var(--accent));\n      background: color-mix(in srgb, var(--v2-host-accent, var(--accent)) 14%, transparent);\n      font-weight: 600;\n    }\n    /* === V2 Host Theme & Compact Surface End === */\n  </style>\n</head>\n<body>\n<div class=\"app\">\n  <aside class=\"sidebar\">\n    <div class=\"brand\">\n      <div class=\"brand-ic\" aria-hidden=\"true\">\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\">\n          <rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"8.5\" y=\"14\" width=\"7\" height=\"7\" rx=\"1.5\"/>\n          <path d=\"M10 6.5h4M6.5 10v2.5L12 14M17.5 10v2.5L12 14\"/>\n        </svg>\n      </div>\n      <div><div class=\"brand-t\">API Arch Studio</div><div class=\"brand-sub\">项目级架构 · API 契约台</div></div>\n    </div>\n    <nav class=\"nav-list\" aria-label=\"主导航\">\n      <button class=\"nav-btn active\" data-view=\"topology\" type=\"button\">\n        <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"4\" width=\"6\" height=\"6\" rx=\"1\"/><rect x=\"15\" y=\"4\" width=\"6\" height=\"6\" rx=\"1\"/><rect x=\"9\" y=\"14\" width=\"6\" height=\"6\" rx=\"1\"/><path d=\"M9 7h6M6 10v2l6 2M18 10v2l-6 2\"/></svg>\n        <span>架构拓扑画布</span><span class=\"nav-badge\" id=\"bd-svc\">0</span>\n      </button>\n      <button class=\"nav-btn\" data-view=\"endpoints\" type=\"button\">\n        <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M4 6h16M4 12h16M4 18h10\"/></svg>\n        <span>API 契约目录</span><span class=\"nav-badge\" id=\"bd-ep\">0</span>\n      </button>\n      <button class=\"nav-btn\" data-view=\"codegen\" type=\"button\">\n        <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"m8 6-6 6 6 6M16 6l6 6-6 6M13 4l-2 16\"/></svg>\n        <span>契约代码生成</span><span class=\"nav-badge\">3.0</span>\n      </button>\n      <button class=\"nav-btn\" data-view=\"schemas\" type=\"button\">\n        <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><ellipse cx=\"12\" cy=\"5\" rx=\"8\" ry=\"3\"/><path d=\"M4 5v14c0 1.66 3.58 3 8 3s8-1.34 8-3V5M4 12c0 1.66 3.58 3 8 3s8-1.34 8-3\"/></svg>\n        <span>数据模型 Schema</span><span class=\"nav-badge\" id=\"bd-sc\">0</span>\n      </button>\n    </nav>\n    <div class=\"sidebar-foot\">\n      <button id=\"btn-demo\" class=\"btn sm\" type=\"button\">载入电商风控演示</button>\n      <button id=\"btn-io\" class=\"btn sm\" type=\"button\">导入 / 导出 JSON</button>\n      <button id=\"btn-theme\" class=\"btn sm ghost\" type=\"button\">切换明暗主题</button>\n    </div>\n  </aside>\n\n  <div class=\"main-col\">\n    <header class=\"topbar\">\n      <div class=\"kpi-strip\">\n        <div class=\"kpi-chip\"><span class=\"dot\" style=\"background:var(--accent)\"></span><div><div class=\"kpi-val\" id=\"kpi-svc\">0 / 0</div><div class=\"kpi-lbl\">服务节点 / 依赖边</div></div></div>\n        <div class=\"kpi-chip\"><span class=\"dot\" style=\"background:var(--ok)\"></span><div><div class=\"kpi-val\" id=\"kpi-ep\">0</div><div class=\"kpi-lbl\">API 契约 · Stable <b id=\"kpi-stable\">0%</b></div></div></div>\n        <div class=\"kpi-chip\"><span class=\"dot\" style=\"background:var(--purple)\"></span><div><div class=\"kpi-val\" id=\"kpi-sc\">0</div><div class=\"kpi-lbl\">共享 Schema 模型</div></div></div>\n        <div class=\"kpi-chip click\" id=\"kpi-cycle-chip\"><span class=\"dot\" id=\"kpi-cycle-dot\" style=\"background:var(--ok)\"></span><div><div class=\"kpi-val\" id=\"kpi-cycle\">0 环依赖</div><div class=\"kpi-lbl\" id=\"kpi-cycle-sub\">架构依赖健康</div></div></div>\n      </div>\n      <div class=\"row\">\n        <button id=\"btn-add-svc\" class=\"btn sm\" type=\"button\">+ 服务节点</button>\n        <button id=\"btn-add-edge\" class=\"btn sm\" type=\"button\">+ 依赖连线</button>\n        <button id=\"btn-add-ep\" class=\"btn primary sm\" type=\"button\">+ 新增 API</button>\n      </div>\n    </header>\n    <div id=\"status-bar\" class=\"status-bar\" role=\"status\"><span id=\"status-text\">正在读取项目架构…</span><span id=\"rev-tag\">rev #0</span></div>\n\n    <main class=\"workspace\">\n      <!-- View 1: Microservice Topology SVG Canvas -->\n      <section id=\"view-topology\" class=\"view\">\n        <div id=\"cycle-banner\" class=\"banner-warn\" hidden></div>\n        <div class=\"topo-layout\">\n          <div class=\"canvas-wrap\">\n            <div class=\"canvas-bar\">\n              <div class=\"row\">\n                <span class=\"pill\"><span class=\"dot\" style=\"background:#2563eb\"></span>Gateway</span>\n                <span class=\"pill\"><span class=\"dot\" style=\"background:#059669\"></span>Service</span>\n                <span class=\"pill\"><span class=\"dot\" style=\"background:#d97706\"></span>Queue</span>\n                <span class=\"pill\"><span class=\"dot\" style=\"background:#7c3aed\"></span>DB</span>\n                <span class=\"pill\"><span class=\"dot\" style=\"background:#64748b\"></span>External</span>\n              </div>\n              <span class=\"muted\">点击节点查看耦合度与入/出边</span>\n            </div>\n            <svg id=\"topo-svg\" class=\"topo-svg\" viewBox=\"0 0 820 460\" aria-label=\"微服务架构拓扑画布\"></svg>\n          </div>\n          <aside id=\"topo-inspector\" class=\"inspector\"></aside>\n        </div>\n      </section>\n\n      <!-- View 2: API Endpoint Catalog & Editor -->\n      <section id=\"view-endpoints\" class=\"view\" hidden>\n        <div class=\"panel\" style=\"margin-bottom:12px\">\n          <div class=\"row\">\n            <div style=\"flex:1;min-width:170px\"><input id=\"ep-search\" type=\"search\" placeholder=\"搜索路径、接口名称或 ID…\"></div>\n            <select id=\"ep-filter-svc\" style=\"width:150px\"></select>\n            <select id=\"ep-filter-method\" style=\"width:112px\"><option value=\"\">全部方法</option><option>GET</option><option>POST</option><option>PUT</option><option>PATCH</option><option>DELETE</option></select>\n            <select id=\"ep-filter-status\" style=\"width:120px\"><option value=\"\">全部状态</option><option value=\"draft\">draft</option><option value=\"review\">review</option><option value=\"stable\">stable</option><option value=\"deprecated\">deprecated</option></select>\n          </div>\n        </div>\n        <div class=\"split\">\n          <div class=\"panel\">\n            <div class=\"phead\"><h2 class=\"ptitle\">接口列表 (<span id=\"ep-count\">0</span>)</h2><button id=\"btn-ep-new2\" class=\"btn sm\" type=\"button\">+ 新建</button></div>\n            <div id=\"ep-list\" class=\"item-list\"></div>\n          </div>\n          <div id=\"ep-editor\" class=\"panel\"></div>\n        </div>\n      </section>\n\n      <!-- View 3: OpenAPI 3.0 & TypeScript Codegen -->\n      <section id=\"view-codegen\" class=\"view\" hidden>\n        <div class=\"panel\">\n          <div class=\"phead\">\n            <div class=\"row\">\n              <div class=\"seg\" id=\"cg-tabs\">\n                <button class=\"active\" data-target=\"openapi\" type=\"button\">OpenAPI 3.0.3 JSON</button>\n                <button data-target=\"typescript\" type=\"button\">TypeScript Interfaces</button>\n              </div>\n              <select id=\"cg-service\" style=\"width:170px\"></select>\n            </div>\n            <div class=\"row\">\n              <span class=\"muted\" id=\"cg-meta\">—</span>\n              <button id=\"btn-cg-refresh\" class=\"btn sm\" type=\"button\">重新编译</button>\n              <button id=\"btn-cg-copy\" class=\"btn sm\" type=\"button\">复制代码</button>\n              <button id=\"btn-cg-insert\" class=\"btn primary sm\" type=\"button\" hidden>插入会话让 AI 评审</button>\n            </div>\n          </div>\n          <pre id=\"cg-code\" class=\"code-box\">// 正在编译契约代码…</pre>\n        </div>\n      </section>\n\n      <!-- View 4: Data Model Schema Center -->\n      <section id=\"view-schemas\" class=\"view\" hidden>\n        <div class=\"split\">\n          <div class=\"panel\">\n            <div class=\"phead\"><h2 class=\"ptitle\">共享模型 (<span id=\"sc-count\">0</span>)</h2><button id=\"btn-sc-new\" class=\"btn sm primary\" type=\"button\">+ 新建 Schema</button></div>\n            <div id=\"sc-list\" class=\"item-list\"></div>\n          </div>\n          <div id=\"sc-editor\" class=\"panel\"></div>\n        </div>\n      </section>\n    </main>\n  </div>\n</div>\n\n<!-- Service Modal -->\n<div id=\"modal-svc\" class=\"modal-bg\" hidden>\n  <div class=\"modal\" role=\"dialog\" aria-modal=\"true\">\n    <div class=\"phead\" style=\"margin-bottom:0\"><h2 id=\"ms-title\" class=\"ptitle\">新增微服务节点</h2><button class=\"btn sm ghost\" data-close=\"modal-svc\" type=\"button\">关闭</button></div>\n    <div class=\"row\">\n      <label class=\"field\" style=\"flex:1\"><span>服务 ID (英文/短横线)</span><input id=\"ms-id\" type=\"text\" maxlength=\"40\" placeholder=\"例如：inventory-svc\"></label>\n      <label class=\"field\" style=\"flex:1\"><span>服务名称</span><input id=\"ms-name\" type=\"text\" maxlength=\"60\" placeholder=\"例如：库存扣减服务\"></label>\n    </div>\n    <div class=\"row\">\n      <label class=\"field\" style=\"flex:1\"><span>节点类型</span><select id=\"ms-kind\"><option value=\"gateway\">Gateway 网关</option><option value=\"service\">Service 微服务</option><option value=\"queue\">Queue 消息队列</option><option value=\"db\">DB 数据库</option><option value=\"external\">External 外部依赖</option></select></label>\n      <label class=\"field\" style=\"width:120px\"><span>拓扑层级 (0-3)</span><select id=\"ms-tier\"><option value=\"0\">0 · 接入层</option><option value=\"1\">1 · 核心域</option><option value=\"2\">2 · 支撑/异步</option><option value=\"3\">3 · 存储/外部</option></select></label>\n      <label class=\"field\" style=\"flex:1\"><span>负责人 / 团队</span><input id=\"ms-owner\" type=\"text\" maxlength=\"40\" placeholder=\"Commerce\"></label>\n    </div>\n    <label class=\"field\"><span>职责说明</span><textarea id=\"ms-desc\" rows=\"2\" maxlength=\"180\" placeholder=\"简述服务边界、核心 SLA 或关键职责\"></textarea></label>\n    <div class=\"row\" style=\"justify-content:flex-end\">\n      <button id=\"btn-ms-del\" class=\"btn danger\" type=\"button\" hidden style=\"margin-right:auto\">删除服务</button>\n      <button class=\"btn\" data-close=\"modal-svc\" type=\"button\">取消</button>\n      <button id=\"btn-ms-save\" class=\"btn primary\" type=\"button\">保存节点</button>\n    </div>\n  </div>\n</div>\n\n<!-- Edge Modal -->\n<div id=\"modal-edge\" class=\"modal-bg\" hidden>\n  <div class=\"modal\" role=\"dialog\" aria-modal=\"true\">\n    <div class=\"phead\" style=\"margin-bottom:0\"><h2 class=\"ptitle\">新增服务依赖边</h2><button class=\"btn sm ghost\" data-close=\"modal-edge\" type=\"button\">关闭</button></div>\n    <div class=\"row\">\n      <label class=\"field\" style=\"flex:1\"><span>调用方 (From)</span><select id=\"me-from\"></select></label>\n      <label class=\"field\" style=\"flex:1\"><span>被调用方 (To)</span><select id=\"me-to\"></select></label>\n    </div>\n    <div class=\"row\">\n      <label class=\"field\" style=\"width:130px\"><span>协议</span><select id=\"me-proto\"><option>HTTP</option><option>gRPC</option><option>Event</option><option>SQL</option><option>Cache</option></select></label>\n      <label class=\"field\" style=\"flex:1\"><span>调用语义说明</span><input id=\"me-label\" type=\"text\" maxlength=\"60\" placeholder=\"例如：扣减库存 RPC\"></label>\n    </div>\n    <div class=\"row\" style=\"justify-content:flex-end\"><button class=\"btn\" data-close=\"modal-edge\" type=\"button\">取消</button><button id=\"btn-me-save\" class=\"btn primary\" type=\"button\">添加依赖边</button></div>\n  </div>\n</div>\n\n<!-- Import / Export Modal -->\n<div id=\"modal-io\" class=\"modal-bg\" hidden>\n  <div class=\"modal\" role=\"dialog\" aria-modal=\"true\">\n    <div class=\"phead\" style=\"margin-bottom:0\"><h2 class=\"ptitle\">导入 / 导出项目架构快照 JSON</h2><button class=\"btn sm ghost\" data-close=\"modal-io\" type=\"button\">关闭</button></div>\n    <div class=\"row\">\n      <select id=\"io-select\" style=\"flex:1\"></select>\n      <button id=\"btn-io-exp\" class=\"btn\" type=\"button\">导出</button>\n      <button id=\"btn-io-copy\" class=\"btn\" type=\"button\">复制</button>\n    </div>\n    <label class=\"field\"><span>JSON 内容</span><textarea id=\"io-text\" rows=\"9\" class=\"mono\" style=\"font-size:12px\" placeholder='{\"format\":\"velai-api-arch-studio\",\"version\":1,...}'></textarea></label>\n    <div class=\"row\" style=\"justify-content:flex-end\"><button class=\"btn\" data-close=\"modal-io\" type=\"button\">关闭</button><button id=\"btn-io-imp\" class=\"btn primary\" type=\"button\">导入并合并</button></div>\n    <div style=\"border-top:1px solid var(--border);padding-top:12px;display:flex;flex-direction:column;gap:8px\">\n      <div class=\"row\" style=\"justify-content:space-between;font-size:12px\"><strong>项目工作区文档同步 (V2 Workspace FS)</strong><span id=\"fs-sha-hint\" style=\"color:var(--fg2)\">支持新建或 CAS 覆盖发布</span></div>\n      <div class=\"row\">\n        <input id=\"fs-dir\" type=\"text\" placeholder=\"工作区目录（空表示根目录，如 docs）\" style=\"flex:1\">\n        <button id=\"fs-btn-list\" class=\"btn sm\" type=\"button\">浏览目录</button>\n      </div>\n      <div id=\"fs-entries\" style=\"display:flex;flex-wrap:wrap;gap:6px;font-size:11.5px;color:var(--fg2)\"></div>\n      <div class=\"row\">\n        <input id=\"fs-path\" type=\"text\" placeholder=\"相对路径，如 docs/openapi.json 或 docs/adr.md\" style=\"flex:1\">\n        <select id=\"fs-target\" style=\"width:128px\"><option value=\"openapi\">OpenAPI 3.0</option><option value=\"typescript\">TypeScript</option><option value=\"adr\">ADR Markdown</option><option value=\"snapshot\">架构快照 JSON</option></select>\n      </div>\n      <div class=\"row\" style=\"justify-content:flex-end\">\n        <button id=\"fs-btn-read\" class=\"btn sm\" type=\"button\">从项目读取</button>\n        <button id=\"fs-btn-write\" class=\"btn sm primary\" type=\"button\">同步发布到项目</button>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\n(() => {\n  const plugin = globalThis.nmasPlugin;\n  const $ = id => document.getElementById(id);\n  const SVG_NS = 'http://www.w3.org/2000/svg';\n  const KIND_META = {\n    gateway: { label: 'Gateway', color: '#2563eb' },\n    service: { label: 'Service', color: '#059669' },\n    queue: { label: 'Queue', color: '#d97706' },\n    db: { label: 'DB', color: '#7c3aed' },\n    external: { label: 'External', color: '#64748b' },\n  };\n  const STATUS_CLS = { draft: '', review: 'warn', stable: 'ok', deprecated: 'danger' };\n\n  const S = {\n    revision: 0, services: [], edges: [], endpoints: [], schemas: [],\n    analysis: { metrics: [], cycles: [], cycle_edge_ids: [], warnings: [], stable_ratio: 0 },\n    view: 'topology', busy: false, canInsert: false,\n    selSvcId: null, selEpId: null, selScId: null,\n    editSvcId: null, cgTarget: 'openapi', cgCode: '',\n    epDraft: null, scDraft: null,\n  };\n\n  function el(tag, props, ...kids) {\n    const n = document.createElement(tag);\n    if (props) for (const [k, v] of Object.entries(props)) {\n      if (k === 'cls') n.className = v;\n      else if (k === 'on') for (const [ev, fn] of Object.entries(v)) n.addEventListener(ev, fn);\n      else if (k === 'css') n.style.cssText = v;\n      else n[k] = v;\n    }\n    for (const c of kids) if (c != null) n.append(typeof c === 'string' ? document.createTextNode(c) : c);\n    return n;\n  }\n  function svg(tag, attrs, text) {\n    const n = document.createElementNS(SVG_NS, tag);\n    if (attrs) for (const [k, v] of Object.entries(attrs)) n.setAttribute(k, String(v));\n    if (text != null) n.textContent = String(text);\n    return n;\n  }\n  const setStatus = (t, k = '') => { $('status-text').textContent = t; $('status-bar').dataset.kind = k; $('rev-tag').textContent = `rev #${S.revision}`; };\n  const svcOf = id => S.services.find(s => s.id === id);\n  const metricOf = id => S.analysis.metrics.find(m => m.service_id === id) || { fan_in: 0, fan_out: 0, endpoint_count: 0, in_cycle: false };\n\n  async function busyRun(errLabel, fn) {\n    if (S.busy) return;\n    S.busy = true;\n    try { await fn(); } catch (e) { setStatus(`${errLabel}：${e?.message || '未知错误'}`, 'error'); } finally { S.busy = false; }\n  }\n\n  function switchView(v) {\n    S.view = v;\n    document.querySelectorAll('.nav-btn').forEach(b => b.classList.toggle('active', b.dataset.view === v));\n    document.querySelectorAll('.view').forEach(s => { s.hidden = s.id !== `view-${v}`; });\n    render();\n    if (v === 'codegen') void runCodegen();\n  }\n\n  function render() {\n    $('kpi-svc').textContent = `${S.services.length} / ${S.edges.length}`;\n    $('kpi-ep').textContent = S.endpoints.length;\n    $('kpi-stable').textContent = `${S.analysis.stable_ratio}%`;\n    $('kpi-sc').textContent = S.schemas.length;\n    $('bd-svc').textContent = S.services.length;\n    $('bd-ep').textContent = S.endpoints.length;\n    $('bd-sc').textContent = S.schemas.length;\n\n    const cycN = S.analysis.cycles.length;\n    $('kpi-cycle').textContent = cycN ? `${cycN} 条循环依赖` : '0 循环依赖';\n    $('kpi-cycle-sub').textContent = cycN ? '点击查看标红路径' : '依赖拓扑无环';\n    $('kpi-cycle-dot').style.background = cycN ? 'var(--danger)' : 'var(--ok)';\n    $('kpi-cycle-chip').classList.toggle('alert', cycN > 0);\n\n    if (S.view === 'topology') renderTopology();\n    else if (S.view === 'endpoints') renderEndpoints();\n    else if (S.view === 'codegen') renderCodegenFilters();\n    else renderSchemas();\n  }\n\n  /* ========== VIEW 1: TOPOLOGY SVG CANVAS ========== */\n  function renderTopology() {\n    const banner = $('cycle-banner');\n    banner.replaceChildren();\n    if (S.analysis.warnings.length) {\n      banner.hidden = false;\n      banner.appendChild(el('strong', null, `架构诊断告警 (${S.analysis.warnings.length})`));\n      for (const w of S.analysis.warnings) banner.appendChild(el('div', null, `• ${w}`));\n    } else {\n      banner.hidden = true;\n    }\n\n    const root = $('topo-svg'); root.replaceChildren();\n    if (!S.services.length) {\n      root.appendChild(svg('text', { x: 410, y: 220, 'text-anchor': 'middle', fill: 'currentColor', opacity: .55, 'font-size': 14 }, '当前项目暂无服务拓扑，点击左下角「载入电商风控演示」或右上角「+ 服务节点」开始设计。'));\n      renderTopoInspector();\n      return;\n    }\n\n    const defs = svg('defs');\n    const pat = svg('pattern', { id: 'bgrid', width: 20, height: 20, patternUnits: 'userSpaceOnUse' });\n    pat.appendChild(svg('circle', { cx: 2, cy: 2, r: 1, fill: 'currentColor', opacity: .13 }));\n    defs.appendChild(pat);\n    for (const [id, col] of [['arr-norm', '#64748b'], ['arr-hi', '#2563eb'], ['arr-cyc', '#dc2626']]) {\n      const m = svg('marker', { id, viewBox: '0 0 10 10', refX: 8, refY: 5, markerWidth: 6.5, markerHeight: 6.5, orient: 'auto' });\n      m.appendChild(svg('path', { d: 'M0,1 L9,5 L0,9 z', fill: col }));\n      defs.appendChild(m);\n    }\n    root.append(defs, svg('rect', { width: 820, height: 460, fill: 'url(#bgrid)' }));\n\n    // Group services into 4 vertical tiers\n    const tiers = [[], [], [], []];\n    for (const s of S.services) tiers[Math.max(0, Math.min(3, s.tier))].push(s);\n    const tierNames = ['Tier 0 · 接入网关', 'Tier 1 · 核心服务', 'Tier 2 · 支撑 / 异步', 'Tier 3 · 存储 / 外部'];\n    const colX = [108, 310, 514, 714], nodeW = 152, nodeH = 74;\n    const pos = new Map();\n\n    tiers.forEach((arr, t) => {\n      root.appendChild(svg('text', { x: colX[t], y: 24, 'text-anchor': 'middle', fill: 'currentColor', opacity: .45, 'font-size': 11, 'font-weight': 600 }, tierNames[t]));\n      if (t > 0) root.appendChild(svg('line', { x1: colX[t] - 101, y1: 34, x2: colX[t] - 101, y2: 446, stroke: 'currentColor', opacity: .07, 'stroke-dasharray': '4 4' }));\n      const span = 396, step = arr.length ? span / arr.length : 0;\n      arr.forEach((s, idx) => {\n        pos.set(s.id, { x: colX[t], y: 54 + step * (idx + 0.5) });\n      });\n    });\n\n    const cycEdges = new Set(S.analysis.cycle_edge_ids);\n    const sel = S.selSvcId && svcOf(S.selSvcId) ? S.selSvcId : null;\n\n    // Draw edges\n    const eg = svg('g');\n    S.edges.forEach((e, idx) => {\n      const a = pos.get(e.from), b = pos.get(e.to); if (!a || !b) return;\n      const isCyc = cycEdges.has(e.id);\n      const isRel = !sel || e.from === sel || e.to === sel;\n      const dx = b.x - a.x, dy = b.y - a.y;\n      const sx = a.x + (Math.abs(dx) > 40 ? (dx > 0 ? nodeW / 2 : -nodeW / 2) : 0);\n      const sy = a.y + (Math.abs(dx) <= 40 ? (dy > 0 ? nodeH / 2 : -nodeH / 2) : 0);\n      const tx = b.x - (Math.abs(dx) > 40 ? (dx > 0 ? nodeW / 2 + 4 : -(nodeW / 2 + 4)) : 0);\n      const ty = b.y - (Math.abs(dx) <= 40 ? (dy > 0 ? nodeH / 2 + 4 : -(nodeH / 2 + 4)) : 0);\n\n      // Offset parallel/reverse edges so bidirectional cycles are clearly separated\n      const revExists = S.edges.some(o => o.from === e.to && o.to === e.from);\n      const bend = revExists ? (e.from < e.to ? -40 : 40) : ((idx % 2 ? 1 : -1) * 14);\n      const mx = (sx + tx) / 2 + (Math.abs(dx) <= 40 ? bend * 1.4 : 0);\n      const my = (sy + ty) / 2 + (Math.abs(dx) > 40 ? bend : 0);\n      const stroke = isCyc ? '#dc2626' : (sel && isRel ? '#2563eb' : '#64748b');\n\n      eg.appendChild(svg('path', {\n        d: `M${sx.toFixed(1)} ${sy.toFixed(1)} Q${mx.toFixed(1)} ${my.toFixed(1)} ${tx.toFixed(1)} ${ty.toFixed(1)}`,\n        fill: 'none', stroke, 'stroke-width': isCyc ? 2.6 : (sel && isRel ? 2.2 : 1.6),\n        'stroke-dasharray': isCyc ? '6 3' : (e.protocol === 'Event' ? '4 3' : ''),\n        opacity: isRel || isCyc ? .95 : .2,\n        'marker-end': isCyc ? 'url(#arr-cyc)' : (sel && isRel ? 'url(#arr-hi)' : 'url(#arr-norm)'),\n      }));\n\n      // Protocol badge at midpoint\n      const lx = 0.25 * sx + 0.5 * mx + 0.25 * tx, ly = 0.25 * sy + 0.5 * my + 0.25 * ty;\n      const bgW = e.protocol.length * 7 + 14;\n      const grp = svg('g', { opacity: isRel || isCyc ? 1 : .22 });\n      grp.appendChild(svg('rect', { x: lx - bgW / 2, y: ly - 9, width: bgW, height: 18, rx: 5, fill: isCyc ? '#dc2626' : '#1e293b' }));\n      grp.appendChild(svg('text', { x: lx, y: ly + 3.5, 'text-anchor': 'middle', fill: '#fff', 'font-size': 9.5, 'font-weight': 700 }, e.protocol));\n      grp.appendChild(svg('title', null, `${e.from} → ${e.to} [${e.protocol}] ${e.label}`));\n      eg.appendChild(grp);\n    });\n    root.appendChild(eg);\n\n    // Draw service nodes\n    const ng = svg('g');\n    for (const s of S.services) {\n      const p = pos.get(s.id), km = KIND_META[s.kind] || KIND_META.service, m = metricOf(s.id);\n      const x = p.x - nodeW / 2, y = p.y - nodeH / 2, isSel = s.id === sel;\n      const g = svg('g', { transform: `translate(${x.toFixed(1)},${y.toFixed(1)})`, style: 'cursor:pointer' });\n\n      if (m.in_cycle) {\n        g.appendChild(svg('rect', { x: -4, y: -4, width: nodeW + 8, height: nodeH + 8, rx: 13, fill: '#dc2626', opacity: .16 }));\n      }\n      g.appendChild(svg('rect', {\n        width: nodeW, height: nodeH, rx: 10, fill: 'var(--surface)',\n        stroke: m.in_cycle ? '#dc2626' : (isSel ? 'var(--accent)' : 'var(--border)'),\n        'stroke-width': m.in_cycle || isSel ? 2.4 : 1.3,\n      }));\n      // Left color stripe\n      g.appendChild(svg('rect', { x: 0, y: 0, width: 6, height: nodeH, rx: 3, fill: m.in_cycle ? '#dc2626' : km.color }));\n      // Kind tag\n      g.appendChild(svg('text', { x: 14, y: 17, fill: m.in_cycle ? '#dc2626' : km.color, 'font-size': 9.5, 'font-weight': 700 }, m.in_cycle ? `${km.label} · CYCLE!` : km.label));\n      g.appendChild(svg('text', { x: nodeW - 8, y: 17, 'text-anchor': 'end', fill: 'currentColor', opacity: .55, 'font-size': 9.5 }, `${m.endpoint_count} API`));\n      // Service name & id\n      const nm = s.name.length > 11 ? s.name.slice(0, 11) + '…' : s.name;\n      g.appendChild(svg('text', { x: 14, y: 36, fill: 'currentColor', 'font-size': 12.5, 'font-weight': 700 }, nm));\n      g.appendChild(svg('text', { x: 14, y: 50, fill: 'currentColor', opacity: .55, 'font-size': 10, 'font-family': 'ui-monospace,monospace' }, s.id));\n      // Fan-in / Fan-out bar\n      g.appendChild(svg('text', { x: 14, y: 65, fill: 'currentColor', opacity: .75, 'font-size': 9.5, 'font-weight': 600 }, `IN:${m.fan_in}  OUT:${m.fan_out}`));\n      if (s.owner) g.appendChild(svg('text', { x: nodeW - 8, y: 65, 'text-anchor': 'end', fill: 'currentColor', opacity: .48, 'font-size': 9.5 }, s.owner.slice(0, 10)));\n\n      g.addEventListener('click', () => { S.selSvcId = s.id; renderTopology(); });\n      ng.appendChild(g);\n    }\n    root.appendChild(ng);\n    renderTopoInspector();\n  }\n\n  function renderTopoInspector() {\n    const box = $('topo-inspector'); box.replaceChildren();\n    const s = S.selSvcId ? svcOf(S.selSvcId) : null;\n    if (!s) {\n      box.append(\n        el('div', { cls: 'ptitle' }, '节点耦合度与依赖透视'),\n        el('p', { cls: 'muted' }, '点击左侧拓扑画布中的任意服务节点，查看扇入/扇出耦合度、上下游调用链，并支持一键断开循环依赖边。')\n      );\n      if (S.services.length === 0) {\n        box.appendChild(el('button', { type: 'button', cls: 'btn primary', on: { click: () => void loadDemo() } }, '载入分布式电商风控演示'));\n      }\n      return;\n    }\n    const km = KIND_META[s.kind] || KIND_META.service, m = metricOf(s.id);\n    const cycEdges = new Set(S.analysis.cycle_edge_ids);\n    const relEdges = S.edges.filter(e => e.from === s.id || e.to === s.id);\n    const svcEps = S.endpoints.filter(ep => ep.service_id === s.id);\n\n    const eList = el('div', { css: 'display:flex;flex-direction:column;gap:6px' });\n    if (!relEdges.length) eList.appendChild(el('span', { cls: 'muted' }, '暂无关联依赖边'));\n    for (const e of relEdges) {\n      const isOut = e.from === s.id, isCyc = cycEdges.has(e.id);\n      eList.appendChild(el('div', { cls: `edge-item${isCyc ? ' cyc' : ''}` },\n        el('div', null,\n          el('div', { css: 'font-weight:600' }, `${isOut ? '→ ' + e.to : '← ' + e.from} `, el('span', { cls: 'pill' }, e.protocol)),\n          el('div', { cls: 'muted' }, e.label || (isCyc ? '位于循环依赖环上' : ''))\n        ),\n        el('button', { type: 'button', cls: 'btn sm danger', title: '断开此依赖边', on: { click: () => void deleteEdge(e.id) } }, '断开')\n      ));\n    }\n\n    const epWrap = el('div', { cls: 'row' });\n    if (!svcEps.length) epWrap.appendChild(el('span', { cls: 'muted' }, '暂无 API 契约'));\n    for (const ep of svcEps) {\n      epWrap.appendChild(el('button', { type: 'button', cls: 'btn sm', on: { click: () => { S.selEpId = ep.id; S.epDraft = null; switchView('endpoints'); } } }, `${ep.method} ${ep.path}`));\n    }\n\n    box.append(\n      el('div', { cls: 'row', css: 'justify-content:space-between' },\n        el('span', { cls: 'pill' }, el('span', { cls: 'dot', css: `background:${km.color}` }), km.label),\n        m.in_cycle ? el('span', { cls: 'pill danger' }, '环依赖节点') : el('span', { cls: 'pill ok' }, '无环')\n      ),\n      el('div', null, el('div', { css: 'font-weight:700;font-size:15px' }, s.name), el('div', { cls: 'muted mono' }, `${s.id}${s.owner ? ' · ' + s.owner : ''}`)),\n      s.description ? el('div', { cls: 'muted', css: 'font-size:12.5px;color:var(--fg2)' }, s.description) : null,\n      el('div', { cls: 'mgrid' },\n        el('div', { cls: 'mbox' }, el('b', null, String(m.fan_in)), el('span', null, '入度 Fan-in')),\n        el('div', { cls: 'mbox' }, el('b', null, String(m.fan_out)), el('span', null, '出度 Fan-out')),\n        el('div', { cls: 'mbox' }, el('b', null, String(m.endpoint_count)), el('span', null, 'API 数'))\n      ),\n      el('div', null, el('div', { cls: 'muted', css: 'margin-bottom:5px;font-weight:600' }, `依赖连线 (${relEdges.length})`), eList),\n      el('div', null, el('div', { cls: 'muted', css: 'margin-bottom:5px;font-weight:600' }, `所属 API (${svcEps.length})`), epWrap),\n      el('div', { cls: 'row', css: 'margin-top:auto' },\n        el('button', { type: 'button', cls: 'btn sm primary', on: { click: () => openServiceModal(s.id) } }, '编辑节点'),\n        el('button', { type: 'button', cls: 'btn sm', on: { click: () => openEdgeModal(s.id) } }, '+ 出边')\n      )\n    );\n  }\n\n  /* ========== VIEW 2: API ENDPOINTS CATALOG & EDITOR ========== */\n  function renderEndpoints() {\n    const sf = $('ep-filter-svc'), prevSf = sf.value;\n    sf.replaceChildren(el('option', { value: '' }, '全部服务'));\n    for (const s of S.services) sf.appendChild(el('option', { value: s.id }, s.name));\n    if (prevSf && svcOf(prevSf)) sf.value = prevSf;\n\n    const kw = $('ep-search').value.trim().toLowerCase(), fSvc = sf.value, fM = $('ep-filter-method').value, fSt = $('ep-filter-status').value;\n    const shown = S.endpoints.filter(ep => (!fSvc || ep.service_id === fSvc) && (!fM || ep.method === fM) && (!fSt || ep.status === fSt) && (!kw || `${ep.path} ${ep.summary} ${ep.id}`.toLowerCase().includes(kw)));\n    $('ep-count').textContent = shown.length;\n\n    const list = $('ep-list'); list.replaceChildren();\n    if (!shown.length) list.appendChild(el('p', { cls: 'muted' }, S.endpoints.length ? '没有匹配的接口。' : '暂无 API 契约，点击「+ 新增 API」创建。'));\n    for (const ep of shown) {\n      const svc = svcOf(ep.service_id);\n      list.appendChild(el('button', {\n        type: 'button', cls: `list-row${ep.id === S.selEpId ? ' active' : ''}`,\n        on: { click: () => { S.selEpId = ep.id; S.epDraft = structuredClone(ep); renderEndpoints(); } },\n      },\n        el('div', { cls: 'row' }, el('span', { cls: `m-badge m-${ep.method}` }, ep.method), el('span', { cls: 'mono', css: 'font-size:12.5px;font-weight:600;word-break:break-all' }, ep.path)),\n        el('div', { cls: 'row', css: 'justify-content:space-between' },\n          el('span', { cls: 'muted' }, `${ep.summary} · ${svc ? svc.name : ep.service_id}`),\n          el('span', { cls: `pill ${STATUS_CLS[ep.status] || ''}` }, ep.status)\n        )\n      ));\n    }\n\n    if (!S.epDraft && S.selEpId) {\n      const found = S.endpoints.find(x => x.id === S.selEpId);\n      if (found) S.epDraft = structuredClone(found);\n    }\n    if (!S.epDraft && shown.length) {\n      S.selEpId = shown[0].id;\n      S.epDraft = structuredClone(shown[0]);\n    }\n    renderEndpointEditor();\n  }\n\n  function renderEndpointEditor() {\n    const box = $('ep-editor'); box.replaceChildren();\n    const d = S.epDraft;\n    if (!d) {\n      box.appendChild(el('div', { cls: 'empty' }, el('p', { cls: 'muted' }, '从左侧选择一条 API 契约编辑，或点击右上角「+ 新增 API」。')));\n      return;\n    }\n    const isNew = !S.endpoints.some(x => x.id === d.id);\n    const mkSel = (opts, val, onCh) => {\n      const s = el('select', { on: { change: e => onCh(e.target.value) } });\n      for (const [ov, ol] of opts) s.appendChild(el('option', { value: ov, selected: ov === val }, ol));\n      return s;\n    };\n    const svcOpts = S.services.map(s => [s.id, `${s.name} (${s.id})`]);\n    const scOpts = [['', '— 无 Schema —'], ...S.schemas.map(sc => [sc.id, `${sc.id} (${sc.name})`])];\n\n    const paramList = el('div', { cls: 'sub-table' });\n    d.params.forEach((p, idx) => {\n      paramList.appendChild(el('div', { cls: 'sub-row param-row' },\n        el('input', { type: 'text', value: p.name, placeholder: '参数名', on: { input: e => { p.name = e.target.value; } } }),\n        mkSel([['path','path'],['query','query'],['header','header']], p.in, v => { p.in = v; }),\n        mkSel([['string','string'],['integer','integer'],['number','number'],['boolean','boolean']], p.type, v => { p.type = v; }),\n        el('label', { cls: 'row', css: 'gap:3px;font-size:11.5px' }, el('input', { type: 'checkbox', checked: p.required, css: 'width:auto', on: { change: e => { p.required = e.target.checked; } } }), '必填'),\n        el('input', { type: 'text', value: p.description, placeholder: '说明', on: { input: e => { p.description = e.target.value; } } }),\n        el('button', { type: 'button', cls: 'btn sm danger', on: { click: () => { d.params.splice(idx, 1); renderEndpointEditor(); } } }, '×')\n      ));\n    });\n\n    const errList = el('div', { cls: 'sub-table' });\n    d.error_codes.forEach((er, idx) => {\n      errList.appendChild(el('div', { cls: 'sub-row err-row' },\n        el('input', { type: 'number', min: 400, max: 599, value: er.code, on: { input: e => { er.code = Number(e.target.value) || 400; } } }),\n        el('input', { type: 'text', value: er.message, placeholder: '错误语义', on: { input: e => { er.message = e.target.value; } } }),\n        el('button', { type: 'button', cls: 'btn sm danger', on: { click: () => { d.error_codes.splice(idx, 1); renderEndpointEditor(); } } }, '×')\n      ));\n    });\n\n    box.append(\n      el('div', { cls: 'phead' },\n        el('h2', { cls: 'ptitle' }, isNew ? '新建 API 契约' : `编辑契约 · ${d.id}`),\n        el('div', { cls: 'row' },\n          !isNew ? el('button', { type: 'button', cls: 'btn sm danger', on: { click: () => void deleteEndpoint(d.id) } }, '删除') : null,\n          el('button', { type: 'button', cls: 'btn sm primary', on: { click: () => void saveEndpoint() } }, '保存契约')\n        )\n      ),\n      el('div', { cls: 'row', css: 'margin-bottom:10px' },\n        el('label', { cls: 'field', css: 'width:105px' }, el('span', null, '方法'), mkSel(['GET','POST','PUT','PATCH','DELETE'].map(x => [x, x]), d.method, v => { d.method = v; })),\n        el('label', { cls: 'field', css: 'flex:1;min-width:180px' }, el('span', null, '接口路径'), el('input', { type: 'text', cls: 'mono', value: d.path, placeholder: '/v1/orders/{orderId}', on: { input: e => { d.path = e.target.value; } } })),\n        el('label', { cls: 'field', css: 'width:165px' }, el('span', null, '所属服务'), mkSel(svcOpts, d.service_id, v => { d.service_id = v; }))\n      ),\n      el('div', { cls: 'row', css: 'margin-bottom:10px' },\n        el('label', { cls: 'field', css: 'flex:1;min-width:170px' }, el('span', null, '接口摘要'), el('input', { type: 'text', value: d.summary, placeholder: '简述接口业务语义', on: { input: e => { d.summary = e.target.value; } } })),\n        el('label', { cls: 'field', css: 'width:118px' }, el('span', null, '鉴权'), mkSel(['none','bearer','api_key','mtls','oauth2'].map(x => [x, x]), d.auth, v => { d.auth = v; })),\n        el('label', { cls: 'field', css: 'width:118px' }, el('span', null, '状态'), mkSel(['draft','review','stable','deprecated'].map(x => [x, x]), d.status, v => { d.status = v; }))\n      ),\n      el('div', { cls: 'row', css: 'margin-bottom:12px' },\n        el('label', { cls: 'field', css: 'flex:1' }, el('span', null, 'Request Schema'), mkSel(scOpts, d.request_schema, v => { d.request_schema = v; })),\n        el('label', { cls: 'field', css: 'flex:1' }, el('span', null, 'Response Schema'), mkSel(scOpts, d.response_schema, v => { d.response_schema = v; }))\n      ),\n      el('div', { css: 'margin-bottom:12px' },\n        el('div', { cls: 'phead', css: 'margin-bottom:6px' }, el('span', { css: 'font-size:12.5px;font-weight:700' }, `请求参数 (${d.params.length})`), el('button', { type: 'button', cls: 'btn sm', on: { click: () => { d.params.push({ name: '', in: 'query', type: 'string', required: false, description: '' }); renderEndpointEditor(); } } }, '+ 添加参数')),\n        paramList\n      ),\n      el('div', null,\n        el('div', { cls: 'phead', css: 'margin-bottom:6px' }, el('span', { css: 'font-size:12.5px;font-weight:700' }, `错误码定义 (${d.error_codes.length})`), el('button', { type: 'button', cls: 'btn sm', on: { click: () => { d.error_codes.push({ code: 400, message: '' }); renderEndpointEditor(); } } }, '+ 添加错误码')),\n        errList\n      )\n    );\n  }\n\n  /* ========== VIEW 3: CODEGEN ========== */\n  function renderCodegenFilters() {\n    const sel = $('cg-service'), prev = sel.value;\n    sel.replaceChildren(el('option', { value: '' }, '全部服务契约'));\n    for (const s of S.services) sel.appendChild(el('option', { value: s.id }, s.name));\n    if (prev && svcOf(prev)) sel.value = prev;\n    $('btn-cg-insert').hidden = !S.canInsert;\n  }\n\n  async function runCodegen() {\n    renderCodegenFilters();\n    try {\n      const r = await plugin.action('arch.codegen', { target: S.cgTarget, service_id: $('cg-service').value || '' });\n      S.cgCode = r.code;\n      $('cg-code').textContent = r.code;\n      $('cg-meta').textContent = `${r.endpoint_count} 接口 · ${r.schema_count} Schema · ${r.code.length} 字符${r.truncated ? ' (已截断)' : ''}`;\n    } catch (e) {\n      $('cg-code').textContent = `// 编译失败：${e?.message || '未知错误'}`;\n    }\n  }\n\n  /* ========== VIEW 4: SCHEMA CENTER ========== */\n  function renderSchemas() {\n    $('sc-count').textContent = S.schemas.length;\n    const list = $('sc-list'); list.replaceChildren();\n    if (!S.schemas.length) list.appendChild(el('p', { cls: 'muted' }, '暂无共享模型，点击「+ 新建 Schema」创建。'));\n    for (const sc of S.schemas) {\n      const refs = S.endpoints.filter(ep => ep.request_schema === sc.id || ep.response_schema === sc.id).length;\n      list.appendChild(el('button', {\n        type: 'button', cls: `list-row${sc.id === S.selScId ? ' active' : ''}`,\n        on: { click: () => { S.selScId = sc.id; S.scDraft = structuredClone(sc); renderSchemas(); } },\n      },\n        el('div', { cls: 'row', css: 'justify-content:space-between' }, el('strong', { cls: 'mono' }, sc.id), el('span', { cls: 'pill purple' }, sc.kind)),\n        el('div', { cls: 'muted' }, `${sc.name} · ${sc.fields.length} 字段 · 被 ${refs} 个接口引用`)\n      ));\n    }\n    if (!S.scDraft && S.selScId) { const f = S.schemas.find(x => x.id === S.selScId); if (f) S.scDraft = structuredClone(f); }\n    if (!S.scDraft && S.schemas.length) { S.selScId = S.schemas[0].id; S.scDraft = structuredClone(S.schemas[0]); }\n    renderSchemaEditor();\n  }\n\n  function renderSchemaEditor() {\n    const box = $('sc-editor'); box.replaceChildren();\n    const d = S.scDraft;\n    if (!d) { box.appendChild(el('div', { cls: 'empty' }, el('p', { cls: 'muted' }, '选择左侧 Schema 或点击「+ 新建 Schema」定义共享 DTO / Entity。'))); return; }\n    const isNew = !S.schemas.some(x => x.id === d.id);\n    const flist = el('div', { cls: 'sub-table' });\n    d.fields.forEach((f, idx) => {\n      const tSel = el('select', { on: { change: e => { f.type = e.target.value; renderSchemaEditor(); } } });\n      for (const tp of ['string','integer','number','boolean','object','array']) tSel.appendChild(el('option', { value: tp, selected: tp === f.type }, tp));\n      flist.appendChild(el('div', { cls: 'sub-row field-row' },\n        el('input', { type: 'text', cls: 'mono', value: f.name, placeholder: '字段名', on: { input: e => { f.name = e.target.value; } } }),\n        tSel,\n        el('input', { type: 'text', value: f.type === 'array' ? f.item_type : f.ref, placeholder: f.type === 'array' ? '元素类型/Schema' : '引用 Schema ID', on: { input: e => { if (f.type === 'array') f.item_type = e.target.value; else f.ref = e.target.value; } } }),\n        el('label', { cls: 'row', css: 'gap:3px;font-size:11.5px' }, el('input', { type: 'checkbox', checked: f.required, css: 'width:auto', on: { change: e => { f.required = e.target.checked; } } }), '必填'),\n        el('input', { type: 'text', value: f.description, placeholder: '字段说明', on: { input: e => { f.description = e.target.value; } } }),\n        el('button', { type: 'button', cls: 'btn sm danger', on: { click: () => { d.fields.splice(idx, 1); renderSchemaEditor(); } } }, '×')\n      ));\n    });\n\n    const tsLines = [`export interface ${d.id || 'UnnamedSchema'} {`, ...d.fields.map(f => `  ${f.name || 'field'}${f.required ? '' : '?'}: ${f.ref || (f.type === 'array' ? `${f.item_type || 'string'}[]` : (f.type === 'integer' ? 'number' : f.type))};${f.description ? ` // ${f.description}` : ''}`), '}'];\n\n    box.append(\n      el('div', { cls: 'phead' },\n        el('h2', { cls: 'ptitle' }, isNew ? '新建 Schema 模型' : `编辑模型 · ${d.id}`),\n        el('div', { cls: 'row' },\n          !isNew ? el('button', { type: 'button', cls: 'btn sm danger', on: { click: () => void deleteSchema(d.id) } }, '删除') : null,\n          el('button', { type: 'button', cls: 'btn sm primary', on: { click: () => void saveSchema() } }, '保存模型')\n        )\n      ),\n      el('div', { cls: 'row', css: 'margin-bottom:10px' },\n        el('label', { cls: 'field', css: 'flex:1' }, el('span', null, 'Schema ID (PascalCase)'), el('input', { type: 'text', cls: 'mono', value: d.id, disabled: !isNew, placeholder: 'OrderItemDTO', on: { input: e => { d.id = e.target.value; } } })),\n        el('label', { cls: 'field', css: 'flex:1' }, el('span', null, '中文名称'), el('input', { type: 'text', value: d.name, placeholder: '订单明细模型', on: { input: e => { d.name = e.target.value; } } })),\n        el('label', { cls: 'field', css: 'width:110px' }, el('span', null, '分类'), (() => { const s = el('select', { on: { change: e => { d.kind = e.target.value; } } }); ['dto','entity','event','error'].forEach(k => s.appendChild(el('option', { value: k, selected: k === d.kind }, k))); return s; })())\n      ),\n      el('label', { cls: 'field', css: 'margin-bottom:12px' }, el('span', null, '说明'), el('input', { type: 'text', value: d.description, placeholder: '描述模型用途与约束', on: { input: e => { d.description = e.target.value; } } })),\n      el('div', { css: 'margin-bottom:12px' },\n        el('div', { cls: 'phead', css: 'margin-bottom:6px' }, el('span', { css: 'font-size:12.5px;font-weight:700' }, `字段定义 (${d.fields.length})`), el('button', { type: 'button', cls: 'btn sm', on: { click: () => { d.fields.push({ name: '', type: 'string', item_type: '', ref: '', required: true, description: '' }); renderSchemaEditor(); } } }, '+ 添加字段')),\n        flist\n      ),\n      el('pre', { cls: 'code-box', css: 'max-height:160px' }, tsLines.join('\\n'))\n    );\n  }\n\n  /* ========== MODALS & ACTIONS ========== */\n  function openServiceModal(id) {\n    S.editSvcId = id;\n    const s = id ? svcOf(id) : null;\n    $('ms-title').textContent = s ? `编辑服务 · ${s.id}` : '新增微服务节点';\n    $('btn-ms-del').hidden = !s;\n    $('ms-id').value = s?.id || '';\n    $('ms-id').disabled = Boolean(s);\n    $('ms-name').value = s?.name || '';\n    $('ms-kind').value = s?.kind || 'service';\n    $('ms-tier').value = String(s?.tier ?? 1);\n    $('ms-owner').value = s?.owner || '';\n    $('ms-desc').value = s?.description || '';\n    $('modal-svc').hidden = false;\n  }\n  function openEdgeModal(fromId) {\n    if (S.services.length < 2) { setStatus('请先创建至少 2 个服务节点再添加依赖边。', 'error'); return; }\n    for (const sid of ['me-from', 'me-to']) {\n      const sel = $(sid); sel.replaceChildren();\n      for (const s of S.services) sel.appendChild(el('option', { value: s.id }, `${s.name} (${s.id})`));\n    }\n    if (fromId && svcOf(fromId)) $('me-from').value = fromId;\n    const alt = S.services.find(s => s.id !== $('me-from').value);\n    if (alt) $('me-to').value = alt.id;\n    $('me-label').value = '';\n    $('modal-edge').hidden = false;\n  }\n\n  async function refresh(msg) {\n    if (typeof plugin?.action !== 'function') { setStatus('请在 Velai Desktop 中打开此插件。', 'error'); return; }\n    try {\n      const caps = await plugin.action('host.capabilities', {}).catch(() => ({ actions: [] }));\n      S.canInsert = Array.isArray(caps?.actions) && caps.actions.includes('host.draft.insert');\n      const r = await plugin.action('arch.state', {});\n      Object.assign(S, { revision: r.revision, services: r.services, edges: r.edges, endpoints: r.endpoints, schemas: r.schemas, analysis: r.analysis });\n      render();\n      setStatus(msg || `已同步 ${S.services.length} 服务 · ${S.edges.length} 依赖边 · ${S.endpoints.length} API 契约`);\n      if (S.view === 'codegen') void runCodegen();\n    } catch (e) { setStatus(`读取失败：${e?.message || '未知错误'}`, 'error'); }\n  }\n\n  const loadDemo = () => busyRun('载入演示失败', async () => {\n    const r = await plugin.action('arch.demo.load', { expected_revision: S.revision });\n    if (r.status === 'loaded') { S.selSvcId = 'order-svc'; S.selEpId = null; S.epDraft = null; S.selScId = null; S.scDraft = null; await refresh(`已载入电商风控演示：${r.services_count} 服务、${r.endpoints_count} 接口、${r.schemas_count} 模型。`); }\n    else { setStatus(`载入冲突：${r.status}`, 'error'); await refresh(); }\n  });\n  const deleteEdge = id => busyRun('断开依赖边失败', async () => {\n    const r = await plugin.action('arch.edge.delete', { expected_revision: S.revision, id });\n    if (r.status === 'deleted') await refresh('已断开依赖边并重新分析拓扑环依赖。');\n    else setStatus(`断开失败：${r.status}`, 'error');\n  });\n  const saveEndpoint = () => busyRun('保存契约失败', async () => {\n    const d = S.epDraft; if (!d) return;\n    if (!d.path.startsWith('/') || !d.summary.trim()) { setStatus('请填写以 / 开头的路径与接口摘要。', 'error'); return; }\n    const r = await plugin.action('arch.endpoint.save', {\n      expected_revision: S.revision, id: d.id, service_id: d.service_id, method: d.method, path: d.path.trim(),\n      summary: d.summary.trim(), auth: d.auth, status: d.status,\n      params: d.params.filter(p => p.name.trim()), request_schema: d.request_schema, response_schema: d.response_schema,\n      error_codes: d.error_codes.filter(e => e.code >= 400 && e.code <= 599 && e.message.trim()),\n    });\n    if (r.status === 'saved') { S.selEpId = r.endpoint_id; S.epDraft = null; await refresh('API 契约已保存。'); }\n    else setStatus(`保存失败：${r.status}`, 'error');\n  });\n  const deleteEndpoint = id => busyRun('删除契约失败', async () => {\n    const r = await plugin.action('arch.endpoint.delete', { expected_revision: S.revision, id });\n    if (r.status === 'deleted') { S.selEpId = null; S.epDraft = null; await refresh('已删除 API 契约。'); }\n    else setStatus(`删除失败：${r.status}`, 'error');\n  });\n  const saveSchema = () => busyRun('保存模型失败', async () => {\n    const d = S.scDraft; if (!d) return;\n    if (!d.id.trim() || !d.name.trim()) { setStatus('请填写 Schema ID 与名称。', 'error'); return; }\n    const r = await plugin.action('arch.schema.save', {\n      expected_revision: S.revision, id: d.id.trim(), name: d.name.trim(), kind: d.kind,\n      description: d.description.trim(), fields: d.fields.filter(f => f.name.trim()),\n    });\n    if (r.status === 'saved') { S.selScId = d.id.trim(); S.scDraft = null; await refresh(`Schema ${d.id.trim()} 已保存。`); }\n    else setStatus(`保存失败：${r.status}`, 'error');\n  });\n  const deleteSchema = id => busyRun('删除模型失败', async () => {\n    const r = await plugin.action('arch.schema.delete', { expected_revision: S.revision, id });\n    if (r.status === 'deleted') { S.selScId = null; S.scDraft = null; await refresh('已删除 Schema 并清理失效引用。'); }\n    else setStatus(`删除失败：${r.status}`, 'error');\n  });\n\n  function startNewEndpoint() {\n    if (!S.services.length) { setStatus('请先创建至少一个服务节点。', 'error'); openServiceModal(null); return; }\n    const id = `ep-${Date.now().toString(36)}`;\n    S.selEpId = id;\n    S.epDraft = { id, service_id: S.selSvcId || S.services[0].id, method: 'GET', path: '/v1/resource', summary: '', auth: 'bearer', status: 'draft', params: [], request_schema: '', response_schema: '', error_codes: [] };\n    switchView('endpoints');\n  }\n\n  /* Wiring */\n  document.querySelectorAll('.nav-btn').forEach(b => b.addEventListener('click', () => switchView(b.dataset.view)));\n  document.querySelectorAll('[data-close]').forEach(b => b.addEventListener('click', () => { $(b.dataset.close).hidden = true; }));\n  $('btn-demo').addEventListener('click', () => void loadDemo());\n  $('btn-add-svc').addEventListener('click', () => openServiceModal(null));\n  $('btn-add-edge').addEventListener('click', () => openEdgeModal(S.selSvcId));\n  $('btn-add-ep').addEventListener('click', startNewEndpoint);\n  $('btn-ep-new2').addEventListener('click', startNewEndpoint);\n  $('kpi-cycle-chip').addEventListener('click', () => switchView('topology'));\n  $('btn-sc-new').addEventListener('click', () => {\n    S.selScId = '';\n    S.scDraft = { id: '', name: '', kind: 'dto', description: '', fields: [{ name: 'id', type: 'string', item_type: '', ref: '', required: true, description: '主键 ID' }] };\n    renderSchemaEditor();\n  });\n  $('btn-theme').addEventListener('click', () => {\n    const r = document.documentElement;\n    r.dataset.theme = (r.dataset.theme === 'dark' || (!r.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches)) ? 'light' : 'dark';\n  });\n  for (const [id, ev] of [['ep-search','input'],['ep-filter-svc','change'],['ep-filter-method','change'],['ep-filter-status','change']]) $(id).addEventListener(ev, renderEndpoints);\n\n  $('btn-ms-save').addEventListener('click', () => {\n    const id = $('ms-id').value.trim(), name = $('ms-name').value.trim();\n    if (!id || !name) { setStatus('请填写服务 ID 与名称。', 'error'); return; }\n    void busyRun('保存服务失败', async () => {\n      const r = await plugin.action('arch.service.save', { expected_revision: S.revision, id, name, kind: $('ms-kind').value, owner: $('ms-owner').value.trim(), description: $('ms-desc').value.trim(), tier: Number($('ms-tier').value) || 1 });\n      if (r.status === 'saved') { $('modal-svc').hidden = true; S.selSvcId = id; await refresh(`服务 ${name} 已保存。`); }\n      else setStatus(`保存失败：${r.status}`, 'error');\n    });\n  });\n  $('btn-ms-del').addEventListener('click', () => S.editSvcId && void busyRun('删除服务失败', async () => {\n    const r = await plugin.action('arch.service.delete', { expected_revision: S.revision, id: S.editSvcId });\n    if (r.status === 'deleted') { $('modal-svc').hidden = true; S.selSvcId = null; S.epDraft = null; await refresh('已删除服务及其关联边与接口。'); }\n    else setStatus(`删除失败：${r.status}`, 'error');\n  }));\n  $('btn-me-save').addEventListener('click', () => void busyRun('添加依赖边失败', async () => {\n    const r = await plugin.action('arch.edge.save', { expected_revision: S.revision, id: `edge-${Date.now().toString(36)}`, from: $('me-from').value, to: $('me-to').value, protocol: $('me-proto').value, label: $('me-label').value.trim() });\n    if (r.status === 'saved') { $('modal-edge').hidden = true; await refresh('已添加依赖边并刷新环依赖检测。'); }\n    else setStatus(`添加失败：${r.status}`, 'error');\n  }));\n\n  document.querySelectorAll('#cg-tabs button').forEach(b => b.addEventListener('click', () => {\n    S.cgTarget = b.dataset.target;\n    document.querySelectorAll('#cg-tabs button').forEach(x => x.classList.toggle('active', x === b));\n    void runCodegen();\n  }));\n  $('cg-service').addEventListener('change', () => void runCodegen());\n  $('btn-cg-refresh').addEventListener('click', () => void runCodegen());\n  $('btn-cg-copy').addEventListener('click', async () => {\n    if (!S.cgCode) return;\n    try { await navigator.clipboard.writeText(S.cgCode); setStatus('契约代码已复制到剪贴板。', 'ok'); }\n    catch { setStatus('复制失败，请手动选中代码框内容。', 'error'); }\n  });\n  $('btn-cg-insert').addEventListener('click', async () => {\n    if (!S.cgCode) return;\n    const lang = S.cgTarget === 'openapi' ? 'json' : 'ts';\n    const text = `请评审以下由 API Arch Studio 生成的 ${S.cgTarget === 'openapi' ? 'OpenAPI 3.0.3' : 'TypeScript'} 接口契约，重点检查 REST 语义、鉴权边界、字段命名与错误码完整性：\\n\\n\\`\\`\\`${lang}\\n${S.cgCode.slice(0, 6000)}\\n\\`\\`\\``;\n    try {\n      const r = await plugin.action('host.draft.insert', { text });\n      if (r?.inserted) setStatus('已插入当前会话输入框，请发送给 AI 评审。', 'ok');\n      else setStatus('未能确认插入结果，请检查会话输入框。', 'error');\n    } catch (e) { setStatus(`插入失败：${e?.message || '未知错误'}`, 'error'); }\n  });\n\n  $('btn-io').addEventListener('click', async () => {\n    $('modal-io').hidden = false;\n    const sel = $('io-select'); sel.replaceChildren();\n    try {\n      const items = (await plugin.action('document.list', {})).items || [];\n      if (!items.length) sel.appendChild(el('option', { value: 'all' }, '暂无可导出数据'));\n      for (const it of items) sel.appendChild(el('option', { value: it.id }, it.label));\n    } catch (e) { setStatus(`读取导出列表失败：${e?.message || '未知错误'}`, 'error'); }\n  });\n  $('btn-io-exp').addEventListener('click', async () => {\n    try {\n      const r = await plugin.action('document.export', { id: $('io-select').value || 'all' });\n      if (r.error) setStatus(`导出失败：${r.error}`, 'error');\n      else { $('io-text').value = r.text || ''; setStatus(`已导出 ${r.filename}`, 'ok'); }\n    } catch (e) { setStatus(`导出异常：${e?.message || '未知错误'}`, 'error'); }\n  });\n  $('btn-io-copy').addEventListener('click', async () => {\n    const t = $('io-text').value; if (!t) return;\n    try { await navigator.clipboard.writeText(t); setStatus('快照 JSON 已复制。', 'ok'); } catch { $('io-text').select(); setStatus('请按 Ctrl/Cmd+C 复制。'); }\n  });\n  $('btn-io-imp').addEventListener('click', async () => {\n    const t = $('io-text').value.trim(); if (!t) return;\n    try {\n      const r = await plugin.action('document.import', { text: t });\n      if (r.imported) { $('modal-io').hidden = true; S.epDraft = null; S.scDraft = null; await refresh(`导入成功：${r.services_count} 服务 · ${r.endpoints_count} 接口 · ${r.schemas_count} 模型。`); }\n      else setStatus(`导入失败：${r.reason || '格式无效'}`, 'error');\n    } catch (e) { setStatus(`导入异常：${e?.message || '未知错误'}`, 'error'); }\n  });\n\n  let lastFsSha = '';\n  let lastFsPath = '';\n  $('fs-btn-list').addEventListener('click', async () => {\n    const dir = $('fs-dir').value.trim();\n    try {\n      const r = await plugin.action('fs_list', { path: dir, limit: 50 });\n      const box = $('fs-entries');\n      box.replaceChildren();\n      if (r.status !== 'ok') { setStatus(`目录读取失败：${r.error || r.status}`, 'error'); return; }\n      if (!r.entries.length) { box.textContent = '（当前目录为空）'; return; }\n      for (const ent of r.entries) {\n        const b = el('button', { type: 'button', class: 'btn sm' }, ent.kind === 'dir' ? `📁 ${ent.name}/` : `📄 ${ent.name}`);\n        b.addEventListener('click', () => {\n          const next = dir ? `${dir}/${ent.name}` : ent.name;\n          if (ent.kind === 'dir') { $('fs-dir').value = next; $('fs-btn-list').click(); }\n          else { $('fs-path').value = next; }\n        });\n        box.appendChild(b);\n      }\n    } catch (e) { setStatus(`目录浏览异常：${e?.message || '未知错误'}`, 'error'); }\n  });\n  $('fs-btn-read').addEventListener('click', async () => {\n    const relPath = $('fs-path').value.trim();\n    if (!relPath) { setStatus('请输入工作区相对路径。', 'error'); return; }\n    try {\n      const r = await plugin.action('fs_import_doc', { path: relPath });\n      if (r.status === 'ok') {\n        $('io-text').value = r.content;\n        lastFsSha = r.sha256;\n        lastFsPath = relPath;\n        $('fs-sha-hint').textContent = `SHA-256: ${r.sha256.slice(0, 10)}… (${r.size_bytes} B)`;\n        setStatus(`已读取 ${relPath} (${r.format})`, 'ok');\n      } else setStatus(`读取失败：${r.error || r.status}`, 'error');\n    } catch (e) { setStatus(`读取异常：${e?.message || '未知错误'}`, 'error'); }\n  });\n  $('fs-btn-write').addEventListener('click', async () => {\n    const relPath = $('fs-path').value.trim();\n    if (!relPath) { setStatus('请输入目标相对路径。', 'error'); return; }\n    const payload = { target: $('fs-target').value, path: relPath };\n    if (lastFsSha && lastFsPath === relPath) payload.expected_sha256 = lastFsSha;\n    else payload.create_only = true;\n    try {\n      const r = await plugin.action('fs_export_doc', payload);\n      if (r.status === 'written') {\n        lastFsSha = r.sha256;\n        lastFsPath = relPath;\n        $('fs-sha-hint').textContent = `已发布 SHA-256: ${r.sha256.slice(0, 10)}… (${r.size_bytes} B)`;\n        setStatus(`已同步写入 ${relPath} (${r.size_bytes} B)`, 'ok');\n      } else setStatus(`发布未完成 (${r.status})：${r.error || '文件已存在时请先从项目读取获取最新 SHA-256'}`, 'error');\n    } catch (e) { setStatus(`发布异常：${e?.message || '未知错误'}`, 'error'); }\n  });\n\n  void refresh();\n})();\n\n/* === V2 Host Theme & Compact Surface JS Start === */\n(() => {\n  const root = document.documentElement;\n  const BTN_MODE = \"label\";\n  const HAS_SIDEBAR = true;\n  const MAIN_SEL = \".main-col\";\n  const INIT_MQ = true;\n  const VALID_THEMES = new Set(['light', 'dark']);\n  const VALID_SURFACES = new Set(['workspace', 'chat', 'assistant']);\n\n  const normalizeTheme = val => (val === 'light' || val === 'dark' ? val : null);\n\n  if (INIT_MQ && !normalizeTheme(root.getAttribute('data-theme'))) {\n    try {\n      const dark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;\n      root.setAttribute('data-theme', dark ? 'dark' : 'light');\n    } catch {}\n  }\n\n  let hostTheme = normalizeTheme(root.getAttribute('data-theme'));\n\n  function syncThemeButton(theme) {\n    const btn = document.getElementById('btn-theme');\n    if (!btn || !VALID_THEMES.has(theme)) return;\n    btn.setAttribute('aria-pressed', String(theme === 'dark'));\n    btn.dataset.activeTheme = theme;\n    btn.title = theme === 'dark' ? '当前深色主题，点击切换浅色' : '当前浅色主题，点击切换深色';\n    if (BTN_MODE === 'short') {\n      btn.textContent = theme === 'light' ? '☾ 深色' : '☀ 浅色';\n    } else if (BTN_MODE === 'emoji') {\n      const txt = (btn.textContent || '').trim();\n      const rest = txt.replace(/^(?:☀️|☀|🌙|☾|◐)\\s*/, '');\n      btn.textContent = (theme === 'light' ? '🌙 ' : '☀️ ') + (rest || '外观');\n    } else {\n      btn.textContent = theme === 'dark' ? '☀ 切换浅色' : '☾ 切换深色';\n    }\n  }\n\n  function applyHostTheme(raw) {\n    const data = raw && typeof raw === 'object'\n      ? (raw.theme || raw.surface || raw.tokens ? raw : (raw.payload && typeof raw.payload === 'object' ? raw.payload : raw))\n      : null;\n    if (!data || typeof data !== 'object') return;\n    const nextTheme = normalizeTheme(data.theme);\n    if (nextTheme) {\n      hostTheme = nextTheme;\n      root.removeAttribute('data-theme-override');\n      root.setAttribute('data-theme', nextTheme);\n      syncThemeButton(nextTheme);\n    }\n    if (typeof data.surface === 'string' && VALID_SURFACES.has(data.surface)) {\n      root.setAttribute('data-surface', data.surface);\n    }\n    if (data.tokens && typeof data.tokens === 'object') {\n      for (const [k, v] of Object.entries(data.tokens)) {\n        if (typeof v === 'string' && k) {\n          try { root.style.setProperty(k.startsWith('--') ? k : '--' + k, v); } catch {}\n        }\n      }\n    }\n  }\n\n  const initialTheme = normalizeTheme(root.getAttribute('data-theme'));\n  if (initialTheme) syncThemeButton(initialTheme);\n\n  const themeBtn = document.getElementById('btn-theme');\n  if (themeBtn) {\n    themeBtn.addEventListener('click', () => {\n      const cur = normalizeTheme(root.getAttribute('data-theme'));\n      if (!cur) return;\n      if (hostTheme && cur !== hostTheme) root.setAttribute('data-theme-override', '1');\n      else root.removeAttribute('data-theme-override');\n      syncThemeButton(cur);\n    });\n  }\n\n  try {\n    window.addEventListener('host.theme.changed', ev => {\n      try { applyHostTheme(ev && typeof ev === 'object' && 'detail' in ev ? ev.detail : ev); } catch {}\n    });\n  } catch {}\n  try {\n    const sub = globalThis.nmasPlugin?.subscribe?.('host.theme.changed', payload => {\n      try { applyHostTheme(payload); } catch {}\n    });\n    if (sub && typeof sub.catch === 'function') sub.catch(() => {});\n  } catch {}\n\n  if (HAS_SIDEBAR) {\n    const sidebar = document.querySelector('.sidebar');\n    const hostMain = document.querySelector(MAIN_SEL) || document.querySelector('.main, .main-area, .main-col, .workspace');\n    const srcBtns = sidebar ? Array.from(sidebar.querySelectorAll('button[data-view]')) : [];\n    if (sidebar && hostMain && srcBtns.length > 0 && !hostMain.querySelector('.v2-surface-nav')) {\n      const nav = document.createElement('nav');\n      nav.className = 'v2-surface-nav';\n      nav.setAttribute('aria-label', '视图切换');\n      const pairs = srcBtns.map(src => {\n        const clone = src.cloneNode(true);\n        clone.querySelectorAll('svg, .nav-badge, .pill, .mono').forEach(el => el.remove());\n        const navLeft = clone.querySelector('.nav-left');\n        let label = '';\n        if (navLeft) {\n          label = Array.from(navLeft.children).map(el => (el.textContent || '').trim()).filter(Boolean).join(' ');\n        } else {\n          label = (clone.textContent || '').replace(/\\s+/g, ' ').trim();\n        }\n        const tab = document.createElement('button');\n        tab.type = 'button';\n        tab.className = 'v2-surface-tab';\n        tab.dataset.surfaceView = src.dataset.view || '';\n        tab.textContent = label || src.dataset.view || '视图';\n        tab.addEventListener('click', () => { try { src.click(); } catch {} });\n        nav.appendChild(tab);\n        return [src, tab];\n      });\n      const syncNav = () => {\n        for (const [src, tab] of pairs) {\n          const active = src.classList.contains('active');\n          tab.classList.toggle('active', active);\n          if (active) tab.setAttribute('aria-current', 'page');\n          else tab.removeAttribute('aria-current');\n        }\n      };\n      syncNav();\n      hostMain.prepend(nav);\n      try {\n        const obs = new MutationObserver(syncNav);\n        obs.observe(sidebar, { subtree: true, attributes: true, attributeFilter: ['class'] });\n      } catch {}\n    }\n  }\n})();\n/* === V2 Host Theme & Compact Surface JS End === */\n</script>\n</body>\n</html>\n","path":"ui/index.html"}],"format":"nmas-plugin","manifest":{"actions":[{"id":"arch.state","input_schema":{"additionalProperties":false,"properties":{},"required":[],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"analysis":{"additionalProperties":false,"properties":{"cycle_edge_ids":{"items":{"maxLength":48,"minLength":1,"type":"string"},"type":"array"},"cycles":{"items":{"items":{"maxLength":40,"minLength":1,"type":"string"},"type":"array"},"type":"array"},"metrics":{"items":{"additionalProperties":false,"properties":{"endpoint_count":{"maximum":999,"minimum":0,"type":"integer"},"fan_in":{"maximum":999,"minimum":0,"type":"integer"},"fan_out":{"maximum":999,"minimum":0,"type":"integer"},"in_cycle":{"type":"boolean"},"service_id":{"maxLength":40,"minLength":1,"type":"string"}},"required":["service_id","fan_in","fan_out","endpoint_count","in_cycle"],"type":"object"},"type":"array"},"stable_ratio":{"maximum":100,"min