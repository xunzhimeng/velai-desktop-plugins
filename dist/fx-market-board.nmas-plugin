{"files":[{"content":"const PREFERRED = ['CNY', 'USD', 'EUR', 'HKD', 'JPY', 'GBP', 'SGD', 'AUD', 'CAD', 'CHF', 'KRW'];\n\nfunction round6(n) {\n  return Math.round(n * 1e6) / 1e6;\n}\n\nfunction round2(n) {\n  return Math.round(n * 100) / 100;\n}\n\nexport default async function (request) {\n  const { kind, contribution, input } = request ?? {};\n  if (kind !== 'action') throw new Error('不支持的调用');\n\n  if (contribution === 'fx.rates') {\n    let res;\n    try {\n      res = await globalThis.nmas.http.request({ rule: 0, body: null });\n    } catch (e) {\n      return { ok: false, code: String(e?.code || 'network_error') };\n    }\n    const v = res?.json;\n    if (!v || v.base !== 'EUR' || typeof v.date !== 'string' || !/^\\d{4}-\\d{2}-\\d{2}$/.test(v.date) || !v.rates || typeof v.rates !== 'object') {\n      return { ok: false, code: 'invalid_rates' };\n    }\n    const entries = [{ code: 'EUR', rate: 1 }];\n    for (const [code, rate] of Object.entries(v.rates)) {\n      if (/^[A-Z]{3}$/.test(code) && typeof rate === 'number' && Number.isFinite(rate) && rate > 0) {\n        entries.push({ code, rate });\n      }\n    }\n    entries.sort((a, b) => {\n      const ia = PREFERRED.indexOf(a.code);\n      const ib = PREFERRED.indexOf(b.code);\n      if (ia !== -1 && ib !== -1) return ia - ib;\n      if (ia !== -1) return -1;\n      if (ib !== -1) return 1;\n      return a.code.localeCompare(b.code);\n    });\n    return { ok: true, base: 'EUR', date: v.date, rates: entries };\n  }\n\n  if (contribution === 'fx.currencies') {\n    let res;\n    try {\n      res = await globalThis.nmas.http.request({ rule: 1, body: null });\n    } catch (e) {\n      return { ok: false, code: String(e?.code || 'network_error') };\n    }\n    const v = res?.json;\n    if (!v || typeof v !== 'object' || Array.isArray(v)) {\n      return { ok: false, code: 'invalid_currencies' };\n    }\n    const currencies = [];\n    for (const [code, name] of Object.entries(v)) {\n      if (/^[A-Z]{3}$/.test(code) && typeof name === 'string' && name.trim()) {\n        currencies.push({ code, name: name.trim().slice(0, 80) });\n      }\n    }\n    currencies.sort((a, b) => a.code.localeCompare(b.code));\n    return { ok: true, currencies };\n  }\n\n  if (contribution === 'fx.convert') {\n    const unit_rate = round6(input.to_rate / input.from_rate);\n    const converted = round2((input.amount * input.to_rate) / input.from_rate);\n    return { converted, unit_rate };\n  }\n\n  throw new Error(`未知动作: ${contribution}`);\n}\n","path":"backend/index.js"},{"content":"<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>实时汇率换算看板</title>\n  <style>\n    :root {\n      color-scheme: light dark;\n      --bg: Canvas; --fg: CanvasText; --muted: color-mix(in srgb, CanvasText 60%, transparent);\n      --border: color-mix(in srgb, CanvasText 18%, transparent);\n      --card: color-mix(in srgb, CanvasText 4%, Canvas);\n      --accent: #2563eb; --danger: #dc2626;\n      font: 14px/1.55 system-ui, -apple-system, sans-serif;\n    }\n    * { box-sizing: border-box; }\n    body { margin: 0; background: var(--bg); color: var(--fg); }\n    main { max-width: 860px; margin: 0 auto; padding: clamp(12px, 2.5vw, 20px); display: flex; flex-direction: column; gap: 12px; }\n    header, .row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: space-between; }\n    h1 { font-size: 18px; margin: 0; }\n    .panel { border: 1px solid var(--border); border-radius: 10px; padding: 14px; background: var(--card); display: flex; flex-direction: column; gap: 10px; }\n    .calc { display: grid; grid-template-columns: 1fr 110px auto 110px; gap: 8px; align-items: center; }\n    @media (max-width: 560px) { .calc { grid-template-columns: 1fr 1fr; } }\n    input, select, button { font: inherit; color: inherit; border: 1px solid var(--border); border-radius: 7px; padding: 7px 10px; background: var(--bg); }\n    button { cursor: pointer; }\n    button.primary { background: var(--accent); border-color: var(--accent); color: #fff; }\n    .result { font-size: 22px; font-weight: 700; color: var(--accent); }\n    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 8px; }\n    .tile { border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; background: var(--bg); }\n    .tile strong { display: block; font-size: 15px; }\n    .tile span { font-size: 12px; color: var(--muted); }\n    .status { font-size: 13px; color: var(--muted); margin: 0; }\n    .status[data-error=\"true\"] { color: var(--danger); }\n    [hidden] { display: none !important; }\n  </style>\n</head>\n<body>\n  <main>\n    <header>\n      <h1>实时汇率换算看板</h1>\n      <div class=\"row\">\n        <button id=\"btn-insert\" class=\"primary\" type=\"button\" hidden>插入换算结果到输入框</button>\n        <button id=\"btn-refresh\" type=\"button\">刷新参考汇率</button>\n      </div>\n    </header>\n\n    <p id=\"status\" class=\"status\" role=\"status\">正在从欧央行公开源 (api.frankfurter.dev) 获取最新汇率…</p>\n\n    <section class=\"panel\">\n      <div class=\"calc\">\n        <input id=\"amount\" type=\"number\" min=\"0\" step=\"any\" value=\"1000\" aria-label=\"金额\">\n        <select id=\"from\" aria-label=\"源币种\"></select>\n        <button id=\"btn-swap\" type=\"button\" title=\"互换币种\">⇄</button>\n        <select id=\"to\" aria-label=\"目标币种\"></select>\n      </div>\n      <div class=\"row\">\n        <div id=\"result\" class=\"result\">--</div>\n        <div id=\"rate-note\" class=\"status\"></div>\n      </div>\n    </section>\n\n    <section class=\"panel\">\n      <div class=\"row\">\n        <strong>常见货币对人民币 (CNY) 参考牌价</strong>\n        <span id=\"rate-date\" class=\"status\"></span>\n      </div>\n      <div id=\"tiles\" class=\"grid\"></div>\n    </section>\n  </main>\n  <script>\n    (() => {\n      const plugin = globalThis.nmasPlugin;\n      const $ = id => document.getElementById(id);\n      const ZH = { CNY: '人民币', USD: '美元', EUR: '欧元', HKD: '港币', JPY: '日元', GBP: '英镑', SGD: '新加坡元', AUD: '澳元', CAD: '加元', CHF: '瑞士法郎', KRW: '韩元' };\n      let rateMap = new Map(), nameMap = new Map(), rateDate = '', lastSummary = '';\n      const setStatus = (t, err = false) => { $('status').textContent = t; $('status').dataset.error = String(err); };\n\n      async function recalc() {\n        const from = $('from').value, to = $('to').value;\n        const amount = Number($('amount').value);\n        if (!rateMap.has(from) || !rateMap.has(to) || !Number.isFinite(amount) || amount < 0) return;\n        try {\n          const res = await plugin.action('fx.convert', {\n            amount,\n            from_rate: rateMap.get(from),\n            to_rate: rateMap.get(to),\n          });\n          $('result').textContent = `${res.converted.toLocaleString('zh-CN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} ${to}`;\n          $('rate-note').textContent = `1 ${from} ≈ ${res.unit_rate} ${to}（欧央行 ${rateDate}）`;\n          lastSummary = `${amount} ${from} ≈ ${res.converted} ${to}（参考汇率 1 ${from} = ${res.unit_rate} ${to}，日期 ${rateDate}）`;\n        } catch (e) { setStatus(`换算失败：${e?.message || '未知错误'}`, true); }\n      }\n\n      function renderTiles() {\n        const box = $('tiles');\n        box.replaceChildren();\n        const cny = rateMap.get('CNY');\n        if (!cny) return;\n        for (const code of ['USD', 'EUR', 'HKD', 'GBP', 'JPY', 'SGD', 'AUD', 'CAD']) {\n          const r = rateMap.get(code);\n          if (!r) continue;\n          const unit = Math.round((cny / r) * 10000) / 10000;\n          const tile = document.createElement('div');\n          tile.className = 'tile';\n          const strong = document.createElement('strong');\n          strong.textContent = `1 ${code} = ${unit} CNY`;\n          const span = document.createElement('span');\n          span.textContent = ZH[code] || nameMap.get(code) || code;\n          tile.append(strong, span);\n          box.appendChild(tile);\n        }\n      }\n\n      async function load() {\n        if (typeof plugin?.action !== 'function') { setStatus('请在 Velai Desktop 中打开此插件。', true); return; }\n        setStatus('正在刷新欧央行参考汇率…');\n        try {\n          const [ratesRes, curRes] = await Promise.all([\n            plugin.action('fx.rates', {}),\n            plugin.action('fx.currencies', {}).catch(() => ({ ok: false })),\n          ]);\n          if (curRes?.ok && Array.isArray(curRes.currencies)) {\n            nameMap = new Map(curRes.currencies.map(c => [c.code, c.name]));\n          }\n          if (!ratesRes?.ok) {\n            setStatus(`汇率拉取失败（${ratesRes?.code || 'network_error'}），请检查网络或 Desktop 代理设置。`, true);\n            return;\n          }\n          rateDate = ratesRes.date;\n          rateMap = new Map(ratesRes.rates.map(r => [r.code, r.rate]));\n          $('rate-date').textContent = `牌价日期：${rateDate}`;\n          const prevFrom = $('from').value || 'USD';\n          const prevTo = $('to').value || 'CNY';\n          for (const sel of [$('from'), $('to')]) {\n            sel.replaceChildren();\n            for (const r of ratesRes.rates) {\n              const label = ZH[r.code] ? `${r.code} ${ZH[r.code]}` : r.code;\n              sel.add(new Option(label, r.code));\n            }\n          }\n          $('from').value = rateMap.has(prevFrom) ? prevFrom : 'EUR';\n          $('to').value = rateMap.has(prevTo) ? prevTo : 'CNY';\n          renderTiles();\n          await recalc();\n          setStatus(`已更新 ${ratesRes.rates.length} 种货币参考汇率（${rateDate}）`);\n        } catch (e) { setStatus(`加载失败：${e?.message || '未知错误'}`, true); }\n      }\n\n      $('amount').addEventListener('input', recalc);\n      $('from').addEventListener('change', recalc);\n      $('to').addEventListener('change', recalc);\n      $('btn-swap').addEventListener('click', () => {\n        const a = $('from').value;\n        $('from').value = $('to').value;\n        $('to').value = a;\n        void recalc();\n      });\n      $('btn-refresh').addEventListener('click', load);\n      $('btn-insert').addEventListener('click', async () => {\n        if (!lastSummary) return;\n        try {\n          const r = await plugin.action('host.draft.insert', { text: lastSummary });\n          setStatus(r?.inserted ? '已插入汇率换算结果到输入框。' : '插入未确认。', !r?.inserted);\n        } catch (e) { setStatus(`插入失败：${e?.message || '未知错误'}`, true); }\n      });\n\n      if (typeof plugin?.action === 'function') {\n        plugin.action('host.capabilities', {}).then(c => {\n          $('btn-insert').hidden = !(Array.isArray(c?.actions) && c.actions.includes('host.draft.insert'));\n        }).catch(() => {});\n      }\n      void load();\n    })();\n  </script>\n</body>\n</html>\n","path":"ui/index.html"}],"format":"nmas-plugin","manifest":{"actions":[{"id":"fx.rates","input_schema":{"additionalProperties":false,"properties":{},"required":[],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"base":{"maxLength":3,"minLength":3,"type":"string"},"code":{"maxLength":48,"type":"string"},"date":{"maxLength":10,"minLength":10,"type":"string"},"ok":{"type":"boolean"},"rates":{"items":{"additionalProperties":false,"properties":{"code":{"maxLength":3,"minLength":3,"type":"string"},"rate":{"maximum":10000000,"minimum":0.000001,"type":"number"}},"required":["code","rate"],"type":"object"},"type":"array"}},"required":["ok"],"type":"object"},"permissions":["http.request"],"title":"拉取欧央行最新参考汇率"},{"id":"fx.currencies","input_schema":{"additionalProperties":false,"properties":{},"required":[],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"code":{"maxLength":48,"type":"string"},"currencies":{"items":{"additionalProperties":false,"properties":{"code":{"maxLength":3,"minLength":3,"type":"string"},"name":{"maxLength":80,"minLength":1,"type":"string"}},"required":["code","name"],"type":"object"},"type":"array"},"ok":{"type":"boolean"}},"required":["ok"],"type":"object"},"permissions":["http.request"],"title":"拉取支持币种目录"},{"id":"fx.convert","input_schema":{"additionalProperties":false,"properties":{"amount":{"maximum":1000000000000,"minimum":0,"type":"number"},"from_rate":{"maximum":10000000,"minimum":0.000001,"type":"number"},"to_rate":{"maximum":10000000,"minimum":0.000001,"type":"number"}},"required":["amount","from_rate","to_rate"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"converted":{"maximum":100000000000000,"minimum":0,"type":"number"},"unit_rate":{"maximum":100000000,"minimum":0,"type":"number"}},"required":["converted","unit_rate"],"type":"object"},"permissions":[],"title":"交叉汇率计算"}],"backend":"backend/index.js","data":[],"files":[{"path":"backend/index.js","sha256":"d188e74a57909630d9cf5e6ec8d099cd3ad7325fed33dad0b3ab4b058114042e"},{"path":"ui/index.html","sha256":"d2cbbd00bf4e20aefe15a54b2e6ecd2dc48dc125fe20f067cddf18fc4f39089c"}],"host_api":1,"http":[{"host":"api.frankfurter.dev","methods":["GET"],"path":"/v1/latest","port":443},{"host":"api.frankfurter.dev","methods":["GET"],"path":"/v1/currencies","port":443}],"manifest_version":1,"name":"实时汇率换算看板","page":"ui/index.html","permissions":["http.request"],"plugin_id":"fx-market-board","tasks":[],"tools":[],"ui":{"icon":"table","surfaces":["workspace","chat"]},"version":"1.0.0"},"version":1}