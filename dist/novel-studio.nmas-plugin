:1,"type":"string"}},"required":["id","title","planted_ch","payoff_ch","status","priority","detail"],"type":"object"},"type":"array"}},"required":["revision","book","characters","relations","lore","threads"],"type":"object"},"permissions":["data.read"],"title":"读取小说工作台总览"},{"id":"novel.book.save","input_schema":{"additionalProperties":false,"properties":{"expected_revision":{"maximum":9007199254740990,"minimum":0,"type":"integer"},"genre":{"maxLength":40,"type":"string"},"logline":{"maxLength":400,"type":"string"},"target_words":{"maximum":10000000,"minimum":1000,"type":"integer"},"title":{"maxLength":100,"minLength":1,"type":"string"}},"required":["expected_revision","title","genre","logline","target_words"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"revision":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"status":{"enum":["saved","conflict","invalid_input"],"type":"string"}},"required":["status","revision"],"type":"object"},"permissions":["data.read","data.write"],"title":"更新书籍基本信息"},{"id":"novel.chapter.get","input_schema":{"additionalProperties":false,"properties":{"id":{"maxLength":48,"minLength":1,"type":"string"}},"required":["id"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"beats":{"maxLength":1000,"type":"string"},"body":{"maxLength":10000,"type":"string"},"found":{"type":"boolean"},"notes":{"maxLength":1000,"type":"string"},"revision":{"maximum":9007199254740991,"minimum":0,"type":"integer"}},"required":["found","revision"],"type":"object"},"permissions":["data.read"],"title":"读取章节完整正文"},{"id":"novel.chapter.save","input_schema":{"additionalProperties":false,"properties":{"beats":{"maxLength":1000,"type":"string"},"body":{"maxLength":10000,"type":"string"},"expected_revision":{"maximum":9007199254740990,"minimum":0,"type":"integer"},"id":{"maxLength":48,"minLength":1,"type":"string"},"notes":{"maxLength":1000,"type":"string"},"pov":{"maxLength":40,"type":"string"},"status":{"enum":["draft","revising","done"],"type":"string"},"summary":{"maxLength":240,"type":"string"},"tension":{"maximum":10,"minimum":1,"type":"integer"},"title":{"maxLength":100,"minLength":1,"type":"string"},"volume":{"maxLength":60,"type":"string"}},"required":["expected_revision","id","volume","title","status","tension","pov","summary","beats","notes","body"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"revision":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"status":{"enum":["saved","conflict","limit","invalid_input"],"type":"string"},"word_count":{"maximum":100000,"minimum":0,"type":"integer"}},"required":["status","revision"],"type":"object"},"permissions":["data.read","data.write"],"title":"保存章节元数据与正文"},{"id":"novel.chapter.delete","input_schema":{"additionalProperties":false,"properties":{"expected_revision":{"maximum":9007199254740990,"minimum":0,"type":"integer"},"id":{"maxLength":48,"minLength":1,"type":"string"}},"required":["expected_revision","id"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"revision":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"status":{"enum":["deleted","not_found","conflict"],"type":"string"}},"required":["status","revision"],"type":"object"},"permissions":["data.read","data.write"],"title":"删除章节"},{"id":"novel.world.save","input_schema":{"additionalProperties":false,"properties":{"characters":{"items":{"additionalProperties":false,"properties":{"faction":{"maxLength":40,"type":"string"},"goal":{"maxLength":200,"type":"string"},"id":{"maxLength":48,"minLength":1,"type":"string"},"name":{"maxLength":40,"minLength":1,"type":"string"},"role":{"enum":["protagonist","antagonist","supporting","mentor"],"type":"string"},"secret":{"maxLength":200,"type":"string"},"traits":{"maxLength":120,"type":"string"}},"required":["id","name","role","faction","traits","goal","secret"],"type":"object"},"type":"array"},"expected_revision":{"maximum":9007199254740990,"minimum":0,"type":"integer"},"lore":{"items":{"additionalProperties":false,"properties":{"category":{"enum":["location","faction","magic_tech","artifact","history"],"type":"string"},"detail":{"maxLength":400,"type":"string"},"id":{"maxLength":48,"minLength":1,"type":"string"},"title":{"maxLength":64,"minLength":1,"type":"string"}},"required":["id","category","title","detail"],"type":"object"},"type":"array"},"relations":{"items":{"additionalProperties":false,"properties":{"from":{"maxLength":48,"minLength":1,"type":"string"},"id":{"maxLength":48,"minLength":1,"type":"string"},"kind":{"enum":["ally","rival","mentor","romance","secret"],"type":"string"},"label":{"maxLength":40,"type":"string"},"to":{"maxLength":48,"minLength":1,"type":"string"}},"required":["id","from","to","kind","label"],"type":"object"},"type":"array"}},"required":["expected_revision","characters","relations","lore"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"revision":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"status":{"enum":["saved","conflict","limit"],"type":"string"}},"required":["status","revision"],"type":"object"},"permissions":["data.read","data.write"],"title":"保存人物、关系或世界观设定"},{"id":"novel.plot.save","input_schema":{"additionalProperties":false,"properties":{"expected_revision":{"maximum":9007199254740990,"minimum":0,"type":"integer"},"threads":{"items":{"additionalProperties":false,"properties":{"detail":{"maxLength":240,"type":"string"},"id":{"maxLength":48,"minLength":1,"type":"string"},"payoff_ch":{"maximum":9999,"minimum":0,"type":"integer"},"planted_ch":{"maximum":9999,"minimum":1,"type":"integer"},"priority":{"enum":["critical","major","minor"],"type":"string"},"status":{"enum":["planted","hinted","payoff","abandoned"],"type":"string"},"title":{"maxLength":80,"minLength":1,"type":"string"}},"required":["id","title","planted_ch","payoff_ch","status","priority","detail"],"type":"object"},"type":"array"}},"required":["expected_revision","threads"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"revision":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"status":{"enum":["saved","conflict","limit"],"type":"string"}},"required":["status","revision"],"type":"object"},"permissions":["data.read","data.write"],"title":"保存伏笔与线索追踪表"},{"id":"novel.seed_demo","input_schema":{"additionalProperties":false,"properties":{"expected_revision":{"maximum":9007199254740990,"minimum":0,"type":"integer"}},"required":["expected_revision"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"revision":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"status":{"enum":["seeded","conflict"],"type":"string"}},"required":["status","revision"],"type":"object"},"permissions":["data.read","data.write"],"title":"加载演示长篇项目"},{"id":"session.turn.request","input_schema":{"additionalProperties":false,"properties":{"prompt":{"maxLength":2048,"minLength":1,"type":"string"},"work_id":{"maxLength":36,"minLength":36,"type":"string"}},"required":["prompt","work_id"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"state":{"enum":["dispatching"],"type":"string"},"task_id":{"maxLength":36,"minLength":36,"type":"string"}},"required":["task_id","state"],"type":"object"},"permissions":["tasks.start"],"title":"向当前会话派发 AI 写作任务"},{"id":"session.turn.result","input_schema":{"additionalProperties":false,"properties":{"work_id":{"maxLength":36,"minLength":36,"type":"string"}},"required":["work_id"],"type":"object"},"output_schema":{"additionalProperties":true,"properties":{"state":{"enum":["dispatching","running","waiting","completed","cancelled","failed","unknown","unavailable"],"type":"string"},"truncated":{"type":"boolean"},"work_id":{"maxLength":36,"minLength":36,"type":"string"}},"required":["work_id","state","truncated"],"type":"object"},"permissions":["tasks.read"],"title":"核对 AI 写作结果"},{"id":"document.list","input_schema":{"additionalProperties":false,"properties":{},"required":[],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"items":{"items":{"additionalProperties":false,"properties":{"id":{"maxLength":48,"minLength":1,"type":"string"},"label":{"maxLength":120,"minLength":1,"type":"string"}},"required":["id","label"],"type":"object"},"type":"array"}},"required":[],"type":"object"},"permissions":["data.read"],"title":"列出可导出内容"},{"id":"document.export","input_schema":{"additionalProperties":false,"properties":{"id":{"maxLength":48,"minLength":1,"type":"string"}},"required":["id"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"error":{"maxLength":64,"type":"string"},"filename":{"maxLength":80,"type":"string"},"text":{"maxLength":12288,"type":"string"}},"required":[],"type":"object"},"permissions":["data.read"],"title":"导出大纲设定或单章"},{"id":"document.import","input_schema":{"additionalProperties":false,"properties":{"text":{"maxLength":12288,"minLength":2,"type":"string"}},"required":["text"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"imported":{"type":"boolean"},"reason":{"maxLength":64,"type":"string"}},"required":["imported"],"type":"object"},"permissions":["data.read","data.write"],"title":"导入小说设定或章节 JSON"}],"backend":"backend/index.js","data":[{"collection":"meta","schema_version":1,"scope":"account"},{"collection":"chapters","schema_version":1,"scope":"account"},{"collection":"world","schema_version":1,"scope":"account"},{"collection":"plot","schema_version":1,"scope":"account"}],"files":[{"path":"backend/index.js","sha256":"a848314087029826c6d0c262abb61c389028bd0c09e1e4e23c067555e3507399"},{"path":"ui/index.html","sha256":"130d5d6b73d4794763180cf5ad38d263153cbc876514edf7fcdb20765a173ac9"}],"host_api":1,"http":[],"manifest_version":1,"name":"AI 长篇小说开发系统","page":"ui/index.html","permissions":["data.read","data.write","tasks.start","tasks.read","tasks.cancel"],"plugin_id":"novel-studio","tasks":[],"tools":[{"description":"获取当前长篇小说的书名、总字数、分卷章节摘要、主要人物清单及未回收伏笔，用于续写或剧情策划。","id":"novel.outline","input_schema":{"additionalProperties":false,"properties":{},"required":[],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"chapters":{"items":{"additionalProperties":false,"properties":{"id":{"maxLength":48,"type":"string"},"order":{"maximum":9999,"minimum":1,"type":"integer"},"pov":{"maxLength":40,"type":"string"},"summary":{"maxLength":240,"type":"string"},"tension":{"maximum":10,"minimum":1,"type":"integer"},"title":{"maxLength":100,"type":"string"}},"required":["id","order","title","tension","pov","summary"],"type":"object"},"type":"array"},"open_threads":{"items":{"additionalProperties":false,"properties":{"planted_ch":{"maximum":9999,"minimum":1,"type":"integer"},"priority":{"maxLength":16,"type":"string"},"title":{"maxLength":80,"type":"string"}},"required":["title","planted_ch","priority"],"type":"object"},"type":"array"},"status":{"enum":["ready","empty"],"type":"string"},"success":{"type":"boolean"},"title":{"maxLength":100,"type":"string"},"total_words":{"maximum":10000000,"minimum":0,"type":"integer"}},"required":["success","status"],"type":"object"},"permissions":["data.read"],"title":"读取小说全书大纲与伏笔"},{"description":"按章节 ID 读取该章的完整正文、分镜节拍和作者笔记，便于做续写、润色或一致性检查。","id":"novel.chapter.read","input_schema":{"additionalProperties":false,"properties":{"id":{"maxLength":48,"minLength":1,"type":"string"}},"required":["id"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"beats":{"maxLength":1000,"type":"string"},"body":{"maxLength":10000,"type":"string"},"pov":{"maxLength":40,"type":"string"},"status":{"enum":["ready","not_found"],"type":"string"},"success":{"type":"boolean"},"title":{"maxLength":100,"type":"string"}},"required":["success","status"],"type":"object"},"permissions":["data.read"],"title":"读取指定小说章节正文"},{"description":"向小说世界观圣经新增或更新一条世界观词条（地点/势力/力量体系/道具/历史）或新伏笔。","id":"novel.bible.upsert","input_schema":{"additionalProperties":false,"properties":{"detail":{"maxLength":400,"minLength":1,"type":"string"},"kind":{"enum":["location","faction","magic_tech","artifact","history","thread"],"type":"string"},"planted_ch":{"maximum":9999,"minimum":1,"type":"integer"},"title":{"maxLength":64,"minLength":1,"type":"string"}},"required":["kind","title","detail"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"id":{"maxLength":48,"type":"string"},"status":{"enum":["saved","conflict","limit"],"type":"string"},"success":{"type":"boolean"}},"required":["success","status"],"type":"object"},"permissions":["data.read","data.write"],"title":"写入人物或世界观设定"}],"ui":{"icon":"edit","surfaces":["workspace","chat","assistant"]},"version":"1.0.0"},"version":1}