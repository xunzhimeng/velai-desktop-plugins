{"files":[{"content":"const MAX_RECORD_BYTES = 240 * 1024;\nconst DOC_FORMAT = 'velai.novel-studio';\nconst SHA256_RE = /^[0-9a-f]{64}$/;\n\nfunction jsonBytes(v) {\n  let b = 0;\n  const s = JSON.stringify(v);\n  for (let i = 0; i < s.length; i++) {\n    const cp = s.codePointAt(i);\n    if (cp > 0xffff) i += 1;\n    b += cp <= 0x7f ? 1 : cp <= 0x7ff ? 2 : cp <= 0xffff ? 3 : 4;\n  }\n  return b;\n}\n\nfunction countWords(text) {\n  const m = (text || '').match(/[A-Za-z0-9]+(?:['’-][A-Za-z0-9]+)*|[\\u3400-\\u4dbf\\u4e00-\\u9fff]/g);\n  return m ? m.length : 0;\n}\n\nfunction normalizeChapterMeta(ch) {\n  return {\n    id: ch.id,\n    volume: ch.volume || '第一卷',\n    order: ch.order,\n    title: ch.title,\n    status: ch.status,\n    tension: ch.tension,\n    pov: ch.pov || '',\n    word_count: ch.word_count || 0,\n    summary: ch.summary || '',\n    fs_path: typeof ch.fs_path === 'string' && ch.fs_path ? ch.fs_path : null,\n    fs_sha256: typeof ch.fs_sha256 === 'string' && SHA256_RE.test(ch.fs_sha256) ? ch.fs_sha256 : null,\n  };\n}\n\nconst DEFAULT_BOOK = {\n  schema_version: 1,\n  title: '未命名长篇计划',\n  genre: '科幻悬疑',\n  logline: '点击左下角「加载演示《星渊回响》」可立即体验多卷长篇账本、人物关系星系图、张力曲线与工作区手稿 CAS 同步。',\n  target_words: 120000,\n  chapters: [],\n};\n\nconst DEFAULT_WORLD = { schema_version: 1, characters: [], relations: [], lore: [] };\nconst DEFAULT_PLOT = { schema_version: 1, threads: [] };\n\nasync function readKey(collection, key, fallback) {\n  const r = await globalThis.nmas.data.read({ collection, key });\n  return { revision: r.revision, value: r.value === null ? fallback : r.value };\n}\n\nasync function writeKey(collection, key, expectedRevision, value) {\n  if (jsonBytes(value) > MAX_RECORD_BYTES) {\n    return { status: 'limit', revision: expectedRevision };\n  }\n  try {\n    const r = await globalThis.nmas.data.write({\n      collection,\n      key,\n      expected_revision: expectedRevision,\n      value,\n    });\n    return { status: 'saved', revision: r.revision };\n  } catch (e) {\n    if (e?.code === 'conflict' && e.outcome_unknown === false) {\n      return { status: 'conflict', revision: expectedRevision };\n    }\n    throw e;\n  }\n}\n\nasync function deleteKey(collection, key, expectedRevision) {\n  try {\n    const r = await globalThis.nmas.data.delete({\n      collection,\n      key,\n      expected_revision: expectedRevision,\n    });\n    return { status: 'deleted', revision: r.revision };\n  } catch (e) {\n    if (e?.code === 'conflict' && e.outcome_unknown === false) {\n      return { status: 'conflict', revision: expectedRevision };\n    }\n    throw e;\n  }\n}\n\nasync function listAllChapterKeys() {\n  const keys = [];\n  let cursor;\n  for (let page = 0; page < 8; page++) {\n    const res = await globalThis.nmas.data.list({\n      collection: 'chapters',\n      prefix: 'ch:',\n      limit: 50,\n      ...(cursor ? { cursor } : {}),\n    });\n    for (const k of res.keys || []) keys.push(k);\n    if (!res.next_cursor) break;\n    cursor = res.next_cursor;\n  }\n  return keys;\n}\n\nfunction computeTotalWords(chapters) {\n  return chapters.reduce((acc, ch) => acc + (ch.word_count || 0), 0);\n}\n\nfunction deriveTitleFromMarkdown(content, relPath) {\n  const lines = String(content || '').split(/\\r?\\n/);\n  for (const line of lines.slice(0, 12)) {\n    const m = /^#\\s+(.+)$/.exec(line.trim());\n    if (m && m[1].trim()) return m[1].trim().slice(0, 100);\n  }\n  const base = String(relPath || '').split('/').pop() || '导入章节';\n  return base.replace(/\\.(md|markdown|txt)$/i, '').slice(0, 100) || '导入章节';\n}\n\nfunction formatChapterMarkdown(meta, chDoc, includeHeader) {\n  const body = chDoc.body || '';\n  if (!includeHeader) return body;\n  const headerLines = [\n    `# ${meta.title}`,\n    '',\n    `> 卷目：${meta.volume || '第一卷'} ｜ 视角：${meta.pov || '全知'} ｜ 状态：${meta.status} ｜ 张力：${meta.tension}/10`,\n  ];\n  if (meta.summary) headerLines.push(`> 摘要：${meta.summary}`);\n  headerLines.push('');\n  return `${headerLines.join('\\n')}\\n${body}`;\n}\n\nfunction demoPayload() {\n  const chaptersMeta = [\n    { id: 'ch-01', volume: '第一卷 · 沉没轨道', order: 1, title: '第1章 零号信标重启', status: 'done', tension: 6, pov: '林深', word_count: 342, summary: '深空打捞员林深在废弃轨道站发现早应销毁的零号信标正在向地球发送倒计时。', fs_path: null, fs_sha256: null },\n    { id: 'ch-02', volume: '第一卷 · 沉没轨道', order: 2, title: '第2章 静默档案室', status: 'done', tension: 5, pov: '沈清秋', word_count: 288, summary: '轨管局监察官沈清秋截获异常频段，发现信标签名竟属于十年前失踪的导师。', fs_path: null, fs_sha256: null },\n    { id: 'ch-03', volume: '第一卷 · 沉没轨道', order: 3, title: '第3章 失压舱门', status: 'revising', tension: 9, pov: '林深', word_count: 316, summary: '武装清道夫突袭打捞船，林深与沈清秋被迫在失压走廊联手逃生。', fs_path: null, fs_sha256: null },\n    { id: 'ch-04', volume: '第一卷 · 沉没轨道', order: 4, title: '第4章 灰烬议会', status: 'draft', tension: 7, pov: '陆沉舟', word_count: 195, summary: '议会副席陆沉舟下令封锁近地轨道，并启动尘封已久的“回声协议”。', fs_path: null, fs_sha256: null },\n    { id: 'ch-05', volume: '第二卷 · 逆向潮汐', order: 5, title: '第5章 记忆折射体', status: 'draft', tension: 8, pov: '林深', word_count: 170, summary: '解码信标内核后，众人震惊地发现它记录的不是过去，而是七十二小时后的未来画面。', fs_path: null, fs_sha256: null },\n  ];\n\n  const bodies = {\n    'ch-01': {\n      beats: '1. 废弃轨道站外部作业压迫感\\n2. 传感器捕捉 42Hz 异常脉冲\\n3. 撬开铅封舱盖，零号信标亮起琥珀光\\n4. 屏幕浮现林深本人的生物密钥与 72:00:00 倒计时',\n      notes: '注意保持冷硬太空工业质感，不要过早揭示回声协议全貌。',\n      body: '舱外探照灯切开近地轨道浓稠的黑，金属残骸在微重力下像一头搁浅的巨鲸缓缓翻身。林深把磁力靴扣死在主龙骨上，面罩里的呼气声被降噪算法压成一道枯燥的白噪音。\\n\\n“七号区辐射读数正常，但你在听什么？”耳机里传来副驾的杂音。\\n\\n“42 赫兹。”林深抬起手腕，示波器上正跳出一串极其规整的锯齿波，“十年前‘星渊号’解体后，这套加密频段就被轨管局永久吊销了。”\\n\\n他切开最后一道铅封锁扣。失重扬起的尘埃在光束里停顿了一瞬，舱壁深处那枚本该烧成焦炭的零号信标，正缓缓浮起一层温热的琥珀色微光。全息投影在他面罩前展开——没有求救信号，只有一行刺目的校验日志：「生物密钥匹配：林深。距离潮汐折叠还有 71:59:58。」',\n    },\n    'ch-02': {\n      beats: '1. 轨管局地下监听塔的深夜值守\\n2. 沈清秋拦截到被自动抹除的告警日志\\n3. 对比十年前导师周明远留下的手写校验码\\n4. 发现内部有人篡改了拦截白名单',\n      notes: '突出沈清秋理智克制与内心执念的反差。',\n      body: '凌晨三点十七分，近地轨管局地下四层的告警灯只闪了零点四秒就被系统自动静默。若不是沈清秋提前在底层总线上挂了物理镜像探针，这条来自废弃打捞区的异常脉冲就会像过去三年里的所有秘密一样人间蒸发。\\n\\n她放大频谱图，指尖停在末尾那组十六进制签名上。那是导师周明远独有的习惯——在每一个校验块的尾帧藏入一段巴赫赋格的频率比。\\n\\n“您果然没有死在星渊号上。”她低声自语，随即把镜像卡拔出藏进袖口。监控屏幕右上角，来自议会高层的强制覆写指令已经抵达，操作人署名为：陆沉舟。',\n    },\n    'ch-03': {\n      beats: '1. 三艘无标识拦截艇封锁船坞\\n2. 沈清秋亮明身份却反遭清道夫击杀令\\n3. 走廊失压瞬间，林深切断气闸救下两人\\n4. 信标在真空中发出第二段坐标',\n      notes: '本卷第一个动作高潮，节奏要快，短句为主。',\n      body: '警报撕裂舱内寂静的刹那，三道高能激光已经融穿了停泊舱的外装甲。林深一把将沈清秋拽进气闸盲区，滚烫的钛合金碎屑擦着护目镜呼啸而过。\\n\\n“你不是轨管局的监察官吗？他们为什么连你一起杀！”林深吼道。\\n\\n“因为下令封锁星渊档案的人，就在我们头顶！”沈清秋迅速将战术终端接入应急气阀，“左侧三十米是旧式逃生滑道，但主走廊已经失压！”\\n\\n没有犹豫的余地。林深反手拉下机械泄压杆，剧烈的气流瞬间卷走所有火焰，也把追兵逼退在厚重的防爆门后。他抓紧怀中滚烫的零号信标，在警报红光里纵身跃入失重通道。',\n    },\n    'ch-04': {\n      beats: '1. 灰烬议会圆桌的冷酷博弈\\n2. 陆沉舟展示十年前“星渊折叠”的机密影像\\n3. 下令全面启动回声协议，宁可牺牲整条轨道环',\n      notes: '让反派具备宏大而扭曲的“救世合理性”，而非脸谱化坏人。',\n      body: '弧形落地窗外，蔚蓝的地球安静得像一枚易碎的玻璃珠。陆沉舟将茶杯轻轻搁在黑曜石长桌上，投影幕布随之切换成十年前那场从未公之于众的灾难——星渊号并非爆炸，而是被一道凭空出现的引力褶皱从时间轴上抹去了半截船体。\\n\\n“诸位，零号信标已经苏醒。”陆沉舟声音平稳得没有一丝波澜，“如果任由那名打捞员把里面的数据公之于众，七十二小时后崩溃的就不止一条轨道环。启动‘回声协议’吧。”',\n    },\n    'ch-05': {\n      beats: '1. 逃亡至废弃中继塔解码信标\\n2. 发现影像里的时间戳竟是三天后\\n3. 影像中沈清秋在最后关头背叛了林深？留下悬念',\n      notes: '第一卷与第二卷衔接钩子。',\n      body: '中继塔的老旧算力阵列发出不堪重负的嗡鸣，进度条终于跳至 100%。全息画幅展开的一刻，舱内陷入死寂——画面里正在崩塌的近地穹顶上方，清晰地悬浮着三天后的太阳历日期。更让林深血液凝固的是，画面最后半秒，站在主控台前按下引爆键的人影，赫然转过沈清秋那张毫无表情的脸。',\n    },\n  };\n\n  const world = {\n    schema_version: 1,\n    characters: [\n      { id: 'c-linshen', name: '林深', role: 'protagonist', faction: '自由打捞公会', traits: '冷静、机械直觉极强、不信任体制', goal: '查清零号信标与自己生物密钥绑定的真相', secret: '十年前轨道事故唯一的记忆断层幸存者' },\n      { id: 'c-shen', name: '沈清秋', role: 'supporting', faction: '近地轨管局', traits: '精密理性、外冷内热、原则极强', goal: '找到失踪导师周明远并揭露议会掩盖的事故', secret: '体内植入了导师留下的半枚回声密钥' },\n      { id: 'c-lu', name: '陆沉舟', role: 'antagonist', faction: '灰烬议会', traits: '克制优雅、极端功利主义、掌控全局', goal: '在潮汐折叠前强行封锁轨道以保全地球本体', secret: '曾是周明远最亲密的联合研究员' },\n      { id: 'c-zhou', name: '周明远', role: 'mentor', faction: '原星渊科研组', traits: '理想主义、密码学与引力场大师', goal: '将未来的警告提前送回七十二小时前', secret: '意识可能已被折叠进信标量子阵列' },\n      { id: 'c-akira', name: '阿澈', role: 'supporting', faction: '自由打捞公会', traits: '话痨、顶尖黑客、重义气', goal: '帮林深保住打捞船并破解信标加密层', secret: '曾为灰烬议会外包写过追踪木马' },\n    ],\n    relations: [\n      { id: 'r-1', from: 'c-linshen', to: 'c-shen', kind: 'ally', label: '被迫结盟 / 暗藏猜忌' },\n      { id: 'r-2', from: 'c-shen', to: 'c-zhou', kind: 'mentor', label: '师徒羁绊' },\n      { id: 'r-3', from: 'c-lu', to: 'c-zhou', kind: 'rival', label: '昔日挚友 / 理念决裂' },\n      { id: 'r-4', from: 'c-lu', to: 'c-linshen', kind: 'rival', label: '猎杀与追逃' },\n      { id: 'r-5', from: 'c-linshen', to: 'c-akira', kind: 'ally', label: '生死搭档' },\n      { id: 'r-6', from: 'c-shen', to: 'c-lu', kind: 'secret', label: '上下级 / 暗中调查' },\n    ],\n    lore: [\n      { id: 'l-1', category: 'artifact', title: '零号信标', detail: '星渊号唯一残留的量子黑匣子，以 42Hz 频段脉冲广播，能够逆向折射 72 小时内的未来观测画面。' },\n      { id: 'l-2', category: 'faction', title: '灰烬议会', detail: '掌控近地轨道能源与防务的最高秘密委员会，奉行“宁可局部焚毁以保全文明存续”的冷酷铁律。' },\n      { id: 'l-3', category: 'magic_tech', title: '潮汐折叠', detail: '人工引力引擎过载引发的局部时空褶皱现象，会让特定空间内的因果顺序出现短时倒置。' },\n      { id: 'l-4', category: 'location', title: '沉没轨道带', detail: '距地表八百公里的退役空间站坟场，电磁干扰极强，是自由打捞船与地下黑市的天然掩护区。' },\n    ],\n  };\n\n  const plot = {\n    schema_version: 1,\n    threads: [\n      { id: 'th-1', title: '林深生物密钥为何提前写入零号信标', planted_ch: 1, payoff_ch: 12, status: 'planted', priority: 'critical', detail: '林深从未登过星渊号，但信标认他为最高权限持有人。' },\n      { id: 'th-2', title: '巴赫赋格尾帧校验码', planted_ch: 2, payoff_ch: 6, status: 'hinted', priority: 'major', detail: '周明远留给沈清秋的暗语，指向中继塔隐藏坐标。' },\n      { id: 'th-3', title: '未来影像中沈清秋按下引爆键的真相', planted_ch: 5, payoff_ch: 18, status: 'planted', priority: 'critical', detail: '究竟是背叛，还是为了阻止更大规模折叠的唯一解法？' },\n      { id: 'th-4', title: '阿澈曾为议会编写的追踪后门', planted_ch: 3, payoff_ch: 8, status: 'hinted', priority: 'major', detail: '清道夫之所以精准锁定打捞船，是否与这段旧代码有关？' },\n    ],\n  };\n\n  const book = {\n    schema_version: 1,\n    title: '星渊回响',\n    genre: '硬科幻 / 太空悬疑',\n    logline: '一枚提前七十二小时传回未来灾难影像的量子信标，让深空打捞员与轨道监察官卷入跨越十年的因果迷局。',\n    target_words: 150000,\n    chapters: chaptersMeta,\n  };\n\n  return { book, bodies, world, plot };\n}\n\nexport default async function (request) {\n  const { kind, contribution, input } = request ?? {};\n\n  if (kind === 'action') {\n    if (contribution === 'novel.bootstrap') {\n      const metaRes = await readKey('meta', 'book', DEFAULT_BOOK);\n      const worldRes = await readKey('world', 'bible', DEFAULT_WORLD);\n      const plotRes = await readKey('plot', 'board', DEFAULT_PLOT);\n      const storedKeys = await listAllChapterKeys();\n      const book = metaRes.value;\n      const world = worldRes.value;\n      const plot = plotRes.value;\n      const chapters = (book.chapters || []).map(normalizeChapterMeta);\n      return {\n        revision: metaRes.revision,\n        stored_chapter_keys: storedKeys,\n        book: {\n          title: book.title,\n          genre: book.genre,\n          logline: book.logline,\n          target_words: book.target_words,\n          total_words: computeTotalWords(chapters),\n          chapters,\n        },\n        characters: world.characters || [],\n        relations: world.relations || [],\n        lore: world.lore || [],\n        threads: plot.threads || [],\n      };\n    }\n\n    if (contribution === 'novel.book.save') {\n      const metaRes = await readKey('meta', 'book', DEFAULT_BOOK);\n      if (metaRes.revision !== input.expected_revision) return { status: 'conflict', revision: metaRes.revision };\n      const title = input.title.trim();\n      if (!title) return { status: 'invalid_input', revision: metaRes.revision };\n      const next = {\n        ...metaRes.value,\n        schema_version: 1,\n        title,\n        genre: input.genre.trim(),\n        logline: input.logline.trim(),\n        target_words: input.target_words,\n      };\n      return writeKey('meta', 'book', input.expected_revision, next);\n    }\n\n    if (contribution === 'novel.chapter.get') {\n      const r = await readKey('chapters', `ch:${input.id}`, null);\n      if (!r.value) return { found: false, revision: r.revision };\n      return {\n        found: true,\n        revision: r.revision,\n        body: r.value.body || '',\n        beats: r.value.beats || '',\n        notes: r.value.notes || '',\n        fs_path: typeof r.value.fs_path === 'string' && r.value.fs_path ? r.value.fs_path : null,\n        fs_sha256: typeof r.value.fs_sha256 === 'string' && SHA256_RE.test(r.value.fs_sha256) ? r.value.fs_sha256 : null,\n      };\n    }\n\n    if (contribution === 'novel.chapter.save') {\n      const { expected_revision, id, volume, title, status, tension, pov, summary, beats, notes, body } = input;\n      if (!title.trim() || !/^[a-zA-Z0-9._-]+$/.test(id)) return { status: 'invalid_input', revision: expected_revision };\n      const metaRes = await readKey('meta', 'book', DEFAULT_BOOK);\n      if (metaRes.revision !== expected_revision) return { status: 'conflict', revision: metaRes.revision };\n\n      const list = metaRes.value.chapters || [];\n      const existing = list.find(c => c.id === id);\n      const fsPath = input.fs_path !== undefined ? (input.fs_path || null) : (existing?.fs_path || null);\n      const fsSha = input.fs_sha256 !== undefined\n        ? (typeof input.fs_sha256 === 'string' && SHA256_RE.test(input.fs_sha256) ? input.fs_sha256 : null)\n        : (existing?.fs_sha256 || null);\n\n      const chDoc = { schema_version: 1, body, beats, notes, fs_path: fsPath, fs_sha256: fsSha };\n      const savedBody = await writeKey('chapters', `ch:${id}`, expected_revision, chDoc);\n      if (savedBody.status !== 'saved') return savedBody;\n\n      const word_count = countWords(body);\n      const entry = {\n        id,\n        volume: volume.trim() || '第一卷',\n        order: existing ? existing.order : list.length + 1,\n        title: title.trim(),\n        status,\n        tension,\n        pov: pov.trim(),\n        word_count,\n        summary: summary.trim(),\n        fs_path: fsPath,\n        fs_sha256: fsSha,\n      };\n      const nextChapters = existing ? list.map(c => (c.id === id ? entry : c)) : [...list, entry];\n      const savedMeta = await writeKey('meta', 'book', savedBody.revision, { ...metaRes.value, schema_version: 1, chapters: nextChapters });\n      return savedMeta.status === 'saved' ? { status: 'saved', revision: savedMeta.revision, word_count } : savedMeta;\n    }\n\n    if (contribution === 'novel.chapter.delete') {\n      const metaRes = await readKey('meta', 'book', DEFAULT_BOOK);\n      if (metaRes.revision !== input.expected_revision) return { status: 'conflict', revision: metaRes.revision };\n      const list = metaRes.value.chapters || [];\n      if (!list.some(c => c.id === input.id)) return { status: 'not_found', revision: metaRes.revision };\n      const deletedBody = await deleteKey('chapters', `ch:${input.id}`, input.expected_revision);\n      if (deletedBody.status !== 'deleted') return { status: 'conflict', revision: deletedBody.revision };\n      const nextChapters = list.filter(c => c.id !== input.id).map((c, idx) => ({ ...c, order: idx + 1 }));\n      const saved = await writeKey('meta', 'book', deletedBody.revision, { ...metaRes.value, schema_version: 1, chapters: nextChapters });\n      return saved.status === 'saved' ? { status: 'deleted', revision: saved.revision } : { status: 'conflict', revision: saved.revision };\n    }\n\n    if (contribution === 'novel.world.save') {\n      const metaRes = await readKey('meta', 'book', DEFAULT_BOOK);\n      if (metaRes.revision !== input.expected_revision) return { status: 'conflict', revision: metaRes.revision };\n      return writeKey('world', 'bible', input.expected_revision, {\n        schema_version: 1,\n        characters: input.characters,\n        relations: input.relations,\n        lore: input.lore,\n      });\n    }\n\n    if (contribution === 'novel.plot.save') {\n      const metaRes = await readKey('meta', 'book', DEFAULT_BOOK);\n      if (metaRes.revision !== input.expected_revision) return { status: 'conflict', revision: metaRes.revision };\n      return writeKey('plot', 'board', input.expected_revision, {\n        schema_version: 1,\n        threads: input.threads,\n      });\n    }\n\n    if (contribution === 'novel.seed_demo') {\n      const metaRes = await readKey('meta', 'book', DEFAULT_BOOK);\n      if (metaRes.revision !== input.expected_revision) return { status: 'conflict', revision: metaRes.revision };\n      const existingKeys = await listAllChapterKeys();\n      const demo = demoPayload();\n      const demoKeys = new Set(Object.keys(demo.bodies).map(id => `ch:${id}`));\n      let rev = input.expected_revision;\n      for (const oldKey of existingKeys) {\n        if (!demoKeys.has(oldKey)) {\n          const d = await deleteKey('chapters', oldKey, rev);\n          if (d.status !== 'deleted') return { status: 'conflict', revision: d.revision };\n          rev = d.revision;\n        }\n      }\n      for (const [chId, doc] of Object.entries(demo.bodies)) {\n        const w = await writeKey('chapters', `ch:${chId}`, rev, { schema_version: 1, ...doc, fs_path: null, fs_sha256: null });\n        if (w.status !== 'saved') return { status: 'conflict', revision: w.revision };\n        rev = w.revision;\n      }\n      const wWorld = await writeKey('world', 'bible', rev, demo.world);\n      if (wWorld.status !== 'saved') return { status: 'conflict', revision: wWorld.revision };\n      rev = wWorld.revision;\n      const wPlot = await writeKey('plot', 'board', rev, demo.plot);\n      if (wPlot.status !== 'saved') return { status: 'conflict', revision: wPlot.revision };\n      rev = wPlot.revision;\n      const wBook = await writeKey('meta', 'book', rev, demo.book);\n      if (wBook.status !== 'saved') return { status: 'conflict', revision: wBook.revision };\n      return { status: 'seeded', revision: wBook.revision };\n    }\n\n    if (contribution === 'novel.fs_list') {\n      const relDir = typeof input.path === 'string' ? input.path : '';\n      const res = await globalThis.nmas.fs.listDir({\n        path: relDir,\n        limit: input.limit ?? 50,\n        ...(input.cursor ? { cursor: input.cursor } : {}),\n      });\n      const entries = (res.entries || []).map(e => ({\n        name: e.name,\n        path: relDir ? `${relDir}/${e.name}` : e.name,\n        kind: e.kind,\n        size_bytes: e.size_bytes ?? null,\n      }));\n      return {\n        path: relDir,\n        entries,\n        next_cursor: res.next_cursor ?? null,\n      };\n    }\n\n    if (contribution === 'novel.fs_stat') {\n      const st = await globalThis.nmas.fs.stat({ path: input.path });\n      return {\n        path: input.path,\n        kind: st.kind,\n        size_bytes: st.size_bytes ?? null,\n        sha256: st.sha256 ?? null,\n      };\n    }\n\n    if (contribution === 'novel.fs_import_chapter') {\n      const file = await globalThis.nmas.fs.readText({ path: input.path });\n      const metaRes = await readKey('meta', 'book', DEFAULT_BOOK);\n      if (metaRes.revision !== input.expected_revision) return { status: 'conflict', revision: metaRes.revision };\n\n      const list = metaRes.value.chapters || [];\n      let chId = input.id ? input.id.trim() : '';\n      if (chId && !/^[a-zA-Z0-9._-]+$/.test(chId)) {\n        return { status: 'invalid_input', revision: metaRes.revision };\n      }\n      if (!chId) {\n        const linked = list.find(c => c.fs_path === input.path);\n        chId = linked ? linked.id : `ch-${Date.now().toString(36)}-${list.length + 1}`;\n      }\n      const existing = list.find(c => c.id === chId);\n      const prevDoc = existing ? (await readKey('chapters', `ch:${chId}`, { beats: '', notes: '' })).value : { beats: '', notes: '' };\n      const body = String(file.content || '').slice(0, 80000);\n      const finalTitle = (input.title && input.title.trim()) || existing?.title || deriveTitleFromMarkdown(body, input.path);\n      const word_count = countWords(body);\n\n      const savedBody = await writeKey('chapters', `ch:${chId}`, input.expected_revision, {\n        schema_version: 1,\n        body,\n        beats: prevDoc.beats || '',\n        notes: prevDoc.notes || '',\n        fs_path: input.path,\n        fs_sha256: file.sha256,\n      });\n      if (savedBody.status !== 'saved') return savedBody;\n\n      const entry = {\n        id: chId,\n        volume: (input.volume && input.volume.trim()) || existing?.volume || '工作区导入卷',\n        order: existing ? existing.order : list.length + 1,\n        title: finalTitle.slice(0, 100),\n        status: existing?.status || 'draft',\n        tension: existing?.tension || 6,\n        pov: (input.pov && input.pov.trim()) || existing?.pov || '',\n        word_count,\n        summary: existing?.summary || `从项目文件 ${input.path} 导入`,\n        fs_path: input.path,\n        fs_sha256: file.sha256,\n      };\n      const nextChapters = existing ? list.map(c => (c.id === chId ? entry : c)) : [...list, entry];\n      const savedMeta = await writeKey('meta', 'book', savedBody.revision, {\n        ...metaRes.value,\n        schema_version: 1,\n        chapters: nextChapters,\n      });\n      if (savedMeta.status !== 'saved') return savedMeta;\n      return {\n        status: 'imported',\n        revision: savedMeta.revision,\n        id: chId,\n        title: entry.title,\n        word_count,\n        fs_path: input.path,\n        fs_sha256: file.sha256,\n        size_bytes: file.size_bytes,\n      };\n    }\n\n    if (contribution === 'novel.fs_export_chapter') {\n      const hasCreate = input.create_only === true;\n      const hasHash = typeof input.expected_sha256 === 'string' && SHA256_RE.test(input.expected_sha256);\n      if (hasCreate === hasHash) {\n        return {\n          status: 'invalid_input',\n          path: input.path,\n          message: 'create_only: true 与 64 位十六进制 expected_sha256 必须严格二选一。',\n        };\n      }\n      const metaRes = await readKey('meta', 'book', DEFAULT_BOOK);\n      const meta = (metaRes.value.chapters || []).find(c => c.id === input.id);\n      if (!meta) {\n        return { status: 'not_found', path: input.path, message: `未找到章节 ${input.id}` };\n      }\n      const chRes = await readKey('chapters', `ch:${input.id}`, { body: '', beats: '', notes: '' });\n      const content = formatChapterMarkdown(meta, chRes.value, input.include_header !== false);\n      try {\n        const written = await globalThis.nmas.fs.writeText({\n          path: input.path,\n          content,\n          ...(hasCreate ? { create_only: true } : { expected_sha256: input.expected_sha256 }),\n        });\n        return {\n          status: 'exported',\n          path: input.path,\n          size_bytes: written.size_bytes,\n          sha256: written.sha256,\n          message: hasCreate ? '已原子新建发布到项目目录。' : '已通过 SHA-256 校验原子更新到本地项目文件。',\n        };\n      } catch (e) {\n        if (e?.code === 'conflict' && e.outcome_unknown === false) {\n          return {\n            status: 'conflict',\n            path: input.path,\n            message: hasCreate\n              ? '目标文件已存在，create_only 模式拒绝覆盖。请先核对本地文件或改用 expected_sha256 原子更新。'\n              : '目标文件自上次同步后已被外部修改或不存在（SHA-256 冲突），已停止覆盖，请先核对本地文件差异。',\n          };\n        }\n        throw e;\n      }\n    }\n\n    if (contribution === 'document.list') {\n      const metaRes = await readKey('meta', 'book', DEFAULT_BOOK);\n      const items = [{ id: 'bible', label: `全书大纲与设定集 (${metaRes.value.title})` }];\n      for (const ch of metaRes.value.chapters || []) {\n        items.push({ id: ch.id, label: `章节：${ch.title} (${ch.word_count} 字)` });\n      }\n      return { items };\n    }\n\n    if (contribution === 'document.export') {\n      const metaRes = await readKey('meta', 'book', DEFAULT_BOOK);\n      if (input.id === 'bible') {\n        const w = await readKey('world', 'bible', DEFAULT_WORLD);\n        const p = await readKey('plot', 'board', DEFAULT_PLOT);\n        const text = JSON.stringify({ format: DOC_FORMAT, version: 1, kind: 'bible', book: metaRes.value, world: w.value, plot: p.value }, null, 2);\n        return { filename: 'novel-bible.json', text };\n      }\n      const meta = (metaRes.value.chapters || []).find(c => c.id === input.id);\n      if (!meta) return { error: 'not_found' };\n      const ch = await readKey('chapters', `ch:${input.id}`, { body: '', beats: '', notes: '' });\n      const text = JSON.stringify({ format: DOC_FORMAT, version: 1, kind: 'chapter', meta, content: ch.value }, null, 2);\n      return { filename: `novel-${input.id}.json`, text };\n    }\n\n    if (contribution === 'document.import') {\n      let parsed;\n      try { parsed = JSON.parse(input.text); } catch { return { imported: false, reason: 'invalid_json' }; }\n      if (parsed?.format !== DOC_FORMAT || parsed?.version !== 1) return { imported: false, reason: 'invalid_document' };\n      const metaRes = await readKey('meta', 'book', DEFAULT_BOOK);\n      const rev = metaRes.revision;\n      if (parsed.kind === 'chapter' && parsed.meta?.title) {\n        const newId = `ch-${Date.now().toString(36)}`;\n        const body = String(parsed.content?.body || '').slice(0, 80000);\n        const w1 = await writeKey('chapters', `ch:${newId}`, rev, {\n          schema_version: 1,\n          body,\n          beats: String(parsed.content?.beats || '').slice(0, 4000),\n          notes: String(parsed.content?.notes || '').slice(0, 4000),\n          fs_path: null,\n          fs_sha256: null,\n        });\n        if (w1.status !== 'saved') return { imported: false, reason: w1.status };\n        const list = metaRes.value.chapters || [];\n        const nextEntry = {\n          id: newId,\n          volume: String(parsed.meta.volume || '导入卷').slice(0, 60),\n          order: list.length + 1,\n          title: String(parsed.meta.title).slice(0, 100),\n          status: ['draft', 'revising', 'done'].includes(parsed.meta.status) ? parsed.meta.status : 'draft',\n          tension: Math.min(10, Math.max(1, Number(parsed.meta.tension) || 5)),\n          pov: String(parsed.meta.pov || '').slice(0, 40),\n          word_count: countWords(body),\n          summary: String(parsed.meta.summary || '').slice(0, 240),\n          fs_path: null,\n          fs_sha256: null,\n        };\n        const w2 = await writeKey('meta', 'book', w1.revision, { ...metaRes.value, chapters: [...list, nextEntry] });\n        return w2.status === 'saved' ? { imported: true } : { imported: false, reason: w2.status };\n      }\n      return { imported: false, reason: 'unsupported_kind' };\n    }\n  }\n\n  if (kind === 'tool') {\n    if (contribution === 'novel.get_story_context') {\n      const metaRes = await readKey('meta', 'book', DEFAULT_BOOK);\n      const worldRes = await readKey('world', 'bible', DEFAULT_WORLD);\n      const plotRes = await readKey('plot', 'board', DEFAULT_PLOT);\n      const chapters = (metaRes.value.chapters || []).map(c => ({\n        id: c.id,\n        volume: c.volume || '第一卷',\n        order: c.order,\n        title: c.title,\n        status: c.status,\n        tension: c.tension,\n        pov: c.pov || '',\n        word_count: c.word_count || 0,\n        summary: c.summary || '',\n        fs_path: typeof c.fs_path === 'string' && c.fs_path ? c.fs_path : null,\n      }));\n      const characters = (worldRes.value.characters || []).map(({ id, name, role, faction, traits, goal }) => ({\n        id, name, role, faction, traits, goal,\n      }));\n      const open_threads = (plotRes.value.threads || [])\n        .filter(t => t.status === 'planted' || t.status === 'hinted')\n        .map(({ id, title, planted_ch, priority, status }) => ({ id, title, planted_ch, priority, status }));\n\n      const base = {\n        title: metaRes.value.title,\n        genre: metaRes.value.genre,\n        logline: metaRes.value.logline,\n        total_words: computeTotalWords(chapters),\n        chapters,\n        characters,\n        open_threads,\n      };\n\n      if (input.chapter_id) {\n        const target = chapters.find(c => c.id === input.chapter_id);\n        if (!target) {\n          return { success: false, status: 'chapter_not_found', ...base };\n        }\n        const chDoc = await readKey('chapters', `ch:${input.chapter_id}`, { body: '', beats: '', notes: '' });\n        return {\n          success: true,\n          status: 'ready',\n          ...base,\n          chapter_detail: {\n            id: target.id,\n            title: target.title,\n            pov: target.pov,\n            beats: chDoc.value.beats || '',\n            notes: chDoc.value.notes || '',\n            body: input.include_body === false ? '' : (chDoc.value.body || ''),\n          },\n        };\n      }\n\n      return {\n        success: true,\n        status: chapters.length ? 'ready' : 'empty',\n        ...base,\n      };\n    }\n\n    if (contribution === 'novel.read_manuscript_file') {\n      try {\n        const file = await globalThis.nmas.fs.readText({ path: input.path });\n        return {\n          success: true,\n          status: 'ready',\n          path: input.path,\n          content: String(file.content || '').slice(0, 120000),\n          word_count: countWords(file.content || ''),\n          size_bytes: file.size_bytes,\n          sha256: file.sha256,\n        };\n      } catch (e) {\n        const code = e?.code === 'permission_denied' || e?.code === 'resource_limit' ? e.code : 'error';\n        return {\n          success: false,\n          status: code,\n          path: input.path,\n          error: String(e?.message || code).slice(0, 240),\n        };\n      }\n    }\n\n    if (contribution === 'novel.upsert_chapter_outline') {\n      const id = String(input.id || '').trim();\n      const title = String(input.title || '').trim();\n      if (!title || !/^[a-zA-Z0-9._-]+$/.test(id)) {\n        return { success: false, status: 'invalid_input' };\n      }\n      const metaRes = await readKey('meta', 'book', DEFAULT_BOOK);\n      const list = metaRes.value.chapters || [];\n      const existing = list.find(c => c.id === id);\n      const prevDocRes = await readKey('chapters', `ch:${id}`, { body: '', beats: '', notes: '', fs_path: null, fs_sha256: null });\n      const prevDoc = prevDocRes.value;\n\n      const body = input.body !== undefined ? String(input.body) : (prevDoc.body || '');\n      const beats = input.beats !== undefined ? String(input.beats) : (prevDoc.beats || '');\n      const notes = input.notes !== undefined ? String(input.notes) : (prevDoc.notes || '');\n      const fsPath = existing?.fs_path || prevDoc.fs_path || null;\n      const fsSha = existing?.fs_sha256 || prevDoc.fs_sha256 || null;\n\n      const savedBody = await writeKey('chapters', `ch:${id}`, prevDocRes.revision, {\n        schema_version: 1,\n        body,\n        beats,\n        notes,\n        fs_path: fsPath,\n        fs_sha256: fsSha,\n      });\n      if (savedBody.status !== 'saved') {\n        return { success: false, status: savedBody.status };\n      }\n\n      const word_count = countWords(body);\n      const order = existing ? existing.order : list.length + 1;\n      const entry = {\n        id,\n        volume: input.volume !== undefined ? (input.volume.trim() || '第一卷') : (existing?.volume || '第一卷'),\n        order,\n        title,\n        status: input.status || existing?.status || 'draft',\n        tension: input.tension !== undefined ? input.tension : (existing?.tension || 6),\n        pov: input.pov !== undefined ? input.pov.trim() : (existing?.pov || ''),\n        word_count,\n        summary: input.summary !== undefined ? input.summary.trim() : (existing?.summary || ''),\n        fs_path: fsPath,\n        fs_sha256: fsSha,\n      };\n      const nextChapters = existing ? list.map(c => (c.id === id ? entry : c)) : [...list, entry];\n      const savedMeta = await writeKey('meta', 'book', savedBody.revision, {\n        ...metaRes.value,\n        schema_version: 1,\n        chapters: nextChapters,\n      });\n      return savedMeta.status === 'saved'\n        ? { success: true, status: 'saved', id, order, word_count, revision: savedMeta.revision }\n        : { success: false, status: savedMeta.status };\n    }\n  }\n\n  throw new Error(`不支持的调用: ${kind}/${contribution}`);\n}\n","path":"backend/index.js"},{"content":"<!doctype html>\n<html lang=\"zh-CN\" data-theme=\"dark\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>AI 长篇小说开发系统</title>\n  <style>\n    :root {\n      --bg: #0b0e14;\n      --bg-elev: #111621;\n      --bg-card: #161d2b;\n      --bg-input: #0e131d;\n      --fg: #e8edf7;\n      --fg-muted: #8b97b1;\n      --border: rgba(148, 163, 184, 0.16);\n      --border-strong: rgba(148, 163, 184, 0.28);\n      --accent: #f59e0b;\n      --accent-soft: rgba(245, 158, 11, 0.14);\n      --blue: #38bdf8;\n      --violet: #a78bfa;\n      --green: #34d399;\n      --red: #fb7185;\n      --shadow: 0 12px 32px rgba(0, 0, 0, 0.32);\n      font: 13.5px/1.6 -apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Segoe UI\", system-ui, sans-serif;\n    }\n    html[data-theme=\"light\"] {\n      --bg: #f6f3ec;\n      --bg-elev: #fdfbf7;\n      --bg-card: #ffffff;\n      --bg-input: #f8f6f0;\n      --fg: #1c1917;\n      --fg-muted: #6b665e;\n      --border: rgba(28, 25, 23, 0.12);\n      --border-strong: rgba(28, 25, 23, 0.22);\n      --accent: #b45309;\n      --accent-soft: rgba(180, 83, 9, 0.1);\n      --blue: #0284c7;\n      --violet: #7c3aed;\n      --green: #059669;\n      --red: #e11d48;\n      --shadow: 0 8px 24px rgba(28, 25, 23, 0.08);\n    }\n    * { box-sizing: border-box; }\n    body { margin: 0; background: var(--bg); color: var(--fg); min-height: 100vh; }\n    .app { display: grid; grid-template-columns: 215px minmax(0, 1fr); min-height: 100vh; }\n    @media (max-width: 820px) { .app { grid-template-columns: 1fr; } .sidebar { border-right: 0; border-bottom: 1px solid var(--border); } }\n\n    .sidebar { background: var(--bg-elev); border-right: 1px solid var(--border); padding: 16px 12px; display: flex; flex-direction: column; gap: 14px; }\n    .brand { display: flex; flex-direction: column; gap: 4px; padding: 6px 8px; }\n    .brand-tag { font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); font-weight: 700; }\n    .brand-title { font-size: 16px; font-weight: 700; margin: 0; line-height: 1.3; }\n    .brand-sub { font-size: 12px; color: var(--fg-muted); }\n\n    .progress-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 10px; padding: 10px; display: flex; flex-direction: column; gap: 6px; }\n    .progress-row { display: flex; justify-content: space-between; font-size: 12px; }\n    .bar { height: 6px; border-radius: 99px; background: var(--border); overflow: hidden; }\n    .bar > i { display: block; height: 100%; background: linear-gradient(90deg, var(--accent), var(--blue)); border-radius: 99px; transition: width .25s ease; }\n\n    .nav { display: flex; flex-direction: column; gap: 4px; }\n    .nav button { text-align: left; border: 1px solid transparent; background: transparent; color: var(--fg-muted); padding: 9px 10px; border-radius: 8px; cursor: pointer; font: inherit; font-weight: 500; display: flex; align-items: center; justify-content: space-between; transition: all .15s; }\n    .nav button:hover { background: var(--bg-card); color: var(--fg); }\n    .nav button.active { background: var(--accent-soft); color: var(--accent); border-color: rgba(245, 158, 11, 0.35); font-weight: 600; }\n    .nav .pill { font-size: 11px; padding: 1px 7px; border-radius: 99px; background: var(--bg-input); color: var(--fg-muted); }\n\n    .sidebar-foot { margin-top: auto; display: flex; flex-direction: column; gap: 6px; }\n\n    .main { display: flex; flex-direction: column; min-width: 0; }\n    .topbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; padding: 12px 18px; border-bottom: 1px solid var(--border); background: var(--bg-elev); }\n    .kpis { display: flex; flex-wrap: wrap; gap: 14px; }\n    .kpi { display: flex; flex-direction: column; }\n    .kpi strong { font-size: 15px; font-weight: 700; }\n    .kpi span { font-size: 11px; color: var(--fg-muted); }\n\n    .content { padding: 16px 18px; flex: 1; display: flex; flex-direction: column; gap: 14px; min-width: 0; }\n    .status-bar { font-size: 12.5px; color: var(--fg-muted); padding: 7px 12px; border-radius: 8px; background: var(--bg-card); border: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; gap: 8px; }\n    .status-bar[data-kind=\"error\"] { color: var(--red); border-color: rgba(251, 113, 133, 0.4); }\n    .status-bar[data-kind=\"ok\"] { color: var(--green); border-color: rgba(52, 211, 153, 0.4); }\n\n    button, input, select, textarea { font: inherit; color: var(--fg); background: var(--bg-input); border: 1px solid var(--border); border-radius: 8px; padding: 7px 10px; }\n    input:focus, select:focus, textarea:focus { outline: none; border-color: var(--accent); }\n    button { cursor: pointer; background: var(--bg-card); transition: border-color .15s, opacity .15s; }\n    button:hover:not(:disabled) { border-color: var(--border-strong); }\n    button.primary { background: var(--accent); border-color: var(--accent); color: #0b0e14; font-weight: 600; }\n    html[data-theme=\"light\"] button.primary { color: #fff; }\n    button.ghost { background: transparent; }\n    button.danger { color: var(--red); border-color: rgba(251, 113, 133, 0.35); }\n    button.sm { padding: 4px 8px; font-size: 12px; }\n    button:disabled { opacity: 0.48; cursor: not-allowed; }\n    .row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }\n    .between { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: space-between; }\n\n    /* Writing IDE 3-column */\n    .write-grid { display: grid; grid-template-columns: 220px minmax(0, 1fr) 310px; gap: 14px; align-items: start; }\n    @media (max-width: 1160px) { .write-grid { grid-template-columns: 200px minmax(0, 1fr); } .sync-panel { grid-column: 1 / -1; } }\n    @media (max-width: 720px) { .write-grid { grid-template-columns: 1fr; } }\n\n    .card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 14px; display: flex; flex-direction: column; gap: 10px; box-shadow: var(--shadow); min-width: 0; }\n    .card h3 { margin: 0; font-size: 13.5px; font-weight: 700; letter-spacing: 0.02em; }\n    .vol-head { font-size: 11px; font-weight: 700; color: var(--accent); text-transform: uppercase; letter-spacing: 0.06em; margin: 6px 0 2px; }\n    .ch-item { text-align: left; width: 100%; padding: 8px 10px; border-radius: 8px; border: 1px solid var(--border); background: var(--bg-input); display: flex; flex-direction: column; gap: 2px; }\n    .ch-item.active { border-color: var(--accent); background: var(--accent-soft); }\n    .ch-meta { font-size: 11.5px; color: var(--fg-muted); display: flex; justify-content: space-between; }\n    .dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; margin-right: 5px; }\n    .dot-done { background: var(--green); }\n    .dot-revising { background: var(--accent); }\n    .dot-draft { background: var(--fg-muted); }\n\n    label.field { display: flex; flex-direction: column; gap: 4px; font-size: 12px; color: var(--fg-muted); font-weight: 600; }\n    textarea.manuscript { min-height: 360px; line-height: 1.85; font-size: 14.5px; font-family: \"Songti SC\", \"Noto Serif SC\", Georgia, serif; padding: 14px; resize: vertical; }\n    textarea.small { min-height: 76px; resize: vertical; font-size: 12.5px; }\n\n    /* FS Sync Panel */\n    .fs-list { display: flex; flex-direction: column; gap: 5px; max-height: 210px; overflow: auto; padding: 6px; border-radius: 8px; background: var(--bg-input); border: 1px solid var(--border); }\n    .fs-row { display: flex; align-items: center; justify-content: space-between; gap: 6px; padding: 5px 7px; border-radius: 6px; font-size: 12px; background: var(--bg-card); border: 1px solid var(--border); }\n    .fs-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; cursor: pointer; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11.5px; }\n    .fs-name:hover { color: var(--accent); }\n    .fs-box { padding: 9px 10px; border-radius: 8px; background: var(--bg-input); border: 1px solid var(--border); font-size: 12px; display: flex; flex-direction: column; gap: 6px; }\n    .fs-box.conflict { border-color: rgba(251, 113, 133, 0.55); background: rgba(251, 113, 133, 0.08); color: var(--red); }\n    .fs-box.ok { border-color: rgba(52, 211, 153, 0.45); background: rgba(52, 211, 153, 0.08); }\n    .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11.5px; word-break: break-all; }\n    .companion-card { border: 1px dashed rgba(167, 139, 250, 0.45); background: rgba(167, 139, 250, 0.08); border-radius: 10px; padding: 10px 11px; display: flex; flex-direction: column; gap: 5px; font-size: 12px; }\n\n    /* Graph & Charts */\n    .split-2 { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(260px, 1fr); gap: 14px; align-items: start; }\n    @media (max-width: 860px) { .split-2 { grid-template-columns: 1fr; } }\n    .svg-wrap { width: 100%; background: var(--bg-input); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }\n    svg { display: block; width: 100%; height: auto; }\n    .badge { display: inline-flex; align-items: center; font-size: 11px; padding: 2px 8px; border-radius: 99px; border: 1px solid var(--border); font-weight: 600; }\n    .b-protagonist { color: var(--accent); border-color: rgba(245, 158, 11, 0.45); background: var(--accent-soft); }\n    .b-antagonist { color: var(--red); border-color: rgba(251, 113, 133, 0.45); background: rgba(251, 113, 133, 0.12); }\n    .b-supporting { color: var(--blue); border-color: rgba(56, 189, 248, 0.45); background: rgba(56, 189, 248, 0.12); }\n    .b-mentor { color: var(--violet); border-color: rgba(167, 139, 250, 0.45); background: rgba(167, 139, 250, 0.12); }\n\n    .grid-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 12px; }\n    .thread-card { border: 1px solid var(--border); border-radius: 10px; padding: 11px; background: var(--bg-input); display: flex; flex-direction: column; gap: 6px; }\n    .thread-card.warn { border-color: rgba(251, 113, 133, 0.6); }\n    [hidden] { display: none !important; }\n  \n    /* === V2 Host Theme & Compact Surface Start === */\n    :root[data-theme=\"dark\"], html[data-theme=\"dark\"] { color-scheme: dark; --bg: #0b0e14; --bg-elev: #111621; --bg-card: #161d2b; --fg: #e8edf7; --fg-muted: #8b97b1; --border: rgba(148, 163, 184, 0.16); --accent: #f59e0b; --v2-host-accent: #f59e0b; }\n    :root[data-theme=\"light\"], html[data-theme=\"light\"] { color-scheme: light; --bg: #f6f3ec; --bg-elev: #fdfbf7; --bg-card: #ffffff; --fg: #1c1917; --fg-muted: #6b665e; --border: rgba(28, 25, 23, 0.12); --accent: #b45309; --v2-host-accent: #b45309; }\n    :root[data-theme=\"dark\"]:not([data-theme-override=\"1\"]), html[data-theme=\"dark\"]:not([data-theme-override=\"1\"]) { --bg: var(--host-bg, #0b0e14); --bg-elev: var(--host-surface, #111621); --bg-card: var(--host-surface, #161d2b); --fg: var(--host-fg, #e8edf7); --fg-muted: var(--host-muted, #8b97b1); --border: var(--host-border, rgba(148, 163, 184, 0.16)); --v2-host-accent: var(--host-primary, #f59e0b); }\n    :root[data-theme=\"light\"]:not([data-theme-override=\"1\"]), html[data-theme=\"light\"]:not([data-theme-override=\"1\"]) { --bg: var(--host-bg, #f6f3ec); --bg-elev: var(--host-surface, #fdfbf7); --bg-card: var(--host-surface, #ffffff); --fg: var(--host-fg, #1c1917); --fg-muted: var(--host-muted, #6b665e); --border: var(--host-border, rgba(28, 25, 23, 0.12)); --v2-host-accent: var(--host-primary, #b45309); }\n    :is(button, input, select, textarea, .v2-surface-tab):focus-visible { outline: 2px solid var(--v2-host-accent, var(--accent)); outline-offset: 1px; }\n    html[data-surface=\"chat\"], html[data-surface=\"assistant\"],\n    html[data-surface=\"chat\"] body, html[data-surface=\"assistant\"] body { overflow-x: hidden; }\n    html[data-surface=\"chat\"] .sidebar, html[data-surface=\"assistant\"] .sidebar { display: none !important; }\n    html[data-surface=\"chat\"] .app, html[data-surface=\"assistant\"] .app { grid-template-columns: 1fr !important; }\n    html[data-surface=\"chat\"] .write-grid, html[data-surface=\"assistant\"] .write-grid, html[data-surface=\"chat\"] .split-2, html[data-surface=\"assistant\"] .split-2, html[data-surface=\"chat\"] .grid-cards, html[data-surface=\"assistant\"] .grid-cards { grid-template-columns: 1fr !important; }\n    \n    html[data-surface=\"chat\"] :is(section, article, main, .card, .panel, .view),\n    html[data-surface=\"assistant\"] :is(section, article, main, .card, .panel, .view) { min-width: 0; }\n    html[data-surface=\"chat\"] :is(svg, canvas, pre),\n    html[data-surface=\"assistant\"] :is(svg, canvas, pre) { max-width: 100%; }\n    html[data-surface=\"chat\"] .sync-panel, html[data-surface=\"assistant\"] .sync-panel { grid-column: auto !important; }\n    html[data-surface=\"chat\"] .topbar, html[data-surface=\"assistant\"] .topbar { padding: 8px 10px; gap: 8px; }\n    html[data-surface=\"chat\"] .kpis, html[data-surface=\"assistant\"] .kpis { gap: 10px; }\n    html[data-surface=\"chat\"] .content, html[data-surface=\"assistant\"] .content { padding: 10px; gap: 10px; }\n    .v2-surface-nav { display: none; }\n    html[data-surface=\"chat\"] .v2-surface-nav, html[data-surface=\"assistant\"] .v2-surface-nav {\n      display: flex; align-items: center; gap: 6px; padding: 7px 10px; \n      overflow-x: auto; scrollbar-width: none; flex-shrink: 0;\n      background: var(--bg-elev); border-bottom: 1px solid var(--border);\n      position: sticky; top: 0; z-index: 30;\n    }\n    html[data-surface=\"chat\"] .v2-surface-nav::-webkit-scrollbar, html[data-surface=\"assistant\"] .v2-surface-nav::-webkit-scrollbar { display: none; }\n    .v2-surface-tab {\n      appearance: none; border: 1px solid var(--border); background: transparent;\n      color: var(--fg-muted); border-radius: 999px; padding: 4px 10px; font-size: 12px;\n      line-height: 1.35; font-weight: 500; white-space: nowrap; flex-shrink: 0; cursor: pointer;\n      transition: background 0.14s ease, border-color 0.14s ease, color 0.14s ease;\n    }\n    .v2-surface-tab:hover { color: var(--fg); border-color: var(--v2-host-accent, var(--accent)); }\n    .v2-surface-tab.active {\n      color: var(--v2-host-accent, var(--accent));\n      border-color: var(--v2-host-accent, var(--accent));\n      background: color-mix(in srgb, var(--v2-host-accent, var(--accent)) 14%, transparent);\n      font-weight: 600;\n    }\n    /* === V2 Host Theme & Compact Surface End === */\n  </style>\n</head>\n<body>\n  <div class=\"app\">\n    <aside class=\"sidebar\">\n      <div class=\"brand\">\n        <span class=\"brand-tag\">NOVEL STUDIO V2 · PROJECT</span>\n        <h1 id=\"book-title\" class=\"brand-title\">AI 长篇小说开发系统</h1>\n        <span id=\"book-genre\" class=\"brand-sub\">长篇创作与工作区同步工作台</span>\n      </div>\n\n      <div class=\"progress-card\">\n        <div class=\"progress-row\"><span>全书字数进度</span><strong id=\"pct-label\">0%</strong></div>\n        <div class=\"bar\"><i id=\"pct-bar\" style=\"width:0%\"></i></div>\n        <div class=\"progress-row\" style=\"color:var(--fg-muted)\"><span id=\"words-now\">0 字</span><span id=\"words-target\">目标 120,000</span></div>\n      </div>\n\n      <nav class=\"nav\">\n        <button class=\"active\" data-view=\"write\" type=\"button\"><span>✍️ 卷章写作与同步</span><span id=\"nav-ch\" class=\"pill\">0</span></button>\n        <button data-view=\"characters\" type=\"button\"><span>🕸️ 人物关系图谱</span><span id=\"nav-char\" class=\"pill\">0</span></button>\n        <button data-view=\"plot\" type=\"button\"><span>📈 张力曲线与伏笔</span><span id=\"nav-plot\" class=\"pill\">0</span></button>\n        <button data-view=\"world\" type=\"button\"><span>🌌 世界观与书目</span><span id=\"nav-lore\" class=\"pill\">0</span></button>\n      </nav>\n\n      <div class=\"sidebar-foot\">\n        <button id=\"btn-demo\" type=\"button\">✨ 加载演示《星渊回响》</button>\n        <button id=\"btn-theme\" type=\"button\">☀️ 切换护眼暖白/墨夜</button>\n      </div>\n    </aside>\n\n    <div class=\"main\">\n      <header class=\"topbar\">\n        <div class=\"kpis\">\n          <div class=\"kpi\"><strong id=\"kpi-words\">0</strong><span>累计字数</span></div>\n          <div class=\"kpi\"><strong id=\"kpi-chapters\">0</strong><span>已建章节</span></div>\n          <div class=\"kpi\"><strong id=\"kpi-chars\">0</strong><span>人物 / 关系</span></div>\n          <div class=\"kpi\"><strong id=\"kpi-threads\">0</strong><span>待回收伏笔</span></div>\n        </div>\n        <div class=\"row\">\n          <button id=\"btn-new-ch\" class=\"primary\" type=\"button\">+ 新建章节</button>\n          <button id=\"btn-refresh\" type=\"button\">刷新同步</button>\n        </div>\n      </header>\n\n      <div class=\"content\">\n        <div id=\"status\" class=\"status-bar\" role=\"status\"><span id=\"status-text\">正在初始化小说工作台…</span><span id=\"rev-tag\">rev #0</span></div>\n\n        <!-- VIEW 1: 卷章写作台 -->\n        <section id=\"view-write\" class=\"write-grid\">\n          <div class=\"card\">\n            <div class=\"between\">\n              <h3>卷章大纲</h3>\n              <span id=\"ch-count-tip\" style=\"font-size:11.5px;color:var(--fg-muted)\">0 章</span>\n            </div>\n            <div id=\"chapter-tree\" style=\"display:flex;flex-direction:column;gap:6px;max-height:560px;overflow:auto\"></div>\n          </div>\n\n          <div class=\"card\">\n            <div class=\"between\">\n              <h3 id=\"editor-caption\">章节正文编辑器</h3>\n              <div class=\"row\">\n                <span id=\"live-words\" style=\"font-size:12px;color:var(--fg-muted)\">0 字</span>\n                <button id=\"btn-save-ch\" class=\"primary\" type=\"button\">保存本章</button>\n                <button id=\"btn-del-ch\" class=\"danger\" type=\"button\" hidden>删除</button>\n              </div>\n            </div>\n            <div class=\"row\">\n              <label class=\"field\" style=\"flex:1.4;min-width:150px\">章节标题 <input id=\"ch-title\" placeholder=\"例如：第1章 零号信标重启\" maxlength=\"100\"></label>\n              <label class=\"field\" style=\"flex:1;min-width:120px\">所属卷 <input id=\"ch-vol\" placeholder=\"第一卷 · 沉没轨道\" maxlength=\"60\"></label>\n            </div>\n            <div class=\"row\">\n              <label class=\"field\" style=\"width:120px\">视角人物 <input id=\"ch-pov\" placeholder=\"林深\" maxlength=\"40\"></label>\n              <label class=\"field\" style=\"width:110px\">状态\n                <select id=\"ch-status\">\n                  <option value=\"draft\">草稿</option>\n                  <option value=\"revising\">润色中</option>\n                  <option value=\"done\">已定稿</option>\n                </select>\n              </label>\n              <label class=\"field\" style=\"flex:1;min-width:130px\">剧情张力 (<span id=\"tension-val\">6</span>/10)\n                <input id=\"ch-tension\" type=\"range\" min=\"1\" max=\"10\" value=\"6\">\n              </label>\n            </div>\n            <label class=\"field\">本章一句话摘要（供 Agent Tool 理解前文脉络）\n              <input id=\"ch-summary\" maxlength=\"240\" placeholder=\"概括本章推动的核心事件与悬念…\">\n            </label>\n            <label class=\"field\">场景节拍 (Scene Beats)\n              <textarea id=\"ch-beats\" class=\"small\" maxlength=\"4000\" placeholder=\"1. 开场钩子&#10;2. 冲突升级&#10;3. 章节结尾反转\"></textarea>\n            </label>\n            <label class=\"field\">正文手稿（V2 单章支持 240 KiB 长正文）\n              <textarea id=\"ch-body\" class=\"manuscript\" maxlength=\"80000\" placeholder=\"开始书写本章正文，或从右侧项目手稿同步面板导入本地 Markdown 章节…\"></textarea>\n            </label>\n            <label class=\"field\">作者备忘\n              <input id=\"ch-notes\" maxlength=\"4000\" placeholder=\"记录伏笔提醒、文风控制点…\">\n            </label>\n          </div>\n\n          <div class=\"card sync-panel\">\n            <div class=\"between\">\n              <h3>📁 项目手稿同步 (CAS)</h3>\n              <button id=\"btn-fs-list\" class=\"sm\" type=\"button\">浏览目录</button>\n            </div>\n            <div class=\"row\">\n              <input id=\"fs-dir\" style=\"flex:1;min-width:110px\" placeholder=\"相对目录，如 chapters（留空为根目录）\" maxlength=\"512\">\n              <button id=\"btn-fs-up\" class=\"sm\" type=\"button\" title=\"返回上级目录\">↑ 上级</button>\n            </div>\n            <div id=\"fs-entries\" class=\"fs-list\">\n              <span style=\"color:var(--fg-muted);font-size:12px\">点击「浏览目录」列出项目工作区中的 Markdown 手稿与子目录。</span>\n            </div>\n\n            <div class=\"fs-box\">\n              <strong style=\"font-size:12px\">目标手稿路径与 CAS 哈希锚点</strong>\n              <label class=\"field\">项目相对路径\n                <input id=\"fs-target-path\" placeholder=\"例如：chapters/ch-01.md\" maxlength=\"512\">\n              </label>\n              <label class=\"field\">预期 SHA-256（CAS 更新必填；新建留空）\n                <input id=\"fs-expected-sha\" class=\"mono\" placeholder=\"64 位十六进制 SHA-256（导入/检查后自动填入）\" maxlength=\"64\">\n              </label>\n              <div class=\"row\">\n                <button id=\"btn-fs-stat\" class=\"sm\" type=\"button\">检查 Stat</button>\n                <button id=\"btn-fs-import\" class=\"sm\" type=\"button\">导入为章节</button>\n              </div>\n              <div class=\"row\">\n                <button id=\"btn-fs-export-new\" class=\"primary sm\" type=\"button\" style=\"flex:1\">新建发布 (create_only)</button>\n                <button id=\"btn-fs-export-cas\" class=\"sm\" type=\"button\" style=\"flex:1\">CAS 原子更新</button>\n              </div>\n            </div>\n\n            <div id=\"fs-feedback\" class=\"fs-box\" hidden></div>\n\n            <div class=\"companion-card\">\n              <strong style=\"color:var(--violet)\">✨ 流式 AI 伴生创作提示</strong>\n              <span style=\"color:var(--fg-muted);line-height:1.55\">\n                为遵守 Velai Desktop V2 安全隔离（项目文件读写插件不混用受管 AI 通道），流式续写与润色请搭配伴生插件 <strong>novel-ai-writer</strong>；或在 Velai 对话中直接调用本插件提供的 3 个 v2 Agent Tools（<code>novel.get_story_context</code> / <code>novel.read_manuscript_file</code> / <code>novel.upsert_chapter_outline</code>）。\n              </span>\n            </div>\n          </div>\n        </section>\n\n        <!-- VIEW 2: 人物关系图谱 -->\n        <section id=\"view-characters\" class=\"split-2\" hidden>\n          <div class=\"card\">\n            <div class=\"between\">\n              <h3>人物关系星系图 (点击节点查看详情)</h3>\n              <div class=\"row\" style=\"font-size:11.5px\">\n                <span class=\"badge b-protagonist\">主角</span>\n                <span class=\"badge b-antagonist\">反派</span>\n                <span class=\"badge b-supporting\">核心配角</span>\n                <span class=\"badge b-mentor\">导师</span>\n              </div>\n            </div>\n            <div class=\"svg-wrap\"><svg id=\"rel-svg\" viewBox=\"0 0 640 420\"></svg></div>\n            <div class=\"between\" style=\"margin-top:4px\">\n              <h3>关系连线清单</h3>\n              <div class=\"row\">\n                <select id=\"rel-from\" style=\"width:105px\"></select>\n                <select id=\"rel-kind\" style=\"width:92px\">\n                  <option value=\"ally\">盟友</option>\n                  <option value=\"rival\">宿敌</option>\n                  <option value=\"mentor\">师徒</option>\n                  <option value=\"romance\">情感</option>\n                  <option value=\"secret\">暗线</option>\n                </select>\n                <select id=\"rel-to\" style=\"width:105px\"></select>\n                <input id=\"rel-label\" placeholder=\"关系说明\" maxlength=\"40\" style=\"width:120px\">\n                <button id=\"btn-add-rel\" class=\"primary\" type=\"button\">+ 连线</button>\n              </div>\n            </div>\n            <div id=\"rel-list\" class=\"row\"></div>\n          </div>\n\n          <div class=\"card\">\n            <div class=\"between\">\n              <h3 id=\"char-form-title\">人物档案卡</h3>\n              <button id=\"btn-new-char\" type=\"button\">+ 新人物</button>\n            </div>\n            <div class=\"row\">\n              <label class=\"field\" style=\"flex:1\">姓名 <input id=\"c-name\" maxlength=\"40\" placeholder=\"例如：林深\"></label>\n              <label class=\"field\" style=\"width:120px\">定位\n                <select id=\"c-role\">\n                  <option value=\"protagonist\">主角</option>\n                  <option value=\"antagonist\">反派</option>\n                  <option value=\"supporting\">配角</option>\n                  <option value=\"mentor\">导师</option>\n                </select>\n              </label>\n            </div>\n            <label class=\"field\">所属阵营 <input id=\"c-faction\" maxlength=\"40\" placeholder=\"例如：自由打捞公会\"></label>\n            <label class=\"field\">性格标签 <input id=\"c-traits\" maxlength=\"120\" placeholder=\"冷静、机械直觉极强…\"></label>\n            <label class=\"field\">核心目标/动机 <textarea id=\"c-goal\" class=\"small\" maxlength=\"200\"></textarea></label>\n            <label class=\"field\">隐藏秘密/弱点 <textarea id=\"c-secret\" class=\"small\" maxlength=\"200\"></textarea></label>\n            <div class=\"row\">\n              <button id=\"btn-save-char\" class=\"primary\" type=\"button\" style=\"flex:1\">保存人物卡</button>\n              <button id=\"btn-del-char\" class=\"danger\" type=\"button\" hidden>删除</button>\n            </div>\n          </div>\n        </section>\n\n        <!-- VIEW 3: 张力曲线与伏笔 -->\n        <section id=\"view-plot\" style=\"display:flex;flex-direction:column;gap:14px\" hidden>\n          <div class=\"card\">\n            <div class=\"between\">\n              <h3>全书剧情张力曲线与章节字数分布</h3>\n              <span style=\"font-size:12px;color:var(--fg-muted)\">琥珀折线：张力值 (1–10) · 浅蓝柱：章节字数</span>\n            </div>\n            <div class=\"svg-wrap\"><svg id=\"tension-svg\" viewBox=\"0 0 820 230\"></svg></div>\n          </div>\n\n          <div class=\"card\">\n            <div class=\"between\">\n              <h3>伏笔与线索回收板</h3>\n              <div class=\"row\">\n                <input id=\"th-title\" placeholder=\"新伏笔标题…\" maxlength=\"80\" style=\"width:200px\">\n                <input id=\"th-planted\" type=\"number\" min=\"1\" value=\"1\" style=\"width:76px\" title=\"埋设章节\">\n                <select id=\"th-priority\" style=\"width:92px\">\n                  <option value=\"critical\">核心主线</option>\n                  <option value=\"major\">重要支线</option>\n                  <option value=\"minor\">细节彩蛋</option>\n                </select>\n                <input id=\"th-detail\" placeholder=\"伏笔说明…\" maxlength=\"240\" style=\"width:200px\">\n                <button id=\"btn-add-thread\" class=\"primary\" type=\"button\">+ 埋设伏笔</button>\n              </div>\n            </div>\n            <div id=\"thread-grid\" class=\"grid-cards\"></div>\n          </div>\n        </section>\n\n        <!-- VIEW 4: 世界观与书目 -->\n        <section id=\"view-world\" style=\"display:flex;flex-direction:column;gap:14px\" hidden>\n          <div class=\"card\">\n            <div class=\"between\">\n              <h3>书籍元数据</h3>\n              <button id=\"btn-save-book\" class=\"primary\" type=\"button\">保存书目信息</button>\n            </div>\n            <div class=\"row\">\n              <label class=\"field\" style=\"flex:1.4;min-width:160px\">书名 <input id=\"b-title\" maxlength=\"100\"></label>\n              <label class=\"field\" style=\"flex:1;min-width:120px\">题材流派 <input id=\"b-genre\" maxlength=\"40\"></label>\n              <label class=\"field\" style=\"width:140px\">字数目标 <input id=\"b-target\" type=\"number\" min=\"1000\" step=\"1000\"></label>\n            </div>\n            <label class=\"field\">一句话核心卖点 (Logline) <textarea id=\"b-logline\" class=\"small\" maxlength=\"400\"></textarea></label>\n          </div>\n\n          <div class=\"card\">\n            <div class=\"between\">\n              <h3>世界观设定集 (World Bible)</h3>\n              <div class=\"row\">\n                <select id=\"lore-cat\" style=\"width:110px\">\n                  <option value=\"location\">地点</option>\n                  <option value=\"faction\">势力</option>\n                  <option value=\"magic_tech\">力量/科技</option>\n                  <option value=\"artifact\">核心道具</option>\n                  <option value=\"history\">历史事件</option>\n                </select>\n                <input id=\"lore-title\" placeholder=\"词条名称\" maxlength=\"64\" style=\"width:150px\">\n                <input id=\"lore-detail\" placeholder=\"设定详情…\" maxlength=\"400\" style=\"width:240px\">\n                <button id=\"btn-add-lore\" class=\"primary\" type=\"button\">+ 新增词条</button>\n              </div>\n            </div>\n            <div id=\"lore-grid\" class=\"grid-cards\"></div>\n          </div>\n        </section>\n      </div>\n    </div>\n  </div>\n  <script>\n    (() => {\n      const plugin = globalThis.nmasPlugin;\n      const $ = id => document.getElementById(id);\n      const ROLE_COLOR = { protagonist: '#f59e0b', antagonist: '#fb7185', supporting: '#38bdf8', mentor: '#a78bfa' };\n      const ROLE_NAME = { protagonist: '主角', antagonist: '反派', supporting: '配角', mentor: '导师' };\n      const REL_COLOR = { ally: '#34d399', rival: '#fb7185', mentor: '#a78bfa', romance: '#f472b6', secret: '#f59e0b' };\n      const LORE_CAT = { location: '地点', faction: '势力', magic_tech: '力量/科技', artifact: '核心道具', history: '历史' };\n      const TH_NEXT = { planted: 'hinted', hinted: 'payoff', payoff: 'planted', abandoned: 'planted' };\n      const TH_NAME = { planted: '已埋设', hinted: '已推进', payoff: '已回收', abandoned: '已弃置' };\n\n      let state = { revision: 0, book: null, characters: [], relations: [], lore: [], threads: [], stored_chapter_keys: [] };\n      let activeChId = null, activeCharId = null, busy = false, currentDir = '';\n\n      const setStatus = (msg, kind = '') => {\n        $('status-text').textContent = msg;\n        $('status').dataset.kind = kind;\n        $('rev-tag').textContent = `rev #${state.revision}`;\n      };\n      const setFsFeedback = (msg, kind = '') => {\n        const box = $('fs-feedback');\n        box.className = `fs-box${kind ? ` ${kind}` : ''}`;\n        box.textContent = msg;\n        box.hidden = !msg;\n      };\n      const countWords = t => {\n        const m = (t || '').match(/[A-Za-z0-9]+(?:['’-][A-Za-z0-9]+)*|[\\u3400-\\u4dbf\\u4e00-\\u9fff]/g);\n        return m ? m.length : 0;\n      };\n      const svgEl = (tag, attrs = {}, text = '') => {\n        const el = document.createElementNS('http://www.w3.org/2000/svg', tag);\n        for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, String(v));\n        if (text) el.textContent = text;\n        return el;\n      };\n\n      function switchView(name) {\n        document.querySelectorAll('.nav button').forEach(b => b.classList.toggle('active', b.dataset.view === name));\n        ['write', 'characters', 'plot', 'world'].forEach(v => { $(`view-${v}`).hidden = v !== name; });\n        if (name === 'characters') renderRelationGraph();\n        if (name === 'plot') renderTensionChart();\n      }\n\n      function renderSummary() {\n        const b = state.book;\n        if (!b) return;\n        $('book-title').textContent = b.title;\n        $('book-genre').textContent = b.genre || '长篇创作';\n        const pct = Math.min(100, Math.round((b.total_words / Math.max(1, b.target_words)) * 100));\n        $('pct-label').textContent = `${pct}%`;\n        $('pct-bar').style.width = `${pct}%`;\n        $('words-now').textContent = `${b.total_words.toLocaleString()} 字`;\n        $('words-target').textContent = `目标 ${b.target_words.toLocaleString()}`;\n        $('kpi-words').textContent = b.total_words.toLocaleString();\n        $('kpi-chapters').textContent = String(b.chapters.length);\n        $('kpi-chars').textContent = `${state.characters.length} / ${state.relations.length}`;\n        const openThreads = state.threads.filter(t => t.status === 'planted' || t.status === 'hinted').length;\n        $('kpi-threads').textContent = String(openThreads);\n        $('nav-ch').textContent = String(b.chapters.length);\n        $('nav-char').textContent = String(state.characters.length);\n        $('nav-plot').textContent = String(state.threads.length);\n        $('nav-lore').textContent = String(state.lore.length);\n        $('b-title').value = b.title;\n        $('b-genre').value = b.genre;\n        $('b-target').value = String(b.target_words);\n        $('b-logline').value = b.logline;\n      }\n\n      function renderChapterTree() {\n        const tree = $('chapter-tree');\n        tree.replaceChildren();\n        const chapters = state.book?.chapters || [];\n        $('ch-count-tip').textContent = `${chapters.length} 章`;\n        if (!chapters.length) {\n          const p = document.createElement('p');\n          p.style.cssText = 'color:var(--fg-muted);font-size:12.5px;margin:8px 0';\n          p.textContent = '暂无章节。点击「新建章节」或左侧「加载演示《星渊回响》」。';\n          tree.appendChild(p);\n          return;\n        }\n        let lastVol = '';\n        for (const ch of chapters) {\n          if (ch.volume !== lastVol) {\n            lastVol = ch.volume;\n            const vh = document.createElement('div');\n            vh.className = 'vol-head';\n            vh.textContent = ch.volume || '正文卷';\n            tree.appendChild(vh);\n          }\n          const btn = document.createElement('button');\n          btn.type = 'button';\n          btn.className = `ch-item${ch.id === activeChId ? ' active' : ''}`;\n          const top = document.createElement('div');\n          const dot = document.createElement('span');\n          dot.className = `dot dot-${ch.status}`;\n          top.append(dot, ch.title);\n          const meta = document.createElement('div');\n          meta.className = 'ch-meta';\n          const s1 = document.createElement('span');\n          s1.textContent = `${ch.pov || '全知'} · 张力 ${ch.tension}${ch.fs_path ? ' · 🔗' : ''}`;\n          const s2 = document.createElement('span');\n          s2.textContent = `${ch.word_count} 字`;\n          meta.append(s1, s2);\n          btn.append(top, meta);\n          btn.addEventListener('click', () => openChapter(ch.id));\n          tree.appendChild(btn);\n        }\n      }\n\n      async function openChapter(id) {\n        activeChId = id;\n        const meta = state.book?.chapters.find(c => c.id === id);\n        renderChapterTree();\n        $('btn-del-ch').hidden = !meta;\n        if (!meta) {\n          $('editor-caption').textContent = '新建章节';\n          $('ch-title').value = '';\n          $('ch-vol').value = state.book?.chapters.at(-1)?.volume || '第一卷';\n          $('ch-pov').value = state.characters[0]?.name || '';\n          $('ch-status').value = 'draft';\n          $('ch-tension').value = '6';\n          $('tension-val').textContent = '6';\n          $('ch-summary').value = '';\n          $('ch-beats').value = '';\n          $('ch-body').value = '';\n          $('ch-notes').value = '';\n          $('live-words').textContent = '0 字';\n          $('fs-target-path').value = '';\n          $('fs-expected-sha').value = '';\n          return;\n        }\n        $('editor-caption').textContent = `正在编辑 · ${meta.title}`;\n        $('ch-title').value = meta.title;\n        $('ch-vol').value = meta.volume;\n        $('ch-pov').value = meta.pov;\n        $('ch-status').value = meta.status;\n        $('ch-tension').value = String(meta.tension);\n        $('tension-val').textContent = String(meta.tension);\n        $('ch-summary').value = meta.summary;\n        $('fs-target-path').value = meta.fs_path || `${meta.id}.md`;\n        $('fs-expected-sha').value = meta.fs_sha256 || '';\n        try {\n          const doc = await plugin.action('novel.chapter.get', { id });\n          $('ch-beats').value = doc.found ? doc.beats : '';\n          $('ch-body').value = doc.found ? doc.body : '';\n          $('ch-notes').value = doc.found ? doc.notes : '';\n          if (doc.found && doc.fs_path) $('fs-target-path').value = doc.fs_path;\n          if (doc.found && doc.fs_sha256) $('fs-expected-sha').value = doc.fs_sha256;\n          $('live-words').textContent = `${countWords($('ch-body').value)} 字`;\n        } catch (e) { setStatus(`读取章节失败：${e?.message}`, 'error'); }\n      }\n\n      async function browseFs(dirPath) {\n        currentDir = (dirPath || '').trim().replace(/^\\/+|\\/+$/g, '');\n        $('fs-dir').value = currentDir;\n        const box = $('fs-entries');\n        box.textContent = '正在读取项目工作区目录…';\n        try {\n          const res = await plugin.action('novel.fs_list', { path: currentDir, limit: 50 });\n          box.replaceChildren();\n          if (!res.entries.length) {\n            const sp = document.createElement('span');\n            sp.style.cssText = 'color:var(--fg-muted);font-size:12px';\n            sp.textContent = '目录为空。';\n            box.appendChild(sp);\n            return;\n          }\n          for (const ent of res.entries) {\n            const row = document.createElement('div');\n            row.className = 'fs-row';\n            const name = document.createElement('span');\n            name.className = 'fs-name';\n            name.textContent = `${ent.kind === 'dir' ? '📂 ' : '📄 '}${ent.name}`;\n            name.title = ent.path;\n            const actions = document.createElement('div');\n            actions.className = 'row';\n            actions.style.gap = '4px';\n            if (ent.kind === 'dir') {\n              name.addEventListener('click', () => browseFs(ent.path));\n              const openBtn = document.createElement('button');\n              openBtn.type = 'button';\n              openBtn.className = 'sm';\n              openBtn.textContent = '进入';\n              openBtn.addEventListener('click', () => browseFs(ent.path));\n              actions.appendChild(openBtn);\n            } else {\n              name.addEventListener('click', () => {\n                $('fs-target-path').value = ent.path;\n                void inspectFsStat(ent.path);\n              });\n              const sz = document.createElement('span');\n              sz.style.cssText = 'font-size:11px;color:var(--fg-muted)';\n              sz.textContent = `${ent.size_bytes ?? 0}B`;\n              const impBtn = document.createElement('button');\n              impBtn.type = 'button';\n              impBtn.className = 'sm';\n              impBtn.textContent = '导入';\n              impBtn.addEventListener('click', () => {\n                $('fs-target-path').value = ent.path;\n                void importFsChapter(ent.path);\n              });\n              actions.append(sz, impBtn);\n            }\n            row.append(name, actions);\n            box.appendChild(row);\n          }\n          setStatus(`已列出工作区目录 ${currentDir || '/'}（${res.entries.length} 项）`);\n        } catch (e) {\n          box.textContent = `无法读取目录：${e?.message || '权限被拒绝'}`;\n          setFsFeedback(`目录浏览失败：${e?.message || '未知错误'}`, 'conflict');\n        }\n      }\n\n      async function inspectFsStat(path) {\n        const target = (path || $('fs-target-path').value).trim();\n        if (!target) { setFsFeedback('请填写项目相对文件路径。', 'conflict'); return; }\n        try {\n          const st = await plugin.action('novel.fs_stat', { path: target });\n          if (st.sha256) $('fs-expected-sha').value = st.sha256;\n          setFsFeedback(`Stat 成功：${st.path} (${st.kind}, ${st.size_bytes ?? 0} B) · SHA-256: ${st.sha256 ? st.sha256.slice(0, 16) + '…' : '无'}`, 'ok');\n        } catch (e) {\n          setFsFeedback(`Stat 失败：${e?.message || '文件不存在或路径被禁止'}`, 'conflict');\n        }\n      }\n\n      async function importFsChapter(path) {\n        const target = (path || $('fs-target-path').value).trim();\n        if (!target) { setFsFeedback('请先指定要导入的项目相对路径。', 'conflict'); return; }\n        if (busy) return;\n        busy = true;\n        try {\n          const res = await plugin.action('novel.fs_import_chapter', {\n            expected_revision: state.revision,\n            path: target,\n          });\n          if (res.status === 'imported') {\n            $('fs-expected-sha').value = res.fs_sha256 || '';\n            await load(res.id);\n            setFsFeedback(`已导入 ${res.fs_path} → 章节《${res.title}》（${res.word_count} 字），已记录 SHA-256 锚点。`, 'ok');\n            setStatus(`成功导入工作区手稿 ${res.fs_path}`, 'ok');\n          } else {\n            setFsFeedback(`导入未完成：${res.status}`, 'conflict');\n          }\n        } catch (e) {\n          setFsFeedback(`导入失败：${e?.message || '路径受限或读取异常'}`, 'conflict');\n          setStatus(`导入失败：${e?.message}`, 'error');\n        } finally {\n          busy = false;\n        }\n      }\n\n      async function exportFsChapter(mode) {\n        if (!activeChId) { setFsFeedback('请先选择或保存一个章节后再导出。', 'conflict'); return; }\n        const target = $('fs-target-path').value.trim();\n        if (!target) { setFsFeedback('请填写导出目标相对路径（如 chapters/ch-01.md）。', 'conflict'); return; }\n        const payload = { id: activeChId, path: target, include_header: true };\n        if (mode === 'create') {\n          payload.create_only = true;\n        } else {\n          const sha = $('fs-expected-sha').value.trim();\n          if (!/^[0-9a-f]{64}$/.test(sha)) {\n            setFsFeedback('CAS 原子更新模式必须填写有效的 64 位十六进制 expected_sha256（可先点击「检查 Stat」核对）。', 'conflict');\n            return;\n          }\n          payload.expected_sha256 = sha;\n        }\n        if (busy) return;\n        busy = true;\n        try {\n          const res = await plugin.action('novel.fs_export_chapter', payload);\n          if (res.status === 'exported') {\n            $('fs-expected-sha').value = res.sha256 || '';\n            setFsFeedback(`原子导出成功：${res.path}（${res.size_bytes} B）· 新 SHA-256: ${res.sha256?.slice(0, 16)}…`, 'ok');\n            setStatus(`已导出至工作区 ${res.path}`, 'ok');\n            // 同步保存章节的 fs_path / fs_sha256 锚点\n            const meta = state.book?.chapters.find(c => c.id === activeChId);\n            if (meta && res.sha256) {\n              const saved = await plugin.action('novel.chapter.save', {\n                expected_revision: state.revision,\n                id: activeChId,\n                volume: $('ch-vol').value.trim() || meta.volume,\n                title: $('ch-title').value.trim() || meta.title,\n                status: $('ch-status').value,\n                tension: Number($('ch-tension').value),\n                pov: $('ch-pov').value.trim(),\n                summary: $('ch-summary').value.trim(),\n                beats: $('ch-beats').value,\n                notes: $('ch-notes').value,\n                body: $('ch-body').value,\n                fs_path: res.path,\n                fs_sha256: res.sha256,\n              });\n              if (saved.status === 'saved') await load(activeChId);\n            }\n          } else if (res.status === 'conflict') {\n            setFsFeedback(`⚠️ 检测到文件冲突：${res.message}`, 'conflict');\n            setStatus('导出因 CAS 冲突中止，未覆盖本地文件。', 'error');\n          } else {\n            setFsFeedback(`导出未完成 (${res.status})：${res.message || ''}`, 'conflict');\n          }\n        } catch (e) {\n          setFsFeedback(`导出被拒绝：${e?.message || '路径不合法或父目录不存在'}`, 'conflict');\n          setStatus(`导出失败：${e?.message}`, 'error');\n        } finally {\n          busy = false;\n        }\n      }\n\n      function renderRelationGraph() {\n        const svg = $('rel-svg');\n        svg.replaceChildren();\n        const chars = state.characters;\n        const rels = state.relations;\n        const defs = svgEl('defs');\n        const glow = svgEl('filter', { id: 'glow' });\n        glow.appendChild(svgEl('feGaussianBlur', { stdDeviation: 3.5, result: 'blur' }));\n        const merge = svgEl('feMerge');\n        merge.append(svgEl('feMergeNode', { in: 'blur' }), svgEl('feMergeNode', { in: 'SourceGraphic' }));\n        glow.appendChild(merge);\n        defs.appendChild(glow);\n        svg.appendChild(defs);\n\n        const cx = 320, cy = 210;\n        for (const r of [75, 140, 195]) {\n          svg.appendChild(svgEl('circle', { cx, cy, r, fill: 'none', stroke: 'rgba(148,163,184,0.1)', 'stroke-dasharray': '3 5' }));\n        }\n        if (!chars.length) {\n          svg.appendChild(svgEl('text', { x: cx, y: cy, 'text-anchor': 'middle', fill: '#8b97b1', 'font-size': 13 }, '暂无人物，点击右侧「+ 新人物」或加载演示项目'));\n          return;\n        }\n        const pos = new Map();\n        const radius = chars.length <= 2 ? 110 : 148;\n        chars.forEach((c, idx) => {\n          const angle = -Math.PI / 2 + (idx * 2 * Math.PI) / chars.length;\n          pos.set(c.id, { x: cx + Math.cos(angle) * radius, y: cy + Math.sin(angle) * (radius * 0.82) });\n        });\n\n        for (const rel of rels) {\n          const p1 = pos.get(rel.from), p2 = pos.get(rel.to);\n          if (!p1 || !p2) continue;\n          const highlighted = !activeCharId || rel.from === activeCharId || rel.to === activeCharId;\n          const mx = (p1.x + p2.x) / 2 + (cy - (p1.y + p2.y) / 2) * 0.14;\n          const my = (p1.y + p2.y) / 2 + ((p1.x + p2.x) / 2 - cx) * 0.14;\n          const color = REL_COLOR[rel.kind] || '#94a3b8';\n          svg.appendChild(svgEl('path', {\n            d: `M ${p1.x} ${p1.y} Q ${mx} ${my} ${p2.x} ${p2.y}`,\n            fill: 'none',\n            stroke: color,\n            'stroke-width': highlighted ? 2.2 : 1.1,\n            'stroke-opacity': highlighted ? 0.85 : 0.25,\n            'stroke-dasharray': rel.kind === 'secret' || rel.kind === 'rival' ? '6 4' : 'none',\n          }));\n          if (rel.label) {\n            svg.appendChild(svgEl('text', {\n              x: mx, y: my - 4, 'text-anchor': 'middle', fill: color, 'font-size': 10.5, opacity: highlighted ? 0.95 : 0.35,\n            }, rel.label));\n          }\n        }\n\n        for (const c of chars) {\n          const p = pos.get(c.id);\n          const color = ROLE_COLOR[c.role] || '#38bdf8';\n          const selected = c.id === activeCharId;\n          const g = svgEl('g', { style: 'cursor:pointer' });\n          if (selected) {\n            g.appendChild(svgEl('circle', { cx: p.x, cy: p.y, r: 34, fill: color, opacity: 0.18, filter: 'url(#glow)' }));\n          }\n          g.appendChild(svgEl('circle', { cx: p.x, cy: p.y, r: 24, fill: '#111621', stroke: color, 'stroke-width': selected ? 3.2 : 2 }));\n          g.appendChild(svgEl('text', { x: p.x, y: p.y + 4, 'text-anchor': 'middle', fill: '#f8fafc', 'font-size': 12.5, 'font-weight': 700 }, c.name.slice(0, 4)));\n          g.appendChild(svgEl('text', { x: p.x, y: p.y + 40, 'text-anchor': 'middle', fill: '#94a3b8', 'font-size': 10.5 }, `${ROLE_NAME[c.role]} · ${c.faction || ''}`));\n          g.addEventListener('click', () => selectChar(c.id));\n          svg.appendChild(g);\n        }\n\n        for (const sel of [$('rel-from'), $('rel-to')]) {\n          const old = sel.value;\n          sel.replaceChildren();\n          for (const c of chars) sel.add(new Option(c.name, c.id));\n          if (old && chars.some(c => c.id === old)) sel.value = old;\n        }\n        const relList = $('rel-list');\n        relList.replaceChildren();\n        for (const rel of rels) {\n          const f = chars.find(c => c.id === rel.from)?.name || rel.from;\n          const t = chars.find(c => c.id === rel.to)?.name || rel.to;\n          const btn = document.createElement('button');\n          btn.type = 'button';\n          btn.style.fontSize = '12px';\n          btn.textContent = `${f} —[${rel.label || rel.kind}]→ ${t} ×`;\n          btn.title = '点击删除这条关系';\n          btn.addEventListener('click', () => saveWorld(state.characters, state.relations.filter(r => r.id !== rel.id), state.lore));\n          relList.appendChild(btn);\n        }\n      }\n\n      function selectChar(id) {\n        activeCharId = id;\n        const c = state.characters.find(x => x.id === id);\n        $('char-form-title').textContent = c ? `编辑人物 · ${c.name}` : '新建人物档案';\n        $('c-name').value = c?.name ?? '';\n        $('c-role').value = c?.role ?? 'supporting';\n        $('c-faction').value = c?.faction ?? '';\n        $('c-traits').value = c?.traits ?? '';\n        $('c-goal').value = c?.goal ?? '';\n        $('c-secret').value = c?.secret ?? '';\n        $('btn-del-char').hidden = !c;\n        renderRelationGraph();\n      }\n\n      function renderTensionChart() {\n        const svg = $('tension-svg');\n        svg.replaceChildren();\n        const chs = state.book?.chapters || [];\n        const W = 820, H = 230, padL = 44, padR = 24, padT = 22, padB = 38;\n        const innerW = W - padL - padR, innerH = H - padT - padB;\n\n        const defs = svgEl('defs');\n        const grad = svgEl('linearGradient', { id: 'tGrad', x1: 0, y1: 0, x2: 0, y2: 1 });\n        grad.append(svgEl('stop', { offset: '0%', 'stop-color': '#f59e0b', 'stop-opacity': 0.42 }), svgEl('stop', { offset: '100%', 'stop-color': '#f59e0b', 'stop-opacity': 0.02 }));\n        defs.appendChild(grad);\n        svg.appendChild(defs);\n\n        for (let yv = 2; yv <= 10; yv += 2) {\n          const y = padT + innerH - (yv / 10) * innerH;\n          svg.appendChild(svgEl('line', { x1: padL, y1: y, x2: W - padR, y2: y, stroke: 'rgba(148,163,184,0.14)' }));\n          svg.appendChild(svgEl('text', { x: padL - 8, y: y + 4, 'text-anchor': 'end', fill: '#8b97b1', 'font-size': 11 }, String(yv)));\n        }\n        if (!chs.length) {\n          svg.appendChild(svgEl('text', { x: W / 2, y: H / 2, 'text-anchor': 'middle', fill: '#8b97b1', 'font-size': 13 }, '暂无章节数据'));\n          return;\n        }\n        const maxWords = Math.max(100, ...chs.map(c => c.word_count));\n        const stepX = chs.length === 1 ? 0 : innerW / (chs.length - 1);\n        const pts = chs.map((c, i) => ({\n          x: chs.length === 1 ? padL + innerW / 2 : padL + i * stepX,\n          y: padT + innerH - (c.tension / 10) * innerH,\n          barH: (c.word_count / maxWords) * (innerH * 0.72),\n          ch: c,\n        }));\n\n        const barW = Math.min(34, innerW / Math.max(4, chs.length * 1.8));\n        for (const p of pts) {\n          svg.appendChild(svgEl('rect', {\n            x: p.x - barW / 2, y: padT + innerH - p.barH, width: barW, height: p.barH, rx: 4, fill: 'rgba(56,189,248,0.2)',\n          }));\n        }\n        const lineD = pts.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x} ${p.y}`).join(' ');\n        const areaD = `${lineD} L ${pts.at(-1).x} ${padT + innerH} L ${pts[0].x} ${padT + innerH} Z`;\n        svg.appendChild(svgEl('path', { d: areaD, fill: 'url(#tGrad)' }));\n        svg.appendChild(svgEl('path', { d: lineD, fill: 'none', stroke: '#f59e0b', 'stroke-width': 2.6 }));\n\n        for (const p of pts) {\n          svg.appendChild(svgEl('circle', { cx: p.x, cy: p.y, r: 5, fill: '#0b0e14', stroke: '#f59e0b', 'stroke-width': 2.5 }));\n          svg.appendChild(svgEl('text', { x: p.x, y: p.y - 10, 'text-anchor': 'middle', fill: '#fbbf24', 'font-size': 11, 'font-weight': 700 }, String(p.ch.tension)));\n          svg.appendChild(svgEl('text', { x: p.x, y: H - 14, 'text-anchor': 'middle', fill: '#8b97b1', 'font-size': 11 }, `第${p.ch.order}章`));\n        }\n      }\n\n      function renderThreads() {\n        const box = $('thread-grid');\n        box.replaceChildren();\n        const maxCh = state.book?.chapters.length || 1;\n        if (!state.threads.length) {\n          const p = document.createElement('p');\n          p.style.color = 'var(--fg-muted)';\n          p.textContent = '尚无伏笔记录。';\n          box.appendChild(p);\n          return;\n        }\n        for (const t of state.threads) {\n          const overdue = (t.status === 'planted' || t.status === 'hinted') && (maxCh - t.planted_ch >= 4);\n          const card = document.createElement('article');\n          card.className = `thread-card${overdue ? ' warn' : ''}`;\n          const top = document.createElement('div');\n          top.className = 'between';\n          const title = document.createElement('strong');\n          title.textContent = t.title;\n          const badge = document.createElement('span');\n          badge.className = 'badge';\n          badge.textContent = TH_NAME[t.status];\n          top.append(title, badge);\n          const info = document.createElement('div');\n          info.style.cssText = 'font-size:12px;color:var(--fg-muted)';\n          info.textContent = `埋设：第${t.planted_ch}章 · 重要度：${t.priority}${overdue ? ' · ⚠️ 长期未回收' : ''}`;\n          const desc = document.createElement('p');\n          desc.style.cssText = 'margin:0;font-size:12.5px';\n          desc.textContent = t.detail;\n          const actions = document.createElement('div');\n          actions.className = 'row';\n          const step = document.createElement('button');\n          step.type = 'button';\n          step.textContent = `切换为「${TH_NAME[TH_NEXT[t.status]]}」`;\n          step.addEventListener('click', () => savePlot(state.threads.map(x => x.id === t.id ? { ...x, status: TH_NEXT[x.status] } : x)));\n          const del = document.createElement('button');\n          del.type = 'button';\n          del.className = 'danger';\n          del.textContent = '删除';\n          del.addEventListener('click', () => savePlot(state.threads.filter(x => x.id !== t.id)));\n          actions.append(step, del);\n          card.append(top, info, desc, actions);\n          box.appendChild(card);\n        }\n      }\n\n      function renderLore() {\n        const box = $('lore-grid');\n        box.replaceChildren();\n        if (!state.lore.length) {\n          const p = document.createElement('p');\n          p.style.color = 'var(--fg-muted)';\n          p.textContent = '暂无世界观词条。';\n          box.appendChild(p);\n          return;\n        }\n        for (const item of state.lore) {\n          const card = document.createElement('article');\n          card.className = 'thread-card';\n          const top = document.createElement('div');\n          top.className = 'between';\n          const strong = document.createElement('strong');\n          strong.textContent = item.title;\n          const tag = document.createElement('span');\n          tag.className = 'badge';\n          tag.textContent = LORE_CAT[item.category] || item.category;\n          top.append(strong, tag);\n          const p = document.createElement('p');\n          p.style.cssText = 'margin:0;font-size:12.5px;color:var(--fg-muted)';\n          p.textContent = item.detail;\n          const del = document.createElement('button');\n          del.type = 'button';\n          del.className = 'danger';\n          del.style.alignSelf = 'flex-start';\n          del.textContent = '删除';\n          del.addEventListener('click', () => saveWorld(state.characters, state.relations, state.lore.filter(l => l.id !== item.id)));\n          card.append(top, p, del);\n          box.appendChild(card);\n        }\n      }\n\n      async function saveWorld(characters, relations, lore) {\n        if (busy) return;\n        busy = true;\n        try {\n          const res = await plugin.action('novel.world.save', { expected_revision: state.revision, characters, relations, lore });\n          if (res.status === 'saved') { await load(activeChId); setStatus('人物与世界观已同步保存。', 'ok'); }\n          else setStatus(`保存未完成：${res.status}`, 'error');\n        } catch (e) { setStatus(`保存失败：${e?.message}`, 'error'); }\n        finally { busy = false; }\n      }\n\n      async function savePlot(threads) {\n        if (busy) return;\n        busy = true;\n        try {\n          const res = await plugin.action('novel.plot.save', { expected_revision: state.revision, threads });\n          if (res.status === 'saved') { await load(activeChId); setStatus('伏笔板已更新。', 'ok'); }\n          else setStatus(`保存未完成：${res.status}`, 'error');\n        } catch (e) { setStatus(`保存失败：${e?.message}`, 'error'); }\n        finally { busy = false; }\n      }\n\n      async function load(preferChId) {\n        if (typeof plugin?.action !== 'function') { setStatus('请在 Velai Desktop 中打开 AI 长篇小说开发系统。', 'error'); return; }\n        try {\n          state = await plugin.action('novel.bootstrap', {});\n          renderSummary();\n          renderChapterTree();\n          renderThreads();\n          renderLore();\n          renderRelationGraph();\n          renderTensionChart();\n          const targetCh = preferChId && state.book.chapters.some(c => c.id === preferChId) ? preferChId : (state.book.chapters[0]?.id ?? null);\n          await openChapter(targetCh);\n          if (state.characters.length && !activeCharId) selectChar(state.characters[0].id);\n          setStatus(`工作台已就绪 · 《${state.book.title}》共 ${state.book.chapters.length} 章（已存储分章键 ${state.stored_chapter_keys.length}）`);\n        } catch (e) { setStatus(`初始化失败：${e?.message || '未知错误'}`, 'error'); }\n      }\n\n      document.querySelectorAll('.nav button').forEach(btn => btn.addEventListener('click', () => switchView(btn.dataset.view)));\n      $('btn-theme').addEventListener('click', () => {\n        const cur = document.documentElement.dataset.theme;\n        document.documentElement.dataset.theme = cur === 'dark' ? 'light' : 'dark';\n      });\n      $('ch-tension').addEventListener('input', () => { $('tension-val').textContent = $('ch-tension').value; });\n      $('ch-body').addEventListener('input', () => { $('live-words').textContent = `${countWords($('ch-body').value)} 字`; });\n      $('btn-new-ch').addEventListener('click', () => { switchView('write'); openChapter(null); $('ch-title').focus(); });\n      $('btn-refresh').addEventListener('click', () => load(activeChId));\n\n      $('btn-demo').addEventListener('click', async () => {\n        if (busy) return;\n        busy = true;\n        setStatus('正在装配演示长篇《星渊回响》…');\n        try {\n          const res = await plugin.action('novel.seed_demo', { expected_revision: state.revision });\n          if (res.status === 'seeded') { await load('ch-01'); setStatus('已加载演示长篇《星渊回响》（5章 + 5人物 + 6关系 + 4伏笔）。', 'ok'); }\n          else setStatus(`加载冲突：${res.status}`, 'error');\n        } catch (e) { setStatus(`加载失败：${e?.message}`, 'error'); }\n        finally { busy = false; }\n      });\n\n      $('btn-save-ch').addEventListener('click', async () => {\n        if (busy) return;\n        const title = $('ch-title').value.trim();\n        if (!title) { setStatus('请填写章节标题。', 'error'); return; }\n        busy = true;\n        try {\n          const id = activeChId || `ch-${Date.now().toString(36)}`;\n          const res = await plugin.action('novel.chapter.save', {\n            expected_revision: state.revision,\n            id,\n            volume: $('ch-vol').value.trim() || '第一卷',\n            title,\n            status: $('ch-status').value,\n            tension: Number($('ch-tension').value),\n            pov: $('ch-pov').value.trim(),\n            summary: $('ch-summary').value.trim(),\n            beats: $('ch-beats').value,\n            notes: $('ch-notes').value,\n            body: $('ch-body').value,\n          });\n          if (res.status === 'saved') { await load(id); setStatus(`已保存《${title}》（${res.word_count} 字）`, 'ok'); }\n          else setStatus(`保存未完成：${res.status}`, 'error');\n        } catch (e) { setStatus(`保存失败：${e?.message}`, 'error'); }\n        finally { busy = false; }\n      });\n\n      $('btn-del-ch').addEventListener('click', async () => {\n        if (busy || !activeChId) return;\n        busy = true;\n        try {\n          const res = await plugin.action('novel.chapter.delete', { expected_revision: state.revision, id: activeChId });\n          if (res.status === 'deleted') { await load(); setStatus('章节及分章正文记录已删除。', 'ok'); }\n          else setStatus(`删除未完成：${res.status}`, 'error');\n        } catch (e) { setStatus(`删除失败：${e?.message}`, 'error'); }\n        finally { busy = false; }\n      });\n\n      // FS Sync actions\n      $('btn-fs-list').addEventListener('click', () => void browseFs($('fs-dir').value));\n      $('btn-fs-up').addEventListener('click', () => {\n        const parts = currentDir.split('/').filter(Boolean);\n        parts.pop();\n        void browseFs(parts.join('/'));\n      });\n      $('btn-fs-stat').addEventListener('click', () => void inspectFsStat());\n      $('btn-fs-import').addEventListener('click', () => void importFsChapter());\n      $('btn-fs-export-new').addEventListener('click', () => void exportFsChapter('create'));\n      $('btn-fs-export-cas').addEventListener('click', () => void exportFsChapter('cas'));\n\n      $('btn-new-char').addEventListener('click', () => { selectChar(null); $('c-name').focus(); });\n      $('btn-save-char').addEventListener('click', () => {\n        const name = $('c-name').value.trim();\n        if (!name) { setStatus('请填写人物姓名。', 'error'); return; }\n        const id = activeCharId || `c-${Date.now().toString(36)}`;\n        const rec = {\n          id, name, role: $('c-role').value, faction: $('c-faction').value.trim(),\n          traits: $('c-traits').value.trim(), goal: $('c-goal').value.trim(), secret: $('c-secret').value.trim(),\n        };\n        const exists = state.characters.some(c => c.id === id);\n        const next = exists ? state.characters.map(c => c.id === id ? rec : c) : [...state.characters, rec];\n        activeCharId = id;\n        void saveWorld(next, state.relations, state.lore);\n      });\n      $('btn-del-char').addEventListener('click', () => {\n        if (!activeCharId) return;\n        const id = activeCharId;\n        activeCharId = null;\n        void saveWorld(state.characters.filter(c => c.id !== id), state.relations.filter(r => r.from !== id && r.to !== id), state.lore);\n      });\n      $('btn-add-rel').addEventListener('click', () => {\n        const from = $('rel-from').value, to = $('rel-to').value;\n        if (!from || !to || from === to) { setStatus('请选择两个不同的人物建立关系。', 'error'); return; }\n        const rec = { id: `r-${Date.now().toString(36)}`, from, to, kind: $('rel-kind').value, label: $('rel-label').value.trim() };\n        $('rel-label').value = '';\n        void saveWorld(state.characters, [...state.relations, rec], state.lore);\n      });\n      $('btn-add-thread').addEventListener('click', () => {\n        const title = $('th-title').value.trim();\n        if (!title) return;\n        const rec = {\n          id: `th-${Date.now().toString(36)}`, title, planted_ch: Math.max(1, Number($('th-planted').value) || 1),\n          payoff_ch: 0, status: 'planted', priority: $('th-priority').value, detail: $('th-detail').value.trim(),\n        };\n        $('th-title').value = ''; $('th-detail').value = '';\n        void savePlot([...state.threads, rec]);\n      });\n      $('btn-save-book').addEventListener('click', async () => {\n        if (busy) return;\n        busy = true;\n        try {\n          const res = await plugin.action('novel.book.save', {\n            expected_revision: state.revision,\n            title: $('b-title').value.trim() || '未命名长篇',\n            genre: $('b-genre').value.trim(),\n            logline: $('b-logline').value.trim(),\n            target_words: Math.max(1000, Number($('b-target').value) || 100000),\n          });\n          if (res.status === 'saved') { await load(activeChId); setStatus('书目信息已保存。', 'ok'); }\n          else setStatus(`保存未完成：${res.status}`, 'error');\n        } catch (e) { setStatus(`保存失败：${e?.message}`, 'error'); }\n        finally { busy = false; }\n      });\n      $('btn-add-lore').addEventListener('click', () => {\n        const title = $('lore-title').value.trim();\n        if (!title) return;\n        const rec = { id: `l-${Date.now().toString(36)}`, category: $('lore-cat').value, title, detail: $('lore-detail').value.trim() };\n        $('lore-title').value = ''; $('lore-detail').value = '';\n        void saveWorld(state.characters, state.relations, [...state.lore, rec]);\n      });\n\n      void load();\n    })();\n  \n/* === V2 Host Theme & Compact Surface JS Start === */\n(() => {\n  const root = document.documentElement;\n  const BTN_MODE = \"emoji\";\n  const HAS_SIDEBAR = true;\n  const MAIN_SEL = \".main\";\n  const INIT_MQ = false;\n  const VALID_THEMES = new Set(['light', 'dark']);\n  const VALID_SURFACES = new Set(['workspace', 'chat', 'assistant']);\n\n  const normalizeTheme = val => (val === 'light' || val === 'dark' ? val : null);\n\n  if (INIT_MQ && !normalizeTheme(root.getAttribute('data-theme'))) {\n    try {\n      const dark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;\n      root.setAttribute('data-theme', dark ? 'dark' : 'light');\n    } catch {}\n  }\n\n  let hostTheme = normalizeTheme(root.getAttribute('data-theme'));\n\n  function syncThemeButton(theme) {\n    const btn = document.getElementById('btn-theme');\n    if (!btn || !VALID_THEMES.has(theme)) return;\n    btn.setAttribute('aria-pressed', String(theme === 'dark'));\n    btn.dataset.activeTheme = theme;\n    btn.title = theme === 'dark' ? '当前深色主题，点击切换浅色' : '当前浅色主题，点击切换深色';\n    if (BTN_MODE === 'short') {\n      btn.textContent = theme === 'light' ? '☾ 深色' : '☀ 浅色';\n    } else if (BTN_MODE === 'emoji') {\n      const txt = (btn.textContent || '').trim();\n      const rest = txt.replace(/^(?:☀️|☀|🌙|☾|◐)\\s*/, '');\n      btn.textContent = (theme === 'light' ? '🌙 ' : '☀️ ') + (rest || '外观');\n    } else {\n      btn.textContent = theme === 'dark' ? '☀ 切换浅色' : '☾ 切换深色';\n    }\n  }\n\n  function applyHostTheme(raw) {\n    const data = raw && typeof raw === 'object'\n      ? (raw.theme || raw.surface || raw.tokens ? raw : (raw.payload && typeof raw.payload === 'object' ? raw.payload : raw))\n      : null;\n    if (!data || typeof data !== 'object') return;\n    const nextTheme = normalizeTheme(data.theme);\n    if (nextTheme) {\n      hostTheme = nextTheme;\n      root.removeAttribute('data-theme-override');\n      root.setAttribute('data-theme', nextTheme);\n      syncThemeButton(nextTheme);\n    }\n    if (typeof data.surface === 'string' && VALID_SURFACES.has(data.surface)) {\n      root.setAttribute('data-surface', data.surface);\n    }\n    if (data.tokens && typeof data.tokens === 'object') {\n      for (const [k, v] of Object.entries(data.tokens)) {\n        if (typeof v === 'string' && k) {\n          try { root.style.setProperty(k.startsWith('--') ? k : '--' + k, v); } catch {}\n        }\n      }\n    }\n  }\n\n  const initialTheme = normalizeTheme(root.getAttribute('data-theme'));\n  if (initialTheme) syncThemeButton(initialTheme);\n\n  const themeBtn = document.getElementById('btn-theme');\n  if (themeBtn) {\n    themeBtn.addEventListener('click', () => {\n      const cur = normalizeTheme(root.getAttribute('data-theme'));\n      if (!cur) return;\n      if (hostTheme && cur !== hostTheme) root.setAttribute('data-theme-override', '1');\n      else root.removeAttribute('data-theme-override');\n      syncThemeButton(cur);\n    });\n  }\n\n  try {\n    window.addEventListener('host.theme.changed', ev => {\n      try { applyHostTheme(ev && typeof ev === 'object' && 'detail' in ev ? ev.detail : ev); } catch {}\n    });\n  } catch {}\n  try {\n    const sub = globalThis.nmasPlugin?.subscribe?.('host.theme.changed', payload => {\n      try { applyHostTheme(payload); } catch {}\n    });\n    if (sub && typeof sub.catch === 'function') sub.catch(() => {});\n  } catch {}\n\n  if (HAS_SIDEBAR) {\n    const sidebar = document.querySelector('.sidebar');\n    const hostMain = document.querySelector(MAIN_SEL) || document.querySelector('.main, .main-area, .main-col, .workspace');\n    const srcBtns = sidebar ? Array.from(sidebar.querySelectorAll('button[data-view]')) : [];\n    if (sidebar && hostMain && srcBtns.length > 0 && !hostMain.querySelector('.v2-surface-nav')) {\n      const nav = document.createElement('nav');\n      nav.className = 'v2-surface-nav';\n      nav.setAttribute('aria-label', '视图切换');\n      const pairs = srcBtns.map(src => {\n        const clone = src.cloneNode(true);\n        clone.querySelectorAll('svg, .nav-badge, .pill, .mono').forEach(el => el.remove());\n        const navLeft = clone.querySelector('.nav-left');\n        let label = '';\n        if (navLeft) {\n          label = Array.from(navLeft.children).map(el => (el.textContent || '').trim()).filter(Boolean).join(' ');\n        } else {\n          label = (clone.textContent || '').replace(/\\s+/g, ' ').trim();\n        }\n        const tab = document.createElement('button');\n        tab.type = 'button';\n        tab.className = 'v2-surface-tab';\n        tab.dataset.surfaceView = src.dataset.view || '';\n        tab.textContent = label || src.dataset.view || '视图';\n        tab.addEventListener('click', () => { try { src.click(); } catch {} });\n        nav.appendChild(tab);\n        return [src, tab];\n      });\n      const syncNav = () => {\n        for (const [src, tab] of pairs) {\n          const active = src.classList.contains('active');\n          tab.classList.toggle('active', active);\n          if (active) tab.setAttribute('aria-current', 'page');\n          else tab.removeAttribute('aria-current');\n        }\n      };\n      syncNav();\n      hostMain.prepend(nav);\n      try {\n        const obs = new MutationObserver(syncNav);\n        obs.observe(sidebar, { subtree: true, attributes: true, attributeFilter: ['class'] });\n      } catch {}\n    }\n  }\n})();\n/* === V2 Host Theme & Compact Surface JS End === */\n</script>\n</body>\n</html>\n","path":"ui/index.html"}],"format":"nmas-plugin","manifest":{"actions":[{"id":"novel.bootstrap","input_schema":{"additionalProperties":false,"properties":{},"required":[],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"book":{"additionalProperties":false,"properties":{"chapters":{"items":{"additionalProperties":false,"properties":{"fs_path":{"maxLength":512,"type":["string","null"]},"fs_sha256":{"maxLength":64,"type":["string","null"]},"id":{"maxLength":48,"minLength":1,"type":"string"},"order":{"maximum":9999,"minimum":1,"type":"integer"},"pov":{"maxLength":40,"type":"string"},"status":{"enum":["draft","revising","done"],"type":"string"},"summary":{"maxLength":240,"type":"string"},"tension":{"maximum":10,"minimum":1,"type":"integer"},"title":{"maxLength":100,"minLength":1,"type":"string"},"volume":{"maxLength":60,"type":"string"},"word_count":{"maximum":200000,"minimum":0,"type":"integer"}},"required":["id","volume","order","title","status","tension","pov","word_count","summary"],"type":"object"},"type":"array"},"genre":{"maxLength":40,"type":"string"},"logline":{"maxLength":400,"type":"string"},"target_words":{"maximum":10000000,"minimum":1000,"type":"integer"},"title":{"maxLength":100,"type":"string"},"total_words":{"maximum":10000000,"minimum":0,"type":"integer"}},"required":["title","genre","logline","target_words","total_words","chapters"],"type":"object"},"characters":{"items":{"additionalProperties":false,"properties":{"faction":{"maxLength":40,"type":"string"},"goal":{"maxLength":200,"type":"string"},"id":{"maxLength":48,"minLength":1,"type":"string"},"name":{"maxLength":40,"minLength":1,"type":"string"},"role":{"enum":["protagonist","antagonist","supporting","mentor"],"type":"string"},"secret":{"maxLength":200,"type":"string"},"traits":{"maxLength":120,"type":"string"}},"required":["id","name","role","faction","traits","goal","secret"],"type":"object"},"type":"array"},"lore":{"items":{"additionalProperties":false,"properties":{"category":{"enum":["location","faction","magic_tech","artifact","history"],"type":"string"},"detail":{"maxLength":400,"type":"string"},"id":{"maxLength":48,"minLength":1,"type":"string"},"title":{"maxLength":64,"minLength":1,"type":"string"}},"required":["id","category","title","detail"],"type":"object"},"type":"array"},"relations":{"items":{"additionalProperties":false,"properties":{"from":{"maxLength":48,"minLength":1,"type":"string"},"id":{"maxLength":48,"minLength":1,"type":"string"},"kind":{"enum":["ally","rival","mentor","romance","secret"],"type":"string"},"label":{"maxLength":40,"type":"string"},"to":{"maxLength":48,"minLength":1,"type":"string"}},"required":["id","from","to","kind","label"],"type":"object"},"type":"array"},"revision":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"stored_chapter_keys":{"items":{"maxLength":64,"type":"string"},"type":"array"},"threads":{"items":{"additionalProperties":false,"properties":{"detail":{"maxLength":240,"type":"string"},"id":{"maxLength":48,"minLength":1,"type":"string"},"payoff_ch":{"maximum":9999,"minimum":0,"type":"integer"},"planted_ch":{"maximum":9999,"minimum":1,"type":"integer"},"priority":{"enum":["critical","major","minor"],"type":"string"},"status":{"enum":["planted","hinted","payoff","abandoned"],"type":"string"},"title":{"maxLength":80,"minLength":1,"type":"string"}},"required":["id","title","planted_ch","payoff_ch","status","priority","detail"],"type":"object"},"type":"array"}},"required":["revision","book","characters","relations","lore","threads","stored_chapter_keys"],"type":"object"},"permissions":["data.read"],"title":"读取小说工作台总览"},{"id":"novel.book.save","input_schema":{"additionalProperties":false,"properties":{"expected_revision":{"maximum":9007199254740990,"minimum":0,"type":"integer"},"genre":{"maxLength":40,"type":"string"},"logline":{"maxLength":400,"type":"string"},"target_words":{"maximum":10000000,"minimum":1000,"type":"integer"},"title":{"maxLength":100,"minLength":1,"type":"string"}},"required":["expected_revision","title","genre","logline","target_words"],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"revision":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"status":{"enum":["saved