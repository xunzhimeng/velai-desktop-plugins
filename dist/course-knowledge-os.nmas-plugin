{"files":[{"content":"const COL_DECKS = 'decks';\nconst COL_CARDS = 'cards';\nconst COL_LOG = 'review_log';\nconst KEY_INDEX = 'index';\nconst DOC_FORMAT = 'velai-course-knowledge-os';\n\nconst MAX_RECORD_BYTES = 240 * 1024;\nconst MAX_DECKS = 64;\nconst MAX_CARDS = 400;\nconst MAX_LOG_ITEMS = 500;\nconst ID_RE = /^[a-zA-Z0-9._-]+$/;\nconst DATE_RE = /^\\d{4}-\\d{2}-\\d{2}$/;\nconst COLOR_RE = /^#[0-9a-fA-F]{3,8}$/;\nconst KINDS = ['concept', 'qa', 'code'];\n\nfunction jsonBytes(v) {\n  let b = 0;\n  for (const ch of JSON.stringify(v)) {\n    const cp = ch.codePointAt(0);\n    b += cp <= 0x7f ? 1 : cp <= 0x7ff ? 2 : cp <= 0xffff ? 3 : 4;\n  }\n  return b;\n}\n\nfunction utcToday() {\n  return new Date().toISOString().slice(0, 10);\n}\n\nfunction resolveToday(inputToday) {\n  return typeof inputToday === 'string' && DATE_RE.test(inputToday) ? inputToday : utcToday();\n}\n\nfunction addDays(ymd, delta) {\n  const [y, m, d] = ymd.split('-').map(Number);\n  const dt = new Date(Date.UTC(y, m - 1, d + delta));\n  return dt.toISOString().slice(0, 10);\n}\n\nfunction round2(n) {\n  return Math.round(n * 100) / 100;\n}\n\nfunction clamp(v, lo, hi) {\n  return Math.max(lo, Math.min(hi, v));\n}\n\nfunction normalizeTags(tags) {\n  if (!Array.isArray(tags)) return [];\n  const out = [];\n  const seen = new Set();\n  for (const raw of tags) {\n    if (typeof raw !== 'string') continue;\n    const t = raw.trim().slice(0, 24);\n    if (!t || seen.has(t)) continue;\n    seen.add(t);\n    out.push(t);\n    if (out.length >= 6) break;\n  }\n  return out;\n}\n\nfunction normalizeLinks(links, selfId, validCardIds) {\n  if (!Array.isArray(links)) return [];\n  const out = [];\n  const seen = new Set();\n  for (const raw of links) {\n    if (typeof raw !== 'string') continue;\n    const id = raw.trim();\n    if (!id || id === selfId || !ID_RE.test(id) || seen.has(id)) continue;\n    if (validCardIds && !validCardIds.has(id)) continue;\n    seen.add(id);\n    out.push(id);\n    if (out.length >= 8) break;\n  }\n  return out;\n}\n\n/**\n * SuperMemo SM-2 algorithm (4-grade scale: 1=Again, 2=Hard, 3=Good, 4=Easy)\n */\nfunction computeSm2(card, rating, today) {\n  const ef0 = typeof card.ease_factor === 'number' ? card.ease_factor : 2.5;\n  const rep0 = Number.isInteger(card.repetitions) ? card.repetitions : 0;\n  const int0 = Number.isInteger(card.interval_days) ? card.interval_days : 0;\n  const lapses0 = Number.isInteger(card.lapses) ? card.lapses : 0;\n\n  let ease_factor = ef0;\n  let repetitions = rep0;\n  let interval_days = int0;\n  let lapses = lapses0;\n\n  if (rating === 1) {\n    // Again: lapse, keep due today for immediate relearning\n    ease_factor = clamp(round2(ef0 - 0.2), 1.3, 3.5);\n    repetitions = 0;\n    interval_days = 0;\n    lapses = Math.min(999, lapses0 + 1);\n  } else {\n    const q = rating === 2 ? 3 : rating === 3 ? 4 : 5;\n    const deltaEf = 0.1 - (5 - q) * (0.08 + (5 - q) * 0.02);\n    ease_factor = clamp(round2(ef0 + deltaEf), 1.3, 3.5);\n\n    if (rating === 2) {\n      if (rep0 === 0) interval_days = 1;\n      else if (rep0 === 1) interval_days = 4;\n      else interval_days = Math.max(int0 + 1, Math.round(int0 * 1.2));\n    } else if (rating === 3) {\n      if (rep0 === 0) interval_days = 1;\n      else if (rep0 === 1) interval_days = 6;\n      else interval_days = Math.max(int0 + 1, Math.round(int0 * ease_factor));\n    } else {\n      if (rep0 === 0) interval_days = 4;\n      else if (rep0 === 1) interval_days = 10;\n      else interval_days = Math.max(int0 + 2, Math.round(int0 * ease_factor * 1.3));\n    }\n    interval_days = clamp(interval_days, 1, 3650);\n    repetitions = Math.min(999, rep0 + 1);\n  }\n\n  return {\n    ease_factor,\n    interval_days,\n    repetitions,\n    lapses,\n    due_date: addDays(today, interval_days),\n    last_reviewed: today,\n  };\n}\n\nfunction cardMasteryScore(card) {\n  if (card.repetitions === 0 && !card.last_reviewed) return 0;\n  if (card.interval_days >= 21) return clamp(Math.round(85 + (card.ease_factor - 1.3) * 7), 85, 100);\n  if (card.interval_days >= 6) return clamp(Math.round(55 + (card.interval_days - 6) * 2), 55, 84);\n  if (card.interval_days >= 1) return clamp(Math.round(25 + card.interval_days * 5), 25, 54);\n  return 15;\n}\n\nfunction computeStats(cards, reviewLog, today) {\n  let due_count = 0;\n  let total_links = 0;\n  let scoreSum = 0;\n  let new_count = 0;\n  let learning = 0;\n  let reviewing = 0;\n  let mastered = 0;\n\n  for (const c of cards) {\n    if (c.due_date <= today) due_count += 1;\n    total_links += c.links.length;\n    scoreSum += cardMasteryScore(c);\n    if (c.repetitions === 0 && !c.last_reviewed) new_count += 1;\n    else if (c.interval_days < 6) learning += 1;\n    else if (c.interval_days < 21) reviewing += 1;\n    else mastered += 1;\n  }\n\n  const reviewedDates = new Set();\n  let reviewed_today = 0;\n  for (const entry of reviewLog) {\n    reviewedDates.add(entry.date);\n    if (entry.date === today) reviewed_today += 1;\n  }\n\n  let streak_days = 0;\n  let cursor = reviewedDates.has(today) ? today : addDays(today, -1);\n  while (reviewedDates.has(cursor) && streak_days < 365) {\n    streak_days += 1;\n    cursor = addDays(cursor, -1);\n  }\n\n  const mastery_rate = cards.length === 0 ? 0 : round2(scoreSum / cards.length);\n\n  return {\n    total_cards: cards.length,\n    due_count,\n    total_links,\n    mastery_rate,\n    streak_days,\n    reviewed_today,\n    tiers: { new_count, learning, reviewing, mastered },\n  };\n}\n\nasync function readCollection(collection, fieldName) {\n  const receipt = await globalThis.nmas.data.read({ collection, key: KEY_INDEX });\n  const doc = receipt.value === null ? { schema_version: 1, [fieldName]: [] } : receipt.value;\n  if (!doc || doc.schema_version !== 1 || !Array.isArray(doc[fieldName])) {\n    throw new Error(`集合 ${collection} 数据格式无效`);\n  }\n  return { revision: receipt.revision, items: doc[fieldName] };\n}\n\nasync function readAll() {\n  const d = await readCollection(COL_DECKS, 'decks');\n  const c = await readCollection(COL_CARDS, 'cards');\n  const l = await readCollection(COL_LOG, 'logs');\n  return { revision: l.revision, decks: d.items, cards: c.items, review_log: l.items };\n}\n\nasync function writeCollection(collection, fieldName, expectedRevision, items) {\n  if (items.length === 0) {\n    try {\n      const receipt = await globalThis.nmas.data.delete({\n        collection,\n        key: KEY_INDEX,\n        expected_revision: expectedRevision,\n      });\n      return { status: 'saved', revision: receipt.revision };\n    } catch (err) {\n      if (err?.code === 'conflict' && err.outcome_unknown === false) {\n        return { status: 'conflict', revision: expectedRevision };\n      }\n      throw err;\n    }\n  }\n  const value = { schema_version: 1, [fieldName]: items };\n  if (jsonBytes(value) > MAX_RECORD_BYTES) {\n    return { status: 'limit', revision: expectedRevision };\n  }\n  try {\n    const receipt = await globalThis.nmas.data.write({\n      collection,\n      key: KEY_INDEX,\n      expected_revision: expectedRevision,\n      value,\n    });\n    return { status: 'saved', revision: receipt.revision };\n  } catch (err) {\n    if (err?.code === 'conflict' && err.outcome_unknown === false) {\n      return { status: 'conflict', revision: expectedRevision };\n    }\n    throw err;\n  }\n}\n\nasync function readPluginSettings() {\n  const raw = await globalThis.nmas.settings.get();\n  const goal = Number.isInteger(raw?.daily_review_goal) ? clamp(raw.daily_review_goal, 1, 500) : 20;\n  const kind = KINDS.includes(raw?.default_card_kind) ? raw.default_card_kind : 'concept';\n  return { daily_review_goal: goal, default_card_kind: kind };\n}\n\nfunction buildDemoData(today) {\n  const decks = [\n    {\n      id: 'llm-inference',\n      name: '大模型推理系统',\n      color: '#6366f1',\n      description: 'Attention、KV-Cache、PagedAttention 与投机解码等核心推理优化技术',\n    },\n    {\n      id: 'dist-consensus',\n      name: '分布式共识与存储',\n      color: '#10b981',\n      description: 'Raft 共识协议、LSM-Tree 存储引擎与分布式一致性工程实践',\n    },\n    {\n      id: 'gpu-parallel',\n      name: 'GPU 并行与调度',\n      color: '#f59e0b',\n      description: 'FlashAttention IO 感知算子、张量/流水线并行与 NCCL 集合通信',\n    },\n  ];\n\n  const cards = [\n    {\n      id: 'kv-cache',\n      deck_id: 'llm-inference',\n      kind: 'concept',\n      front: '为什么自回归 LLM 推理必须使用 KV-Cache？其显存占用公式是什么？',\n      back: '自回归解码每步仅新增 1 个 token，缓存历史层的 K/V 投影避免 O(N^2) 重复计算，将单步复杂度降为 O(N)。\\n显存估算：2 * n_layers * n_kv_heads * d_head * seq_len * batch * dtype_bytes。\\n使用 GQA/MQA 可成倍压缩 KV-Cache 带宽压力。',\n      tags: ['KV-Cache', 'Attention', '推理'],\n      links: ['paged-attn', 'flash-attn'],\n      ease_factor: 2.5,\n      interval_days: 0,\n      repetitions: 0,\n      due_date: today,\n      last_reviewed: '',\n      lapses: 0,\n    },\n    {\n      id: 'paged-attn',\n      deck_id: 'llm-inference',\n      kind: 'qa',\n      front: 'PagedAttention 如何解决传统连续显存 KV-Cache 的碎片浪费问题？',\n      back: '借鉴操作系统虚拟内存分页机制：将每个请求的 KV-Cache 切分为固定大小的 Block（如 16 tokens），通过 Block Table 映射逻辑块与非连续物理显存块。内部碎片仅存在于最后一块，并支持 Beam Search 与共享系统前缀的写时复制 (CoW)。',\n      tags: ['vLLM', '内存管理'],\n      links: ['kv-cache', 'spec-decode'],\n      ease_factor: 2.36,\n      interval_days: 2,\n      repetitions: 1,\n      due_date: today,\n      last_reviewed: addDays(today, -2),\n      lapses: 0,\n    },\n    {\n      id: 'spec-decode',\n      deck_id: 'llm-inference',\n      kind: 'qa',\n      front: '投机解码 (Speculative Decoding) 如何在不损失输出分布的前提下加速解码？',\n      back: '用轻量 Draft 模型连续猜测 K 个 token，再用目标大模型一次前向并行验证全部 K+1 个位置。通过改进拒绝采样：若 p(x)>=q(x) 接受，否则以 p(x)/q(x) 接受并从 max(0, p-q) 重采样，数学上严格等价于目标模型原分布。',\n      tags: ['解码加速', '采样'],\n      links: ['kv-cache', 'paged-attn'],\n      ease_factor: 2.5,\n      interval_days: 6,\n      repetitions: 2,\n      due_date: addDays(today, 3),\n      last_reviewed: addDays(today, -3),\n      lapses: 0,\n    },\n    {\n      id: 'flash-attn',\n      deck_id: 'gpu-parallel',\n      kind: 'code',\n      front: 'FlashAttention 如何借助 Online Softmax 实现 O(N) 显存复杂度？',\n      back: '按块将 Q/K/V 从 HBM 载入片上 SRAM，分块累加不落盘 N*N 注意力矩阵：\\nm_new = max(m_old, rowmax(S_ij))\\nP_ij = exp(S_ij - m_new)\\nl_new = exp(m_old - m_new)*l_old + rowsum(P_ij)\\nO_new = diag(l_new)^-1 * (exp(m_old - m_new)*l_old*O_old + P_ij @ V_j)',\n      tags: ['CUDA', 'SRAM', '算子优化'],\n      links: ['kv-cache', 'tp-pp'],\n      ease_factor: 2.6,\n      interval_days: 12,\n      repetitions: 3,\n      due_date: today,\n      last_reviewed: addDays(today, -12),\n      lapses: 0,\n    },\n    {\n      id: 'tp-pp',\n      deck_id: 'gpu-parallel',\n      kind: 'concept',\n      front: '张量并行 (TP) 与流水线并行 (PP) 在通信模式与适用边界上有何差异？',\n      back: 'TP 将单层权重按行/列切分到多卡，每层需 2 次 AllReduce，通信频次高且延迟敏感，适合单机 NVLink 互联；PP 按层切分阶段，仅在 Stage 边界点对点传递激活值，带宽需求低但存在 Bubble 空泡（可用 1F1B 调度压缩），适合跨机扩展。',\n      tags: ['Megatron', '3D并行'],\n      links: ['nccl-ring', 'flash-attn'],\n      ease_factor: 2.7,\n      interval_days: 24,\n      repetitions: 4,\n      due_date: addDays(today, 10),\n      last_reviewed: addDays(today, -14),\n      lapses: 0,\n    },\n    {\n      id: 'nccl-ring',\n      deck_id: 'gpu-parallel',\n      kind: 'qa',\n      front: 'Ring AllReduce 如何做到通信量与节点数 N 近乎无关？',\n      back: '将张量切为 N 份，分为 Reduce-Scatter 和 AllGather 两阶段，每阶段沿环传递 N-1 步。单卡总发送/接收量均为 2*(N-1)/N * M，当 N 增大时收敛于 2M，充分打满每张卡的环形双向链路带宽。',\n      tags: ['NCCL', '集合通信'],\n      links: ['tp-pp'],\n      ease_factor: 2.5,\n      interval_days: 8,\n      repetitions: 2,\n      due_date: addDays(today, 4),\n      last_reviewed: addDays(today, -4),\n      lapses: 0,\n    },\n    {\n      id: 'raft-safety',\n      deck_id: 'dist-consensus',\n      kind: 'qa',\n      front: 'Raft 为什么禁止 Leader 直接通过统计多数派来提交前任 Term 的旧日志？',\n      back: 'Figure 8 经典隐患：旧任期日志即便已被复制到多数节点，仍可能被持有更高任期的新 Leader 覆盖。Raft 规定 Leader 只能通过提交当前任期的新日志，再借 Log Matching 性质间接提交之前的旧日志，确保已提交日志永不丢失。',\n      tags: ['Raft', '共识', '一致性'],\n      links: ['lsm-tree'],\n      ease_factor: 2.4,\n      interval_days: 1,\n      repetitions: 1,\n      due_date: today,\n      last_reviewed: addDays(today, -1),\n      lapses: 1,\n    },\n    {\n      id: 'lsm-tree',\n      deck_id: 'dist-consensus',\n      kind: 'concept',\n      front: 'LSM-Tree 如何在写放大、读放大与空间放大 (RUM) 之间做工程权衡？',\n      back: '写路径顺序追加 WAL + 内存 MemTable，满后刷盘为不可变 SSTable，将随机写转化为顺序写。后台 Compaction 合并层级：Leveled 策略压低读/空间放大但写放大较高；Size-Tiered 写放大低但空间放大高。配合 Bloom Filter 与 Fence Pointer 可显著减少点查磁盘 IO。',\n      tags: ['RocksDB', '存储引擎'],\n      links: ['raft-safety'],\n      ease_factor: 2.65,\n      interval_days: 28,\n      repetitions: 5,\n      due_date: addDays(today, 16),\n      last_reviewed: addDays(today, -12),\n      lapses: 0,\n    },\n  ];\n\n  const review_log = [\n    { date: addDays(today, -18), card_id: 'lsm-tree', deck_id: 'dist-consensus', rating: 3, interval_days: 6 },\n    { date: addDays(today, -16), card_id: 'tp-pp', deck_id: 'gpu-parallel', rating: 4, interval_days: 10 },\n    { date: addDays(today, -14), card_id: 'tp-pp', deck_id: 'gpu-parallel', rating: 4, interval_days: 24 },\n    { date: addDays(today, -12), card_id: 'flash-attn', deck_id: 'gpu-parallel', rating: 3, interval_days: 12 },\n    { date: addDays(today, -12), card_id: 'lsm-tree', deck_id: 'dist-consensus', rating: 4, interval_days: 28 },\n    { date: addDays(today, -9), card_id: 'nccl-ring', deck_id: 'gpu-parallel', rating: 3, interval_days: 4 },\n    { date: addDays(today, -7), card_id: 'spec-decode', deck_id: 'llm-inference', rating: 3, interval_days: 1 },\n    { date: addDays(today, -5), card_id: 'paged-attn', deck_id: 'llm-inference', rating: 2, interval_days: 1 },\n    { date: addDays(today, -4), card_id: 'nccl-ring', deck_id: 'gpu-parallel', rating: 3, interval_days: 8 },\n    { date: addDays(today, -3), card_id: 'spec-decode', deck_id: 'llm-inference', rating: 3, interval_days: 6 },\n    { date: addDays(today, -2), card_id: 'paged-attn', deck_id: 'llm-inference', rating: 2, interval_days: 2 },\n    { date: addDays(today, -2), card_id: 'raft-safety', deck_id: 'dist-consensus', rating: 1, interval_days: 0 },\n    { date: addDays(today, -1), card_id: 'raft-safety', deck_id: 'dist-consensus', rating: 3, interval_days: 1 },\n    { date: today, card_id: 'lsm-tree', deck_id: 'dist-consensus', rating: 4, interval_days: 28 },\n  ];\n\n  return { decks, cards, review_log };\n}\n\nexport default async function (request) {\n  const { kind, contribution, input } = request ?? {};\n\n  if (kind === 'action') {\n    if (contribution === 'study.state') {\n      const today = resolveToday(input?.today);\n      const all = await readAll();\n      const settings = await readPluginSettings();\n      return {\n        revision: all.revision,\n        today,\n        decks: all.decks,\n        cards: all.cards,\n        review_log: all.review_log,\n        stats: computeStats(all.cards, all.review_log, today),\n        settings,\n      };\n    }\n\n    if (contribution === 'study.deck.save') {\n      const { expected_revision, id, name, color, description } = input;\n      if (!ID_RE.test(id) || !name.trim() || !COLOR_RE.test(color)) {\n        return { status: 'invalid_input', revision: expected_revision };\n      }\n      const d = await readCollection(COL_DECKS, 'decks');\n      if (d.revision !== expected_revision) return { status: 'conflict', revision: d.revision };\n      const record = {\n        id,\n        name: name.trim().slice(0, 60),\n        color,\n        description: (description || '').trim().slice(0, 160),\n      };\n      const exists = d.items.some(x => x.id === id);\n      if (!exists && d.items.length >= MAX_DECKS) return { status: 'limit', revision: d.revision };\n      const next = exists ? d.items.map(x => (x.id === id ? record : x)) : [...d.items, record];\n      return writeCollection(COL_DECKS, 'decks', expected_revision, next);\n    }\n\n    if (contribution === 'study.deck.delete') {\n      const { expected_revision, id } = input;\n      const all = await readAll();\n      if (all.revision !== expected_revision) return { status: 'conflict', revision: all.revision };\n      if (!all.decks.some(d => d.id === id)) return { status: 'not_found', revision: all.revision };\n      const nextDecks = all.decks.filter(d => d.id !== id);\n      const removedIds = new Set(all.cards.filter(c => c.deck_id === id).map(c => c.id));\n      const nextCards = all.cards\n        .filter(c => c.deck_id !== id)\n        .map(c => ({ ...c, links: c.links.filter(l => !removedIds.has(l)) }));\n\n      const r1 = await writeCollection(COL_DECKS, 'decks', expected_revision, nextDecks);\n      if (r1.status !== 'saved') return { status: 'conflict', revision: r1.revision };\n      if (removedIds.size > 0) {\n        const r2 = await writeCollection(COL_CARDS, 'cards', r1.revision, nextCards);\n        if (r2.status !== 'saved') return { status: 'conflict', revision: r2.revision };\n        return { status: 'deleted', revision: r2.revision };\n      }\n      return { status: 'deleted', revision: r1.revision };\n    }\n\n    if (contribution === 'study.card.save') {\n      const { expected_revision, id, deck_id, kind: cardKind, front, back, tags, links, due_date } = input;\n      if (!ID_RE.test(id) || !front.trim() || !back.trim() || !KINDS.includes(cardKind)) {\n        return { status: 'invalid_input', revision: expected_revision };\n      }\n      const all = await readAll();\n      if (all.revision !== expected_revision) return { status: 'conflict', revision: all.revision };\n      if (!all.decks.some(d => d.id === deck_id)) {\n        return { status: 'deck_not_found', revision: all.revision };\n      }\n      const existing = all.cards.find(c => c.id === id);\n      if (!existing && all.cards.length >= MAX_CARDS) {\n        return { status: 'limit', revision: all.revision };\n      }\n      const validIds = new Set(all.cards.map(c => c.id));\n      validIds.add(id);\n      const today = utcToday();\n      const record = {\n        id,\n        deck_id,\n        kind: cardKind,\n        front: front.trim().slice(0, 320),\n        back: back.trim().slice(0, 800),\n        tags: normalizeTags(tags),\n        links: normalizeLinks(links, id, validIds),\n        ease_factor: existing ? existing.ease_factor : 2.5,\n        interval_days: existing ? existing.interval_days : 0,\n        repetitions: existing ? existing.repetitions : 0,\n        due_date:\n          typeof due_date === 'string' && DATE_RE.test(due_date)\n            ? due_date\n            : existing\n              ? existing.due_date\n              : today,\n        last_reviewed: existing ? existing.last_reviewed : '',\n        lapses: existing ? existing.lapses : 0,\n      };\n      const nextCards = existing\n        ? all.cards.map(c => (c.id === id ? record : c))\n        : [record, ...all.cards];\n      const res = await writeCollection(COL_CARDS, 'cards', expected_revision, nextCards);\n      return res.status === 'saved'\n        ? { status: 'saved', revision: res.revision, card_id: id }\n        : { status: res.status, revision: res.revision };\n    }\n\n    if (contribution === 'study.card.delete') {\n      const { expected_revision, id } = input;\n      const c = await readCollection(COL_CARDS, 'cards');\n      if (c.revision !== expected_revision) return { status: 'conflict', revision: c.revision };\n      if (!c.items.some(x => x.id === id)) return { status: 'not_found', revision: c.revision };\n      const nextCards = c.items\n        .filter(x => x.id !== id)\n        .map(x => ({ ...x, links: x.links.filter(l => l !== id) }));\n      const res = await writeCollection(COL_CARDS, 'cards', expected_revision, nextCards);\n      return res.status === 'saved'\n        ? { status: 'deleted', revision: res.revision }\n        : { status: 'conflict', revision: res.revision };\n    }\n\n    if (contribution === 'study.review.submit') {\n      const { expected_revision, card_id, rating, today: inputToday } = input;\n      if (!Number.isInteger(rating) || rating < 1 || rating > 4) {\n        return { status: 'invalid_input', revision: expected_revision };\n      }\n      const today = resolveToday(inputToday);\n      const c = await readCollection(COL_CARDS, 'cards');\n      const l = await readCollection(COL_LOG, 'logs');\n      if (l.revision !== expected_revision) return { status: 'conflict', revision: l.revision };\n      const target = c.items.find(x => x.id === card_id);\n      if (!target) return { status: 'not_found', revision: l.revision };\n\n      const sm2 = computeSm2(target, rating, today);\n      const updatedCard = { ...target, ...sm2 };\n      const nextCards = c.items.map(x => (x.id === card_id ? updatedCard : x));\n      const logEntry = {\n        date: today,\n        card_id: target.id,\n        deck_id: target.deck_id,\n        rating,\n        interval_days: sm2.interval_days,\n      };\n      const nextLogs = [...l.items, logEntry].slice(-MAX_LOG_ITEMS);\n\n      const r1 = await writeCollection(COL_CARDS, 'cards', expected_revision, nextCards);\n      if (r1.status !== 'saved') return { status: 'conflict', revision: r1.revision };\n      const r2 = await writeCollection(COL_LOG, 'logs', r1.revision, nextLogs);\n      if (r2.status !== 'saved') return { status: 'conflict', revision: r2.revision };\n\n      return {\n        status: 'reviewed',\n        revision: r2.revision,\n        next_interval_days: sm2.interval_days,\n        next_due_date: sm2.due_date,\n        ease_factor: sm2.ease_factor,\n        repetitions: sm2.repetitions,\n      };\n    }\n\n    if (contribution === 'study.demo.load') {\n      const { expected_revision, today: inputToday } = input;\n      const today = resolveToday(inputToday);\n      const all = await readAll();\n      if (all.revision !== expected_revision) {\n        return { status: 'conflict', revision: all.revision, decks_count: all.decks.length, cards_count: all.cards.length };\n      }\n      const demo = buildDemoData(today);\n      const r1 = await writeCollection(COL_DECKS, 'decks', expected_revision, demo.decks);\n      if (r1.status !== 'saved') return { status: 'conflict', revision: r1.revision, decks_count: 0, cards_count: 0 };\n      const r2 = await writeCollection(COL_CARDS, 'cards', r1.revision, demo.cards);\n      if (r2.status !== 'saved') return { status: 'conflict', revision: r2.revision, decks_count: 0, cards_count: 0 };\n      const r3 = await writeCollection(COL_LOG, 'logs', r2.revision, demo.review_log);\n      if (r3.status !== 'saved') return { status: 'conflict', revision: r3.revision, decks_count: 0, cards_count: 0 };\n      return {\n        status: 'loaded',\n        revision: r3.revision,\n        decks_count: demo.decks.length,\n        cards_count: demo.cards.length,\n      };\n    }\n\n    if (contribution === 'document.list') {\n      const listed = await globalThis.nmas.data.list({ collection: COL_DECKS, limit: 20 });\n      const all = listed.keys.length ? await readAll() : { decks: [], cards: [] };\n      const items = [];\n      if (all.decks.length > 0 || all.cards.length > 0) {\n        items.push({ id: 'all', label: `全部知识库 (${all.decks.length} 卡组 · ${all.cards.length} 卡片)` });\n      }\n      for (const d of all.decks) {\n        const cnt = all.cards.filter(c => c.deck_id === d.id).length;\n        items.push({ id: `deck:${d.id}`, label: `卡组: ${d.name} (${cnt} 张)` });\n      }\n      return { items };\n    }\n\n    if (contribution === 'document.export') {\n      const all = await readAll();\n      let decks = all.decks;\n      let cards = all.cards;\n      let filename = 'knowledge-os-all.json';\n      if (input.id !== 'all') {\n        const deckId = input.id.startsWith('deck:') ? input.id.slice(5) : input.id;\n        const deck = all.decks.find(d => d.id === deckId);\n        if (!deck) return { error: 'not_found' };\n        decks = [deck];\n        cards = all.cards.filter(c => c.deck_id === deck.id);\n        filename = `knowledge-deck-${deck.id}.json`;\n      }\n      const payload = {\n        format: DOC_FORMAT,\n        version: 1,\n        decks,\n        cards: cards.map(({ id, deck_id, kind: k, front, back, tags, links }) => ({\n          id,\n          deck_id,\n          kind: k,\n          front,\n          back,\n          tags,\n          links,\n        })),\n      };\n      const text = JSON.stringify(payload, null, 2);\n      if (jsonBytes(text) > MAX_RECORD_BYTES) return { error: 'too_large' };\n      return { filename, text };\n    }\n\n    if (contribution === 'document.import') {\n      let parsed;\n      try {\n        parsed = JSON.parse(input.text);\n      } catch {\n        return { imported: false, reason: 'invalid_json' };\n      }\n      if (\n        parsed?.format !== DOC_FORMAT ||\n        parsed?.version !== 1 ||\n        !Array.isArray(parsed.decks) ||\n        !Array.isArray(parsed.cards)\n      ) {\n        return { imported: false, reason: 'invalid_document' };\n      }\n      const all = await readAll();\n      const deckMap = new Map(all.decks.map(d => [d.id, d]));\n      let addedDecks = 0;\n      for (const d of parsed.decks) {\n        if (!d || typeof d.id !== 'string' || !ID_RE.test(d.id) || typeof d.name !== 'string' || !d.name.trim()) continue;\n        if (!deckMap.has(d.id)) {\n          if (deckMap.size >= MAX_DECKS) continue;\n          deckMap.set(d.id, {\n            id: d.id.slice(0, 40),\n            name: d.name.trim().slice(0, 60),\n            color: typeof d.color === 'string' && COLOR_RE.test(d.color) ? d.color : '#6366f1',\n            description: typeof d.description === 'string' ? d.description.trim().slice(0, 160) : '',\n          });\n          addedDecks += 1;\n        }\n      }\n\n      const cardMap = new Map(all.cards.map(c => [c.id, c]));\n      const today = utcToday();\n      let addedCards = 0;\n      for (const c of parsed.cards) {\n        if (\n          !c ||\n          typeof c.id !== 'string' ||\n          !ID_RE.test(c.id) ||\n          typeof c.deck_id !== 'string' ||\n          !deckMap.has(c.deck_id) ||\n          typeof c.front !== 'string' ||\n          !c.front.trim() ||\n          typeof c.back !== 'string' ||\n          !c.back.trim()\n        ) {\n          continue;\n        }\n        const targetId = cardMap.has(c.id) ? `${c.id.slice(0, 28)}-${addedCards + 1}` : c.id.slice(0, 40);\n        if (cardMap.size >= MAX_CARDS) break;\n        cardMap.set(targetId, {\n          id: targetId,\n          deck_id: c.deck_id,\n          kind: KINDS.includes(c.kind) ? c.kind : 'concept',\n          front: c.front.trim().slice(0, 320),\n          back: c.back.trim().slice(0, 800),\n          tags: normalizeTags(c.tags),\n          links: normalizeLinks(c.links, targetId, null),\n          ease_factor: 2.5,\n          interval_days: 0,\n          repetitions: 0,\n          due_date: today,\n          last_reviewed: '',\n          lapses: 0,\n        });\n        addedCards += 1;\n      }\n\n      const allCardIds = new Set(cardMap.keys());\n      const nextCards = Array.from(cardMap.values()).map(c => ({\n        ...c,\n        links: c.links.filter(l => allCardIds.has(l) && l !== c.id),\n      }));\n      const nextDecks = Array.from(deckMap.values());\n\n      const r1 = await writeCollection(COL_DECKS, 'decks', all.revision, nextDecks);\n      if (r1.status !== 'saved') return { imported: false, reason: r1.status };\n      const r2 = await writeCollection(COL_CARDS, 'cards', r1.revision, nextCards);\n      if (r2.status !== 'saved') return { imported: false, reason: r2.status };\n      return { imported: true, added_decks: addedDecks, added_cards: addedCards };\n    }\n  }\n\n  if (kind === 'tool') {\n    if (contribution === 'study.due') {\n      const today = resolveToday(input?.today);\n      const deckFilter = typeof input?.deck_id === 'string' && input.deck_id.trim() ? input.deck_id.trim() : '';\n      const limit = Number.isInteger(input?.limit) ? clamp(input.limit, 1, 20) : 10;\n      const all = await readAll();\n      const deckNameById = new Map(all.decks.map(d => [d.id, d.name]));\n      const stats = computeStats(all.cards, all.review_log, today);\n      const dueAll = all.cards\n        .filter(c => c.due_date <= today && (!deckFilter || c.deck_id === deckFilter))\n        .sort((a, b) => (a.due_date === b.due_date ? a.interval_days - b.interval_days : a.due_date.localeCompare(b.due_date)));\n      const due_cards = dueAll.slice(0, limit).map(c => ({\n        id: c.id,\n        deck_id: c.deck_id,\n        deck_name: deckNameById.get(c.deck_id) || c.deck_id,\n        kind: c.kind,\n        front: c.front,\n        interval_days: c.interval_days,\n        ease_factor: c.ease_factor,\n        due_date: c.due_date,\n        links: c.links,\n      }));\n      return {\n        success: true,\n        status: due_cards.length > 0 ? 'ready' : 'empty',\n        today,\n        due_count: dueAll.length,\n        total_cards: all.cards.length,\n        mastery_rate: stats.mastery_rate,\n        due_cards,\n      };\n    }\n\n    if (contribution === 'study.card.add') {\n      const { deck_id, front, back, kind: cardKind = 'concept', tags = [], links = [] } = input;\n      if (!front.trim() || !back.trim() || !KINDS.includes(cardKind)) {\n        const all = await readAll();\n        return { success: false, status: 'invalid_input', revision: all.revision };\n      }\n      const all = await readAll();\n      if (!all.decks.some(d => d.id === deck_id)) {\n        return { success: false, status: 'deck_not_found', revision: all.revision };\n      }\n      if (all.cards.length >= MAX_CARDS) {\n        return { success: false, status: 'limit', revision: all.revision };\n      }\n      const id = `c-${Date.now().toString(36)}-${(all.cards.length + 1).toString(36)}`.slice(0, 40);\n      const validIds = new Set(all.cards.map(c => c.id));\n      const today = utcToday();\n      const record = {\n        id,\n        deck_id,\n        kind: cardKind,\n        front: front.trim().slice(0, 320),\n        back: back.trim().slice(0, 800),\n        tags: normalizeTags(tags),\n        links: normalizeLinks(links, id, validIds),\n        ease_factor: 2.5,\n        interval_days: 0,\n        repetitions: 0,\n        due_date: today,\n        last_reviewed: '',\n        lapses: 0,\n      };\n      const res = await writeCollection(COL_CARDS, 'cards', all.revision, [record, ...all.cards]);\n      if (res.status !== 'saved') {\n        return { success: false, status: res.status, revision: res.revision };\n      }\n      return {\n        success: true,\n        status: 'created',\n        card_id: id,\n        due_date: today,\n        revision: res.revision,\n      };\n    }\n  }\n\n  throw new Error(`不支持的调用: ${kind}/${contribution}`);\n}\n","path":"backend/index.js"},{"content":"<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>AI 知识图谱与间隔重复学习系统</title>\n<style>\n:root{\ncolor-scheme:light dark;\n--bg:#f6f7fb;--surface:#ffffff;--s2:#f0f2f8;--s3:#e7ebf4;\n--fg:#111827;--fg2:#374151;--muted:#6b7280;\n--border:#dfe4ef;--b2:#c8d1e4;\n--accent:#4f46e5;--accent-s:rgba(79,70,229,.11);--accent-fg:#fff;\n--ok:#059669;--ok-s:rgba(5,150,105,.12);\n--warn:#d97706;--warn-s:rgba(217,119,6,.13);\n--danger:#dc2626;--danger-s:rgba(220,38,38,.12);\n--info:#0284c7;--info-s:rgba(2,132,199,.12);\n--sh1:0 1px 2px rgba(15,23,42,.05);--sh2:0 12px 30px rgba(15,23,42,.1);\n--r:12px;--mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;\nfont:13.5px/1.55 -apple-system,BlinkMacSystemFont,\"SF Pro Text\",\"Segoe UI\",system-ui,sans-serif;\n}\n@media (prefers-color-scheme:dark){\n:root:not([data-theme=\"light\"]){--bg:#0c0f17;--surface:#131824;--s2:#1a2132;--s3:#222b40;--fg:#f3f4f6;--fg2:#d1d5db;--muted:#94a3b8;--border:#252f45;--b2:#33415c;--accent:#818cf8;--accent-s:rgba(129,140,248,.16);--accent-fg:#0c0f17;--ok:#34d399;--ok-s:rgba(52,211,153,.15);--warn:#fbbf24;--warn-s:rgba(251,191,36,.15);--danger:#f87171;--danger-s:rgba(248,113,113,.15);--info:#38bdf8;--info-s:rgba(56,189,248,.15);--sh1:0 1px 2px rgba(0,0,0,.35);--sh2:0 14px 36px rgba(0,0,0,.48)}\n}\n:root[data-theme=\"dark\"]{--bg:#0c0f17;--surface:#131824;--s2:#1a2132;--s3:#222b40;--fg:#f3f4f6;--fg2:#d1d5db;--muted:#94a3b8;--border:#252f45;--b2:#33415c;--accent:#818cf8;--accent-s:rgba(129,140,248,.16);--accent-fg:#0c0f17;--ok:#34d399;--ok-s:rgba(52,211,153,.15);--warn:#fbbf24;--warn-s:rgba(251,191,36,.15);--danger:#f87171;--danger-s:rgba(248,113,113,.15);--info:#38bdf8;--info-s:rgba(56,189,248,.15);--sh1:0 1px 2px rgba(0,0,0,.35);--sh2:0 14px 36px rgba(0,0,0,.48)}\n*{box-sizing:border-box}\nhtml,body{height:100%;margin:0;background:var(--bg);color:var(--fg);overflow:hidden}\nbutton,input,select,textarea{font:inherit;color:inherit}\n.app{display:grid;grid-template-columns:222px minmax(0,1fr);height:100vh}\n@media (max-width:780px){\n.app{grid-template-columns:1fr;grid-template-rows:auto minmax(0,1fr)}\n.sidebar{flex-direction:row !important;align-items:center;overflow-x:auto;border-right:none !important;border-bottom:1px solid var(--border);padding:8px 12px !important}\n.nav-list,.sidebar-foot{flex-direction:row !important;margin-top:0 !important}\n.brand-sub{display:none}\n}\n.sidebar{background:var(--surface);border-right:1px solid var(--border);padding:15px 12px;display:flex;flex-direction:column;gap:14px;overflow-y:auto}\n.brand{display:flex;align-items:center;gap:10px;padding:2px 6px}\n.brand-icon{width:34px;height:34px;border-radius:10px;flex-shrink:0;background:linear-gradient(135deg,#4f46e5,#06b6d4);display:grid;place-items:center;color:#fff;box-shadow:0 4px 12px rgba(79,70,229,.3)}\n.brand-title{font-weight:700;font-size:14px;letter-spacing:-.01em;line-height:1.2}\n.brand-sub{font-size:11px;color:var(--muted)}\n.nav-list{display:flex;flex-direction:column;gap:4px}\n.nav-btn{display:flex;align-items:center;gap:9px;width:100%;padding:9px 10px;border-radius:9px;border:1px solid transparent;background:transparent;cursor:pointer;text-align:left;font-weight:500;color:var(--fg2);transition:.14s}\n.nav-btn:hover{background:var(--s2);color:var(--fg)}\n.nav-btn.active{background:var(--accent-s);color:var(--accent);border-color:color-mix(in srgb,var(--accent) 28%,transparent);font-weight:600}\n.nav-badge{margin-left:auto;font-size:11px;font-weight:600;padding:1px 7px;border-radius:999px;background:var(--s2);color:var(--muted)}\n.nav-btn.active .nav-badge{background:var(--accent);color:var(--accent-fg)}\n.sidebar-foot{margin-top:auto;display:flex;flex-direction:column;gap:6px;padding-top:10px;border-top:1px solid var(--border)}\n.main-col{display:flex;flex-direction:column;min-width:0;height:100%;overflow:hidden}\n.topbar{background:var(--surface);border-bottom:1px solid var(--border);padding:10px 18px;display:flex;align-items:center;gap:12px;flex-wrap:wrap}\n.kpi-strip{display:flex;align-items:center;gap:10px;flex-wrap:wrap;flex:1}\n.kpi-chip{display:flex;align-items:center;gap:8px;padding:6px 11px;border-radius:10px;background:var(--s2);border:1px solid var(--border);min-width:114px}\n.kpi-val{font-size:16px;font-weight:700;line-height:1.1;font-variant-numeric:tabular-nums}\n.kpi-lbl{font-size:11px;color:var(--muted);line-height:1.2}\n.dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;display:inline-block}\n.status-bar{padding:5px 18px;font-size:12px;color:var(--muted);background:var(--bg);border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:8px}\n.status-bar[data-kind=\"error\"]{color:var(--danger);background:var(--danger-s)}\n.status-bar[data-kind=\"ok\"]{color:var(--ok)}\n.workspace{flex:1;overflow-y:auto;padding:16px 18px 24px}\n.view[hidden],[hidden]{display:none !important}\n.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:7px 12px;border-radius:8px;border:1px solid var(--border);background:var(--surface);color:var(--fg);cursor:pointer;font-weight:500;transition:.12s;white-space:nowrap}\n.btn:hover:not(:disabled){background:var(--s2);border-color:var(--b2)}\n.btn:disabled{opacity:.5;cursor:not-allowed}\n.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-fg)}\n.btn.primary:hover:not(:disabled){filter:brightness(1.07)}\n.btn.ghost{background:transparent;border-color:transparent}\n.btn.ghost:hover:not(:disabled){background:var(--s2)}\n.btn.danger{color:var(--danger);border-color:color-mix(in srgb,var(--danger) 35%,var(--border))}\n.btn.danger:hover:not(:disabled){background:var(--danger-s)}\n.btn.sm{padding:4px 9px;font-size:12px;border-radius:7px}\ninput[type=\"text\"],input[type=\"search\"],select,textarea{width:100%;padding:7px 10px;border-radius:8px;border:1px solid var(--border);background:var(--surface);color:var(--fg);outline:none}\ninput:focus,select:focus,textarea:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-s)}\ntextarea{resize:vertical;min-height:82px}\n.panel{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:14px 16px;box-shadow:var(--sh1)}\n.panel-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:11px}\n.panel-title{font-size:14px;font-weight:700;margin:0}\n.muted{color:var(--muted);font-size:12px}\n.row{display:flex;align-items:center;gap:8px;flex-wrap:wrap}\n.pill{display:inline-flex;align-items:center;gap:5px;padding:2px 8px;border-radius:999px;font-size:11.5px;font-weight:600;background:var(--s2);color:var(--fg2);border:1px solid var(--border)}\n.pill.click{cursor:pointer}\n.pill.click:hover{border-color:var(--accent);color:var(--accent)}\n.review-wrap{max-width:780px;margin:0 auto;display:flex;flex-direction:column;gap:14px}\n.progress-track{height:7px;border-radius:99px;background:var(--s2);overflow:hidden}\n.progress-fill{height:100%;border-radius:99px;background:linear-gradient(90deg,var(--accent),#06b6d4);transition:width .25s ease}\n.fc-stage{perspective:1200px}\n.flashcard{width:100%;min-height:300px;border-radius:16px;border:1px solid var(--border);background:var(--surface);box-shadow:var(--sh2);padding:22px 26px;display:flex;flex-direction:column;justify-content:space-between;transition:transform .25s ease,border-color .2s;cursor:pointer;transform-style:preserve-3d}\n.flashcard:hover{border-color:var(--b2);transform:translateY(-1px)}\n.flashcard.flipped{border-color:color-mix(in srgb,var(--accent) 48%,var(--border))}\n.fc-front{font-size:19.5px;font-weight:700;line-height:1.45;letter-spacing:-.01em;margin:18px 0 12px}\n.fc-div{height:1px;background:var(--border);margin:12px 0}\n.fc-back{background:var(--s2);border:1px solid var(--border);border-radius:11px;padding:14px 16px;white-space:pre-wrap;word-break:break-word;font-size:13.8px;line-height:1.65;animation:reveal .22s ease}\n.fc-back.code{font-family:var(--mono);font-size:12.5px}\n@keyframes reveal{from{opacity:0;transform:rotateX(-12deg) translateY(6px)}to{opacity:1;transform:none}}\n.rate-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}\n@media (max-width:560px){.rate-grid{grid-template-columns:repeat(2,1fr)}}\n.rate-btn{display:flex;flex-direction:column;align-items:center;gap:3px;padding:11px 8px;border-radius:11px;border:1px solid var(--border);background:var(--surface);cursor:pointer;transition:.12s}\n.rate-btn:hover:not(:disabled){transform:translateY(-1px)}\n.rate-btn strong{font-size:13.5px}\n.rate-btn span{font-size:11.5px;color:var(--muted)}\n.rate-btn.r1{border-color:color-mix(in srgb,var(--danger) 42%,var(--border))}.rate-btn.r1:hover{background:var(--danger-s)}.rate-btn.r1 strong{color:var(--danger)}\n.rate-btn.r2{border-color:color-mix(in srgb,var(--warn) 45%,var(--border))}.rate-btn.r2:hover{background:var(--warn-s)}.rate-btn.r2 strong{color:var(--warn)}\n.rate-btn.r3{border-color:color-mix(in srgb,var(--info) 45%,var(--border))}.rate-btn.r3:hover{background:var(--info-s)}.rate-btn.r3 strong{color:var(--info)}\n.rate-btn.r4{border-color:color-mix(in srgb,var(--ok) 45%,var(--border))}.rate-btn.r4:hover{background:var(--ok-s)}.rate-btn.r4 strong{color:var(--ok)}\n.graph-layout{display:grid;grid-template-columns:minmax(0,1fr) 308px;gap:14px;min-height:500px}\n@media (max-width:960px){.graph-layout{grid-template-columns:1fr}}\n.graph-wrap{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);overflow:hidden;display:flex;flex-direction:column;min-height:485px}\n.graph-bar{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:10px 14px;border-bottom:1px solid var(--border);flex-wrap:wrap}\n.graph-svg{width:100%;flex:1;min-height:435px;display:block;background:var(--bg)}\n.inspector{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:14px;display:flex;flex-direction:column;gap:11px;overflow-y:auto;max-height:550px}\n.mgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}\n.mbox{background:var(--s2);border:1px solid var(--border);border-radius:8px;padding:7px 9px}\n.mbox b{display:block;font-size:13.5px;font-variant-numeric:tabular-nums}\n.mbox span{font-size:11px;color:var(--muted)}\n.charts-grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);gap:14px;margin-bottom:14px}\n@media (max-width:880px){.charts-grid{grid-template-columns:1fr}}\n.deck-strip{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}\n.deck-chip{display:inline-flex;align-items:center;gap:7px;padding:6px 11px;border-radius:10px;border:1px solid var(--border);background:var(--surface);cursor:pointer;font-weight:500}\n.deck-chip.active{border-color:var(--accent);background:var(--accent-s);color:var(--accent)}\n.card-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(285px,1fr));gap:11px}\n.kcard{background:var(--surface);border:1px solid var(--border);border-radius:11px;padding:13px;display:flex;flex-direction:column;gap:8px}\n.kcard:hover{border-color:var(--b2);box-shadow:var(--sh1)}\n.kcard-front{font-weight:600;font-size:13.5px;line-height:1.4}\n.kcard-back{font-size:12.5px;color:var(--fg2);line-height:1.5;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}\n.mbar{height:5px;border-radius:99px;background:var(--s2);overflow:hidden}\n.mbar > i{display:block;height:100%;border-radius:99px}\n.ai-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:14px}\n@media (max-width:880px){.ai-grid{grid-template-columns:1fr}}\n.mode-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:12px}\n.mode-card{padding:10px;border-radius:10px;border:1px solid var(--border);background:var(--s2);cursor:pointer;text-align:left}\n.mode-card.active{border-color:var(--accent);background:var(--accent-s)}\n.mode-card b{display:block;font-size:12.5px}\n.mode-card span{display:block;font-size:11px;color:var(--muted);margin-top:2px}\n.ai-out{white-space:pre-wrap;word-break:break-word;padding:12px;border-radius:10px;border:1px solid var(--border);background:var(--s2);max-height:280px;overflow-y:auto;font-size:13px;line-height:1.6}\n.draft-card{border:1px solid var(--border);border-radius:10px;padding:10px;background:var(--s2);display:flex;flex-direction:column;gap:5px}\n.modal-bg{position:fixed;inset:0;background:rgba(10,14,24,.56);display:grid;place-items:center;padding:16px;z-index:40}\n.modal{width:min(550px,100%);max-height:90vh;overflow-y:auto;background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:18px;box-shadow:var(--sh2);display:flex;flex-direction:column;gap:12px}\n.field{display:flex;flex-direction:column;gap:5px}\n.field > span{font-size:12px;font-weight:600;color:var(--fg2)}\n.link-picker{display:flex;flex-wrap:wrap;gap:6px;max-height:120px;overflow-y:auto;padding:8px;border:1px solid var(--border);border-radius:8px;background:var(--s2)}\n.link-opt{display:inline-flex;align-items:center;gap:5px;font-size:12px;padding:3px 8px;border-radius:7px;border:1px solid var(--border);background:var(--surface);cursor:pointer}\n.link-opt input{width:auto;margin:0}\n.empty{text-align:center;padding:38px 20px;border:1px dashed var(--b2);border-radius:var(--r);background:var(--surface);display:flex;flex-direction:column;align-items:center;gap:10px}\n.kbd{font-family:var(--mono);font-size:11px;padding:1px 5px;border-radius:5px;border:1px solid var(--b2);background:var(--s2)}\n\n    /* === V2 Host Theme & Compact Surface Start === */\n    :root[data-theme=\"dark\"], html[data-theme=\"dark\"] { color-scheme: dark; --bg: #0c0f17; --surface: #131824; --fg: #f3f4f6; --muted: #94a3b8; --border: #252f45; --accent: #818cf8; --v2-host-accent: #818cf8; }\n    :root[data-theme=\"light\"], html[data-theme=\"light\"] { color-scheme: light; --bg: #f6f7fb; --surface: #ffffff; --fg: #111827; --muted: #6b7280; --border: #dfe4ef; --accent: #4f46e5; --v2-host-accent: #4f46e5; }\n    :root[data-theme=\"dark\"]:not([data-theme-override=\"1\"]), html[data-theme=\"dark\"]:not([data-theme-override=\"1\"]) { --bg: var(--host-bg, #0c0f17); --surface: var(--host-surface, #131824); --fg: var(--host-fg, #f3f4f6); --muted: var(--host-muted, #94a3b8); --border: var(--host-border, #252f45); --v2-host-accent: var(--host-primary, #818cf8); }\n    :root[data-theme=\"light\"]:not([data-theme-override=\"1\"]), html[data-theme=\"light\"]:not([data-theme-override=\"1\"]) { --bg: var(--host-bg, #f6f7fb); --surface: var(--host-surface, #ffffff); --fg: var(--host-fg, #111827); --muted: var(--host-muted, #6b7280); --border: var(--host-border, #dfe4ef); --v2-host-accent: var(--host-primary, #4f46e5); }\n    :is(button, input, select, textarea, .v2-surface-tab):focus-visible { outline: 2px solid var(--v2-host-accent, var(--accent)); outline-offset: 1px; }\n    html[data-surface=\"chat\"], html[data-surface=\"assistant\"],\n    html[data-surface=\"chat\"] body, html[data-surface=\"assistant\"] body { overflow-x: hidden; }\n    html[data-surface=\"chat\"] .sidebar, html[data-surface=\"assistant\"] .sidebar { display: none !important; }\n    html[data-surface=\"chat\"] .app, html[data-surface=\"assistant\"] .app { grid-template-columns: 1fr !important; grid-template-rows: minmax(0, 1fr) !important; }\n    html[data-surface=\"chat\"] .graph-layout, html[data-surface=\"assistant\"] .graph-layout, html[data-surface=\"chat\"] .charts-grid, html[data-surface=\"assistant\"] .charts-grid, html[data-surface=\"chat\"] .card-grid, html[data-surface=\"assistant\"] .card-grid, html[data-surface=\"chat\"] .ai-grid, html[data-surface=\"assistant\"] .ai-grid { grid-template-columns: 1fr !important; }\n    html[data-surface=\"chat\"] .rate-grid, html[data-surface=\"assistant\"] .rate-grid { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; gap: 8px; }\n    html[data-surface=\"chat\"] :is(section, article, main, .card, .panel, .view),\n    html[data-surface=\"assistant\"] :is(section, article, main, .card, .panel, .view) { min-width: 0; }\n    html[data-surface=\"chat\"] :is(svg, canvas, pre),\n    html[data-surface=\"assistant\"] :is(svg, canvas, pre) { max-width: 100%; }\n    html[data-surface=\"chat\"] .topbar, html[data-surface=\"assistant\"] .topbar { padding: 8px 10px; gap: 6px; }\n    html[data-surface=\"chat\"] .workspace, html[data-surface=\"assistant\"] .workspace { padding: 10px; gap: 10px; }\n    .v2-surface-nav { display: none; }\n    html[data-surface=\"chat\"] .v2-surface-nav, html[data-surface=\"assistant\"] .v2-surface-nav {\n      display: flex; align-items: center; gap: 6px; padding: 7px 10px; \n      overflow-x: auto; scrollbar-width: none; flex-shrink: 0;\n      background: var(--surface); border-bottom: 1px solid var(--border);\n      position: sticky; top: 0; z-index: 30;\n    }\n    html[data-surface=\"chat\"] .v2-surface-nav::-webkit-scrollbar, html[data-surface=\"assistant\"] .v2-surface-nav::-webkit-scrollbar { display: none; }\n    .v2-surface-tab {\n      appearance: none; border: 1px solid var(--border); background: transparent;\n      color: var(--muted); border-radius: 999px; padding: 4px 10px; font-size: 12px;\n      line-height: 1.35; font-weight: 500; white-space: nowrap; flex-shrink: 0; cursor: pointer;\n      transition: background 0.14s ease, border-color 0.14s ease, color 0.14s ease;\n    }\n    .v2-surface-tab:hover { color: var(--fg); border-color: var(--v2-host-accent, var(--accent)); }\n    .v2-surface-tab.active {\n      color: var(--v2-host-accent, var(--accent));\n      border-color: var(--v2-host-accent, var(--accent));\n      background: color-mix(in srgb, var(--v2-host-accent, var(--accent)) 14%, transparent);\n      font-weight: 600;\n    }\n    /* === V2 Host Theme & Compact Surface End === */\n  </style>\n</head>\n<body>\n<div class=\"app\">\n <aside class=\"sidebar\">\n  <div class=\"brand\">\n   <div class=\"brand-icon\" aria-hidden=\"true\">\n    <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\">\n     <circle cx=\"6\" cy=\"6\" r=\"2.6\"/><circle cx=\"18\" cy=\"7\" r=\"2.6\"/><circle cx=\"12\" cy=\"18\" r=\"2.6\"/>\n     <path d=\"M8.3 7.1 15.5 7M7.2 8.4l3.6 7.2M16.7 9.4l-3.4 6.3\"/>\n    </svg>\n   </div>\n   <div><div class=\"brand-title\">Knowledge OS</div><div class=\"brand-sub\">SM-2 间隔重复 · 知识图谱</div></div>\n  </div>\n  <nav class=\"nav-list\" aria-label=\"主导航\">\n   <button class=\"nav-btn active\" data-view=\"review\" type=\"button\">\n    <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"14\" rx=\"2\"/><path d=\"M7 20h10M9 9h6M9 13h4\"/></svg>\n    <span>今日复习</span><span class=\"nav-badge\" id=\"badge-due\">0</span>\n   </button>\n   <button class=\"nav-btn\" data-view=\"graph\" type=\"button\">\n    <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"5\" cy=\"12\" r=\"2.5\"/><circle cx=\"19\" cy=\"6\" r=\"2.5\"/><circle cx=\"19\" cy=\"18\" r=\"2.5\"/><path d=\"M7.3 11 16.7 7M7.3 13l9.4 4\"/></svg>\n    <span>知识图谱</span><span class=\"nav-badge\" id=\"badge-links\">0</span>\n   </button>\n   <button class=\"nav-btn\" data-view=\"library\" type=\"button\">\n    <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M4 19.5A2.5 2.5 0 0 1 6.5 17H20\"/><path d=\"M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z\"/></svg>\n    <span>卡组与知识库</span><span class=\"nav-badge\" id=\"badge-cards\">0</span>\n   </button>\n   <button class=\"nav-btn\" data-view=\"feynman\" type=\"button\">\n    <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 3a6 6 0 0 0-4 10.5V17h8v-3.5A6 6 0 0 0 12 3z\"/><path d=\"M9 21h6\"/></svg>\n    <span>AI 费曼导师</span><span class=\"nav-badge\">AI</span>\n   </button>\n  </nav>\n  <div class=\"sidebar-foot\">\n   <button id=\"btn-demo\" class=\"btn sm\" type=\"button\">载入大模型演示卡组</button>\n   <button id=\"btn-io\" class=\"btn sm\" type=\"button\">导入 / 导出 JSON</button>\n   <button id=\"btn-theme\" class=\"btn sm ghost\" type=\"button\">切换明暗主题</button>\n  </div>\n </aside>\n <div class=\"main-col\">\n  <header class=\"topbar\">\n   <div class=\"kpi-strip\">\n    <div class=\"kpi-chip\"><span class=\"dot\" style=\"background:var(--danger)\"></span><div><div class=\"kpi-val\" id=\"kpi-due\">0</div><div class=\"kpi-lbl\">今日待复习</div></div></div>\n    <div class=\"kpi-chip\"><span class=\"dot\" style=\"background:var(--accent)\"></span><div><div class=\"kpi-val\" id=\"kpi-cards\">0</div><div class=\"kpi-lbl\">知识卡 / 双链</div></div></div>\n    <div class=\"kpi-chip\"><span class=\"dot\" style=\"background:var(--ok)\"></span><div><div class=\"kpi-val\" id=\"kpi-mastery\">0%</div><div class=\"kpi-lbl\">综合掌握度</div></div></div>\n    <div class=\"kpi-chip\"><span class=\"dot\" style=\"background:var(--warn)\"></span><div><div class=\"kpi-val\" id=\"kpi-streak\">0 天</div><div class=\"kpi-lbl\">连续学习 · 今日 <b id=\"kpi-today\">0</b></div></div></div>\n   </div>\n   <button id=\"btn-new-card\" class=\"btn primary sm\" type=\"button\">+ 新建知识卡</button>\n  </header>\n  <div id=\"status-bar\" class=\"status-bar\" role=\"status\"><span id=\"status-text\">正在初始化知识库…</span><span id=\"rev-tag\">rev #0</span></div>\n  <main class=\"workspace\">\n   <section id=\"view-review\" class=\"view\">\n    <div class=\"review-wrap\">\n     <div class=\"row\" style=\"justify-content:space-between\">\n      <div class=\"row\" id=\"review-deck-pills\"></div>\n      <span class=\"muted\" id=\"review-counter\">队列 0 / 0</span>\n     </div>\n     <div class=\"progress-track\"><div id=\"review-progress\" class=\"progress-fill\" style=\"width:0%\"></div></div>\n     <div id=\"review-stage\"></div>\n    </div>\n   </section>\n   <section id=\"view-graph\" class=\"view\" hidden>\n    <div class=\"graph-layout\">\n     <div class=\"graph-wrap\">\n      <div class=\"graph-bar\"><div class=\"row\" id=\"graph-legend\"></div><button id=\"btn-graph-clear\" class=\"btn sm\" type=\"button\">重置高亮</button></div>\n      <svg id=\"graph-svg\" class=\"graph-svg\" viewBox=\"0 0 760 470\" aria-label=\"知识图谱网络\"></svg>\n     </div>\n     <aside id=\"graph-inspector\" class=\"inspector\"></aside>\n    </div>\n   </section>\n   <section id=\"view-library\" class=\"view\" hidden>\n    <div class=\"charts-grid\">\n     <div class=\"panel\">\n      <div class=\"panel-head\"><h2 class=\"panel-title\">近 42 天学习热力图</h2><span class=\"muted\" id=\"heatmap-summary\">共 0 次复习</span></div>\n      <svg id=\"svg-heatmap\" width=\"100%\" viewBox=\"0 0 540 120\" aria-label=\"学习热力图\"></svg>\n     </div>\n     <div class=\"panel\">\n      <div class=\"panel-head\"><h2 class=\"panel-title\">记忆掌握度分布</h2><span class=\"muted\">SM-2 间隔分层</span></div>\n      <svg id=\"svg-mastery\" width=\"100%\" viewBox=\"0 0 380 120\" aria-label=\"掌握度分布柱状图\"></svg>\n     </div>\n    </div>\n    <div class=\"panel\" style=\"margin-bottom:14px\">\n     <div class=\"panel-head\"><h2 class=\"panel-title\">学科卡组</h2><button id=\"btn-new-deck\" class=\"btn sm\" type=\"button\">+ 新建卡组</button></div>\n     <div id=\"deck-strip\" class=\"deck-strip\"></div>\n     <div class=\"row\">\n      <div style=\"flex:1;min-width:180px\"><input id=\"lib-search\" type=\"search\" placeholder=\"搜索正面概念、答案或标签…\"></div>\n      <select id=\"lib-kind\" style=\"width:124px\"><option value=\"\">全部类型</option><option value=\"concept\">概念卡</option><option value=\"qa\">问答题</option><option value=\"code\">代码题</option></select>\n      <select id=\"lib-due\" style=\"width:128px\"><option value=\"\">全部状态</option><option value=\"due\">今日待复习</option><option value=\"mastered\">已掌握 (>=21天)</option></select>\n     </div>\n    </div>\n    <div id=\"card-grid\" class=\"card-grid\"></div>\n   </section>\n   <section id=\"view-feynman\" class=\"view\" hidden>\n    <div class=\"ai-grid\">\n     <div class=\"panel\">\n      <div class=\"panel-head\"><h2 class=\"panel-title\">费曼自测与闪卡提炼工作台</h2><span class=\"pill\">本地模板 · 可协同工作台聊天</span></div>\n      <div class=\"mode-tabs\" id=\"ai-mode-tabs\">\n       <button class=\"mode-card active\" data-mode=\"feynman\" type=\"button\"><b>费曼深度追问</b><span>3 个苏格拉底式盲区拷问</span></button>\n       <button class=\"mode-card\" data-mode=\"extract\" type=\"button\"><b>提炼 3 张闪卡</b><span>自动生成并一键采纳入库</span></button>\n       <button class=\"mode-card\" data-mode=\"analogy\" type=\"button\"><b>生成类比解释</b><span>直觉模型并追加到背面</span></button>\n      </div>\n      <div class=\"field\" style=\"margin-bottom:10px\"><span>关联已有知识卡（可选）</span><select id=\"ai-card-select\"></select></div>\n      <div class=\"field\" style=\"margin-bottom:12px\"><span>粘贴学习笔记或核心知识点</span><textarea id=\"ai-notes\" rows=\"6\" maxlength=\"1600\" placeholder=\"粘贴论文摘要、课程笔记或概念理解，生成本地结构化草稿或复制提示词至 Velai 工作台聊天/AI 伴生插件…\"></textarea></div>\n      <div class=\"row\">\n       <button id=\"btn-ai-draft\" class=\"btn primary\" type=\"button\">生成本地结构化草稿</button>\n       <button id=\"btn-ai-prompt\" class=\"btn\" type=\"button\">复制 AI 导师提示词</button>\n      </div>\n     </div>\n     <div class=\"panel\" style=\"display:flex;flex-direction:column;gap:10px\">\n      <div class=\"panel-head\" style=\"margin-bottom:0\"><h2 class=\"panel-title\">审阅与采纳工作区</h2><span class=\"muted\" id=\"ai-state-badge\">就绪</span></div>\n      <div id=\"ai-raw-preview\" class=\"ai-out\">选择左侧模式并点击「生成本地结构化草稿」即可审阅并采纳入库；如需深度追问可复制提示词至 Velai 工作台聊天或独立 AI 伴生插件。</div>\n      <div id=\"ai-adopt-area\" hidden style=\"display:flex;flex-direction:column;gap:10px\">\n       <div id=\"ai-draft-list\" style=\"display:flex;flex-direction:column;gap:8px\"></div>\n       <div class=\"row\">\n        <select id=\"ai-target-deck\" style=\"flex:1;min-width:140px\"></select>\n        <button id=\"btn-ai-adopt-cards\" class=\"btn primary\" type=\"button\" hidden>采纳选中闪卡入库</button>\n        <button id=\"btn-ai-append-card\" class=\"btn primary\" type=\"button\" hidden>追加到所选卡片背面</button>\n       </div>\n      </div>\n     </div>\n    </div>\n   </section>\n  </main>\n </div>\n</div>\n<div id=\"modal-card\" class=\"modal-bg\" hidden>\n <div class=\"modal\" role=\"dialog\" aria-modal=\"true\">\n  <div class=\"panel-head\" style=\"margin-bottom:0\"><h2 id=\"modal-card-title\" class=\"panel-title\">新建知识闪卡</h2><button class=\"btn sm ghost\" data-close=\"modal-card\" type=\"button\">关闭</button></div>\n  <div class=\"row\">\n   <label class=\"field\" style=\"flex:1\"><span>所属卡组</span><select id=\"fc-deck\"></select></label>\n   <label class=\"field\" style=\"width:128px\"><span>卡片类型</span><select id=\"fc-kind\"><option value=\"concept\">概念卡</option><option value=\"qa\">问答题</option><option value=\"code\">代码题</option></select></label>\n  </div>\n  <label class=\"field\"><span>正面：核心概念 / 问题</span><textarea id=\"fc-front\" rows=\"2\" maxlength=\"320\" placeholder=\"例如：FlashAttention 为何能减少 HBM 读写？\"></textarea></label>\n  <label class=\"field\"><span>背面：精炼解析 / 代码答案</span><textarea id=\"fc-back\" rows=\"4\" maxlength=\"800\" placeholder=\"关键原理、推导或代码片段…\"></textarea></label>\n  <label class=\"field\"><span>标签（逗号分隔，最多 6 个）</span><input id=\"fc-tags\" type=\"text\" placeholder=\"CUDA, Attention, 推理优化\"></label>\n  <div class=\"field\"><span>双链关联前置/相关知识卡</span><div id=\"fc-links\" class=\"link-picker\"></div></div>\n  <div class=\"row\" style=\"justify-content:flex-end\">\n   <button id=\"btn-fc-delete\" class=\"btn danger\" type=\"button\" hidden style=\"margin-right:auto\">删除卡片</button>\n   <button class=\"btn\" data-close=\"modal-card\" type=\"button\">取消</button>\n   <button id=\"btn-fc-save\" class=\"btn primary\" type=\"button\">保存卡片</button>\n  </div>\n </div>\n</div>\n<div id=\"modal-deck\" class=\"modal-bg\" hidden>\n <div class=\"modal\" role=\"dialog\" aria-modal=\"true\">\n  <div class=\"panel-head\" style=\"margin-bottom:0\"><h2 id=\"modal-deck-title\" class=\"panel-title\">新建学科卡组</h2><button class=\"btn sm ghost\" data-close=\"modal-deck\" type=\"button\">关闭</button></div>\n  <div class=\"row\">\n   <label class=\"field\" style=\"flex:1\"><span>卡组名称</span><input id=\"dk-name\" type=\"text\" maxlength=\"60\" placeholder=\"例如：深度学习编译器\"></label>\n   <label class=\"field\" style=\"width:92px\"><span>主题色</span><input id=\"dk-color\" type=\"color\" value=\"#6366f1\" style=\"height:35px;padding:3px\"></label>\n  </div>\n  <label class=\"field\"><span>简介</span><input id=\"dk-desc\" type=\"text\" maxlength=\"160\" placeholder=\"简述学科知识范围与目标\"></label>\n  <div class=\"row\" style=\"justify-content:flex-end\">\n   <button id=\"btn-dk-delete\" class=\"btn danger\" type=\"button\" hidden style=\"margin-right:auto\">删除卡组</button>\n   <button class=\"btn\" data-close=\"modal-deck\" type=\"button\">取消</button>\n   <button id=\"btn-dk-save\" class=\"btn primary\" type=\"button\">保存卡组</button>\n  </div>\n </div>\n</div>\n<div id=\"modal-io\" class=\"modal-bg\" hidden>\n <div class=\"modal\" role=\"dialog\" aria-modal=\"true\">\n  <div class=\"panel-head\" style=\"margin-bottom:0\"><h2 class=\"panel-title\">导入 / 导出知识库 JSON</h2><button class=\"btn sm ghost\" data-close=\"modal-io\" type=\"button\">关闭</button></div>\n  <div class=\"row\">\n   <select id=\"io-export-select\" style=\"flex:1\"></select>\n   <button id=\"btn-do-export\" class=\"btn\" type=\"button\">导出 JSON</button>\n   <button id=\"btn-copy-io\" class=\"btn\" type=\"button\">复制</button>\n  </div>\n  <label class=\"field\"><span>JSON 内容</span><textarea id=\"io-text\" rows=\"9\" style=\"font-family:var(--mono);font-size:12px\" placeholder='{\"format\":\"velai-course-knowledge-os\",\"version\":1,...}'></textarea></label>\n  <div class=\"row\" style=\"justify-content:flex-end\"><button class=\"btn\" data-close=\"modal-io\" type=\"button\">关闭</button><button id=\"btn-do-import\" class=\"btn primary\" type=\"button\">导入并合并</button></div>\n </div>\n</div>\n<script>\n(() => {\n const plugin = globalThis.nmasPlugin;\n const $ = id => document.getElementById(id);\n const SVG_NS = 'http://www.w3.org/2000/svg';\n const KIND_LABEL = { concept: '概念卡', qa: '问答题', code: '代码题' };\n const S = {\n  revision: 0, today: new Date().toISOString().slice(0, 10),\n  decks: [], cards: [], review_log: [],\n  stats: { total_cards: 0, due_count: 0, total_links: 0, mastery_rate: 0, streak_days: 0, reviewed_today: 0, tiers: { new_count: 0, learning: 0, reviewing: 0, mastered: 0 } },\n  view: 'review', busy: false, reviewDeck: '', flipped: false, doneCount: 0, pinnedId: null,\n  graphSel: null, libDeck: '', editCardId: null, editDeckId: null,\n  aiMode: 'feynman', aiWorkId: null, aiText: '', aiDrafts: [],\n };\n function el(tag, props, ...kids) {\n  const n = document.createElement(tag);\n  if (props) for (const [k, v] of Object.entries(props)) {\n   if (k === 'cls') n.className = v;\n   else if (k === 'on') for (const [ev, fn] of Object.entries(v)) n.addEventListener(ev, fn);\n   else if (k === 'css') n.style.cssText = v;\n   else n[k] = v;\n  }\n  for (const c of kids) if (c != null) n.append(typeof c === 'string' ? document.createTextNode(c) : c);\n  return n;\n }\n function svg(tag, attrs, text) {\n  const n = document.createElementNS(SVG_NS, tag);\n  if (attrs) for (const [k, v] of Object.entries(attrs)) n.setAttribute(k, String(v));\n  if (text != null) n.textContent = String(text);\n  return n;\n }\n const setStatus = (t, k = '') => { $('status-text').textContent = t; $('status-bar').dataset.kind = k; $('rev-tag').textContent = `rev #${S.revision}`; };\n const addDays = (ymd, d) => { const [y, m, dd] = ymd.split('-').map(Number); return new Date(Date.UTC(y, m - 1, dd + d)).toISOString().slice(0, 10); };\n const deckOf = id => S.decks.find(d => d.id === id) || { id, name: id, color: '#6366f1', description: '' };\n const dotPill = (color, label) => el('span', { cls: 'pill' }, el('span', { cls: 'dot', css: `background:${color}` }), label);\n const scoreOf = c => {\n  if (c.repetitions === 0 && !c.last_reviewed) return 0;\n  if (c.interval_days >= 21) return Math.min(100, Math.max(85, Math.round(85 + (c.ease_factor - 1.3) * 7)));\n  if (c.interval_days >= 6) return Math.min(84, Math.max(55, Math.round(55 + (c.interval_days - 6) * 2)));\n  return c.interval_days >= 1 ? Math.min(54, Math.max(25, Math.round(25 + c.interval_days * 5))) : 15;\n };\n function previewInt(c, r) {\n  if (r === 1) return '今天重学';\n  const q = r === 2 ? 3 : r === 3 ? 4 : 5;\n  const ef = Math.max(1.3, Math.min(3.5, Math.round((c.ease_factor + (0.1 - (5 - q) * (0.08 + (5 - q) * 0.02))) * 100) / 100));\n  const rep = c.repetitions, iv = c.interval_days;\n  const d = r === 2 ? (rep === 0 ? 1 : rep === 1 ? 4 : Math.max(iv + 1, Math.round(iv * 1.2)))\n   : r === 3 ? (rep === 0 ? 1 : rep === 1 ? 6 : Math.max(iv + 1, Math.round(iv * ef)))\n   : (rep === 0 ? 4 : rep === 1 ? 10 : Math.max(iv + 2, Math.round(iv * ef * 1.3)));\n  return `${d} 天后`;\n }\n function uuid() {\n  const b = crypto.getRandomValues(new Uint8Array(16));\n  b[6] = (b[6] & 0x0f) | 0x40; b[8] = (b[8] & 0x3f) | 0x80;\n  const h = Array.from(b, x => x.toString(16).padStart(2, '0')).join('');\n  return `${h.slice(0,8)}-${h.slice(8,12)}-${h.slice(12,16)}-${h.slice(16,20)}-${h.slice(20)}`;\n }\n function dueQueue() {\n  let q = S.cards.filter(c => c.due_date <= S.today && (!S.reviewDeck || c.deck_id === S.reviewDeck))\n   .sort((a, b) => (a.due_date === b.due_date ? a.interval_days - b.interval_days : a.due_date.localeCompare(b.due_date)));\n  if (S.pinnedId) { const p = S.cards.find(c => c.id === S.pinnedId); if (p) q = [p, ...q.filter(c => c.id !== p.id)]; }\n  return q;\n }\n function switchView(v) {\n  S.view = v;\n  document.querySelectorAll('.nav-btn').forEach(b => b.classList.toggle('active', b.dataset.view === v));\n  document.querySelectorAll('.view').forEach(s => { s.hidden = s.id !== `view-${v}`; });\n  render();\n }\n function render() {\n  const st = S.stats;\n  $('kpi-due').textContent = st.due_count;\n  $('kpi-cards').textContent = `${st.total_cards} / ${st.total_links}`;\n  $('kpi-mastery').textContent = `${Math.round(st.mastery_rate)}%`;\n  $('kpi-streak').textContent = `${st.streak_days} 天`;\n  $('kpi-today').textContent = st.reviewed_today;\n  $('badge-due').textContent = st.due_count;\n  $('badge-links').textContent = st.total_links;\n  $('badge-cards').textContent = st.total_cards;\n  if (S.view === 'review') renderReview();\n  else if (S.view === 'graph') renderGraph();\n  else if (S.view === 'library') renderLibrary();\n  else renderAiSelectors();\n }\n /* View 1: SM-2 Review */\n function renderReview() {\n  const pills = $('review-deck-pills');\n  pills.replaceChildren();\n  const addPill = (id, label) => pills.appendChild(el('button', {\n   type: 'button', cls: `btn sm${S.reviewDeck === id ? ' primary' : ''}`,\n   on: { click: () => { S.reviewDeck = id; S.pinnedId = null; S.flipped = false; renderReview(); } },\n  }, label));\n  addPill('', '全部卡组');\n  for (const d of S.decks) addPill(d.id, `${d.name} (${S.cards.filter(c => c.deck_id === d.id && c.due_date <= S.today).length})`);\n  const q = dueQueue();\n  const total = q.length + S.doneCount;\n  $('review-counter').textContent = `待复习 ${q.length} 张 · 本轮已完成 ${S.doneCount} 张`;\n  $('review-progress').style.width = `${total === 0 ? 100 : Math.round((S.doneCount / total) * 100)}%`;\n  const stage = $('review-stage');\n  stage.replaceChildren();\n  if (!S.cards.length) {\n   stage.appendChild(el('div', { cls: 'empty' },\n    el('h3', { css: 'margin:0' }, '知识库为空'),\n    el('p', { cls: 'muted', css: 'margin:0' }, '可一键载入「大模型系统与分布式架构」演示卡组（3 卡组、8 张互链知识卡），或手动创建。'),\n    el('div', { cls: 'row' },\n     el('button', { cls: 'btn primary', type: 'button', on: { click: () => void loadDemo() } }, '一键载入演示卡组'),\n     el('button', { cls: 'btn', type: 'button', on: { click: () => openDeckModal(null) } }, '+ 新建学科卡组')\n    )\n   ));\n   return;\n  }\n  if (!q.length) {\n   stage.appendChild(el('div', { cls: 'empty' },\n    el('h3', { css: 'margin:0' }, '今日复习队列已全部清空！'),\n    el('p', { cls: 'muted', css: 'margin:0' }, '全部到期闪卡均已按 SuperMemo SM-2 安排好下次复习日期。'),\n    el('div', { cls: 'row' },\n     el('button', { cls: 'btn primary', type: 'button', on: { click: () => switchView('graph') } }, '探索知识图谱'),\n     el('button', { cls: 'btn', type: 'button', on: { click: () => switchView('feynman') } }, '打开 AI 费曼导师')\n    )\n   ));\n   return;\n  }\n  const c = q[0], dk = deckOf(c.deck_id);\n  const fc = el('div', { cls: `flashcard${S.flipped ? ' flipped' : ''}`, on: { click: e => { if (!e.target.closest('button')) { S.flipped = !S.flipped; renderReview(); } } } });\n  const leftMeta = el('div', { cls: 'row' }, dotPill(dk.color, dk.name), el('span', { cls: 'pill' }, KIND_LABEL[c.kind] || c.kind));\n  for (const t of c.tags.slice(0, 3)) leftMeta.appendChild(el('span', { cls: 'pill' }, `#${t}`));\n  const rightMeta = el('div', { cls: 'row' },\n   el('span', { cls: 'muted' }, `EF ${c.ease_factor.toFixed(2)} · 间隔 ${c.interval_days}d · ${c.repetitions}次`),\n   el('button', { type: 'button', cls: 'btn sm ghost', on: { click: () => openAiForCard(c.id, 'feynman') } }, 'AI 追问')\n  );\n  fc.append(el('div', { cls: 'row', css: 'justify-content:space-between' }, leftMeta, rightMeta), el('div', { cls: 'fc-front' }, c.front));\n  if (S.flipped) {\n   fc.append(el('div', { cls: 'fc-div' }), el('div', { cls: `fc-back${c.kind === 'code' ? ' code' : ''}` }, c.back));\n  } else {\n   fc.append(el('div', { cls: 'row', css: 'justify-content:center;margin-top:14px' },\n    el('button', { type: 'button', cls: 'btn primary', on: { click: () => { S.flipped = true; renderReview(); } } }, '翻转查看答案与解析 (Space)')\n   ));\n  }\n  if (c.links.length) {\n   const lr = el('div', { cls: 'row', css: 'margin-top:14px' }, el('span', { cls: 'muted' }, '双链前置：'));\n   for (const lid of c.links) {\n    const tg = S.cards.find(x => x.id === lid);\n    if (tg) lr.appendChild(el('button', { type: 'button', cls: 'pill click', on: { click: () => { S.graphSel = tg.id; switchView('graph'); } } }, `↗ ${tg.front.slice(0, 18)}${tg.front.length > 18 ? '…' : ''}`));\n   }\n   fc.appendChild(lr);\n  }\n  stage.appendChild(el('div', { cls: 'fc-stage' }, fc));\n  if (S.flipped) {\n   const grid = el('div', { cls: 'rate-grid' });\n   for (const [r, cls, title] of [[1,'r1','1 重来 Again'],[2,'r2','2 困难 Hard'],[3,'r3','3 良好 Good'],[4,'r4','4 简单 Easy']]) {\n    grid.appendChild(el('button', { type: 'button', cls: `rate-btn ${cls}`, disabled: S.busy, on: { click: () => void submitReview(c.id, r) } },\n     el('strong', null, title), el('span', null, previewInt(c, r))\n    ));\n   }\n   stage.appendChild(grid);\n  } else {\n   stage.appendChild(el('div', { cls: 'muted', css: 'text-align:center' }, '快捷键：', el('span', { cls: 'kbd' }, 'Space'), ' 翻转 · ', el('span', { cls: 'kbd' }, '1-4'), ' 提交 SM-2 评分'));\n  }\n }\n /* View 2: Pure SVG Knowledge Graph */\n function layoutGraph() {\n  const W = 760, H = 470, cx = W / 2, cy = H / 2;\n  const deckIdx = new Map(S.decks.map((d, i) => [d.id, i]));\n  const dCount = Math.max(1, S.decks.length);\n  const byDeck = new Map(), pos = new Map();\n  for (const c of S.cards) { if (!byDeck.has(c.deck_id)) byDeck.set(c.deck_id, []); byDeck.get(c.deck_id).push(c); }\n  for (const [did, arr] of byDeck) {\n   const a0 = ((deckIdx.get(did) ?? 0) / dCount) * Math.PI * 2 - Math.PI / 2;\n   const cr = dCount === 1 ? 0 : 132;\n   const gx = cx + Math.cos(a0) * cr, gy = cy + Math.sin(a0) * cr * 0.78;\n   arr.forEach((c, i) => {\n    const a = a0 + (i / Math.max(1, arr.length)) * Math.PI * 2;\n    const r = arr.length === 1 ? 0 : 62 + (i % 2) * 18;\n    pos.set(c.id, { x: gx + Math.cos(a) * r, y: gy + Math.sin(a) * r });\n   });\n  }\n  const ids = S.cards.map(c => c.id);\n  for (let it = 0; it < 50; it++) {\n   const disp = new Map(ids.map(id => [id, { x: 0, y: 0 }]));\n   for (let i = 0; i < ids.length; i++) for (let j = i + 1; j < ids.length; j++) {\n    const a = pos.get(ids[i]), b = pos.get(ids[j]);\n    const dx = a.x - b.x, dy = a.y - b.y, d = Math.hypot(dx, dy) || 0.1;\n    if (d < 135) { const f = (135 - d) * 0.14; disp.get(ids[i]).x += (dx / d) * f; disp.get(ids[i]).y += (dy / d) * f; disp.get(ids[j]).x -= (dx / d) * f; disp.get(ids[j]).y -= (dy / d) * f; }\n   }\n   for (const c of S.cards) for (const lid of c.links) {\n    const a = pos.get(c.id), b = pos.get(lid); if (!b) continue;\n    const dx = b.x - a.x, dy = b.y - a.y, d = Math.hypot(dx, dy) || 1;\n    if (d > 145) { const f = (d - 145) * 0.04; disp.get(c.id).x += (dx / d) * f; disp.get(c.id).y += (dy / d) * f; disp.get(lid).x -= (dx / d) * f; disp.get(lid).y -= (dy / d) * f; }\n   }\n   for (const id of ids) {\n    const p = pos.get(id), dp = disp.get(id);\n    p.x = Math.max(76, Math.min(W - 76, p.x + dp.x + (cx - p.x) * 0.015));\n    p.y = Math.max(58, Math.min(H - 58, p.y + dp.y + (cy - p.y) * 0.015));\n   }\n  }\n  return pos;\n }\n function renderGraph() {\n  const leg = $('graph-legend'); leg.replaceChildren();\n  for (const d of S.decks) leg.appendChild(dotPill(d.color, d.name));\n  const root = $('graph-svg'); root.replaceChildren();\n  if (!S.cards.length) {\n   root.appendChild(svg('text', { x: 380, y: 235, 'text-anchor': 'middle', fill: 'currentColor', opacity: .55, 'font-size': 14 }, '暂无知识节点，请先载入演示卡组或新建卡片'));\n   renderInspector(null);\n   return;\n  }\n  const defs = svg('defs');\n  const pat = svg('pattern', { id: 'gdot', width: 22, height: 22, patternUnits: 'userSpaceOnUse' });\n  pat.appendChild(svg('circle', { cx: 2, cy: 2, r: 1, fill: 'currentColor', opacity: .14 }));\n  defs.appendChild(pat);\n  for (const [id, col] of [['am', '#94a3b8'], ['aa', '#6366f1']]) {\n   const m = svg('marker', { id, viewBox: '0 0 10 10', refX: 8, refY: 5, markerWidth: 6, markerHeight: 6, orient: 'auto' });\n   m.appendChild(svg('path', { d: 'M0,1 L9,5 L0,9 z', fill: col }));\n   defs.appendChild(m);\n  }\n  root.append(defs, svg('rect', { width: 760, height: 470, fill: 'url(#gdot)' }));\n  const pos = layoutGraph();\n  const sel = S.graphSel && S.cards.some(c => c.id === S.graphSel) ? S.graphSel : null;\n  const near = new Set();\n  if (sel) { near.add(sel); for (const c of S.cards) { if (c.id === sel) c.links.forEach(l => near.add(l)); if (c.links.includes(sel)) near.add(c.id); } }\n  const eg = svg('g');\n  for (const c of S.cards) {\n   const a = pos.get(c.id);\n   for (const lid of c.links) {\n    const b = pos.get(lid); if (!b) continue;\n    const hi = !sel || c.id === sel || lid === sel;\n    const mx = (a.x + b.x) / 2 + (b.y - a.y) * 0.12, my = (a.y + b.y) / 2 - (b.x - a.x) * 0.12;\n    eg.appendChild(svg('path', {\n     d: `M${a.x.toFixed(1)} ${a.y.toFixed(1)} Q${mx.toFixed(1)} ${my.toFixed(1)} ${b.x.toFixed(1)} ${b.y.toFixed(1)}`,\n     fill: 'none', stroke: hi && sel ? '#6366f1' : '#94a3b8', 'stroke-width': hi && sel ? 2.4 : 1.5,\n     opacity: hi ? (sel ? .92 : .48) : .12, 'marker-end': hi && sel ? 'url(#aa)' : 'url(#am)',\n    }));\n   }\n  }\n  root.appendChild(eg);\n  const ng = svg('g');\n  for (const c of S.cards) {\n   const p = pos.get(c.id), dk = deckOf(c.deck_id), sc = scoreOf(c), r = 15 + Math.round((sc / 100) * 11);\n   const isSel = c.id === sel, g = svg('g', { transform: `translate(${p.x.toFixed(1)},${p.y.toFixed(1)})`, opacity: (!sel || near.has(c.id)) ? 1 : .22, style: 'cursor:pointer' });\n   if (isSel) g.appendChild(svg('circle', { r: r + 8, fill: dk.color, opacity: .2 }));\n   const rr = r + 3.5, circ = 2 * Math.PI * rr;\n   g.appendChild(svg('circle', { r: rr, fill: 'none', stroke: dk.color, opacity: .22, 'stroke-width': 2.5 }));\n   if (sc > 0) g.appendChild(svg('circle', { r: rr, fill: 'none', stroke: dk.color, 'stroke-width': 2.8, 'stroke-dasharray': `${(circ * sc / 100).toFixed(1)} ${circ.toFixed(1)}`, transform: 'rotate(-90)' }));\n   g.appendChild(svg('circle', { r, fill: dk.color, stroke: isSel ? '#fff' : 'rgba(255,255,255,.65)', 'stroke-width': isSel ? 2.8 : 1.5 }));\n   g.appendChild(svg('text', { y: 4, 'text-anchor': 'middle', fill: '#fff', 'font-size': 10, 'font-weight': 700 }, `${sc}%`));\n   if (c.due_date <= S.today) g.appendChild(svg('circle', { cx: r - 2, cy: -(r - 2), r: 4.5, fill: '#ef4444', stroke: '#fff', 'stroke-width': 1.5 }));\n   const txt = c.front.replace(/[？?。：:]/g, '').slice(0, 12);\n   g.appendChild(svg('text', { y: r + 17, 'text-anchor': 'middle', fill: 'currentColor', 'font-size': 11, 'font-weight': isSel ? 700 : 500 }, txt + (c.front.length > 12 ? '…' : '')));\n   g.addEventListener('click', () => { S.graphSel = c.id; renderGraph(); });\n   ng.appendChild(g);\n  }\n  root.appendChild(ng);\n  renderInspector(sel ? S.cards.find(c => c.id === sel) : null);\n }\n function renderInspector(c) {\n  const box = $('graph-inspector'); box.replaceChildren();\n  if (!c) {\n   box.append(el('div', { cls: 'panel-title' }, '节点透视面板'), el('p', { cls: 'muted' }, '点击左侧知识图谱任意节点，高亮相邻双链子图并可直接编辑、复习或发起 AI 费曼追问。'));\n   return;\n  }\n  const dk = deckOf(c.deck_id), sc = scoreOf(c);\n  const mg = el('div', { cls: 'mgrid' });\n  for (const [k, v] of [['掌握度', `${sc}%`], ['下次复习', c.due_date <= S.today ? '今日到期' : c.due_date], ['SM-2 易度', c.ease_factor.toFixed(2)], ['当前间隔', `${c.interval_days}天 (${c.repetitions}次)`]]) {\n   mg.appendChild(el('div', { cls: 'mbox' }, el('span', null, k), el('b', null, v)));\n  }\n  const rel = S.cards.filter(o => o.id !== c.id && (c.links.includes(o.id) || o.links.includes(c.id)));\n  const relRow = el('div', { cls: 'row' });\n  if (!rel.length) relRow.appendChild(el('span', { cls: 'muted' }, '暂无相邻节点'));\n  for (const nb of rel) relRow.appendChild(el('button', { type: 'button', cls: 'pill click', on: { click: () => { S.graphSel = nb.id; renderGraph(); } } }, nb.front.slice(0, 16) + (nb.front.length > 16 ? '…' : '')));\n  box.append(\n   el('div', { cls: 'row' }, dotPill(dk.color, dk.name), el('span', { cls: 'pill' }, KIND_LABEL[c.kind])),\n   el('div', { css: 'font-weight:700;font-size:14.5px' }, c.front),\n   el('div', { cls: `fc-back${c.kind === 'code' ? ' code' : ''}`, css: 'font-size:12.5px' }, c.back),\n   mg,\n   el('div', null, el('div', { cls: 'muted', css: 'margin-bottom:5px' }, '相邻双链知识网'), relRow),\n   el('div', { cls: 'row', css: 'margin-top:auto' },\n    el('button', { type: 'button', cls: 'btn primary sm', on: { click: () => { S.pinnedId = c.id; S.reviewDeck = ''; S.flipped = false; switchView('review'); } } }, '立即复习'),\n    el('button', { type: 'button', cls: 'btn sm', on: { click: () => openCardModal(c.id) } }, '编辑'),\n    el('button', { type: 'button', cls: 'btn sm', on: { click: () => openAiForCard(c.id, 'feynman') } }, '费曼追问')\n   )\n  );\n }\n /* View 3: Library & SVG Charts */\n function renderLibrary() {\n  // Heatmap\n  const hm = $('svg-heatmap'); hm.replaceChildren();\n  const cntMap = new Map();\n  for (const l of S.review_log) cntMap.set(l.date, (cntMap.get(l.date) || 0) + 1);\n  $('heatmap-summary').textContent = `近 42 天累计 ${S.review_log.length} 次复习`;\n  const start = addDays(S.today, -41), pal = ['rgba(148,163,184,.18)', '#a5b4fc', '#818cf8', '#4f46e5', '#10b981'];\n  for (let i = 0; i < 42; i++) {\n   const d = addDays(start, i), n = cntMap.get(d) || 0, lvl = n === 0 ? 0 : n === 1 ? 1 : n === 2 ? 2 : n <= 4 ? 3 : 4;\n   const r = svg('rect', { x: 14 + Math.floor(i / 3) * 19, y: 14 + (i % 3) * 19, width: 15, height: 15, rx: 3.5, fill: pal[lvl] });\n   r.appendChild(svg('title', null, `${d}：${n} 次复习`));\n   hm.appendChild(r);\n  }\n  hm.append(\n   svg('text', { x: 14, y: 88, fill: 'currentColor', opacity: .55, 'font-size': 10.5 }, start.slice(5)),\n   svg('text', { x: 276, y: 88, 'text-anchor': 'end', fill: 'currentColor', opacity: .55, 'font-size': 10.5 }, `${S.today.slice(5)} (今日)`),\n   svg('text', { x: 344, y: 38, fill: 'currentColor', opacity: .65, 'font-size': 11 }, '活跃度图例')\n  );\n  pal.forEach((col, i) => hm.appendChild(svg('rect', { x: 344 + i * 20, y: 46, width: 14, height: 14, rx: 3, fill: col })));\n  hm.append(svg('text', { x: 344, y: 76, fill: 'currentColor', opacity: .5, 'font-size': 10 }, '0 次'), svg('text', { x: 438, y: 76, 'text-anchor': 'end', fill: 'currentColor', opacity: .5, 'font-size': 10 }, '5+ 次'));\n  // Mastery bar chart\n  const mc = $('svg-mastery'); mc.replaceChildren();\n  const tr = S.stats.tiers;\n  const bars = [['未学习', tr.new_count, '#94a3b8'], ['学习中', tr.learning, '#f59e0b'], ['巩固中', tr.reviewing, '#3b82f6'], ['已掌握', tr.mastered, '#10b981']];\n  const maxV = Math.max(1, ...bars.map(b => b[1]));\n  mc.appendChild(svg('line', { x1: 18, y1: 90, x2: 362, y2: 90, stroke: 'currentColor', opacity: .16 }));\n  bars.forEach(([lbl, val, col], i) => {\n   const x = 34 + i * 86, h = Math.max(4, Math.round((val / maxV) * 64)), y = 90 - h;\n   mc.append(\n    svg('rect', { x, y, width: 46, height: h, rx: 6, fill: col, opacity: .9 }),\n    svg('text', { x: x + 23, y: y - 6, 'text-anchor': 'middle', fill: 'currentColor', 'font-size': 12, 'font-weight': 700 }, val),\n    svg('text', { x: x + 23, y: 108, 'text-anchor': 'middle', fill: 'currentColor', opacity: .68, 'font-size': 11 }, lbl)\n   );\n  });\n  // Deck strip\n  const strip = $('deck-strip'); strip.replaceChildren();\n  const mkDeck = (id, name, color, count, edit) => el('button', {\n   type: 'button', cls: `deck-chip${S.libDeck === id ? ' active' : ''}`, title: edit ? '单击筛选，双击编辑卡组' : '',\n   on: { click: () => { S.libDeck = id; renderLibrary(); }, ...(edit ? { dblclick: () => openDeckModal(id) } : {}) },\n  }, color ? el('span', { cls: 'dot', css: `background:${color}` }) : null, `${name} (${count})`);\n  strip.appendChild(mkDeck('', '全部卡组', null, S.cards.length, false));\n  for (const d of S.decks) strip.appendChild(mkDeck(d.id, d.name, d.color, S.cards.filter(c => c.deck_id === d.id).length, true));\n  // Filtered cards\n  const kw = $('lib-search').value.trim().toLowerCase(), kf = $('lib-kind').value, df = $('lib-due').value;\n  const shown = S.cards.filter(c => (!S.libDeck || c.deck_id === S.libDeck) && (!kf || c.kind === kf) && (df !== 'due' || c.due_date <= S.today) && (df !== 'mastered' || c.interval_days >= 21) && (!kw || `${c.front} ${c.back} ${c.tags.join(' ')}`.toLowerCase().includes(kw)));\n  const grid = $('card-grid'); grid.replaceChildren();\n  if (!shown.length) {\n   grid.appendChild(el('div', { cls: 'empty', css: 'grid-column:1/-1' }, el('p', { cls: 'muted' }, S.cards.length ? '没有匹配筛选条件的卡片。' : '暂无知识卡，点击右上角新建或左下角载入演示卡组。')));\n   return;\n  }\n  for (const c of shown) {\n   const dk = deckOf(c.deck_id), sc = scoreOf(c);\n   const col = sc >= 85 ? 'var(--ok)' : sc >= 55 ? 'var(--info)' : 'var(--warn)';\n   grid.appendChild(el('article', { cls: 'kcard' },\n    el('div', { cls: 'row', css: 'justify-content:space-between' }, dotPill(dk.color, dk.name), el('span', { cls: 'pill' }, KIND_LABEL[c.kind])),\n    el('div', { cls: 'kcard-front' }, c.front),\n    el('div', { cls: 'kcard-back' }, c.back),\n    el('div', { cls: 'mbar' }, el('i', { css: `width:${sc}%;background:${col}` })),\n    el('div', { cls: 'row', css: 'justify-content:space-between;margin-top:auto' },\n     el('span', { cls: 'muted' }, `掌握 ${sc}% · 双链 ${c.links.length} · ${c.due_date <= S.today ? '今日到期' : c.due_date}`),\n     el('div', { cls: 'row' },\n      el('button', { type: 'button', cls: 'btn sm ghost', on: { click: () => { S.graphSel = c.id; switchView('graph'); } } }, '图谱'),\n      el('button', { type: 'button', cls: 'btn sm', on: { click: () => openCardModal(c.id) } }, '编辑')\n     )\n    )\n   ));\n  }\n }\n /* View 4: AI Feynman Tutor */\n function renderAiSelectors() {\n  const sel = $('ai-card-select'), prev = sel.value;\n  sel.replaceChildren(el('option', { value: '' }, '— 手动输入下方学习笔记 / 主题 —'));\n  for (const c of S.cards) sel.appendChild(el('option', { value: c.id }, `[${deckOf(c.deck_id).name}] ${c.front.slice(0, 42)}`));\n  if (prev && S.cards.some(c => c.id === prev)) sel.value = prev;\n  const td = $('ai-target-deck'), pd = td.value;\n  td.replaceChildren();\n  for (const d of S.decks) td.appendChild(el('option', { value: d.id }, `入库到：${d.name}`));\n  if (pd && S.decks.some(d => d.id === pd)) td.value = pd;\n }\n function openAiForCard(id, mode) {\n  S.aiMode = mode;\n  document.querySelectorAll('#ai-mode-tabs .mode-card').forEach(b => b.classList.toggle('active', b.dataset.mode === mode));\n  switchView('feynman');\n  $('ai-card-select').value = id;\n  const c = S.cards.find(x => x.id === id);\n  if (c) $('ai-notes').value = `概念/问题：${c.front}\\n\\n当前笔记：${c.back}`;\n }\n function parseCards(text) {\n  const m = text.match(/\\[[\\s\\S]*\\]/);\n  if (m) {\n   try {\n    const arr = JSON.parse(m[0]);\n    if (Array.isArray(arr)) {\n     const ok = arr.filter(x => x && typeof x.front === 'string' && typeof x.back === 'string').slice(0, 5)\n      .map(x => ({ front: x.front.trim().slice(0, 300), back: x.back.trim().slice(0, 760), kind: ['concept','qa','code'].includes(x.kind) ? x.kind : 'qa', checked: true }));\n     if (ok.length) return ok;\n    }\n   } catch {}\n  }\n  const out = [];\n  for (const blk of text.split(/\\n(?=(?:\\d+[.、]\\s*)?(?:Q|问|正面)[：:])/i)) {\n   const qm = blk.match(/(?:Q|问|正面)[：:]\\s*([^\\n]+)/i), am = blk.match(/(?:A|答|背面)[：:]\\s*([\\s\\S]+)/i);\n   if (qm && am) out.push({ front: qm[1].trim().slice(0, 300), back: am[1].trim().slice(0, 760), kind: 'qa', checked: true });\n  }\n  return out.slice(0, 5);\n }\n function renderAiAdopt() {\n  const area = $('ai-adopt-area'), list = $('ai-draft-list'); list.replaceChildren();\n  area.hidden = !S.aiText.trim();\n  if (!S.aiText.trim()) return;\n  if (S.aiMode === 'extract') {\n   S.aiDrafts = parseCards(S.aiText);\n   $('btn-ai-adopt-cards').hidden = !S.aiDrafts.length;\n   $('ai-target-deck').hidden = !S.aiDrafts.length;\n   $('btn-ai-append-card').hidden = true;\n   if (!S.aiDrafts.length) { list.appendChild(el('p', { cls: 'muted' }, '未检测到结构化闪卡数组，可直接复制上方文本新建卡片。')); return; }\n   S.aiDrafts.forEach((d, i) => {\n    const cb = el('input', { type: 'checkbox', checked: d.checked, css: 'width:auto', on: { change: () => { d.checked = cb.checked; } } });\n    list.appendChild(el('div', { cls: 'draft-card' }, el('label', { cls: 'row', css: 'cursor:pointer' }, cb, el('strong', null, `闪卡 #${i + 1}：${d.front}`)), el('div', { cls: 'muted' }, d.back)));\n   });\n  } else {\n   $('btn-ai-adopt-cards').hidden = true;\n   $('ai-target-deck').hidden = true;\n   $('btn-ai-append-card').hidden = !$('ai-card-select').value;\n  }\n }\n /* Modals */\n function openCardModal(id) {\n  if (!S.decks.length) { setStatus('请先创建至少一个卡组，或载入演示数据。', 'error'); openDeckModal(null); return; }\n  S.editCardId = id;\n  const c = id ? S.cards.find(x => x.id === id) : null;\n  $('modal-card-title').textContent = c ? '编辑知识闪卡' : '新建知识闪卡';\n  $('btn-fc-delete').hidden = !c;\n  const ds = $('fc-deck'); ds.replaceChildren();\n  for (const d of S.decks) ds.appendChild(el('option', { value: d.id }, d.name));\n  ds.value = c?.deck_id || S.libDeck || S.decks[0].id;\n  $('fc-kind').value = c?.kind || 'concept';\n  $('fc-front').value = c?.front || '';\n  $('fc-back').value = c?.back || '';\n  $('fc-tags').value = c ? c.tags.join(', ') : '';\n  const pk = $('fc-links'); pk.replaceChildren();\n  const others = S.cards.filter(x => x.id !== id);\n  if (!others.length) pk.appendChild(el('span', { cls: 'muted' }, '暂无其他卡片可关联'));\n  for (const o of others) pk.appendChild(el('label', { cls: 'link-opt' }, el('input', { type: 'checkbox', value: o.id, checked: Boolean(c?.links.includes(o.id)) }), o.front.slice(0, 22) + (o.front.length > 22 ? '…' : '')));\n  $('modal-card').hidden = false;\n }\n function openDeckModal(id) {\n  S.editDeckId = id;\n  const d = id ? S.decks.find(x => x.id === id) : null;\n  $('modal-deck-title').textContent = d ? '编辑学科卡组' : '新建学科卡组';\n  $('btn-dk-delete').hidden = !d;\n  $('dk-name').value = d?.name || '';\n  $('dk-color').value = d?.color || '#6366f1';\n  $('dk-desc').value = d?.description || '';\n  $('modal-deck').hidden = false;\n }\n /* Backend Actions */\n async function busyRun(errLabel, fn) {\n  if (S.busy) return;\n  S.busy = true;\n  try { await fn(); } catch (e) { setStatus(`${errLabel}：${e?.message || '未知错误'}`, 'error'); } finally { S.busy = false; }\n }\n async function refresh(msg) {\n  if (typeof plugin?.action !== 'function') { setStatus('请在 Velai Desktop 中打开此插件。', 'error'); return; }\n  try {\n   const r = await plugin.action('study.state', {});\n   Object.assign(S, { revision: r.revision, today: r.today, decks: r.decks, cards: r.cards, review_log: r.review_log, stats: r.stats, settings: r.settings });\n   render();\n   const goal = r.settings?.daily_review_goal ?? 20;\n   setStatus(msg || `已同步 ${S.decks.length} 卡组 · ${S.cards.length} 卡片（待复习 ${S.stats.due_count} · 今日目标 ${S.stats.reviewed_today}/${goal}）`);\n  } catch (e) { setStatus(`读取失败：${e?.message || '未知错误'}`, 'error'); }\n }\n const submitReview = (cardId, rating) => busyRun('评分失败', async () => {\n  const r = await plugin.action('study.review.submit', { expected_revision: S.revision, card_id: cardId, rating, today: S.today });\n  if (r.status === 'reviewed') {\n   S.flipped = false; S.pinnedId = null; if (rating > 1) S.doneCount += 1;\n   await refresh(`SM-2 已更新：下次 ${r.next_interval_days === 0 ? '今天重学' : `${r.next_interval_days}天后(${r.next_due_date})`}，EF ${r.ease_factor.toFixed(2)}`);\n  } else { setStatus(`提交未完成：${r.status}`, 'error'); await refresh(); }\n });\n const loadDemo = () => busyRun('载入演示失败', async () => {\n  const r = await plugin.action('study.demo.load', { expected_revision: S.revision });\n  if (r.status === 'loaded') { S.doneCount = 0; S.flipped = false; S.graphSel = 'kv-cache'; await refresh(`已载入演示：${r.decks_count} 卡组、${r.cards_count} 张双链知识卡。`); }\n  else { setStatus(`载入冲突：${r.status}`, 'error'); await refresh(); }\n });\n /* Wiring */\n document.querySelectorAll('.nav-btn').forEach(b => b.addEventListener('click', () => switchView(b.dataset.view)));\n document.querySelectorAll('[data-close]').forEach(b => b.addEventListener('click', () => { $(b.dataset.close).hidden = true; }));\n $('btn-demo').addEventListener('click', () => void loadDemo());\n $('btn-new-card').addEventListener('click', () => openCardModal(null));\n $('btn-new-deck').addEventListener('click', () => openDeckModal(null));\n $('btn-graph-clear').addEventListener('click', () => { S.graphSel = null; renderGraph(); });\n $('btn-theme').addEventListener('click', () => {\n  const r = document.documentElement;\n  r.dataset.theme = (r.dataset.theme === 'dark' || (!r.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches)) ? 'light' : 'dark';\n });\n for (const [id, ev] of [['lib-search','input'],['lib-kind','change'],['lib-due','change']]) $(id).addEventListener(ev, renderLibrary);\n $('btn-io').addEventListener('click', async () => {\n  $('modal-io').hidden = false;\n  const sel = $('io-export-select'); sel.replaceChildren();\n  try {\n   const items = (await plugin.action('document.list', {})).items || [];\n   if (!items.length) sel.appendChild(el('option', { value: 'all' }, '暂无可导出数据'));\n   for (const it of items) sel.appendChild(el('option', { value: it.id }, it.label));\n  } catch (e) { setStatus(`读取导出列表失败：${e?.message || '未知错误'}`, 'error'); }\n });\n $('btn-do-export').addEventListener('click', async () => {\n  try {\n   const r = await plugin.action('document.export', { id: $('io-export-select').value || 'all' });\n   if (r.error) setStatus(`导出失败：${r.error}`, 'error');\n   else { $('io-text').value = r.text || ''; setStatus(`已导出 ${r.filename}`, 'ok'); }\n  } catch (e) { setStatus(`导出异常：${e?.message || '未知错误'}`, 'error'); }\n });\n $('btn-copy-io').addEventListener('click', async () => {\n  const t = $('io-text').value; if (!t) return;\n  try { await navigator.clipboard.writeText(t); setStatus('JSON 已复制。', 'ok'); } catch { $('io-text').select(); setStatus('请按 Ctrl/Cmd+C 复制。'); }\n });\n $('btn-do-import').addEventListener('click', async () => {\n  const t = $('io-text').value.trim(); if (!t) return;\n  try {\n   const r = await plugin.action('document.import', { text: t });\n   if (r.imported) { $('modal-io').hidden = true; await refresh(`导入成功：+${r.added_decks || 0} 卡组、+${r.added_cards || 0} 卡片。`); }\n   else setStatus(`导入失败：${r.reason || '格式无效'}`, 'error');\n  } catch (e) { setStatus(`导入异常：${e?.message || '未知错误'}`, 'error'); }\n });\n $('btn-fc-save').addEventListener('click', () => {\n  const front = $('fc-front').value.trim(), back = $('fc-back').value.trim();\n  if (!front || !back) { setStatus('请填写正面与背面内容。', 'error'); return; }\n  void busyRun('保存异常', async () => {\n   const r = await plugin.action('study.card.save', {\n    expected_revision: S.revision, id: S.editCardId || `card-${Date.now().toString(36)}`,\n    deck_id: $('fc-deck').value, kind: $('fc-kind').value, front, back,\n    tags: $('fc-tags').value.split(/[,，]/).map(s => s.trim()).filter(Boolean).slice(0, 6),\n    links: Array.from($('fc-links').querySelectorAll('input:checked')).map(i => i.value),\n   });\n   if (r.status === 'saved') { $('modal-card').hidden = true; await refresh('知识闪卡已保存。'); }\n   else setStatus(`保存失败：${r.status}`, 'error');\n  });\n });\n $('btn-fc-delete').addEventListener('click', () => S.editCardId && void busyRun('删除异常', async () => {\n  const r = await plugin.action('study.card.delete', { expected_revision: S.revision, id: S.editCardId });\n  if (r.status === 'deleted') { $('modal-card').hidden = true; if (S.graphSel === S.editCardId) S.graphSel = null; await refresh('已删除卡片并清理失效双链。'); }\n  else setStatus(`删除失败：${r.status}`, 'error');\n }));\n $('btn-dk-save').addEventListener('click', () => {\n  const name = $('dk-name').value.trim();\n  if (!name) { setStatus('请填写卡组名称。', 'error'); return; }\n  void busyRun('保存异常', async () => {\n   const r = await plugin.action('study.deck.save', { expected_revision: S.revision, id: S.editDeckId || `deck-${Date.now().toString(36)}`, name, color: $('dk-color').value || '#6366f1', description: $('dk-desc').value.trim() });\n   if (r.status === 'saved') { $('modal-deck').hidden = true; await refresh(`卡组「${name}」已保存。`); }\n   else setStatus(`保存失败：${r.status}`, 'error');\n  });\n });\n $('btn-dk-delete').addEventListener('click', () => S.editDeckId && void busyRun('删除异常', async () => {\n  const r = await plugin.action('study.deck.delete', { expected_revision: S.revision, id: S.editDeckId });\n  if (r.status === 'deleted') { $('modal-deck').hidden = true; S.libDeck = ''; await refresh('已删除卡组。'); }\n  else setStatus(`删除失败：${r.status}`, 'error');\n }));\n document.querySelectorAll('#ai-mode-tabs .mode-card').forEach(b => b.addEventListener('click', () => {\n  S.aiMode = b.dataset.mode;\n  document.querySelectorAll('#ai-mode-tabs .mode-card').forEach(x => x.classList.toggle('active', x === b));\n  renderAiAdopt();\n }));\n $('ai-card-select').addEventListener('change', () => {\n  const c = S.cards.find(x => x.id === $('ai-card-select').value);\n  if (c) $('ai-notes').value = `概念/问题：${c.front}\\n\\n当前笔记：${c.back}`;\n  renderAiAdopt();\n });\n function buildStudyPrompt(notes) {\n  return S.aiMode === 'feynman' ? `请作为费曼导师，针对以下知识点提出 3 个直击本质的深度追问及判断要点（简洁纯文本）：\\n\\n${notes}`\n   : S.aiMode === 'extract' ? `请从以下学习笔记提炼 3 张高价值间隔重复闪卡，严格只输出 JSON 数组 [{\"front\":\"问题\",\"back\":\"解答\",\"kind\":\"concept|qa|code\"}]：\\n\\n${notes}`\n   : `请用生动直观的工程类比与心智模型解释以下概念（250字内，纯文本）：\\n\\n${notes}`;\n }\n $('btn-ai-draft').addEventListener('click', () => {\n  const notes = $('ai-notes').value.trim();\n  if (!notes) { setStatus('请先选择卡片或粘贴学习笔记。', 'error'); return; }\n  const firstLine = notes.split(/\\r?\\n/)[0].replace(/^概念\\/问题[:：]\\s*/, '').slice(0, 80) || '核心知识点';\n  const defKind = S.settings?.default_card_kind || 'concept';\n  if (S.aiMode === 'extract') {\n   const drafts = [\n    { front: `核心原理：${firstLine}`, back: notes.slice(0, 260), kind: defKind },\n    { front: `工程边界：${firstLine} 在什么场景下会失效或出现瓶颈？`, back: '请结合输入笔记梳理前置假设、复杂度/资源约束与典型反例。', kind: 'qa' },\n    { front: `实践应用：如何用一句话向非专业同事复述 ${firstLine}？`, back: '提炼输入 -> 核心机制 -> 可量化收益三段式心智模型。', kind: 'concept' },\n   ];\n   S.aiText = JSON.stringify(drafts, null, 2);\n  } else if (S.aiMode === 'feynman') {\n   S.aiText = [\n    `【费曼自测 3 问 · ${firstLine}】`,\n    '1. 核心机制：如果去掉其中最关键的一个假设或组件，系统行为会发生什么变化？',\n    '2. 边界与权衡：它在时间、空间或一致性上牺牲了什么来换取当前收益？',\n    '3. 反例验证：请举出一个不适用该方法的反例，并说明替代方案。',\n   ].join('\\n');\n  } else {\n   S.aiText = `【直觉类比模板 · ${firstLine}】\\n可以将该机制类比为「按需缓存与分级索引」：把高频核心信息放在最近的工作台，减少重复开销；如需更丰富类比，可点击「复制 AI 导师提示词」在工作台聊天或 AI 伴生插件中生成。`;\n  }\n  $('ai-state-badge').textContent = '已生成本地草稿';\n  $('ai-raw-preview').textContent = S.aiText;\n  renderAiAdopt();\n });\n $('btn-ai-prompt').addEventListener('click', async () => {\n  const notes = $('ai-notes').value.trim();\n  if (!notes) { setStatus('请先选择卡片或粘贴学习笔记。', 'error'); return; }\n  const prompt = buildStudyPrompt(notes);\n  try { await navigator.clipboard.writeText(prompt); $('ai-state-badge').textContent = '提示词已复制'; setStatus('已复制导师提示词，请粘贴至工作台聊天或独立 AI 伴生插件。'); }\n  catch { $('ai-raw-preview').textContent = prompt; $('ai-state-badge').textContent = '已展示提示词'; setStatus('请从右侧预览区复制提示词。'); }\n });\n $('btn-ai-adopt-cards').addEventListener('click', () => {\n  const deckId = $('ai-target-deck').value, chosen = S.aiDrafts.filter(d => d.checked);\n  if (!deckId || !chosen.length) { setStatus('请选择目标卡组与至少一张闪卡。', 'error'); return; }\n  void busyRun('入库失败', async () => {\n   let n = 0, rev = S.revision, lid = $('ai-card-select').value;\n   for (let i = 0; i < chosen.length; i++) {\n    const d = chosen[i];\n    const r = await plugin.action('study.card.save', { expected_revision: rev, id: `ai-${Date.now().toString(36)}-${i}`, deck_id: deckId, kind: d.kind, front: d.front, back: d.back, tags: ['AI制卡'], links: lid ? [lid] : [] });\n    if (r.status === 'saved') { rev = r.revision; n += 1; } else break;\n   }\n   await refresh(`已采纳并入库 ${n} 张 AI 闪卡！`); $('ai-adopt-area').hidden = true;\n  });\n });\n $('btn-ai-append-card').addEventListener('click', () => {\n  const c = S.cards.find(x => x.id === $('ai-card-select').value);\n  if (!c || !S.aiText) return;\n  void busyRun('写入异常', async () => {\n   const r = await plugin.action('study.card.save', { expected_revision: S.revision, id: c.id, deck_id: c.deck_id, kind: c.kind, front: c.front, back: `${c.back}\\n\\n[AI 费曼补充]\\n${S.aiText}`.slice(0, 800), tags: c.tags, links: c.links });\n   if (r.status === 'saved') { await refresh('已追加写入卡片背面。'); $('ai-adopt-area').hidden = true; }\n   else setStatus(`写入失败：${r.status}`, 'error');\n  });\n });\n document.addEventListener('keydown', e => {\n  if (S.view !== 'review' || !$('modal-card').hidden || !$('modal-deck').hidden || !$('modal-io').hidden) return;\n  if (['INPUT','TEXTAREA','SELECT'].includes(document.activeElement?.tagName)) return;\n  const q = dueQueue(); if (!q.length) return;\n  if (e.code === 'Space') { e.preventDefault(); S.flipped = !S.flipped; renderReview(); }\n  else if (S.flipped && ['1','2','3','4'].includes(e.key)) { e.preventDefault(); void submitReview(q[0].id, Number(e.key)); }\n });\n void refresh();\n})();\n\n/* === V2 Host Theme & Compact Surface JS Start === */\n(() => {\n  const root = document.documentElement;\n  const BTN_MODE = \"label\";\n  const HAS_SIDEBAR = true;\n  const MAIN_SEL = \".main-col\";\n  const INIT_MQ = true;\n  const VALID_THEMES = new Set(['light', 'dark']);\n  const VALID_SURFACES = new Set(['workspace', 'chat', 'assistant']);\n\n  const normalizeTheme = val => (val === 'light' || val === 'dark' ? val : null);\n\n  if (INIT_MQ && !normalizeTheme(root.getAttribute('data-theme'))) {\n    try {\n      const dark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;\n      root.setAttribute('data-theme', dark ? 'dark' : 'light');\n    } catch {}\n  }\n\n  let hostTheme = normalizeTheme(root.getAttribute('data-theme'));\n\n  function syncThemeButton(theme) {\n    const btn = document.getElementById('btn-theme');\n    if (!btn || !VALID_THEMES.has(theme)) return;\n    btn.setAttribute('aria-pressed', String(theme === 'dark'));\n    btn.dataset.activeTheme = theme;\n    btn.title = theme === 'dark' ? '当前深色主题，点击切换浅色' : '当前浅色主题，点击切换深色';\n    if (BTN_MODE === 'short') {\n      btn.textContent = theme === 'light' ? '☾ 深色' : '☀ 浅色';\n    } else if (BTN_MODE === 'emoji') {\n      const txt = (btn.textContent || '').trim();\n      const rest = txt.replace(/^(?:☀️|☀|🌙|☾|◐)\\s*/, '');\n      btn.textContent = (theme === 'light' ? '🌙 ' : '☀️ ') + (rest || '外观');\n    } else {\n      btn.textContent = theme === 'dark' ? '☀ 切换浅色' : '☾ 切换深色';\n    }\n  }\n\n  function applyHostTheme(raw) {\n    const data = raw && typeof raw === 'object'\n      ? (raw.theme || raw.surface || raw.tokens ? raw : (raw.payload && typeof raw.payload === 'object' ? raw.payload : raw))\n      : null;\n    if (!data || typeof data !== 'object') return;\n    const nextTheme = normalizeTheme(data.theme);\n    if (nextTheme) {\n      hostTheme = nextTheme;\n      root.removeAttribute('data-theme-override');\n      root.setAttribute('data-theme', nextTheme);\n      syncThemeButton(nextTheme);\n    }\n    if (typeof data.surface === 'string' && VALID_SURFACES.has(data.surface)) {\n      root.setAttribute('data-surface', data.surface);\n    }\n    if (data.tokens && typeof data.tokens === 'object') {\n      for (const [k, v] of Object.entries(data.tokens)) {\n        if (typeof v === 'string' && k) {\n          try { root.style.setProperty(k.startsWith('--') ? k : '--' + k, v); } catch {}\n        }\n      }\n    }\n  }\n\n  const initialTheme = normalizeTheme(root.getAttribute('data-theme'));\n  if (initialTheme) syncThemeButton(initialTheme);\n\n  const themeBtn = document.getElementById('btn-theme');\n  if (themeBtn) {\n    themeBtn.addEventListener('click', () => {\n      const cur = normalizeTheme(root.getAttribute('data-theme'));\n      if (!cur) return;\n      if (hostTheme && cur !== hostTheme) root.setAttribute('data-theme-override', '1');\n      else root.removeAttribute('data-theme-override');\n      syncThemeButton(cur);\n    });\n  }\n\n  try {\n    window.addEventListener('host.theme.changed', ev => {\n      try { applyHostTheme(ev && typeof ev === 'object' && 'detail' in ev ? ev.detail : ev); } catch {}\n    });\n  } catch {}\n  try {\n    const sub = globalThis.nmasPlugin?.subscribe?.('host.theme.changed', payload => {\n      try { applyHostTheme(payload); } catch {}\n    });\n    if (sub && typeof sub.catch === 'function') sub.catch(() => {});\n  } catch {}\n\n  if (HAS_SIDEBAR) {\n    const sidebar = document.querySelector('.sidebar');\n    const hostMain = document.querySelector(MAIN_SEL) || document.querySelector('.main, .main-area, .main-col, .workspace');\n    const srcBtns = sidebar ? Array.from(sidebar.querySelectorAll('button[data-view]')) : [];\n    if (sidebar && hostMain && srcBtns.length > 0 && !hostMain.querySelector('.v2-surface-nav')) {\n      const nav = document.createElement('nav');\n      nav.className = 'v2-surface-nav';\n      nav.setAttribute('aria-label', '视图切换');\n      const pairs = srcBtns.map(src => {\n        const clone = src.cloneNode(true);\n        clone.querySelectorAll('svg, .nav-badge, .pill, .mono').forEach(el => el.remove());\n        const navLeft = clone.querySelector('.nav-left');\n        let label = '';\n        if (navLeft) {\n          label = Array.from(navLeft.children).map(el => (el.textContent || '').trim()).filter(Boolean).join(' ');\n        } else {\n          label = (clone.textContent || '').replace(/\\s+/g, ' ').trim();\n        }\n        const tab = document.createElement('button');\n        tab.type = 'button';\n        tab.className = 'v2-surface-tab';\n        tab.dataset.surfaceView = src.dataset.view || '';\n        tab.textContent = label || src.dataset.view || '视图';\n        tab.addEventListener('click', () => { try { src.click(); } catch {} });\n        nav.appendChild(tab);\n        return [src, tab];\n      });\n      const syncNav = () => {\n        for (const [src, tab] of pairs) {\n          const active = src.classList.contains('active');\n          tab.classList.toggle('active', active);\n          if (active) tab.setAttribute('aria-current', 'page');\n          else tab.removeAttribute('aria-current');\n        }\n      };\n      syncNav();\n      hostMain.prepend(nav);\n      try {\n        const obs = new MutationObserver(syncNav);\n        obs.observe(sidebar, { subtree: true, attributes: true, attributeFilter: ['class'] });\n      } catch {}\n    }\n  }\n})();\n/* === V2 Host Theme & Compact Surface JS End === */\n</script>\n</body>\n</html>\n","path":"ui/index.html"}],"format":"nmas-plugin","manifest":{"actions":[{"id":"study.state","input_schema":{"additionalProperties":false,"properties":{"today":{"maxLength":10,"minLength":10,"type":"string"}},"required":[],"type":"object"},"output_schema":{"additionalProperties":false,"properties":{"cards":{"items":{"additionalProperties":false,"properties":{"back":{"maxLength":800,"minLength":1,"type":"string"},"deck_id":{"maxLength":40,"minLength":1,"type":"string"},"due_date":{"maxLength":10,"minLength":10,"type":"string"},"ease_factor":{"ma